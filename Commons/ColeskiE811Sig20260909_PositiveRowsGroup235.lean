  let b : Fin 31 := ⟨a.val/256,by omega⟩
  have h := cover_blocks b
  have hm : a.val%256 ∈ List.range (if b.val = 30 then 96 else 256) := by
    simp only [List.mem_range]
    dsimp [b]
