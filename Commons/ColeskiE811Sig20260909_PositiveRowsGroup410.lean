    simp only [List.mem_range]
    dsimp [b]
    split <;> omega
  have hc := List.all_eq_true.mp h (a.val%256) hm
  have he : b.val*256+a.val%256 = a.val := by dsimp [b]; omega
  simpa only [he,beq_iff_eq] using hc
