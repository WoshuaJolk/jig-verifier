theorem proof : IsGreatest {r : ℝ | 0 < r ∧ ∃ p : Fin 7 → ℝ × ℝ,
    (∀ i, r ≤ (p i).1 ∧ (p i).1 ≤ 1 - r ∧ r ≤ (p i).2 ∧ (p i).2 ≤ 1 / 2 - r) ∧
    (∀ i j, i ≠ j → (2 * r) ^ 2 ≤ ((p i).1 - (p j).1) ^ 2 + ((p i).2 - (p j).2) ^ 2)}
    (1 / (4 + Real.sqrt 6 + Real.sqrt 2)) := by
  have h6 : Real.sqrt 6 ^ 2 = 6 := Real.sq_sqrt (by norm_num)
  have h2 : Real.sqrt 2 ^ 2 = 2 := Real.sq_sqrt (by norm_num)
  have h6l : (24494897 / 10000000 : ℝ) < Real.sqrt 6 := (Real.lt_sqrt (by norm_num)).mpr (by norm_num)
  have h6u : Real.sqrt 6 < (24494898 / 10000000 : ℝ) := (Real.sqrt_lt' (by norm_num)).mpr (by norm_num)
  have h2l : (14142135 / 10000000 : ℝ) < Real.sqrt 2 := (Real.lt_sqrt (by norm_num)).mpr (by norm_num)
  have h2u : Real.sqrt 2 < (14142136 / 10000000 : ℝ) := (Real.sqrt_lt' (by norm_num)).mpr (by norm_num)
  obtain ⟨s, hs⟩ : ∃ s : ℝ, s = (Real.sqrt 6 - Real.sqrt 2) / 4 := ⟨_, rfl⟩
  obtain ⟨c, hc⟩ : ∃ c : ℝ, c = (Real.sqrt 6 + Real.sqrt 2) / 4 := ⟨_, rfl⟩
  have hsc1 : s ^ 2 + c ^ 2 = 1 := by rw [hs, hc]; nlinarith [h6, h2]
  have hsc2 : s * c = 1 / 4 := by rw [hs, hc]; nlinarith [h6, h2]
  have hsl : (258819 / 1000000 : ℝ) ≤ s := by rw [hs]; linarith
  have hsh : s ≤ (25882 / 100000 : ℝ) := by rw [hs]; linarith
  have hcl : (965925 / 1000000 : ℝ) ≤ c := by rw [hc]; linarith
  have hcu : c ≤ (965926 / 1000000 : ℝ) := by rw [hc]; linarith
  have hden : 4 + Real.sqrt 6 + Real.sqrt 2 = 4 * (1 + c) := by rw [hc]; ring
  rw [hden]
  constructor
  · -- attainment: Specht's configuration
    obtain ⟨r, hr⟩ : ∃ r : ℝ, r = 1 / (4 * (1 + c)) := ⟨_, rfl⟩
    rw [← hr]
    have hc1 : (0 : ℝ) < 1 + c := by linarith
    have hc1' : (1 + c : ℝ) ≠ 0 := ne_of_gt hc1
    have hr0 : 0 < r := by rw [hr]; exact div_pos one_pos (by linarith)
    have h4r : 4 * r * (1 + c) = 1 := by rw [hr]; field_simp
    obtain ⟨X, hX⟩ : ∃ X : Fin 7 → ℝ, X = ![0, s, 1, 1 + s, 1 + c, 1 + 2 * c - s, 1 + 2 * c] :=
      ⟨_, rfl⟩
    obtain ⟨Y, hY⟩ : ∃ Y : Fin 7 → ℝ, Y = ![0, c, 0, c, s, c, 0] := ⟨_, rfl⟩
    have hbox : ∀ i, 0 ≤ X i ∧ X i ≤ 1 + 2 * c ∧ 0 ≤ Y i ∧ Y i ≤ c := by
      intro i
      rw [hX, hY]
      fin_cases i <;> simp <;> (try constructorm* _ ∧ _) <;> linarith
    have hn : ∀ i j, i ≠ j → 1 ≤ (X i - X j) ^ 2 + (Y i - Y j) ^ 2 := by
      intro i j hij
      rw [hX, hY]
      have hs0 : 0 ≤ s := by linarith
      have hc0 : 0 ≤ c := by linarith
      fin_cases i <;> fin_cases j <;> simp [-one_le_sq_iff_one_le_abs] at hij ⊢ <;>
        nlinarith [hsc1, hsc2, mul_nonneg hs0 hs0, mul_nonneg hc0 hc0, mul_nonneg hs0 hc0,
          mul_nonneg hc0 (by linarith : (0:ℝ) ≤ c - s), mul_nonneg hs0 (by linarith : (0:ℝ) ≤ c - s)]
    refine ⟨hr0, fun i => (r + 2 * r * X i, r + 2 * r * Y i), fun i => ?_, fun i j hij => ?_⟩
    · obtain ⟨a1, a2, a3, a4⟩ := hbox i
      have e1 := mul_nonneg hr0.le a1
      have e2 := mul_le_mul_of_nonneg_left a2 hr0.le
      have e3 := mul_nonneg hr0.le a3
      have e4 := mul_le_mul_of_nonneg_left a4 hr0.le
      dsimp only
      refine ⟨by nlinarith, by nlinarith, by nlinarith, by nlinarith⟩
    · have := hn i j hij
      dsimp only
      nlinarith [mul_nonneg (sq_nonneg r) (sub_nonneg.2 this)]
  · -- upper bound
    intro r hr
    obtain ⟨hr0, p, hp, hd⟩ := hr
    by_contra hcon
    have hlt := not_le.mp hcon
    have hk : 1 < 4 * r * (1 + c) := by
      have hpos : (0 : ℝ) < 4 * (1 + c) := by linarith
      rw [div_lt_iff₀ hpos] at hlt
      nlinarith
    have h2r : (0 : ℝ) < 2 * r := by linarith
    obtain ⟨X, hX⟩ : ∃ X : Fin 7 → ℝ, ∀ i, X i = ((p i).1 - r) / (2 * r) := ⟨_, fun _ => rfl⟩
    obtain ⟨Y, hY⟩ : ∃ Y : Fin 7 → ℝ, ∀ i, Y i = ((p i).2 - r) / (2 * r) := ⟨_, fun _ => rfl⟩
    have hX0 : ∀ i, 0 ≤ X i := fun i => by
      rw [hX]; exact div_nonneg (by linarith [(hp i).1]) h2r.le
    have hXu : ∀ i, X i < 1 + 2 * c := fun i => by
      rw [hX, div_lt_iff₀ h2r]; nlinarith [(hp i).2.1]
    have hY0 : ∀ i, 0 ≤ Y i := fun i => by
      rw [hY]; exact div_nonneg (by linarith [(hp i).2.2.1]) h2r.le
    have hYu : ∀ i, Y i ≤ c := fun i => by
      rw [hY, div_le_iff₀ h2r]; nlinarith [(hp i).2.2.2]
    have hpair : ∀ i j, i ≠ j → 1 ≤ (X j - X i) ^ 2 + (Y j - Y i) ^ 2 := by
      intro i j hij
      have e1 : X j - X i = ((p j).1 - (p i).1) / (2 * r) := by rw [hX, hX]; ring
      have e2 : Y j - Y i = ((p j).2 - (p i).2) / (2 * r) := by rw [hY, hY]; ring
      rw [e1, e2, div_pow, div_pow, ← add_div, le_div_iff₀ (by positivity)]
      nlinarith [hd i j hij]
    have hm : Monotone (X ∘ Tuple.sort X) := Tuple.monotone_sort X
    set σ := Tuple.sort X with hσ
    have hne : ∀ a b : Fin 7, a ≠ b → σ a ≠ σ b := fun a b h e => h (σ.injective e)
    have m01 : X (σ 0) ≤ X (σ 1) := hm (show (0 : Fin 7) ≤ 1 by decide)
    have m12 : X (σ 1) ≤ X (σ 2) := hm (show (1 : Fin 7) ≤ 2 by decide)
    have m23 : X (σ 2) ≤ X (σ 3) := hm (show (2 : Fin 7) ≤ 3 by decide)
    have m34 : X (σ 3) ≤ X (σ 4) := hm (show (3 : Fin 7) ≤ 4 by decide)
    have m45 : X (σ 4) ≤ X (σ 5) := hm (show (4 : Fin 7) ≤ 5 by decide)
    have m56 : X (σ 5) ≤ X (σ 6) := hm (show (5 : Fin 7) ≤ 6 by decide)
    have key := core s c hsc1 hsc2 hsl hsh hcl hcu
      (X (σ 0)) (X (σ 1)) (X (σ 2)) (X (σ 3)) (X (σ 4)) (X (σ 5)) (X (σ 6))
      (Y (σ 0)) (Y (σ 1)) (Y (σ 2)) (Y (σ 3)) (Y (σ 4)) (Y (σ 5)) (Y (σ 6))
      m01 m12 m23 m34 m45 m56
      (hpair _ _ (hne 0 1 (by decide))) (hpair _ _ (hne 0 2 (by decide))) (hpair _ _ (hne 0 3 (by decide))) (hpair _ _ (hne 0 4 (by decide))) (hpair _ _ (hne 0 5 (by decide))) (hpair _ _ (hne 0 6 (by decide))) (hpair _ _ (hne 1 2 (by decide))) (hpair _ _ (hne 1 3 (by decide))) (hpair _ _ (hne 1 4 (by decide))) (hpair _ _ (hne 1 5 (by decide))) (hpair _ _ (hne 1 6 (by decide))) (hpair _ _ (hne 2 3 (by decide))) (hpair _ _ (hne 2 4 (by decide))) (hpair _ _ (hne 2 5 (by decide))) (hpair _ _ (hne 2 6 (by decide))) (hpair _ _ (hne 3 4 (by decide))) (hpair _ _ (hne 3 5 (by decide))) (hpair _ _ (hne 3 6 (by decide))) (hpair _ _ (hne 4 5 (by decide))) (hpair _ _ (hne 4 6 (by decide))) (hpair _ _ (hne 5 6 (by decide)))
      (hY0 _) (hYu _) (hY0 _) (hYu _) (hY0 _) (hYu _) (hY0 _) (hYu _) (hY0 _) (hYu _) (hY0 _) (hYu _) (hY0 _) (hYu _)
    have := hXu (σ 6)
    have := hX0 (σ 0)
    linarith

end Submissions.DominoSevenCircles.HeightChains
