/-!
Optimality of the Packomania (Eckard Specht) packing of seven equal circles in `[0,1] × [0,1/2]`,
radius `r* = 1/(4 + √6 + √2) = 1/(4(1 + cos 15°))`.

Normalise by the diameter `2r`: centres become points with pairwise distance `≥ 1` in
`[0, A] × [0, B]`, `A = 1/(2r) - 1`, `B = 1/(4r) - 1 = (A - 1)/2`. If `r > r*` then
`B < c := cos 15°` and `A < 1 + 2c`. Sort the points by `x` (`Tuple.sort`). Two sorted points
with heights differing by at most `t` are at least `√(1 - t²)` apart horizontally, so chains of
such gaps bound the width from below. `core` shows by an exact case split on the seven heights
(262 boxes closed by rational chain bounds, 4 boxes at the copies of Specht's arrangement
closed by `cornerP`) that the width is always `≥ 1 + 2c`, a contradiction.
-/

namespace Submissions.DominoSevenCircles.HeightChains

/-- From `g ≥ 0` and `g² + dy² ≥ 1`, any `l` with `l² + dy² ≤ 1` is a lower bound for `g`. -/
theorem gapL (g dy l : ℝ) (h : 1 ≤ g ^ 2 + dy ^ 2) (hg : 0 ≤ g) (hl : l ^ 2 + dy ^ 2 ≤ 1) :
    l ≤ g := by
  by_contra hc
  have hlt := not_le.mp hc
  nlinarith [mul_lt_mul'' hlt hlt hg hg]

/-- Horizontal gap between two sorted unit-separated points whose height difference is at most
`t`: at least any `q ≥ 0` with `q² + t² ≤ 1`. -/
theorem gapB (xi xj yi yj q t : ℝ) (h : 1 ≤ (xj - xi) ^ 2 + (yj - yi) ^ 2) (hord : xi ≤ xj)
    (h1 : yj - yi ≤ t) (h2 : yi - yj ≤ t) (hq : q ^ 2 + t ^ 2 ≤ 1) (_hq0 : 0 ≤ q) :
    q ≤ xj - xi := by
  have hdy : (yj - yi) ^ 2 ≤ t ^ 2 := by
    nlinarith [mul_nonneg (by linarith : (0:ℝ) ≤ t - (yj - yi))
      (by linarith : (0:ℝ) ≤ t + (yj - yi))]
  exact gapL (xj - xi) (yj - yi) q h (by linarith) (by linarith)

