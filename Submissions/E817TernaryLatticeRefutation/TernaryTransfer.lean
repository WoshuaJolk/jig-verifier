/- BEGIN LOCAL MODULE Erdos817LatticeTransfer -/
section
/-!
Ternary digit boxes obtained from the Epoch AI / GPT-6 Astra lattice construction
for Erdős problem 1. All cyclic-lattice and integer-perturbation ingredients are
attributed to that published proof. This file changes the final digit scale by
using a rounded perturbation parameter; it does not claim a new lattice family.
-/

open Filter Matrix
open scoped Topology

namespace Erdos817LatticeTransfer

open Submissions.Erdos1DistinctSubsetSumsRefuted.EpochPort
open Erdos1DigitBoxes Erdos1LatticePrimitive Erdos1LatticeStability
  Erdos1LatticeAsymptotic Erdos1LatticeReduction Erdos1CyclicLatticeConstruction

noncomputable def rounded (R s : ℕ) : ℕ :=
  ⌈(R : ℝ)⁻¹ * (3 : ℝ)^s⌉₊

noncomputable def parameter {n : ℕ} (B : Matrix (Fin n) (Fin n) ℤ) (R s : ℕ) : ℤ :=
  (rounded R s : ℤ) + errorCost B

lemma rounded_ratio_limit {R : ℕ} (hR : 0 < R) :
    Tendsto (fun s : ℕ => (rounded R s : ℝ) / (3 : ℝ)^s) atTop
      (𝓝 (R : ℝ)⁻¹) := by
  have hR' : 0 < (R : ℝ) := by exact_mod_cast hR
  exact (tendsto_nat_ceil_mul_div_atTop (le_of_lt (inv_pos.mpr hR'))).comp
    (tendsto_pow_atTop_atTop_of_one_lt (by norm_num : (1 : ℝ) < 3))

lemma parameter_limit {n R : ℕ} (B : Matrix (Fin n) (Fin n) ℤ) (hR : 0 < R) :
    Tendsto (fun s : ℕ => (parameter B R s : ℝ)) atTop atTop := by
  have hR' : 0 < (R : ℝ) := by exact_mod_cast hR
  have hp : Tendsto (fun s : ℕ => (3 : ℝ)^s) atTop atTop :=
    tendsto_pow_atTop_atTop_of_one_lt (by norm_num)
  have hs : Tendsto (fun s : ℕ => (R : ℝ)⁻¹ * (3 : ℝ)^s) atTop atTop := by
    simpa [mul_comm] using hp.atTop_mul_const (inv_pos.mpr hR')
  have hc : Tendsto (fun s : ℕ => rounded R s) atTop atTop :=
    tendsto_nat_ceil_atTop.comp hs
  have hcr : Tendsto (fun s : ℕ => (rounded R s : ℝ)) atTop atTop :=
    tendsto_natCast_atTop_atTop.comp hc
  simpa [parameter] using
    (tendsto_atTop_add_const_right atTop (errorCost B : ℝ) hcr)

lemma parameter_ratio_limit {n R : ℕ} (B : Matrix (Fin n) (Fin n) ℤ) (hR : 0 < R) :
    Tendsto (fun s : ℕ => (parameter B R s : ℝ) / (3 : ℝ)^s) atTop
      (𝓝 (R : ℝ)⁻¹) := by
  have hp : Tendsto (fun s : ℕ => (3 : ℝ)^s) atTop atTop :=
    tendsto_pow_atTop_atTop_of_one_lt (by norm_num)
  have he := (tendsto_inv_atTop_zero.comp hp).const_mul (errorCost B : ℝ)
  simpa [parameter, add_div, div_eq_mul_inv, add_mul] using (rounded_ratio_limit hR).add he

noncomputable def coeff {n : ℕ} (B : Matrix (Fin n) (Fin n) ℤ)
    (hB : B.BlockTriangular id) (R s : ℕ) (i : Fin (n+1)) : ℤ :=
  coefficient (perturb B (parameter B R s)) (perturb_unit hB _) i

lemma coeff_ratio_limit {n R : ℕ} (B : Matrix (Fin n) (Fin n) ℤ)
    (hB : B.BlockTriangular id) (hR : 0 < R) (i : Fin (n+1)) :
    Tendsto (fun s : ℕ => (coeff B hB R s i : ℝ) / (3 : ℝ)^(n*s)) atTop
      (𝓝 (((-1 : ℝ)^n * (B.det : ℝ)) / (R : ℝ)^n)) := by
  have ht := parameter_limit B hR
  have hn := (normal_limit B i).comp ht
  have hr := (parameter_ratio_limit B hR).pow n
  have hh := hn.mul hr
  simp only [inv_pow, ← div_eq_mul_inv] at hh
  apply hh.congr'
  filter_upwards [ht.eventually (eventually_gt_atTop (0 : ℝ))] with s hs
  have hc : (coeff B hB R s i : ℝ) = normalReal B (parameter B R s) i := by
    exact coefficient_real B hB (parameter B R s) i
  rw [hc]
  simp only [Function.comp_apply]
  rw [div_pow, ← pow_mul]
  have ht0 : (parameter B R s : ℝ) ≠ 0 := ne_of_gt hs
  have hq0 : (3 : ℝ)^s ≠ 0 := by positivity
  field_simp
  rw [Nat.mul_comm s n]

lemma parameter_radius {n R : ℕ} (B : Matrix (Fin n) (Fin n) ℤ) (hR : 0 < R)
    (s : ℕ) :
    (3^s : ℤ) ≤ (parameter B R s - errorCost B) * (R : ℤ) := by
  have hR' : 0 < (R : ℝ) := by exact_mod_cast hR
  have hh := Nat.le_ceil ((R : ℝ)⁻¹ * (3 : ℝ)^s)
  have hm := mul_le_mul_of_nonneg_right hh hR'.le
  have hreal : (3 : ℝ)^s ≤ (rounded R s : ℝ) * (R : ℝ) := by
    simpa [rounded, mul_assoc, mul_left_comm, mul_comm, ne_of_gt hR'] using hm
  have hz : (3^s : ℤ) ≤ (rounded R s : ℤ) * (R : ℤ) := by exact_mod_cast hreal
  simpa [parameter] using hz

theorem eventual_ternary_box_family {n R D : ℕ}
    (B : Matrix (Fin n) (Fin n) ℤ) (hB : B.BlockTriangular id)
    (hR : 0 < R) (hD : 0 < D) (hdet : (-1 : ℤ)^n * B.det = D)
    (hradius : ∀ z : Fin n → ℤ, z ≠ 0 → ∃ i, (R : ℤ) ≤ |leading B z i|)
    {ε : ℝ} (hε : (D : ℝ) / (R : ℝ)^n < ε) :
    ∀ᶠ s : ℕ in atTop, ∃ a : Fin (n+1) → ℕ,
      BoxDistinct (3^s) a ∧ (∀ i, 0 < a i) ∧
      (∀ i, (a i : ℝ) ≤ ε * (3 : ℝ)^(n*s)) := by
  have hR' : 0 < (R : ℝ) := by exact_mod_cast hR
  have hD' : 0 < (D : ℝ) := by exact_mod_cast hD
  have hdet' : (-1 : ℝ)^n * (B.det : ℝ) = D := by exact_mod_cast hdet
  have hne : B.det ≠ 0 := by
    intro hzero
    rw [hzero, mul_zero] at hdet
    have : 0 < (D : ℤ) := by exact_mod_cast hD
    omega
  have hb : ∀ᶠ s : ℕ in atTop, ∀ i : Fin (n+1),
      0 < coeff B hB R s i ∧
      (coeff B hB R s i : ℝ) ≤ ε * (3 : ℝ)^(n*s) := by
    rw [eventually_all]
    intro i
    have hl := coeff_ratio_limit B hB hR i
    rw [hdet'] at hl
    have hlo := (tendsto_order.mp hl).1 0 (div_pos hD' (pow_pos hR' n))
    have hhi := (tendsto_order.mp hl).2 ε hε
    filter_upwards [hlo, hhi] with s hslo hshi
    have hpow : 0 < (3 : ℝ)^(n*s) := by positivity
    have hpos : (0 : ℝ) < (coeff B hB R s i : ℝ) := by
      have hh := (lt_div_iff₀ hpow).mp hslo
      simpa using hh
    exact ⟨by exact_mod_cast hpos, ((div_lt_iff₀ hpow).mp hshi).le⟩
  filter_upwards [hb] with s hs
  let a : Fin (n+1) → ℕ := fun i => (coeff B hB R s i).toNat
  have ha (i : Fin (n+1)) : (a i : ℤ) = coeff B hB R s i :=
    Int.toNat_of_nonneg (hs i).1.le
  have ht : errorCost B ≤ parameter B R s := by
    dsimp [parameter]
    omega
  have hbox : BoxDistinct (3^s) a :=
    perturb_box B hB hne hradius ht (parameter_radius B hR s) a ha
  refine ⟨a, hbox, ?_, ?_⟩
  · intro i
    have hi : (0 : ℤ) < (a i : ℤ) := by rw [ha]; exact (hs i).1
    exact_mod_cast hi
  · intro i
    have hc : (a i : ℝ) = (coeff B hB R s i : ℝ) := by exact_mod_cast ha i
    rw [hc]
    exact (hs i).2

/-- The lattice ingredients are the published Epoch AI / GPT-6 Astra proof.
The new conclusion allows an arbitrarily small coefficient at ternary scales. -/
theorem exists_ternary_box_family (ε : ℝ) (hε : 0 < ε) :
    ∃ n : ℕ, ∀ᶠ s : ℕ in atTop, ∃ a : Fin (n+1) → ℕ,
      BoxDistinct (3^s) a ∧ (∀ i, 0 < a i) ∧
      (∀ i, (a i : ℝ) ≤ ε * (3 : ℝ)^(n*s)) := by
  obtain ⟨k, hk⟩ := exists_nat_gt (1 / ε)
  obtain ⟨n, r, D, B, hB, hD, hdet, hradius, hsmall⟩ := low_determinant_family k
  have hk' : 0 < (k : ℝ) := lt_trans (div_pos zero_lt_one hε) hk
  have hR : 0 < (2^r : ℕ) := by positivity
  have hpow : 0 < ((2^r : ℕ) : ℝ)^n := by positivity
  have hsmall' : (k : ℝ) * (D : ℝ) < ((2^r : ℕ) : ℝ)^n := by
    have hn : k * D < (2^r)^n := by
      rw [← pow_mul, Nat.mul_comm r n]
      exact hsmall
    exact_mod_cast hn
  have hratio : (D : ℝ) / ((2^r : ℕ) : ℝ)^n < 1 / (k : ℝ) := by
    apply (div_lt_div_iff₀ hpow hk').mpr
    nlinarith
  have hkε : 1 / (k : ℝ) < ε := by
    apply (div_lt_iff₀ hk').mpr
    have hh := (div_lt_iff₀ hε).mp hk
    nlinarith
  refine ⟨n, eventual_ternary_box_family B hB hR hD hdet ?_ (hratio.trans hkε)⟩
  intro z hz
  simpa using hradius z hz

end Erdos817LatticeTransfer
