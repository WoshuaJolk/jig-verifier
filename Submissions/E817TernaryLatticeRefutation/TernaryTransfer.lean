/- BEGIN LOCAL MODULE Erdos817Digits -/
section
/- Ternary digit transfer for Erdős 817. The lattice and BoxDistinct
definitions are credited to the published Epoch AI / GPT-6 Astra E1 proof.
This file supplies the ternary expansion and exact three-AP-free bridge. -/

namespace Erdos817Digits

open Finset
open Submissions.Erdos1DistinctSubsetSumsRefuted.EpochPort
open Erdos1DigitBoxes

def subsetSums (A : Finset ℕ) : Set ℕ :=
  {x | ∃ B ⊆ A, ∑ a ∈ B, a = x}

def IsThreeAPFree (S : Set ℕ) : Prop :=
  ∀ x y z, x ∈ S → y ∈ S → z ∈ S → x + z = 2 * y → x = z

def ternaryValue {s : ℕ} (f : Fin s → Fin 3) : ℕ :=
  ∑ j, 3 ^ j.val * (f j).val

lemma ternaryValue_succ {s : ℕ} (f : Fin (s+1) → Fin 3) :
    ternaryValue f = (f 0).val + 3 * ternaryValue (fun j => f j.succ) := by
  simp only [ternaryValue, Fin.sum_univ_succ, Fin.val_zero, pow_zero, one_mul,
    Fin.val_succ, pow_succ, mul_sum]
  congr 1
  apply sum_congr rfl
  intro j _
  ring

lemma ternaryValue_lt {s : ℕ} (f : Fin s → Fin 3) : ternaryValue f < 3^s := by
  induction s with
  | zero => simp [ternaryValue]
  | succ s ih =>
    rw [ternaryValue_succ, pow_succ]
    have ht := ih (fun j => f j.succ)
    have h0 := (f 0).isLt
    omega

lemma ternaryValue_injective (s : ℕ) :
    Function.Injective (ternaryValue : (Fin s → Fin 3) → ℕ) := by
  induction s with
  | zero => intro f g _; funext i; exact Fin.elim0 i
  | succ s ih =>
    intro f g h
    rw [ternaryValue_succ, ternaryValue_succ] at h
    have hf := (f 0).isLt
    have hg := (g 0).isLt
    have h0 : (f 0).val = (g 0).val := by omega
    have ht : ternaryValue (fun j => f j.succ) = ternaryValue (fun j => g j.succ) := by
      omega
    have he := ih ht
    funext i
    refine Fin.cases ?_ (fun j => ?_) i
    · exact Fin.ext h0
    · exact congrFun he j

variable {α : Type} [Fintype α] [DecidableEq α]

def grouped {s : ℕ} (x : α × Fin s → Fin 3) (i : α) : Fin (3^s) :=
  ⟨ternaryValue (fun j => x (i,j)), ternaryValue_lt _⟩

lemma grouped_sum {s : ℕ} (a : α → ℕ) (x : α × Fin s → Fin 3) :
    (∑ i, (grouped x i).val * a i) =
      ∑ p, (x p).val * (3^p.2.val * a p.1) := by
  simp only [grouped, ternaryValue, sum_mul]
  rw [Fintype.sum_prod_type]
  apply sum_congr rfl
  intro i _
  apply sum_congr rfl
  intro j _
  ring

theorem ternary_expansion {s : ℕ} {a : α → ℕ} (ha : BoxDistinct (3^s) a) :
    BoxDistinct 3 (fun p : α × Fin s => 3^p.2.val * a p.1) := by
  intro x y h
  have hh : grouped x = grouped y := ha (by simpa only [grouped_sum] using h)
  funext p
  have hp := congrArg Fin.val (congrFun hh p.1)
  have he := ternaryValue_injective s hp
  exact congrFun he p.2

def indicator3 (U : Finset α) (i : α) : Fin 3 :=
  ⟨if i ∈ U then 1 else 0, by split <;> omega⟩

lemma indicator3_sum (a : α → ℕ) (U : Finset α) :
    (∑ i, (indicator3 U i).val * a i) = ∑ i ∈ U, a i := by
  simp [indicator3, ite_mul]

lemma indexed_of_box3 {a : α → ℕ} (ha : BoxDistinct 3 a) : IndexedDistinct a := by
  intro U V h
  have he : indicator3 U = indicator3 V := ha (by simpa only [indicator3_sum] using h)
  ext i
  have hi := congrArg Fin.val (congrFun he i)
  simp only [indicator3] at hi
  split_ifs at hi <;> simp_all

lemma image_ap_free {a : α → ℕ} (ha : BoxDistinct 3 a) :
    IsThreeAPFree (subsetSums (univ.image a)) := by
  have hi := indexed_of_box3 ha
  intro x y z hx hy hz hxyz
  obtain ⟨U,hU,hUx⟩ := hx
  obtain ⟨V,hV,hVy⟩ := hy
  obtain ⟨W,hW,hWz⟩ := hz
  obtain ⟨U',hU',heU⟩ := subset_image_iff.mp hU
  obtain ⟨V',hV',heV⟩ := subset_image_iff.mp hV
  obtain ⟨W',hW',heW⟩ := subset_image_iff.mp hW
  have hUx' : (∑ i ∈ U', a i) = x := by
    rw [← heU, sum_image hi.injective.injOn] at hUx
    exact hUx
  have hVy' : (∑ i ∈ V', a i) = y := by
    rw [← heV, sum_image hi.injective.injOn] at hVy
    exact hVy
  have hWz' : (∑ i ∈ W', a i) = z := by
    rw [← heW, sum_image hi.injective.injOn] at hWz
    exact hWz
  let left : α → Fin 3 := fun i =>
    ⟨(if i ∈ U' then 1 else 0) + (if i ∈ W' then 1 else 0), by split_ifs <;> omega⟩
  let right : α → Fin 3 := fun i =>
    ⟨2 * (if i ∈ V' then 1 else 0), by split_ifs <;> omega⟩
  have hl : (∑ i, (left i).val * a i) = x + z := by
    simp only [left, add_mul, sum_add_distrib]
    simpa [ite_mul] using congrArg₂ (· + ·) hUx' hWz'
  have hr : (∑ i, (right i).val * a i) = 2 * y := by
    simp only [right, mul_assoc, ← mul_sum]
    simpa [ite_mul] using hVy'
  have he : left = right := ha (by
    change (∑ i, (left i).val * a i) = ∑ i, (right i).val * a i
    rw [hl,hr,hxyz])
  have hUW : U' = W' := by
    ext i
    have hc := congrArg Fin.val (congrFun he i)
    simp only [left,right] at hc
    split_ifs at hc <;> simp_all
  rw [← hUx', ← hWz', hUW]

theorem expanded_set {s : ℕ} (hs : 0 < s) {a : α → ℕ}
    (ha : BoxDistinct (3^s) a) :
    ∃ A : Finset ℕ, A.card = Fintype.card α * s ∧
      IsThreeAPFree (subsetSums A) ∧
      (∀ x ∈ A, 0 < x ∧ ∃ i : α, ∃ j : Fin s, x = 3^j.val * a i) := by
  let b : α × Fin s → ℕ := fun p => 3^p.2.val * a p.1
  have hb : BoxDistinct 3 b := ternary_expansion ha
  have hi := indexed_of_box3 hb
  refine ⟨univ.image b, ?_, image_ap_free hb, ?_⟩
  · rw [card_image_of_injective _ hi.injective]
    simp
  · intro x hx
    obtain ⟨p,_,rfl⟩ := mem_image.mp hx
    exact ⟨hi.positive p, p.1,p.2,rfl⟩

end Erdos817Digits
end
