/- BEGIN LOCAL MODULE Erdos817Root -/
section
/-!
Faithful local definitions for Jig175 / E817 and its asymptotic refutation bridge.
No `Statements` import is used. The construction hypothesis explicitly supplies
arbitrarily large cardinalities; a single small finite witness cannot discharge it.
-/

namespace Erdos817Root

open Filter

def subsetSums (A : Finset ℕ) : Set ℕ :=
  {x | ∃ B ⊆ A, ∑ a ∈ B, a = x}

def IsThreeAPFree (S : Set ℕ) : Prop :=
  ∀ x y z, x ∈ S → y ∈ S → z ∈ S → x + z = 2 * y → x = z

def Admissible (n N : ℕ) : Prop :=
  ∃ A : Finset ℕ, A ⊆ Finset.Icc 1 N ∧ A.card = n ∧
    IsThreeAPFree (subsetSums A)

noncomputable def g (n : ℕ) : ℕ :=
  sInf {N | Admissible n N}

abbrev statement : Prop :=
  (fun n : ℕ ↦ (3 ^ n : ℝ)) =O[atTop] fun n ↦ (g n : ℝ)

theorem g_le_of_admissible {n N : ℕ} (h : Admissible n N) : g n ≤ N :=
  Nat.sInf_le h

theorem not_statement_of_small_admissible
    (h : ∀ ε : ℝ, 0 < ε → ∀ K : ℕ, ∃ n N : ℕ,
      K ≤ n ∧ Admissible n N ∧ (N : ℝ) ≤ ε * (3 : ℝ) ^ n) :
    ¬ statement := by
  intro hO
  obtain ⟨C, hC, hbound⟩ := hO.exists_pos
  obtain ⟨K, hK⟩ := Filter.eventually_atTop.mp hbound.bound
  obtain ⟨n, N, hn, hA, hN⟩ := h ((2 * C)⁻¹) (by positivity) K
  have hgn : (g n : ℝ) ≤ N := by exact_mod_cast g_le_of_admissible hA
  have hp : 0 < (3 : ℝ) ^ n := by positivity
  have hb := hK n hn
  simp only [Real.norm_eq_abs, abs_of_nonneg (le_of_lt hp),
    abs_of_nonneg (show (0 : ℝ) ≤ (g n : ℝ) by positivity)] at hb
  have hm := mul_le_mul_of_nonneg_left (hgn.trans hN) hC.le
  have hcancel : C * (2 * C)⁻¹ = (1 / 2 : ℝ) := by
    field_simp
  rw [← mul_assoc, hcancel] at hm
  linarith

theorem not_statement_of_small_sets
    (h : ∀ ε : ℝ, 0 < ε → ∀ K : ℕ, ∃ A : Finset ℕ,
      K ≤ A.card ∧ IsThreeAPFree (subsetSums A) ∧
      ∀ a ∈ A, 0 < a ∧ (a : ℝ) ≤ ε * (3 : ℝ) ^ A.card) :
    ¬ statement := by
  apply not_statement_of_small_admissible
  intro ε hε K
  obtain ⟨A, hcard, hAP, hbound⟩ := h ε hε (K + 1)
  have hne : A.Nonempty := Finset.card_pos.mp (by omega)
  refine ⟨A.card, A.max' hne, by omega, ?_, ?_⟩
  · refine ⟨A, ?_, rfl, hAP⟩
    intro a ha
    exact Finset.mem_Icc.mpr ⟨(hbound a ha).1, A.le_max' a ha⟩
  · exact (hbound _ (A.max'_mem hne)).2

theorem not_statement_of_eventual_families
    (h : ∀ ε : ℝ, 0 < ε → ∃ k : ℕ, 0 < k ∧
      ∀ᶠ s : ℕ in atTop, ∃ A : Finset ℕ,
        A.card = k * s ∧ IsThreeAPFree (subsetSums A) ∧
        ∀ a ∈ A, 0 < a ∧ (a : ℝ) ≤ ε * (3 : ℝ) ^ (k * s)) :
    ¬ statement := by
  apply not_statement_of_small_sets
  intro ε hε K
  obtain ⟨k, hk, hfamily⟩ := h ε hε
  obtain ⟨S, hS⟩ := Filter.eventually_atTop.mp hfamily
  obtain ⟨A, hcard, hAP, hbound⟩ := hS (max S K) (le_max_left _ _)
  refine ⟨A, ?_, hAP, ?_⟩
  · rw [hcard]
    calc
      K ≤ max S K := le_max_right _ _
      _ ≤ k * max S K := Nat.le_mul_of_pos_left _ hk
  · simpa only [hcard] using hbound

theorem not_statement_of_box_families
    (h : ∀ ε : ℝ, 0 < ε → ∃ n : ℕ,
      ∀ᶠ s : ℕ in atTop, ∃ a : Fin (n + 1) → ℕ,
        Submissions.Erdos1DistinctSubsetSumsRefuted.EpochPort.Erdos1DigitBoxes.BoxDistinct
          (3 ^ s) a ∧
        (∀ i, 0 < a i) ∧
        (∀ i, (a i : ℝ) ≤ ε * (3 : ℝ) ^ (n * s))) :
    ¬ statement := by
  apply not_statement_of_eventual_families
  intro ε hε
  obtain ⟨n, hfamily⟩ := h ε hε
  refine ⟨n + 1, Nat.succ_pos _, ?_⟩
  filter_upwards [hfamily, eventually_gt_atTop (0 : ℕ)] with s hfamily hs
  obtain ⟨a, hbox, _hpositive, hbound⟩ := hfamily
  obtain ⟨A, hcard, hAP, hrepr⟩ := Erdos817Digits.expanded_set hs hbox
  refine ⟨A, by simpa using hcard, hAP, ?_⟩
  intro x hx
  obtain ⟨hxpos, i, j, hxrepr⟩ := hrepr x hx
  refine ⟨hxpos, ?_⟩
  have hpow : (3 : ℝ) ^ j.val ≤ (3 : ℝ) ^ s :=
    pow_le_pow_right₀ (by norm_num) (Nat.le_of_lt j.isLt)
  calc
    (x : ℝ) = (3 : ℝ) ^ j.val * (a i : ℝ) := by
      rw [hxrepr]
      push_cast
      rfl
    _ ≤ (3 : ℝ) ^ s * (ε * (3 : ℝ) ^ (n * s)) :=
      mul_le_mul hpow (hbound i) (Nat.cast_nonneg _) (by positivity)
    _ = ε * (3 : ℝ) ^ ((n + 1) * s) := by
      rw [Nat.add_mul, one_mul, pow_add]
      ring

/-- Refutation of the literal eventual Big-O statement, using the credited
Epoch lattice construction through its ternary-scale transfer. -/
theorem proof : ¬ statement :=
  not_statement_of_box_families Erdos817LatticeTransfer.exists_ternary_box_family

end Erdos817Root
end
