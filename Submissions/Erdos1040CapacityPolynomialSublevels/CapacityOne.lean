/- BEGIN LOCAL MODULE Erdos1040HilbertApproximation -/
section
/-!
Hilbert-space closure and bounded-density approximation. The mass-functional
alternative records that if mass-zero annihilators vanish on all harmonic
polynomials, then at most one scalar centering condition remains. It does not
assume an equilibrium potential or polar-boundary uniqueness theorem.
-/

open MeasureTheory Set
open scoped ENNReal Topology

namespace Erdos1040HilbertApproximation

variable {X E : Type*} [NormedAddCommGroup X] [NormedSpace ℝ X]
  [NormedAddCommGroup E] [InnerProductSpace ℝ E] [CompleteSpace E]

/-- The concrete annihilator criterion for membership in the closure of the
range of a continuous linear operator into a real Hilbert space. -/
theorem mem_closure_range_of_annihilator (T : X →L[ℝ] E) (u : E)
    (hu : ∀ v : E, (∀ x, inner ℝ v (T x) = 0) → inner ℝ v u = 0) :
    u ∈ closure (Set.range T) := by
  let S : Submodule ℝ E := LinearMap.range T.toLinearMap
  change u ∈ (S.topologicalClosure : Set E)
  rw [← S.orthogonal_orthogonal_eq_closure]
  apply (Sᗮ.mem_orthogonal u).mpr
  intro v hv
  apply hu v
  intro x
  exact (S.mem_orthogonal' v).mp hv (T x) ⟨x, rfl⟩

omit [CompleteSpace E] in
/-- Once a normalized annihilator exists, all pairings on the test family
factor through the mass of the annihilator. -/
theorem annihilator_pairing_factors_through_mass
    (T : X →L[ℝ] E) (mass : E →ₗ[ℝ] ℝ) (P : Set E)
    (hzero : ∀ v : E, (∀ x, inner ℝ v (T x) = 0) → mass v = 0 →
      ∀ u ∈ P, inner ℝ v u = 0)
    (v₀ : E) (hv₀ : ∀ x, inner ℝ v₀ (T x) = 0) (hm₀ : mass v₀ = 1)
    (v : E) (hv : ∀ x, inner ℝ v (T x) = 0) (u : E) (hu : u ∈ P) :
    inner ℝ v u = mass v * inner ℝ v₀ u := by
  have hg : ∀ x, inner ℝ (v - mass v • v₀) (T x) = 0 := by
    intro x
    rw [inner_sub_left, real_inner_smul_left, hv x, hv₀ x, mul_zero, sub_zero]
  have hgm : mass (v - mass v • v₀) = 0 := by
    rw [map_sub, map_smul, hm₀]
    simp only [smul_eq_mul, mul_one, sub_self]
  have hpair := hzero (v - mass v • v₀) hg hgm u hu
  rw [inner_sub_left, real_inner_smul_left] at hpair
  exact sub_eq_zero.mp hpair

/-- Either the entire test family is approximable, or a single normalized
annihilator supplies the centering functional. No positivity of that functional
is asserted or required. -/
theorem mass_centering_alternative
    (T : X →L[ℝ] E) (mass : E →ₗ[ℝ] ℝ) (P : Set E)
    (hzero : ∀ v : E, (∀ x, inner ℝ v (T x) = 0) → mass v = 0 →
      ∀ u ∈ P, inner ℝ v u = 0) :
    (∀ u ∈ P, u ∈ closure (Set.range T)) ∨
    ∃ v₀ : E, (∀ x, inner ℝ v₀ (T x) = 0) ∧ mass v₀ = 1 ∧
      ∀ u ∈ P, inner ℝ v₀ u = 0 → u ∈ closure (Set.range T) := by
  classical
  by_cases hall : ∀ v : E, (∀ x, inner ℝ v (T x) = 0) → mass v = 0
  · left
    intro u hu
    exact mem_closure_range_of_annihilator T u
      (fun v hv ↦ hzero v hv (hall v hv) u hu)
  · right
    push Not at hall
    obtain ⟨v, hv, hm⟩ := hall
    let v₀ : E := (mass v)⁻¹ • v
    have hv₀ : ∀ x, inner ℝ v₀ (T x) = 0 := by
      intro x
      rw [real_inner_smul_left, hv x, mul_zero]
    have hm₀ : mass v₀ = 1 := by
      rw [map_smul]
      exact inv_mul_cancel₀ hm
    refine ⟨v₀, hv₀, hm₀, ?_⟩
    intro u hu hcenter
    apply mem_closure_range_of_annihilator T u
    intro w hw
    rw [annihilator_pairing_factors_through_mass T mass P hzero v₀ hv₀ hm₀ w hw u hu,
      hcenter, mul_zero]

section BoundedSource

variable {α : Type*} [MeasurableSpace α] {μ : Measure α}

theorem exists_simpleLp_approx (f : Lp ℝ 2 μ) {ε : ℝ} (hε : 0 < ε) :
    ∃ s : MeasureTheory.SimpleFunc α ℝ, ∃ hs : MemLp s 2 μ, ‖f - hs.toLp s‖ < ε := by
  obtain ⟨s, hsclose, hs⟩ := (Lp.memLp f).exists_simpleFunc_eLpNorm_sub_lt
    (by norm_num : (2 : ℝ≥0∞) ≠ ∞) (ENNReal.ofReal_ne_zero_iff.mpr hε)
  refine ⟨s, hs, ?_⟩
  have hrep : (⇑(f - hs.toLp s)) =ᵐ[μ] fun x ↦ f x - s x := by
    filter_upwards [Lp.coeFn_sub f (hs.toLp s), hs.coeFn_toLp] with x ha hb
    simpa only [Pi.sub_apply, hb] using ha
  rw [Lp.norm_def, eLpNorm_congr_ae hrep]
  exact ENNReal.toReal_lt_of_lt_ofReal hsclose

/-- Every vector in the closure of the operator range is approximable using
actual measurable simple functions as source densities. -/
theorem exists_simpleFunc_operator_approx
    (T : Lp ℝ 2 μ →L[ℝ] E) (u : E) (hu : u ∈ closure (Set.range T))
    {ε : ℝ} (hε : 0 < ε) :
    ∃ s : MeasureTheory.SimpleFunc α ℝ, ∃ hs : MemLp s 2 μ, ‖T (hs.toLp s) - u‖ < ε := by
  obtain ⟨y, ⟨h, rfl⟩, hclose⟩ := Metric.mem_closure_iff.mp hu (ε / 2) (half_pos hε)
  have hh : ‖T h - u‖ < ε / 2 := by
    simpa only [dist_eq_norm, norm_sub_rev] using hclose
  let δ : ℝ := (ε / 2) / (‖T‖ + 1)
  have hfac : 0 < ‖T‖ + 1 := by positivity
  have hδ : 0 < δ := div_pos (half_pos hε) hfac
  obtain ⟨s, hs, hsclose⟩ := exists_simpleLp_approx h hδ
  refine ⟨s, hs, ?_⟩
  have hop : ‖T (hs.toLp s) - T h‖ < ε / 2 := by
    calc
      ‖T (hs.toLp s) - T h‖ = ‖T (hs.toLp s - h)‖ := by rw [map_sub]
      _ ≤ ‖T‖ * ‖hs.toLp s - h‖ := T.le_opNorm _
      _ ≤ (‖T‖ + 1) * ‖hs.toLp s - h‖ := by
        gcongr
        linarith
      _ < (‖T‖ + 1) * δ := mul_lt_mul_of_pos_left (by
        simpa only [norm_sub_rev] using hsclose) hfac
      _ = ε / 2 := by dsimp [δ]; field_simp
  calc
    ‖T (hs.toLp s) - u‖ ≤ ‖T (hs.toLp s) - T h‖ + ‖T h - u‖ := by
      simpa only [dist_eq_norm] using dist_triangle (T (hs.toLp s)) (T h) u
    _ < ε := by linarith

/-- The annihilator argument produces a globally bounded measurable scalar
density whose actual Bochner potential approximates the desired target. -/
theorem exists_bounded_kernel_approx_of_annihilator [IsProbabilityMeasure μ]
    {K : α → E} {B : ℝ}
    (hK : AEStronglyMeasurable K μ) (hB : ∀ᵐ x ∂μ, ‖K x‖ ≤ B) (u : E)
    (hu : ∀ v : E, (∀ h : Lp ℝ 2 μ,
      inner ℝ v (CampaignAnalysis277Kernel.kernelL2Operator hK hB h) = 0) →
      inner ℝ v u = 0) {ε : ℝ} (hε : 0 < ε) :
    ∃ h : α → ℝ, Measurable h ∧ (∃ C : ℝ, ∀ x, ‖h x‖ ≤ C) ∧
      ‖(∫ x, h x • K x ∂μ) - u‖ < ε := by
  let T := CampaignAnalysis277Kernel.kernelL2Operator hK hB
  obtain ⟨s, hs, hclose⟩ := exists_simpleFunc_operator_approx T u
    (mem_closure_range_of_annihilator T u hu) hε
  refine ⟨s, s.measurable, s.exists_forall_norm_le, ?_⟩
  have heq : T (hs.toLp s) = ∫ x, s x • K x ∂μ := by
    rw [CampaignAnalysis277Kernel.kernelL2Operator_apply]
    apply integral_congr_ae
    filter_upwards [hs.coeFn_toLp] with x hx
    rw [hx]
  rwa [heq] at hclose

end BoundedSource


end Erdos1040HilbertApproximation
end
/- END LOCAL MODULE Erdos1040HilbertApproximation -/

/- BEGIN LOCAL MODULE Erdos1040DualApproximation -/
section
/-! Concrete area-charge duality for the planar logarithmic kernel. -/

open Set Filter MeasureTheory InnerProductSpace
open scoped Topology

namespace Erdos1040DualApproximation

open Erdos1040LogKernel CampaignAnalysis277Kernel

variable {H : Set ℂ}

/-- The scalar dual potential is exactly the Hilbert pairing with the actual
logarithmic L² kernel. -/
theorem inner_logKernel (hH : IsCompact H) (f : Lp ℝ 2 (volume.restrict H)) (w : ℂ) :
    inner ℝ f (logKernel H hH.isBounded w) =
      ∫ z in H, f z * Real.log ‖w - z‖ := by
  rw [logKernel, inner_toLp_eq_integral_mul]
  simp only [norm_sub_rev]

theorem continuous_dualPotential (hH : IsCompact H) (f : Lp ℝ 2 (volume.restrict H)) :
    Continuous (fun w : ℂ ↦ ∫ z in H, f z * Real.log ‖w - z‖) := by
  simpa only [inner_logKernel hH f] using
    continuous_dual_kernel (continuous_logKernel H hH.isBounded hH.measurableSet) f

theorem integrableOn_areaCharge (hH : IsCompact H) (f : Lp ℝ 2 (volume.restrict H)) :
    IntegrableOn f H := by
  let : IsFiniteMeasure (volume.restrict H) := isFiniteMeasure_restrict.mpr hH.measure_ne_top
  exact (Lp.memLp f).integrable (by norm_num)

/-- The exterior uniqueness and Cauchy moment theorems discharge the analytic
input to the mass-centering alternative for actual area L² charges. -/
theorem polynomial_pairing_zero_of_mass_zero_boundary_zero (hH : IsCompact H)
    (hconn : IsPreconnected Hᶜ) (f : Lp ℝ 2 (volume.restrict H))
    (hmass : (∫ z in H, f z) = 0)
    (hboundary : ∀ w ∈ frontier H, ∫ z in H, f z * Real.log ‖w - z‖ = 0)
    (p : Polynomial ℂ) : (∫ z in H, f z * (p.eval z).re) = 0 := by
  have hf := integrableOn_areaCharge hH f
  have hlim : Tendsto (fun w : ℂ ↦ ∫ z in H, f z * Real.log ‖w - z‖)
      (cocompact ℂ) (𝓝 0) := by
    simpa only [hmass, zero_mul, sub_zero] using
      Erdos1040PotentialDecay.tendsto_potential_sub_mass_log hH hf
  have hext := Erdos1040ExteriorMaximum.eq_zero_of_zero_boundary_tendsto_zero hH hconn
    (Erdos1040HarmonicPotential.harmonicOnNhd_potential_compl hH hf)
    (continuous_dualPotential hH f).continuousOn hboundary hlim
  have hh := Erdos1040CauchyTransform.real_polynomial_integrals_eq_of_potential_eq hH hf
    (show IntegrableOn (fun _ : ℂ ↦ (0 : ℝ)) H (volume : Measure ℂ) from integrable_zero _ _ _)
    (fun w hw ↦ by simpa only [zero_mul, integral_zero] using hext w hw) p
  simpa only [zero_mul, integral_zero] using hh

/-- An operator annihilator has zero potential on the actual support of the
source measure. This does not assume that the source has full support on the
original compact root set. -/
theorem dualPotential_zero_on_support (hH : IsCompact H)
    (ν : Measure ℂ) [IsProbabilityMeasure ν] {B : ℝ}
    (hK : AEStronglyMeasurable (logKernel H hH.isBounded) ν)
    (hB : ∀ᵐ w ∂ν, ‖logKernel H hH.isBounded w‖ ≤ B)
    (f : Lp ℝ 2 (volume.restrict H))
    (hf : ∀ h : Lp ℝ 2 ν, inner ℝ f (kernelL2Operator hK hB h) = 0) :
    ∀ w ∈ ν.support, ∫ z in H, f z * Real.log ‖w - z‖ = 0 := by
  have hae := dual_kernel_eq_zero_ae_of_orthogonal hK hB f hf
  have hclosed : IsClosed {w : ℂ | inner ℝ f (logKernel H hH.isBounded w) = 0} :=
    isClosed_eq (continuous_dual_kernel
      (continuous_logKernel H hH.isBounded hH.measurableSet) f) continuous_const
  intro w hw
  simpa only [mem_ofPred_eq, inner_logKernel hH f] using
    ν.support_subset_of_isClosed hclosed hae hw

/-- Every zero-mass annihilator of the actual source operator pairs to zero
with every harmonic polynomial on the filled support hull. -/
theorem polynomial_pairing_zero_of_zero_mass_annihilator (hH : IsCompact H)
    (hconn : IsPreconnected Hᶜ) (ν : Measure ℂ) [IsProbabilityMeasure ν]
    (hfrontier : frontier H ⊆ ν.support) {B : ℝ}
    (hK : AEStronglyMeasurable (logKernel H hH.isBounded) ν)
    (hB : ∀ᵐ w ∂ν, ‖logKernel H hH.isBounded w‖ ≤ B)
    (f : Lp ℝ 2 (volume.restrict H))
    (hf : ∀ h : Lp ℝ 2 ν, inner ℝ f (kernelL2Operator hK hB h) = 0)
    (hmass : (∫ z in H, f z) = 0) (p : Polynomial ℂ) :
    (∫ z in H, f z * (p.eval z).re) = 0 :=
  polynomial_pairing_zero_of_mass_zero_boundary_zero hH hconn f hmass
    (fun w hw ↦ dualPotential_zero_on_support hH ν hK hB f hf w (hfrontier hw)) p

/-- Real parts of complex polynomials define actual area L² vectors. -/
theorem polynomial_memLp (hH : IsCompact H) (p : Polynomial ℂ) :
    MemLp (fun z : ℂ ↦ (p.eval z).re) 2 (volume.restrict H) := by
  let : IsFiniteMeasure (volume.restrict H) := isFiniteMeasure_restrict.mpr hH.measure_ne_top
  have hc : Continuous (fun z : ℂ ↦ (p.eval z).re) := Complex.continuous_re.comp p.continuous
  obtain ⟨B, hB⟩ := (hH.image hc).isBounded.exists_norm_le
  have hb : ∀ᵐ z ∂(volume.restrict H), ‖(p.eval z).re‖ ≤ B := by
    filter_upwards [self_mem_ae_restrict hH.measurableSet] with z hz
    exact hB _ (mem_image_of_mem _ hz)
  exact (memLp_top_of_bound hc.aestronglyMeasurable B hb).mono_exponent le_top

noncomputable def polynomialLp (hH : IsCompact H) (p : Polynomial ℂ) :
    Lp ℝ 2 (volume.restrict H) :=
  (polynomial_memLp hH p).toLp (fun z : ℂ ↦ (p.eval z).re)

theorem inner_polynomialLp (hH : IsCompact H) (f : Lp ℝ 2 (volume.restrict H))
    (p : Polynomial ℂ) :
    inner ℝ f (polynomialLp hH p) = ∫ z in H, f z * (p.eval z).re :=
  inner_toLp_eq_integral_mul f (polynomial_memLp hH p)

/-- The mass of an area L² vector as an actual linear functional. -/
noncomputable def mass (hH : IsCompact H) : Lp ℝ 2 (volume.restrict H) →ₗ[ℝ] ℝ :=
  (innerSL ℝ (polynomialLp hH 1)).toLinearMap

theorem mass_apply (hH : IsCompact H) (f : Lp ℝ 2 (volume.restrict H)) :
    mass hH f = ∫ z in H, f z := by
  change inner ℝ (polynomialLp hH 1) f = _
  rw [real_inner_comm, inner_polynomialLp]
  simp

/-- The actual logarithmic source operator has at most one scalar obstruction
on harmonic polynomials. The analytic input is proved above, rather than
assumed as an abstract orthogonality condition. -/
theorem polynomial_closure_mass_alternative (hH : IsCompact H)
    (hconn : IsPreconnected Hᶜ) (ν : Measure ℂ) [IsProbabilityMeasure ν]
    (hfrontier : frontier H ⊆ ν.support) {B : ℝ}
    (hK : AEStronglyMeasurable (logKernel H hH.isBounded) ν)
    (hB : ∀ᵐ w ∂ν, ‖logKernel H hH.isBounded w‖ ≤ B) :
    (∀ p : Polynomial ℂ, polynomialLp hH p ∈ closure (Set.range (kernelL2Operator hK hB))) ∨
    ∃ f₀ : Lp ℝ 2 (volume.restrict H),
      (∀ h : Lp ℝ 2 ν, inner ℝ f₀ (kernelL2Operator hK hB h) = 0) ∧
      (∫ z in H, f₀ z) = 1 ∧
      ∀ p : Polynomial ℂ, (∫ z in H, f₀ z * (p.eval z).re) = 0 →
        polynomialLp hH p ∈ closure (Set.range (kernelL2Operator hK hB)) := by
  have hzero : ∀ f : Lp ℝ 2 (volume.restrict H),
      (∀ h : Lp ℝ 2 ν, inner ℝ f (kernelL2Operator hK hB h) = 0) → mass hH f = 0 →
      ∀ u ∈ Set.range (polynomialLp hH), inner ℝ f u = 0 := by
    intro f hf hm u hu
    obtain ⟨p, rfl⟩ := hu
    rw [inner_polynomialLp]
    exact polynomial_pairing_zero_of_zero_mass_annihilator hH hconn ν hfrontier hK hB f hf
      (by rwa [mass_apply] at hm) p
  obtain hall | ⟨f₀, hf₀, hm₀, hcenter⟩ :=
    Erdos1040HilbertApproximation.mass_centering_alternative
      (kernelL2Operator hK hB) (mass hH) (Set.range (polynomialLp hH)) hzero
  · exact Or.inl (fun p ↦ hall _ ⟨p, rfl⟩)
  · refine Or.inr ⟨f₀, hf₀, ?_, ?_⟩
    · rwa [mass_apply] at hm₀
    · intro p hp
      exact hcenter _ ⟨p, rfl⟩ (by rwa [inner_polynomialLp])

/-- A polynomial in the actual operator-range closure can be approximated by
a globally bounded measurable scalar source density. -/
theorem exists_bounded_density_approx (hH : IsCompact H)
    (ν : Measure ℂ) [IsProbabilityMeasure ν] {B : ℝ}
    (hK : AEStronglyMeasurable (logKernel H hH.isBounded) ν)
    (hB : ∀ᵐ w ∂ν, ‖logKernel H hH.isBounded w‖ ≤ B) (p : Polynomial ℂ)
    (hp : polynomialLp hH p ∈ closure (Set.range (kernelL2Operator hK hB)))
    {ε : ℝ} (hε : 0 < ε) :
    ∃ h : ℂ → ℝ, Measurable h ∧ (∃ C : ℝ, ∀ w, ‖h w‖ ≤ C) ∧
      ‖(∫ w, h w • logKernel H hH.isBounded w ∂ν) - polynomialLp hH p‖ < ε := by
  obtain ⟨s, hs, hclose⟩ := Erdos1040HilbertApproximation.exists_simpleFunc_operator_approx
    (kernelL2Operator hK hB) (polynomialLp hH p) hp hε
  refine ⟨s, s.measurable, s.exists_forall_norm_le, ?_⟩
  have heq : kernelL2Operator hK hB (hs.toLp s) =
      ∫ w, s w • logKernel H hH.isBounded w ∂ν := by
    rw [kernelL2Operator_apply]
    apply integral_congr_ae
    filter_upwards [hs.coeFn_toLp] with w hw
    rw [hw]
  rwa [heq] at hclose


end Erdos1040DualApproximation
end
/- END LOCAL MODULE Erdos1040DualApproximation -/

/- BEGIN LOCAL MODULE Erdos1040Empirical -/
section
/-!
Equal-weight approximation of Banach-valued integrals. This is an unconditional
foundation lemma for the deterministic discretization step in the proposed
Erdős 1040(ii) argument; it does not assert the full Erdős theorem.
-/

open MeasureTheory Filter Set
open scoped Topology BigOperators

namespace Erdos1040Empirical

variable {E : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E]

/-- Every finite convex combination is approximable by a mean with equal weights.
The proof rounds the weights down after dilation and normalizes their total. -/
theorem exists_mean_of_mem_convexHull {s : Set E} {v : E}
    (hv : v ∈ convexHull ℝ s) {ε : ℝ} (hε : 0 < ε) :
    ∃ (N : ℕ) (_ : 0 < N) (z : Fin N → E),
      (∀ i, z i ∈ s) ∧ ‖(N : ℝ)⁻¹ • (∑ i, z i) - v‖ < ε := by
  classical
  obtain ⟨ι, hι, w, z, hw, hw1, hz, hwz⟩ :=
    mem_convexHull_iff_exists_fintype.mp hv
  let := hι
  let a (t : ℝ) (i : ι) : ℝ := (⌊w i * t⌋₊ : ℝ) / t
  let A (t : ℝ) : ℝ := ∑ i, a t i
  let B (t : ℝ) : E := ∑ i, a t i • z i
  have ha (i : ι) : Tendsto (fun t => a t i) atTop (𝓝 (w i)) :=
    tendsto_nat_floor_mul_div_atTop (hw i)
  have hA : Tendsto A atTop (𝓝 1) := by
    simpa [A, hw1] using tendsto_finsetSum Finset.univ (fun i _ => ha i)
  have hB : Tendsto B atTop (𝓝 v) := by
    simpa [B, hwz] using
      tendsto_finsetSum Finset.univ (fun i _ => (ha i).smul_const (z i))
  have hAB : Tendsto (fun t => (A t)⁻¹ • B t) atTop (𝓝 v) := by
    simpa using (hA.inv₀ (by norm_num : (1 : ℝ) ≠ 0)).smul hB
  have hclose : ∀ᶠ t in atTop, ‖(A t)⁻¹ • B t - v‖ < ε := by
    apply hAB.eventually (p := fun y : E => ‖y - v‖ < ε)
    change {y : E | ‖y - v‖ < ε} ∈ 𝓝 v
    simpa only [Metric.ball, dist_eq_norm] using (Metric.ball_mem_nhds v hε)
  have hpos : ∀ᶠ t in atTop, 0 < A t := hA.eventually (Ioi_mem_nhds (by norm_num))
  obtain ⟨t, ht, hAt, hct⟩ := (eventually_gt_atTop (0 : ℝ) |>.and (hpos.and hclose)).exists
  let n (i : ι) : ℕ := ⌊w i * t⌋₊
  let J := (i : ι) × Fin (n i)
  let : Fintype J := inferInstance
  have hcard : (Fintype.card J : ℝ) = ∑ i, (n i : ℝ) := by
    simp [J, Fintype.card_sigma]
  have hAeq : A t = (Fintype.card J : ℝ) / t := by
    simp only [A, a, ← Finset.sum_div, hcard, n]
  have hJ : 0 < Fintype.card J := by
    have : 0 < (Fintype.card J : ℝ) := (div_pos_iff.mp (hAeq ▸ hAt)).resolve_right
      (by intro h; linarith [h.2]) |>.1
    exact_mod_cast this
  have hsum : (∑ j : J, z j.1) = ∑ i, (n i : ℝ) • z i := by
    simp [J, Fintype.sum_sigma, Nat.cast_smul_eq_nsmul ℝ]
  have hBeq : B t = t⁻¹ • (∑ j : J, z j.1) := by
    rw [hsum, Finset.smul_sum]
    apply Finset.sum_congr rfl
    intro i _
    simp [a, n, div_eq_mul_inv, mul_smul, mul_comm]
  have hmean : (A t)⁻¹ • B t = (Fintype.card J : ℝ)⁻¹ • (∑ j : J, z j.1) := by
    rw [hBeq, hAeq, smul_smul]
    congr 1
    field_simp [ht.ne']
  let e := Fintype.equivFin J
  refine ⟨Fintype.card J, hJ, fun i => z (e.symm i).1, fun i => hz _, ?_⟩
  rw [e.symm.sum_comp (fun j : J => z j.1)]
  exact hmean ▸ hct

/-- Every point of a closed convex hull is approximable by a finite equal-weight mean. -/
theorem exists_mean_of_mem_closedConvexHull {s : Set E} {v : E}
    (hv : v ∈ closedConvexHull ℝ s) {ε : ℝ} (hε : 0 < ε) :
    ∃ (N : ℕ) (_ : 0 < N) (z : Fin N → E),
      (∀ i, z i ∈ s) ∧ ‖(N : ℝ)⁻¹ • (∑ i, z i) - v‖ < ε := by
  rw [closedConvexHull_eq_closure_convexHull] at hv
  obtain ⟨y, hy, hyclose⟩ := Metric.mem_closure_iff.mp hv (ε / 2) (by positivity)
  obtain ⟨N, hN, z, hz, hzclose⟩ := exists_mean_of_mem_convexHull hy (half_pos hε)
  refine ⟨N, hN, z, hz, ?_⟩
  have hyclose' : ‖y - v‖ < ε / 2 := by simpa [dist_eq_norm, norm_sub_rev] using hyclose
  calc
    ‖(N : ℝ)⁻¹ • (∑ i, z i) - v‖ ≤
        ‖(N : ℝ)⁻¹ • (∑ i, z i) - y‖ + ‖y - v‖ := by
          simpa only [dist_eq_norm] using
            (dist_triangle ((N : ℝ)⁻¹ • (∑ i, z i)) y v)
    _ < ε := by linarith

/-- Every integrable function on a probability space has arbitrarily accurate
finite empirical means, using points of the original domain. -/
theorem exists_empirical_mean {X : Type*} [MeasurableSpace X]
    {μ : Measure X} [IsProbabilityMeasure μ] [CompleteSpace E]
    {f : X → E} (hf : Integrable f μ) {ε : ℝ} (hε : 0 < ε) :
    ∃ (N : ℕ) (_ : 0 < N) (x : Fin N → X),
      ‖(N : ℝ)⁻¹ • (∑ i, f (x i)) - ∫ y, f y ∂μ‖ < ε := by
  have hint : (∫ y, f y ∂μ) ∈ closedConvexHull ℝ (Set.range f) :=
    convex_closedConvexHull.integral_mem isClosed_closedConvexHull
      (Filter.Eventually.of_forall fun x => subset_closedConvexHull (Set.mem_range_self x)) hf
  obtain ⟨N, hN, z, hz, hclose⟩ := exists_mean_of_mem_closedConvexHull hint hε
  choose x hx using hz
  refine ⟨N, hN, x, ?_⟩
  simpa only [hx] using hclose

/-- Compact-domain version used for a continuous logarithmic-kernel map into L².
The probability measure is on X itself, so all sample points belong to X. -/
theorem exists_empirical_mean_of_continuous {X : Type*} [TopologicalSpace X]
    [CompactSpace X] [MeasurableSpace X] [OpensMeasurableSpace X]
    {μ : Measure X} [IsProbabilityMeasure μ] [CompleteSpace E]
    {f : X → E} (hf : Continuous f) {ε : ℝ} (hε : 0 < ε) :
    ∃ (N : ℕ) (_ : 0 < N) (x : Fin N → X),
      ‖(N : ℝ)⁻¹ • (∑ i, f (x i)) - ∫ y, f y ∂μ‖ < ε :=
  exists_empirical_mean (hf.integrable_of_hasCompactSupport (HasCompactSupport.of_compactSpace f)) hε

end Erdos1040Empirical
end
/- END LOCAL MODULE Erdos1040Empirical -/

/- BEGIN LOCAL MODULE Erdos1040WeakKernel -/
section
/-! Weak convergence of probability measures gives norm convergence of their
integrals against a continuous Hilbert-valued kernel on a compact space.
The proof uses the continuous scalar two-point inner-product kernel. -/

open MeasureTheory Filter Set
open scoped Topology

namespace Erdos1040WeakKernel

variable {X E : Type*} [MetricSpace X] [CompactSpace X]
  [MeasurableSpace X] [BorelSpace X] [SecondCountableTopology X]
  [NormedAddCommGroup E] [InnerProductSpace ℝ E] [CompleteSpace E]

noncomputable def mean (K : C(X, E)) (μ : ProbabilityMeasure X) : E :=
  ∫ x, K x ∂(μ : Measure X)

omit [SecondCountableTopology X] [InnerProductSpace ℝ E] [CompleteSpace E] in
theorem integrable_kernel (K : C(X, E)) (μ : ProbabilityMeasure X) :
    Integrable K (μ : Measure X) :=
  K.continuous.integrable_of_hasCompactSupport (HasCompactSupport.of_compactSpace _)

def innerKernel (K : C(X, E)) : C(X × X, ℝ) :=
  ⟨fun p => inner ℝ (K p.1) (K p.2), by fun_prop⟩

theorem inner_mean_eq_integral (K : C(X, E)) (μ ν : ProbabilityMeasure X) :
    inner ℝ (mean K μ) (mean K ν) =
      ∫ p, innerKernel K p ∂(μ.prod ν : Measure (X × X)) := by
  rw [ProbabilityMeasure.toMeasure_prod,
    integral_prod _ ((innerKernel K).continuous.integrable_of_hasCompactSupport
      (HasCompactSupport.of_compactSpace _))]
  dsimp [mean, innerKernel]
  rw [real_inner_comm, ← integral_inner (integrable_kernel K μ)]
  apply integral_congr_ae
  filter_upwards [] with x
  rw [real_inner_comm]
  exact (integral_inner (integrable_kernel K ν) (K x)).symm

theorem continuous_inner_mean (K : C(X, E)) :
    Continuous (fun p : ProbabilityMeasure X × ProbabilityMeasure X =>
      inner ℝ (mean K p.1) (mean K p.2)) := by
  simp_rw [inner_mean_eq_integral]
  exact (ProbabilityMeasure.continuous_integral_continuousMap
    (innerKernel K)).comp ProbabilityMeasure.continuous_prod

theorem continuous_mean (K : C(X, E)) : Continuous (mean K) := by
  rw [continuous_iff_continuousAt]
  intro μ
  rw [ContinuousAt, tendsto_iff_norm_sub_tendsto_zero]
  have hs : Tendsto (fun ν : ProbabilityMeasure X =>
      ‖mean K ν - mean K μ‖ ^ 2) (𝓝 μ) (𝓝 0) := by
    have ha := ((continuous_inner_mean K).comp
      (continuous_id.prodMk continuous_id)).continuousAt.tendsto (x := μ)
    have hb := ((continuous_inner_mean K).comp
      (continuous_id.prodMk (continuous_const (y := μ)))).continuousAt.tendsto (x := μ)
    have hh := (ha.sub (hb.const_mul 2)).add_const (‖mean K μ‖ ^ 2)
    simp only [Function.comp_apply, id_eq, real_inner_self_eq_norm_sq] at hh
    convert hh using 1
    · ext ν
      exact norm_sub_sq_real _ _
    · congr 1
      ring
  simpa only [Real.sqrt_sq (norm_nonneg _), Real.sqrt_zero] using hs.sqrt


end Erdos1040WeakKernel
end
/- END LOCAL MODULE Erdos1040WeakKernel -/

/- BEGIN LOCAL MODULE Erdos1040LogDiscretization -/
section
/-! Actual planar logarithmic potentials and their equal-weight polynomial
approximations. These lemmas are unconditional; no capacity assumption or
unproved potential-theory conclusion is hidden in their hypotheses. -/

open MeasureTheory Set Metric
open scoped Topology BigOperators

namespace Erdos1040LogDiscretization

open Erdos1040LogKernel

noncomputable def potentialL2 (D : Set ℂ) (hD : Bornology.IsBounded D)
    {S : Set ℂ} (ν : Measure S) : Lp ℝ 2 (volume.restrict D) :=
  ∫ w : S, logKernel D hD (w : ℂ) ∂ν

noncomputable def potential {S : Set ℂ} (ν : Measure S) (z : ℂ) : ℝ :=
  ∫ w : S, Real.log ‖z - (w : ℂ)‖ ∂ν

theorem integrable_logKernel (D : Set ℂ) (hD : Bornology.IsBounded D)
    (hmD : MeasurableSet D) {S : Set ℂ} (hS : IsCompact S)
    (ν : Measure S) [IsFiniteMeasure ν] :
    Integrable (fun w : S => logKernel D hD (w : ℂ)) ν := by
  let : CompactSpace S := isCompact_iff_compactSpace.mp hS
  exact ((continuous_logKernel D hD hmD).comp continuous_subtype_val).integrable_of_hasCompactSupport
    (HasCompactSupport.of_compactSpace _)

theorem coeFn_potentialL2 (D : Set ℂ) (hD : Bornology.IsBounded D)
    (hmD : MeasurableSet D) {S : Set ℂ} (hS : IsCompact S)
    (ν : Measure S) [IsFiniteMeasure ν] :
    (⇑(potentialL2 D hD ν)) =ᵐ[volume.restrict D] potential ν := by
  let : IsFiniteMeasure (volume.restrict D) :=
    isFiniteMeasure_restrict.mpr hD.measure_lt_top.ne
  apply CampaignAnalysis277Kernel.coeFn_integral_eq_integral_ae_of_measurable
    (integrable_logKernel D hD hmD hS ν)
  · exact (Real.measurable_log.comp
      (measurable_snd.sub (measurable_subtype_coe.comp measurable_fst)).norm).aestronglyMeasurable
  · exact Filter.Eventually.of_forall fun w => coeFn_logKernel D hD (w : ℂ)

/-- Weak probability convergence on the compact root set implies norm convergence
of the actual logarithmic potential in planar L². -/
theorem continuous_potentialL2 (D : Set ℂ) (hD : Bornology.IsBounded D)
    (hmD : MeasurableSet D) {S : Set ℂ} (hS : IsCompact S) :
    Continuous (fun ν : ProbabilityMeasure S => potentialL2 D hD (ν : Measure S)) := by
  let : CompactSpace S := isCompact_iff_compactSpace.mp hS
  exact Erdos1040WeakKernel.continuous_mean
    ⟨fun w : S => logKernel D hD (w : ℂ),
      (continuous_logKernel D hD hmD).comp continuous_subtype_val⟩

noncomputable def empiricalL2 (D : Set ℂ) (hD : Bornology.IsBounded D)
    {S : Set ℂ} {N : ℕ} (w : Fin N → S) : Lp ℝ 2 (volume.restrict D) :=
  (N : ℝ)⁻¹ • ∑ i, logKernel D hD (w i : ℂ)

theorem coeFn_empiricalL2 (D : Set ℂ) (hD : Bornology.IsBounded D)
    {S : Set ℂ} {N : ℕ} (w : Fin N → S) :
    (⇑(empiricalL2 D hD w)) =ᵐ[volume.restrict D]
      fun z => (N : ℝ)⁻¹ * ∑ i, Real.log ‖z - (w i : ℂ)‖ :=
  CampaignAnalysis277Kernel.coeFn_empirical_mean_ae _ _
    (fun i => coeFn_logKernel D hD (w i : ℂ))

/-- Every probability measure on a compact root set has equally weighted
root potentials arbitrarily close in planar L² on every bounded measurable set. -/
theorem exists_empiricalL2 (D : Set ℂ) (hD : Bornology.IsBounded D)
    (hmD : MeasurableSet D) {S : Set ℂ} (hS : IsCompact S)
    (ν : Measure S) [IsProbabilityMeasure ν] {ε : ℝ} (hε : 0 < ε) :
    ∃ (N : ℕ) (_ : 0 < N) (w : Fin N → S),
      ‖empiricalL2 D hD w - potentialL2 D hD ν‖ < ε := by
  exact Erdos1040Empirical.exists_empirical_mean
    (integrable_logKernel D hD hmD hS ν) hε

def rootPolynomial {S : Set ℂ} {N : ℕ} (w : Fin N → S) (z : ℂ) : ℂ :=
  ∏ i, (z - (w i : ℂ))

theorem log_norm_rootPolynomial {S : Set ℂ} {N : ℕ} (w : Fin N → S)
    (z : ℂ) (hz : ∀ i, z ≠ (w i : ℂ)) :
    Real.log ‖rootPolynomial w z‖ = ∑ i, Real.log ‖z - (w i : ℂ)‖ := by
  unfold rootPolynomial
  rw [norm_prod, Real.log_prod (fun i _ => norm_ne_zero_iff.mpr (sub_ne_zero.mpr (hz i)))]

/-- The empirical L² vector is the normalized logarithm of a genuine monic
root product, outside its finite set of zeros, hence almost everywhere. -/
theorem coeFn_empiricalL2_rootPolynomial (D : Set ℂ) (hD : Bornology.IsBounded D)
    {S : Set ℂ} {N : ℕ} (w : Fin N → S) :
    (⇑(empiricalL2 D hD w)) =ᵐ[volume.restrict D]
      fun z => (N : ℝ)⁻¹ * Real.log ‖rootPolynomial w z‖ := by
  have hn : ∀ᵐ z ∂(volume.restrict D), ∀ i, z ≠ (w i : ℂ) :=
    Filter.eventually_all.mpr fun i => ae_restrict_of_ae (volume.ae_ne (w i : ℂ))
  filter_upwards [coeFn_empiricalL2 D hD w, hn] with z hz hzne
  rw [hz, log_norm_rootPolynomial w z hzne]

theorem rootPolynomial_sublevel_ae (D : Set ℂ) (hD : Bornology.IsBounded D)
    {S : Set ℂ} {N : ℕ} (hN : 0 < N) (w : Fin N → S) :
    {z : ℂ | ‖rootPolynomial w z‖ < 1} =ᵐ[volume.restrict D]
      {z : ℂ | empiricalL2 D hD w z < 0} := by
  have hn : ∀ᵐ z ∂(volume.restrict D), ∀ i, z ≠ (w i : ℂ) :=
    Filter.eventually_all.mpr fun i => ae_restrict_of_ae (volume.ae_ne (w i : ℂ))
  filter_upwards [coeFn_empiricalL2_rootPolynomial D hD w, hn] with z hz hzne
  have hp : 0 < ‖rootPolynomial w z‖ := norm_pos_iff.mpr
    (Finset.prod_ne_zero_iff.mpr (fun i _ => sub_ne_zero.mpr (hzne i)))
  have hNp : 0 < (N : ℝ)⁻¹ := inv_pos.mpr (by exact_mod_cast hN)
  change (‖rootPolynomial w z‖ < 1) = (empiricalL2 D hD w z < 0)
  apply propext
  rw [hz, ← Real.log_neg_iff hp]
  constructor
  · exact mul_neg_of_pos_of_neg hNp
  · intro h
    by_contra hnlog
    have := mul_nonneg hNp.le (le_of_not_gt hnlog)
    linarith


end Erdos1040LogDiscretization
end
/- END LOCAL MODULE Erdos1040LogDiscretization -/

/- BEGIN LOCAL MODULE Erdos1040Area -/
section
/-! Quantitative area bounds for negative regions of planar L² potentials. -/

open MeasureTheory Set

namespace Erdos1040Area

variable {X : Type*} [MeasurableSpace X] {μ : Measure X} [IsFiniteMeasure μ]

omit [IsFiniteMeasure μ] in
theorem integral_sq_coeFn (f : Lp ℝ 2 μ) :
    (∫ x, (f x) ^ 2 ∂μ) = ‖f‖ ^ 2 := by
  rw [← real_inner_self_eq_norm_sq f]
  rw [L2.inner_def]
  simp only [Real.inner_apply, pow_two]

theorem square_exceedance_measure_le (f : Lp ℝ 2 μ) {a : ℝ} (ha : 0 < a) :
    μ.real {x | a ^ 2 ≤ (f x) ^ 2} ≤ ‖f‖ ^ 2 / a ^ 2 := by
  have hi : Integrable (fun x => (f x) ^ 2) μ :=
    (memLp_two_iff_integrable_sq (Lp.aestronglyMeasurable f)).mp (Lp.memLp f)
  have h := mul_meas_ge_le_integral_of_nonneg
    (Filter.Eventually.of_forall fun x => sq_nonneg (f x)) hi (a ^ 2)
  rw [integral_sq_coeFn] at h
  exact (le_div_iff₀ (by positivity : 0 < a ^ 2)).mpr (by simpa only [mul_comm] using h)

/-- Outside the region where v lacks a positive margin, negativity of u costs
at least a² of squared error per unit area. -/
theorem negative_region_measure_le (u v : Lp ℝ 2 μ) {a : ℝ} (ha : 0 < a) :
    μ.real {x | u x < 0} ≤ μ.real {x | v x ≤ a} + ‖u - v‖ ^ 2 / a ^ 2 := by
  have hμ : μ {x | u x < 0} ≤
      μ ({x | v x ≤ a} ∪ {x | a ^ 2 ≤ ((u - v) x) ^ 2}) := by
    apply measure_mono_ae
    filter_upwards [Lp.coeFn_sub u v] with x hx
    intro hu
    by_cases hv : v x ≤ a
    · exact Or.inl hv
    · apply Or.inr
      change a ^ 2 ≤ ((u - v) x) ^ 2
      rw [hx]
      change a ^ 2 ≤ (u x - v x) ^ 2
      change u x < 0 at hu
      have hv' := lt_of_not_ge hv
      nlinarith
  have hr : μ.real {x | u x < 0} ≤
      μ.real ({x | v x ≤ a} ∪ {x | a ^ 2 ≤ ((u - v) x) ^ 2}) :=
    ENNReal.toReal_mono (measure_ne_top μ _) hμ
  exact hr.trans ((measureReal_union_le _ _).trans
    (add_le_add le_rfl (square_exceedance_measure_le (u - v) ha)))

theorem negative_region_measure_lt (u v : Lp ℝ 2 μ) {a η : ℝ} (ha : 0 < a)
    (hbad : μ.real {x | v x ≤ a} < η / 2)
    (hclose : ‖u - v‖ ^ 2 < a ^ 2 * (η / 2)) :
    μ.real {x | u x < 0} < η := by
  have he : ‖u - v‖ ^ 2 / a ^ 2 < η / 2 :=
    (div_lt_iff₀ (by positivity : 0 < a ^ 2)).mpr (by simpa only [mul_comm] using hclose)
  have h := negative_region_measure_le u v ha
  linarith


end Erdos1040Area
end
/- END LOCAL MODULE Erdos1040Area -/

/- BEGIN LOCAL MODULE Erdos1040Separator -/
section
/-! Polynomial separation of two horizontal caps from the origin. -/

namespace Erdos1040Separator

open Set Polynomial

lemma horizontalLine_unbounded (a : ℂ) :
    ¬ Bornology.IsBounded (Set.range fun t : ℝ => (t : ℂ) + a) := by
  intro h
  obtain ⟨M, hM⟩ := h.exists_norm_le
  have hb := hM (((M - a.re + 1 : ℝ) : ℂ) + a) ⟨M - a.re + 1, rfl⟩
  have hr := (le_abs_self ((((M - a.re + 1 : ℝ) : ℂ) + a).re)).trans
    (Complex.abs_re_le_norm _)
  simp only [Complex.add_re, Complex.ofReal_re] at hr
  linarith

lemma inverse_mem_polynomialClosure (E : Set ℂ) [CompactSpace E] (a : ℂ)
    (hline : ∀ t : ℝ, (t : ℂ) + a ∉ E) :
    ∃ g : C(E, ℂ), g ∈ (polynomialFunctions E).topologicalClosure ∧
      ∀ z : E, g z = ((z : ℂ) - a)⁻¹ := by
  let A := (polynomialFunctions E).topologicalClosure
  let : IsClosed (A : Set C(E, ℂ)) :=
    (polynomialFunctions E).isClosed_topologicalClosure
  let x : A := ⟨X.toContinuousMapOn E,
    (polynomialFunctions E).le_topologicalClosure (by
      rw [← SetLike.mem_coe, polynomialFunctions_coe]
      exact ⟨X, rfl⟩)⟩
  have hspec : spectrum ℂ (x : C(E, ℂ)) = E := by
    rw [ContinuousMap.spectrum_eq_range]
    ext z
    simp [x, Polynomial.toContinuousMapOn, Polynomial.toContinuousMap]
  have ha : a ∉ spectrum ℂ x := by
    intro ha
    have hb := Subalgebra.spectrum_isBounded_connectedComponentIn A x ha
    rw [hspec] at hb
    apply horizontalLine_unbounded a
    apply hb.subset
    apply (isPreconnected_range (show Continuous (fun t : ℝ => (t : ℂ) + a) by
      fun_prop)).subset_connectedComponentIn
    · exact ⟨0, by simp⟩
    · rintro z ⟨t, rfl⟩
      exact hline t
  have hu : IsUnit (x - algebraMap ℂ A a) := by
    simpa using (spectrum.notMem_iff.mp ha).neg
  obtain ⟨u, hu⟩ := hu
  refine ⟨((↑(u⁻¹) : A) : C(E, ℂ)), (↑(u⁻¹) : A).property, ?_⟩
  intro z
  have he := congrArg (fun v : A => (v : C(E, ℂ)) z) u.val_inv
  rw [hu] at he
  have he' : ((z : ℂ) - a) * ((↑(u⁻¹) : A) : C(E, ℂ)) z = 1 := by
    simpa [x, Polynomial.toContinuousMapOn, Polynomial.toContinuousMap] using he
  exact eq_inv_of_mul_eq_one_right he'

lemma polynomial_approximation_of_mem_closure (E : Set ℂ) [CompactSpace E]
    (f : C(E, ℂ)) (hf : f ∈ (polynomialFunctions E).topologicalClosure)
    {ε : ℝ} (hε : 0 < ε) :
    ∃ p : ℂ[X], ∀ z : E, ‖p.eval (z : ℂ) - f z‖ < ε := by
  obtain ⟨g, hg, hfg⟩ := Metric.mem_closure_iff.mp hf ε hε
  change g ∈ (polynomialFunctions E : Set C(E, ℂ)) at hg
  rw [polynomialFunctions_coe] at hg
  obtain ⟨p, rfl⟩ := hg
  refine ⟨p, fun z => ?_⟩
  have hb := (f - Polynomial.toContinuousMapOnAlgHom E p).norm_coe_le_norm z
  rw [dist_eq_norm] at hfg
  simpa [norm_sub_rev] using hb.trans_lt hfg

lemma rational_small {α : ℝ} (hα : 0 < α) {z : ℂ} (hz : 16 * α ≤ |z.im|) :
    ‖(α : ℂ) ^ 2 * (z - (α : ℂ) * Complex.I)⁻¹ *
      (z + (α : ℂ) * Complex.I)⁻¹‖ ≤ 1 / 225 := by
  have h₁ : 15 * α ≤ ‖z - (α : ℂ) * Complex.I‖ := by
    have habs : |z.im| ≤ |z.im - α| + α := by
      simpa [abs_of_pos hα] using abs_add_le (z.im - α) α
    have hnorm := Complex.abs_im_le_norm (z - (α : ℂ) * Complex.I)
    simp only [Complex.sub_im, Complex.mul_im, Complex.ofReal_re, Complex.I_im,
      mul_one, Complex.ofReal_im, Complex.I_re, mul_zero, add_zero] at hnorm
    linarith
  have h₂ : 15 * α ≤ ‖z + (α : ℂ) * Complex.I‖ := by
    have habs : |z.im| ≤ |z.im + α| + α := by
      simpa [abs_of_pos hα] using abs_add_le (z.im + α) (-α)
    have hnorm := Complex.abs_im_le_norm (z + (α : ℂ) * Complex.I)
    simp only [Complex.add_im, Complex.mul_im, Complex.ofReal_re, Complex.I_im,
      mul_one, Complex.ofReal_im, Complex.I_re, mul_zero, add_zero] at hnorm
    linarith
  have hn₁ : 0 < ‖z - (α : ℂ) * Complex.I‖ := by linarith
  have hn₂ : 0 < ‖z + (α : ℂ) * Complex.I‖ := by linarith
  have hprod := mul_le_mul h₁ h₂ (by positivity : 0 ≤ 15 * α)
    (norm_nonneg (z - (α : ℂ) * Complex.I))
  rw [norm_mul, norm_mul, norm_pow, Complex.norm_real, Real.norm_eq_abs,
    abs_of_pos hα, norm_inv, norm_inv, ← div_eq_mul_inv, ← div_eq_mul_inv, div_div]
  apply (div_le_iff₀ (mul_pos hn₁ hn₂)).2
  nlinarith

lemma horizontalLine_disjoint_of_gap {E : Set ℂ} {δ : ℝ}
    (hgap : ∀ z ∈ E, z = 0 ∨ δ ≤ |z.im|) (a : ℂ)
    (ha : a.im ≠ 0) (haδ : |a.im| < δ) :
    ∀ t : ℝ, (t : ℂ) + a ∉ E := by
  intro t ht
  rcases hgap _ ht with hz | hz
  · apply ha
    simpa using congrArg Complex.im hz
  · simp only [Complex.add_im, Complex.ofReal_im, zero_add] at hz
    linarith

/-- A compact set separated from the real axis, with the origin adjoined, admits a
complex polynomial which is close to one at the origin and small everywhere else. -/
theorem exists_polynomial_separator_of_gap (E : Set ℂ) [CompactSpace E]
    (hzero : (0 : ℂ) ∈ E) {δ : ℝ} (hδ : 0 < δ)
    (hgap : ∀ z ∈ E, z = 0 ∨ δ ≤ |z.im|) :
    ∃ p : ℂ[X], ‖p.eval 0 - 1‖ < 1 / 8 ∧
      ∀ z ∈ E, z ≠ 0 → ‖p.eval z‖ < 1 / 8 := by
  let α : ℝ := δ / 16
  have hα : 0 < α := by dsimp [α]; positivity
  have hαδ : α < δ := by dsimp [α]; linarith
  obtain ⟨g₁, hg₁, hg₁val⟩ := inverse_mem_polynomialClosure E
    ((α : ℂ) * Complex.I) (horizontalLine_disjoint_of_gap hgap _ (by
      simpa using hα.ne') (by simpa [abs_of_pos hα] using hαδ))
  obtain ⟨g₂, hg₂, hg₂val⟩ := inverse_mem_polynomialClosure E
    (-((α : ℂ) * Complex.I)) (horizontalLine_disjoint_of_gap hgap _ (by
      simpa using hα.ne') (by simpa [abs_of_pos hα] using hαδ))
  let f : C(E, ℂ) := (α : ℂ) ^ 2 • (g₁ * g₂)
  have hf : f ∈ (polynomialFunctions E).topologicalClosure :=
    (polynomialFunctions E).topologicalClosure.smul_mem
      ((polynomialFunctions E).topologicalClosure.mul_mem hg₁ hg₂) _
  have hformula (z : E) : f z = (α : ℂ) ^ 2 *
      ((z : ℂ) - (α : ℂ) * Complex.I)⁻¹ *
      ((z : ℂ) + (α : ℂ) * Complex.I)⁻¹ := by
    simp [f, hg₁val, hg₂val, mul_assoc]
  have hfzero : f ⟨0, hzero⟩ = 1 := by
    rw [hformula]
    simp only [zero_sub, zero_add]
    have haC : (α : ℂ) ≠ 0 := by exact_mod_cast hα.ne'
    field_simp
    simp [Complex.I_sq]
  obtain ⟨p, hp⟩ := polynomial_approximation_of_mem_closure E f hf
    (by norm_num : (0 : ℝ) < 1 / 16)
  refine ⟨p, ?_, ?_⟩
  · have hz := hp ⟨0, hzero⟩
    rw [hfzero] at hz
    exact hz.trans (by norm_num)
  · intro z hz hz0
    have hzδ : δ ≤ |z.im| := (hgap z hz).resolve_left hz0
    have hsmall : ‖f ⟨z, hz⟩‖ ≤ 1 / 225 := by
      rw [hformula]
      apply rational_small hα
      dsimp [α]
      linarith
    have happrox := hp ⟨z, hz⟩
    have htri := norm_add_le (p.eval z - f ⟨z, hz⟩) (f ⟨z, hz⟩)
    simp only [sub_add_cancel] at htri
    linarith

/-- The two-cap separator, in the quantitative form used for Erdős 1040. -/
theorem exists_polynomial_separator (R : ℝ) {δ : ℝ} (hδ : 0 < δ) :
    ∃ p : ℂ[X], ‖p.eval 0 - 1‖ < 1 / 8 ∧
      ∀ z : ℂ, ‖z‖ ≤ R → δ ≤ |z.im| → ‖p.eval z‖ < 1 / 8 := by
  let E : Set ℂ := {z : ℂ | ‖z‖ ≤ R ∧ δ ≤ |z.im|} ∪ {0}
  have hcap : IsCompact {z : ℂ | ‖z‖ ≤ R ∧ δ ≤ |z.im|} := by
    have heq : {z : ℂ | ‖z‖ ≤ R ∧ δ ≤ |z.im|} =
        Metric.closedBall 0 R ∩ {z : ℂ | δ ≤ |z.im|} := by
      ext z
      simp
    rw [heq]
    exact (isCompact_closedBall (0 : ℂ) R).inter_right
      (isClosed_le continuous_const Complex.continuous_im.abs)
  have hE : IsCompact E := hcap.union isCompact_singleton
  let : CompactSpace E := isCompact_iff_compactSpace.mp hE
  have hzero : (0 : ℂ) ∈ E := by simp [E]
  obtain ⟨p, hp0, hp⟩ := exists_polynomial_separator_of_gap E hzero hδ (by
    intro z hz
    rcases hz with hz | hz
    · exact Or.inr hz.2
    · exact Or.inl (Set.mem_singleton_iff.mp hz))
  refine ⟨p, hp0, fun z hzR hzδ => hp z (Or.inl ⟨hzR, hzδ⟩) ?_⟩
  intro hz
  subst z
  simp only [Complex.zero_im, abs_zero] at hzδ
  exact hδ.not_ge hzδ

end Erdos1040Separator
end
/- END LOCAL MODULE Erdos1040Separator -/

/- BEGIN LOCAL MODULE Erdos1040StripArea -/
section
/-! Area of a thin rotated strip inside a bounded disk. -/

open Set MeasureTheory Complex

namespace Erdos1040StripArea

theorem rotated_strip_volume_le (R δ : ℝ) (hR : 0 < R) (hδ : 0 < δ)
    (a : ℂ) (ha : ‖a‖ = 1) :
    volume {z : ℂ | ‖z‖ ≤ R ∧ |(a * z).im| < δ} ≤ ENNReal.ofReal (4 * R * δ) := by
  let c : Circle := ⟨a, mem_sphere_zero_iff_norm.mpr ha⟩
  let T : ℂ → ℝ × ℝ := Complex.measurableEquivRealProd ∘ rotation c
  have hT : MeasurePreserving T volume volume :=
    Complex.volume_preserving_equiv_real_prod.comp (rotation c).measurePreserving
  let rectangle : Set (ℝ × ℝ) := Icc (-R) R ×ˢ Icc (-δ) δ
  have hsub : {z : ℂ | ‖z‖ ≤ R ∧ |(a * z).im| < δ} ⊆ T ⁻¹' rectangle := by
    intro z hz
    have hnorm : ‖a * z‖ ≤ R := by simpa only [norm_mul, ha, one_mul] using hz.1
    have hre : |(a * z).re| ≤ R := (Complex.abs_re_le_norm _).trans hnorm
    have him : |(a * z).im| ≤ δ := hz.2.le
    change (-R ≤ (a * z).re ∧ (a * z).re ≤ R) ∧
      (-δ ≤ (a * z).im ∧ (a * z).im ≤ δ)
    exact ⟨abs_le.mp hre, abs_le.mp him⟩
  calc
    volume {z : ℂ | ‖z‖ ≤ R ∧ |(a * z).im| < δ} ≤ volume (T ⁻¹' rectangle) := measure_mono hsub
    _ ≤ volume rectangle := hT.measure_preimage_le rectangle
    _ = ENNReal.ofReal (4 * R * δ) := by
      change (volume : Measure ℝ).prod volume (Icc (-R) R ×ˢ Icc (-δ) δ) = _
      rw [Measure.prod_prod, Real.volume_Icc, Real.volume_Icc,
        ← ENNReal.ofReal_mul (by linarith : 0 ≤ R - -R)]
      congr 1
      ring


end Erdos1040StripArea
end
/- END LOCAL MODULE Erdos1040StripArea -/

/- BEGIN LOCAL MODULE Erdos1040CenteredSeparator -/
section
/-! Centered real parts of polynomials positive outside arbitrarily small area. -/

namespace Erdos1040CenteredSeparator

open Set Polynomial MeasureTheory
open scoped BigOperators

lemma sum_rotations (q : ℂ[X]) {N : ℕ} {ζ : ℂ} (hζ : IsPrimitiveRoot ζ N)
    (hN : q.natDegree < N) :
    ∑ j ∈ Finset.range N, q.comp (C (ζ ^ j) * X) = C ((N : ℂ) * q.eval 0) := by
  ext k
  rw [finsetSum_coeff]
  simp only [comp_C_mul_X_coeff]
  by_cases hk : k = 0
  · subst k
    simp [nsmul_eq_mul, coeff_zero_eq_eval_zero]
  rw [coeff_C, if_neg hk]
  by_cases hkN : k < N
  · have hpow : (ζ ^ k) ^ N = 1 := by
      rw [← pow_mul, Nat.mul_comm, pow_mul, hζ.pow_eq_one, one_pow]
    have hgeom : ∑ j ∈ Finset.range N, (ζ ^ k) ^ j = 0 := by
      have hh := geom_sum_mul (ζ ^ k) N
      rw [hpow, sub_self] at hh
      exact (mul_eq_zero.mp hh).resolve_right
        (sub_ne_zero.mpr (hζ.pow_ne_one_of_pos_of_lt hk hkN))
    rw [← Finset.mul_sum]
    have hp (j : ℕ) : (ζ ^ j) ^ k = (ζ ^ k) ^ j := by
      rw [← pow_mul, ← pow_mul, Nat.mul_comm]
    simp_rw [hp]
    rw [hgeom, mul_zero]
  · have hcoeff : q.coeff k = 0 := coeff_eq_zero_of_natDegree_lt (by omega)
    simp [hcoeff]

lemma exists_rotation_ge_constant (Λ : ℂ[X] →ₗ[ℝ] ℝ)
    (hΛ : ∀ c : ℂ, Λ (C c) = c.re) (q : ℂ[X]) :
    ∃ a : ℂ, ‖a‖ = 1 ∧ (q.eval 0).re ≤ Λ (q.comp (C a * X)) := by
  let N := q.natDegree + 1
  have hN : N ≠ 0 := by dsimp [N]; omega
  let ζ := Complex.exp (2 * Real.pi * Complex.I / N)
  have hζ : IsPrimitiveRoot ζ N := Complex.isPrimitiveRoot_exp N hN
  have hsum := congrArg Λ (sum_rotations q hζ (by dsimp [N]; omega))
  rw [map_sum, hΛ] at hsum
  have hsum' : ∑ j ∈ Finset.range N, (q.eval 0).re =
      ∑ j ∈ Finset.range N, Λ (q.comp (C (ζ ^ j) * X)) := by
    rw [hsum]
    simp [Complex.mul_re]
  obtain ⟨j, hj, hle⟩ := Finset.exists_le_of_sum_le
    (Finset.nonempty_range_iff.mpr hN) hsum'.le
  refine ⟨ζ ^ j, ?_, hle⟩
  rw [norm_pow, hζ.norm'_eq_one hN, one_pow]

lemma exists_centered_polynomial_caps (Λ : ℂ[X] →ₗ[ℝ] ℝ)
    (hΛ : ∀ c : ℂ, Λ (C c) = c.re) (R : ℝ) {δ : ℝ} (hδ : 0 < δ) :
    ∃ (a : ℂ) (p : ℂ[X]), ‖a‖ = 1 ∧ Λ p = 0 ∧
      ∀ z : ℂ, ‖z‖ ≤ R → δ ≤ |(a * z).im| → 1 < (p.eval z).re := by
  obtain ⟨Q, hQ0, hQ⟩ := Erdos1040Separator.exists_polynomial_separator R hδ
  obtain ⟨a, ha, ham⟩ := exists_rotation_ge_constant Λ hΛ Q
  let m := Λ (Q.comp (C a * X))
  have hm : 7 / 8 < m := by
    have h := (Complex.abs_re_le_norm (Q.eval 0 - 1)).trans_lt hQ0
    simp only [Complex.sub_re, Complex.one_re] at h
    have hh := (abs_lt.mp h).1
    dsimp [m]
    linarith
  let p : ℂ[X] := (2 : ℝ) • (C (m : ℂ) - Q.comp (C a * X))
  refine ⟨a, p, ha, ?_, ?_⟩
  · simp [p, map_sub, hΛ, m]
  · intro z hz hzim
    have hnorm : ‖a * z‖ ≤ R := by simpa [norm_mul, ha] using hz
    have hsmall := hQ (a * z) hnorm hzim
    have hre : (Q.eval (a * z)).re < 1 / 8 :=
      ((le_abs_self _).trans (Complex.abs_re_le_norm _)).trans_lt hsmall
    have hp : (p.eval z).re = 2 * (m - (Q.eval (a * z)).re) := by
      simp [p]
    rw [hp]
    linarith

noncomputable def polynomialPairing {H : Set ℂ} (hH : IsCompact H)
    (f : Lp ℝ 2 (volume.restrict H)) : ℂ[X] →ₗ[ℝ] ℝ where
  toFun p := ∫ z in H, f z * (p.eval z).re
  map_add' p q := by
    simp only [eval_add, Complex.add_re, mul_add]
    exact integral_add
      ((Erdos1040DualApproximation.integrableOn_areaCharge hH f).mul_continuousOn
        (Complex.continuous_re.comp p.continuous).continuousOn hH)
      ((Erdos1040DualApproximation.integrableOn_areaCharge hH f).mul_continuousOn
        (Complex.continuous_re.comp q.continuous).continuousOn hH)
  map_smul' r p := by
    simp only [eval_smul, Complex.real_smul, Complex.mul_re, Complex.ofReal_re,
      Complex.ofReal_im, zero_mul, sub_zero, RingHom.id_apply, smul_eq_mul]
    rw [← integral_const_mul]
    congr 1
    funext z
    ring

lemma polynomialPairing_const {H : Set ℂ} (hH : IsCompact H)
    (f : Lp ℝ 2 (volume.restrict H)) (hmass : (∫ z in H, f z) = 1) (c : ℂ) :
    polynomialPairing hH f (C c) = c.re := by
  change (∫ z in H, f z * (eval z (C c)).re) = _
  simp only [eval_C]
  rw [integral_mul_const, hmass, one_mul]

/-- A real area charge of total mass one can be paired to zero by a polynomial
whose real part is at least one outside an arbitrarily small area. -/
theorem exists_centered_polynomial (H : Set ℂ) (hH : IsCompact H)
    (f : Lp ℝ 2 (volume.restrict H)) (hmass : (∫ z in H, f z) = 1)
    {η : ℝ} (hη : 0 < η) :
    ∃ p : ℂ[X], (∫ z in H, f z * (p.eval z).re) = 0 ∧
      (volume.restrict H) {z | (p.eval z).re < 1} < ENNReal.ofReal η := by
  obtain ⟨R, hR, hbound⟩ := hH.isBounded.exists_pos_norm_le
  let δ : ℝ := η / (8 * R)
  have hδ : 0 < δ := by dsimp [δ]; positivity
  obtain ⟨a, p, ha, hcenter, hpositive⟩ := exists_centered_polynomial_caps
    (polynomialPairing hH f) (polynomialPairing_const hH f hmass) R hδ
  refine ⟨p, hcenter, ?_⟩
  rw [Measure.restrict_apply' hH.measurableSet]
  have hsubset : {z : ℂ | (p.eval z).re < 1} ∩ H ⊆
      {z : ℂ | ‖z‖ ≤ R ∧ |(a * z).im| < δ} := by
    intro z hz
    refine ⟨hbound z hz.2, ?_⟩
    by_contra h
    have hh := hpositive z (hbound z hz.2) (le_of_not_gt h)
    exact (not_lt_of_ge hh.le) hz.1
  calc
    volume ({z : ℂ | (p.eval z).re < 1} ∩ H) ≤
        volume {z : ℂ | ‖z‖ ≤ R ∧ |(a * z).im| < δ} := measure_mono hsubset
    _ ≤ ENNReal.ofReal (4 * R * δ) :=
      Erdos1040StripArea.rotated_strip_volume_le R δ hR hδ a ha
    _ < ENNReal.ofReal η := by
      apply (ENNReal.ofReal_lt_ofReal_iff hη).2
      have heq : 4 * R * δ = η / 2 := by
        dsimp [δ]
        field_simp
        ring
      rw [heq]
      linarith

end Erdos1040CenteredSeparator
end
/- END LOCAL MODULE Erdos1040CenteredSeparator -/

/- BEGIN LOCAL MODULE Erdos1040InnerDensity -/
section
/-! Bounded signed source densities with positive logarithmic potential on
most of a compact planar region. -/

open Set Filter MeasureTheory
open scoped Topology

namespace Erdos1040InnerDensity

open Erdos1040LogKernel Erdos1040DualApproximation CampaignAnalysis277Kernel

variable {H : Set ℂ}

/-- The Bochner signed potential has the actual scalar logarithmic integral
as a representative almost everywhere on the area region. -/
theorem coeFn_signedPotential (hH : IsCompact H) (ν : Measure ℂ) [IsProbabilityMeasure ν]
    {B : ℝ} (hK : AEStronglyMeasurable (logKernel H hH.isBounded) ν)
    (hB : ∀ᵐ w ∂ν, ‖logKernel H hH.isBounded w‖ ≤ B)
    {h : ℂ → ℝ} (hh : Measurable h) {C : ℝ} (hC : ∀ w, ‖h w‖ ≤ C) :
    (⇑(∫ w, h w • logKernel H hH.isBounded w ∂ν : Lp ℝ 2 (volume.restrict H)))
      =ᵐ[volume.restrict H] fun z ↦ ∫ w, h w * Real.log ‖z - w‖ ∂ν := by
  let : IsFiniteMeasure (volume.restrict H) := isFiniteMeasure_restrict.mpr hH.measure_ne_top
  have hhint : Integrable h ν :=
    (memLp_top_of_bound hh.aestronglyMeasurable C (Eventually.of_forall hC)).integrable le_top
  apply coeFn_integral_eq_integral_ae_of_measurable
    (K := fun w ↦ h w • logKernel H hH.isBounded w) (hhint.smul_bdd B hK hB)
  · exact ((hh.comp measurable_fst).mul
      (Real.measurable_log.comp (measurable_snd.sub measurable_fst).norm)).aestronglyMeasurable
  · exact Eventually.of_forall fun w ↦ by
      filter_upwards [Lp.coeFn_smul (h w) (logKernel H hH.isBounded w),
        coeFn_logKernel H hH.isBounded w] with z hz₁ hz₂
      simpa only [Pi.smul_apply, smul_eq_mul, hz₂] using hz₁

/-- A scalar potential close in L² to a polynomial of real part at least one
has a small region where it is at most one half. -/
theorem half_sublevel_measure_le (hH : IsCompact H)
    (u : Lp ℝ 2 (volume.restrict H)) (φ : ℂ → ℝ)
    (hu : u =ᵐ[volume.restrict H] φ) (p : Polynomial ℂ) :
    (volume.restrict H).real {z | φ z ≤ (1 : ℝ) / 2} ≤
      (volume.restrict H).real {z | (p.eval z).re < 1} +
        ‖u - polynomialLp hH p‖ ^ 2 / ((1 : ℝ) / 2) ^ 2 := by
  let : IsFiniteMeasure (volume.restrict H) := isFiniteMeasure_restrict.mpr hH.measure_ne_top
  let v := polynomialLp hH p
  have hμ : (volume.restrict H) {z | φ z ≤ (1 : ℝ) / 2} ≤
      (volume.restrict H) ({z | (p.eval z).re < 1} ∪
        {z | ((1 : ℝ) / 2) ^ 2 ≤ ((u - v) z) ^ 2}) := by
    apply measure_mono_ae
    filter_upwards [hu, (polynomial_memLp hH p).coeFn_toLp, Lp.coeFn_sub u v] with z huz hvz hsub
    intro hz
    by_cases hp : (p.eval z).re < 1
    · exact Or.inl hp
    · apply Or.inr
      change ((1 : ℝ) / 2) ^ 2 ≤ ((u - v) z) ^ 2
      rw [hsub]
      change ((1 : ℝ) / 2) ^ 2 ≤ (u z - v z) ^ 2
      change φ z ≤ (1 : ℝ) / 2 at hz
      change v z = (p.eval z).re at hvz
      rw [huz, hvz]
      have hp' := le_of_not_gt hp
      nlinarith
  have hr := ENNReal.toReal_mono (measure_ne_top (volume.restrict H) _) hμ
  exact hr.trans ((measureReal_union_le _ _).trans
    (add_le_add le_rfl (Erdos1040Area.square_exceedance_measure_le (u - v) (by norm_num))))

/-- Assembly from the centered separator interface. The concrete separator
construction is supplied by `Erdos1040CenteredSeparator`. -/
theorem exists_bounded_density_positive_on_most_of_separator (hH : IsCompact H)
    (hconn : IsPreconnected Hᶜ) (ν : Measure ℂ) [IsProbabilityMeasure ν]
    (hsupp : IsCompact ν.support) (hfrontier : frontier H ⊆ ν.support)
    (hseparator : ∀ (f₀ : Lp ℝ 2 (volume.restrict H)), (∫ z in H, f₀ z) = 1 →
      ∀ η : ℝ, 0 < η → ∃ p : Polynomial ℂ,
        (∫ z in H, f₀ z * (p.eval z).re) = 0 ∧
        (volume.restrict H) {z | (p.eval z).re < 1} < ENNReal.ofReal η)
    {η : ℝ} (hη : 0 < η) :
    ∃ h : ℂ → ℝ, Measurable h ∧ ∃ C : ℝ, 0 ≤ C ∧ (∀ w, ‖h w‖ ≤ C) ∧
      (volume.restrict H).real {z | (∫ w, h w * Real.log ‖z - w‖ ∂ν) ≤ (1 : ℝ) / 2} < η := by
  obtain ⟨B, hBpos, hBall⟩ := exists_uniform_bound H hH.isBounded hH.measurableSet ν.support hsupp
  have hK : AEStronglyMeasurable (logKernel H hH.isBounded) ν :=
    (continuous_logKernel H hH.isBounded hH.measurableSet).aestronglyMeasurable
  have hB : ∀ᵐ w ∂ν, ‖logKernel H hH.isBounded w‖ ≤ B := by
    filter_upwards [ν.support_mem_ae] with w hw
    exact hBall w hw
  have hex : ∃ p : Polynomial ℂ,
      polynomialLp hH p ∈ closure (Set.range (kernelL2Operator hK hB)) ∧
      (volume.restrict H) {z | (p.eval z).re < 1} < ENNReal.ofReal (η / 2) := by
    obtain hall | ⟨f₀, hf₀, hm₀, hcenter⟩ :=
      polynomial_closure_mass_alternative hH hconn ν hfrontier hK hB
    · refine ⟨1, hall 1, ?_⟩
      simpa using ENNReal.ofReal_pos.mpr (half_pos hη)
    · obtain ⟨p, hpcenter, hpbad⟩ := hseparator f₀ hm₀ (η / 2) (half_pos hη)
      exact ⟨p, hcenter p hpcenter, hpbad⟩
  obtain ⟨p, hpclose, hpbad⟩ := hex
  have hδ : 0 < Real.sqrt (η / 8) := Real.sqrt_pos.mpr (by positivity)
  obtain ⟨h, hh, ⟨C, hC⟩, hclose⟩ := exists_bounded_density_approx hH ν hK hB p hpclose hδ
  have hCnonneg : 0 ≤ C := (norm_nonneg (h 0)).trans (hC 0)
  refine ⟨h, hh, C, hCnonneg, hC, ?_⟩
  let u : Lp ℝ 2 (volume.restrict H) := ∫ w, h w • logKernel H hH.isBounded w ∂ν
  have hrep := coeFn_signedPotential hH ν hK hB hh hC
  have harea := half_sublevel_measure_le hH u _ hrep p
  have hbad : (volume.restrict H).real {z | (p.eval z).re < 1} < η / 2 :=
    ENNReal.toReal_lt_of_lt_ofReal hpbad
  have hsq : ‖u - polynomialLp hH p‖ ^ 2 < η / 8 := by
    have hsqrt : (Real.sqrt (η / 8)) ^ 2 = η / 8 := Real.sq_sqrt (by positivity)
    dsimp [u] at *
    nlinarith [norm_nonneg ((∫ w, h w • logKernel H hH.isBounded w ∂ν) - polynomialLp hH p)]
  norm_num at harea
  linarith

/-- A globally bounded measurable signed source density has scalar logarithmic
potential greater than one half on all but an arbitrarily small area of the
compact filled support hull. The centered separator is constructed, not assumed. -/
theorem exists_bounded_density_positive_on_most (hH : IsCompact H)
    (hconn : IsPreconnected Hᶜ) (ν : Measure ℂ) [IsProbabilityMeasure ν]
    (hsupp : IsCompact ν.support) (hfrontier : frontier H ⊆ ν.support)
    {η : ℝ} (hη : 0 < η) :
    ∃ h : ℂ → ℝ, Measurable h ∧ ∃ C : ℝ, 0 ≤ C ∧ (∀ w, ‖h w‖ ≤ C) ∧
      (volume.restrict H).real {z | (∫ w, h w * Real.log ‖z - w‖ ∂ν) ≤ (1 : ℝ) / 2} < η :=
  exists_bounded_density_positive_on_most_of_separator hH hconn ν hsupp hfrontier
    (fun f₀ hm₀ η hη ↦ Erdos1040CenteredSeparator.exists_centered_polynomial H hH f₀ hm₀ (η := η) hη) hη


end Erdos1040InnerDensity
end
