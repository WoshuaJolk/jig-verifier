/- BEGIN LOCAL MODULE Erdos1040PositivePotential -/
section
/-! Strict exterior positivity of a nonnegative compact probability potential. -/

open Set Filter MeasureTheory InnerProductSpace
open scoped Topology

namespace Erdos1040PositivePotential

/-- Continuity on an open planar set upgrades almost-everywhere nonnegativity
to pointwise nonnegativity there. -/
theorem nonnegative_on_open_of_ae {U : Set ℂ} (ho : IsOpen U) {f : ℂ → ℝ}
    (hf : ContinuousOn f U) (hnonneg : ∀ᵐ z ∂volume, 0 ≤ f z) :
    ∀ z ∈ U, 0 ≤ f z := by
  have heq : (fun z ↦ min (f z) 0) =ᵐ[volume.restrict U] fun _ ↦ (0 : ℝ) := by
    filter_upwards [ae_restrict_of_ae hnonneg] with z hz
    exact min_eq_right hz
  have hall := Measure.eqOn_open_of_ae_eq heq ho (hf.inf continuousOn_const) continuousOn_const
  intro z hz
  exact min_eq_right_iff.mp (hall hz)

/-- Unit mass forces a compactly supported real potential to be positive at
some exterior point, as a consequence of the proved logarithmic asymptotic. -/
theorem exists_positive_exterior (H : Set ℂ) (hH : IsCompact H) (ν : Measure ℂ)
    [IsFiniteMeasure ν] (hmass : (∫ _z in H, (1 : ℝ) ∂ν) = 1) :
    ∃ w ∈ Hᶜ, 0 < ∫ z in H, Real.log ‖w - z‖ ∂ν := by
  have hlim : Tendsto (fun w : ℂ ↦ (∫ z in H, Real.log ‖w - z‖ ∂ν) - Real.log ‖w‖)
      (cocompact ℂ) (𝓝 0) := by
    simpa only [hmass, one_mul] using
      Erdos1040PotentialDecay.tendsto_potential_sub_mass_log hH
        (show IntegrableOn (fun _ : ℂ ↦ (1 : ℝ)) H ν from integrable_const 1)
  have hlog : Tendsto (fun w : ℂ ↦ Real.log ‖w‖) (cocompact ℂ) atTop :=
    Real.tendsto_log_atTop.comp tendsto_norm_cocompact_atTop
  have hevent : ∀ᶠ w in cocompact ℂ, w ∈ Hᶜ ∧
      -1 < (∫ z in H, Real.log ‖w - z‖ ∂ν) - Real.log ‖w‖ ∧ 1 < Real.log ‖w‖ := by
    filter_upwards [hH.compl_mem_cocompact,
      hlim.eventually (lt_mem_nhds (by norm_num : (-1 : ℝ) < 0)),
      hlog.eventually_gt_atTop 1] with w hwH hwerr hwlog
    exact ⟨hwH, hwerr, hwlog⟩
  obtain ⟨w, hwH, hwerr, hwlog⟩ := hevent.exists
  exact ⟨w, hwH, by linarith⟩

/-- An actual compact probability potential that is nonnegative almost
everywhere is strictly positive outside its filled support hull. -/
theorem positive_exterior_of_ae_nonnegative (H : Set ℂ) (hH : IsCompact H)
    (hconn : IsPreconnected Hᶜ) (ν : Measure ℂ) [IsProbabilityMeasure ν]
    (hsupport : ν.support ⊆ H)
    (hnonneg : ∀ᵐ w ∂volume, 0 ≤ ∫ z, Real.log ‖w - z‖ ∂ν) :
    ∀ w ∈ Hᶜ, 0 < ∫ z, Real.log ‖w - z‖ ∂ν := by
  have hrestrict : ν.restrict H = ν :=
    Measure.restrict_eq_self_of_ae_mem (by
      filter_upwards [ν.support_mem_ae] with z hz
      exact hsupport hz)
  have hmass : (∫ z in H, (1 : ℝ) ∂ν) = 1 := by rw [hrestrict]; simp
  have hh : HarmonicOnNhd (fun w : ℂ ↦ ∫ z in H, Real.log ‖w - z‖ ∂ν) Hᶜ := by
    simpa only [one_mul] using
      Erdos1040HarmonicPotential.harmonicOnNhd_potential_compl hH
        (show IntegrableOn (fun _ : ℂ ↦ (1 : ℝ)) H ν from integrable_const 1)
  rw [hrestrict] at hh
  apply Erdos1040ExteriorMaximum.positive_of_nonnegative_of_exists_pos hconn
    hH.isClosed.isOpen_compl hh
    (nonnegative_on_open_of_ae hH.isClosed.isOpen_compl hh.continuousOn hnonneg)
  simpa only [hrestrict] using exists_positive_exterior H hH ν hmass


end Erdos1040PositivePotential
end
/- END LOCAL MODULE Erdos1040PositivePotential -/

/- BEGIN LOCAL MODULE Erdos1040Complete -/
section
/-!
The full capacity-to-vanishing-area implication, including arbitrary compact
sets of transfinite diameter one. All analytic inputs are constructed from
the canonical capacity hypothesis; no regularity of the set is assumed.
-/

open MeasureTheory Metric

namespace Erdos1040Complete

theorem compact_infimum_eq_zero {F : Set ℂ} (hF : IsCompact F)
    (hcap : 1 ≤ Erdos1040Foundation.transfiniteDiameter F) :
    Erdos1040Foundation.polynomialSublevelInfimum F = 0 := by
  obtain ⟨ν, hν, hνF, hnonneg⟩ :=
    Erdos1040Support.exists_ambient_nonnegative_potential hF hcap
  obtain ⟨H, hH, hνH, _hopen, hconn, hfrontier⟩ :=
    Erdos1040ExteriorHull.exists_compact_connected_exterior hν
  obtain ⟨R, hνR⟩ :=
    (Metric.isBounded_iff_subset_closedBall (0 : ℂ)).mp hν.isBounded
  apply Erdos1040OuterMargins.polynomialSublevelInfimum_eq_zero_of_baseline_and_inner
    ν hν hνF hνR H hH hnonneg
  · exact Erdos1040PositivePotential.positive_exterior_of_ae_nonnegative
      H hH hconn.isPreconnected (ν : Measure ℂ) hνH hnonneg
  · intro η hη
    exact Erdos1040InnerDensity.exists_bounded_density_positive_on_most
      hH hconn.isPreconnected (ν : Measure ℂ) hν hfrontier hη

/-- The exact Jig277 root, Erdős #1040(ii). -/
theorem proof : Erdos1040Foundation.statement := by
  apply Erdos1040Foundation.compact_reduction.mpr
  intro F hF _hinfinite hcap
  exact compact_infimum_eq_zero hF hcap


end Erdos1040Complete
end
/- END LOCAL MODULE Erdos1040Complete -/

namespace Submissions.Erdos1040CapacityPolynomialSublevels.CapacityOne

theorem proof : Erdos1040Foundation.statement := Erdos1040Complete.proof

end Submissions.Erdos1040CapacityPolynomialSublevels.CapacityOne
