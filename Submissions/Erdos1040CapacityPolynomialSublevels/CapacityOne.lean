section
/-!
# Bounded Banach-valued kernels acting on scalar L¹

Reusable infrastructure for the candidate area-potential argument for Jig277.
This file does not assume or claim the root theorem. The intended application
has target `E = Lp ℝ 2 (volume.restrict D)` and kernel `w ↦ log |· - w|`.
The planar logarithmic kernel estimates must be proved separately.
-/

open MeasureTheory
open scoped ENNReal

namespace CampaignAnalysis277Kernel

variable {α E : Type*} [MeasurableSpace α] {μ : Measure α}
  [NormedAddCommGroup E] [NormedSpace ℝ E]
  {k : α → E} {B : ℝ}

theorem integrable_smul_kernel
    (hk : AEStronglyMeasurable k μ) (hB : ∀ᵐ x ∂μ, ‖k x‖ ≤ B)
    (f : Lp ℝ 1 μ) : Integrable (fun x ↦ f x • k x) μ := by
  exact (memLp_one_iff_integrable.mp (Lp.memLp f)).smul_bdd B hk hB

noncomputable def kernelLinearMap
    (hk : AEStronglyMeasurable k μ) (hB : ∀ᵐ x ∂μ, ‖k x‖ ≤ B) :
    Lp ℝ 1 μ →ₗ[ℝ] E where
  toFun f := ∫ x, f x • k x ∂μ
  map_add' f g := by
    calc
      (∫ x, (f + g) x • k x ∂μ) =
          ∫ x, f x • k x + g x • k x ∂μ := by
        apply integral_congr_ae
        filter_upwards [Lp.coeFn_add f g] with x hx
        simp only [hx, Pi.add_apply, add_smul]
      _ = (∫ x, f x • k x ∂μ) + ∫ x, g x • k x ∂μ :=
        integral_add (integrable_smul_kernel hk hB f) (integrable_smul_kernel hk hB g)
  map_smul' c f := by
    calc
      (∫ x, (c • f) x • k x ∂μ) = ∫ x, c • (f x • k x) ∂μ := by
        apply integral_congr_ae
        filter_upwards [Lp.coeFn_smul c f] with x hx
        simp only [hx, Pi.smul_apply, smul_eq_mul, mul_smul]
      _ = c • ∫ x, f x • k x ∂μ := integral_smul c _

theorem norm_kernelLinearMap_apply_le
    (hk : AEStronglyMeasurable k μ) (hB : ∀ᵐ x ∂μ, ‖k x‖ ≤ B)
    (f : Lp ℝ 1 μ) : ‖kernelLinearMap hk hB f‖ ≤ B * ‖f‖ := by
  have hf := memLp_one_iff_integrable.mp (Lp.memLp f)
  calc
    ‖kernelLinearMap hk hB f‖ ≤ ∫ x, ‖f x‖ * B ∂μ := by
      apply norm_integral_le_of_norm_le (hf.norm.mul_const B)
      filter_upwards [hB] with x hx
      simpa only [norm_smul] using mul_le_mul_of_nonneg_left hx (norm_nonneg (f x))
    _ = B * ‖f‖ := by
      rw [integral_mul_const, ← L1.norm_eq_integral_norm]
      exact mul_comm _ _

noncomputable def kernelOperator
    (hk : AEStronglyMeasurable k μ) (hB : ∀ᵐ x ∂μ, ‖k x‖ ≤ B) :
    Lp ℝ 1 μ →L[ℝ] E :=
  (kernelLinearMap hk hB).mkContinuous B (norm_kernelLinearMap_apply_le hk hB)

@[simp] theorem kernelOperator_apply
    (hk : AEStronglyMeasurable k μ) (hB : ∀ᵐ x ∂μ, ‖k x‖ ≤ B)
    (f : Lp ℝ 1 μ) : kernelOperator hk hB f = ∫ x, f x • k x ∂μ := rfl

theorem norm_kernelOperator_le
    (hk : AEStronglyMeasurable k μ) (hB : ∀ᵐ x ∂μ, ‖k x‖ ≤ B)
    (hB0 : 0 ≤ B) : ‖kernelOperator hk hB‖ ≤ B :=
  LinearMap.mkContinuous_norm_le _ hB0 _

theorem norm_kernel_integral_sub_le
    (hk : AEStronglyMeasurable k μ) (hB : ∀ᵐ x ∂μ, ‖k x‖ ≤ B)
    (f g : Lp ℝ 1 μ) :
    ‖(∫ x, f x • k x ∂μ) - ∫ x, g x • k x ∂μ‖ ≤ B * ‖f - g‖ := by
  change ‖kernelLinearMap hk hB f - kernelLinearMap hk hB g‖ ≤ _
  rw [← map_sub]
  exact norm_kernelLinearMap_apply_le hk hB (f - g)

section Probability

variable [IsProbabilityMeasure μ]

noncomputable def l2ToL1 (f : Lp ℝ 2 μ) : Lp ℝ 1 μ :=
  ((Lp.memLp f).mono_exponent (by norm_num : (1 : ℝ≥0∞) ≤ 2)).toLp f

theorem coeFn_l2ToL1 (f : Lp ℝ 2 μ) : l2ToL1 f =ᵐ[μ] f :=
  MemLp.coeFn_toLp _

noncomputable def l2ToL1LinearMap : Lp ℝ 2 μ →ₗ[ℝ] Lp ℝ 1 μ where
  toFun := l2ToL1
  map_add' f g := by
    apply Lp.ext
    filter_upwards [coeFn_l2ToL1 (f + g), Lp.coeFn_add f g,
      Lp.coeFn_add (l2ToL1 f) (l2ToL1 g), coeFn_l2ToL1 f, coeFn_l2ToL1 g]
      with x ha hab hb hf hg
    simp only [ha, hab, hb, Pi.add_apply, hf, hg]
  map_smul' c f := by
    apply Lp.ext
    filter_upwards [coeFn_l2ToL1 (c • f), Lp.coeFn_smul c f,
      Lp.coeFn_smul c (l2ToL1 f), coeFn_l2ToL1 f] with x ha hb hc hf
    simp only [RingHom.id_apply, ha, hb, hc, Pi.smul_apply, hf]

theorem norm_l2ToL1_le (f : Lp ℝ 2 μ) : ‖l2ToL1 f‖ ≤ ‖f‖ := by
  rw [l2ToL1, Lp.norm_toLp, Lp.norm_def]
  exact ENNReal.toReal_mono (Lp.memLp f).2.ne
    (eLpNorm_le_eLpNorm_of_exponent_le (by norm_num : (1 : ℝ≥0∞) ≤ 2) (Lp.memLp f).1)

noncomputable def l2ToL1Operator : Lp ℝ 2 μ →L[ℝ] Lp ℝ 1 μ :=
  l2ToL1LinearMap.mkContinuous 1 (fun f ↦ by simpa [l2ToL1LinearMap] using norm_l2ToL1_le f)

noncomputable def kernelL2Operator
    (hk : AEStronglyMeasurable k μ) (hB : ∀ᵐ x ∂μ, ‖k x‖ ≤ B) :
    Lp ℝ 2 μ →L[ℝ] E :=
  (kernelOperator hk hB).comp l2ToL1Operator

theorem kernelL2Operator_apply
    (hk : AEStronglyMeasurable k μ) (hB : ∀ᵐ x ∂μ, ‖k x‖ ≤ B)
    (f : Lp ℝ 2 μ) : kernelL2Operator hk hB f = ∫ x, f x • k x ∂μ := by
  change (∫ x, l2ToL1 f x • k x ∂μ) = _
  apply integral_congr_ae
  filter_upwards [coeFn_l2ToL1 f] with x hx
  rw [hx]

theorem norm_kernelL2Operator_le
    (hk : AEStronglyMeasurable k μ) (hB : ∀ᵐ x ∂μ, ‖k x‖ ≤ B)
    (hB0 : 0 ≤ B) : ‖kernelL2Operator hk hB‖ ≤ B := by
  apply ContinuousLinearMap.opNorm_le_bound _ hB0
  intro f
  exact (norm_kernelLinearMap_apply_le hk hB (l2ToL1 f)).trans
    (mul_le_mul_of_nonneg_left (norm_l2ToL1_le f) hB0)

end Probability

section HilbertDuality

variable {F : Type*} [NormedAddCommGroup F] [InnerProductSpace ℝ F]
  [CompleteSpace F] {K : α → F} [IsProbabilityMeasure μ]

/-- The dual pairing follows by commuting one continuous linear functional with
a Banach-valued integral. No Hilbert--Schmidt operator or product Fubini theorem
is needed for this identity. -/
theorem inner_kernelL2Operator
    (hK : AEStronglyMeasurable K μ) (hB : ∀ᵐ x ∂μ, ‖K x‖ ≤ B)
    (v : F) (f : Lp ℝ 2 μ) :
    inner ℝ v (kernelL2Operator hK hB f) =
      ∫ x, f x * inner ℝ v (K x) ∂μ := by
  rw [kernelL2Operator_apply]
  have hf : Integrable (fun x ↦ f x • K x) μ :=
    ((Lp.memLp f).integrable (by norm_num)).smul_bdd B hK hB
  rw [← integral_inner hf v]
  simp only [inner_smul_right]

omit [MeasurableSpace α] [CompleteSpace F] in
/-- Continuity of the area-charge potential is an immediate consequence of
continuity of the kernel into L² and continuity of `innerSL`. -/
theorem continuous_dual_kernel [TopologicalSpace α]
    (hK : Continuous K) (v : F) : Continuous (fun x ↦ inner ℝ v (K x)) :=
  (innerSL ℝ v).continuous.comp hK

/-- An annihilator of the integral operator annihilates the kernel almost
everywhere. The test density is the scalar dual kernel itself. -/
theorem dual_kernel_eq_zero_ae_of_orthogonal
    (hK : AEStronglyMeasurable K μ) (hB : ∀ᵐ x ∂μ, ‖K x‖ ≤ B)
    (v : F) (hv : ∀ f : Lp ℝ 2 μ, inner ℝ v (kernelL2Operator hK hB f) = 0) :
    ∀ᵐ x ∂μ, inner ℝ v (K x) = 0 := by
  let W : α → ℝ := fun x ↦ inner ℝ v (K x)
  have hW : MemLp W 2 μ :=
    ((memLp_top_of_bound hK B hB).const_inner v).mono_exponent le_top
  let f : Lp ℝ 2 μ := hW.toLp W
  have hzero : (∫ x, W x * W x ∂μ) = 0 := by
    specialize hv f
    rw [inner_kernelL2Operator hK hB v f] at hv
    have hfeq : f =ᵐ[μ] W := hW.coeFn_toLp
    calc
      _ = ∫ x, f x * W x ∂μ := by
        apply integral_congr_ae
        filter_upwards [hfeq] with x hx
        rw [hx]
      _ = 0 := hv
  have hint : Integrable (fun x ↦ W x * W x) μ :=
    memLp_one_iff_integrable.mp (hW.mul' hW)
  have hae := (integral_eq_zero_iff_of_nonneg (fun x ↦ mul_self_nonneg (W x)) hint).mp hzero
  filter_upwards [hae] with x hx
  exact mul_self_eq_zero.mp hx

end HilbertDuality

section FullSupportDuality

variable [TopologicalSpace α] [μ.IsOpenPosMeasure]
  {F : Type*} [NormedAddCommGroup F] [InnerProductSpace ℝ F]
  [CompleteSpace F] {K : α → F} [IsProbabilityMeasure μ]

/-- On a full-support parameter space, the continuous dual kernel vanishes
everywhere when its vector annihilates the integral operator. -/
theorem dual_kernel_eq_zero_of_orthogonal
    (hK : AEStronglyMeasurable K μ) (hB : ∀ᵐ x ∂μ, ‖K x‖ ≤ B)
    (hKc : Continuous K) (v : F)
    (hv : ∀ f : Lp ℝ 2 μ, inner ℝ v (kernelL2Operator hK hB f) = 0) :
    ∀ x, inner ℝ v (K x) = 0 := by
  have h := MeasureTheory.Measure.eq_of_ae_eq
    (dual_kernel_eq_zero_ae_of_orthogonal hK hB v hv)
    (continuous_dual_kernel hKc v) continuous_const
  exact fun x ↦ congrFun h x

end FullSupportDuality

section ScalarRepresentatives

/-- The dual pairing with a concrete scalar kernel is its ordinary scalar
integral. The equality is insensitive to the representative chosen by `toLp`. -/
theorem inner_toLp_eq_integral_mul
    (f : Lp ℝ 2 μ) {g : α → ℝ} (hg : MemLp g 2 μ) :
    inner ℝ f (hg.toLp g) = ∫ x, f x * g x ∂μ := by
  rw [L2.inner_def]
  apply integral_congr_ae
  filter_upwards [hg.coeFn_toLp] with x hx
  rw [Real.inner_apply, hx]

variable {β : Type*} [MeasurableSpace β] {ν : Measure β}
  [IsFiniteMeasure μ] [SFinite ν]

/-- A finite target measure makes the scalar L¹ norm of an L² representative
bounded by a fixed constant times its L² norm. -/
theorem integral_norm_coeFn_le (f : Lp ℝ 2 μ) :
    (∫ z, ‖f z‖ ∂μ) ≤
      ‖indicatorConstLp 2 MeasurableSet.univ (measure_ne_top μ Set.univ) (1 : ℝ)‖ * ‖f‖ := by
  let n : Lp ℝ 2 μ := (Lp.memLp f).norm.toLp (fun z ↦ ‖f z‖)
  let e : Lp ℝ 2 μ :=
    indicatorConstLp 2 MeasurableSet.univ (measure_ne_top μ Set.univ) (1 : ℝ)
  have hn : ‖n‖ = ‖f‖ := by
    rw [Lp.norm_toLp, eLpNorm_norm, Lp.norm_def]
  have he : inner ℝ e n = ∫ z, ‖f z‖ ∂μ := by
    rw [L2.inner_indicatorConstLp_one, Measure.restrict_univ]
    exact integral_congr_ae (Lp.memLp f).norm.coeFn_toLp
  rw [← he, ← hn]
  exact real_inner_le_norm e n

omit [SFinite ν] in
/-- Joint scalar measurability and Bochner integrability of the L² kernel
already imply scalar product integrability on a finite target measure. -/
theorem integrable_scalar_kernel_of_integrable_L2
    {K : β → Lp ℝ 2 μ} {k : β → α → ℝ}
    (hK : Integrable K ν)
    (hk : AEStronglyMeasurable (Function.uncurry k) (ν.prod μ))
    (hrep : ∀ᵐ w ∂ν, K w =ᵐ[μ] k w) :
    Integrable (Function.uncurry k) (ν.prod μ) := by
  apply (integrable_prod_iff hk).mpr
  constructor
  · filter_upwards [hrep] with w hw
    exact ((memLp_congr_ae hw).mp (Lp.memLp (K w))).integrable (by norm_num)
  · let C : ℝ :=
      ‖indicatorConstLp 2 MeasurableSet.univ (measure_ne_top μ Set.univ) (1 : ℝ)‖
    apply (hK.norm.const_mul C).mono' hk.norm.integral_prod_right'
    filter_upwards [hrep] with w hw
    rw [Real.norm_eq_abs, abs_of_nonneg (integral_nonneg (fun _ ↦ norm_nonneg _))]
    calc
      (∫ z, ‖k w z‖ ∂μ) = ∫ z, ‖K w z‖ ∂μ :=
        integral_congr_ae (hw.symm.fun_comp norm)
      _ ≤ C * ‖K w‖ := integral_norm_coeFn_le (K w)

/-- A Bochner integral of L² kernels represents the pointwise scalar integral.
The proof tests against indicators and uses scalar Fubini, so it does not
mistake point evaluation for a continuous functional on L². -/
theorem coeFn_integral_eq_integral_ae
    {K : β → Lp ℝ 2 μ} {k : β → α → ℝ}
    (hK : Integrable K ν)
    (hk : Integrable (Function.uncurry k) (ν.prod μ))
    (hrep : ∀ᵐ w ∂ν, K w =ᵐ[μ] k w) :
    (⇑(∫ w, K w ∂ν : Lp ℝ 2 μ)) =ᵐ[μ] fun z ↦ ∫ w, k w z ∂ν := by
  have hleft : Integrable (⇑(∫ w, K w ∂ν : Lp ℝ 2 μ)) μ :=
    (Lp.memLp _).integrable (by norm_num)
  have hright : Integrable (fun z ↦ ∫ w, k w z ∂ν) μ := hk.integral_prod_right
  apply Integrable.ae_eq_of_forall_setIntegral_eq _ _ hleft hright
  intro s hs hμs
  let e : Lp ℝ 2 μ := indicatorConstLp 2 hs hμs.ne (1 : ℝ)
  have hk' : Integrable (Function.uncurry k) (ν.prod (μ.restrict s)) :=
    hk.mono_measure (Measure.prod_mono le_rfl Measure.restrict_le_self)
  calc
    (∫ z in s, (∫ w, K w ∂ν) z ∂μ) = inner ℝ e (∫ w, K w ∂ν) :=
      (L2.inner_indicatorConstLp_one hs hμs.ne _).symm
    _ = ∫ w, inner ℝ e (K w) ∂ν := (integral_inner hK e).symm
    _ = ∫ w, ∫ z in s, K w z ∂μ ∂ν := by
      congr 1
      funext w
      exact L2.inner_indicatorConstLp_one hs hμs.ne _
    _ = ∫ w, ∫ z in s, k w z ∂μ ∂ν := by
      apply integral_congr_ae
      filter_upwards [hrep] with w hw
      exact integral_congr_ae (ae_restrict_of_ae hw)
    _ = ∫ z in s, ∫ w, k w z ∂ν ∂μ := integral_integral_swap hk'

/-- The representative bridge with product integrability discharged from the
jointly measurable scalar kernel and the Bochner-integrable L² kernel. -/
theorem coeFn_integral_eq_integral_ae_of_measurable
    {K : β → Lp ℝ 2 μ} {k : β → α → ℝ}
    (hK : Integrable K ν)
    (hk : AEStronglyMeasurable (Function.uncurry k) (ν.prod μ))
    (hrep : ∀ᵐ w ∂ν, K w =ᵐ[μ] k w) :
    (⇑(∫ w, K w ∂ν : Lp ℝ 2 μ)) =ᵐ[μ] fun z ↦ ∫ w, k w z ∂ν :=
  coeFn_integral_eq_integral_ae hK
    (integrable_scalar_kernel_of_integrable_L2 hK hk hrep) hrep

end ScalarRepresentatives

section FiniteRepresentatives

variable {ι : Type*}

/-- Finite sums in L² agree almost everywhere with the sums of their chosen
scalar representatives. -/
theorem coeFn_sum_ae (s : Finset ι) (F : ι → Lp ℝ 2 μ) :
    (⇑(∑ i ∈ s, F i : Lp ℝ 2 μ)) =ᵐ[μ] fun z ↦ ∑ i ∈ s, F i z := by
  classical
  induction s using Finset.induction_on with
  | empty =>
    filter_upwards [Lp.coeFn_zero ℝ 2 μ] with z hz
    simpa only [Finset.sum_empty, Pi.zero_apply] using hz
  | @insert i s hi ih =>
    rw [Finset.sum_insert hi]
    filter_upwards [Lp.coeFn_add (F i) (∑ j ∈ s, F j), ih] with z ha hs
    simp only [ha, Pi.add_apply, hs, Finset.sum_insert hi]

/-- An equal-weight mean of L² kernels has the expected scalar representative.
The equality holds also for an empty mean; applications separately provide
positive `N` so that the associated polynomial has positive degree. -/
theorem coeFn_empirical_mean_ae {N : ℕ}
    (F : Fin N → Lp ℝ 2 μ) (f : Fin N → α → ℝ)
    (hrep : ∀ i, F i =ᵐ[μ] f i) :
    (⇑((N : ℝ)⁻¹ • (∑ i, F i) : Lp ℝ 2 μ)) =ᵐ[μ]
      fun z ↦ (N : ℝ)⁻¹ * ∑ i, f i z := by
  have hall : ∀ᵐ z ∂μ, ∀ i, F i z = f i z := Filter.eventually_all.mpr hrep
  filter_upwards [Lp.coeFn_smul (N : ℝ)⁻¹ (∑ i, F i),
    coeFn_sum_ae Finset.univ F, hall] with z hsm hsum hz
  simp only [hsm, Pi.smul_apply, smul_eq_mul, hsum, hz]

end FiniteRepresentatives


end CampaignAnalysis277Kernel
end
