variable {H : Set ℂ} {μ : Measure ℂ} {f : ℂ → ℝ} {w z : ℂ} {R : ℝ}

/-- Quantitative decay of a logarithmic kernel after subtracting its mass term. -/
theorem abs_log_norm_sub_le (hw : w ≠ 0) (hz : ‖z‖ ≤ ‖w‖ / 2) :
    |Real.log ‖w - z‖ - Real.log ‖w‖| ≤ (3 / 2) * ‖z‖ / ‖w‖ := by
  have hwp : 0 < ‖w‖ := norm_pos_iff.mpr hw
  have hzw : ‖z‖ < ‖w‖ := hz.trans_lt (half_lt_self hwp)
  have hwz : w - z ≠ 0 := sub_ne_zero.mpr (by
    intro h
    have he := congrArg norm h
    linarith)
  have hsmall : ‖-(z / w)‖ ≤ 1 / 2 := by
    rw [norm_neg, norm_div]
    exact (div_le_iff₀ hwp).mpr (by linarith)
  have heq : 1 + -(z / w) = (w - z) / w := by
    field_simp
    ring
  have hlog : Real.log ‖w - z‖ - Real.log ‖w‖ =
      (Complex.log (1 + -(z / w))).re := by
    rw [Complex.log_re, heq, norm_div,
      Real.log_div (norm_ne_zero_iff.mpr hwz) (norm_ne_zero_iff.mpr hw)]
  rw [hlog]
  calc
    |(Complex.log (1 + -(z / w))).re| ≤ ‖Complex.log (1 + -(z / w))‖ :=
      Complex.abs_re_le_norm _
    _ ≤ (3 / 2) * ‖-(z / w)‖ := Complex.norm_log_one_add_half_le_self hsmall
    _ = (3 / 2) * ‖z‖ / ‖w‖ := by rw [norm_neg, norm_div]; ring

/-- The potential differs from its total mass times `log ‖w‖` by `O(1/‖w‖)`.
The statement has an explicit constant and holds for every sufficiently far
point, with no regularity assumptions on the compact support. -/
theorem abs_potential_sub_mass_log_le (hH : IsCompact H) (hf : IntegrableOn f H μ)
    (hR : 0 < R) (hbound : ∀ z ∈ H, ‖z‖ ≤ R) (hw : 2 * R < ‖w‖) :
    |(∫ z in H, f z * Real.log ‖w - z‖ ∂μ) -
        (∫ z in H, f z ∂μ) * Real.log ‖w‖| ≤
      ((3 / 2) * R / ‖w‖) * ∫ z in H, ‖f z‖ ∂μ := by
  have hwp : 0 < ‖w‖ := by linarith
  have hwn : w ≠ 0 := norm_pos_iff.mp hwp
  have hwH : w ∉ H := by
    intro h
    have := hbound w h
    linarith
  have hpot := hf.mul_continuousOn
    (Erdos1040HarmonicPotential.continuousOn_log_norm hwH) hH
  rw [← integral_mul_const, ← integral_sub hpot (hf.mul_const (Real.log ‖w‖)),
    ← Real.norm_eq_abs]
  calc
    ‖∫ z in H, (f z * Real.log ‖w - z‖ - f z * Real.log ‖w‖) ∂μ‖ ≤
        ∫ z in H, ((3 / 2) * R / ‖w‖) * ‖f z‖ ∂μ := by
      apply norm_integral_le_of_norm_le (hf.norm.const_mul ((3 / 2) * R / ‖w‖))
      filter_upwards [ae_restrict_mem hH.measurableSet] with z hz
      have hsmall : ‖z‖ ≤ ‖w‖ / 2 := by have := hbound z hz; linarith
      have hlog : ‖Real.log ‖w - z‖ - Real.log ‖w‖‖ ≤ (3 / 2) * R / ‖w‖ := by
        rw [Real.norm_eq_abs]
        exact (abs_log_norm_sub_le hwn hsmall).trans (by gcongr; exact hbound z hz)
      rw [← mul_sub, norm_mul]
      simpa only [mul_comm] using mul_le_mul_of_nonneg_left hlog (norm_nonneg (f z))
    _ = ((3 / 2) * R / ‖w‖) * ∫ z in H, ‖f z‖ ∂μ := integral_const_mul _ _

/-- Subtracting total mass times `log ‖w‖` gives a potential tending to zero at
infinity. The limit is along the cocompact filter on the plane. -/
theorem tendsto_potential_sub_mass_log (hH : IsCompact H) (hf : IntegrableOn f H μ) :
    Tendsto (fun w : ℂ ↦ (∫ z in H, f z * Real.log ‖w - z‖ ∂μ) -
      (∫ z in H, f z ∂μ) * Real.log ‖w‖) (cocompact ℂ) (𝓝 0) := by
  obtain ⟨R, hR, hbound⟩ := hH.isBounded.exists_pos_norm_le
  have hi : Tendsto (fun w : ℂ ↦ ‖w‖⁻¹) (cocompact ℂ) (𝓝 (0 : ℝ)) :=
    tendsto_inv_atTop_zero.comp tendsto_norm_cocompact_atTop
  have ht : Tendsto
      (fun w : ℂ ↦ ((3 / 2) * R / ‖w‖) * ∫ z in H, ‖f z‖ ∂μ)
      (cocompact ℂ) (𝓝 0) := by
    simpa only [div_eq_mul_inv, mul_zero, zero_mul] using
      ((tendsto_const_nhds (x := (3 / 2) * R)).mul hi).mul_const (∫ z in H, ‖f z‖ ∂μ)
  apply squeeze_zero_norm' _ ht
  filter_upwards [tendsto_norm_cocompact_atTop.eventually_gt_atTop (2 * R)] with w hw
  simpa only [Real.norm_eq_abs] using abs_potential_sub_mass_log_le hH hf hR hbound hw


end Erdos1040PotentialDecay
end
/- END LOCAL MODULE Erdos1040PotentialDecay -/

/- BEGIN LOCAL MODULE Erdos1040CauchyTransform -/
section
/-!
Cauchy transforms and moment comparison for real compactly supported charges.
This is a concrete analytic bridge for the candidate proof, not an equilibrium
measure or exterior uniqueness axiom.
-/

open MeasureTheory Set Metric Complex Filter InnerProductSpace
open scoped Topology

namespace Erdos1040CauchyTransform

open Erdos1040HarmonicPotential

variable {H : Set ℂ} {μ ν : Measure ℂ} {f g : ℂ → ℝ} {w₀ w z : ℂ} {r : ℝ}

theorem hasDerivAt_localPotential (hH : IsCompact H) (hf : IntegrableOn f H μ)
    (hr : 0 < r) (hsep : ∀ z ∈ H, r ≤ ‖w₀ - z‖) (hw : w ∈ ball w₀ (r / 2)) :
    HasDerivAt
      (fun v ↦ ∫ z in H, (f z : ℂ) * Complex.log ((v - z) / (w₀ - z)) ∂μ)
      (∫ z in H, (f z : ℂ) / (w - z) ∂μ) w := by
  have hfc : IntegrableOn (fun z ↦ (f z : ℂ)) H μ :=
    Complex.ofRealCLM.integrable_comp hf
  have hlogint (v : ℂ) (hv : v ∈ ball w₀ (r / 2)) :
      IntegrableOn (fun z ↦ (f z : ℂ) * Complex.log ((v - z) / (w₀ - z))) H μ := by
    apply hfc.mul_continuousOn _ hH
    have hv' : ‖v - w₀‖ < r / 2 := by simpa only [mem_ball, dist_eq_norm] using hv
    exact continuousOn_normalized_log hsep hr (hv'.trans (half_lt_self hr))
  have hw' : ‖w - w₀‖ < r / 2 := by simpa only [mem_ball, dist_eq_norm] using hw
  have hmeas : ∀ᶠ v in 𝓝 w,
      AEStronglyMeasurable
        (fun z ↦ (f z : ℂ) * Complex.log ((v - z) / (w₀ - z))) (μ.restrict H) := by
    filter_upwards [isOpen_ball.mem_nhds hw] with v hv
    exact (hlogint v hv).aestronglyMeasurable
  have hderivint : IntegrableOn (fun z ↦ (f z : ℂ) / (w - z)) H μ := by
    simpa only [div_eq_mul_inv, Pi.inv_apply, Pi.sub_apply, id_eq] using hfc.mul_continuousOn
      ((continuous_const.sub continuous_id).continuousOn.inv₀ (fun z hz ↦
        norm_pos_iff.mp ((half_pos hr).trans (half_separation (hsep z hz) hw')))) hH
  have hbound : ∀ᵐ z ∂μ.restrict H, ∀ v ∈ ball w₀ (r / 2),
      ‖(f z : ℂ) / (v - z)‖ ≤ (2 / r) * ‖f z‖ := by
    filter_upwards [ae_restrict_mem hH.measurableSet] with z hz
    intro v hv
    have hv' : ‖v - w₀‖ < r / 2 := by simpa only [mem_ball, dist_eq_norm] using hv
    rw [norm_div, Complex.norm_real]
    calc
      ‖f z‖ / ‖v - z‖ ≤ ‖f z‖ / (r / 2) :=
        div_le_div_of_nonneg_left (norm_nonneg _) (half_pos hr)
          (half_separation (hsep z hz) hv').le
      _ = (2 / r) * ‖f z‖ := by ring
  have hdiff : ∀ᵐ z ∂μ.restrict H, ∀ v ∈ ball w₀ (r / 2),
      HasDerivAt (fun v : ℂ ↦ (f z : ℂ) * Complex.log ((v - z) / (w₀ - z)))
        ((f z : ℂ) / (v - z)) v := by
    filter_upwards [ae_restrict_mem hH.measurableSet] with z hz
    intro v hv
    have hv' : ‖v - w₀‖ < r / 2 := by simpa only [mem_ball, dist_eq_norm] using hv
    simpa only [div_eq_mul_inv] using
      (hasDerivAt_normalized_log hr (hsep z hz) hv').const_mul (f z : ℂ)
  exact (hasDerivAt_integral_of_dominated_loc_of_deriv_le (isOpen_ball.mem_nhds hw)
    hmeas (hlogint w hw) hderivint.aestronglyMeasurable hbound
    (hf.norm.const_mul (2 / r)) hdiff).2


/-- Equal real logarithmic potentials on the exterior have equal complex
Cauchy transforms there. The local holomorphic logarithms have equal real
parts, so their difference is constant by the open mapping theorem. -/
theorem cauchy_eq_of_potential_eq (hH : IsCompact H)
    (hf : IntegrableOn f H μ) (hg : IntegrableOn g H ν)
    (hpot : ∀ w ∉ H, (∫ z in H, f z * Real.log ‖w - z‖ ∂μ) =
      ∫ z in H, g z * Real.log ‖w - z‖ ∂ν)
    (hw₀ : w₀ ∉ H) :
    (∫ z in H, (f z : ℂ) / (w₀ - z) ∂μ) =
      ∫ z in H, (g z : ℂ) / (w₀ - z) ∂ν := by
  obtain ⟨r, hr, hball⟩ := Metric.isOpen_iff.mp hH.isClosed.isOpen_compl w₀ hw₀
  have hsep : ∀ z ∈ H, r ≤ ‖w₀ - z‖ := by
    intro z hz
    by_contra h
    have hzin : z ∈ ball w₀ r := by
      simpa only [mem_ball, dist_eq_norm, norm_sub_rev z w₀] using lt_of_not_ge h
    exact hball hzin hz
  let A : ℂ → ℂ := fun v ↦
    (∫ z in H, (f z : ℂ) * Complex.log ((v - z) / (w₀ - z)) ∂μ) -
    ∫ z in H, (g z : ℂ) * Complex.log ((v - z) / (w₀ - z)) ∂ν
  have hA : AnalyticOnNhd ℂ A (ball w₀ (r / 2)) :=
    ((differentiableOn_localPotential hH hf hr hsep).sub
      (differentiableOn_localPotential hH hg hr hsep)).analyticOnNhd isOpen_ball
  have hAre : ∀ v ∈ ball w₀ (r / 2), (A v).re = 0 := by
    intro v hv
    have hv' : ‖v - w₀‖ < r / 2 := by simpa only [mem_ball, dist_eq_norm] using hv
    have hvH : v ∉ H := hball (by
      rw [mem_ball, dist_eq_norm]
      exact hv'.trans (half_lt_self hr))
    have hf' := potential_eq_local_re_add hH hf hr hsep hv'
    have hg' := potential_eq_local_re_add hH hg hr hsep hv'
    have heq := hpot v hvH
    have heq₀ := hpot w₀ hw₀
    dsimp only [A]
    rw [Complex.sub_re]
    linarith
  obtain ⟨c, hc⟩ := hA.eq_const_of_re_eq_const hAre isOpen_ball
    ⟨⟨w₀, mem_ball_self (half_pos hr)⟩, (convex_ball w₀ (r / 2)).isPreconnected⟩
  have heq : A =ᶠ[𝓝 w₀] fun _ ↦ c := by
    filter_upwards [ball_mem_nhds w₀ (half_pos hr)] with v hv
    exact hc v hv
  have hz : HasDerivAt A 0 w₀ := (hasDerivAt_const w₀ c).congr_of_eventuallyEq heq
  have hd : HasDerivAt A
      ((∫ z in H, (f z : ℂ) / (w₀ - z) ∂μ) -
        ∫ z in H, (g z : ℂ) / (w₀ - z) ∂ν) w₀ :=
    (hasDerivAt_localPotential hH hf hr hsep (mem_ball_self (half_pos hr))).sub
      (hasDerivAt_localPotential hH hg hr hsep (mem_ball_self (half_pos hr)))
  exact sub_eq_zero.mp (hd.unique hz)

section ComplexDensities

variable {q q' : ℂ → ℂ} {R : ℝ}

theorem integrableOn_cauchy (hH : IsCompact H) (hq : IntegrableOn q H μ)
    (hw : w ∉ H) : IntegrableOn (fun z ↦ q z / (w - z)) H μ := by
  simpa only [div_eq_mul_inv, Pi.inv_apply, Pi.sub_apply, id_eq] using
    hq.mul_continuousOn ((continuous_const.sub continuous_id).continuousOn.inv₀
      (fun z hz ↦ sub_ne_zero.mpr (by intro h; change w = z at h; exact hw (h.symm ▸ hz)))) hH

theorem norm_mul_cauchy_sub_mass_le (hH : IsCompact H) (hq : IntegrableOn q H μ)
    (hR : 0 < R) (hbound : ∀ z ∈ H, ‖z‖ ≤ R) (hw : 2 * R < ‖w‖) :
    ‖w * (∫ z in H, q z / (w - z) ∂μ) - ∫ z in H, q z ∂μ‖ ≤
      (2 * R / ‖w‖) * ∫ z in H, ‖q z‖ ∂μ := by
  have hwp : 0 < ‖w‖ := by linarith
  have hwH : w ∉ H := by intro h; have := hbound w h; linarith
  have hint := integrableOn_cauchy hH hq hwH
  rw [← integral_const_mul, ← integral_sub (hint.const_mul w) hq]
  calc
    ‖∫ z in H, (w * (q z / (w - z)) - q z) ∂μ‖ ≤
        ∫ z in H, (2 * R / ‖w‖) * ‖q z‖ ∂μ := by
      apply norm_integral_le_of_norm_le (hq.norm.const_mul (2 * R / ‖w‖))
      filter_upwards [ae_restrict_mem hH.measurableSet] with z hz
      have hgap : ‖w‖ / 2 < ‖w - z‖ := by
        have := norm_sub_norm_le w z
        have := hbound z hz
        linarith
      have hne : w - z ≠ 0 := norm_pos_iff.mp ((half_pos hwp).trans hgap)
      have heq : w * (q z / (w - z)) - q z = q z * z / (w - z) := by
        field_simp
        ring
      rw [heq, norm_div, norm_mul]
      calc
        ‖q z‖ * ‖z‖ / ‖w - z‖ ≤ ‖q z‖ * R / (‖w‖ / 2) := by
          gcongr
          · exact hbound z hz
        _ = (2 * R / ‖w‖) * ‖q z‖ := by ring
    _ = (2 * R / ‖w‖) * ∫ z in H, ‖q z‖ ∂μ := integral_const_mul _ _

theorem tendsto_mul_cauchy (hH : IsCompact H) (hq : IntegrableOn q H μ) :
    Tendsto (fun w : ℂ ↦ w * ∫ z in H, q z / (w - z) ∂μ)
      (cocompact ℂ) (𝓝 (∫ z in H, q z ∂μ)) := by
  obtain ⟨R, hR, hbound⟩ := hH.isBounded.exists_pos_norm_le
  have hi : Tendsto (fun w : ℂ ↦ ‖w‖⁻¹) (cocompact ℂ) (𝓝 (0 : ℝ)) :=
    tendsto_inv_atTop_zero.comp tendsto_norm_cocompact_atTop
  have ht : Tendsto
      (fun w : ℂ ↦ (2 * R / ‖w‖) * ∫ z in H, ‖q z‖ ∂μ)
      (cocompact ℂ) (𝓝 0) := by
    simpa only [div_eq_mul_inv, mul_zero, zero_mul] using
      ((tendsto_const_nhds (x := 2 * R)).mul hi).mul_const (∫ z in H, ‖q z‖ ∂μ)
  have hd : Tendsto
      (fun w : ℂ ↦ w * (∫ z in H, q z / (w - z) ∂μ) - ∫ z in H, q z ∂μ)
      (cocompact ℂ) (𝓝 0) := by
    apply squeeze_zero_norm' _ ht
    filter_upwards [tendsto_norm_cocompact_atTop.eventually_gt_atTop (2 * R)] with w hw
    exact norm_mul_cauchy_sub_mass_le hH hq hR hbound hw
  simpa only [sub_add_cancel, zero_add] using hd.add_const (∫ z in H, q z ∂μ)

theorem mass_eq_of_cauchy_eq (hH : IsCompact H)
    (hq : IntegrableOn q H μ) (hq' : IntegrableOn q' H ν)
    (hc : ∀ w ∉ H, (∫ z in H, q z / (w - z) ∂μ) =
      ∫ z in H, q' z / (w - z) ∂ν) :
    (∫ z in H, q z ∂μ) = ∫ z in H, q' z ∂ν := by
  apply tendsto_nhds_unique (tendsto_mul_cauchy hH hq)
  apply (tendsto_mul_cauchy hH hq').congr'
  filter_upwards [hH.compl_mem_cocompact] with w hw
  rw [hc w hw]

theorem cauchy_mul_coordinate (hH : IsCompact H) (hq : IntegrableOn q H μ)
    (hw : w ∉ H) :
    (∫ z in H, (q z * z) / (w - z) ∂μ) =
      w * (∫ z in H, q z / (w - z) ∂μ) - ∫ z in H, q z ∂μ := by
  rw [← integral_const_mul,
    ← integral_sub ((integrableOn_cauchy hH hq hw).const_mul w) hq]
  apply setIntegral_congr_fun hH.measurableSet
  intro z hz
  have hne : w - z ≠ 0 := sub_ne_zero.mpr (by intro h; exact hw (h.symm ▸ hz))
  change q z * z / (w - z) = w * (q z / (w - z)) - q z
  field_simp
  ring

/-- All complex polynomial moments are determined by the exterior Cauchy
transform. The proof extracts total mass at infinity and iterates the exact
identity `C_(zq)(w) = w C_q(w) - mass(q)`. -/
theorem moments_eq_of_cauchy_eq (hH : IsCompact H)
    (hq : IntegrableOn q H μ) (hq' : IntegrableOn q' H ν)
    (hc : ∀ w ∉ H, (∫ z in H, q z / (w - z) ∂μ) =
      ∫ z in H, q' z / (w - z) ∂ν) :
    ∀ n : ℕ, (∫ z in H, q z * z ^ n ∂μ) = ∫ z in H, q' z * z ^ n ∂ν := by
  have hint (n : ℕ) : IntegrableOn (fun z ↦ q z * z ^ n) H μ :=
    hq.mul_continuousOn (continuous_id.pow n).continuousOn hH
  have hint' (n : ℕ) : IntegrableOn (fun z ↦ q' z * z ^ n) H ν :=
    hq'.mul_continuousOn (continuous_id.pow n).continuousOn hH
  have hcn : ∀ n : ℕ, ∀ w ∉ H,
      (∫ z in H, (q z * z ^ n) / (w - z) ∂μ) =
        ∫ z in H, (q' z * z ^ n) / (w - z) ∂ν := by
    intro n
    induction n with
    | zero => simpa only [pow_zero, mul_one] using hc
    | succ n ih =>
      have hm := mass_eq_of_cauchy_eq hH (hint n) (hint' n) ih
      intro w hw
      simp only [pow_succ, ← mul_assoc]
      rw [cauchy_mul_coordinate hH (hint n) hw,
        cauchy_mul_coordinate hH (hint' n) hw, ih w hw, hm]
  intro n
  exact mass_eq_of_cauchy_eq hH (hint n) (hint' n) (hcn n)

theorem polynomial_integrals_eq_of_moments_eq (hH : IsCompact H)
    (hq : IntegrableOn q H μ) (hq' : IntegrableOn q' H ν)
    (hm : ∀ n : ℕ, (∫ z in H, q z * z ^ n ∂μ) = ∫ z in H, q' z * z ^ n ∂ν)
    (p : Polynomial ℂ) :
    (∫ z in H, q z * p.eval z ∂μ) = ∫ z in H, q' z * p.eval z ∂ν := by
  induction p using Polynomial.induction_on' with
  | add p₁ p₂ h₁ h₂ =>
    simp only [Polynomial.eval_add, mul_add]
    rw [integral_add (hq.mul_continuousOn p₁.continuousOn hH)
        (hq.mul_continuousOn p₂.continuousOn hH),
      integral_add (hq'.mul_continuousOn p₁.continuousOn hH)
        (hq'.mul_continuousOn p₂.continuousOn hH), h₁, h₂]
  | monomial n a =>
    have hfun (Q : ℂ → ℂ) :
        (fun z ↦ Q z * (Polynomial.monomial n a).eval z) =
        fun z ↦ a * (Q z * z ^ n) := by
      funext z
      rw [Polynomial.eval_monomial]
      ring
    rw [hfun q, hfun q', integral_const_mul, integral_const_mul, hm n]

end ComplexDensities

/-- Equality of real logarithmic potentials on the complement of a compact set
forces equality of every complex moment of the two real charges. -/
theorem complex_moments_eq_of_potential_eq (hH : IsCompact H)
    (hf : IntegrableOn f H μ) (hg : IntegrableOn g H ν)
    (hpot : ∀ w ∉ H, (∫ z in H, f z * Real.log ‖w - z‖ ∂μ) =
      ∫ z in H, g z * Real.log ‖w - z‖ ∂ν) :
    ∀ n : ℕ, (∫ z in H, (f z : ℂ) * z ^ n ∂μ) =
      ∫ z in H, (g z : ℂ) * z ^ n ∂ν :=
  moments_eq_of_cauchy_eq hH (Complex.ofRealCLM.integrable_comp hf)
    (Complex.ofRealCLM.integrable_comp hg)
    (fun _ hw ↦ cauchy_eq_of_potential_eq hH hf hg hpot hw)

/-- In particular, equal exterior potentials give equal integrals of the real
part of every complex polynomial, the exact harmonic-polynomial pairing used
in the Hilbert-space annihilator argument. -/
theorem real_polynomial_integrals_eq_of_potential_eq (hH : IsCompact H)
    (hf : IntegrableOn f H μ) (hg : IntegrableOn g H ν)
    (hpot : ∀ w ∉ H, (∫ z in H, f z * Real.log ‖w - z‖ ∂μ) =
      ∫ z in H, g z * Real.log ‖w - z‖ ∂ν) (p : Polynomial ℂ) :
    (∫ z in H, f z * (p.eval z).re ∂μ) = ∫ z in H, g z * (p.eval z).re ∂ν := by
  have hfc : IntegrableOn (fun z ↦ (f z : ℂ)) H μ := Complex.ofRealCLM.integrable_comp hf
  have hgc : IntegrableOn (fun z ↦ (g z : ℂ)) H ν := Complex.ofRealCLM.integrable_comp hg
  have hh := polynomial_integrals_eq_of_moments_eq hH hfc hgc
    (complex_moments_eq_of_potential_eq hH hf hg hpot) p
  have hfRe : (∫ z in H, f z * (p.eval z).re ∂μ) =
      (∫ z in H, (f z : ℂ) * p.eval z ∂μ).re := by
    simpa only [Complex.reCLM_apply, Complex.mul_re, Complex.ofReal_re,
      Complex.ofReal_im, zero_mul, sub_zero] using
      Complex.reCLM.integral_comp_comm (hfc.mul_continuousOn p.continuousOn hH)
  have hgRe : (∫ z in H, g z * (p.eval z).re ∂ν) =
      (∫ z in H, (g z : ℂ) * p.eval z ∂ν).re := by
    simpa only [Complex.reCLM_apply, Complex.mul_re, Complex.ofReal_re,
      Complex.ofReal_im, zero_mul, sub_zero] using
      Complex.reCLM.integral_comp_comm (hgc.mul_continuousOn p.continuousOn hH)
  rw [hfRe, hgRe, hh]

/-- The centered polynomial is orthogonal to an area charge as soon as its
exterior potential is a scalar multiple of the reference measure's potential. -/
theorem centered_polynomial_pairing_zero [IsFiniteMeasure ν]
    (hH : IsCompact H) (hf : IntegrableOn f H μ) (c : ℝ)
    (hpot : ∀ w ∉ H, (∫ z in H, f z * Real.log ‖w - z‖ ∂μ) =
      c * ∫ z in H, Real.log ‖w - z‖ ∂ν) (p : Polynomial ℂ)
    (hcenter : (∫ z in H, (p.eval z).re ∂ν) = 0) :
    (∫ z in H, f z * (p.eval z).re ∂μ) = 0 := by
  have hg : IntegrableOn (fun _ : ℂ ↦ c) H ν := integrable_const c
  have heq := real_polynomial_integrals_eq_of_potential_eq hH hf hg
    (fun w hw ↦ by rw [integral_const_mul]; exact hpot w hw) p
  rwa [integral_const_mul, hcenter, mul_zero] at heq


end Erdos1040CauchyTransform
end
/- END LOCAL MODULE Erdos1040CauchyTransform -/

/- BEGIN LOCAL MODULE Erdos1040LogKernel -/
section
/-! Logarithmic-kernel integrability used by the proposed E1040 proof.
All conclusions in this file are unconditional analytic infrastructure.
-/

namespace Erdos1040LogKernel

open MeasureTheory Set Metric

lemma sq_log_le_four_mul {x : ℝ} (hx : 1 ≤ x) : (Real.log x) ^ 2 ≤ 4 * x := by
  have hx0 : 0 < x := lt_of_lt_of_le zero_lt_one hx
  have hs := Real.log_le_sub_one_of_pos (Real.sqrt_pos.2 hx0)
  rw [Real.log_sqrt hx0.le] at hs
  have hlog : Real.log x ≤ 2 * Real.sqrt x := by linarith
  calc
    _ ≤ (2 * Real.sqrt x) ^ 2 := by gcongr; exact Real.log_nonneg hx
    _ = _ := by nlinarith [Real.sq_sqrt hx0.le]

lemma sq_log_le_four_mul_add_inv {x : ℝ} (hx : 0 < x) :
    (Real.log x) ^ 2 ≤ 4 * (x + x⁻¹) := by
  by_cases hx1 : 1 ≤ x
  · have := sq_log_le_four_mul hx1
    have := inv_nonneg.2 hx.le
    linarith
  · have hinv : 1 ≤ x⁻¹ := (one_le_inv₀ hx).2 (le_of_not_ge hx1)
    have h := sq_log_le_four_mul hinv
    rw [Real.log_inv, neg_sq] at h
    linarith

lemma sq_log_le_inverse_on_ball (r : ℝ) (z : ℂ) (hz : z ∈ ball 0 r) :
    ‖(Real.log ‖z‖) ^ 2‖ ≤ (4 * (r ^ 2 + 1)) * ‖z‖ ^ (-(1 : ℝ)) := by
  have hzr : ‖z‖ < r := mem_ball_zero_iff.1 hz
  by_cases hz0 : z = 0
  · simp [hz0]
  have hn : 0 < ‖z‖ := norm_pos_iff.2 hz0
  have hr : 0 < r := hn.trans hzr
  have hlog := sq_log_le_four_mul_add_inv hn
  rw [Real.norm_eq_abs, abs_of_nonneg (sq_nonneg _), Real.rpow_neg_one]
  have hnr : ‖z‖ ^ 2 ≤ r ^ 2 := by gcongr
  have hmul : ‖z‖ * ‖z‖⁻¹ = 1 := mul_inv_cancel₀ hn.ne'
  have hbound : ‖z‖ ≤ r ^ 2 * ‖z‖⁻¹ := by
    exact (le_mul_inv_iff₀ hn).2 (by nlinarith)
  nlinarith [inv_nonneg.2 hn.le]

theorem integrableOn_sq_log_norm_ball (r : ℝ) :
    IntegrableOn (fun z : ℂ => (Real.log ‖z‖) ^ 2) (ball 0 r) := by
  refine integrableOn_ball_of_norm_le_rpow (C := 4 * (r ^ 2 + 1)) (α := 1)
    (by norm_num [Complex.finrank_real_complex]) ?_ ?_ ?_
  · norm_num [Complex.finrank_real_complex]
  · filter_upwards [self_mem_ae_restrict isOpen_ball.measurableSet] with z hz
    exact sq_log_le_inverse_on_ball r z hz
  · exact ((Real.measurable_log.comp measurable_norm).pow_const 2).aestronglyMeasurable

theorem integrableOn_sq_log_norm_sub_ball (w : ℂ) (r : ℝ) :
    IntegrableOn (fun z : ℂ => (Real.log ‖z - w‖) ^ 2) (ball w r) := by
  have h := ((measurePreserving_sub_right volume w).integrableOn_comp_preimage
    (Homeomorph.subRight w).measurableEmbedding).2 (integrableOn_sq_log_norm_ball r)
  simpa [Function.comp_def, ball, dist_eq_norm] using h

theorem integrableOn_sq_log_norm_sub_bounded (w : ℂ) (s : Set ℂ)
    (hs : Bornology.IsBounded s) :
    IntegrableOn (fun z : ℂ => (Real.log ‖z - w‖) ^ 2) s := by
  obtain ⟨r, hr⟩ := (Metric.isBounded_iff_subset_ball w).1 hs
  exact (integrableOn_sq_log_norm_sub_ball w r).mono_set hr

theorem memLp_log_norm_sub_bounded (w : ℂ) (s : Set ℂ)
    (hs : Bornology.IsBounded s) :
    MemLp (fun z : ℂ => Real.log ‖z - w‖) 2 (volume.restrict s) := by
  apply (memLp_two_iff_integrable_sq
    ((Real.measurable_log.comp ((measurable_id.sub_const w).norm)).aestronglyMeasurable)).2
  exact integrableOn_sq_log_norm_sub_bounded w s hs

noncomputable def logKernel (s : Set ℂ) (hs : Bornology.IsBounded s) (w : ℂ) :
    Lp ℝ 2 (volume.restrict s) :=
  (memLp_log_norm_sub_bounded w s hs).toLp (fun z : ℂ => Real.log ‖z - w‖)

theorem coeFn_logKernel (s : Set ℂ) (hs : Bornology.IsBounded s) (w : ℂ) :
    logKernel s hs w =ᵐ[volume.restrict s] (fun z : ℂ => Real.log ‖z - w‖) :=
  (memLp_log_norm_sub_bounded w s hs).coeFn_toLp

noncomputable def restrictL2 (s : Set ℂ) :
    Lp ℝ 2 (volume : Measure ℂ) →L[ℝ] Lp ℝ 2 (volume.restrict s) :=
  Lp.LpToLpOfMeasureLeSMul (c := 1) (by simp) (by simpa using Measure.restrict_le_self (μ := (volume : Measure ℂ)) (s := s))

theorem coeFn_restrictL2 (s : Set ℂ) (f : Lp ℝ 2 (volume : Measure ℂ)) :
    restrictL2 s f =ᵐ[volume.restrict s] f :=
  Lp.coeFn_LpToLpOfMeasureLeSMul _ _ f

noncomputable def cutoffLog (r : ℝ) : ℂ → ℝ := (ball 0 r).indicator (fun z => Real.log ‖z‖)

theorem memLp_cutoffLog (r : ℝ) : MemLp (cutoffLog r) 2 volume := by
  apply (memLp_indicator_iff_restrict isOpen_ball.measurableSet).2
  simpa using memLp_log_norm_sub_bounded 0 (ball 0 r) isBounded_ball

noncomputable def cutoffL2 (r : ℝ) : Lp ℝ 2 (volume : Measure ℂ) :=
  (memLp_cutoffLog r).toLp (cutoffLog r)

def shiftMap (w : ℂ) : C(ℂ, ℂ) := ⟨fun z => z - w, by fun_prop⟩

theorem shift_preserves (w : ℂ) : MeasurePreserving (shiftMap w) volume volume :=
  measurePreserving_sub_right volume w

noncomputable def translatedCutoff (r : ℝ) (w : ℂ) : Lp ℝ 2 (volume : Measure ℂ) :=
  Lp.compMeasurePreserving (shiftMap w) (shift_preserves w) (cutoffL2 r)

theorem continuous_translatedCutoff (r : ℝ) : Continuous (translatedCutoff r) := by
  have hg : Continuous shiftMap :=
    ContinuousMap.continuous_of_continuous_uncurry _ (by dsimp [shiftMap, Function.uncurry]; fun_prop)
  exact continuous_const.compMeasurePreservingLp hg shift_preserves (by simp)

theorem coeFn_translatedCutoff (r : ℝ) (w : ℂ) :
    translatedCutoff r w =ᵐ[volume] (fun z => cutoffLog r (z - w)) := by
  exact (Lp.coeFn_compMeasurePreserving (cutoffL2 r) (shift_preserves w)).trans
    ((shift_preserves w).quasiMeasurePreserving.ae_eq (memLp_cutoffLog r).coeFn_toLp)

theorem logKernel_eq_restricted_translate (s : Set ℂ) (hs : Bornology.IsBounded s)
    (hm : MeasurableSet s) (r : ℝ) (w : ℂ) (h : ∀ z ∈ s, ‖z - w‖ < r) :
    logKernel s hs w = restrictL2 s (translatedCutoff r w) := by
  apply Lp.ext
  filter_upwards [coeFn_logKernel s hs w, coeFn_restrictL2 s (translatedCutoff r w),
    (coeFn_translatedCutoff r w).restrict,
    self_mem_ae_restrict hm] with z hz₁ hz₂ hz₃ hz₄
  rw [hz₁, hz₂, hz₃]
  exact (Set.indicator_of_mem (mem_ball_zero_iff.2 (h z hz₄))
    (fun z : ℂ => Real.log ‖z‖)).symm

theorem continuous_logKernel (s : Set ℂ) (hs : Bornology.IsBounded s)
    (hm : MeasurableSet s) : Continuous (logKernel s hs) := by
  rw [continuous_iff_continuousAt]
  intro w₀
  obtain ⟨B, hB⟩ := (Metric.isBounded_iff_subset_ball (0 : ℂ)).1 hs
  let R := B + ‖w₀‖ + 2
  have heq : logKernel s hs =ᶠ[nhds w₀]
      (fun w => restrictL2 s (translatedCutoff R w)) := by
    filter_upwards [Metric.ball_mem_nhds w₀ (by norm_num : (0 : ℝ) < 1)] with w hw
    apply logKernel_eq_restricted_translate s hs hm R w
    intro z hz
    have hzB : ‖z‖ < B := mem_ball_zero_iff.1 (hB hz)
    have hwB : ‖w - w₀‖ < 1 := by simpa only [Metric.mem_ball, dist_eq_norm] using hw
    have hnw : ‖w‖ ≤ ‖w - w₀‖ + ‖w₀‖ := by
      simpa using norm_add_le (w - w₀) w₀
    have hnz : ‖z - w‖ ≤ ‖z‖ + ‖w‖ := norm_sub_le z w
    dsimp [R]
    linarith
  exact (((restrictL2 s).continuous.comp (continuous_translatedCutoff R)).continuousAt).congr_of_eventuallyEq heq

/-- Source points in a compact set give a single bound on the planar L² kernels. -/
theorem exists_uniform_bound (s : Set ℂ) (hs : Bornology.IsBounded s)
    (hm : MeasurableSet s) (S : Set ℂ) (hS : IsCompact S) :
    ∃ B > 0, ∀ w ∈ S, ‖logKernel s hs w‖ ≤ B := by
  obtain ⟨B, hB, hb⟩ :=
    (hS.image (continuous_logKernel s hs hm)).isBounded.exists_pos_norm_le
  exact ⟨B, hB, fun w hw => hb _ (mem_image_of_mem _ hw)⟩


end Erdos1040LogKernel
end
