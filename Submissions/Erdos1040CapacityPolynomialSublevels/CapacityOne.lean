/- BEGIN LOCAL MODULE Erdos1040Foundation -/
section
/-!
An elementary, unconditional branch of Erdős 1040(ii): unbounded sets of
allowed roots admit quadratic unit lemniscates of arbitrarily small area.
This does not prove the compact capacity-one case.
-/

namespace Erdos1040Foundation

open Filter MeasureTheory

def indexPairs (n : ℕ) : Finset (Fin n × Fin n) :=
  (Finset.univ ×ˢ Finset.univ).filter fun ij => ij.1 < ij.2

noncomputable def vandermondeRoot (n : ℕ) (z : Fin n → ℂ) : ENNReal :=
  ENNReal.rpow
    (∏ ij ∈ indexPairs n, ENNReal.ofReal (dist (z ij.1) (z ij.2)))
    ((n.choose 2 : ℝ)⁻¹)

noncomputable def diameterAt (n : ℕ) (F : Set ℂ) : ENNReal :=
  ⨆ z : Fin n → ℂ, ⨆ (_ : ∀ i, z i ∈ F), vandermondeRoot n z

noncomputable def transfiniteDiameter (F : Set ℂ) : ENNReal :=
  limsup (fun n => diameterAt n F) atTop

def rootProduct (roots : List ℂ) (z : ℂ) : ℂ :=
  (roots.map fun r => z - r).prod

noncomputable def polynomialSublevelInfimum (F : Set ℂ) : ENNReal :=
  ⨅ roots : {l : List ℂ // l ≠ [] ∧ ∀ z ∈ l, z ∈ F},
    volume {z : ℂ | ‖rootProduct roots.1 z‖ < 1}

theorem quadratic_sublevel_subset (a b : ℂ) (r : ℝ) (hr : 0 < r)
    (hab : 2 < r * dist a b) :
    {z : ℂ | ‖(z - a) * (z - b)‖ < 1} ⊆
      Metric.ball a r ∪ Metric.ball b r := by
  intro z hz
  simp only [Set.mem_ofPred_eq, norm_mul, ← dist_eq_norm] at hz
  by_contra h
  simp only [Set.mem_union, Metric.mem_ball, not_or, not_lt] at h
  have hx := dist_nonneg (x := z) (y := a)
  have hy := dist_nonneg (x := z) (y := b)
  have htri : dist a b ≤ dist z a + dist z b := by
    simpa only [dist_comm a z] using dist_triangle a z b
  have hprod₁ := mul_le_mul_of_nonneg_right h.1 hy
  have hprod₂ := mul_le_mul_of_nonneg_left h.2 hx
  have htri' := mul_le_mul_of_nonneg_left htri hr.le
  nlinarith

theorem quadratic_sublevel_volume_le (a b : ℂ) (r : ℝ) (hr : 0 < r)
    (hab : 2 < r * dist a b) :
    volume {z : ℂ | ‖(z - a) * (z - b)‖ < 1} ≤
      2 * ENNReal.ofReal r ^ 2 * NNReal.pi := by
  calc
    _ ≤ volume (Metric.ball a r ∪ Metric.ball b r) :=
      measure_mono (quadratic_sublevel_subset a b r hr hab)
    _ ≤ volume (Metric.ball a r) + volume (Metric.ball b r) := measure_union_le _ _
    _ = _ := by rw [Complex.volume_ball, Complex.volume_ball]; ring

theorem infimum_le_quadratic (F : Set ℂ) (a b : ℂ) (ha : a ∈ F) (hb : b ∈ F) :
    polynomialSublevelInfimum F ≤ volume {z : ℂ | ‖(z - a) * (z - b)‖ < 1} := by
  let roots : {l : List ℂ // l ≠ [] ∧ ∀ z ∈ l, z ∈ F} :=
    ⟨[a, b], by simp, by simpa using And.intro ha hb⟩
  have h := iInf_le
    (fun roots : {l : List ℂ // l ≠ [] ∧ ∀ z ∈ l, z ∈ F} =>
      volume {z : ℂ | ‖rootProduct roots.1 z‖ < 1}) roots
  simpa [polynomialSublevelInfimum, roots, rootProduct] using h

theorem unbounded_infimum_eq_zero (F : Set ℂ) (hF : ¬ Bornology.IsBounded F) :
    polynomialSublevelInfimum F = 0 := by
  have far (c : ℂ) (R : ℝ) : ∃ b ∈ F, R < dist b c := by
    by_contra h
    push Not at h
    exact hF ((Metric.isBounded_iff_subset_closedBall c).2 ⟨R, h⟩)
  obtain ⟨a, ha, _⟩ := far 0 0
  apply le_antisymm _ bot_le
  apply ENNReal.le_of_forall_pos_le_add
  intro ε hε _
  have hεr : 0 < (ε : ℝ) := hε
  let r : ℝ := Real.sqrt ((ε : ℝ) / (2 * Real.pi))
  have hr : 0 < r := Real.sqrt_pos.2 (div_pos hεr (by positivity))
  obtain ⟨b, hb, hab⟩ := far a (2 / r)
  have hab' : 2 < r * dist a b := by
    have := (div_lt_iff₀ hr).1 hab
    simpa only [dist_comm b a, mul_comm] using this
  have hsquare : 2 * r ^ 2 * Real.pi = (ε : ℝ) := by
    dsimp [r]
    rw [Real.sq_sqrt (by positivity)]
    field_simp
  have harea : 2 * ENNReal.ofReal r ^ 2 * NNReal.pi = (ε : ENNReal) := by
    calc
      _ = ENNReal.ofReal (2 * r ^ 2 * Real.pi) := by
        rw [ENNReal.ofReal_mul (by positivity), ENNReal.ofReal_mul (by positivity)]
        simp [ENNReal.ofReal_pow, hr.le, ← NNReal.coe_real_pi]
      _ = _ := by rw [hsquare]; simp
  simpa [harea] using
    (infimum_le_quadratic F a b ha hb).trans
      (quadratic_sublevel_volume_le a b r hr hab')

abbrev statement : Prop :=
  ∀ F : Set ℂ, IsClosed F → F.Infinite →
    1 ≤ transfiniteDiameter F → polynomialSublevelInfimum F = 0

abbrev compactStatement : Prop :=
  ∀ F : Set ℂ, IsCompact F → F.Infinite →
    1 ≤ transfiniteDiameter F → polynomialSublevelInfimum F = 0

/-- The full exact root reduces to compact sets, with no capacity assumption
needed for the unbounded branch. The compact statement is still unproved here. -/
theorem compact_reduction : statement ↔ compactStatement := by
  constructor
  · intro h F hF hInf hCap
    exact h F hF.isClosed hInf hCap
  · intro h F hF hInf hCap
    by_cases hBound : Bornology.IsBounded F
    · exact h F (Metric.isCompact_iff_isClosed_bounded.2 ⟨hF, hBound⟩) hInf hCap
    · exact unbounded_infimum_eq_zero F hBound


end Erdos1040Foundation
end
/- END LOCAL MODULE Erdos1040Foundation -/

/- BEGIN LOCAL MODULE Erdos1040Fekete -/
section
/-!
Finite Fekete deletion identities and monotonicity of the canonical finite
Fekete diameters used in Jig277. This file does not identify their limit with
logarithmic capacity and does not assert the full Erdős 1040 theorem.
-/

open scoped BigOperators
open Filter

namespace Erdos1040Fekete

/-- Definition copied verbatim from the canonical Jig277 root. -/
def indexPairs (n : ℕ) : Finset (Fin n × Fin n) :=
  (Finset.univ ×ˢ Finset.univ).filter fun ij => ij.1 < ij.2

@[simp] theorem mem_indexPairs {n : ℕ} {ij : Fin n × Fin n} :
    ij ∈ indexPairs n ↔ ij.1 < ij.2 := by
  simp [indexPairs]

/-- Unnormalized pair product, generalized to any commutative monoid. -/
def pairProduct {M : Type*} [CommMonoid M] (n : ℕ) (a : Fin n × Fin n → M) : M :=
  ∏ ij ∈ indexPairs n, a ij

/-- Removing a coordinate removes exactly its incident pair factors. -/
theorem pairProduct_delete {M : Type*} [CommMonoid M] {n : ℕ}
    (k : Fin (n + 1)) (a : Fin (n + 1) × Fin (n + 1) → M) :
    pairProduct n (fun ij => a (k.succAbove ij.1, k.succAbove ij.2)) =
      ∏ ij ∈ (indexPairs (n + 1)).filter (fun ij => ij.1 ≠ k ∧ ij.2 ≠ k), a ij := by
  classical
  unfold pairProduct
  apply Finset.prod_bij (fun ij _ => (k.succAbove ij.1, k.succAbove ij.2))
  · intro ij hij
    simp only [Finset.mem_filter, mem_indexPairs]
    exact ⟨(Fin.strictMono_succAbove k) (mem_indexPairs.mp hij),
      Fin.succAbove_ne k ij.1, Fin.succAbove_ne k ij.2⟩
  · intro i hi j hj hij
    exact Prod.ext (Fin.succAbove_right_injective (congrArg Prod.fst hij))
      (Fin.succAbove_right_injective (congrArg Prod.snd hij))
  · intro ij hij
    obtain ⟨hij, hi, hj⟩ := Finset.mem_filter.mp hij
    obtain ⟨i, hi'⟩ := Fin.exists_succAbove_eq hi
    obtain ⟨j, hj'⟩ := Fin.exists_succAbove_eq hj
    refine ⟨(i, j), ?_, Prod.ext hi' hj'⟩
    apply mem_indexPairs.mpr
    apply (Fin.strictMono_succAbove k).lt_iff_lt.mp
    simpa only [hi', hj'] using mem_indexPairs.mp hij
  · intro ij hij
    rfl

/-- In N=n+1 coordinates, each unordered pair survives exactly N−2=n−1 deletions. -/
theorem prod_pairProduct_delete {M : Type*} [CommMonoid M] {n : ℕ}
    (a : Fin (n + 1) × Fin (n + 1) → M) :
    (∏ k : Fin (n + 1), pairProduct n
      (fun ij => a (k.succAbove ij.1, k.succAbove ij.2))) =
      pairProduct (n + 1) a ^ (n - 1) := by
  classical
  simp_rw [pairProduct_delete, Finset.prod_filter]
  rw [Finset.prod_comm]
  unfold pairProduct
  rw [← Finset.prod_pow]
  apply Finset.prod_congr rfl
  intro ij hij
  have hne : ij.1 ≠ ij.2 := ne_of_lt (mem_indexPairs.mp hij)
  rw [← Finset.prod_filter]
  have hfilter : (Finset.univ.filter (fun k : Fin (n + 1) => ij.1 ≠ k ∧ ij.2 ≠ k)) =
      (Finset.univ.erase ij.1).erase ij.2 := by
    ext k
    simp only [Finset.mem_filter, Finset.mem_univ, true_and, Finset.mem_erase]
    aesop
  rw [hfilter]
  simp [Finset.card_erase_of_mem, hne.symm]

/-- Definition copied verbatim from the canonical Jig277 root. -/
noncomputable def vandermondeRoot (n : ℕ) (z : Fin n → ℂ) : ENNReal :=
  ENNReal.rpow
    (∏ ij ∈ indexPairs n, ENNReal.ofReal (dist (z ij.1) (z ij.2)))
    ((n.choose 2 : ℝ)⁻¹)

/-- Definition copied verbatim from the canonical Jig277 root. -/
noncomputable def diameterAt (n : ℕ) (F : Set ℂ) : ENNReal :=
  ⨆ z : Fin n → ℂ, ⨆ (_ : ∀ i, z i ∈ F), vandermondeRoot n z

/-- The normalized deletion identity has exponent n+1 on the full diameter. -/
theorem prod_vandermondeRoot_delete {n : ℕ} (hn : 2 ≤ n) (z : Fin (n + 1) → ℂ) :
    (∏ k : Fin (n + 1), vandermondeRoot n (z ∘ k.succAbove)) =
      vandermondeRoot (n + 1) z ^ (n + 1) := by
  let a : Fin (n + 1) × Fin (n + 1) → ENNReal :=
    fun ij => ENNReal.ofReal (dist (z ij.1) (z ij.2))
  change (∏ k : Fin (n + 1), (pairProduct n
    (fun ij => a (k.succAbove ij.1, k.succAbove ij.2))) ^ ((n.choose 2 : ℝ)⁻¹)) =
      (pairProduct (n + 1) a ^ (((n + 1).choose 2 : ℝ)⁻¹)) ^ (n + 1)
  rw [ENNReal.prod_rpow_of_nonneg (by positivity), prod_pairProduct_delete]
  rw [← ENNReal.rpow_natCast_mul, ← ENNReal.rpow_mul_natCast]
  congr 1
  have hn0 : (n : ℝ) ≠ 0 := by exact_mod_cast (by omega : n ≠ 0)
  have hnm : (n : ℝ) - 1 ≠ 0 := by
    have : (2 : ℝ) ≤ n := by exact_mod_cast hn
    linarith
  have hnp : (n : ℝ) + 1 ≠ 0 := by positivity
  simp only [Nat.cast_choose_two, Nat.cast_add, Nat.cast_one,
    Nat.cast_sub (by omega : 1 ≤ n)]
  field_simp [hn0, hnm, hnp]
  ring

/-- Every (n+1)-point diameter is bounded by the supremum of n-point diameters. -/
theorem vandermondeRoot_succ_le_diameterAt {n : ℕ} (hn : 2 ≤ n) {F : Set ℂ}
    (z : Fin (n + 1) → ℂ) (hz : ∀ i, z i ∈ F) :
    vandermondeRoot (n + 1) z ≤ diameterAt n F := by
  apply (ENNReal.pow_le_pow_left_iff (Nat.succ_ne_zero n)).mp
  rw [← prod_vandermondeRoot_delete hn]
  calc
    (∏ k : Fin (n + 1), vandermondeRoot n (z ∘ k.succAbove)) ≤
        ∏ _k : Fin (n + 1), diameterAt n F := by
      apply Finset.prod_le_prod'
      intro k _
      exact le_iSup_of_le (z ∘ k.succAbove) <|
        le_iSup_of_le (fun i => hz (k.succAbove i)) le_rfl
    _ = diameterAt n F ^ (n + 1) := by simp

/-- The canonical finite Fekete diameters decrease from n=2 onward.
No compactness or boundedness is needed, and the inequality also covers 0 and ∞. -/
theorem diameterAt_succ_le {n : ℕ} (hn : 2 ≤ n) (F : Set ℂ) :
    diameterAt (n + 1) F ≤ diameterAt n F := by
  apply iSup_le
  intro z
  apply iSup_le
  intro hz
  exact vandermondeRoot_succ_le_diameterAt hn z hz

/-- Monotonicity on the entire canonical tail. -/
theorem diameterAt_antitoneOn (F : Set ℂ) :
    AntitoneOn (fun n => diameterAt n F) (Set.Ici 2) :=
  antitoneOn_nat_Ici_of_succ_le (fun _ hn => diameterAt_succ_le hn F)

/-- Definition copied verbatim from the canonical Jig277 root. -/
noncomputable def transfiniteDiameter (F : Set ℂ) : ENNReal :=
  limsup (fun n => diameterAt n F) atTop

/-- Every finite diameter on the decreasing tail bounds the canonical limsup. -/
theorem transfiniteDiameter_le_diameterAt {n : ℕ} (hn : 2 ≤ n) (F : Set ℂ) :
    transfiniteDiameter F ≤ diameterAt n F := by
  refine limsup_le_of_le (by isBoundedDefault) ?_
  filter_upwards [eventually_ge_atTop n] with m hm
  exact diameterAt_antitoneOn F hn (hn.trans hm) hm

/-- The capacity hypothesis gives an unconditional bound at each finite stage. -/
theorem one_le_diameterAt {n : ℕ} (hn : 2 ≤ n) {F : Set ℂ}
    (hF : 1 ≤ transfiniteDiameter F) :
    1 ≤ diameterAt n F :=
  hF.trans (transfiniteDiameter_le_diameterAt hn F)

/-- Tuples can approximate any value strictly below the canonical capacity,
without an attainment or compactness assumption. -/
theorem exists_vandermondeRoot_gt {n : ℕ} (hn : 2 ≤ n) {F : Set ℂ}
    {r : ENNReal} (hr : r < transfiniteDiameter F) :
    ∃ z : Fin n → ℂ, (∀ i, z i ∈ F) ∧ r < vandermondeRoot n z := by
  have h : r < diameterAt n F := hr.trans_le (transfiniteDiameter_le_diameterAt hn F)
  obtain ⟨z, hz⟩ := lt_iSup_iff.mp h
  obtain ⟨hmem, hz⟩ := lt_iSup_iff.mp hz
  exact ⟨z, hmem, hz⟩


end Erdos1040Fekete
end
/- END LOCAL MODULE Erdos1040Fekete -/

/- BEGIN LOCAL MODULE Erdos1040FeketeMax -/
section
open scoped BigOperators Topology
open Set Filter

namespace Erdos1040FeketeMax

noncomputable section

def rawProduct {X : Type*} [MetricSpace X] {n : ℕ} (z : Fin n → X) : ℝ :=
  ∏ ij ∈ Erdos1040Fekete.indexPairs n, dist (z ij.1) (z ij.2)

theorem continuous_rawProduct {X : Type*} [MetricSpace X] (n : ℕ) :
    Continuous (rawProduct : (Fin n → X) → ℝ) := by
  apply continuous_finsetProd
  intro ij _
  exact (continuous_apply ij.1).dist (continuous_apply ij.2)

theorem exists_maximizer {X : Type*} [MetricSpace X] [CompactSpace X] [Nonempty X]
    (n : ℕ) : ∃ z : Fin n → X, ∀ w : Fin n → X, rawProduct w ≤ rawProduct z := by
  obtain ⟨z, _, hz⟩ := isCompact_univ.exists_isMaxOn
    (Set.univ_nonempty : (Set.univ : Set (Fin n → X)).Nonempty)
    (continuous_rawProduct n).continuousOn
  exact ⟨z, fun w => hz (Set.mem_univ w)⟩

def maximizingTuple (X : Type*) [MetricSpace X] [CompactSpace X] [Nonempty X]
    (n : ℕ) : Fin n → X := Classical.choose (exists_maximizer (X := X) n)

def maximumProduct (X : Type*) [MetricSpace X] [CompactSpace X] [Nonempty X]
    (n : ℕ) : ℝ := rawProduct (maximizingTuple X n)

theorem rawProduct_le_maximumProduct {X : Type*} [MetricSpace X] [CompactSpace X]
    [Nonempty X] {n : ℕ} (z : Fin n → X) : rawProduct z ≤ maximumProduct X n :=
  Classical.choose_spec (exists_maximizer (X := X) n) z

theorem injective_of_rawProduct_pos {X : Type*} [MetricSpace X] {n : ℕ}
    {z : Fin n → X} (hp : 0 < rawProduct z) : Function.Injective z := by
  have hne := Finset.prod_ne_zero_iff.mp hp.ne'
  intro i j hij
  by_contra h
  rcases lt_or_gt_of_ne h with hlt | hgt
  · exact hne (i, j) (Erdos1040Fekete.mem_indexPairs.mpr hlt) (dist_eq_zero.mpr hij)
  · exact hne (j, i) (Erdos1040Fekete.mem_indexPairs.mpr hgt) (dist_eq_zero.mpr hij.symm)

theorem vandermondeRoot_subtype {K : Set ℂ} {n : ℕ} (z : Fin n → K) :
    Erdos1040Fekete.vandermondeRoot n (fun i => (z i : ℂ)) =
      ENNReal.ofReal (rawProduct z) ^ ((n.choose 2 : ℝ)⁻¹) := by
  unfold Erdos1040Fekete.vandermondeRoot rawProduct
  rw [ENNReal.ofReal_prod_of_nonneg (fun ij _ => dist_nonneg)]
  simp only [Subtype.dist_eq]
  rfl

/-- On a compact set the canonical supremum equals the attained raw maximum
raised to its defining exponent. -/
theorem diameterAt_eq_maximumProduct_rpow {K : Set ℂ} [CompactSpace K] [Nonempty K]
    (n : ℕ) : Erdos1040Fekete.diameterAt n K =
      ENNReal.ofReal (maximumProduct K n) ^ ((n.choose 2 : ℝ)⁻¹) := by
  apply le_antisymm
  · apply iSup_le
    intro z
    apply iSup_le
    intro hz
    let w : Fin n → K := fun i => ⟨z i, hz i⟩
    change Erdos1040Fekete.vandermondeRoot n (fun i => (w i : ℂ)) ≤ _
    rw [vandermondeRoot_subtype]
    exact ENNReal.rpow_le_rpow (ENNReal.ofReal_le_ofReal (rawProduct_le_maximumProduct w))
      (by positivity)
  · change ENNReal.ofReal (rawProduct (maximizingTuple K n)) ^ ((n.choose 2 : ℝ)⁻¹) ≤ _
    rw [← vandermondeRoot_subtype (maximizingTuple K n)]
    exact le_iSup_of_le (fun i => (maximizingTuple K n i : ℂ))
      (le_iSup_of_le (fun i => (maximizingTuple K n i).property) le_rfl)

theorem one_le_maximumProduct {K : Set ℂ} [CompactSpace K] [Nonempty K]
    (hcap : 1 ≤ Erdos1040Fekete.transfiniteDiameter K) {n : ℕ} (hn : 2 ≤ n) :
    1 ≤ maximumProduct K n := by
  have hd := Erdos1040Fekete.one_le_diameterAt hn hcap
  rw [diameterAt_eq_maximumProduct_rpow] at hd
  by_contra h
  have hc : 0 < ((n.choose 2 : ℝ)⁻¹) :=
    inv_pos.mpr (by exact_mod_cast Nat.choose_pos hn)
  exact (ENNReal.rpow_lt_one (ENNReal.ofReal_lt_one.mpr (lt_of_not_ge h)) hc).not_ge hd

/-- A sequence bounded below by one cannot lose a fixed multiplicative
factor at every sufficiently late step. -/
theorem exists_good_ratio (a : ℕ → ℝ) (ha : ∀ n ≥ 2, 1 ≤ a n)
    {q : ℝ} (hq0 : 0 ≤ q) (hq1 : q < 1) (N : ℕ) (hN : 2 ≤ N) :
    ∃ n ≥ N, q * a n ≤ a (n + 1) := by
  by_contra! h
  have hb : ∀ k : ℕ, a (N + k) ≤ q ^ k * a N := by
    intro k
    induction k with
    | zero => simp
    | succ k ih =>
      calc
        a (N + (k + 1)) ≤ q * a (N + k) := by
          simpa only [Nat.add_assoc] using (h (N + k) (by omega)).le
        _ ≤ q * (q ^ k * a N) := mul_le_mul_of_nonneg_left ih hq0
        _ = q ^ (k + 1) * a N := by rw [pow_succ]; ring
  have ht : Tendsto (fun k : ℕ => q ^ k * a N) atTop (𝓝 0) := by
    simpa using (tendsto_pow_atTop_nhds_zero_of_lt_one hq0 hq1).mul_const (a N)
  have he : ∀ᶠ k in atTop, q ^ k * a N < 1 := ht.eventually (gt_mem_nhds (by norm_num))
  obtain ⟨k, hk⟩ := he.exists
  have hlo := ha (N + k) (by omega)
  linarith [hb k]

theorem exists_good_ratio_subsequence (a : ℕ → ℝ) (ha : ∀ n ≥ 2, 1 ≤ a n)
    {q : ℝ} (hq0 : 0 ≤ q) (hq1 : q < 1) :
    ∃ φ : ℕ → ℕ, StrictMono φ ∧ ∀ k, 2 ≤ φ k ∧ q * a (φ k) ≤ a (φ k + 1) := by
  apply extraction_of_frequently_atTop (P := fun n => 2 ≤ n ∧ q * a n ≤ a (n + 1))
  rw [frequently_atTop]
  intro N
  obtain ⟨n, hn, hratio⟩ := exists_good_ratio a ha hq0 hq1 (max N 2) (le_max_right _ _)
  exact ⟨n, (le_max_left _ _).trans hn, (le_max_right _ _).trans hn, hratio⟩

theorem incident_product {X : Type*} [MetricSpace X] {n : ℕ}
    (z : Fin n → X) (k : Fin n) :
    (∏ ij ∈ (Erdos1040Fekete.indexPairs n).filter (fun ij => ij.1 = k ∨ ij.2 = k),
      dist (z ij.1) (z ij.2)) =
      ∏ i ∈ Finset.univ.erase k, dist (z k) (z i) := by
  classical
  have recover (ij : Fin n × Fin n) (hlt : ij.1 < ij.2) (hi : ij.1 = k ∨ ij.2 = k) :
      ij = (min k (if ij.1 = k then ij.2 else ij.1),
        max k (if ij.1 = k then ij.2 else ij.1)) := by
    rcases ij with ⟨i, j⟩
    rcases hi with hi | hi
    · change i = k at hi
      subst i
      simp [hlt.le]
    · change j = k at hi
      subst j
      simp [hlt.ne, hlt.le]
  apply Finset.prod_bij (fun ij _ => if ij.1 = k then ij.2 else ij.1)
  · intro ij hij
    obtain ⟨hij, hi⟩ := Finset.mem_filter.mp hij
    have hlt := Erdos1040Fekete.mem_indexPairs.mp hij
    rcases ij with ⟨i, j⟩
    rcases hi with rfl | rfl
    · simp [hlt.ne']
    · simp [hlt.ne]
  · intro ij hi ij' hj heq
    obtain ⟨hi, hik⟩ := Finset.mem_filter.mp hi
    obtain ⟨hj, hjk⟩ := Finset.mem_filter.mp hj
    have hilt := Erdos1040Fekete.mem_indexPairs.mp hi
    have hjlt := Erdos1040Fekete.mem_indexPairs.mp hj
    exact (recover ij hilt hik).trans
      ((congrArg (fun t => (min k t, max k t)) heq).trans (recover ij' hjlt hjk).symm)
  · intro i hi
    have hne : i ≠ k := (Finset.mem_erase.mp hi).1
    rcases lt_or_gt_of_ne hne with hlt | hgt
    · refine ⟨(i, k), ?_, ?_⟩
      · simp [Erdos1040Fekete.mem_indexPairs, hlt]
      · simp [hne]
    · refine ⟨(k, i), ?_, ?_⟩
      · simp [Erdos1040Fekete.mem_indexPairs, hgt]
      · simp
  · intro ij hij
    obtain ⟨_, hi⟩ := Finset.mem_filter.mp hij
    rcases hi with hi | hi
    · simp [hi]
    · by_cases h : ij.1 = k
      · simp [h, hi]
      · simp [h, hi, dist_comm]

/-- Removing a point divides the raw Vandermonde by the product of its
distances to all the other points. The identity itself needs no distinctness. -/
theorem rawProduct_delete {X : Type*} [MetricSpace X] {n : ℕ}
    (z : Fin (n + 1) → X) (k : Fin (n + 1)) :
    rawProduct z = rawProduct (z ∘ k.succAbove) *
      ∏ i ∈ Finset.univ.erase k, dist (z k) (z i) := by
  classical
  have hd := Erdos1040Fekete.pairProduct_delete k
    (fun ij => dist (z ij.1) (z ij.2))
  change rawProduct (z ∘ k.succAbove) = _ at hd
  rw [hd, ← incident_product]
  unfold rawProduct
  have h := Finset.prod_filter_mul_prod_filter_not
    (s := Erdos1040Fekete.indexPairs (n + 1))
    (p := fun ij => ij.1 = k ∨ ij.2 = k)
    (f := fun ij => dist (z ij.1) (z ij.2))
  simpa only [not_or] using h.symm.trans (mul_comm _ _)

/-- A good consecutive ratio of raw maxima bounds all the nodal derivatives
of the larger maximizing tuple from below. -/
theorem incident_lower_of_ratio {X : Type*} [MetricSpace X] [CompactSpace X] [Nonempty X]
    {n : ℕ} (hpos : 0 < maximumProduct X n) {d : ℝ}
    (hratio : d * maximumProduct X n ≤ maximumProduct X (n + 1))
    (k : Fin (n + 1)) :
    d ≤ ∏ i ∈ Finset.univ.erase k,
      dist (maximizingTuple X (n + 1) k) (maximizingTuple X (n + 1) i) := by
  have hdel := rawProduct_le_maximumProduct (maximizingTuple X (n + 1) ∘ k.succAbove)
  have hid := rawProduct_delete (maximizingTuple X (n + 1)) k
  have hdnonneg : 0 ≤ ∏ i ∈ Finset.univ.erase k,
      dist (maximizingTuple X (n + 1) k) (maximizingTuple X (n + 1) i) :=
    Finset.prod_nonneg (fun _ _ => dist_nonneg)
  have hbound := mul_le_mul_of_nonneg_right hdel hdnonneg
  have hratio' : d * maximumProduct X n ≤
      maximumProduct X n * ∏ i ∈ Finset.univ.erase k,
        dist (maximizingTuple X (n + 1) k) (maximizingTuple X (n + 1) i) := by
    exact hratio.trans (by simpa only [maximumProduct, ← hid] using hbound)
  nlinarith

theorem derivative_nodal_norm {n : ℕ} (z : Fin n → ℂ) (i : Fin n) :
    ‖(Lagrange.nodal Finset.univ z).derivative.eval (z i)‖ =
      ∏ j ∈ Finset.univ.erase i, dist (z i) (z j) := by
  rw [Lagrange.eval_nodal_derivative_eval_node_eq (Finset.mem_univ i), Lagrange.eval_nodal]
  simp only [norm_prod, dist_eq_norm]

/-- Lagrange interpolation converts a lower bound for the derivative at every
root into a lower bound for the monic polynomial away from small root disks. -/
theorem lagrange_polynomial_lower {n : ℕ} (hn : 0 < n) (z : Fin n → ℂ)
    (hz : Function.Injective z) {d r : ℝ} (hd : 0 < d) (hr : 0 < r)
    (hderiv : ∀ i, d ≤ ∏ j ∈ Finset.univ.erase i, dist (z i) (z j))
    (w : ℂ) (hw : ∀ i, r ≤ dist w (z i)) :
    d * r ≤ (n : ℝ) * ‖(Lagrange.nodal Finset.univ z).eval w‖ := by
  have hs : (Finset.univ : Finset (Fin n)).Nonempty := ⟨⟨0, hn⟩, Finset.mem_univ _⟩
  have hroot (i : Fin n) : w ≠ z i := dist_pos.mp (hr.trans_le (hw i))
  have hlag := Lagrange.eval_interpolate_not_at_node (s := Finset.univ) (v := z)
    (x := w) (1 : Fin n → ℂ) (fun i _ => hroot i)
  have hid : (1 : ℂ) = (Lagrange.nodal Finset.univ z).eval w *
      ∑ i, Lagrange.nodalWeight Finset.univ z i * (w - z i)⁻¹ := by
    simpa only [Lagrange.interpolate_one hz.injOn hs, Polynomial.eval_one,
      Pi.one_apply, mul_one] using hlag
  have hb (i : Fin n) :
      ‖Lagrange.nodalWeight Finset.univ z i * (w - z i)⁻¹‖ ≤ d⁻¹ * r⁻¹ := by
    rw [Lagrange.nodalWeight_eq_eval_derivative_nodal (Finset.mem_univ i),
      norm_mul, norm_inv, norm_inv, derivative_nodal_norm, ← dist_eq_norm]
    exact mul_le_mul (inv_anti₀ hd (hderiv i)) (inv_anti₀ hr (hw i))
      (inv_nonneg.mpr dist_nonneg) (inv_nonneg.mpr hd.le)
  have hnorm : (1 : ℝ) ≤ ‖(Lagrange.nodal Finset.univ z).eval w‖ *
      (n : ℝ) * d⁻¹ * r⁻¹ := by
    calc
      1 = ‖(Lagrange.nodal Finset.univ z).eval w *
          ∑ i, Lagrange.nodalWeight Finset.univ z i * (w - z i)⁻¹‖ := by rw [← hid]; simp
      _ = ‖(Lagrange.nodal Finset.univ z).eval w‖ *
          ‖∑ i, Lagrange.nodalWeight Finset.univ z i * (w - z i)⁻¹‖ := norm_mul _ _
      _ ≤ ‖(Lagrange.nodal Finset.univ z).eval w‖ *
          ∑ i, ‖Lagrange.nodalWeight Finset.univ z i * (w - z i)⁻¹‖ := by
        exact mul_le_mul_of_nonneg_left (norm_sum_le _ _) (norm_nonneg _)
      _ ≤ ‖(Lagrange.nodal Finset.univ z).eval w‖ * ∑ _i : Fin n, d⁻¹ * r⁻¹ := by
        exact mul_le_mul_of_nonneg_left (Finset.sum_le_sum (fun i _ => hb i)) (norm_nonneg _)
      _ = _ := by simp; ring
  have hm := mul_le_mul_of_nonneg_right hnorm (mul_pos hd hr).le
  have hcancel : (‖(Lagrange.nodal Finset.univ z).eval w‖ *
      (n : ℝ) * d⁻¹ * r⁻¹) * (d * r) = (n : ℝ) * ‖(Lagrange.nodal Finset.univ z).eval w‖ := by
    field_simp [hd.ne', hr.ne']
  simpa only [one_mul, hcancel] using hm

/-- Logarithmic form of the Lagrange lower bound with derivative threshold
exp(−1). It applies everywhere outside the specified root disks. -/
theorem lagrange_log_lower {n : ℕ} (hn : 0 < n) (z : Fin n → ℂ)
    (hz : Function.Injective z)
    (hderiv : ∀ i, Real.exp (-1) ≤ ∏ j ∈ Finset.univ.erase i, dist (z i) (z j))
    {r : ℝ} (hr : 0 < r) (w : ℂ) (hw : ∀ i, r ≤ dist w (z i)) :
    -1 + Real.log r - Real.log n ≤ ∑ i, Real.log (dist w (z i)) := by
  have hb := lagrange_polynomial_lower hn z hz (Real.exp_pos (-1)) hr hderiv w hw
  simp only [Lagrange.eval_nodal, norm_prod, ← dist_eq_norm] at hb
  have hn0 : (n : ℝ) ≠ 0 := by exact_mod_cast hn.ne'
  have hp : 0 < ∏ i, dist w (z i) := Finset.prod_pos (fun i _ => hr.trans_le (hw i))
  have hl := Real.log_le_log (mul_pos (Real.exp_pos (-1)) hr) hb
  rw [Real.log_mul (Real.exp_ne_zero _) hr.ne', Real.log_exp,
    Real.log_mul hn0 hp.ne', Real.log_prod (fun i _ => (hr.trans_le (hw i)).ne')] at hl
  linarith

/-- Disks of radius 1/n have total area O(1/n); outside these disks the
normalized logarithm is bounded below by −(1+2 log n)/n. -/
theorem lagrange_log_mean_lower {n : ℕ} (hn : 0 < n) (z : Fin n → ℂ)
    (hz : Function.Injective z)
    (hderiv : ∀ i, Real.exp (-1) ≤ ∏ j ∈ Finset.univ.erase i, dist (z i) (z j))
    (w : ℂ) (hw : ∀ i, (n : ℝ)⁻¹ ≤ dist w (z i)) :
    -(1 + 2 * Real.log n) / (n : ℝ) ≤
      (n : ℝ)⁻¹ * ∑ i, Real.log (dist w (z i)) := by
  have hnpos : 0 < (n : ℝ) := by exact_mod_cast hn
  have h := lagrange_log_lower hn z hz hderiv (inv_pos.mpr hnpos) w hw
  rw [Real.log_inv] at h
  have hm := mul_le_mul_of_nonneg_left h (inv_nonneg.mpr hnpos.le)
  calc
    -(1 + 2 * Real.log n) / (n : ℝ) =
        (n : ℝ)⁻¹ * (-1 + -Real.log n - Real.log n) := by ring
    _ ≤ _ := hm

theorem nonempty_of_one_le_transfiniteDiameter {K : Set ℂ}
    (hcap : 1 ≤ Erdos1040Fekete.transfiniteDiameter K) : K.Nonempty := by
  obtain ⟨z, hz, _⟩ := Erdos1040Fekete.exists_vandermondeRoot_gt (n := 2) (by decide)
    (zero_lt_one.trans_le hcap)
  exact ⟨z 0, hz 0⟩

/-- Canonical capacity at least one produces an increasing sequence of
genuine finite Fekete maximizers with all nodal derivatives bounded below
by exp(−1), enabling the global Lagrange estimates. -/
theorem exists_good_fekete_subsequence {K : Set ℂ} [CompactSpace K] [Nonempty K]
    (hcap : 1 ≤ Erdos1040Fekete.transfiniteDiameter K) :
    ∃ φ : ℕ → ℕ, StrictMono φ ∧ ∀ k,
      2 ≤ φ k ∧ Function.Injective (maximizingTuple K (φ k + 1)) ∧
      ∀ i, Real.exp (-1) ≤ ∏ j ∈ Finset.univ.erase i,
        dist (maximizingTuple K (φ k + 1) i) (maximizingTuple K (φ k + 1) j) := by
  obtain ⟨φ, hφ, hg⟩ := exists_good_ratio_subsequence (maximumProduct K)
    (fun n hn => one_le_maximumProduct hcap hn) (Real.exp_pos (-1)).le
    (Real.exp_lt_one_iff.mpr (by norm_num))
  refine ⟨φ, hφ, ?_⟩
  intro k
  obtain ⟨hk, hr⟩ := hg k
  refine ⟨hk, injective_of_rawProduct_pos ?_, ?_⟩
  · exact zero_lt_one.trans_le (one_le_maximumProduct hcap (by omega))
  · intro i
    exact incident_lower_of_ratio (zero_lt_one.trans_le (one_le_maximumProduct hcap hk)) hr i


end

end Erdos1040FeketeMax
end
/- END LOCAL MODULE Erdos1040FeketeMax -/

/- BEGIN LOCAL MODULE Erdos1040FeketeEstimates -/
section
open scoped BigOperators Topology
open Filter Set MeasureTheory

namespace Erdos1040FeketeEstimates

noncomputable section

def rootDisks {n : ℕ} (z : Fin n → ℂ) : Set ℂ :=
  ⋃ i, Metric.ball (z i) (n : ℝ)⁻¹

def lowerError (n : ℕ) : ℝ := (1 + 2 * Real.log n) / (n : ℝ)

theorem lowerError_tendsto : Tendsto lowerError atTop (𝓝 0) := by
  change Tendsto (fun n : ℕ => (1 + 2 * Real.log n) / (n : ℝ)) atTop (𝓝 0)
  have hlog : Tendsto (fun n : ℕ => Real.log (n : ℝ) / (n : ℝ)) atTop (𝓝 0) :=
    Real.isLittleO_log_id_atTop.tendsto_div_nhds_zero.comp tendsto_natCast_atTop_atTop
  have hi : Tendsto (fun n : ℕ => 1 / (n : ℝ)) atTop (𝓝 0) :=
    tendsto_one_div_atTop_nhds_zero_nat
  simpa only [add_div, mul_div_assoc, add_zero, mul_zero] using
    hi.add (hlog.const_mul 2)

theorem rootDisks_volume_le {n : ℕ} (hn : 0 < n) (z : Fin n → ℂ) :
    volume (rootDisks z) ≤ ENNReal.ofReal (Real.pi / n) := by
  have hn0 : (n : ℝ) ≠ 0 := by exact_mod_cast hn.ne'
  calc
    volume (rootDisks z) ≤ ∑ i, volume (Metric.ball (z i) (n : ℝ)⁻¹) :=
      measure_iUnion_fintype_le volume _
    _ = (n : ENNReal) * (ENNReal.ofReal ((n : ℝ)⁻¹) ^ 2 * NNReal.pi) := by
      simp [Complex.volume_ball]
    _ = ENNReal.ofReal ((n : ℝ) * (n : ℝ)⁻¹ ^ 2 * Real.pi) := by
      rw [ENNReal.ofReal_mul (by positivity), ENNReal.ofReal_mul (by positivity)]
      simp [← NNReal.coe_real_pi, mul_assoc, -inv_pow, ENNReal.ofReal_pow]
    _ = ENNReal.ofReal (Real.pi / n) := by
      congr 1
      field_simp [hn0]

theorem rootDisks_bound_tendsto :
    Tendsto (fun n : ℕ => ENNReal.ofReal (Real.pi / n)) atTop (𝓝 0) := by
  simpa only [Function.comp_def, ENNReal.ofReal_zero] using ENNReal.continuous_ofReal.continuousAt.tendsto.comp
    (tendsto_const_div_atTop_nhds_zero_nat Real.pi)

/-- The explicit finite Fekete mean is bounded below outside a set whose
area tends to zero. No assertion about its limiting potential is assumed. -/
theorem log_mean_lower_outside_rootDisks {n : ℕ} (hn : 0 < n) (z : Fin n → ℂ)
    (hz : Function.Injective z)
    (hderiv : ∀ i, Real.exp (-1) ≤ ∏ j ∈ Finset.univ.erase i, dist (z i) (z j))
    {w : ℂ} (hw : w ∉ rootDisks z) :
    -lowerError n ≤ (n : ℝ)⁻¹ * ∑ i, Real.log (dist w (z i)) := by
  have hdist : ∀ i, (n : ℝ)⁻¹ ≤ dist w (z i) := by
    simpa only [rootDisks, Set.mem_iUnion, Metric.mem_ball, not_exists, not_lt] using hw
  simpa only [lowerError, neg_div] using
    Erdos1040FeketeMax.lagrange_log_mean_lower hn z hz hderiv w hdist


end

end Erdos1040FeketeEstimates
end
/- END LOCAL MODULE Erdos1040FeketeEstimates -/

/- BEGIN LOCAL MODULE Erdos1040Equilibrium -/
section
/-!
Compact extraction of empirical measures and passage of continuous two-point
energies to their limits. This is a constructive foundation for the equilibrium
measure step of Erdős 1040(ii), not a proof of the complete statement.
-/

open MeasureTheory Filter Set
open scoped Topology BigOperators

namespace Erdos1040Equilibrium

noncomputable section

/-- The empirical probability measure of a nonempty finite tuple. -/
def empirical {X : Type*} [MeasurableSpace X] {n : ℕ} (hn : 0 < n)
    (z : Fin n → X) : ProbabilityMeasure X :=
  ⟨(n : ENNReal)⁻¹ • ∑ i, Measure.dirac (z i), by
    constructor
    simp only [Measure.smul_apply, Measure.finsetSum_apply, Measure.dirac_apply_of_mem,
      Set.mem_univ, Finset.sum_const, Finset.card_univ, Fintype.card_fin, nsmul_eq_mul,
      mul_one, smul_eq_mul]
    exact ENNReal.inv_mul_cancel (by exact_mod_cast hn.ne') (by simp)⟩

theorem integral_empirical {X : Type*} [MeasurableSpace X] [MeasurableSingletonClass X]
    {n : ℕ} (hn : 0 < n) (z : Fin n → X) (f : X → ℝ) :
    (∫ x, f x ∂(empirical hn z : Measure X)) = (n : ℝ)⁻¹ * ∑ i, f (z i) := by
  change (∫ x, f x ∂((n : ENNReal)⁻¹ • ∑ i, Measure.dirac (z i))) = _
  rw [integral_smul_measure, integral_finsetSum_measure]
  · simp
  · intro i _
    exact integrable_dirac (by simp)

variable {X : Type*} [MetricSpace X] [CompactSpace X]
  [MeasurableSpace X] [BorelSpace X] [SecondCountableTopology X]

/-- A continuous two-point energy of an empirical measure is its full double
sum, including the diagonal. -/
theorem integral_empirical_prod {n : ℕ} (hn : 0 < n) (z : Fin n → X)
    (f : C(X × X, ℝ)) :
    (∫ p, f p ∂((empirical hn z).prod (empirical hn z) : Measure (X × X))) =
      (n : ℝ)⁻¹ ^ 2 * ∑ i, ∑ j, f (z i, z j) := by
  change (∫ p, f p ∂((empirical hn z : Measure X).prod (empirical hn z : Measure X))) = _
  rw [integral_prod f (f.continuous.integrable_of_hasCompactSupport
    (HasCompactSupport.of_compactSpace _))]
  simp_rw [integral_empirical]
  rw [← Finset.mul_sum]
  ring

/-- Weak convergence of probability measures passes to continuous two-point
energies on a compact metric space. -/
theorem tendsto_integral_prod {ι : Type*} {l : Filter ι}
    {ν : ι → ProbabilityMeasure X} {μ : ProbabilityMeasure X}
    (hν : Tendsto ν l (𝓝 μ)) (f : C(X × X, ℝ)) :
    Tendsto (fun i => ∫ p, f p ∂((ν i).prod (ν i) : Measure (X × X))) l
      (𝓝 (∫ p, f p ∂(μ.prod μ : Measure (X × X)))) := by
  have hp : Tendsto (fun i => (ν i).prod (ν i)) l (𝓝 (μ.prod μ)) :=
    ProbabilityMeasure.continuous_prod.continuousAt.tendsto.comp (hν.prodMk_nhds hν)
  exact (ProbabilityMeasure.continuous_integral_continuousMap f).continuousAt.tendsto.comp hp

/-- Any sequence of empirical measures on a compact metric space has one
subsequence along which every continuous two-point energy converges. -/
theorem exists_empirical_energy_limit (N : ℕ → ℕ) (hN : ∀ n, 0 < N n)
    (z : ∀ n, Fin (N n) → X) :
    ∃ (μ : ProbabilityMeasure X) (φ : ℕ → ℕ), StrictMono φ ∧
      Tendsto (fun k => empirical (hN (φ k)) (z (φ k))) atTop (𝓝 μ) ∧
      ∀ f : C(X × X, ℝ),
        Tendsto (fun k => (N (φ k) : ℝ)⁻¹ ^ 2 *
          ∑ i, ∑ j, f (z (φ k) i, z (φ k) j)) atTop
          (𝓝 (∫ p, f p ∂(μ.prod μ : Measure (X × X)))) := by
  obtain ⟨μ, φ, hφ, hμ⟩ :=
    SeqCompactSpace.tendsto_subseq (fun n => empirical (hN n) (z n))
  refine ⟨μ, φ, hφ, hμ, ?_⟩
  intro f
  simpa only [Function.comp_apply, integral_empirical_prod] using tendsto_integral_prod hμ f

/-- The logarithmic kernel cut off below at distance exp(−M). -/
def truncatedLog (M : ℝ) : C(X × X, ℝ) :=
  ⟨fun p => Real.log (max (Real.exp (-M)) (dist p.1 p.2)),
    (continuous_const.max continuous_dist).log
      (fun _p => ne_of_gt ((Real.exp_pos _).trans_le (le_max_left _ _)))⟩

omit [CompactSpace X] [MeasurableSpace X] [BorelSpace X] [SecondCountableTopology X] in
@[simp] theorem truncatedLog_apply (M : ℝ) (x y : X) :
    truncatedLog M (x, y) = Real.log (max (Real.exp (-M)) (dist x y)) := rfl

omit [CompactSpace X] [MeasurableSpace X] [BorelSpace X] [SecondCountableTopology X] in
@[simp] theorem truncatedLog_diag (M : ℝ) (x : X) :
    truncatedLog M (x, x) = -M := by
  simp [truncatedLog, le_of_lt (Real.exp_pos (-M))]

/-- If the finite truncated energies have a lower error tending to zero,
compactness constructs one probability measure whose energy is nonnegative
for every truncation. The hypothesis concerns only explicit finite tuples. -/
theorem exists_nonneg_truncated_energy
    (N : ℕ → ℕ) (hN : ∀ n, 0 < N n) (z : ∀ n, Fin (N n) → X)
    (err : ℝ → ℕ → ℝ)
    (herr : ∀ M > 0, Tendsto (err M) atTop (𝓝 0))
    (henergy : ∀ M > 0, ∀ n,
      -(err M n) ≤ (N n : ℝ)⁻¹ ^ 2 *
        ∑ i, ∑ j, truncatedLog M (z n i, z n j)) :
    ∃ μ : ProbabilityMeasure X, ∀ M > 0,
      0 ≤ ∫ p, truncatedLog M p ∂(μ.prod μ : Measure (X × X)) := by
  obtain ⟨μ, φ, hφ, _, hlim⟩ := exists_empirical_energy_limit N hN z
  refine ⟨μ, ?_⟩
  intro M hM
  have he := ((herr M hM).comp hφ.tendsto_atTop).neg
  have hl := hlim (truncatedLog M)
  have h := le_of_tendsto_of_tendsto he hl
    (Filter.Eventually.of_forall (fun k => henergy M hM (φ k)))
  simpa using h

/-- Capacity at least one gives, at every finite stage, distinct points whose
unnormalized sum of pair logarithms exceeds −1. The raw product threshold
exp(−1) avoids any limiting exponent manipulation. -/
theorem exists_log_tuple {K : Set ℂ} (hK : 1 ≤ Erdos1040Fekete.transfiniteDiameter K)
    {n : ℕ} (hn : 2 ≤ n) :
    ∃ z : Fin n → K, Function.Injective z ∧
      -1 < ∑ ij ∈ Erdos1040Fekete.indexPairs n, Real.log (dist (z ij.1) (z ij.2)) := by
  have hc : 0 < ((n.choose 2 : ℝ)⁻¹) := by
    exact inv_pos.mpr (by exact_mod_cast Nat.choose_pos hn)
  have hr : ENNReal.ofReal (Real.exp (-1)) ^ ((n.choose 2 : ℝ)⁻¹) < 1 :=
    ENNReal.rpow_lt_one (ENNReal.ofReal_lt_one.mpr
      (Real.exp_lt_one_iff.mpr (by norm_num : (-1 : ℝ) < 0))) hc
  obtain ⟨w, hw, hwroot⟩ := Erdos1040Fekete.exists_vandermondeRoot_gt hn (hr.trans_le hK)
  have hp : ENNReal.ofReal (Real.exp (-1)) <
      ∏ ij ∈ Erdos1040Fekete.indexPairs n,
        ENNReal.ofReal (dist (w ij.1) (w ij.2)) :=
    (ENNReal.rpow_lt_rpow_iff hc).mp hwroot
  rw [← ENNReal.ofReal_prod_of_nonneg (fun ij _ => dist_nonneg)] at hp
  have hprod := (ENNReal.ofReal_lt_ofReal_iff'.mp hp).1
  have hne := Finset.prod_ne_zero_iff.mp ((Real.exp_pos (-1)).trans hprod).ne'
  have hlog := Real.log_lt_log (Real.exp_pos (-1)) hprod
  rw [Real.log_exp, Real.log_prod hne] at hlog
  let z : Fin n → K := fun i => ⟨w i, hw i⟩
  refine ⟨z, ?_, ?_⟩
  · intro i j hij
    have heq : w i = w j := congrArg Subtype.val hij
    by_contra h
    rcases lt_or_gt_of_ne h with hlt | hgt
    · exact hne (i, j) (Erdos1040Fekete.mem_indexPairs.mpr hlt) (dist_eq_zero.mpr heq)
    · exact hne (j, i) (Erdos1040Fekete.mem_indexPairs.mpr hgt) (dist_eq_zero.mpr heq.symm)
  · simpa [z, Subtype.dist_eq] using hlog

/-- A symmetric double sum consists of two copies of the unordered-pair sum
and one copy of the diagonal. -/
theorem sum_pair_decomposition {n : ℕ} (f : Fin n → Fin n → ℝ)
    (hf : ∀ i j, f i j = f j i) :
    (∑ i, ∑ j, f i j) =
      2 * (∑ ij ∈ Erdos1040Fekete.indexPairs n, f ij.1 ij.2) + ∑ i, f i i := by
  classical
  have hsplit (i j : Fin n) : f i j =
      (if i < j then f i j else 0) + (if j < i then f i j else 0) +
        (if i = j then f i j else 0) := by
    rcases lt_trichotomy i j with h | h | h
    · simp [h, not_lt.mpr h.le, h.ne]
    · simp [h]
    · simp [h, not_lt.mpr h.le, h.ne']
  have hswap : (∑ i, ∑ j, if j < i then f i j else 0) =
      ∑ i, ∑ j, if i < j then f i j else 0 := by
    rw [Finset.sum_comm]
    apply Finset.sum_congr rfl
    intro i _
    apply Finset.sum_congr rfl
    intro j _
    split_ifs <;> simp [hf]
  have hupper : (∑ ij ∈ Erdos1040Fekete.indexPairs n, f ij.1 ij.2) =
      ∑ i, ∑ j, if i < j then f i j else 0 := by
    simp [Erdos1040Fekete.indexPairs, Finset.sum_filter, Fintype.sum_prod_type]
  calc
    _ = ∑ i, ∑ j, ((if i < j then f i j else 0) +
        (if j < i then f i j else 0) + (if i = j then f i j else 0)) := by
      apply Finset.sum_congr rfl
      intro i _
      apply Finset.sum_congr rfl
      intro j _
      exact hsplit i j
    _ = _ := by
      simp only [Finset.sum_add_distrib]
      rw [hswap, ← hupper]
      simp [two_mul]

omit [CompactSpace X] [MeasurableSpace X] [BorelSpace X] [SecondCountableTopology X] in
/-- A finite tuple with pair-logarithm sum greater than −1 has truncated
empirical energy at least −2/n²−M/n. The second term is exactly the diagonal
penalty, which disappears as the number of points increases. -/
theorem truncated_energy_lower {n : ℕ} (hn : 0 < n) (z : Fin n → X)
    (hz : Function.Injective z)
    (hlog : -1 < ∑ ij ∈ Erdos1040Fekete.indexPairs n,
      Real.log (dist (z ij.1) (z ij.2))) (M : ℝ) :
    -(2 * (n : ℝ)⁻¹ ^ 2 + M * (n : ℝ)⁻¹) ≤
      (n : ℝ)⁻¹ ^ 2 * ∑ i, ∑ j, truncatedLog M (z i, z j) := by
  have hp : -1 ≤ ∑ ij ∈ Erdos1040Fekete.indexPairs n,
      truncatedLog M (z ij.1, z ij.2) := by
    apply hlog.le.trans
    apply Finset.sum_le_sum
    intro ij hij
    apply Real.log_le_log
    · exact dist_pos.mpr (hz.ne (Erdos1040Fekete.mem_indexPairs.mp hij).ne)
    · exact le_max_right _ _
  have hd := sum_pair_decomposition (fun i j => truncatedLog M (z i, z j))
    (fun i j => by simp only [truncatedLog_apply, dist_comm])
  simp only [truncatedLog_diag, Finset.sum_const, Finset.card_univ, Fintype.card_fin,
    nsmul_eq_mul] at hd
  have hl : -2 - M * (n : ℝ) ≤ ∑ i, ∑ j, truncatedLog M (z i, z j) := by
    linarith
  have hmul := mul_le_mul_of_nonneg_left hl (sq_nonneg ((n : ℝ)⁻¹))
  have hn0 : (n : ℝ) ≠ 0 := by exact_mod_cast hn.ne'
  have heq : (n : ℝ)⁻¹ ^ 2 * (-2 - M * (n : ℝ)) =
      -(2 * (n : ℝ)⁻¹ ^ 2 + M * (n : ℝ)⁻¹) := by
    field_simp [hn0]
    ring
  rwa [heq] at hmul

/-- A compact set of canonical transfinite diameter at least one admits a
probability measure whose every lower-truncated logarithmic energy is
nonnegative. The measure is obtained as a limit of finite Fekete approximants. -/
theorem exists_equilibrium_candidate {K : Set ℂ} (hcompact : IsCompact K)
    (hcap : 1 ≤ Erdos1040Fekete.transfiniteDiameter K) :
    ∃ μ : ProbabilityMeasure K, ∀ M > 0,
      0 ≤ ∫ p, Real.log (max (Real.exp (-M)) (dist p.1 p.2))
        ∂(μ.prod μ : Measure (K × K)) := by
  let : CompactSpace K := isCompact_iff_compactSpace.mp hcompact
  choose z hz hlog using
    (fun n : ℕ => exists_log_tuple hcap (by omega : 2 ≤ n + 2))
  have hinv : Tendsto (fun n : ℕ => ((n + 2 : ℕ) : ℝ)⁻¹) atTop (𝓝 0) :=
    tendsto_inv_atTop_nhds_zero_nat.comp (tendsto_add_atTop_nat 2)
  apply exists_nonneg_truncated_energy (fun n => n + 2) (fun n => by omega) z
    (fun M n => 2 * ((n + 2 : ℕ) : ℝ)⁻¹ ^ 2 + M * ((n + 2 : ℕ) : ℝ)⁻¹)
  · intro M _hM
    simpa using ((hinv.pow 2).const_mul 2).add (hinv.const_mul M)
  · intro M _hM n
    exact truncated_energy_lower (by omega) (z n) (hz n) (hlog n) M

/-- Ambient-plane form of the constructed candidate. Its probability measure
is supported on K, and each truncated energy is an integrable nonnegative
real integral. -/
theorem exists_equilibrium_candidate_ambient {K : Set ℂ} (hcompact : IsCompact K)
    (hcap : 1 ≤ Erdos1040Fekete.transfiniteDiameter K) :
    ∃ ν : ProbabilityMeasure ℂ, (ν : Measure ℂ) Kᶜ = 0 ∧ ∀ M > 0,
      Integrable (fun p : ℂ × ℂ => Real.log (max (Real.exp (-M)) (dist p.1 p.2)))
        (ν.prod ν : Measure (ℂ × ℂ)) ∧
      0 ≤ ∫ p, Real.log (max (Real.exp (-M)) (dist p.1 p.2))
        ∂(ν.prod ν : Measure (ℂ × ℂ)) := by
  let : CompactSpace K := isCompact_iff_compactSpace.mp hcompact
  obtain ⟨μ, hμ⟩ := exists_equilibrium_candidate hcompact hcap
  let ν := μ.map measurable_subtype_coe.aemeasurable
  have hprod : (ν.prod ν : Measure (ℂ × ℂ)) =
      (μ.prod μ : Measure (K × K)).map (Prod.map Subtype.val Subtype.val) :=
    Measure.map_prod_map _ _ measurable_subtype_coe measurable_subtype_coe
  refine ⟨ν, ?_, ?_⟩
  · change (μ : Measure K).map Subtype.val Kᶜ = 0
    rw [Measure.map_apply measurable_subtype_coe hcompact.isClosed.measurableSet.compl]
    have hp : (Subtype.val : K → ℂ) ⁻¹' Kᶜ = ∅ := by ext x; simp
    rw [hp, measure_empty]
  · intro M hM
    have hf : StronglyMeasurable (truncatedLog (X := ℂ) M) :=
      (truncatedLog (X := ℂ) M).continuous.stronglyMeasurable
    have hm : Measurable (Prod.map (Subtype.val : K → ℂ) (Subtype.val : K → ℂ)) :=
      measurable_subtype_coe.prodMap measurable_subtype_coe
    constructor
    · rw [hprod]
      apply (integrable_map_measure hf.aestronglyMeasurable hm.aemeasurable).mpr
      exact (truncatedLog (X := K) M).continuous.integrable_of_hasCompactSupport
        (HasCompactSupport.of_compactSpace _)
    · change 0 ≤ ∫ p, truncatedLog (X := ℂ) M p ∂(ν.prod ν : Measure (ℂ × ℂ))
      rw [hprod, integral_map_of_stronglyMeasurable hm hf]
      exact hμ M hM


end

end Erdos1040Equilibrium
end
