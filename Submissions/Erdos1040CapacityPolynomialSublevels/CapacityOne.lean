/- BEGIN LOCAL MODULE Erdos1040LimitSign -/
section
/-! Passing approximate sign bounds to limits in measure. The exceptional
sets need only have measure tending to zero, not a summable bound. -/

open MeasureTheory Filter Set
open scoped Topology

namespace Erdos1040LimitSign

variable {X : Type*} [MeasurableSpace X] {μ : Measure X}

theorem measure_strict_negative_eq_zero
    {f : ℕ → X → ℝ} {g : X → ℝ} (hfg : TendstoInMeasure μ f atTop g)
    {E : ℕ → Set X} (hE : Tendsto (fun n => μ (E n)) atTop (𝓝 0))
    {err : ℕ → ℝ} (herr : Tendsto err atTop (𝓝 0))
    (hlower : ∀ n x, x ∉ E n → -(err n) ≤ f n x)
    {r : ℝ} (hr : 0 < r) : μ {x | g x < -r} = 0 := by
  have hd := tendstoInMeasure_iff_norm.mp hfg (r / 2) (half_pos hr)
  have hs := hE.add hd
  simp only [add_zero] at hs
  have he : ∀ᶠ n in atTop, err n < r / 2 :=
    herr.eventually (Iio_mem_nhds (half_pos hr))
  have hb : ∀ᶠ n in atTop, μ {x | g x < -r} ≤
      μ (E n) + μ {x | r / 2 ≤ ‖f n x - g x‖} := by
    filter_upwards [he] with n hn
    apply le_trans (measure_mono (t := E n ∪ {x | r / 2 ≤ ‖f n x - g x‖}) ?_)
      (measure_union_le _ _)
    intro x hx
    by_cases hxE : x ∈ E n
    · exact Or.inl hxE
    · apply Or.inr
      have hlow := hlower n x hxE
      have hab : f n x - g x ≤ ‖f n x - g x‖ := le_abs_self _
      change g x < -r at hx
      change r / 2 ≤ ‖f n x - g x‖
      linarith
  exact le_antisymm (le_of_tendsto_of_tendsto tendsto_const_nhds hs hb) bot_le

theorem ae_nonnegative_of_approximate_lower_bound
    {f : ℕ → X → ℝ} {g : X → ℝ} (hfg : TendstoInMeasure μ f atTop g)
    {E : ℕ → Set X} (hE : Tendsto (fun n => μ (E n)) atTop (𝓝 0))
    {err : ℕ → ℝ} (herr : Tendsto err atTop (𝓝 0))
    (hlower : ∀ n x, x ∉ E n → -(err n) ≤ f n x) :
    ∀ᵐ x ∂μ, 0 ≤ g x := by
  have hb (n : ℕ) : ∀ᵐ x ∂μ, -(1 / ((n : ℝ) + 1)) ≤ g x := by
    have hz := measure_strict_negative_eq_zero hfg hE herr hlower
      (r := 1 / ((n : ℝ) + 1)) (by positivity)
    simpa only [ae_iff, not_le] using hz
  have hall : ∀ᵐ x ∂μ, ∀ n : ℕ, -(1 / ((n : ℝ) + 1)) ≤ g x :=
    ae_all_iff.mpr hb
  filter_upwards [hall] with x hx
  have ht : Tendsto (fun n : ℕ => -(1 / ((n : ℝ) + 1))) atTop (𝓝 0) := by
    simpa using (tendsto_one_div_add_atTop_nhds_zero_nat (𝕜 := ℝ)).neg
  exact le_of_tendsto_of_tendsto ht tendsto_const_nhds (Filter.Eventually.of_forall hx)


end Erdos1040LimitSign
end
/- END LOCAL MODULE Erdos1040LimitSign -/

/- BEGIN LOCAL MODULE Erdos1040Baseline -/
section
/-! Construction of a compactly supported probability measure with an actual
nonnegative planar logarithmic potential, directly from the canonical finite
Fekete diameters. No equilibrium or Frostman property is assumed. -/

open MeasureTheory Filter Set
open scoped Topology BigOperators

namespace Erdos1040Baseline

open Erdos1040FeketeMax Erdos1040FeketeEstimates Erdos1040Equilibrium
  Erdos1040LogDiscretization

noncomputable section

theorem integral_empirical_banach {X E : Type*} [MeasurableSpace X]
    [MeasurableSingletonClass X] [NormedAddCommGroup E] [NormedSpace ℝ E] [CompleteSpace E]
    {n : ℕ} (hn : 0 < n) (z : Fin n → X) (f : X → E) :
    (∫ x, f x ∂(empirical hn z : Measure X)) = (n : ℝ)⁻¹ • ∑ i, f (z i) := by
  change (∫ x, f x ∂((n : ENNReal)⁻¹ • ∑ i, Measure.dirac (z i))) = _
  rw [integral_smul_measure, integral_finsetSum_measure]
  · simp
  · intro i _
    exact integrable_dirac (by simp)

theorem potentialL2_empirical (D : Set ℂ) (hD : Bornology.IsBounded D)
    {S : Set ℂ} {n : ℕ} (hn : 0 < n) (z : Fin n → S) :
    potentialL2 D hD (empirical hn z : Measure S) = empiricalL2 D hD z :=
  integral_empirical_banach hn z _

/-- One weak subsequential limit of actual Fekete maximizers has nonnegative
logarithmic potential on every bounded measurable planar set. -/
theorem exists_nonnegative_potential_on_bounded_sets {K : Set ℂ}
    (hK : IsCompact K) (hcap : 1 ≤ Erdos1040Fekete.transfiniteDiameter K) :
    ∃ μ : ProbabilityMeasure K, ∀ (D : Set ℂ), Bornology.IsBounded D → MeasurableSet D →
      ∀ᵐ w ∂(volume.restrict D), 0 ≤ potential (μ : Measure K) w := by
  let : CompactSpace K := isCompact_iff_compactSpace.mp hK
  let : Nonempty K := (nonempty_of_one_le_transfiniteDiameter hcap).to_subtype
  obtain ⟨φ, hφ, hg⟩ := exists_good_fekete_subsequence hcap
  let N (k : ℕ) := φ k + 1
  have hN (k : ℕ) : 0 < N k := by dsimp [N]; omega
  let z (k : ℕ) : Fin (N k) → K := maximizingTuple K (N k)
  obtain ⟨μ, ψ, hψ, hμ⟩ :=
    SeqCompactSpace.tendsto_subseq (fun k => empirical (hN k) (z k))
  refine ⟨μ, ?_⟩
  intro D hD hmD
  have hNt : Tendsto (fun k => N (ψ k)) atTop atTop :=
    (tendsto_add_atTop_nat 1).comp (hφ.tendsto_atTop.comp hψ.tendsto_atTop)
  have hl2 : Tendsto (fun k => empiricalL2 D hD (z (ψ k))) atTop
      (𝓝 (potentialL2 D hD (μ : Measure K))) := by
    have h := (continuous_potentialL2 D hD hmD hK).continuousAt.tendsto.comp hμ
    simpa only [Function.comp_def, potentialL2_empirical] using h
  have him : TendstoInMeasure (volume.restrict D)
      (fun k w => (N (ψ k) : ℝ)⁻¹ * ∑ i, Real.log ‖w - (z (ψ k) i : ℂ)‖) atTop
      (potential (μ : Measure K)) := by
    exact (tendstoInMeasure_of_tendsto_Lp hl2).congr
      (fun k => coeFn_empiricalL2 D hD (z (ψ k)))
      (coeFn_potentialL2 D hD hmD hK (μ : Measure K))
  let E (k : ℕ) : Set ℂ := rootDisks (fun i => (z (ψ k) i : ℂ))
  have hE : Tendsto (fun k => (volume.restrict D) (E k)) atTop (𝓝 0) := by
    apply tendsto_of_tendsto_of_tendsto_of_le_of_le tendsto_const_nhds
      (rootDisks_bound_tendsto.comp hNt)
    · intro k
      exact bot_le
    · intro k
      exact (Measure.restrict_apply_le D (E k)).trans
        (rootDisks_volume_le (hN (ψ k)) (fun i => (z (ψ k) i : ℂ)))
  apply Erdos1040LimitSign.ae_nonnegative_of_approximate_lower_bound him hE
    (lowerError_tendsto.comp hNt)
  intro k w hw
  have hz : Function.Injective (fun i => (z (ψ k) i : ℂ)) :=
    Subtype.val_injective.comp (hg (ψ k)).2.1
  have hd : ∀ i, Real.exp (-1) ≤ ∏ j ∈ Finset.univ.erase i,
      dist (z (ψ k) i : ℂ) (z (ψ k) j : ℂ) := by
    intro i
    simpa only [Subtype.dist_eq] using (hg (ψ k)).2.2 i
  simpa only [dist_eq_norm, Function.comp_apply] using log_mean_lower_outside_rootDisks (hN (ψ k))
    (fun i => (z (ψ k) i : ℂ)) hz hd hw

/-- Canonical capacity at least one gives an actual probability measure on K
whose logarithmic potential is nonnegative almost everywhere in the whole
plane. This uses only finite Fekete maximization, Lagrange interpolation,
compactness of probability measures, and the planar L² logarithmic kernel. -/
theorem exists_nonnegative_potential {K : Set ℂ} (hK : IsCompact K)
    (hcap : 1 ≤ Erdos1040Fekete.transfiniteDiameter K) :
    ∃ μ : ProbabilityMeasure K, ∀ᵐ w ∂volume, 0 ≤ potential (μ : Measure K) w := by
  obtain ⟨μ, hμ⟩ := exists_nonnegative_potential_on_bounded_sets hK hcap
  refine ⟨μ, ?_⟩
  have h := (ae_restrict_iUnion_iff (μ := volume) (fun n : ℕ => Metric.ball (0 : ℂ) n)
    (fun w => 0 ≤ potential (μ : Measure K) w)).mpr
      (fun n => hμ _ Metric.isBounded_ball measurableSet_ball)
  simpa only [Metric.iUnion_ball_nat, Measure.restrict_univ] using h


end

end Erdos1040Baseline
end
/- END LOCAL MODULE Erdos1040Baseline -/

/- BEGIN LOCAL MODULE Erdos1040ExteriorHull -/
section
/-! A compact planar set can be filled to have connected exterior. The construction
uses only connected components and the connectedness of circles. -/

open Set Metric
open scoped Topology

namespace Erdos1040ExteriorHull

/-- The outside of a closed disk in the plane is connected. -/
theorem isConnected_compl_closedBall_zero {R : ℝ} (hR : 0 ≤ R) :
    IsConnected (closedBall (0 : ℂ) R)ᶜ := by
  have hs : IsConnected (sphere (0 : ℂ) 1) :=
    isConnected_sphere (by simp) 0 (by norm_num)
  have heq : (fun p : ℝ × ℂ => p.1 • p.2) ''
      (Ioi R ×ˢ sphere (0 : ℂ) 1) = (closedBall (0 : ℂ) R)ᶜ := by
    ext w
    constructor
    · rintro ⟨⟨r, z⟩, ⟨hr, hz⟩, rfl⟩
      have hz' : ‖z‖ = 1 := by simpa using hz
      have hr' : 0 ≤ r := hR.trans hr.le
      simpa [mem_closedBall, dist_zero_right, norm_smul, Real.norm_eq_abs,
        abs_of_nonneg hr', hz'] using hr
    · intro hw
      have hw' : R < ‖w‖ := by simpa using hw
      have hwpos : 0 < ‖w‖ := hR.trans_lt hw'
      refine ⟨(‖w‖, ‖w‖⁻¹ • w), ⟨hw', ?_⟩, ?_⟩
      · simp [hwpos.ne']
      · simp [hwpos.ne']
  rw [← heq]
  exact (isConnected_Ioi.prod hs).image _ (by fun_prop)

/-- The boundary of a component of an open set has no points in that open set. -/
theorem frontier_connectedComponentIn_subset_compl
    {X : Type*} [TopologicalSpace X] [LocallyConnectedSpace X]
    {U : Set X} (hU : IsOpen U) (x : X) :
    frontier (connectedComponentIn U x) ⊆ Uᶜ := by
  intro y hy hyU
  have hCy := hU.connectedComponentIn (x := y)
  obtain ⟨z, hzCy, hzCx⟩ := mem_closure_iff_nhds.mp hy.1 _
    (hCy.mem_nhds (mem_connectedComponentIn hyU))
  have heq : connectedComponentIn U x = connectedComponentIn U y :=
    (connectedComponentIn_eq hzCx).trans (connectedComponentIn_eq hzCy).symm
  exact hy.2 (by simpa [heq, hU.connectedComponentIn.interior_eq] using
    (mem_connectedComponentIn hyU))

/-- Fill the bounded complementary components of a compact planar set. -/
theorem exists_compact_connected_exterior {S : Set ℂ} (hS : IsCompact S) :
    ∃ H : Set ℂ, IsCompact H ∧ S ⊆ H ∧ IsOpen Hᶜ ∧
      IsConnected Hᶜ ∧ frontier H ⊆ S := by
  let : LocallyConnectedSpace ℂ := locallyConnectedSpace_of_connected_bases
    (fun x r => ball x r) (fun _ r => 0 < r) (fun _ => nhds_basis_ball)
    (fun x r _ => (convex_ball x r).isPreconnected)
  obtain ⟨R, hR, hSR⟩ := hS.isBounded.subset_ball_lt 0 (0 : ℂ)
  have hSB : S ⊆ closedBall (0 : ℂ) R := hSR.trans ball_subset_closedBall
  let E := (closedBall (0 : ℂ) R)ᶜ
  have hE : IsConnected E := isConnected_compl_closedBall_zero hR.le
  obtain ⟨x, hx⟩ := hE.nonempty
  have hES : E ⊆ Sᶜ := compl_subset_compl.mpr hSB
  let U := connectedComponentIn Sᶜ x
  have hU : IsOpen U := hS.isClosed.isOpen_compl.connectedComponentIn
  have hEU : E ⊆ U := hE.isPreconnected.subset_connectedComponentIn hx hES
  have hUB : Uᶜ ⊆ closedBall (0 : ℂ) R := by
    simpa [E] using compl_subset_compl.mpr hEU
  refine ⟨Uᶜ, isCompact_of_isClosed_isBounded hU.isClosed_compl
    (isBounded_closedBall.subset hUB), ?_, ?_, ?_, ?_⟩
  · exact fun s hs hu => (connectedComponentIn_subset Sᶜ x hu) hs
  · simpa using hU
  · simpa [U] using isConnected_connectedComponentIn_iff.mpr (hES hx)
  · simpa [frontier_compl, U] using
      frontier_connectedComponentIn_subset_compl hS.isClosed.isOpen_compl x

end Erdos1040ExteriorHull
end
/- END LOCAL MODULE Erdos1040ExteriorHull -/

/- BEGIN LOCAL MODULE Erdos1040Support -/
section
/-! Transport the constructed baseline to its actual compact support. This
provides full support, without assuming any support property of a Fekete limit. -/

open Set MeasureTheory
open scoped Topology

namespace Erdos1040Support

noncomputable section

/-- The ambient pushforward of a probability measure on a planar subset. -/
def ambient {K : Set ℂ} (μ : ProbabilityMeasure K) : ProbabilityMeasure ℂ :=
  μ.map measurable_subtype_coe.aemeasurable

theorem ambient_compl {K : Set ℂ} (hK : IsClosed K) (μ : ProbabilityMeasure K) :
    (ambient μ : Measure ℂ) Kᶜ = 0 := by
  change (μ : Measure K).map Subtype.val Kᶜ = 0
  rw [Measure.map_apply measurable_subtype_coe hK.measurableSet.compl]
  have hpre : (Subtype.val : K → ℂ) ⁻¹' Kᶜ = ∅ := by ext x; simp
  rw [hpre, measure_empty]

theorem support_ambient_subset {K : Set ℂ} (hK : IsClosed K)
    (μ : ProbabilityMeasure K) : (ambient μ : Measure ℂ).support ⊆ K :=
  Measure.support_subset_of_isClosed hK (ambient_compl hK μ)

theorem isCompact_support_ambient {K : Set ℂ} (hK : IsCompact K)
    (μ : ProbabilityMeasure K) : IsCompact (ambient μ : Measure ℂ).support :=
  hK.of_isClosed_subset Measure.isClosed_support (support_ambient_subset hK.isClosed μ)

theorem integral_ambient {K : Set ℂ} (hK : MeasurableSet K) (μ : ProbabilityMeasure K)
    {E : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E] (f : ℂ → E) :
    (∫ z, f z ∂(ambient μ : Measure ℂ)) = ∫ z : K, f z ∂(μ : Measure K) :=
  (MeasurableEmbedding.subtype_coe hK).integral_map f

/-- A probability measure viewed on its conull support. -/
def onSupport (ν : ProbabilityMeasure ℂ) : ProbabilityMeasure (ν : Measure ℂ).support :=
  ⟨(ν : Measure ℂ).comap Subtype.val,
    (MeasurableEmbedding.subtype_coe Measure.isClosed_support.measurableSet).isProbabilityMeasure_comap
      (by simpa using (Measure.support_mem_ae (μ := (ν : Measure ℂ))))⟩

theorem ambient_onSupport (ν : ProbabilityMeasure ℂ) :
    (ambient (onSupport ν) : Measure ℂ) = (ν : Measure ℂ) := by
  change ((ν : Measure ℂ).comap Subtype.val).map Subtype.val = _
  rw [map_comap_subtype_coe Measure.isClosed_support.measurableSet]
  exact Measure.restrict_eq_self_of_ae_mem Measure.support_mem_ae

theorem integral_onSupport (ν : ProbabilityMeasure ℂ)
    {E : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E] (f : ℂ → E) :
    (∫ z : (ν : Measure ℂ).support, f z ∂(onSupport ν : Measure _)) =
      ∫ z, f z ∂(ν : Measure ℂ) := by
  rw [← integral_ambient Measure.isClosed_support.measurableSet (onSupport ν) f,
    ambient_onSupport]

/-- Every nonempty relatively open subset of the support has positive mass. -/
instance onSupport_isOpenPosMeasure (ν : ProbabilityMeasure ℂ) :
    (onSupport ν : Measure (ν : Measure ℂ).support).IsOpenPosMeasure where
  open_pos U hU hUne := by
    obtain ⟨V, hV, rfl⟩ := isOpen_induced_iff.mp hU
    obtain ⟨z, hz⟩ := hUne
    have hpos : 0 < (ν : Measure ℂ) V :=
      (Measure.mem_support_iff_forall (z : ℂ)).mp z.property V (hV.mem_nhds hz)
    change (ν : Measure ℂ).comap Subtype.val (Subtype.val ⁻¹' V) ≠ 0
    rw [comap_subtype_coe_apply Measure.isClosed_support.measurableSet]
    rw [Subtype.image_preimage_coe]
    have heq : (ν : Measure ℂ) (V ∩ (ν : Measure ℂ).support) = (ν : Measure ℂ) V := by
      rw [← Measure.restrict_apply hV.measurableSet,
        Measure.restrict_eq_self_of_ae_mem (s := (ν : Measure ℂ).support)
          (Measure.support_mem_ae (μ := (ν : Measure ℂ)))]
    simpa [inter_comm] using heq.symm ▸ hpos.ne'

/-- A continuous almost-everywhere identity holds everywhere on the support. -/
theorem eqOn_support_of_ae_eq (ν : Measure ℂ) {E : Type*} [TopologicalSpace E]
    [T2Space E] {f g : ℂ → E} (hf : Continuous f) (hg : Continuous g)
    (hfg : f =ᵐ[ν] g) : EqOn f g ν.support :=
  Measure.support_subset_of_isClosed (isClosed_eq hf hg) hfg

/-- The canonical capacity assumption gives a full-support compact baseline. -/
theorem exists_fullSupport_nonnegative_potential {K : Set ℂ} (hK : IsCompact K)
    (hcap : 1 ≤ Erdos1040Fekete.transfiniteDiameter K) :
    ∃ S : Set ℂ, IsCompact S ∧ S ⊆ K ∧ ∃ μ : ProbabilityMeasure S,
      (μ : Measure S).IsOpenPosMeasure ∧
      ∀ᵐ w ∂volume, 0 ≤ Erdos1040LogDiscretization.potential (μ : Measure S) w := by
  obtain ⟨μ, hμ⟩ := Erdos1040Baseline.exists_nonnegative_potential hK hcap
  let ν := ambient μ
  let S := (ν : Measure ℂ).support
  refine ⟨S, isCompact_support_ambient hK μ, support_ambient_subset hK.isClosed μ,
    onSupport ν, inferInstance, ?_⟩
  have hid (w : ℂ) : Erdos1040LogDiscretization.potential (onSupport ν : Measure S) w =
      Erdos1040LogDiscretization.potential (μ : Measure K) w := by
    change (∫ z : S, Real.log ‖w - (z : ℂ)‖ ∂(onSupport ν : Measure S)) = _
    dsimp [S]
    exact (integral_onSupport ν (fun z => Real.log ‖w - z‖)).trans
      (integral_ambient hK.isClosed.measurableSet μ (fun z => Real.log ‖w - z‖))
  simpa only [hid] using hμ

/-- Ambient form of the baseline, with its actual support contained in K. -/
theorem exists_ambient_nonnegative_potential {K : Set ℂ} (hK : IsCompact K)
    (hcap : 1 ≤ Erdos1040Fekete.transfiniteDiameter K) :
    ∃ ν : ProbabilityMeasure ℂ, IsCompact (ν : Measure ℂ).support ∧
      (ν : Measure ℂ).support ⊆ K ∧
      ∀ᵐ w ∂volume, 0 ≤ ∫ z, Real.log ‖w - z‖ ∂(ν : Measure ℂ) := by
  obtain ⟨μ, hμ⟩ := Erdos1040Baseline.exists_nonnegative_potential hK hcap
  refine ⟨ambient μ, isCompact_support_ambient hK μ,
    support_ambient_subset hK.isClosed μ, ?_⟩
  filter_upwards [hμ] with w hw
  rwa [integral_ambient hK.isClosed.measurableSet μ]

end

end Erdos1040Support
end
/- END LOCAL MODULE Erdos1040Support -/

/- BEGIN LOCAL MODULE Erdos1040Closing -/
section
/-! The exact finite-root closing step. Its positive-margin hypothesis is
explicit: the construction of measures with that property is a separate task. -/

open Set Metric MeasureTheory
open scoped BigOperators

namespace Erdos1040Closing

open Erdos1040LogDiscretization

theorem rootProduct_ofFn {S : Set ℂ} {N : ℕ} (w : Fin N → S) (z : ℂ) :
    Erdos1040Foundation.rootProduct (List.ofFn fun i => (w i : ℂ)) z =
      rootPolynomial w z := by
  simp [Erdos1040Foundation.rootProduct, List.map_ofFn, List.prod_ofFn,
    rootPolynomial, Function.comp_def]

/-- The unit sublevel of a product with roots in a disk stays in the disk
enlarged by one. -/
theorem rootPolynomial_sublevel_subset_ball {S : Set ℂ} {R : ℝ}
    (hSR : S ⊆ closedBall (0 : ℂ) R) {N : ℕ} (w : Fin N → S) :
    {z : ℂ | ‖rootPolynomial w z‖ < 1} ⊆ ball (0 : ℂ) (R + 1) := by
  intro z hz
  by_contra hzo
  have hzR : R + 1 ≤ ‖z‖ := by simpa using hzo
  have hfactor (i : Fin N) : 1 ≤ ‖z - (w i : ℂ)‖ := by
    have hi : ‖(w i : ℂ)‖ ≤ R := by simpa using hSR (w i).property
    have htri := norm_sub_norm_le z (w i : ℂ)
    linarith
  have hp : 1 ≤ ‖rootPolynomial w z‖ := by
    rw [rootPolynomial, norm_prod]
    exact Finset.one_le_prod (fun i _ => hfactor i)
  exact (not_lt_of_ge hp) hz

/-- One compactly supported probability with a positive potential margin
outside a small region gives an admissible finite list with small total area. -/
theorem exists_rootList_sublevel_lt {F S : Set ℂ} (hS : IsCompact S)
    (hSF : S ⊆ F) {R : ℝ} (hSR : S ⊆ closedBall (0 : ℂ) R)
    (μ : ProbabilityMeasure S) {a ε : ℝ} (ha : 0 < a) (hε : 0 < ε)
    (hbad : (volume.restrict (ball (0 : ℂ) (R + 1))).real
      {z | potential (μ : Measure S) z ≤ a} < ε / 2) :
    ∃ roots : List ℂ, roots ≠ [] ∧ (∀ z ∈ roots, z ∈ F) ∧
      volume {z : ℂ | ‖Erdos1040Foundation.rootProduct roots z‖ < 1} <
        ENNReal.ofReal ε := by
  let D := ball (0 : ℂ) (R + 1)
  have hD : Bornology.IsBounded D := isBounded_ball
  have hmD : MeasurableSet D := measurableSet_ball
  let : IsFiniteMeasure (volume.restrict D) :=
    isFiniteMeasure_restrict.mpr hD.measure_lt_top.ne
  have he : 0 < a ^ 2 * (ε / 2) := mul_pos (sq_pos_of_pos ha) (by positivity)
  obtain ⟨N, hN, w, hw⟩ := exists_empiricalL2 D hD hmD hS (μ : Measure S)
    (Real.sqrt_pos.mpr he)
  have hclose : ‖empiricalL2 D hD w - potentialL2 D hD (μ : Measure S)‖ ^ 2 <
      a ^ 2 * (ε / 2) := by
    have hs := Real.sq_sqrt he.le
    have hn := norm_nonneg (empiricalL2 D hD w - potentialL2 D hD (μ : Measure S))
    nlinarith
  have hbad' : (volume.restrict D).real
      {z | potentialL2 D hD (μ : Measure S) z ≤ a} < ε / 2 := by
    calc
      _ = (volume.restrict D).real {z | potential (μ : Measure S) z ≤ a} := by
        apply measureReal_congr
        filter_upwards [coeFn_potentialL2 D hD hmD hS (μ : Measure S)] with z hz
        exact congrArg (fun r : ℝ => r ≤ a) hz
      _ < ε / 2 := hbad
  have hneg := Erdos1040Area.negative_region_measure_lt
    (empiricalL2 D hD w) (potentialL2 D hD (μ : Measure S)) ha hbad' hclose
  have harea : (volume.restrict D).real {z : ℂ | ‖rootPolynomial w z‖ < 1} < ε := by
    rwa [measureReal_congr (rootPolynomial_sublevel_ae D hD hN w)]
  have hareaE : (volume.restrict D) {z : ℂ | ‖rootPolynomial w z‖ < 1} <
      ENNReal.ofReal ε := by
    rw [← ofReal_measureReal]
    exact (ENNReal.ofReal_lt_ofReal_iff hε).mpr harea
  have hsubset : {z : ℂ | ‖rootPolynomial w z‖ < 1} ⊆ D :=
    rootPolynomial_sublevel_subset_ball hSR w
  rw [Measure.restrict_eq_self volume hsubset] at hareaE
  refine ⟨List.ofFn (fun i => (w i : ℂ)), ?_, ?_, ?_⟩
  · simpa using hN.ne'
  · intro z hz
    obtain ⟨i, rfl⟩ := List.mem_ofFn.mp hz
    exact hSF (w i).property
  · simpa only [rootProduct_ofFn] using hareaE

/-- Explicit positive-margin hypothesis implies the canonical root infimum
is zero. This is the finite-root conclusion used by the compact branch. -/
theorem polynomialSublevelInfimum_eq_zero_of_positive_margins
    {F S : Set ℂ} (hS : IsCompact S) (hSF : S ⊆ F) {R : ℝ}
    (hSR : S ⊆ closedBall (0 : ℂ) R)
    (hmargins : ∀ ε : ℝ, 0 < ε → ∃ μ : ProbabilityMeasure S, ∃ a : ℝ, 0 < a ∧
      (volume.restrict (ball (0 : ℂ) (R + 1))).real
        {z | potential (μ : Measure S) z ≤ a} < ε / 2) :
    Erdos1040Foundation.polynomialSublevelInfimum F = 0 := by
  apply le_antisymm _ bot_le
  apply ENNReal.le_of_forall_pos_le_add
  intro ε hε _
  obtain ⟨μ, a, ha, hbad⟩ := hmargins ε hε
  obtain ⟨roots, hn, hF, harea⟩ :=
    exists_rootList_sublevel_lt hS hSF hSR μ ha hε hbad
  let p : {l : List ℂ // l ≠ [] ∧ ∀ z ∈ l, z ∈ F} := ⟨roots, hn, hF⟩
  have hi := iInf_le (fun p : {l : List ℂ // l ≠ [] ∧ ∀ z ∈ l, z ∈ F} =>
    volume {z : ℂ | ‖Erdos1040Foundation.rootProduct p.1 z‖ < 1}) p
  have hh := hi.trans harea.le
  simpa [Erdos1040Foundation.polynomialSublevelInfimum, p] using hh

/-- Ambient probabilities can be discretized on their actual support, including
when a positive tilt has changed the support. -/
theorem exists_rootList_sublevel_lt_ambient {F : Set ℂ} (ν : ProbabilityMeasure ℂ)
    (hS : IsCompact (ν : Measure ℂ).support)
    (hSF : (ν : Measure ℂ).support ⊆ F) {R : ℝ}
    (hSR : (ν : Measure ℂ).support ⊆ closedBall (0 : ℂ) R)
    {a ε : ℝ} (ha : 0 < a) (hε : 0 < ε)
    (hbad : (volume.restrict (ball (0 : ℂ) (R + 1))).real
      {w | (∫ z, Real.log ‖w - z‖ ∂(ν : Measure ℂ)) ≤ a} < ε / 2) :
    ∃ roots : List ℂ, roots ≠ [] ∧ (∀ z ∈ roots, z ∈ F) ∧
      volume {z : ℂ | ‖Erdos1040Foundation.rootProduct roots z‖ < 1} <
        ENNReal.ofReal ε := by
  have hp : potential (Erdos1040Support.onSupport ν : Measure (ν : Measure ℂ).support) =
      fun w => ∫ z, Real.log ‖w - z‖ ∂(ν : Measure ℂ) := by
    funext w
    exact Erdos1040Support.integral_onSupport ν (fun z => Real.log ‖w - z‖)
  apply exists_rootList_sublevel_lt hS hSF hSR (Erdos1040Support.onSupport ν) ha hε
  simpa only [hp] using hbad

/-- Ambient positive margins close the canonical root when all approximating
probability measures are supported in one fixed compact set of allowed roots. -/
theorem polynomialSublevelInfimum_eq_zero_of_ambient_positive_margins
    {F S : Set ℂ} (hS : IsCompact S) (hSF : S ⊆ F) {R : ℝ}
    (hSR : S ⊆ closedBall (0 : ℂ) R)
    (hmargins : ∀ ε : ℝ, 0 < ε → ∃ ν : ProbabilityMeasure ℂ,
      (ν : Measure ℂ).support ⊆ S ∧ ∃ a : ℝ, 0 < a ∧
      (volume.restrict (ball (0 : ℂ) (R + 1))).real
        {w | (∫ z, Real.log ‖w - z‖ ∂(ν : Measure ℂ)) ≤ a} < ε / 2) :
    Erdos1040Foundation.polynomialSublevelInfimum F = 0 := by
  apply le_antisymm _ bot_le
  apply ENNReal.le_of_forall_pos_le_add
  intro ε hε _
  obtain ⟨ν, hνS, a, ha, hbad⟩ := hmargins ε hε
  obtain ⟨roots, hn, hF, harea⟩ := exists_rootList_sublevel_lt_ambient ν
    (hS.of_isClosed_subset Measure.isClosed_support hνS) (hνS.trans hSF)
    (hνS.trans hSR) ha hε hbad
  let p : {l : List ℂ // l ≠ [] ∧ ∀ z ∈ l, z ∈ F} := ⟨roots, hn, hF⟩
  have hi := iInf_le (fun p : {l : List ℂ // l ≠ [] ∧ ∀ z ∈ l, z ∈ F} =>
    volume {z : ℂ | ‖Erdos1040Foundation.rootProduct p.1 z‖ < 1}) p
  have hh := hi.trans harea.le
  simpa [Erdos1040Foundation.polynomialSublevelInfimum, p] using hh

end Erdos1040Closing
end
/- END LOCAL MODULE Erdos1040Closing -/

/- BEGIN LOCAL MODULE Erdos1040PositiveDensity -/
section
/-! Adding a positive constant to a bounded signed source density, normalizing
it to a probability measure, and computing its Banach-valued integrals. -/

open MeasureTheory Set Filter
open scoped Topology

namespace Erdos1040PositiveDensity

variable {X : Type*} [MeasurableSpace X] {μ : Measure X} [IsProbabilityMeasure μ]

noncomputable def density (h : X → ℝ) (C : ℝ) (x : X) : ℝ :=
  (h x + C) / ((∫ y, h y ∂μ) + C)

theorem denominator_pos {h : X → ℝ} {B C : ℝ}
    (hB : ∀ x, ‖h x‖ ≤ B) (hC : B < C) :
    0 < (∫ y, h y ∂μ) + C := by
  have hm : ‖∫ y, h y ∂μ‖ ≤ B := by
    simpa using norm_integral_le_of_norm_le_const (μ := μ) (Filter.Eventually.of_forall hB)
  have := neg_abs_le (∫ y, h y ∂μ)
  rw [Real.norm_eq_abs] at hm
  linarith

theorem density_pos {h : X → ℝ} {B C : ℝ}
    (hB : ∀ x, ‖h x‖ ≤ B) (hC : B < C) (x : X) :
    0 < density (μ := μ) h C x := by
  apply div_pos _ (denominator_pos hB hC)
  have := hB x
  have := neg_abs_le (h x)
  rw [Real.norm_eq_abs] at *
  linarith

theorem integrable_density {h : X → ℝ} (hh : Integrable h μ) (C : ℝ) :
    Integrable (density (μ := μ) h C) μ :=
  (hh.add (integrable_const C)).div_const _

theorem integral_density {h : X → ℝ} (hh : Integrable h μ) {B C : ℝ}
    (hB : ∀ x, ‖h x‖ ≤ B) (hC : B < C) :
    (∫ x, density (μ := μ) h C x ∂μ) = 1 := by
  unfold density
  rw [integral_div, integral_add hh (integrable_const C)]
  simpa using div_self (denominator_pos (μ := μ) hB hC).ne'

theorem density_mass {h : X → ℝ} (hh : Integrable h μ) {B C : ℝ}
    (hB : ∀ x, ‖h x‖ ≤ B) (hC : B < C) :
    (∫⁻ x, ENNReal.ofReal (density (μ := μ) h C x) ∂μ) = 1 := by
  rw [← ofReal_integral_eq_lintegral_ofReal (integrable_density hh C)
    (Filter.Eventually.of_forall fun x => (density_pos hB hC x).le)]
  rw [integral_density hh hB hC]
  simp

noncomputable def tilted (h : X → ℝ) (hh : Integrable h μ) (B C : ℝ)
    (hB : ∀ x, ‖h x‖ ≤ B) (hC : B < C) : ProbabilityMeasure X :=
  ⟨μ.withDensity (fun x => ENNReal.ofReal (density (μ := μ) h C x)), by
    constructor
    rw [withDensity_apply _ MeasurableSet.univ, Measure.restrict_univ]
    exact density_mass hh hB hC⟩

variable {E : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E] [CompleteSpace E]

theorem integral_tilted (h : X → ℝ) (hh : Integrable h μ) (B C : ℝ)
    (hB : ∀ x, ‖h x‖ ≤ B) (hC : B < C)
    (K : X → E) (hK : Integrable K μ) (hhK : Integrable (fun x => h x • K x) μ) :
    (∫ x, K x ∂(tilted h hh B C hB hC : Measure X)) =
      ((∫ x, h x ∂μ) + C)⁻¹ • ((∫ x, h x • K x ∂μ) + C • ∫ x, K x ∂μ) := by
  change (∫ x, K x ∂μ.withDensity _) = _
  rw [integral_withDensity_eq_integral_toReal_smul₀
    ((integrable_density hh C).aemeasurable.ennreal_ofReal) (by simp)]
  have heq : (fun x => (ENNReal.ofReal (density (μ := μ) h C x)).toReal • K x) =
      (fun x => ((∫ x, h x ∂μ) + C)⁻¹ • (h x • K x + C • K x)) := by
    funext x
    rw [ENNReal.toReal_ofReal (density_pos hB hC x).le]
    rw [density, div_eq_mul_inv, mul_comm, mul_smul, add_smul]
  have hCK : Integrable (fun x => C • K x) μ := by
    fun_prop
  rw [heq, integral_smul, integral_add hhK hCK, integral_smul]

omit [CompleteSpace E] in
theorem normalized_sub (V U : E) (m C : ℝ) (hmC : m + C ≠ 0) :
    (m + C)⁻¹ • (V + C • U) - U = (m + C)⁻¹ • (V - m • U) := by
  have hc : (m + C)⁻¹ * C - 1 = -((m + C)⁻¹ * m) := by
    field_simp
    ring
  calc
    _ = (m + C)⁻¹ • V + ((m + C)⁻¹ * C - 1) • U := by module
    _ = _ := by rw [hc]; module

theorem tendsto_normalized (V U : E) (m : ℝ) :
    Tendsto (fun C : ℝ => (m + C)⁻¹ • (V + C • U)) atTop (𝓝 U) := by
  have hi : Tendsto (fun C : ℝ => (m + C)⁻¹) atTop (𝓝 0) :=
    tendsto_inv_atTop_zero.comp (tendsto_atTop_add_const_left atTop m tendsto_id)
  have hs : Tendsto (fun C : ℝ => (m + C)⁻¹ • (V - m • U)) atTop (𝓝 0) := by
    simpa using hi.smul_const (V - m • U)
  rw [tendsto_iff_norm_sub_tendsto_zero]
  have hn : Tendsto (fun C : ℝ => ‖(m + C)⁻¹ • (V - m • U)‖) atTop (𝓝 0) := by
    simpa using hs.norm
  apply hn.congr'
  filter_upwards [eventually_gt_atTop (-m)] with C hC
  exact congrArg norm (normalized_sub V U m C (by linarith)).symm

/-- The normalized positive source measure can preserve a chosen density h
while bringing every fixed Banach kernel integral arbitrarily close to baseline. -/
theorem exists_tilted_close (h : X → ℝ) (hh : Integrable h μ) (B : ℝ)
    (hB : ∀ x, ‖h x‖ ≤ B) (K : X → E) (hK : Integrable K μ)
    (hhK : Integrable (fun x => h x • K x) μ) {ε : ℝ} (hε : 0 < ε) :
    ∃ (C : ℝ) (hC : B < C),
      ‖(∫ x, K x ∂(tilted h hh B C hB hC : Measure X)) - ∫ x, K x ∂μ‖ < ε := by
  have ht := tendsto_normalized (∫ x, h x • K x ∂μ) (∫ x, K x ∂μ) (∫ x, h x ∂μ)
  have hc : ∀ᶠ C in atTop,
      ‖((∫ x, h x ∂μ) + C)⁻¹ • ((∫ x, h x • K x ∂μ) + C • ∫ x, K x ∂μ) -
        ∫ x, K x ∂μ‖ < ε := by
    simpa only [Metric.mem_ball, dist_eq_norm] using ht.eventually
      (Metric.ball_mem_nhds (∫ x, K x ∂μ) hε)
  obtain ⟨C, hC, hc⟩ := ((eventually_gt_atTop B).and hc).exists
  refine ⟨C, hC, ?_⟩
  rw [integral_tilted h hh B C hB hC K hK hhK]
  exact hc


end Erdos1040PositiveDensity
end
/- END LOCAL MODULE Erdos1040PositiveDensity -/

/- BEGIN LOCAL MODULE Erdos1040Margins -/
section
/-! Positive margins outside small sets and the final positive-potential step. -/

open MeasureTheory Filter Set
open scoped Topology

namespace Erdos1040Margins

variable {X : Type*} [MeasurableSpace X] {μ : Measure X} [IsFiniteMeasure μ]

theorem exists_positive_margin {g : X → ℝ} (hg : AEMeasurable g μ)
    (hpos : ∀ᵐ x ∂μ, 0 < g x) {ε : ℝ} (hε : 0 < ε) :
    ∃ a > 0, μ.real {x | g x ≤ a} < ε := by
  let s (n : ℕ) := {x | g x ≤ 1 / ((n : ℝ) + 1)}
  have hs (n : ℕ) : NullMeasurableSet (s n) μ := by
    exact nullMeasurableSet_le hg aemeasurable_const
  have hm : Antitone s := by
    intro n m hnm x hx
    have hd : (1 : ℝ) / ((m : ℝ) + 1) ≤ 1 / ((n : ℝ) + 1) := by
      gcongr
    exact hx.trans hd
  have hi : μ (⋂ n, s n) = 0 := by
    have hsub : (⋂ n, s n) ⊆ {x | g x ≤ 0} := by
      intro x hx
      exact le_of_tendsto_of_tendsto tendsto_const_nhds
        (tendsto_one_div_add_atTop_nhds_zero_nat (𝕜 := ℝ))
        (Filter.Eventually.of_forall fun n => mem_iInter.mp hx n)
    exact measure_mono_null hsub (by simpa only [ae_iff, not_lt] using hpos)
  have ht : Tendsto (fun n => μ (s n)) atTop (𝓝 0) := by
    simpa only [Function.comp_def, hi] using
      tendsto_measure_iInter_atTop hs hm ⟨0, measure_ne_top μ _⟩
  have htr : Tendsto (fun n => μ.real (s n)) atTop (𝓝 0) := by
    simpa only [Function.comp_def, measureReal_def, ENNReal.toReal_zero] using
      (ENNReal.tendsto_toReal (by simp : (0 : ENNReal) ≠ ⊤)).comp ht
  obtain ⟨n, hn⟩ := (htr.eventually (Iio_mem_nhds hε)).exists
  exact ⟨1 / ((n : ℝ) + 1), by positivity, hn⟩


end Erdos1040Margins
end
