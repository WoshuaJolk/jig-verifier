/- BEGIN LOCAL MODULE Erdos1040OuterMargins -/
section
/-! Assemble a small exceptional set inside the filled support and strict
baseline positivity outside it into an actual positive probability margin. -/

open Set Metric MeasureTheory Filter
open scoped Topology

namespace Erdos1040OuterMargins

open Erdos1040LogKernel Erdos1040LogDiscretization Erdos1040Support

theorem integrable_logKernel_ambient (D : Set ℂ) (hD : Bornology.IsBounded D)
    (hmD : MeasurableSet D) (ν : ProbabilityMeasure ℂ)
    (hν : IsCompact (ν : Measure ℂ).support) :
    Integrable (logKernel D hD) (ν : Measure ℂ) := by
  have h := integrable_logKernel D hD hmD hν (onSupport ν : Measure _)
  have hm : Integrable (logKernel D hD)
      ((onSupport ν : Measure (ν : Measure ℂ).support).map Subtype.val) :=
    (MeasurableEmbedding.subtype_coe
      (Measure.isClosed_support (μ := (ν : Measure ℂ))).measurableSet).integrable_map_iff.mpr h
  change Integrable (logKernel D hD) (ambient (onSupport ν) : Measure ℂ) at hm
  simpa only [ambient_onSupport] using hm

theorem coeFn_integral_logKernel_ambient (D : Set ℂ) (hD : Bornology.IsBounded D)
    (hmD : MeasurableSet D) (ν : ProbabilityMeasure ℂ)
    (hν : IsCompact (ν : Measure ℂ).support) :
    (⇑(∫ z, logKernel D hD z ∂(ν : Measure ℂ))) =ᵐ[volume.restrict D]
      fun w => ∫ z, Real.log ‖w - z‖ ∂(ν : Measure ℂ) := by
  let : IsFiniteMeasure (volume.restrict D) :=
    isFiniteMeasure_restrict.mpr hD.measure_lt_top.ne
  apply CampaignAnalysis277Kernel.coeFn_integral_eq_integral_ae_of_measurable
    (integrable_logKernel_ambient D hD hmD ν hν)
  · exact (Real.measurable_log.comp (measurable_snd.sub measurable_fst).norm).aestronglyMeasurable
  · exact Eventually.of_forall fun z => coeFn_logKernel D hD z

theorem coeFn_integral_smul_logKernel_ambient (D : Set ℂ) (hD : Bornology.IsBounded D)
    (hmD : MeasurableSet D) (ν : ProbabilityMeasure ℂ)
    (hν : IsCompact (ν : Measure ℂ).support) (h : ℂ → ℝ) (hh : Measurable h)
    {B : ℝ} (hB : ∀ z, ‖h z‖ ≤ B) :
    (⇑(∫ z, h z • logKernel D hD z ∂(ν : Measure ℂ))) =ᵐ[volume.restrict D]
      fun w => ∫ z, h z * Real.log ‖w - z‖ ∂(ν : Measure ℂ) := by
  let : IsFiniteMeasure (volume.restrict D) :=
    isFiniteMeasure_restrict.mpr hD.measure_lt_top.ne
  apply CampaignAnalysis277Kernel.coeFn_integral_eq_integral_ae_of_measurable
    ((integrable_logKernel_ambient D hD hmD ν hν).bdd_smul B
      hh.aestronglyMeasurable (Eventually.of_forall hB))
  · exact ((hh.comp measurable_fst).mul
      (Real.measurable_log.comp (measurable_snd.sub measurable_fst).norm)).aestronglyMeasurable
  · apply Eventually.of_forall
    intro z
    filter_upwards [Lp.coeFn_smul (h z) (logKernel D hD z), coeFn_logKernel D hD z]
      with w hw hlog
    change (h z • logKernel D hD z) w = _
    rw [hw]
    change h z * logKernel D hD z w = _
    rw [hlog]

/-- Three exceptional regions suffice: the bad inner region, the low exterior
baseline region, and a squared-error exceedance region. -/
theorem sublevel_measure_le {X : Type*} [MeasurableSpace X] (μ : Measure X)
    [IsFiniteMeasure μ] (u v : Lp ℝ 2 μ) (H A : Set X) {a τ : ℝ}
    (hτ : 0 < τ) (haτ : a ≤ τ / 2)
    (hinner : ∀ᵐ x ∂μ, x ∈ H → x ∉ A → a < u x) :
    μ.real {x | u x ≤ a} ≤ μ.real A + μ.real (Hᶜ ∩ {x | v x ≤ τ}) +
      ‖u - v‖ ^ 2 / (τ / 2) ^ 2 := by
  have hsub : μ {x | u x ≤ a} ≤
      μ ((A ∪ (Hᶜ ∩ {x | v x ≤ τ})) ∪ {x | (τ / 2) ^ 2 ≤ ((u - v) x) ^ 2}) := by
    apply measure_mono_ae
    filter_upwards [hinner, Lp.coeFn_sub u v] with x hx hdiff
    intro hxu
    by_cases hxA : x ∈ A
    · exact Or.inl (Or.inl hxA)
    by_cases hxH : x ∈ H
    · exact False.elim ((not_lt_of_ge hxu) (hx hxH hxA))
    by_cases hxv : v x ≤ τ
    · exact Or.inl (Or.inr ⟨hxH, hxv⟩)
    · right
      change (τ / 2) ^ 2 ≤ ((u - v) x) ^ 2
      rw [hdiff]
      change (τ / 2) ^ 2 ≤ (u x - v x) ^ 2
      have hv : τ < v x := lt_of_not_ge hxv
      change u x ≤ a at hxu
      nlinarith
  have hr := ENNReal.toReal_mono (measure_ne_top μ _) hsub
  exact hr.trans ((measureReal_union_le _ _).trans
    (add_le_add (measureReal_union_le _ _)
      (Erdos1040Area.square_exceedance_measure_le (u - v) (by positivity))))

/-- Inner signed-density positivity and strict exterior baseline positivity
produce a positive probability margin outside an arbitrarily small area. -/
theorem exists_positive_probability_margin
    (D : Set ℂ) (hD : Bornology.IsBounded D) (hmD : MeasurableSet D)
    (H : Set ℂ) (hH : IsCompact H) (ν : ProbabilityMeasure ℂ)
    (hν : IsCompact (ν : Measure ℂ).support)
    (hnonneg : ∀ᵐ w ∂volume, 0 ≤ ∫ z, Real.log ‖w - z‖ ∂(ν : Measure ℂ))
    (hpositive : ∀ w ∈ Hᶜ, 0 < ∫ z, Real.log ‖w - z‖ ∂(ν : Measure ℂ))
    (hinner : ∀ η : ℝ, 0 < η → ∃ h : ℂ → ℝ, Measurable h ∧
      ∃ B : ℝ, 0 ≤ B ∧ (∀ z, ‖h z‖ ≤ B) ∧
      (volume.restrict H).real
        {w | (∫ z, h z * Real.log ‖w - z‖ ∂(ν : Measure ℂ)) ≤ 1 / 2} < η)
    {ε : ℝ} (hε : 0 < ε) :
    ∃ μ : ProbabilityMeasure ℂ, (μ : Measure ℂ).support ⊆ (ν : Measure ℂ).support ∧
      ∃ a : ℝ, 0 < a ∧ (volume.restrict D).real
        {w | (∫ z, Real.log ‖w - z‖ ∂(μ : Measure ℂ)) ≤ a} < ε / 2 := by
  let : IsFiniteMeasure (volume.restrict D) :=
    isFiniteMeasure_restrict.mpr hD.measure_lt_top.ne
  let : IsFiniteMeasure (volume.restrict H) :=
    isFiniteMeasure_restrict.mpr hH.isBounded.measure_lt_top.ne
  let U : Lp ℝ 2 (volume.restrict D) := ∫ z, logKernel D hD z ∂(ν : Measure ℂ)
  have hUrep := coeFn_integral_logKernel_ambient D hD hmD ν hν
  have hUpos : ∀ᵐ w ∂((volume.restrict D).restrict Hᶜ), 0 < U w := by
    filter_upwards [ae_restrict_of_ae hUrep, ae_restrict_mem hH.isClosed.measurableSet.compl]
      with w hw hwH
    rw [show U w = _ from hw]
    exact hpositive w hwH
  obtain ⟨τ, hτ, hτbad⟩ := Erdos1040Margins.exists_positive_margin
    (Lp.aestronglyMeasurable U).aemeasurable.restrict hUpos
    (show 0 < ε / 8 by positivity)
  obtain ⟨h, hh, B, hBpos, hB, hAbad⟩ := hinner (ε / 8) (by positivity)
  have hi : Integrable h (ν : Measure ℂ) :=
    Integrable.of_bound hh.aestronglyMeasurable B (Eventually.of_forall hB)
  have hK := integrable_logKernel_ambient D hD hmD ν hν
  have hhK : Integrable (fun z => h z • logKernel D hD z) (ν : Measure ℂ) :=
    hK.bdd_smul B hh.aestronglyMeasurable (Eventually.of_forall hB)
  let V : Lp ℝ 2 (volume.restrict D) := ∫ z, h z • logKernel D hD z ∂(ν : Measure ℂ)
  let m : ℝ := ∫ z, h z ∂(ν : Measure ℂ)
  have he : 0 < (τ / 2) ^ 2 * (ε / 8) := by positivity
  obtain ⟨C, hC, hclose⟩ := Erdos1040PositiveDensity.exists_tilted_close h hi B hB
    (logKernel D hD) hK hhK (Real.sqrt_pos.mpr he)
  let μ := Erdos1040PositiveDensity.tilted h hi B C hB hC
  have hμν : (μ : Measure ℂ) ≪ (ν : Measure ℂ) :=
    withDensity_absolutelyContinuous _ _
  have hμsupport := hμν.support_mono
  have hμcompact : IsCompact (μ : Measure ℂ).support :=
    hν.of_isClosed_subset Measure.isClosed_support hμsupport
  let T : Lp ℝ 2 (volume.restrict D) := ∫ z, logKernel D hD z ∂(μ : Measure ℂ)
  have hclose' : ‖T - U‖ ^ 2 / (τ / 2) ^ 2 < ε / 8 := by
    have hs := Real.sq_sqrt he.le
    have hnorm : 0 ≤ ‖T - U‖ := norm_nonneg _
    have hlt : ‖T - U‖ ^ 2 < (τ / 2) ^ 2 * (ε / 8) := by
      change ‖T - U‖ < Real.sqrt ((τ / 2) ^ 2 * (ε / 8)) at hclose
      nlinarith
    exact (div_lt_iff₀ (by positivity)).mpr (by simpa only [mul_comm] using hlt)
  have hden : 0 < m + C := Erdos1040PositiveDensity.denominator_pos hB hC
  have hCpos : 0 < C := hBpos.trans_lt hC
  let a : ℝ := min (τ / 2) (1 / (2 * (m + C)))
  have ha : 0 < a := lt_min (by positivity) (by positivity)
  have haτ : a ≤ τ / 2 := min_le_left _ _
  have had : a ≤ 1 / (2 * (m + C)) := min_le_right _ _
  have hT : T = (m + C)⁻¹ • (V + C • U) :=
    Erdos1040PositiveDensity.integral_tilted h hi B C hB hC (logKernel D hD) hK hhK
  have hTformula : ∀ᵐ w ∂(volume.restrict D),
      T w = (m + C)⁻¹ * (V w + C * U w) := by
    filter_upwards [Lp.coeFn_smul (m + C)⁻¹ (V + C • U),
      Lp.coeFn_add V (C • U), Lp.coeFn_smul C U] with w h1 h2 h3
    rw [hT, h1]
    change (m + C)⁻¹ * (V + C • U) w = _
    rw [h2]
    change (m + C)⁻¹ * (V w + (C • U) w) = _
    rw [h3]
    rfl
  let A : Set ℂ := H ∩
    {w | (∫ z, h z * Real.log ‖w - z‖ ∂(ν : Measure ℂ)) ≤ 1 / 2}
  have hinner' : ∀ᵐ w ∂(volume.restrict D), w ∈ H → w ∉ A → a < T w := by
    filter_upwards [hTformula, coeFn_integral_smul_logKernel_ambient D hD hmD ν hν h hh hB,
      hUrep, ae_restrict_of_ae hnonneg] with w hTw hVw hUw hposw
    intro hwH hwA
    have hv : 1 / 2 < V w := by
      rw [show V w = _ from hVw]
      exact lt_of_not_ge (fun hv => hwA ⟨hwH, hv⟩)
    have hu : 0 ≤ U w := by rwa [show U w = _ from hUw]
    have hl : 1 / 2 < V w + C * U w := by nlinarith
    have hstep : 1 / (2 * (m + C)) < T w := by
      rw [hTw]
      have hmul := mul_lt_mul_of_pos_left hl (inv_pos.mpr hden)
      simpa only [one_div, mul_inv_rev] using hmul
    exact had.trans_lt hstep
  have hA : (volume.restrict D).real A < ε / 8 := by
    have hle : (volume.restrict D) A ≤ (volume.restrict H)
        {w | (∫ z, h z * Real.log ‖w - z‖ ∂(ν : Measure ℂ)) ≤ 1 / 2} := by
      rw [Measure.restrict_apply' hH.isClosed.measurableSet]
      simpa only [A, inter_comm] using Measure.restrict_apply_le D A
    exact (ENNReal.toReal_mono (measure_ne_top (volume.restrict H) _) hle).trans_lt hAbad
  have houter : (volume.restrict D).real (Hᶜ ∩ {w | U w ≤ τ}) < ε / 8 := by
    rw [measureReal_restrict_apply' hH.isClosed.measurableSet.compl] at hτbad
    simpa only [inter_comm] using hτbad
  have harea : (volume.restrict D).real {w | T w ≤ a} < ε / 2 := by
    have h := sublevel_measure_le (volume.restrict D) T U H A hτ haτ hinner'
    linarith
  refine ⟨μ, hμsupport, a, ha, ?_⟩
  have hrep := coeFn_integral_logKernel_ambient D hD hmD μ hμcompact
  have heq : {w | T w ≤ a} =ᵐ[volume.restrict D]
      {w | (∫ z, Real.log ‖w - z‖ ∂(μ : Measure ℂ)) ≤ a} := by
    filter_upwards [hrep] with w hw
    exact congrArg (fun r : ℝ => r ≤ a) hw
  rwa [← measureReal_congr heq]

/-- The full exact-root conclusion from the baseline and inner-density inputs.
The remaining analytic work is isolated in those explicit hypotheses. -/
theorem polynomialSublevelInfimum_eq_zero_of_baseline_and_inner
    {F : Set ℂ} (ν : ProbabilityMeasure ℂ)
    (hν : IsCompact (ν : Measure ℂ).support)
    (hνF : (ν : Measure ℂ).support ⊆ F) {R : ℝ}
    (hνR : (ν : Measure ℂ).support ⊆ closedBall (0 : ℂ) R)
    (H : Set ℂ) (hH : IsCompact H)
    (hnonneg : ∀ᵐ w ∂volume, 0 ≤ ∫ z, Real.log ‖w - z‖ ∂(ν : Measure ℂ))
    (hpositive : ∀ w ∈ Hᶜ, 0 < ∫ z, Real.log ‖w - z‖ ∂(ν : Measure ℂ))
    (hinner : ∀ η : ℝ, 0 < η → ∃ h : ℂ → ℝ, Measurable h ∧
      ∃ B : ℝ, 0 ≤ B ∧ (∀ z, ‖h z‖ ≤ B) ∧
      (volume.restrict H).real
        {w | (∫ z, h z * Real.log ‖w - z‖ ∂(ν : Measure ℂ)) ≤ 1 / 2} < η) :
    Erdos1040Foundation.polynomialSublevelInfimum F = 0 := by
  apply Erdos1040Closing.polynomialSublevelInfimum_eq_zero_of_ambient_positive_margins
    hν hνF hνR
  intro ε hε
  exact exists_positive_probability_margin (ball (0 : ℂ) (R + 1))
    isBounded_ball measurableSet_ball H hH ν hν hnonneg hpositive hinner hε

end Erdos1040OuterMargins
end
