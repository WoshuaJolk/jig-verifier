def witness_ok (j : Nat) (x d : Fin 31) : Prop :=
  witness j x.val d.val < 31 ∧
    if horizontal j then
      on j (witness j x.val d.val) d.val ∧
      on j ((witness j x.val d.val+31-x.val)%31) d.val
    else
      on j x.val (witness j x.val d.val) ∧
      on j x.val ((witness j x.val d.val+31-d.val)%31)

theorem base_relation_table : ∀ x d : Fin 31, relation x d ↔ on 0 x.val d.val := by
  unfold relation on
  decide

theorem all_step_certificates : ∀ j : Fin 7, ∀ x d : Fin 31,
    on (j.val+1) x.val d.val → witness_ok j.val x d := by
  unfold witness_ok on
  decide

theorem mask_sound : ∀ n : Nat, n ≤ 7 → ∀ x d : Fin 31,
    on n x.val d.val → stage n x d := by
  intro n
  induction n with
  | zero =>
    intro _ x d h
    exact (base_relation_table x d).mpr h
  | succ n ih =>
    intro hn x d h
    have hc := all_step_certificates ⟨n, by omega⟩ x d h
    unfold witness_ok at hc
    obtain ⟨hu, hp⟩ := hc
    let u : Fin 31 := ⟨witness n x.val d.val, hu⟩
    have prev := ih (by omega)
    change (if horizontal n then HD (stage n) else VD (stage n)) x d
    by_cases hh : horizontal n
    · rw [if_pos hh]
      rw [if_pos hh] at hp
      exact ⟨u, prev u d hp.1, prev (sub31 u x) d hp.2⟩
    · rw [if_neg hh]
      rw [if_neg hh] at hp
      exact ⟨u, prev x u hp.1, prev x (sub31 u d) hp.2⟩

theorem final_mask_full : ∀ x d : Fin 31, on 7 x.val d.val := by
  unfold on
  decide

theorem full_difference_closure : ∀ x d : Fin 31, stage 7 x d := by
  intro x d
  exact mask_sound 7 (by decide) x d (final_mask_full x d)

theorem no_four : ∀ x d : Fin 31, d.val ≠ 0 →
    ¬(inA x.val = true ∧ inA ((x.val+d.val)%31) = true ∧
      inA ((x.val+2*d.val)%31) = true ∧ inA ((x.val+3*d.val)%31) = true) := by
  decide

theorem solves :
(∀ x d : Fin 31, stage 7 x d) ∧
(∀ x d : Fin 31, d.val ≠ 0 →
    ¬(inA x.val = true ∧ inA ((x.val+d.val)%31) = true ∧
      inA ((x.val+2*d.val)%31) = true ∧ inA ((x.val+3*d.val)%31) = true)) := by
  exact ⟨@full_difference_closure, @no_four⟩

end Submissions.J4P26BilinearClosure.Proof

