theorem weighted_mem_hull {ι : Type*} [Fintype ι] [DecidableEq ι]
    (x : ι → Fin 3 → ℝ) (y : Fin 3 → ℝ) (w : ι → ℕ) (d : ℕ)
    (hd : 0 < d) (hs : ∑ j, w j = d)
    (he : ∀ i, ∑ j, (w j : ℝ) * x j i = (d : ℝ) * y i)
    (S : Set (Fin 3 → ℝ)) (hm : ∀ j, w j ≠ 0 → x j ∈ S) :
    y ∈ convexHull ℝ S := by
  let t : Finset ι := Finset.univ.filter (fun j => w j ≠ 0)
  have hs' : ∑ j ∈ t, (w j : ℝ) = (d : ℝ) := by
    simp only [t, Finset.sum_filter]
    have hsum : (∑ j, if w j ≠ 0 then (w j : ℝ) else 0) = ∑ j, (w j : ℝ) := by
      apply Finset.sum_congr rfl
      intro j hj
      by_cases h : w j = 0 <;> simp [h]
    rw [hsum]
    exact_mod_cast hs
  have hd' : (d : ℝ) ≠ 0 := by positivity
  have he' : (∑ j ∈ t, ((w j : ℝ) / d) • x j) = y := by
    ext i
    simp only [Finset.sum_apply, Pi.smul_apply, smul_eq_mul]
    calc
      ∑ j ∈ t, (w j : ℝ) / d * x j i =
          (∑ j ∈ t, (w j : ℝ) * x j i) / d := by
        rw [Finset.sum_div]
        apply Finset.sum_congr rfl
        intro j hj
        ring
      _ = (∑ j, (w j : ℝ) * x j i) / d := by
        congr 1
        simp only [t, Finset.sum_filter]
        apply Finset.sum_congr rfl
        intro j hj
        by_cases h : w j = 0 <;> simp [h]
      _ = y i := by rw [he]; field_simp
  rw [← he']
  apply (convex_convexHull ℝ S).sum_mem
  · intro j hj; positivity
  · rw [← Finset.sum_div, hs']; exact div_self hd'
  · intro j hj
    exact subset_convexHull ℝ S (hm j (Finset.mem_filter.mp hj).2)

theorem scaled_weighted_mem_hull {ι : Type*} [Fintype ι] [DecidableEq ι]
    (a : ι → Fin 3 → ℕ) (z : Fin 3 → ℕ) (s : Fin 3 → ℝ)
    (w : ι → ℕ) (d : ℕ) (hd : 0 < d) (hs : ∑ j, w j = d)
    (he : ∀ i, ∑ j, w j * 2 ^ a j i = d * 2 ^ z i)
    (S : Set (Fin 3 → ℝ))
    (hm : ∀ j, w j ≠ 0 → (fun i => s i * (2 : ℝ) ^ a j i) ∈ S) :
    (fun i => s i * (2 : ℝ) ^ z i) ∈ convexHull ℝ S := by
  apply weighted_mem_hull _ _ w d hd hs _ S hm
  intro i
  have h := congrArg (fun n : ℕ => (n : ℝ)) (he i)
  push_cast at h
  calc
    ∑ j, (w j : ℝ) * (s i * (2 : ℝ) ^ a j i) =
        s i * ∑ j, (w j : ℝ) * (2 : ℝ) ^ a j i := by
      rw [Finset.mul_sum]
      apply Finset.sum_congr rfl
      intro j hj
      ring
    _ = (d : ℝ) * (s i * (2 : ℝ) ^ z i) := by rw [h]; ring

def pointExp (m : Fin 3 → Fin 13) (j : Fin 5) (i : Fin 3) : ℕ :=
  24 + j.val * (m i).val - 6 * j.val

theorem normalized_point (m : Fin 13) (j : Fin 5) (p : ℝ) :
    p / (2 : ℝ)^24 * (2 : ℝ)^(24+j.val*m.val-6*j.val) =
      p * ((2 : ℝ)^((m.val : ℤ)-6))^j.val := by
  fin_cases m <;> fin_cases j <;> norm_num <;> ring

theorem pointExp_injective (m : Fin 3 → Fin 13) (hm : ∃ i, (m i).val ≠ 6) :
    Function.Injective (fun j : Fin 5 => fun i => pointExp m j i) := by
  obtain ⟨i, hi⟩ := hm
  intro j k h
  have he := congrFun h i
  have hj := j.isLt
  have hk := k.isLt
  have hmi := (m i).isLt
  change 24 + j.val * (m i).val - 6 * j.val =
    24 + k.val * (m i).val - 6 * k.val at he
  apply Fin.ext
  have hjbound : 6 * j.val ≤ 24 + j.val * (m i).val := by omega
  have hkbound : 6 * k.val ≤ 24 + k.val * (m i).val := by omega
  have he' : 24 + j.val * (m i).val + 6 * k.val =
      24 + k.val * (m i).val + 6 * j.val := by omega
  have he'' : (24 : ℤ) + j.val * (m i).val + 6 * k.val =
      24 + k.val * (m i).val + 6 * j.val := by exact_mod_cast he'
  have hd : (j.val : ℤ) * ((m i).val - 6 : ℤ) =
      (k.val : ℤ) * ((m i).val - 6 : ℤ) := by nlinarith
  have hne : ((m i).val - 6 : ℤ) ≠ 0 := by omega
  exact_mod_cast (mul_right_cancel₀ hne hd)

theorem scaled_point_injective (m : Fin 3 → Fin 13) (hm : ∃ i, (m i).val ≠ 6)
    (s : Fin 3 → ℝ) (hs : ∀ i, s i ≠ 0) :
    Function.Injective (fun j : Fin 5 => fun i => s i * (2 : ℝ)^pointExp m j i) := by
  intro j k h
  apply pointExp_injective m hm
  funext i
  have he := mul_left_cancel₀ (hs i) (congrFun h i)
  exact (pow_right_injective₀ (by norm_num : (0 : ℝ) < 2) (by norm_num)) he

theorem scaled_pow_mem_of_le (s : ℝ) (a z : ℕ) (haz : a ≤ z)
    (ha : ∃ k : ℕ, s * (2 : ℝ) ^ a = (2 : ℝ) ^ k) :
    ∃ k : ℕ, s * (2 : ℝ) ^ z = (2 : ℝ) ^ k := by
  obtain ⟨k, hk⟩ := ha
  refine ⟨k + (z - a), ?_⟩
  calc
    s * (2 : ℝ) ^ z = s * ((2 : ℝ) ^ a * 2 ^ (z - a)) := by
      rw [← pow_add, Nat.add_sub_of_le haz]
    _ = (s * (2 : ℝ) ^ a) * 2 ^ (z - a) := by ring
    _ = (2 : ℝ) ^ (k + (z - a)) := by rw [hk, pow_add]

theorem lattice_between (a b z : ℕ) (s : ℝ) (hz : min a b ≤ z)
    (ha : ∃ k : ℕ, s * (2 : ℝ) ^ a = (2 : ℝ) ^ k)
    (hb : ∃ k : ℕ, s * (2 : ℝ) ^ b = (2 : ℝ) ^ k) :
    ∃ k : ℕ, s * (2 : ℝ) ^ z = (2 : ℝ) ^ k := by
  rcases le_total a b with hab | hba
  · apply scaled_pow_mem_of_le s a z (by simpa [min_eq_left hab] using hz) ha
  · apply scaled_pow_mem_of_le s b z (by simpa [min_eq_right hba] using hz) hb

def expLattice (d : ℕ) (α : ℝ) : Set (Fin d → ℝ) :=
  {x | ∀ i, ∃ n : ℕ, x i = α ^ n}

def IsEmptyPolytope {d : ℕ} (S V : Set (Fin d → ℝ)) : Prop :=
  V.Finite ∧ V ⊆ S ∧
    (∀ v ∈ V, v ∉ convexHull ℝ (V \ {v})) ∧
    convexHull ℝ V ∩ S ⊆ V

def geoProg (k : ℕ) (p r : Fin 3 → ℝ) : Set (Fin 3 → ℝ) :=
  (fun n : ℕ => fun i => p i * r i ^ n) '' {n : ℕ | n < k}

theorem normalized_obstruction (m : Fin 3 → Fin 13) (hm : ∃ i, (m i).val ≠ 6)
    (s : Fin 3 → ℝ) (z : Fin 3 → ℕ) (w : Fin 5 → ℕ) (d : ℕ)
    (hd : 0 < d) (hs : ∑ j, w j = d)
    (hz : ∀ i, min 24 (4 * (m i).val) ≤ z i)
    (he : ∀ i, ∑ j, w j * 2 ^ pointExp m j i = d * 2 ^ z i)
    (hc : (∀ j : Fin 5, ∃ i : Fin 3, z i ≠ pointExp m j i) ∨
      ((∀ i, z i = pointExp m 1 i) ∧ w 1 = 0)) :
    ¬ IsEmptyPolytope (expLattice 3 2)
      (Set.range (fun j : Fin 5 => fun i => s i * (2 : ℝ)^pointExp m j i)) := by
  intro hp
  let x : Fin 5 → Fin 3 → ℝ := fun j i => s i * (2 : ℝ)^pointExp m j i
  let y : Fin 3 → ℝ := fun i => s i * (2 : ℝ)^z i
  have hxn : ∀ j, x j ∈ expLattice 3 2 := fun j => hp.2.1 ⟨j, rfl⟩
  have hs0 : ∀ i, s i ≠ 0 := by
    intro i hzero
    obtain ⟨n, hn⟩ := hxn 0 i
    simp only [x, hzero, zero_mul] at hn
    exact (pow_ne_zero n (by norm_num : (2 : ℝ) ≠ 0)) hn.symm
  have hyn : y ∈ expLattice 3 2 := by
    intro i
    apply lattice_between 24 (4 * (m i).val) (z i) (s i) (hz i)
    · simpa [x, pointExp] using hxn 0 i
    · have hv : pointExp m 4 i = 4 * (m i).val := by simp [pointExp]
      simpa only [x, hv] using hxn 4 i
  rcases hc with hhole | ⟨hvertex, hwzero⟩
  · have hyh : y ∈ convexHull ℝ (Set.range x) := by
      apply scaled_weighted_mem_hull _ z s w d hd hs he
      intro j hj
      exact ⟨j, rfl⟩
    obtain ⟨j, hj⟩ := hp.2.2.2 ⟨hyh, hyn⟩
    obtain ⟨i, hi⟩ := hhole j
    apply hi
    apply pow_right_injective₀ (by norm_num : (0 : ℝ) < 2) (by norm_num)
    exact (mul_left_cancel₀ (hs0 i) (congrFun hj i)).symm
  · have hyx : y = x 1 := by
      funext i
      exact congrArg (fun n : ℕ => s i * (2 : ℝ)^n) (hvertex i)
    have hyh : y ∈ convexHull ℝ (Set.range x \ {x 1}) := by
      apply scaled_weighted_mem_hull _ z s w d hd hs he
      intro j hj
      refine ⟨⟨j, rfl⟩, ?_⟩
      simp only [Set.mem_singleton_iff]
      intro heq
      have hji := scaled_point_injective m hm s hs0 heq
      exact hj (hji ▸ hwzero)
    exact hp.2.2.1 (x 1) ⟨1, rfl⟩ (hyx ▸ hyh)

theorem geoProg_eq_range (p r : Fin 3 → ℝ) :
    geoProg 5 p r = Set.range (fun j : Fin 5 => fun i => p i * r i ^ j.val) := by
  ext x
  constructor
  · rintro ⟨j, hj, rfl⟩
    exact ⟨⟨j, hj⟩, rfl⟩
  · rintro ⟨j, rfl⟩
    exact ⟨j.val, j.isLt, rfl⟩

theorem encoded_obstruction (p r : Fin 3 → ℝ)
    (m : Fin 3 → Fin 13) (hr : ∀ i, r i = (2 : ℝ)^((m i).val - 6 : ℤ))
    (hm : ∃ i, (m i).val ≠ 6)
    (z : Fin 3 → ℕ) (w : Fin 5 → ℕ) (d : ℕ)
    (hd : 0 < d) (hs : ∑ j, w j = d)
    (hz : ∀ i, min 24 (4 * (m i).val) ≤ z i)
    (he : ∀ i, ∑ j, w j * 2 ^ pointExp m j i = d * 2 ^ z i)
    (hc : (∀ j : Fin 5, ∃ i : Fin 3, z i ≠ pointExp m j i) ∨
      ((∀ i, z i = pointExp m 1 i) ∧ w 1 = 0)) :
    ¬ IsEmptyPolytope (expLattice 3 2) (geoProg 5 p r) := by
  have hset : geoProg 5 p r =
      Set.range (fun j : Fin 5 => fun i => (p i / (2 : ℝ)^24) *
        (2 : ℝ)^pointExp m j i) := by
    rw [geoProg_eq_range]
    congr 1
    funext j i
    rw [hr i]
    exact (normalized_point (m i) j (p i)).symm
  rw [hset]
  exact normalized_obstruction m hm _ z w d hd hs hz he hc

theorem encode_direction (r : Fin 3 → ℝ)
    (hr : ∀ i, ∃ m : ℤ, m.natAbs ≤ 6 ∧ r i = (2 : ℝ)^m)
    (hne : ∃ i, r i ≠ 1) :
    ∃ m : Fin 3 → Fin 13,
      (∀ i, r i = (2 : ℝ)^((m i).val - 6 : ℤ)) ∧
      (∃ i, (m i).val ≠ 6) := by
  choose m hm hr using hr
  have hbounds : ∀ i, -6 ≤ m i ∧ m i ≤ 6 := by
    intro i
    have hi := hm i
    omega
  let e : Fin 3 → Fin 13 := fun i => ⟨(m i + 6).toNat, by
    have hi := hbounds i
    omega⟩
  have he : ∀ i, ((e i).val : ℤ) - 6 = m i := by
    intro i
    have hi := hbounds i
    dsimp [e]
    omega
  refine ⟨e, ?_, ?_⟩
  · intro i
    rw [he i]
    exact hr i
  · obtain ⟨i, hi⟩ := hne
    refine ⟨i, ?_⟩
    intro hh
    apply hi
    rw [hr i, ← he i, hh]
    norm_num

end BatchTwoGeoBridge

open BatchTwoGeoBridge
theorem proof :
  ∀ p r : Fin 3 → ℝ,
    (∀ i, ∃ m : ℤ, m.natAbs ≤ 6 ∧ r i = (2 : ℝ) ^ m) →
    (∃ i, r i ≠ 1) →
    ¬ IsEmptyPolytope (expLattice 3 2) (geoProg 5 p r) := by
  intro p r hr hne
  obtain ⟨m, hm, hmn⟩ := encode_direction r hr hne
  let c := GeoCertData.lookup m
  have hg : GeoCertData.Good m c := GeoCertData.allGood m
  obtain ⟨hd, hs, he, hx⟩ := hg
  apply encoded_obstruction p r m hm hmn c.z c.w c.d hd hs
  · intro i
    exact (he i).1
  · intro i
    exact (he i).2.2
  · by_cases hh : c.hole = true
    · left
      simpa only [hh, Bool.false_eq_true, ↓reduceIte, GeoCertData.pointExp, pointExp] using hx
    · right
      simpa only [hh, Bool.false_eq_true, ↓reduceIte, GeoCertData.pointExp, pointExp] using hx
end Submissions.ExpLatticeGeoProgAtMost4.BatchTwoGeoProg

