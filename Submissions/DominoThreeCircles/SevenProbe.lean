/-!
Optimality of the Packomania (Eckard Specht) packing of seven equal circles in `[0,1] × [0,1/2]`,
radius `r* = 1/(4 + √6 + √2) = 1/(4(1 + cos 15°))`.

Normalise by the diameter `2r`: centres become points with pairwise distance `≥ 1` in
`[0, A] × [0, B]`, `A = 1/(2r) - 1`, `B = 1/(4r) - 1 = (A - 1)/2`. If `r > r*` then
`B < c := cos 15°` and `A < 1 + 2c`. Sort the points by `x` (`Tuple.sort`). Two sorted points
with heights differing by at most `t` are at least `√(1 - t²)` apart horizontally, so chains of
such gaps bound the width from below. `core` shows by an exact case split on the seven heights
(262 boxes closed by rational chain bounds, 4 boxes at the copies of Specht's arrangement
closed by `cornerP`) that the width is always `≥ 1 + 2c`, a contradiction.
-/

namespace Submissions.DominoThreeCircles.SevenProbe

/-- From `g ≥ 0` and `g² + dy² ≥ 1`, any `l` with `l² + dy² ≤ 1` is a lower bound for `g`. -/
theorem gapL (g dy l : ℝ) (h : 1 ≤ g ^ 2 + dy ^ 2) (hg : 0 ≤ g) (hl : l ^ 2 + dy ^ 2 ≤ 1) :
    l ≤ g := by
  by_contra hc
  have hlt := not_le.mp hc
  nlinarith [mul_lt_mul'' hlt hlt hg hg]

/-- Horizontal gap between two sorted unit-separated points whose height difference is at most
`t`: at least any `q ≥ 0` with `q² + t² ≤ 1`. -/
theorem gapB (xi xj yi yj q t : ℝ) (h : 1 ≤ (xj - xi) ^ 2 + (yj - yi) ^ 2) (hord : xi ≤ xj)
    (h1 : yj - yi ≤ t) (h2 : yi - yj ≤ t) (hq : q ^ 2 + t ^ 2 ≤ 1) (hq0 : 0 ≤ q) :
    q ≤ xj - xi := by
  have hdy : (yj - yi) ^ 2 ≤ t ^ 2 := by
    nlinarith [mul_nonneg (by linarith : (0:ℝ) ≤ t - (yj - yi))
      (by linarith : (0:ℝ) ≤ t + (yj - yi))]
  exact gapL (xj - xi) (yj - yi) q h (by linarith) (by linarith)

/-- The local lemma at Specht's configuration: sorted heights near
`(0, c, 0, c, s, c, 0)` (with `c = cos 15°`, `s = sin 15°`) force total width `≥ 1 + 2c`. -/
theorem cornerP (s c : ℝ) (hsc1 : s ^ 2 + c ^ 2 = 1) (hsc2 : s * c = 1 / 4)
    (hsl : (258819 / 1000000 : ℝ) ≤ s) (hsh : s ≤ (25882 / 100000 : ℝ))
    (hcl : (965925 / 1000000 : ℝ) ≤ c) (hcu : c ≤ (965926 / 1000000 : ℝ))
    (x0 x1 x2 x3 x4 x5 x6 y0 y1 y2 y3 y4 y5 y6 : ℝ)
    (m01 : x0 ≤ x1) (m12 : x1 ≤ x2) (m23 : x2 ≤ x3) (m34 : x3 ≤ x4) (m45 : x4 ≤ x5) (m56 : x5 ≤ x6)
    (h01 : 1 ≤ (x1 - x0) ^ 2 + (y1 - y0) ^ 2) (h02 : 1 ≤ (x2 - x0) ^ 2 + (y2 - y0) ^ 2)
    (h13 : 1 ≤ (x3 - x1) ^ 2 + (y3 - y1) ^ 2) (h24 : 1 ≤ (x4 - x2) ^ 2 + (y4 - y2) ^ 2)
    (h34 : 1 ≤ (x4 - x3) ^ 2 + (y4 - y3) ^ 2) (h46 : 1 ≤ (x6 - x4) ^ 2 + (y6 - y4) ^ 2)
    (b0l : 0 ≤ y0) (b0u : y0 ≤ 1 / 25) (b1l : c - 1 / 25 ≤ y1) (b1u : y1 ≤ c)
    (b2l : 0 ≤ y2) (b2u : y2 ≤ 1 / 25) (b3l : c - 1 / 25 ≤ y3) (b3u : y3 ≤ c)
    (b4l : s - 1 / 25 ≤ y4) (b4u : y4 ≤ s + 1 / 25) (b6l : 0 ≤ y6) (b6u : y6 ≤ 1 / 25) :
    1 + 2 * c ≤ x6 - x0 := by
  have hh : (c - s) ^ 2 = 1 / 2 := by nlinarith
  have hh0 : (7 / 10 : ℝ) ≤ c - s := by linarith
  have G01 : s + 2 * ((c - y1) + y0) ≤ x1 - x0 := by
    apply gapL (x1 - x0) (y1 - y0) _ h01 (by linarith)
    nlinarith [mul_nonneg (by linarith : (0:ℝ) ≤ (c - y1) + y0)
      (by linarith : (0:ℝ) ≤ 2 * c - 4 * s - 5 * ((c - y1) + y0))]
  have G13 : 1 - (1 / 20) * ((c - y1) + (c - y3)) ≤ x3 - x1 := by
    apply gapL (x3 - x1) (y3 - y1) _ h13 (by linarith)
    nlinarith [mul_nonneg (by linarith : (0:ℝ) ≤ c - y1) (by linarith : (0:ℝ) ≤ 1 / 25 - (c - y1)),
      mul_nonneg (by linarith : (0:ℝ) ≤ c - y3) (by linarith : (0:ℝ) ≤ 1 / 25 - (c - y3)),
      mul_nonneg (by linarith : (0:ℝ) ≤ c - y1) (by linarith : (0:ℝ) ≤ c - y3)]
  rcases le_total s y4 with hw | hw
  · have G34 : (c - s) + (1 / 2) * ((c - y3) + (y4 - s)) ≤ x4 - x3 := by
      apply gapL (x4 - x3) (y4 - y3) _ h34 (by linarith)
      nlinarith [mul_nonneg (by linarith : (0:ℝ) ≤ (c - y3) + (y4 - s))
        (by linarith : (0:ℝ) ≤ (c - s) - (5 / 4) * ((c - y3) + (y4 - s)))]
    have G46 : c - (3 / 10) * (y4 - s) ≤ x6 - x4 := by
      apply gapL (x6 - x4) (y6 - y4) _ h46 (by linarith)
      nlinarith [mul_nonneg (by linarith : (0:ℝ) ≤ y4 - s)
        (by linarith : (0:ℝ) ≤ (6 / 10) * c - 2 * s - (109 / 100) * (y4 - s)),
        mul_nonneg b6l (by linarith : (0:ℝ) ≤ 2 * y4 - y6)]
    linarith
  · have G02 : 1 - (1 / 20) * (y0 + y2) ≤ x2 - x0 := by
      apply gapL (x2 - x0) (y2 - y0) _ h02 (by linarith)
      nlinarith [mul_nonneg b0l (by linarith : (0:ℝ) ≤ 1 / 25 - y0),
        mul_nonneg b2l (by linarith : (0:ℝ) ≤ 1 / 25 - y2), mul_nonneg b0l b2l]
    have G24 : c + (1 / 5) * ((s - y4) + y2) ≤ x4 - x2 := by
      apply gapL (x4 - x2) (y4 - y2) _ h24 (by linarith)
      nlinarith [mul_nonneg (by linarith : (0:ℝ) ≤ (s - y4) + y2)
        (by linarith : (0:ℝ) ≤ 2 * s - (4 / 10) * c - (104 / 100) * ((s - y4) + y2))]
    have G46 : c + (1 / 5) * ((s - y4) + y6) ≤ x6 - x4 := by
      apply gapL (x6 - x4) (y6 - y4) _ h46 (by linarith)
      nlinarith [mul_nonneg (by linarith : (0:ℝ) ≤ (s - y4) + y6)
        (by linarith : (0:ℝ) ≤ 2 * s - (4 / 10) * c - (104 / 100) * ((s - y4) + y6))]
    have G34 : (c - s) - (3 / 2) * (s - y4) + (1 / 2) * (c - y3) ≤ x4 - x3 := by
      apply gapL (x4 - x3) (y4 - y3) _ h34 (by linarith)
      nlinarith [mul_nonneg (by linarith : (0:ℝ) ≤ s - y4) (by linarith : (0:ℝ) ≤ 1 / 25 - (s - y4)),
        mul_nonneg (by linarith : (0:ℝ) ≤ c - y3) (by linarith : (0:ℝ) ≤ 1 / 25 - (c - y3)),
        mul_nonneg (by linarith : (0:ℝ) ≤ s - y4) (by linarith : (0:ℝ) ≤ c - y3),
        mul_nonneg (by linarith : (0:ℝ) ≤ (c - s) - 7 / 10) (by linarith : (0:ℝ) ≤ s - y4),
        mul_nonneg (by linarith : (0:ℝ) ≤ (c - s) - 7 / 10) (by linarith : (0:ℝ) ≤ c - y3)]
    linarith

