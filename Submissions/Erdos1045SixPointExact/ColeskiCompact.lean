theorem proof : IsGreatest ((fun z : Fin 6 → ℂ => ∏ i : Fin 6, ∏ j ∈ Finset.univ.filter (fun j : Fin 6 => i < j), ‖z i-z j‖^2) '' {z : Fin 6 → ℂ | ∀i j, ‖z i-z j‖≤2}) (64*(2*Real.sqrt 3-2)^18) := by
 apply Erdos1045N6.IsGreatest_of_three_ordered_covers
 · intro t ht hz;exact TreeOrderedArms311.complete_half_cover t (Erdos1045N6.negativeCertificateBox_mem t ht hz)
