def compactLeaf(c:Nat)(p:Option (Nat × Int))(b:Box 4):Bool:=if c=4 then JigCompact.fastLeafCheck scale threshold distances b else if c=5 then orderedReject isPath b else if c=6 then fastTaylorCheck scale threshold expressions b p else false
theorem compactLeaf_sound(c p b)(h:compactLeaf c p b=true):∀x,b.Mem scale x→Good x:=by
 simp only[compactLeaf]at h
 split at h
 · exact JigCompact.fastOrderedNaturalGood (by norm_num[scale]) expressions isPath b h
 split at h
 · exact ordered_good b h
 split at h
 · exact taylor_good b p h
 · simp at h
