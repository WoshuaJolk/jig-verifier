 fun x hx _=>fastMixedNaturalGood hs es mono box h x hx
structure CBox where
 x0:Interval
 x1:Interval
 x2:Interval
 x3:Interval
 deriving DecidableEq
def CBox.toBox(b:CBox):Box 4:=![b.x0,b.x1,b.x2,b.x3]
def CBox.left(b:CBox):Nat→CBox
|0=>{b with x0:=⟨b.x0.lo,(b.x0.lo+b.x0.hi)/2⟩}
|1=>{b with x1:=⟨b.x1.lo,(b.x1.lo+b.x1.hi)/2⟩}
|2=>{b with x2:=⟨b.x2.lo,(b.x2.lo+b.x2.hi)/2⟩}
|_=>{b with x3:=⟨b.x3.lo,(b.x3.lo+b.x3.hi)/2⟩}
def CBox.right(b:CBox):Nat→CBox
|0=>{b with x0:=⟨(b.x0.lo+b.x0.hi)/2,b.x0.hi⟩}
|1=>{b with x1:=⟨(b.x1.lo+b.x1.hi)/2,b.x1.hi⟩}
|2=>{b with x2:=⟨(b.x2.lo+b.x2.hi)/2,b.x2.hi⟩}
|_=>{b with x3:=⟨(b.x3.lo+b.x3.hi)/2,b.x3.hi⟩}
theorem CBox.left_toBox(b:CBox)(i:Fin 4):(b.left i.val).toBox=b.toBox.left i:=by
 funext j;fin_cases i<;>fin_cases j<;>rfl
theorem CBox.right_toBox(b:CBox)(i:Fin 4):(b.right i.val).toBox=b.toBox.right i:=by
 funext j;fin_cases i<;>fin_cases j<;>rfl
theorem CBox.split_covers {S:ℤ}{b:CBox}{x:Fin 4→ℝ}(hx:b.toBox.Mem S x)(i:Nat)(hi:i<4):
 (b.left i).toBox.Mem S x∨(b.right i).toBox.Mem S x:=by
 have hl:(b.left i).toBox=b.toBox.left (⟨i,hi⟩:Fin 4):=CBox.left_toBox b ⟨i,hi⟩
 have hr:(b.right i).toBox=b.toBox.right (⟨i,hi⟩:Fin 4):=CBox.right_toBox b ⟨i,hi⟩
 rw[hl,hr];exact b.toBox.split_covers hx ⟨i,hi⟩
structure Reader where
 data : String
 pos : String.Pos.Raw := 0
 buf : Nat := 0
 count : Nat := 0
 last : Int := 0
 deriving DecidableEq
def word (c : Char) : Nat := if c.toNat ≥ 0xe000 then c.toNat-0x900 else c.toNat-0x100
def Reader.ofString (s : String) : Reader := ⟨s,0,0,0,0⟩
def bit : Reader → Option (Nat × Reader)
| ⟨s,p,_,0,l⟩ => match s.get? p with
  | none => none
  | some c => let w:=word c;some (w%2,⟨s,s.next p,w/2,14,l⟩)
| ⟨s,p,b,n+1,l⟩ => some (b%2,⟨s,p,b/2,n,l⟩)
def bits : Nat → Reader → Option (Nat × Reader)
| 0,r => some (0,r)
| n+1,r => do let (a,r) ← bit r;let (b,r) ← bits n r;some (a+2*b,r)
def vint : Nat → Nat → Nat → Reader → Option (Nat × Reader)
| 0,_,_,_ => none
| fuel+1,shift,acc,r => do
  let (b,r) ← bits 8 r
  let acc:=acc+(b%128)*2^shift
  if b<128 then some (acc,r) else vint fuel (shift+7) acc r
def event (r : Reader) : Option (Nat × Option (Nat × Int) × Reader) := do
  let (c,r) ← bits 3 r
  if c=6 then
    let (k,r) ← bits 4 r
    let (z,r) ← vint 5 0 0 r
    let d : Int := if z%2=0 then Int.ofNat (z/2) else -Int.ofNat (z/2)-1
    let l:=r.last+d
    some (c,(if k=0 then none else some (k-1,l*100)),{r with last:=l})
  else some (c,none,r)
def scan (leaf : Nat → Option (Nat × Int) → Box 4 → Bool) : Nat → Reader → List CBox → Option Reader
| _,r,[] => some r
| 0,_,_::_ => none
| fuel+1,r,b::bs => do
  let (c,p,r) ← event r
  if h:c<4 then
    scan leaf fuel r (b.left c::b.right c::bs)
  else if leaf c p b.toBox then scan leaf fuel r bs else none
theorem scan_sound {S:ℤ}(leaf : Nat → Option (Nat × Int) → Box 4 → Bool)(P:(Fin 4→ℝ)→Prop)
 (hl:∀c p b,leaf c p b=true→∀x,b.Mem S x→P x):∀fuel r bs rest,scan leaf fuel r bs=some rest→∀b∈bs,∀x,b.toBox.Mem S x→P x:=by
 intro fuel;induction fuel with
 | zero=>intro r bs rest h;cases bs<;>simp[scan]at h⊢
 | succ fuel ih=>
  intro r bs rest h b' hb' x hx
  cases bs with
  | nil=>simp at hb'
  | cons b bs=>
   cases he:event r with
   | none=>simp[scan,he]at h
   | some e=>
    rcases e with ⟨c,p,r⟩
    simp only[scan,he,Option.bind_eq_bind,Option.bind_some]at h
    split at h
    next hc=>
     have hs:=ih r (b.left c::b.right c::bs) rest h
     simp only[List.mem_cons]at hb'
     rcases hb' with rfl|hb'
     · rcases b'.split_covers hx c hc with hx|hx
       · exact hs (b'.left c) (by simp) x hx
       · exact hs (b'.right c) (by simp) x hx
     · exact hs b' (by simp[hb']) x hx
    next=>
     split at h
     next ho=>
      simp only[List.mem_cons]at hb'
      rcases hb' with rfl|hb'
      · exact hl c p b'.toBox ho x hx
      · exact ih r bs rest h b' hb' x hx
     next=>simp at h
theorem scan_some_sound {S:ℤ}(leaf:Nat→Option (Nat × Int)→Box 4→Bool)(P:(Fin 4→ℝ)→Prop)
 (hl:∀c p b,leaf c p b=true→∀x,b.Mem S x→P x)
 (fuel:Nat)(r:Reader)(b:CBox)(h:(scan leaf fuel r [b]).isSome=true):∀x,b.toBox.Mem S x→P x:=by
 cases he:scan leaf fuel r [b] with
 | none=>simp[he]at h
 | some q=>exact scan_sound leaf P hl fuel r [b] q he b (by simp)
