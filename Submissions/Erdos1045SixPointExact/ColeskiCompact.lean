    Function.Injective z := by
  intro i j heq
  by_contra hij
  rcases lt_or_gt_of_ne hij with hlt | hgt
  · have hzero := discriminant_eq_zero_of_eq z hlt heq
    linarith
  · have hzero := discriminant_eq_zero_of_eq z hgt heq.symm
    linarith
