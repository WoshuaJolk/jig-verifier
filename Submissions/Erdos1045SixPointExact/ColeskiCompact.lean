theorem star_tree_bound (t : Fin 4 → ℝ) (ht : treeInitialBox t)
    (ha : admissible (treePoints 0 t)) :
    discriminant (treePoints 0 t) ≤ candidateValue := by
  apply tree_bound_of_0_good t ha
  apply TreeCertStar.complete_cover
