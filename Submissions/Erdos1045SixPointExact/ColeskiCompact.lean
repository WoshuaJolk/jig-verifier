  unfold R
  exact div_mul_cancel₀ 2 (ne_of_gt (lt_trans (by norm_num) sqrt_three_bounds.1))
theorem radius_square : R ^ 2 = 4 / 3 := by
  unfold R
  rw [div_pow, Real.sq_sqrt (by norm_num : (0 : ℝ) ≤ 3)]
