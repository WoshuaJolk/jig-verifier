def compactLeaf(c:Nat)(p:Option (Nat × Int))(b:Box 4):Bool:=if c=4 then JigCompact.fastLeafCheck scale threshold distances b else if c=5 then arms221OrderedReject b else if c=6 then fastTaylorCheck scale threshold expressions b p else if c=7 then monoCheck mono b else false
theorem compactLeaf_sound(c p b)(h:compactLeaf c p b=true):∀x,b.Mem scale x→Good x:=by
 simp only[compactLeaf]at h
 split at h
 · exact JigCompact.fastArms221NaturalGood (by norm_num[scale]) expressions mono b h
 split at h
 · exact ordered_good b h
