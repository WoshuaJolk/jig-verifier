  ![![0,2,2*a,2*b,2*c,2*d],
    ![0,2,2*a,2*b,2*c,2-2*d],
    ![0,2,2*a,2*b,2-2*c,2-2*d],
    ![0,2,2-2*a,2-2*a+2*a*b,2*c,2*d],
    ![0,2,2-2*a,2*b,2*b*(1-c),2*d],
