      ‖(ComplexNodalQuotient.nodal nodes).eval (x : ℂ)‖ :=
  MultipoleInterpolationAlgebra.norm_quotient_real_le z hz H u p nodes Q hfactor x M
    (d.mask_bounds x hx).1 (d.mask_bounds x hx).2 (d.old_bound x hx) hp hW

