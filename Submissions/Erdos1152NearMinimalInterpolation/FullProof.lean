/-- The strict absolute-value tail of a real function. -/
def absTail (f : α → ℝ) (R : ℝ) : Set α :=
  {x | R < |f x|}

/-- One cutoff is chosen before an eventual row bound for each measure tolerance.
This definition uses actual tail measures, not a compactness or selection axiom. -/
def EventuallyUpperTight (μ : Measure α) (u : ℕ → α → ℝ) : Prop :=
  ∀ δ : ℝ≥0∞, 0 < δ → ∃ R : ℝ, 0 < R ∧
    ∀ᶠ n in atTop, μ (absTail (u n) R) ≤ δ

