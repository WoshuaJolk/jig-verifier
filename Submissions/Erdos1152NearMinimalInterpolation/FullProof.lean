/-- A sufficiently positive center slope yields the needed slope on the entire neighborhood. -/
theorem lower_slope_of_center (t : ι → ℝ) (c h B : ℝ) (n : ℕ) (x : ℝ)
    (hh : 0 < h) (hgap : ∀ i, 4 * h ≤ |c - t i|)
    (hdensity : ∀ r : ℝ, 0 < r →
      ((Finset.univ.filter (fun i => |c - t i| ≤ r)).card : ℝ) ≤
        2 * B * (n : ℝ) * r)
