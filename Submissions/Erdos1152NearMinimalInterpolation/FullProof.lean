    (havoid : ∀ c ∈ centers, ∀ i, 4 * h ≤ |c - nodes i|) :
    volume (badCells nodes centers B h) ≤ ENNReal.ofReal (6 / B) := by
  have hnreal : (0 : ℝ) < Fintype.card ι := by exact_mod_cast hn
