the number of original indices. The witness radius is part of the definition. -/
def badCenter (nodes : ι → ℝ) (B c : ℝ) : Prop :=
  ∃ r : ℝ, 0 < r ∧ 2 * B * (Fintype.card ι : ℝ) * r < (count nodes c r : ℝ)

