/-!
# Stability of the complete indexed nodal logarithmic derivative

Every original index remains in the polynomial and reciprocal sums; no
injectivity of node values is assumed. The interval slope and root avoidance
are derived from the exclusion radius, full indexed density, and center slope.
-/

open Set Polynomial
open scoped BigOperators

noncomputable section

namespace Jig133.NodalSlopeStability

attribute [local instance] Classical.propDecidable

/-- The actual logarithmic derivative of the full indexed nodal polynomial. -/
theorem nodal_log_derivative {ι : Type*} (s : Finset ι) (t : ι → ℝ)
    (x : ℝ) (hx : ∀ i ∈ s, x ≠ t i) :
    (Lagrange.nodal s t).derivative.eval x / (Lagrange.nodal s t).eval x =
      ∑ i ∈ s, 1 / (x - t i) := by
  classical
  have hW : (Lagrange.nodal s t).eval x ≠ 0 :=
    Lagrange.eval_nodal_not_at_node hx
  rw [Lagrange.derivative_nodal, Polynomial.eval_finsetSum, Finset.sum_div]
  apply Finset.sum_congr rfl
  intro i hi
  have hfactor : (Lagrange.nodal s t).eval x =
      (x - t i) * (Lagrange.nodal (s.erase i) t).eval x := by
    rw [Lagrange.nodal_eq_mul_nodal_erase hi]
    simp only [Polynomial.eval_mul, Polynomial.eval_sub, Polynomial.eval_X, Polynomial.eval_C]
  apply (div_eq_div_iff hW (sub_ne_zero.mpr (hx i hi))).mpr
  simpa only [one_mul, mul_comm] using hfactor.symm

variable {ι : Type*} [Fintype ι]

/-- The reciprocal sum includes every original index with its multiplicity. -/
def slope (t : ι → ℝ) (x : ℝ) : ℝ := ∑ i, 1 / (x - t i)

omit [Fintype ι] in
/-- A point within 2h stays at least 2h from each node and loses at most a
factor two in its distance to the center's nodes. -/
theorem denominator_comparison (t : ι → ℝ) (c h x : ℝ)
    (hgap : ∀ i, 4 * h ≤ |c - t i|) (hx : |x - c| ≤ 2 * h) (i : ι) :
    2 * h ≤ |x - t i| ∧ |c - t i| ≤ 2 * |x - t i| := by
  have htriangle := abs_sub_le c x (t i)
  rw [abs_sub_comm c x] at htriangle
  constructor <;> linarith [hgap i]

omit [Fintype ι] in
/-- Root avoidance throughout the actual closed neighborhood follows from the gaps. -/
theorem root_avoidance (t : ι → ℝ) (c h x : ℝ) (hh : 0 < h)
    (hgap : ∀ i, 4 * h ≤ |c - t i|) (hx : |x - c| ≤ 2 * h) :
    ∀ i, x ≠ t i := by
  intro i
  have hd := (denominator_comparison t c h x hgap hx i).1
  exact sub_ne_zero.mp (abs_pos.mp (lt_of_lt_of_le (by linarith : 0 < 2 * h) hd))

theorem nodal_eval_ne_zero (t : ι → ℝ) (c h x : ℝ) (hh : 0 < h)
    (hgap : ∀ i, 4 * h ≤ |c - t i|) (hx : |x - c| ≤ 2 * h) :
    (Lagrange.nodal Finset.univ t).eval x ≠ 0 :=
  Lagrange.eval_nodal_not_at_node (fun i _ => root_avoidance t c h x hh hgap hx i)

omit [Fintype ι] in
private theorem reciprocal_change_le (t : ι → ℝ) (c h x : ℝ) (hh : 0 < h)
    (hgap : ∀ i, 4 * h ≤ |c - t i|) (hx : |x - c| ≤ 2 * h) (i : ι) :
    |1 / (x - t i) - 1 / (c - t i)| ≤
      2 * |x - c| * (1 / (c - t i) ^ 2) := by
  have hxc := root_avoidance t c h x hh hgap hx i
  have hc : c ≠ t i := by
    have hd : 0 < |c - t i| := lt_of_lt_of_le (by linarith : 0 < 4 * h) (hgap i)
    exact sub_ne_zero.mp (abs_pos.mp hd)
  have hdx : 0 < |x - t i| := abs_pos.mpr (sub_ne_zero.mpr hxc)
  have hdc : 0 < |c - t i| := abs_pos.mpr (sub_ne_zero.mpr hc)
  have heq : 1 / (x - t i) - 1 / (c - t i) =
      (c - x) / ((x - t i) * (c - t i)) := by
    field_simp [sub_ne_zero.mpr hxc, sub_ne_zero.mpr hc]
    ring
  have hcomp := (denominator_comparison t c h x hgap hx i).2
  have hmul := mul_le_mul_of_nonneg_left
    (mul_le_mul_of_nonneg_right hcomp hdc.le) (abs_nonneg (x - c))
  calc
    _ = |x - c| / (|x - t i| * |c - t i|) := by
      rw [heq, abs_div, abs_mul, abs_sub_comm c x]
    _ ≤ (2 * |x - c|) / |c - t i| ^ 2 := by
      apply (div_le_div_iff₀ (mul_pos hdx hdc) (sq_pos_of_pos hdc)).mpr
      nlinarith
    _ = 2 * |x - c| * (1 / (c - t i) ^ 2) := by
      rw [sq_abs]
      ring

/-- Actual finite-sum stability, before applying any density estimate. -/
theorem slope_change_le_sum (t : ι → ℝ) (c h x : ℝ) (hh : 0 < h)
    (hgap : ∀ i, 4 * h ≤ |c - t i|) (hx : |x - c| ≤ 2 * h) :
    |slope t x - slope t c| ≤
      2 * |x - c| * ∑ i, 1 / (c - t i) ^ 2 := by
  unfold slope
  rw [← Finset.sum_sub_distrib]
  calc
    _ ≤ ∑ i, |1 / (x - t i) - 1 / (c - t i)| :=
      Finset.abs_sum_le_sum_abs _ _
    _ ≤ ∑ i, 2 * |x - c| * (1 / (c - t i) ^ 2) :=
      Finset.sum_le_sum (fun i _ => reciprocal_change_le t c h x hh hgap hx i)
    _ = 2 * |x - c| * ∑ i, 1 / (c - t i) ^ 2 := by rw [Finset.mul_sum]

private theorem density_scale_nonneg (t : ι → ℝ) (c B : ℝ) (n : ℕ)
    (hdensity : ∀ r : ℝ, 0 < r →
      ((Finset.univ.filter (fun i => |c - t i| ≤ r)).card : ℝ) ≤
        2 * B * (n : ℝ) * r) : 0 ≤ B * (n : ℝ) := by
  have hd := hdensity 1 zero_lt_one
  have hn : 0 ≤ ((Finset.univ.filter (fun i => |c - t i| ≤ 1)).card : ℝ) :=
    Nat.cast_nonneg _
  nlinarith

/-- Full indexed all-radius density supplies a uniform change bound throughout 2h. -/
theorem slope_stability (t : ι → ℝ) (c h B : ℝ) (n : ℕ) (x : ℝ) (hh : 0 < h)
    (hgap : ∀ i, 4 * h ≤ |c - t i|)
    (hdensity : ∀ r : ℝ, 0 < r →
      ((Finset.univ.filter (fun i => |c - t i| ≤ r)).card : ℝ) ≤
        2 * B * (n : ℝ) * r)
    (hx : |x - c| ≤ 2 * h) :
    |slope t x - slope t c| ≤ 8 * B * (n : ℝ) := by
  have hscale := density_scale_nonneg t c B n hdensity
  have hinv := DensityInverseSquare.roots_sum_inv_sq_le t c h B n hh hgap hdensity
  have hbound : 0 ≤ 2 * B * (n : ℝ) / h :=
    div_nonneg (by nlinarith [hscale]) hh.le
  calc
    _ ≤ 2 * |x - c| * ∑ i, 1 / (c - t i) ^ 2 :=
      slope_change_le_sum t c h x hh hgap hx
    _ ≤ 2 * |x - c| * (2 * B * (n : ℝ) / h) :=
      mul_le_mul_of_nonneg_left hinv (by positivity)
    _ ≤ (2 * (2 * h)) * (2 * B * (n : ℝ) / h) :=
      mul_le_mul_of_nonneg_right (mul_le_mul_of_nonneg_left hx (by norm_num)) hbound
    _ = 8 * B * (n : ℝ) := by
      field_simp [ne_of_gt hh]
      ring

/-- The same stability bound for the actual full polynomial logarithmic derivative. -/
theorem log_derivative_stability (t : ι → ℝ) (c h B : ℝ) (n : ℕ) (x : ℝ)
    (hh : 0 < h) (hgap : ∀ i, 4 * h ≤ |c - t i|)
    (hdensity : ∀ r : ℝ, 0 < r →
      ((Finset.univ.filter (fun i => |c - t i| ≤ r)).card : ℝ) ≤
        2 * B * (n : ℝ) * r)
    (hx : |x - c| ≤ 2 * h) :
    |(Lagrange.nodal Finset.univ t).derivative.eval x /
        (Lagrange.nodal Finset.univ t).eval x -
      (Lagrange.nodal Finset.univ t).derivative.eval c /
        (Lagrange.nodal Finset.univ t).eval c| ≤ 8 * B * (n : ℝ) := by
  have hc : |c - c| ≤ 2 * h := by
    simp only [sub_self, abs_zero]
    linarith
  rw [nodal_log_derivative Finset.univ t x
      (fun i _ => root_avoidance t c h x hh hgap hx i),
    nodal_log_derivative Finset.univ t c
      (fun i _ => root_avoidance t c h c hh hgap hc i)]
