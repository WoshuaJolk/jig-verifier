    16 * B * (n : ℝ) ≤ slope t x := by
  have hd := (abs_le.mp (slope_stability t c h B n x hh hgap hdensity hx)).1
  linarith

/-- The analogous negative center slope yields the upper negative slope. -/
theorem upper_slope_of_center (t : ι → ℝ) (c h B : ℝ) (n : ℕ) (x : ℝ)
    (hh : 0 < h) (hgap : ∀ i, 4 * h ≤ |c - t i|)
    (hdensity : ∀ r : ℝ, 0 < r →
      ((Finset.univ.filter (fun i => |c - t i| ≤ r)).card : ℝ) ≤
