The mask, extension, neighborhood radius and complex height cutoff are genuinely
constructed from a finite old assignment and an exceptional-volume budget.
They are fixed before every later pole family, original row and interpolant.
-/

noncomputable section
open Set Polynomial MeasureTheory

namespace Jig133.OldNodeCompatibleData

abbrev Interval := Icc (-1 : ℝ) 1

/-- A proved specification, constructed below from finite data alone. -/
structure Prepared (s : Finset ℝ) (values : s → ℝ) (η ρ δ : ℝ)
    (H u : ℝ[X]) : Prop where
  radius_pos : 0 < ρ
  radius_le_one : ρ ≤ 1
  height_pos : 0 < δ
  height_le_one : δ ≤ 1
  volume_small : volume (RealOldNodeMask.neighborhoods s ρ) < ENNReal.ofReal η
  mask_old : ∀ t : s, H.eval (t : ℝ) = 0
  old_values : ∀ t : s, u.eval (t : ℝ) = values t
  mask_bounds : ∀ x ∈ Interval, 0 ≤ H.eval x ∧ H.eval x ≤ 1
  old_bound : ∀ x ∈ Interval, |u.eval x| < 2
  pole_lower : ∀ c ∈ Interval, c ∉ RealOldNodeMask.neighborhoods s ρ →
    ∀ α ∈ Icc (0 : ℝ) δ,
      (1 / 4 : ℝ) ≤ ‖(MultipoleInterpolationAlgebra.complexify H).eval
        ((c : ℂ) + (α : ℂ) * Complex.I)‖

/-- No mask, extension or modulus is supplied as an existence premise. -/
theorem exists_prepared (s : Finset ℝ) (hs : ∀ t ∈ s, t ∈ Interval)
    (values : s → ℝ) (hv : ∀ t, |values t| < 2) (η : ℝ) (hη : 0 < η) :
    ∃ H u : ℝ[X], ∃ ρ δ : ℝ, Prepared s values η ρ δ H u := by
  obtain ⟨u, hunodes, hubound⟩ := BoundedPolynomialExtension.exists_bounded_extension
    s hs values 2 (by norm_num) hv
  obtain ⟨ρ, hρ, hρone, hvol, H, hHnodes, hHbounds, hHlower⟩ :=
    RealOldNodeMask.exists_mask s hs η hη
  obtain ⟨δ, hδ, hδone, hvertical⟩ :=
    PolynomialVerticalContinuity.exists_uniform_vertical_lower H (1 / 2) (by norm_num)
  refine ⟨H, u, ρ, δ, ⟨hρ, hρone, hδ, hδone, hvol,
    (fun t => hHnodes t t.property), hunodes, hHbounds, hubound, ?_⟩⟩
  intro c hc hout α hα
  have hv := hvertical c hc α hα (hHlower c hc hout)
  norm_num only at hv
  exact hv

variable {s : Finset ℝ} {values : s → ℝ} {η ρ δ : ℝ} {H u : ℝ[X]}

/-- All later complex poles above retained real centers have nonzero mask value. -/
theorem Prepared.mask_eval_ne_zero (d : Prepared s values η ρ δ H u)
    (w : ℂ) (hc : w.re ∈ Interval)
    (hout : w.re ∉ RealOldNodeMask.neighborhoods s ρ)
    (hα0 : 0 ≤ w.im) (hα1 : w.im ≤ δ) :
    (MultipoleInterpolationAlgebra.complexify H).eval w ≠ 0 := by
  have h := d.pole_lower w.re hc hout w.im ⟨hα0, hα1⟩
  rw [Complex.re_add_im] at h
  exact norm_pos_iff.mp (lt_of_lt_of_le (by norm_num : (0 : ℝ) < 1 / 4) h)

theorem Prepared.datum_old (d : Prepared s values η ρ δ H u)
    {k : ℕ} (z : Fin k → ℂ) (t : s) :
    MultipoleInterpolationAlgebra.datum z H u (t : ℝ) = values t := by
  rw [MultipoleInterpolationAlgebra.datum_at_old z H u (t : ℝ) (d.mask_old t)]
  exact d.old_values t

theorem Prepared.datum_bound (d : Prepared s values η ρ δ H u)
    {k : ℕ} (z : Fin k → ℂ) (hz : ∀ j, 0 < (z j).im)
    (x : ℝ) (hx : x ∈ Interval) :
    |MultipoleInterpolationAlgebra.datum z H u x| < 2 :=
  MultipoleInterpolationAlgebra.abs_datum_lt_two z hz H u x
    (d.mask_bounds x hx).1 (d.mask_bounds x hx).2 (d.old_bound x hx)

/-- One later datum, with one full-original-row quotient for each interpolant.
The constructed mask makes every chosen pole eligible, without an added mask oracle. -/
theorem Prepared.quotient_for_interpolant (d : Prepared s values η ρ δ H u)
    {k n r : ℕ} (z : Fin k → ℂ) (hz : ∀ j, 0 < (z j).im)
    (hcenter : ∀ j, (z j).re ∈ Interval)
    (hout : ∀ j, (z j).re ∉ RealOldNodeMask.neighborhoods s ρ)
    (hheight : ∀ j, (z j).im ≤ δ)
    (p : ℝ[X]) (nodes : Fin n → ℝ) (hinj : Function.Injective nodes)
    (hp : p.natDegree ≤ n + r - 1)
    (hinterp : ∀ i, p.eval (nodes i) = MultipoleInterpolationAlgebra.datum z H u (nodes i)) :
    ∃ Q : ℂ[X], MultipoleInterpolationAlgebra.cleared z H u p =
        ComplexNodalQuotient.nodal nodes * Q ∧
      Q.natDegree ≤ r + 2 * k + H.natDegree + u.natDegree ∧
      (∀ j, Q.eval (z j) ≠ 0) ∧
      (∀ j, Q.eval (z j) = -(MultipoleInterpolationAlgebra.complexify H).eval (z j) *
        (MultipoleData.lowerProduct z).eval (z j) ^ 2 /
          (2 * (ComplexNodalQuotient.nodal nodes).eval (z j))) := by
  obtain ⟨Q, hfactor, hdegree, hpoles, hnonzero⟩ :=
    MultipoleInterpolationAlgebra.exists_quotient_with_poles z hz H u p nodes hinj hp hinterp
  refine ⟨Q, hfactor, hdegree, ?_, hpoles⟩
  intro j
  exact hnonzero j (d.mask_eval_ne_zero (z j) (hcenter j) (hout j) (hz j).le (hheight j))

theorem Prepared.boundary_norm_le (d : Prepared s values η ρ δ H u)
    {k n : ℕ} (z : Fin k → ℂ) (hz : ∀ j, 0 < (z j).im)
    (p : ℝ[X]) (nodes : Fin n → ℝ) (Q : ℂ[X])
    (hfactor : MultipoleInterpolationAlgebra.cleared z H u p =
      ComplexNodalQuotient.nodal nodes * Q)
    (x M : ℝ) (hx : x ∈ Interval) (hp : |p.eval x| ≤ M)
