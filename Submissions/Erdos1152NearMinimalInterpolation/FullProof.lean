      (∀ x ∈ Q, x ∉ FullProductRootFilter.bad F c B L n) →
      (∀ x ∈ Q, η * A ≤ |F.eval x| ∧ |F.eval x| ≤ T * A) →
      (∀ y ∈ Y, y ∉ Z → |F.derivative.eval y| ≤ C_D * n * A) →
      (∀ i ∈ indices Y Q, i ∉ SourceRankGeometry.badIndices Y C n) →
      ∀ (ell : ℕ) (hell : 0 < ell) (K : ℝ),
      0 ≤ MarkedBoundaryWeights.harmonic ell / C - 4 →
      4 * K + 4 < (η * Real.exp (-(1 / 2 : ℝ))) *
        (MarkedBoundaryWeights.harmonic ell / C - 4) / C_D →
      ∀ (s : Finset ℝ) (hs : ∀ x ∈ s, x ∈ Icc (-1 : ℝ) 1) (values : s → ℝ) (H h : ℝ[X]),
      (∀ t : s, h.eval (t : ℝ) = values t) →
      (∀ x ∈ Icc (-1 : ℝ) 1, |h.eval x| < 2) → (∀ t ∈ s, H.eval t = 0) →
      (∀ x ∈ Icc (-1 : ℝ) 1, 0 ≤ H.eval x ∧ H.eval x ≤ 1) →
      ∃ g : C(Icc (-1 : ℝ) 1, ℝ), ‖g‖ ≤ 1 ∧
        (∀ t : s, g ⟨(t : ℝ), hs t t.property⟩ = values t / 2) ∧
        (∀ i, |g ⟨nodes i, hnodes i⟩| < 1) ∧
      ∀ (m : ℕ) (degrees : Fin m → ℕ) (ρ : ℝ), 0 ≤ ρ →
      (∀ x ∈ Icc (-1 : ℝ) 1, x ∉ RealOldNodeMask.neighborhoods s ρ → (1 / 2 : ℝ) ≤ H.eval x) →
      ∀ (target : Set ℝ), MeasurableSet target → volume target ≠ ⊤ →
      ∀ (β θ σ δ τ : ℝ) (r : ℕ), 0 ≤ β → 0 ≤ σ →
      volume.real (RealOldNodeMask.neighborhoods s ρ) ≤ θ →
      volume.real (RealOldNodeMask.neighborhoods s ρ) ≤ ((parameter ell hell : ℝ) * β / 16) * θ →
      (∀ a ∈ Icc (-1 : ℝ) 1, ∀ b ∈ Icc (-1 : ℝ) 1,
        β * volume.real (target ∩ Icc a b) - σ ≤ volume.real (windows Y Q c B L n ∩ Icc a b)) →
      ((effective (indices Y Q) (badRanks Y Z) ell).card : ℝ) ≤ δ * n →
      smallCost r S.natDegree (H.natDegree + h.natDegree) (complexity degrees s) n (width c B L) ≤ τ →
      (complexity degrees s : ℝ) * ε + ((parameter ell hell : ℝ) / 4) * (complexity degrees s) * σ + τ +
