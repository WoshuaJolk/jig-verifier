theorem absTail_mul_subset (f g : α → ℝ) (K L : ℝ) :
    absTail (fun x => f x * g x) (K * L) ⊆
      absTail f K ∪ absTail g L := by
  intro x hx
  by_cases hf : K < |f x|
  · exact Or.inl hf
  by_cases hg : L < |g x|
  · exact Or.inr hg
  have hfle : |f x| ≤ K := le_of_not_gt hf
  have hgle : |g x| ≤ L := le_of_not_gt hg
  have hbound : |f x * g x| ≤ K * L := by
    rw [abs_mul]
    exact mul_le_mul hfle hgle (abs_nonneg _) ((abs_nonneg _).trans hfle)
  exact False.elim ((not_le_of_gt hx) hbound)

