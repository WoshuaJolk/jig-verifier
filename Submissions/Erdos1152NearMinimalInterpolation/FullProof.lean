    (J₀ : Finset (Fin k₀)) (a₀ b₀ : Fin k₀ → ℝ) (hab₀ : ∀ j ∈ J₀, a₀ j ≤ b₀ j)
    (hd₀ : Set.PairwiseDisjoint (↑J₀) (fun j => Ioc (a₀ j) (b₀ j)))
    (J₁ : Finset (Fin k₁)) (a₁ b₁ : Fin k₁ → ℝ) (hab₁ : ∀ j ∈ J₁, a₁ j ≤ b₁ j)
    (hd₁ : Set.PairwiseDisjoint (↑J₁) (fun j => Ioc (a₁ j) (b₁ j)))
    (hcover : (⋃ j ∈ J₁, Ioc (a₁ j) (b₁ j)) = ⋃ j ∈ J₀, Ioc (a₀ j) (b₀ j))
    (σ : Fin k₁ → Bool) :
    ((parameter ell hell : ℝ) / 4) * volume.real (family Y Q c B L n E (⋃ j ∈ J₀, Ioc (a₀ j) (b₀ j))) -
        J₀.card * ε - ((J₁.card : ℝ) / 2 + 3 / 2 + 8 * (parameter ell hell : ℝ) * (effective E (badRanks Y Z) ell).card) *
        (2 * width c B L / n) ≤
      volume.real (mixed Y Q c B L n J₁
        (fun j => chosen (retained E ell ω) (σ j) \ bad (retained E ell ω) (badRanks Y Z) ell)
        (fun j => Ioc (a₁ j) (b₁ j))) := by
  have hm := history_lower Y Q P hP c B L n hc hB hL hn hroots hQ E hE ell hell ω ε herror
    J₀ a₀ b₀ hab₀ hd₀
  have hp := mixed_parity_lower Y Q P hP c B L n hc hB hL hn hroots hQ
    (retained E ell ω) (bad (retained E ell ω) (badRanks Y Z) ell)
    (fun i hi => hE (Finset.mem_filter.mp hi).1) J₁ a₁ b₁ hab₁ hd₁ σ
  rw [hcover] at hp
  have hw : 0 ≤ 2 * width c B L / n :=
    div_nonneg (mul_nonneg (by norm_num) (width_bounds hc hB hL).1.le) (Nat.cast_nonneg n)
  have hcst := mul_le_mul_of_nonneg_right hbad hw
  nlinarith


theorem mass_lower {k : ℕ} (Y Z : Finset ℝ) (Q : Set ℝ) (P : ℝ[X]) (hP : P ≠ 0)
    (c B L : ℝ) (n : ℕ) (hc : 0 < c) (hB : 0 < B) (hL : 0 < L) (hn : 0 < n)
    (hroots : ∀ y ∈ Y, P.eval y = 0) (hQ : ∀ x ∈ Q, x ∉ FullProductRootFilter.bad P c B L n)
    (E : Finset (Fin (count Y))) (hE : E ⊆ indices Y Q) (ell : ℕ) (hell : 0 < ell)
    (ω : Fin (count Y) → Bool) (ε : ℝ)
    (herror : ∀ t, |randomCDF Y Q c B L n E ell ω t - meanCDF Y Q c B L n (parameter ell hell) E ell t| < ε)
    (hbad : ((bad (retained E ell ω) (badRanks Y Z) ell).card : ℝ) ≤ 8 * (parameter ell hell : ℝ) * (effective E (badRanks Y Z) ell).card)
    (J : Finset (Fin k)) (a b : Fin k → ℝ)
    (hab : ∀ j ∈ J, a j ≤ b j) (hd : Set.PairwiseDisjoint (↑J) (fun j => Ioc (a j) (b j)))
    (ha : ∀ j ∈ J, a j ∈ Icc (-1 : ℝ) 1) (hb : ∀ j ∈ J, b j ∈ Icc (-1 : ℝ) 1)
    (q S : ℝ[X]) :
    ((parameter ell hell : ℝ) / 4) * volume.real (family Y Q c B L n E (⋃ j ∈ J, Ioc (a j) (b j))) -
      J.card * ε - (((q.natDegree : ℝ) + S.natDegree) / 2 + J.card + 2 +
        8 * (parameter ell hell : ℝ) * (effective E (badRanks Y Z) ell).card) * (2 * width c B L / n) ≤
      volume.real (favorable Y Q c B L n (retained E ell ω)
        (bad (retained E ell ω) (badRanks Y Z) ell) (⋃ j ∈ J, Ioc (a j) (b j)) q S) := by
  obtain ⟨m, J', a', b', σ, V, hcard, hab', hd', hcover, hV, hσ⟩ :=
    RationalCorrectionPartition.exists_partition J a b q S ha hb
  have hp := partition_lower Y Z Q P hP c B L n hc hB hL hn hroots hQ
    E hE ell hell ω ε herror hbad J a b hab hd J' a' b' hab' hd' hcover σ
  have hsub := mixed_subset_favorable Y Q c B L n (retained E ell ω)
    (bad (retained E ell ω) (badRanks Y Z) ell) (⋃ j ∈ J, Ioc (a j) (b j)) q S J' a' b' σ V hcover hσ
  have hm := measureReal_mono hsub (favorable_finite Y Q c B L n (retained E ell ω)
    (bad (retained E ell ω) (badRanks Y Z) ell) (⋃ j ∈ J, Ioc (a j) (b j)) q S)
  rw [measureReal_sdiff_null (by simp only [measureReal_def, hV, ENNReal.toReal_zero])
    (by rw [hV]; exact ENNReal.zero_ne_top)] at hm
  have hcardR : (J'.card : ℝ) ≤ q.natDegree + S.natDegree + 2 * J.card + 1 := by exact_mod_cast hcard
  have hw : 0 ≤ 2 * width c B L / n :=
    div_nonneg (mul_nonneg (by norm_num) (width_bounds hc hB hL).1.le) (Nat.cast_nonneg n)
  have hcost := mul_le_mul_of_nonneg_right hcardR hw
  nlinarith


theorem exists_one_datum_all_histories {n : ℕ} (hn : 0 < n) (nodes : Fin n → ℝ)
    (hinj : Function.Injective nodes) (hnodes : ∀ i, nodes i ∈ Icc (-1 : ℝ) 1)
    (F S : ℝ[X]) (hF : F ≠ 0) (hfactor : F = RealNodalDivision.nodal nodes * S)
    (Y Z : Finset ℝ) (hY : ∀ y ∈ Y, y ∈ Icc (-1 : ℝ) 1)
    (hYsep : FiniteSourceNets.Separated Y (1 / (n : ℝ))) (hroots : ∀ y ∈ Y, F.eval y = 0)
    (Q : Set ℝ) (c B L η T A C_D C : ℝ)
    (hc : 0 < c) (hB : 0 < B) (hL : 0 < L) (hη : 0 < η) (hA : 0 < A) (hD : 0 < C_D) (hC : 0 < C)
    (hQ : ∀ x ∈ Q, x ∉ FullProductRootFilter.bad F c B L n)
    (hband : ∀ x ∈ Q, η * A ≤ |F.eval x| ∧ |F.eval x| ≤ T * A)
    (hderiv : ∀ y ∈ Y, y ∉ Z → |F.derivative.eval y| ≤ C_D * n * A)
    (E : Finset (Fin (count Y))) (hE : E ⊆ indices Y Q)
    (hrank : ∀ i ∈ E, i ∉ SourceRankGeometry.badIndices Y C n)
    (ell : ℕ) (hell : 0 < ell) (hG : 0 ≤ MarkedBoundaryWeights.harmonic ell / C - 4)
    (ω : Fin (count Y) → Bool) (ε K : ℝ)
    (hamp : 4 * K + 4 < (η * Real.exp (-(1 / 2 : ℝ))) * (MarkedBoundaryWeights.harmonic ell / C - 4) / C_D)
    (herror : ∀ t, |randomCDF Y Q c B L n E ell ω t - meanCDF Y Q c B L n (parameter ell hell) E ell t| < ε)
    (hbad : ((bad (retained E ell ω) (badRanks Y Z) ell).card : ℝ) ≤ 8 * (parameter ell hell : ℝ) * (effective E (badRanks Y Z) ell).card)
    (s : Finset ℝ) (hs : ∀ x ∈ s, x ∈ Icc (-1 : ℝ) 1) (values : s → ℝ)
    (H h : ℝ[X]) (hold : ∀ t : s, h.eval (t : ℝ) = values t)
    (hh : ∀ x ∈ Icc (-1 : ℝ) 1, |h.eval x| < 2) (hzero : ∀ t ∈ s, H.eval t = 0)
    (hH : ∀ x ∈ Icc (-1 : ℝ) 1, 0 ≤ H.eval x ∧ H.eval x ≤ 1)
 :
    ∃ g : C(Icc (-1 : ℝ) 1, ℝ), ‖g‖ ≤ 1 ∧
      (∀ t : s, g ⟨(t : ℝ), hs t t.property⟩ = values t / 2) ∧
      (∀ i, |g ⟨nodes i, hnodes i⟩| < 1) ∧
      ∀ (k : ℕ) (J : Finset (Fin k)) (a b : Fin k → ℝ)
        (_hab : ∀ j ∈ J, a j ≤ b j) (_hd : Set.PairwiseDisjoint (↑J) (fun j => Ioc (a j) (b j)))
        (_ha : ∀ j ∈ J, a j ∈ Icc (-1 : ℝ) 1) (_hb : ∀ j ∈ J, b j ∈ Icc (-1 : ℝ) 1)
        (_haway : ∀ x ∈ ⋃ j ∈ J, Ioc (a j) (b j), (1 / 2 : ℝ) ≤ H.eval x),
      ∀ (p : ℝ[X]) (r : ℕ), p.natDegree ≤ n + r →
        (∀ i, p.eval (nodes i) = g ⟨nodes i, hnodes i⟩) →
        volume.real ((⋃ j ∈ J, Ioc (a j) (b j)) ∩ {x | |p.eval x| ≤ K}) ≤
          volume.real (⋃ j ∈ J, Ioc (a j) (b j)) -
          ((parameter ell hell : ℝ) / 4) * volume.real (family Y Q c B L n E (⋃ j ∈ J, Ioc (a j) (b j))) +
          J.card * ε + cost r S.natDegree (H.natDegree + h.natDegree) J.card (effective E (badRanks Y Z) ell).card n (parameter ell hell) (width c B L) := by
  let R := SampledResiduePolynomial.polynomial Y Z E ell ω F (C_D * n * A)
  have hM : 0 < C_D * (n : ℝ) * A := mul_pos (mul_pos hD (Nat.cast_pos.mpr hn)) hA
  have hRn : ∀ i, |R.eval (nodes i)| ≤ 1 := by
    intro i
    apply SampledResiduePolynomial.all_roots_bound Y Z hY E ell ω F hroots _ hM hderiv
    rw [hfactor, eval_mul, RealNodalDivision.at_node, zero_mul]
  have hRdeg : R.natDegree ≤ n + S.natDegree := by
    have hr := SampledResiduePolynomial.degree_le Y Z E ell ω F (C_D * n * A)
    have hfdeg : F.natDegree ≤ n + S.natDegree := by
      rw [hfactor]
      exact (natDegree_mul_le).trans_eq (by rw [RealNodalDivision.degree])
    exact hr.trans ((Nat.sub_le _ _).trans hfdeg)
  let X := Finset.univ.image nodes
  have hmem : ∀ i, nodes i ∈ X := fun i => Finset.mem_image.mpr ⟨i, Finset.mem_univ i, rfl⟩
  have hX : ∀ x ∈ X, x ∈ Icc (-1 : ℝ) 1 := by
    intro x hx
    obtain ⟨i, _, rfl⟩ := Finset.mem_image.mp hx
    exact hnodes i
  have hRX : ∀ x ∈ X, |R.eval x| ≤ 1 := by
    intro x hx
    obtain ⟨i, _, rfl⟩ := Finset.mem_image.mp hx
    exact hRn i
  obtain ⟨g, hnorm, gold, gnew⟩ :=
    CompatibleResidueDatum.unit_extension s X hs hX values H h R hold hh hzero hH hRX
  have gnodes : ∀ i, g ⟨nodes i, hnodes i⟩ = (CompatibleResidueDatum.blend H h R).eval (nodes i) / 2 :=
    fun i => gnew ⟨nodes i, hmem i⟩
  have gstrict : ∀ i, |g ⟨nodes i, hnodes i⟩| < 1 := by
    intro i
    rw [gnodes i, abs_div, abs_of_pos (by norm_num : (0 : ℝ) < 2)]
    apply (div_lt_one (by norm_num : (0 : ℝ) < 2)).mpr
    exact CompatibleResidueDatum.nodal_bound H h R (nodes i)
      (hH _ (hnodes i)).1 (hH _ (hnodes i)).2 (hh _ (hnodes i)) (hRn i)
  refine ⟨g, hnorm, gold, gstrict, ?_⟩
  intro k J a b hab hd ha hb haway
  let A₀ := ⋃ j ∈ J, Ioc (a j) (b j)
  have hI : A₀ ⊆ Icc (-1 : ℝ) 1 := by
    intro x hx
    simp only [A₀, mem_iUnion] at hx
    obtain ⟨j, hj, hx⟩ := hx
    exact ⟨(ha j hj).1.trans hx.1.le, hx.2.trans (hb j hj).2⟩
  have hAf : volume A₀ ≠ ⊤ := measure_ne_top_of_subset hI (by simp)
  intro p r hp hmatch
  obtain ⟨q, hquot, hqdeg⟩ := RealNodalDivision.unit_datum_quotient nodes hinj p H h R
    (fun i => (hmatch i).trans (gnodes i)) hp hRdeg
  have hlarge := amplitude_on_favorable nodes F S p H h R q Y Q c B L n
    (retained E ell ω) (bad (retained E ell ω) (badRanks Y Z) ell) A₀ K hfactor hquot
    (fun x hx => ⟨haway x hx, (hH x (hI hx)).2⟩) (fun x hx => (hh x (hI hx)).le)
    (by
      intro j hj x hx _
      have hg := SampledResiduePolynomial.pointwise_gain Y Z hY Q F hF c B L η T A C_D C n hn hc hB hL
        hη hA hD hC hroots hYsep hQ hband E hE hrank ell hell hG ω j hj x hx
      exact ⟨hg.1, hg.2.1, hamp.trans_le hg.2.2⟩)
  have hm := mass_lower Y Z Q F hF c B L n hc hB hL hn hroots hQ E hE ell hell ω ε herror hbad
    J a b hab hd ha hb q S
  have hs := sublevel_of_large_mass A₀ _ p K _ hAf hlarge hm
  have hq : q.natDegree + S.natDegree ≤ r + 2 * S.natDegree + (H.natDegree + h.natDegree) := by omega
  have hqR : (q.natDegree : ℝ) + S.natDegree ≤ r + 2 * S.natDegree + (H.natDegree + h.natDegree) := by exact_mod_cast hq
  have hw : 0 ≤ 2 * width c B L / n :=
    div_nonneg (mul_nonneg (by norm_num) (width_bounds hc hB hL).1.le) (Nat.cast_nonneg n)
  have hcost := mul_le_mul_of_nonneg_right (div_le_div_of_nonneg_right hqR (by norm_num : (0 : ℝ) ≤ 2)) hw
  simp only [cost, Nat.cast_add]
  dsimp only [A₀] at hs
  nlinarith


theorem exists_target_contraction (ε : ℝ) (hε : 0 < ε) :
    ∃ N : ℕ, 0 < N ∧ ∀ (n : ℕ), N ≤ n →
      ∀ (nodes : Fin n → ℝ), Function.Injective nodes →
      ∀ (hnodes : ∀ i, nodes i ∈ Icc (-1 : ℝ) 1),
      ∀ (F S : ℝ[X]), F ≠ 0 → F = RealNodalDivision.nodal nodes * S →
      ∀ (Y Z : Finset ℝ), (∀ y ∈ Y, y ∈ Icc (-1 : ℝ) 1) → Y.card ≤ n →
      FiniteSourceNets.Separated Y (1 / (n : ℝ)) → (∀ y ∈ Y, F.eval y = 0) →
      ∀ (Q : Set ℝ) (c B L η T A C_D C : ℝ),
      0 < c → 0 < B → 0 < L → 0 < η → 0 < A → 0 < C_D → 0 < C →
      (∀ x ∈ Q, x ∉ FullProductRootFilter.bad F c B L n) →
      (∀ x ∈ Q, η * A ≤ |F.eval x| ∧ |F.eval x| ≤ T * A) →
      (∀ y ∈ Y, y ∉ Z → |F.derivative.eval y| ≤ C_D * n * A) →
      (∀ i ∈ indices Y Q, i ∉ SourceRankGeometry.badIndices Y C n) →
      ∀ (ell : ℕ) (hell : 0 < ell) (K : ℝ),
      0 ≤ MarkedBoundaryWeights.harmonic ell / C - 4 →
      4 * K + 4 < (η * Real.exp (-(1 / 2 : ℝ))) *
        (MarkedBoundaryWeights.harmonic ell / C - 4) / C_D →
      ∀ (s : Finset ℝ) (hs : ∀ x ∈ s, x ∈ Icc (-1 : ℝ) 1) (values : s → ℝ) (H h : ℝ[X]),
      (∀ t : s, h.eval (t : ℝ) = values t) →
      (∀ x ∈ Icc (-1 : ℝ) 1, |h.eval x| < 2) → (∀ t ∈ s, H.eval t = 0) →
      (∀ x ∈ Icc (-1 : ℝ) 1, 0 ≤ H.eval x ∧ H.eval x ≤ 1) →
      ∃ g : C(Icc (-1 : ℝ) 1, ℝ), ‖g‖ ≤ 1 ∧
        (∀ t : s, g ⟨(t : ℝ), hs t t.property⟩ = values t / 2) ∧
      (∀ i, |g ⟨nodes i, hnodes i⟩| < 1) ∧
      ∀ (k : ℕ) (J : Finset (Fin k)) (a b : Fin k → ℝ),
      (∀ j ∈ J, a j ≤ b j) → Set.PairwiseDisjoint (↑J) (fun j => Ioc (a j) (b j)) →
      (∀ j ∈ J, a j ∈ Icc (-1 : ℝ) 1) → (∀ j ∈ J, b j ∈ Icc (-1 : ℝ) 1) →
      (∀ x ∈ ⋃ j ∈ J, Ioc (a j) (b j), (1 / 2 : ℝ) ≤ H.eval x) →
      ∀ (target : Set ℝ), MeasurableSet target → volume target ≠ ⊤ →
      ∀ (β θ σ δ τ : ℝ) (r : ℕ), 0 ≤ β →
      θ ≤ volume.real (target ∩ ⋃ j ∈ J, Ioc (a j) (b j)) →
      (∀ j ∈ J, β * volume.real (target ∩ Icc (a j) (b j)) - σ ≤
        volume.real (windows Y Q c B L n ∩ Icc (a j) (b j))) →
      ((effective (indices Y Q) (badRanks Y Z) ell).card : ℝ) ≤ δ * n →
      smallCost r S.natDegree (H.natDegree + h.natDegree) J.card n (width c B L) ≤ τ →
      J.card * ε + ((parameter ell hell : ℝ) / 4) * J.card * σ + τ +
        16 * (parameter ell hell : ℝ) * width c B L * δ ≤ ((parameter ell hell : ℝ) * β / 8) * θ →
        ∀ p : ℝ[X], p.natDegree ≤ n + r → (∀ i, p.eval (nodes i) = g ⟨nodes i, hnodes i⟩) →
          volume.real ((⋃ j ∈ J, Ioc (a j) (b j)) ∩ {x | |p.eval x| ≤ K}) ≤
            volume.real (⋃ j ∈ J, Ioc (a j) (b j)) - ((parameter ell hell : ℝ) * β / 8) * θ := by
  obtain ⟨N, hN, hsample⟩ := LocalThinningSelection.eventually_uniform_sample ε hε
  refine ⟨N, hN, ?_⟩
  intro n hn nodes hinj hnodes F S hF hfactor Y Z hY hYn hYsep hroots Q c B L η T A C_D C
    hc hB hL hη hA hD hC hQ hband hderiv hrank ell hell K hG hamp s hs values H h hold hh hzero hH
  have hnpos : 0 < n := hN.trans_le hn
  obtain ⟨ω, herr, hbad⟩ := hsample n hn Y Z hY hYn Q F hF c B L hc hB hL hroots hQ
    (indices Y Q) (Finset.Subset.refl _) ell hell
  obtain ⟨g, hnorm, hgold, hgstrict, hg⟩ := exists_one_datum_all_histories hnpos nodes hinj hnodes F S hF hfactor
    Y Z hY hYsep hroots Q c B L η T A C_D C hc hB hL hη hA hD hC hQ hband hderiv
    (indices Y Q) (Finset.Subset.refl _) hrank ell hell hG ω ε K hamp herr hbad
    s hs values H h hold hh hzero hH
  refine ⟨g, hnorm, hgold, hgstrict, ?_⟩
  intro k J a b hab hd ha hb haway target ht htf β θ σ δ τ r hβ hθ hcomp hZ hsmall hbudget p hp hmatch
  have hcontract := hg k J a b hab hd ha hb haway p r hp hmatch
  have hsupply := OldHistorySupply.history_lower target ht htf Y Q c B L β σ n J a b hd hcomp
  have hw : 0 ≤ width c B L := (width_bounds hc hB hL).1.le
  have hp0 : 0 ≤ (parameter ell hell : ℝ) := (parameter ell hell).property.1
  have hcst := bad_fraction_bound r S.natDegree (H.natDegree + h.natDegree) J.card (effective (indices Y Q) (badRanks Y Z) ell).card n
    (parameter ell hell) (width c B L) δ hnpos hp0 hw hZ
  have hsupply' := mul_le_mul_of_nonneg_left hsupply (show 0 ≤ (parameter ell hell : ℝ) / 4 by positivity)
  have htarget := mul_le_mul_of_nonneg_left hθ (show 0 ≤ (parameter ell hell : ℝ) * β / 4 by positivity)
  nlinarith


theorem exists_common_sublevel_step (ε : ℝ) (hε : 0 < ε) :
    ∃ N : ℕ, 0 < N ∧ ∀ (n : ℕ), N ≤ n →
      ∀ (nodes : Fin n → ℝ), Function.Injective nodes →
      ∀ (hnodes : ∀ i, nodes i ∈ Icc (-1 : ℝ) 1),
