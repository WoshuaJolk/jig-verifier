    {Z : Omega → ℝ≥0∞} (hZ : Measurable Z) :
    (∫⁻ ω, Z ω ∂mu) ^ 2 ≤
      mu (Function.support Z) * (∫⁻ ω, (Z ω) ^ 2 ∂mu) := by
