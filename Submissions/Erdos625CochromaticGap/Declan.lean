      ((((n - 1 : ℕ) : ℝ) * r) / 2) ≤
        (n : ℝ) * r := by
    have hcast : ((n - 1 : ℕ) : ℝ) ≤ (n : ℝ) := by
      exact_mod_cast hnSub
    have hmul :
        ((n - 1 : ℕ) : ℝ) * r ≤ (n : ℝ) * r :=
      mul_le_mul_of_nonneg_right hcast hr
    nlinarith [mul_nonneg (Nat.cast_nonneg (n - 1)) hr]
