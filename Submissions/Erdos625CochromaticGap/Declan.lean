        (4 : ℝ)⁻¹ ^ t * ((S.card : ℝ) + 1 / 3) - 1 / 3 ≤ (R.card : ℝ) := by
  induction t generalizing S with
  | zero =>
      refine ⟨∅, S, by simp, Finset.empty_subset _, ?_, (by intro x hx; exact hx), ?_, ?_⟩
      · simp
      · simp
      · norm_num
