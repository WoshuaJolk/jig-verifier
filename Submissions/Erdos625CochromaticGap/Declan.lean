  induction ell generalizing v with
  | zero =>
      change Fintype {x : V // x = v ∧ x = w}
      infer_instance
  | succ ell ih =>
      change Fintype (Σ u : V, FH V ell u w)
      letI (u : V) : Fintype (FH V ell u w) := ih u
      infer_instance
namespace FH
def vertex {V : Type*} :
    {ell : ℕ} → {v w : V} →
      FH V ell v w → Fin (ell + 1) → V
