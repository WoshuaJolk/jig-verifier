def A1C (alpha : Nat) (A8 : 5 < alpha)
    (k : AG (alpha + 1))
    (S : Bm (AO k) (AO k)) :
    Prop :=
  forall e, e ∈ S.edges ->
    exists i j, e.1.1 ∈ GR alpha A8 k i /\
      e.2.1 ∈ GR alpha A8 k j /\
        S.typeTable e.1.1 e.2.1 = BL alpha A8 i j
def ARF (alpha : Nat) (A8 : 5 < alpha) : Nat :=
  BK alpha A8 (0 : Fin 4) / 2
def Aq9 (alpha : Nat) (A8 : 5 < alpha)
    (k : AG (alpha + 1))
    (S : Bm (AO k) (AO k)) :
    Prop :=
  A1C alpha A8 k S /\
    (forall ab, ab ∈ Md alpha A8 k S ->
      ARF alpha A8 < S.typeTable ab.1 ab.2)
def A8P (alpha : Nat) (A8 : 5 < alpha)
    (k : AG (alpha + 1))
    (S : Bm (AO k) (AO k)) :
    Prop :=
  (forall a b1 b2,
      (a, b1) ∈ Md alpha A8 k S ->
      (a, b2) ∈ Md alpha A8 k S -> b1 = b2) /\
    (forall a1 a2 b,
      (a1, b) ∈ Md alpha A8 k S ->
      (a2, b) ∈ Md alpha A8 k S -> a1 = a2)
def AIV (alpha : Nat) (A8 : 5 < alpha)
    (k : AG (alpha + 1))
    (S : Bm (AO k) (AO k)) :
    Prop :=
  A1C alpha A8 k S /\
    A8P alpha A8 k S
abbrev AIP (alpha : Nat) (A8 : 5 < alpha)
    (k : AG (alpha + 1)) :=
  {S : Bm (AO k) (AO k) //
    AIV alpha A8 k S}
abbrev ND (alpha : Nat) (A8 : 5 < alpha)
    (k : AG (alpha + 1)) (L : Bh) :=
  {S : AIP alpha A8 k //
    AB8 alpha A8 k S.1.typeTable = L}
noncomputable instance Av4
    (alpha : Nat) (A8 : 5 < alpha) (k : AG (alpha + 1))
    (L : Bh) :
    Fintype (ND alpha A8 k L) := by
  classical
  exact Fintype.ofFinite _
noncomputable def ARQ (alpha : Nat)
    (A8 : 5 < alpha) (k : AG (alpha + 1))
    (L : Bh)
    (S : ND alpha A8 k L) : ENNReal :=
  (Md alpha A8 k S.1.1).prod fun ab =>
    (C8 (S.1.1.typeTable ab.1 ab.2) : ENNReal)
noncomputable def As8 (n alpha : Nat)
    (A8 : 5 < alpha) (k : AG (alpha + 1))
    (L : Bh)
    (S : ND alpha A8 k L) : ENNReal :=
  ARQ alpha A8 k L S /
    ((n.descFactorial (K3 alpha A8 L) : Nat) : ENNReal)
end
end Erdos625
