theorem A2e
    (alpha : Nat) (A8 : 5 < alpha) (k : AG (alpha + 1))
    (L : Bh)
    (AN : CZ alpha A8 k)
    (D : J9 alpha A8 k L)
    (e : ↥D.1.1.edges) :
    (Jy alpha A8 k L AN D).typeTable
