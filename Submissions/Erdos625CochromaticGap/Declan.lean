section M017
namespace Erdos625
open scoped BigOperators
noncomputable section
structure Jv
    {I J : Type*}
    [Fintype I] [Fintype J] [DecidableEq I] [DecidableEq J]
    (L : I -> J -> Nat) (k : I -> Nat) (ell : J -> Nat) where
  FJ : forall i, JZ (k i) (L i)
