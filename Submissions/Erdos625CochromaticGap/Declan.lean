    (GF : Joins v blocks w) :
    F6.Joins v (Ih blocks) w := by
  induction blocks generalizing v with
  | nil =>
      simpa [Joins, Ih] using GF
  | cons block blocks ih =>
      rcases block with ⟨run, ⟨u, x⟩⟩
      simp only [Joins] at GF
      simp only [Ih, List.flatMap_cons]
      rw [List.append_assoc]
      apply F6.jh GF.1
      exact ⟨rfl, ih GF.2⟩
theorem Aek
    {V : Type*} {v w : V} {blocks : List (RI V)}
    (GF : F6.Joins v (Ih blocks) w) :
    Joins v blocks w := by
  induction blocks generalizing v with
  | nil =>
      simpa [Joins, Ih] using GF
  | cons block blocks ih =>
      rcases block with ⟨run, ⟨u, x⟩⟩
      simp only [Ih, List.flatMap_cons] at GF
      obtain ⟨middle, Jb, htail⟩ :=
        F6.A0C.mp GF
      obtain ⟨preTransition, hrun, UH⟩ :=
        F6.A0C.mp Jb
      simp only [F6.Joins] at UH
      rcases UH with ⟨rfl, rfl⟩
      exact ⟨hrun, ih htail⟩
theorem A9a
    {A B : Type*} [DecidableEq A] [DecidableEq B]
    (blocks : List (RI (A ⊕ B))) :
    DB (Ih blocks) =
      DB (N9 blocks) ∪
        DB (Jq blocks) := by
  induction blocks with
  | nil =>
      simp [Ih, N9, Jq,
        DB]
  | cons block blocks ih =>
      rcases block with ⟨run, separator⟩
      have htail :
          DB
              (List.flatMap (fun block => block.1 ++ [block.2]) blocks) =
            DB (List.flatMap Prod.fst blocks) ∪
              DB (List.map Prod.snd blocks) := by
        simpa only [Ih, N9, Jq] using ih
      simp only [Ih, N9, Jq,
        List.flatMap_cons, List.map_cons, A9W,
        A9X]
      rw [htail]
      ext cell
      simp only [Finset.mem_union]
      tauto
end PhysicalCutBlockList
def Et {V : Type*} (isSeparator : V × V → Bool) :
    List (V × V) → List (RI V)
  | [] => []
  | edge :: tail =>
      if isSeparator edge = true then
        ([], edge) :: Et isSeparator tail
      else
        match Et isSeparator tail with
        | [] => []
        | (run, separator) :: blocks =>
            (edge :: run, separator) :: blocks
theorem tQ
    {V : Type*} (isSeparator : V × V → Bool)
    (edges : List (V × V)) :
    PhysicalCutBlockList.Jq
        (Et isSeparator edges) =
      edges.filter isSeparator := by
  induction edges with
  | nil => rfl
  | cons edge tail ih =>
      rw [Et, List.filter_cons]
      by_cases hedge : isSeparator edge = true
      · simp only [hedge, ↓reduceIte,
          PhysicalCutBlockList.Jq, List.map_cons]
        exact congrArg (List.cons edge) ih
      · simp only [hedge]
        generalize SY : Et isSeparator tail = blocks
        cases blocks with
        | nil =>
            have htail := ih
            rw [SY] at htail
            simpa [PhysicalCutBlockList.Jq] using htail
        | cons block blocks =>
            rcases block with ⟨run, separator⟩
            have htail := ih
            rw [SY] at htail
            simpa [PhysicalCutBlockList.Jq] using htail
@[simp]
theorem AMK
    {V : Type*} (isSeparator : V × V → Bool)
    (edges : List (V × V)) :
    (Et isSeparator edges).length =
      (edges.filter isSeparator).length := by
  calc
    (Et isSeparator edges).length =
        (PhysicalCutBlockList.Jq
          (Et isSeparator edges)).length :=
      (PhysicalCutBlockList.A8E _).symm
    _ = (edges.filter isSeparator).length :=
      congrArg List.length
        (tQ isSeparator edges)
theorem AxO
    {V : Type*} (isSeparator : V × V → Bool)
    {edges : List (V × V)}
    {block : RI V}
    (FU : block ∈ Et isSeparator edges) :
    isSeparator block.2 = true := by
  have UH :
      block.2 ∈ PhysicalCutBlockList.Jq
        (Et isSeparator edges) := by
    simp only [PhysicalCutBlockList.Jq, List.mem_map]
    exact ⟨block, FU, rfl⟩
  rw [tQ] at UH
  exact List.of_mem_filter UH
theorem AlW
    {V : Type*} (isSeparator : V × V → Bool)
    (edges : List (V × V)) :
    ∀ block ∈ Et isSeparator edges,
      ∀ edge ∈ block.1, isSeparator edge ≠ true := by
  induction edges with
  | nil => simp [Et]
  | cons edge tail ih =>
      rw [Et]
      by_cases hedge : isSeparator edge = true
      · simpa [hedge] using ih
      · simp only [hedge]
        generalize SY : Et isSeparator tail = blocks
        have htail := ih
        rw [SY] at htail
        cases blocks with
        | nil => simp
        | cons first blocks =>
            rcases first with ⟨run, separator⟩
            intro block FU runEdge hrunEdge
            rcases List.mem_cons.mp FU with FU | FU
            · subst block
              simp only [List.mem_cons] at hrunEdge
              rcases hrunEdge with rfl | hrunEdge
              · exact hedge
              · exact htail (run, separator) (by simp) runEdge hrunEdge
            · exact htail block (by simp [FU]) runEdge hrunEdge
theorem AlM
    {V : Type*} (isSeparator : V × V → Bool)
    {edges : List (V × V)}
    {edge : V × V}
    (hedge : edge ∈ PhysicalCutBlockList.N9
      (Et isSeparator edges)) :
    isSeparator edge ≠ true := by
  unfold PhysicalCutBlockList.N9 at hedge
  obtain ⟨block, FU, hedge⟩ := List.mem_flatMap.mp hedge
  exact AlW
    isSeparator edges block FU edge hedge
theorem A1v
    {V : Type*} (isSeparator : V × V → Bool)
    (initial : List (V × V)) (closing : V × V)
    (U8 : isSeparator closing = true) :
    Et isSeparator (initial ++ [closing]) ≠ [] ∧
      PhysicalCutBlockList.Ih
          (Et isSeparator (initial ++ [closing])) =
        initial ++ [closing] := by
  induction initial with
  | nil =>
      simp [Et, U8,
        PhysicalCutBlockList.Ih]
  | cons edge initial ih =>
      rw [List.cons_append, Et]
      by_cases hedge : isSeparator edge = true
      · simp only [hedge, ↓reduceIte,
          PhysicalCutBlockList.Ih, List.flatMap_cons]
        exact ⟨by simp,
          congrArg (List.cons edge) ih.2⟩
      · simp only [hedge]
        generalize SY :
          Et isSeparator (initial ++ [closing]) = blocks at ih ⊢
        cases blocks with
        | nil => exact False.elim (ih.1 rfl)
        | cons block blocks =>
            rcases block with ⟨run, separator⟩
            constructor
            · simp
            · simp only [PhysicalCutBlockList.Ih,
                List.flatMap_cons] at ih ⊢
              simpa [List.append_assoc] using congrArg (List.cons edge) ih.2
theorem Al6
    {V : Type*} (isSeparator : V × V → Bool)
    (initial : List (V × V)) (closing : V × V)
    (U8 : isSeparator closing = true) :
    PhysicalCutBlockList.N9
        (Et isSeparator (initial ++ [closing])) =
      (initial ++ [closing]).filter (fun edge => !(isSeparator edge)) := by
  induction initial with
  | nil =>
      simp [Et, U8,
        PhysicalCutBlockList.N9]
  | cons edge initial ih =>
      rw [List.cons_append, Et, List.filter_cons]
      by_cases hedge : isSeparator edge = true
      · simp only [hedge, Bool.not_true, Bool.false_eq_true, ↓reduceIte,
          PhysicalCutBlockList.N9, List.flatMap_cons,
          List.nil_append]
        simpa only [PhysicalCutBlockList.N9,
          List.filter_append] using ih
      · simp only [hedge]
        generalize SY :
          Et isSeparator (initial ++ [closing]) = blocks at ih ⊢
        cases blocks with
        | nil =>
            have hnonempty :=
              (A1v
                isSeparator initial closing U8).1
            exact False.elim (hnonempty SY)
        | cons block blocks =>
            rcases block with ⟨run, separator⟩
            simp only [PhysicalCutBlockList.N9,
              List.flatMap_cons] at ih ⊢
            simpa [List.append_assoc] using congrArg (List.cons edge) ih
theorem ApF?
    {V : Type*} (isSeparator : V × V → Bool)
    (initial : List (V × V)) (closing : V × V)
    (U8 : isSeparator closing = true) :
    (PhysicalCutBlockList.Jq
      (Et isSeparator (initial ++ [closing]))).getLast? =
        some closing := by
  rw [tQ]
  simp [List.filter_append, U8]
theorem AlY
    {V : Type*} (isSeparator : V × V → Bool)
    (edges : List (V × V)) :
    ∀ block ∈ Et isSeparator edges,
      block.1.Sublist edges := by
  induction edges with
  | nil => simp [Et]
  | cons edge tail ih =>
      rw [Et]
      by_cases hedge : isSeparator edge = true
      · simp only [hedge, ↓reduceIte]
        intro block FU
        rcases List.mem_cons.mp FU with FU | FU
        · subst block
          exact List.nil_sublist (edge :: tail)
        · exact (ih block FU).cons edge
      · simp only [hedge]
        generalize SY : Et isSeparator tail = blocks
        have htail := ih
        rw [SY] at htail
        cases blocks with
        | nil => simp
        | cons first blocks =>
            rcases first with ⟨run, separator⟩
            intro block FU
            rcases List.mem_cons.mp FU with FU | FU
            · subst block
              exact (htail (run, separator) (by simp)).cons_cons edge
            · exact (htail block (by simp [FU])).cons edge
theorem AlX
    {V : Type*} (isSeparator : V × V → Bool)
    (edges : List (V × V))
    {block : RI V}
    (FU : block ∈ Et isSeparator edges) :
    block.1.length ≤ edges.length :=
  (AlY isSeparator edges block FU).length_le
def Zr {V : Type*} (isSeparator : V × V → Bool) :
    List (V × V) → Prop
  | [] => True
  | [_] => True
  | edge :: next :: tail =>
      ¬ (isSeparator edge = true ∧ isSeparator next = true) ∧
        Zr isSeparator (next :: tail)
theorem AML
    {V : Type*} (isSeparator : V × V → Bool)
    (edges : List (V × V)) (jf : Zr isSeparator edges) :
    (∀ block ∈ (Et isSeparator edges).tail,
        0 < block.1.length) ∧
      (match edges with
       | [] => True
       | first :: _ => isSeparator first ≠ true →
           ∀ block ∈ Et isSeparator edges,
             0 < block.1.length) := by
  induction edges with
  | nil => simp [Et]
  | cons edge tail ih =>
      cases tail with
      | nil =>
          by_cases hedge : isSeparator edge = true <;>
            simp [Et, hedge]
      | cons next tail =>
          have hpair :
              ¬ (isSeparator edge = true ∧
                isSeparator next = true) := jf.1
          have AdV :
              Zr isSeparator (next :: tail) := jf.2
          have ADp := ih AdV
          rw [Et]
          by_cases hedge : isSeparator edge = true
          · simp only [hedge, ↓reduceIte, List.tail_cons]
            have hnext : isSeparator next ≠ true := by
              intro hnext
              exact hpair ⟨hedge, hnext⟩
            exact ⟨ADp.2 hnext, fun h => False.elim (h rfl)⟩
          · simp only [hedge]
            generalize SY :
              Et isSeparator (next :: tail) = blocks
            have qW := ADp.1
            rw [SY] at qW
            cases blocks with
            | nil => simp
            | cons first blocks =>
                rcases first with ⟨run, separator⟩
                constructor
                · exact qW
                · intro _ block FU
                  rcases List.mem_cons.mp FU with FU | FU
                  · subst block
                    simp
                  · exact qW block FU
theorem AMM
    {V : Type*} (isSeparator : V × V → Bool)
    (first : V × V) (tail : List (V × V))
    (jf : Zr isSeparator (first :: tail))
    (Jb : isSeparator first ≠ true) :
    ∀ block ∈ Et isSeparator (first :: tail),
      0 < block.1.length :=
  (AML isSeparator
    (first :: tail) jf).2 Jb
theorem AMi
    {A B : Type*} [DecidableEq A] [DecidableEq B]
    {M : Finset (A × B)} (hM : DZ M)
    {left right : (A ⊕ B) × (A ⊕ B)}
    {leftCell kN : A × B}
    (hjoin : left.2 = right.1)
    (zV : leftCell ∈ M) (A06 : kN ∈ M)
    (zU : DS left = some leftCell)
    (A04 : DS right = some kN) :
    leftCell = kN := by
  rcases left with ⟨leftStart, leftFinish⟩
  rcases right with ⟨rightStart, rightFinish⟩
  rcases leftStart with a | b <;> rcases leftFinish with a' | b' <;>
    rcases rightStart with c | d <;> rcases rightFinish with c' | d' <;>
    simp [DS] at zU A04
  all_goals subst leftCell
  all_goals subst kN
  all_goals simp at hjoin
  all_goals subst_vars
  · apply Prod.ext
    · exact hM.2 _ _ _ zV A06
    · rfl
  · apply Prod.ext
    · rfl
    · exact hM.1 _ _ _ zV A06
theorem AEZ
    {A B : Type*} [DecidableEq A] [DecidableEq B]
    (M : Finset (A × B)) (hM : DZ M)
    (left right : (A ⊕ B) × (A ⊕ B))
    (hjoin : left.2 = right.1)
    (qV : s(left.1, left.2) ≠ s(right.1, right.2)) :
    ¬ (Ed M left = true ∧
      Ed M right = true) := by
  rintro ⟨hleft, hright⟩
  obtain ⟨leftCell, zV, zU⟩ :=
    (ZO M left).mp hleft
  obtain ⟨kN, A06, A04⟩ :=
    (ZO M right).mp hright
  have A4u : leftCell = kN :=
    AMi hM hjoin
      zV A06 zU A04
  apply qV
  rw [← lO zU,
    ← lO A04,
    A4u]
theorem Aly
    {A B : Type*} [DecidableEq A] [DecidableEq B]
    (M : Finset (A × B)) (hM : DZ M)
    {start finish : A ⊕ B}
    (edges : List ((A ⊕ B) × (A ⊕ B)))
    (GF : F6.Joins start edges finish)
    (hnodup :
      (edges.map (fun edge => s(edge.1, edge.2))).Nodup) :
    Zr (Ed M) edges := by
  induction edges generalizing start with
  | nil => trivial
  | cons edge tail ih =>
      cases tail with
      | nil => trivial
      | cons next tail =>
          have hjoin : edge.2 = next.1 := by
            rcases edge with ⟨u, x⟩
            rcases next with ⟨y, z⟩
            exact GF.2.1.symm
          have qV :
              s(edge.1, edge.2) ≠ s(next.1, next.2) := by
            intro hsym
            exact (List.nodup_cons.mp hnodup).1 (by simp [hsym])
          constructor
          · exact AEZ
              M hM edge next hjoin qV
          · exact ih GF.2 (List.nodup_cons.mp hnodup).2
theorem AeW
    {A B : Type*}
    (initial : List ((A ⊕ B) × (A ⊕ B)))
    (closing : (A ⊕ B) × (A ⊕ B))
    (hclosed : F6.Joins closing.2
      (initial ++ [closing]) closing.2)
    {cell : A × B}
    (DU : DS closing = some cell) :
    initial ≠ [] := by
  intro ADJ
  subst initial
  rcases closing with ⟨u, x⟩
  rcases u with a | b <;> rcases x with a' | b' <;>
    simp [F6.Joins, DS] at hclosed DU
theorem AZl
    {A B : Type*} [DecidableEq A] [DecidableEq B]
    (M : Finset (A × B)) (hM : DZ M)
    (first : (A ⊕ B) × (A ⊕ B))
    (tail : List ((A ⊕ B) × (A ⊕ B)))
    (closing : (A ⊕ B) × (A ⊕ B))
    (hclosed : F6.Joins closing.2
      ((first :: tail) ++ [closing]) closing.2)
    (hnodup :
      (((first :: tail) ++ [closing]).map
        (fun edge => s(edge.1, edge.2))).Nodup)
    (U8 : Ed M closing = true) :
    Ed M first ≠ true := by
  have hjoin : closing.2 = first.1 := hclosed.1.symm
  have qV : s(closing.1, closing.2) ≠ s(first.1, first.2) := by
    intro hsym
    have hnotMem := (List.nodup_cons.mp hnodup).1
    apply hnotMem
    simp [hsym]
  intro Jb
  exact AEZ
    M hM closing first hjoin qV ⟨U8, Jb⟩
theorem AQ1
    {A B : Type*} [DecidableEq A] [DecidableEq B]
    (S : Finset (A × B))
    (edge : (A ⊕ B) × (A ⊕ B))
    {cell : A × B} (hcell : cell ∈ S)
    (DU : DS edge = some cell) :
    ∃ z ∈ Kw S,
      edge.2 = J6 z ∧
        edge = rG z := by
  rcases edge with ⟨u, x⟩
  rcases u with a | b <;> rcases x with a' | b' <;>
    simp [DS] at DU
  · subst cell
    exact ⟨((a, b'), false), by
      simp [Kw, hcell], rfl, rfl⟩
  · subst cell
    exact ⟨((a', b), true), by
      simp [Kw, hcell], rfl, rfl⟩
theorem A2S
    {X Y : Type*} (f : X → Option Y) (keep : X → Bool)
    (xs : List X) :
    (xs.filter keep).filterMap f |>.Sublist (xs.filterMap f) := by
  induction xs with
  | nil => simp
  | cons x xs ih =>
      cases hkeep : keep x <;> cases DU : f x <;>
        simp [hkeep, DU, ih]
theorem Afo
    {A B : Type*} [Fintype A] [Fintype B]
    [DecidableEq A] [DecidableEq B]
    {C : Finset (A × B)} {v : A ⊕ B}
    {p : (Gd C).Walk v v} (hp : p.IsCycle)
    (hcover : p.edges.toFinset = C.image Lh)
    (M : Finset (A × B))
    (edges : List ((A ⊕ B) × (A ⊕ B)))
    (hperm : (L8 p).Perm edges) :
    (edges.filter (Ed M)).length = (C ∩ M).card := by
  have AaL : ∀ edge ∈ edges,
      ∃ cell, DS edge = some cell := by
    intro edge hedge
    have e7 : edge ∈ L8 p :=
      hperm.mem_iff.mpr hedge
    obtain ⟨cell, _, DU⟩ :=
      Zo p e7
    exact ⟨cell, DU⟩
  have Aa7 : ∀ edge ∈ edges.filter (Ed M),
      ∃ cell, DS edge = some cell := by
    intro edge hedge
    exact AaL edge (List.mem_of_mem_filter hedge)
  have AaM :
      (edges.filterMap DS).Nodup :=
    A2U hp hperm
  have Aa8 :
      ((edges.filter (Ed M)).filterMap
        DS).Nodup :=
    AaM.sublist
      (A2S DS
        (Ed M) edges)
  have zK : DB edges = C := by
    rw [← A1x hperm]
    exact A1y p hcover
  have AZZ :
      DB (edges.filter (Ed M)) =
        C ∩ M := by
    rw [A9Y, zK]
  calc
    (edges.filter (Ed M)).length =
        ((edges.filter (Ed M)).filterMap
          DS).length :=
      (A2T _ _
        Aa7).symm
    _ = (DB
          (edges.filter (Ed M))).card :=
      (List.toFinset_card_of_nodup Aa8).symm
    _ = (C ∩ M).card := congrArg Finset.card AZZ
theorem A9b
    {A B : Type*} [Fintype A] [Fintype B]
    [DecidableEq A] [DecidableEq B]
    (M : Finset (A × B))
    (edges : List ((A ⊕ B) × (A ⊕ B))) :
    DB
        (PhysicalCutBlockList.Jq
          (Et (Ed M) edges)) =
      DB edges ∩ M := by
  classical
  rw [tQ,
    A9Y]
theorem AMh
    {A B : Type*} [Fintype A] [Fintype B]
    [DecidableEq A] [DecidableEq B]
    (M : Finset (A × B))
    (initial : List ((A ⊕ B) × (A ⊕ B)))
    (closing : (A ⊕ B) × (A ⊕ B))
    (U8 : Ed M closing = true) :
    DB
        (PhysicalCutBlockList.N9
          (Et (Ed M)
            (initial ++ [closing]))) =
      DB (initial ++ [closing]) \ M := by
  classical
  let blocks := Et (Ed M)
    (initial ++ [closing])
  have q7 : PhysicalCutBlockList.Ih blocks =
      initial ++ [closing] :=
    (A1v
      (Ed M) initial closing U8).2
  apply Finset.Subset.antisymm
  · intro cell Nb
    refine Finset.mem_sdiff.mpr ⟨?_, ?_⟩
    · have hunion :
          cell ∈ DB
              (PhysicalCutBlockList.N9 blocks) ∪
            DB
              (PhysicalCutBlockList.Jq blocks) :=
        Finset.mem_union_left _ Nb
      rw [← PhysicalCutBlockList.A9a,
        q7] at hunion
      exact hunion
    · simp only [DB, List.mem_toFinset] at Nb
      obtain ⟨edge, hedge, DU⟩ :=
        List.mem_filterMap.mp Nb
      have A5j : Ed M edge ≠ true := by
        exact AlM
          (Ed M) hedge
      intro hcellM
      exact A5j
        ((ZO M edge).mpr
          ⟨cell, hcellM, DU⟩)
  · intro cell houtside
    obtain ⟨hfull, hnotM⟩ := Finset.mem_sdiff.mp houtside
    have hunion :
        cell ∈ DB
            (PhysicalCutBlockList.N9 blocks) ∪
          DB
            (PhysicalCutBlockList.Jq blocks) := by
      rw [← PhysicalCutBlockList.A9a,
        q7]
      exact hfull
    rcases Finset.mem_union.mp hunion with Nb | UH
    · exact Nb
    · exfalso
      have Adm :
          DB
              (PhysicalCutBlockList.Jq blocks) =
            DB (initial ++ [closing]) ∩ M := by
        dsimp only [blocks]
        exact A9b M _
      rw [Adm] at UH
      exact hnotM (Finset.mem_inter.mp UH).2
theorem AQB
    {V : Type*} {L : ℕ} {v w : V}
    (blocks : List (RI V))
    (GF : PhysicalCutBlockList.Joins v blocks w)
    (K4 : ∀ block ∈ blocks, 0 < block.1.length)
    (PN : ∀ block ∈ blocks, block.1.length ≤ L) :
    ∃ code : E9 V L blocks.length v w,
      Fj code =
          PhysicalCutBlockList.N9 blocks ∧
        GO code =
          PhysicalCutBlockList.Jq blocks ∧
        ML code =
          PhysicalCutBlockList.Ih blocks := by
  induction blocks generalizing v with
  | nil =>
      simp only [PhysicalCutBlockList.Joins] at GF
      subst w
      let Aq5 : FH V 0 v v := ⟨v, rfl, rfl⟩
      refine ⟨Aq5, ?_⟩
      simp [Fj, GO,
        ML, PhysicalCutBlockList.N9,
        PhysicalCutBlockList.Jq,
        PhysicalCutBlockList.Ih]
  | cons block blocks ih =>
      rcases block with ⟨run, ⟨u, x⟩⟩
      simp only [PhysicalCutBlockList.Joins] at GF
      have Acm : 0 < run.length :=
        K4 (run, (u, x)) (by simp)
      have Acl : run.length ≤ L :=
        PN (run, (u, x)) (by simp)
      obtain ⟨runCode, hrunCode⟩ :=
        AQ8 run GF.1
          Acm Acl
      have qW : ∀ tailBlock ∈ blocks,
          0 < tailBlock.1.length := by
        intro tailBlock htailBlock
        exact K4 tailBlock (by simp [htailBlock])
      have AdU : ∀ tailBlock ∈ blocks,
          tailBlock.1.length ≤ L := by
        intro tailBlock htailBlock
        exact PN tailBlock (by simp [htailBlock])
      obtain ⟨tailCode, Nb, UH, horiented⟩ :=
        ih GF.2 qW AdU
      let code : E9 V L (blocks.length + 1) v w :=
        ⟨x, ⟨⟨u, runCode⟩, tailCode⟩⟩
      refine ⟨code, ?_, ?_, ?_⟩
      · simp [code, Fj,
