section M343
namespace Erdos625
open scoped BigOperators
noncomputable section
def Ya {n : ℕ} (b : ℕ) (P : GD n) :
    AG b :=
  fun i ↦ (Jh P).count (i.1 + 1)
private theorem Aht {n s : ℕ}
    (P : GD n) (hs : s ∈ Jh P) :
    0 < s := by
  rw [Jh, Multiset.mem_map] at hs
  obtain ⟨B, hB, hcard⟩ := hs
  have hBpos : 0 < B.card := Finset.card_pos.mpr (P.nonempty_of_mem_parts hB)
  omega
private theorem Ahs {n b s : ℕ}
    (P : GD n)
    (hBound : ∀ B ∈ P.parts, B.card ≤ b)
    (hs : s ∈ Jh P) :
    s ≤ b := by
  rw [Jh, Multiset.mem_map] at hs
  obtain ⟨B, hB, hcard⟩ := hs
  have hBle : B.card ≤ b := hBound B hB
  omega
private theorem Ak1 {b s : ℕ}
    (k : AG b) (hs : s ∈ AG.sizes k) :
    0 < s := by
  simp only [AG.sizes, Multiset.mem_sum] at hs
  obtain ⟨i, _hi, hs⟩ := hs
  simp only [Multiset.mem_replicate] at hs
  omega
private theorem Ak0 {b s : ℕ}
    (k : AG b) (hs : s ∈ AG.sizes k) :
    s ≤ b := by
  simp only [AG.sizes, Multiset.mem_sum] at hs
  obtain ⟨i, _hi, hs⟩ := hs
  simp only [Multiset.mem_replicate] at hs
  omega
theorem Ahr {n b : ℕ}
    (P : GD n)
    (hBound : ∀ B ∈ P.parts, B.card ≤ b) :
    Jh P =
      AG.sizes (Ya b P) := by
  rw [Multiset.ext]
  intro s
  by_cases hzero : s = 0
  · subst s
    rw [Multiset.count_eq_zero.mpr, Multiset.count_eq_zero.mpr]
    · intro hs
      exact (Ak1 (Ya b P) hs).ne' rfl
    · intro hs
      exact (Aht P hs).ne' rfl
  · by_cases hle : s ≤ b
    · have hspos : 0 < s := Nat.pos_of_ne_zero hzero
      have hslt : s - 1 < b := by omega
      let i : Fin b := ⟨s - 1, hslt⟩
      have hi : i.1 + 1 = s := by
        dsimp only [i]
        omega
      calc
        (Jh P).count s =
            (Jh P).count (i.1 + 1) := by rw [hi]
        _ = Ya b P i := rfl
        _ = (AG.sizes (Ya b P)).count
            (i.1 + 1) :=
              (AG.A1u
                (Ya b P) i).symm
        _ = (AG.sizes (Ya b P)).count s := by
              rw [hi]
    · have hgt : b < s := Nat.lt_of_not_ge hle
      rw [Multiset.count_eq_zero.mpr, Multiset.count_eq_zero.mpr]
      · intro hs
        exact (not_le_of_gt hgt)
          (Ak0 (Ya b P) hs)
      · intro hs
        exact (not_le_of_gt hgt) (Ahs P hBound hs)
def Apx {n b : ℕ}
    (P : GD n)
    (hBound : ∀ B ∈ P.parts, B.card ≤ b) :
    BT n (Ya b P) :=
  ⟨P, Ahr P hBound⟩
theorem AJl {n : ℕ}
    (G : LabeledGraph n) (b parts : ℕ) (P : GD n)
    (yZ : G ∈ KX P)
    (A3w : P.parts.card = parts)
    (hBound : ∀ B ∈ P.parts, B.card ≤ b) :
    0 < RK G b parts := by
  rw [AJj]
  let k : AG b := Ya b P
  let Pk : BT n k :=
    Apx P hBound
  refine ⟨k, ?_, Pk, ?_⟩
  · apply Afz
    · exact Pk.vertexMass_eq
    · rw [← Pk.card_parts_eq]
      exact A3w
  · exact yZ
end
end Erdos625
end M343

section M344
namespace Erdos625
noncomputable section
theorem AJk
    {n k b : ℕ} (G : LabeledGraph n)
    (hchi : chromaticNumberNat G ≤ k)
    (hkn : k ≤ n)
    (hindep : G.indepNum ≤ b) :
    0 < RK G b k := by
  obtain ⟨P, A3w, yZ⟩ :=
    APw G hchi hkn
  apply AJl G b k P
    yZ A3w
  intro B hB
