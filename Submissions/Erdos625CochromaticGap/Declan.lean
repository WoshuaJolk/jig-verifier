        ∑ i' : Fin 4, ∑ j' : Fin 4,
          S6 n (BL alpha A8 i' j') :=
    Finset.single_le_sum
      (s := Finset.univ)
      (f := fun i' : Fin 4 => ∑ j' : Fin 4,
        S6 n (BL alpha A8 i' j'))
      (fun _ _ => bot_le) (Finset.mem_univ i)
