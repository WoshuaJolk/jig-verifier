def MW
    {A B : Type*} [Fintype A] [Fintype B]
    [DecidableEq A] [DecidableEq B]
    {demand : A → B → ℕ} {row : A → ℕ} {col : B → ℕ}
    (witness : BW demand row col) (a : A) :
    Finset (Fin (row a)) :=
  Finset.univ.filter (fun i =>
    (⟨a, i⟩ : Cj row) ∈ Ue witness)
def Ud
    {A B : Type*} [Fintype A] [Fintype B]
    [DecidableEq A] [DecidableEq B]
    {demand : A → B → ℕ} {row : A → ℕ} {col : B → ℕ}
    (witness : BW demand row col) (b : B) :
    Finset (Fin (col b)) :=
  Finset.univ.filter (fun i =>
    (⟨b, i⟩ : Cm col) ∈ XE witness)
def D5
    {A B : Type*} [Fintype A] [Fintype B]
    [DecidableEq A] [DecidableEq B]
    {demand : A → B → ℕ} {row : A → ℕ} {col : B → ℕ}
    (A1K : BW demand row col) (a : A) : ℕ :=
  row a - ∑ b, demand a b
def Dd
    {A B : Type*} [Fintype A] [Fintype B]
    [DecidableEq A] [DecidableEq B]
    {demand : A → B → ℕ} {row : A → ℕ} {col : B → ℕ}
    (A1K : BW demand row col) (b : B) : ℕ :=
  col b - ∑ a, demand a b
theorem AL3
    {A B : Type*} [Fintype A] [Fintype B]
    [DecidableEq A] [DecidableEq B]
    {demand : A → B → ℕ} {row : A → ℕ} {col : B → ℕ}
    (witness : BW demand row col) (a : A) :
    (MW witness a).card = ∑ b, demand a b := by
  classical
  let f : Fin (row a) → Cj row := fun i => ⟨a, i⟩
  have hf : Function.Injective f := by
    intro i j h
    exact eq_of_heq (Sigma.mk.inj_iff.mp h).2
  have himage :
      (MW witness a).image f =
        (Ue witness).filter (fun stub => stub.1 = a) := by
    ext stub
    constructor
    · intro h
      obtain ⟨i, hi, rfl⟩ := Finset.mem_image.mp h
      exact Finset.mem_filter.mpr ⟨by
        simpa [f, MW] using hi, rfl⟩
    · intro h
      obtain ⟨Kt, Nz⟩ := Finset.mem_filter.mp h
      obtain ⟨a', i⟩ := stub
      simp only at Nz
      subst a'
      exact Finset.mem_image.mpr ⟨i, by
        simp [MW, Kt], rfl⟩
  calc
    (MW witness a).card =
        ((MW witness a).image f).card := by
      rw [Finset.card_image_of_injective _ hf]
    _ = ((Ue witness).filter
          (fun stub => stub.1 = a)).card := by rw [himage]
    _ = ∑ b, demand a b := AKp witness a
theorem AL1
    {A B : Type*} [Fintype A] [Fintype B]
    [DecidableEq A] [DecidableEq B]
    {demand : A → B → ℕ} {row : A → ℕ} {col : B → ℕ}
    (witness : BW demand row col) (b : B) :
    (Ud witness b).card = ∑ a, demand a b := by
  classical
  let f : Fin (col b) → Cm col := fun i => ⟨b, i⟩
  have hf : Function.Injective f := by
    intro i j h
    exact eq_of_heq (Sigma.mk.inj_iff.mp h).2
  have himage :
      (Ud witness b).image f =
        (XE witness).filter (fun stub => stub.1 = b) := by
    ext stub
    constructor
    · intro h
      obtain ⟨i, hi, rfl⟩ := Finset.mem_image.mp h
      exact Finset.mem_filter.mpr ⟨by
        simpa [f, Ud] using hi, rfl⟩
    · intro h
      obtain ⟨Kt, Nz⟩ := Finset.mem_filter.mp h
      obtain ⟨b', i⟩ := stub
      simp only at Nz
      subst b'
      exact Finset.mem_image.mpr ⟨i, by
        simp [Ud, Kt], rfl⟩
  calc
    (Ud witness b).card =
        ((Ud witness b).image f).card := by
      rw [Finset.card_image_of_injective _ hf]
    _ = ((XE witness).filter
          (fun stub => stub.1 = b)).card := by rw [himage]
    _ = ∑ a, demand a b := AKo witness b
theorem A9A
    {A B : Type*} [Fintype A] [Fintype B]
    [DecidableEq A] [DecidableEq B]
    {demand : A → B → ℕ} {row : A → ℕ} {col : B → ℕ}
    (witness : BW demand row col) (a : A) :
    Fintype.card
        {i : Fin (row a) // i ∉ MW witness a} =
      D5 witness a := by
  classical
  rw [Fintype.card_subtype]
  have hfilter :
      Finset.univ.filter
          (fun i : Fin (row a) => i ∉ MW witness a) =
        (MW witness a)ᶜ := by
    ext i
    simp
  rw [hfilter, Finset.card_compl, Fintype.card_fin,
    AL3 witness]
  rfl
theorem AKl
    {A B : Type*} [Fintype A] [Fintype B]
    [DecidableEq A] [DecidableEq B]
    {demand : A → B → ℕ} {row : A → ℕ} {col : B → ℕ}
    (witness : BW demand row col) (b : B) :
    Fintype.card
        {i : Fin (col b) // i ∉ Ud witness b} =
      Dd witness b := by
  classical
  rw [Fintype.card_subtype]
  have hfilter :
      Finset.univ.filter
          (fun i : Fin (col b) => i ∉ Ud witness b) =
        (Ud witness b)ᶜ := by
    ext i
    simp
  rw [hfilter, Finset.card_compl, Fintype.card_fin,
    AL1 witness]
  rfl
private def Akx
    {A B : Type*} [Fintype A] [Fintype B]
    [DecidableEq A] [DecidableEq B]
    {demand : A → B → ℕ} {row : A → ℕ} {col : B → ℕ}
    (witness : BW demand row col) :
    Vv witness ≃
      Σ a, {i : Fin (row a) // i ∉ MW witness a} where
  toFun x := ⟨x.1.1, ⟨x.1.2, by
    simpa [MW] using x.2⟩⟩
  invFun x := ⟨⟨x.1, x.2.1⟩, by
    simpa [MW] using x.2.2⟩
  left_inv _ := rfl
  right_inv _ := rfl
private def Akv
    {A B : Type*} [Fintype A] [Fintype B]
    [DecidableEq A] [DecidableEq B]
    {demand : A → B → ℕ} {row : A → ℕ} {col : B → ℕ}
    (witness : BW demand row col) :
    Yj witness ≃
      Σ b, {i : Fin (col b) // i ∉ Ud witness b} where
  toFun x := ⟨x.1.1, ⟨x.1.2, by
    simpa [Ud] using x.2⟩⟩
  invFun x := ⟨⟨x.1, x.2.1⟩, by
    simpa [Ud] using x.2.2⟩
  left_inv _ := rfl
  right_inv _ := rfl
def YO
    {A B : Type*} [Fintype A] [Fintype B]
    [DecidableEq A] [DecidableEq B]
    {demand : A → B → ℕ} {row : A → ℕ} {col : B → ℕ}
    (witness : BW demand row col) :
    Vv witness ≃ Cj (D5 witness) :=
  (Akx witness).trans
    (Equiv.sigmaCongrRight (fun a =>
      Fintype.equivFinOfCardEq (A9A witness a)))
def kL
    {A B : Type*} [Fintype A] [Fintype B]
    [DecidableEq A] [DecidableEq B]
    {demand : A → B → ℕ} {row : A → ℕ} {col : B → ℕ}
    (witness : BW demand row col) :
    Yj witness ≃ Cm (Dd witness) :=
  (Akv witness).trans
    (Equiv.sigmaCongrRight (fun b =>
      Fintype.equivFinOfCardEq (AKl witness b)))
@[simp] theorem AxC
    {A B : Type*} [Fintype A] [Fintype B]
    [DecidableEq A] [DecidableEq B]
    {demand : A → B → ℕ} {row : A → ℕ} {col : B → ℕ}
    (witness : BW demand row col)
    (x : Vv witness) :
    (YO witness x).1 = x.1.1 := rfl
@[simp] theorem Akw
    {A B : Type*} [Fintype A] [Fintype B]
    [DecidableEq A] [DecidableEq B]
    {demand : A → B → ℕ} {row : A → ℕ} {col : B → ℕ}
    (witness : BW demand row col)
    (x : Yj witness) :
    (kL witness x).1 = x.1.1 := rfl
def WA
    {A B : Type*} [Fintype A] [Fintype B]
    [DecidableEq A] [DecidableEq B]
    {demand : A → B → ℕ} {row : A → ℕ} {col : B → ℕ}
    (witness : BW demand row col) :
    {matching : BZ row col //
        H7 matching witness} ≃
      BZ (D5 witness)
        (Dd witness) :=
  (wQ witness).trans
    ((YO witness).equivCongr
      (kL witness))
theorem Apb
    {A B : Type*} [Fintype A] [Fintype B]
    [DecidableEq A] [DecidableEq B]
    {demand : A → B → ℕ} {row : A → ℕ} {col : B → ℕ}
    (witness : BW demand row col)
    [Nonempty {matching : BZ row col //
        H7 matching witness}]
    [Nonempty (BZ (D5 witness)
      (Dd witness))] :
    (PMF.uniformOfFintype
        {matching : BZ row col //
          H7 matching witness}).map
        (WA witness) =
      PMF.uniformOfFintype
        (BZ (D5 witness)
          (Dd witness)) :=
  A8J
    (WA witness)
end
