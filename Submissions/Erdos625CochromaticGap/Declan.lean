    funext ω
    by_cases hω : Z ω = 0 <;> simp [I, Function.support, hω]
  have hI_sq : (fun ω ↦ I ω ^ (2 : ℝ)) = I := by
    funext ω
    by_cases hω : Z ω = 0 <;> simp [I, Function.support, hω]
  have AU1 : (∫⁻ ω, I ω ∂mu) = mu (Function.support Z) := by
    simp [I, measurableSet_support hZ]
