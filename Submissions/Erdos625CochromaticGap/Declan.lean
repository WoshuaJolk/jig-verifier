    (fun i _ => Finset.sum_nonneg fun r _ =>
      div_nonneg (pow_nonneg (hxi i) _) (by positivity))
    (fun i _ => ApH (xi i) (k i) (hxi i))
theorem AHX
    (n CY : Nat) (u k : I -> Nat) (xi : I -> Real)
    (hxi : ∀ i, 0 ≤ xi i)
    (eO : CY ≤ n)
