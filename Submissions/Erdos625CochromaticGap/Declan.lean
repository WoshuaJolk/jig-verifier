        (n.choose 2 - (Hpresent.edgeSet.ncard + E0.edgeSet.ncard)) *
        (1 / 2 : ENNReal) ^ n.choose 2 := by
      simp [Finset.sum_const, hcard, nsmul_eq_mul]
    _ = (1 / 2 : ENNReal) ^
        (Hpresent.edgeSet.ncard + E0.edgeSet.ncard) := by
      conv_lhs =>
        rhs
        rw [show n.choose 2 =
          (n.choose 2 -
            (Hpresent.edgeSet.ncard + E0.edgeSet.ncard)) +
            (Hpresent.edgeSet.ncard + E0.edgeSet.ncard) by
              exact (Nat.sub_add_cancel Ac8).symm,
          pow_add]
      rw [← mul_assoc, ← mul_pow]
      rw [div_eq_mul_inv, one_mul,
        ENNReal.mul_inv_cancel (by norm_num) (by norm_num), one_pow, one_mul]
