def A1V {α β : Type*} (e : α ≃ β) :
    (α → Bool) ≃ (β → Bool) where
  toFun f := fun b => f (e.symm b)
  invFun g := fun a => g (e a)
  left_inv := by
    intro f
    funext a
    simp
  right_inv := by
    intro g
    funext b
    simp
