      = (((P8 alpha A8 k L *
            Oy alpha A8 k L : ℕ)) : ENNReal) /
          ((KQ L *
            n.descFactorial (K3 alpha A8 L) : ℕ) : ENNReal) *
          bY alpha A8 L := by
  unfold M8
  rw [← ANa]
  push_cast
  ring_nf
private lemma A9z (alpha : Nat) (A8 : 5 < alpha) (i j : Fin 4) :
    BL alpha A8 i j = BL alpha A8 j i := by
  unfold BL; exact min_comm _ _
private lemma A9r (n alpha : Nat) (A8 : 5 < alpha) (i j : Fin 4) :
    KR n alpha A8 i j = KR n alpha A8 j i := by
  unfold KR DQ Gw M6
  rw [Nat.dist_comm, max_comm, min_comm]
private lemma AN9 (n alpha : Nat) (A8 : 5 < alpha) (i j : Fin 4) :
    Gh n alpha A8 i j
      = Gh n alpha A8 j i := by
  unfold Gh
  rw [A9z alpha A8 i j]
private lemma ArF (n alpha : Nat) (A8 : 5 < alpha) (i j : Fin 4) :
    M5 n alpha A8 i j = M5 n alpha A8 j i := by
  unfold M5 Gh
  rw [A9z alpha A8 i j, A9r n alpha A8 i j]
private lemma A9s (L : Bh) (j : Fin 4) :
    E3 (Mb L) j = El L j := rfl
private lemma ANJ (L : Bh) :
    KQ (Mb L) = KQ L := by
  unfold KQ Mb
  exact Finset.prod_comm
private lemma A9y (L : Bh) :
    Ln L * KQ L
