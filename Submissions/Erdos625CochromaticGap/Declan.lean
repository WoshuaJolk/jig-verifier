theorem ABE
    (alpha : Nat) (A8 : 5 < alpha) (i j : Fin 4) :
    LL alpha A8 i j =
      WJ
        (M6 alpha A8 i j) *
      (Nat.choose
        (Gw alpha A8 i j)
        (DQ i j) : ENNReal) := by
