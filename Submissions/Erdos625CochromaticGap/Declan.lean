    randomGraphMeasure n (Mt Hpresent E0) =
        randomGraphMeasure n (T : Set (LabeledGraph n)) := by
      congr 1
      ext G
      simp [T]
    _ = ∑ G ∈ T, randomGraphMeasure n {G} := by
      rw [MeasureTheory.sum_measure_singleton]
    _ = ∑ _G ∈ T, (1 / 2 : ENNReal) ^ n.choose 2 := by
      simp_rw [Wt]
