        residual a b ≤ cap a b ∧
          (support a b → residual a b = 0)) := by
  constructor
  · intro h a b
    obtain ⟨hcap, hsupp⟩ := h a b
    have hs := hsplit a b
    exact ⟨by omega, fun hsup => by
      have heq := hsupp hsup
      omega⟩
  · intro h a b
    obtain ⟨hcap, hsupp⟩ := h a b
    have hs := hsplit a b
    have hdc := AZb a b
    refine ⟨?_, fun hsup => by
      have hzero := hsupp hsup
      omega⟩
    by_cases hsup : support a b
    · have hzero := hsupp hsup
      omega
    · have hoff := AZc a b hsup
      omega
