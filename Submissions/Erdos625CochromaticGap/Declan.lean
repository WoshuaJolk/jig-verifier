          (Ip n : ℝ) := by norm_num
    _ ≤ ((m : ℝ) / (GW n : ℝ) + 1) +
          (Ip n : ℝ) := by
      gcongr
      exact AL6 m (GW n) hsteps
    _ ≤ (14 * Real.log 4 * (m : ℝ) / Real.log n + 1) +
          (Ip n : ℝ) := by gcongr
    _ = 14 * Real.log 4 * (m : ℝ) / Real.log n +
          (Ip n : ℝ) + 1 := by ring
def Ze (n u : ℕ) : ℕ :=
  if u < Ip n then u
  else Nq u (GW n) + Ip n
theorem AfF :
    ∀ᶠ n : ℕ in atTop,
