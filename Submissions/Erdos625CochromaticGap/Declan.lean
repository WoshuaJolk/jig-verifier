        intro y
        have hy := y.2
        simp only [Lj, Finset.mem_map, Finset.mem_univ, true_and] at hy
        obtain ⟨x, hx⟩ := hy
        refine ⟨x, ?_⟩
        apply Subtype.ext
        exact hx⟩
