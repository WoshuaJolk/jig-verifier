      BK alpha A8 k = alpha - 2 - k.val := by
    unfold BK Oz GQ
    simp [Ao]
    omega
  have hdist :
      max (BK alpha A8 i) (BK alpha A8 j) -
          min (BK alpha A8 i) (BK alpha A8 j) =
        DQ i j := by
