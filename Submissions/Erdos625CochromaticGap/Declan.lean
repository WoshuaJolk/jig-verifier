    {n : ℕ} {row : Fin n → A} {BU : B → ℕ}
    (table : EO n row BU) : ℚ :=
  DM table.Cd
def AGw
    {A B : Type*} [Fintype A] [Fintype B]
    [DecidableEq A] [DecidableEq B]
    {n : ℕ} (row : Fin n → A) (BU : B → ℕ) : ℚ :=
  ∑ table : EO n row BU,
    vG row BU table *
      A1W table
theorem AJi
    {A B : Type*} [Fintype A] [Fintype B]
    [DecidableEq A] [DecidableEq B]
