theorem AR3
    (alpha : Nat) (A8 : 5 < alpha) (k : AG (alpha + 1))
    (L : Bh)
    (AN : CZ alpha A8 k)
    (D : J9 alpha A8 k L) :
    A8P alpha A8 k
