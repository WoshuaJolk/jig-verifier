  simpa using (matching.Ov j).2.1 i
def tW
    {I J : Type*}
    [Fintype I] [Fintype J] [DecidableEq I] [DecidableEq J]
    (L : I -> J -> Nat) (k : I -> Nat) (ell : J -> Nat) :
    Jv L k ell ≃ BW L k ell where
  toFun matching :=
    ⟨matching.FJ, matching.Ov, matching.pairing⟩
  invFun witness :=
    { FJ := witness.1
      Ov := witness.2.1
      pairing := witness.2.2 }
  left_inv matching := by
    cases matching
    rfl
  right_inv witness := by
    rcases witness with ⟨FJ, Ov, pairing⟩
    rfl
noncomputable instance AvH
    {I J : Type*}
    [Fintype I] [Fintype J] [DecidableEq I] [DecidableEq J]
