          linarith
        have hpow : 0 ≤ (4 : ℝ)⁻¹ ^ i := by positivity
        have hmul := mul_le_mul_of_nonneg_left hshift hpow
        calc
          (4 : ℝ)⁻¹ ^ (i + 1) * ((S.card : ℝ) + 1 / 3) - 1 / 3 =
              (4 : ℝ)⁻¹ ^ i * (((S.card : ℝ) + 1 / 3) / 4) - 1 / 3 := by
                rw [pow_succ]
