        ((K : Real) * q +
          K7 n
            (DA alpha h.1
              (Aa n alpha K))) ∧
    Ni n alpha (K : Real) -
        ((K : Real) * q +
          K7 n
            (DA alpha h.1
              (Aa n alpha K))) ≤
      (50 / 7 : Real) := by
  rw [AGm
    n alpha K h]
  exact ⟨AEn n alpha K h,
    AEm n alpha K h⟩
theorem Wg
    (n alpha K : Nat) (h : Dh n alpha K) :
    (∑ i : Fin 4,
      (alpha - Ao i) * Aa n alpha K i) = n := by
  have hK : 0 < K := h.2.1
  have hn : n ≤ alpha * K := h.2.2.1
  have nC :=
    MH n alpha K h
  have nF :
      (∑ i : Fin 4,
        (Aa n alpha K i : Real)) = (K : Real) := by
    exact_mod_cast nC.1
  have o9 :
      (∑ i : Fin 4,
        Ao i * Aa n alpha K i) =
        IZ n alpha K := by
    simpa [Nl, Ao] using nC.2.1
  have oA :
      (∑ i : Fin 4,
        (Ao i : Real) *
          (Aa n alpha K i : Real)) =
        (IZ n alpha K : Real) := by
    exact_mod_cast o9
  have AT8 :
      (IZ n alpha K : Real) =
        (alpha : Real) * (K : Real) - (n : Real) := by
    unfold IZ
    rw [Nat.cast_sub hn, Nat.cast_mul]
  have AV0 :
      ((∑ i : Fin 4,
        (alpha - Ao i) * Aa n alpha K i : Nat) : Real) =
        (n : Real) := by
    calc
      ((∑ i : Fin 4,
        (alpha - Ao i) * Aa n alpha K i : Nat) : Real) =
        ∑ i : Fin 4,
          (((alpha : Real) - (Ao i : Real)) *
            (Aa n alpha K i : Real)) := by
              rw [Nat.cast_sum]
              apply Finset.sum_congr rfl
              intro i _hi
              have Uw : Ao i ≤ alpha := by
                have AT9 : Ao i ≤ 5 := by
                  fin_cases i <;> norm_num [Ao]
                exact AT9.trans (Nat.le_of_lt h.1)
              rw [Nat.cast_mul, Nat.cast_sub Uw]
      _ = ∑ i : Fin 4,
          ((alpha : Real) *
              (Aa n alpha K i : Real) -
            (Ao i : Real) *
              (Aa n alpha K i : Real)) := by
                apply Finset.sum_congr rfl
                intro i _hi
                ring
      _ = (∑ i : Fin 4,
            (alpha : Real) *
              (Aa n alpha K i : Real)) -
          ∑ i : Fin 4,
            (Ao i : Real) *
              (Aa n alpha K i : Real) := by
                rw [Finset.sum_sub_distrib]
      _ = (alpha : Real) *
            (∑ i : Fin 4,
              (Aa n alpha K i : Real)) -
          ∑ i : Fin 4,
            (Ao i : Real) *
              (Aa n alpha K i : Real) := by
                rw [Finset.mul_sum]
      _ = (n : Real) := by
        rw [nF, oA, AT8]
        ring
  exact_mod_cast AV0
theorem AId
    (n alpha K : Nat) (h : Dh n alpha K) :
    |Real.log
        (Ee n
          (fun i : Fin 4 ↦ alpha - Ao i)
          (Aa n alpha K)) -
        Ni n alpha (K : Real)| ≤
      4 * CH n + 50 / 7 := by
  have hMass := Wg n alpha K h
  have ZI :=
    A8V
      n alpha h.1 (Aa n alpha K) hMass
  have NX :=
    (MH n alpha K h).1
  have Xk :
      ((((∑ i : Fin 4, Aa n alpha K i : Nat) : Real))) =
        (K : Real) := by
    exact_mod_cast NX
  rw [Xk] at ZI
  have hGap :=
    Am8 n alpha K h
  let m9 : Real :=
    Real.log
      (Ee n
        (fun i : Fin 4 ↦ alpha - Ao i)
        (Aa n alpha K))
  let discrete : Real :=
    (K : Real) * q +
      K7 n
        (DA alpha h.1
          (Aa n alpha K))
  let objective : Real := Ni n alpha (K : Real)
  have AWn : |m9 - discrete| ≤
      4 * CH n := by
    simpa only [m9, discrete] using ZI
  have Asf : 0 ≤ objective - discrete := by
    simpa only [objective, discrete] using hGap.1
  have Ase : objective - discrete ≤ (50 / 7 : Real) := by
    simpa only [objective, discrete] using hGap.2
  have ATM : |discrete - objective| ≤ (50 / 7 : Real) := by
    rw [abs_of_nonpos (by linarith)]
    linarith
  calc
    |Real.log
        (Ee n
          (fun i : Fin 4 ↦ alpha - Ao i)
          (Aa n alpha K)) -
        Ni n alpha (K : Real)| =
      |(m9 - discrete) + (discrete - objective)| := by
        simp only [m9, objective]
        congr 1
        ring
    _ ≤ |m9 - discrete| + |discrete - objective| :=
      abs_add_le _ _
    _ ≤ 4 * CH n + 50 / 7 :=
      add_le_add AWn ATM
end
end Erdos625
end M339

section M340
namespace Erdos625
open scoped BigOperators
def A0n {α : Type*} [DecidableEq α]
    {s T : Finset α} (P : Finpartition s) (hT : T ⊆ s)
    (UF : ∀ B ∈ P.parts, (B \ T).Nonempty) : Finpartition s := by
  apply Finpartition.ofExistsUnique
    (T.image (fun x => ({x} : Finset α)) ∪
      P.parts.image fun B => B \ T)
  · intro A hA
    rw [Finset.mem_union] at hA
    rcases hA with hA | hA
    · obtain ⟨x, hxT, rfl⟩ := Finset.mem_image.mp hA
      exact Finset.singleton_subset_iff.mpr (hT hxT)
    · obtain ⟨B, hB, rfl⟩ := Finset.mem_image.mp hA
      exact Finset.sdiff_subset.trans (P.subset hB)
  · intro x hx
    by_cases hxT : x ∈ T
    · refine ⟨{x}, ?_, ?_⟩
      · exact ⟨Finset.mem_union_left _ <|
          Finset.mem_image.mpr ⟨x, hxT, rfl⟩, Finset.mem_singleton_self x⟩
      · intro A hA
        rcases hA with ⟨mo, hxA⟩
        rw [Finset.mem_union] at mo
        rcases mo with c8 | hAres
        · obtain ⟨y, hyT, rfl⟩ := Finset.mem_image.mp c8
          simpa only [Finset.singleton_inj] using
            (Finset.eq_of_mem_singleton hxA).symm
        · obtain ⟨B, hB, rfl⟩ := Finset.mem_image.mp hAres
          exact False.elim ((Finset.mem_sdiff.mp hxA).2 hxT)
    · let B := P.part x
      have hB : B ∈ P.parts := P.part_mem.mpr hx
      have hxB : x ∈ B := P.mem_part hx
      refine ⟨B \ T, ?_, ?_⟩
      · exact ⟨Finset.mem_union_right _ <|
          Finset.mem_image.mpr ⟨B, hB, rfl⟩,
          Finset.mem_sdiff.mpr ⟨hxB, hxT⟩⟩
      · intro A hA
        rcases hA with ⟨mo, hxA⟩
        rw [Finset.mem_union] at mo
        rcases mo with c8 | hAres
        · obtain ⟨y, hyT, rfl⟩ := Finset.mem_image.mp c8
          have hxy : x = y := Finset.mem_singleton.mp hxA
          exact False.elim (hxT (hxy ▸ hyT))
        · obtain ⟨C, hC, rfl⟩ := Finset.mem_image.mp hAres
          have hpart : P.part x = C :=
            P.part_eq_of_mem hC (Finset.mem_sdiff.mp hxA).1
          exact congrArg (fun D : Finset α => D \ T) hpart.symm
  · intro hempty
    rw [Finset.mem_union] at hempty
    rcases hempty with hsing | hres
    · obtain ⟨x, hxT, hx⟩ := Finset.mem_image.mp hsing
      exact Finset.singleton_ne_empty x hx
    · obtain ⟨B, hB, AS9⟩ := Finset.mem_image.mp hres
      obtain ⟨x, hx⟩ := UF B hB
      rw [AS9] at hx
      simp at hx
@[simp] theorem AFN {α : Type*}
    [DecidableEq α] {s T : Finset α} (P : Finpartition s)
    (hT : T ⊆ s) (UF : ∀ B ∈ P.parts, (B \ T).Nonempty) :
    (A0n P hT UF).parts =
      T.image (fun x => ({x} : Finset α)) ∪
        P.parts.image (fun B => B \ T) :=
  rfl
theorem Amd {α : Type*} [DecidableEq α]
    {s T : Finset α} (P : Finpartition s) (hT : T ⊆ s)
    (UF : ∀ B ∈ P.parts, (B \ T).Nonempty) :
    A0n P hT UF ≤ P := by
  intro A hA
  rw [AFN, Finset.mem_union] at hA
  rcases hA with c8 | hAres
  · obtain ⟨x, hxT, rfl⟩ := Finset.mem_image.mp c8
    refine ⟨P.part x, P.part_mem.mpr (hT hxT), ?_⟩
    exact Finset.singleton_subset_iff.mpr (P.mem_part (hT hxT))
  · obtain ⟨B, hB, rfl⟩ := Finset.mem_image.mp hAres
    exact ⟨B, hB, Finset.sdiff_subset⟩
theorem AKf {α : Type*}
    [DecidableEq α] {s T : Finset α} (P : Finpartition s)
    (hT : T ⊆ s) (UF : ∀ B ∈ P.parts, (B \ T).Nonempty) :
    (A0n P hT UF).parts.card =
      T.card + P.parts.card := by
  have hdisjoint : Disjoint (T.image (fun x => ({x} : Finset α)))
      (P.parts.image fun B => B \ T) := by
    rw [Finset.disjoint_left]
    intro A c8 hAres
    obtain ⟨x, hxT, rfl⟩ := Finset.mem_image.mp c8
    obtain ⟨B, hB, hEq⟩ := Finset.mem_image.mp hAres
    have hxres : x ∈ B \ T := by
      rw [hEq]
      exact Finset.mem_singleton_self x
    exact (Finset.mem_sdiff.mp hxres).2 hxT
  have hinj : Set.InjOn (fun B : Finset α => B \ T) P.parts := by
    intro B hB C hC hEq
    obtain ⟨x, hx⟩ := UF B hB
    have hxB : x ∈ B := (Finset.mem_sdiff.mp hx).1
    have hxT : x ∉ T := (Finset.mem_sdiff.mp hx).2
    change B \ T = C \ T at hEq
    have AeA : x ∈ C \ T := by
      rw [← hEq]
      exact Finset.mem_sdiff.mpr ⟨hxB, hxT⟩
    exact P.eq_of_mem_parts hB hC hxB (Finset.mem_sdiff.mp AeA).1
  rw [AFN,
    Finset.card_union_of_disjoint hdisjoint,
    Finset.card_image_of_injective T Finset.singleton_injective,
    Finset.card_image_of_injOn hinj]
theorem AQC {α : Type*} [DecidableEq α]
    {s : Finset α} (P : Finpartition s) :
    ∃ R : Finset α, R ⊆ s ∧ R.card = P.parts.card ∧
      ∀ B ∈ P.parts, ∃ r ∈ R, r ∈ B := by
  obtain ⟨R, hRs, hbij⟩ := P.exists_subset_part_bijOn
  refine ⟨R, hRs, ?_, ?_⟩
  · simpa using hbij.ncard_eq
  · intro B hB
    obtain ⟨r, hrR, hrpart⟩ := hbij.surjOn hB
    refine ⟨r, hrR, ?_⟩
    have hrs : r ∈ s := hRs hrR
    have hmem : r ∈ P.part r := P.mem_part hrs
    simpa [hrpart] using hmem
theorem AAZ {α : Type*}
    [DecidableEq α] {s : Finset α} (P : Finpartition s) {k : ℕ}
    (hlo : P.parts.card ≤ k) (hhi : k ≤ s.card) :
    ∃ Q : Finpartition s, Q.parts.card = k ∧ Q ≤ P := by
  obtain ⟨R, hRs, A41, AWH⟩ := AQC P
  have AYm : k - P.parts.card ≤ (s \ R).card := by
    rw [Finset.card_sdiff_of_subset hRs, A41]
    exact Nat.sub_le_sub_right hhi P.parts.card
  obtain ⟨T, hTsub, dM⟩ :=
    Finset.exists_subset_card_eq
      (s := s \ R) (n := k - P.parts.card) AYm
  have hTs : T ⊆ s := hTsub.trans Finset.sdiff_subset
  have UF : ∀ B ∈ P.parts, (B \ T).Nonempty := by
    intro B hB
    obtain ⟨r, hrR, hrB⟩ := AWH B hB
    refine ⟨r, Finset.mem_sdiff.mpr ⟨hrB, ?_⟩⟩
    intro hrT
    exact (Finset.mem_sdiff.mp (hTsub hrT)).2 hrR
  let Q := A0n P hTs UF
  refine ⟨Q, ?_, Amd P hTs UF⟩
  rw [show Q.parts.card = T.card + P.parts.card from
    AKf P hTs UF,
    dM, Nat.sub_add_cancel hlo]
theorem AEf {n : ℕ}
    {G : LabeledGraph n} {P Q : GD n}
    (hQP : Q ≤ P) (hP : G ∈ KX P) :
    G ∈ KX Q := by
  intro C hC
  obtain ⟨B, hB, hCB⟩ := hQP hC
  exact Set.Pairwise.mono (by simpa using hCB) (hP B hB)
theorem AhY {n b : ℕ}
    {P Q : GD n} (hQP : Q ≤ P)
    (hP : ∀ B ∈ P.parts, B.card ≤ b) :
    ∀ C ∈ Q.parts, C.card ≤ b := by
  intro C hC
  obtain ⟨B, hB, hCB⟩ := hQP hC
  exact (Finset.card_le_card hCB).trans (hP B hB)
theorem Ara
    {n p k b : ℕ} (G : LabeledGraph n) (P : GD n)
    (AcD : G ∈ KX P)
    (hp : P.parts.card = p) (hpk : p ≤ k) (hkn : k ≤ n)
    (hbound : ∀ B ∈ P.parts, B.card ≤ b) :
    ∃ Q : GD n,
      Q.parts.card = k ∧ Q ≤ P ∧
        G ∈ KX Q ∧
          ∀ C ∈ Q.parts, C.card ≤ b := by
  have hlo : P.parts.card ≤ k := hp.trans_le hpk
  have hhi : k ≤ (Finset.univ : Finset (Fin n)).card := by
    simpa using hkn
  obtain ⟨Q, A3z, hQP⟩ :=
    AAZ P hlo hhi
  exact ⟨Q, A3z, hQP,
    AEf hQP AcD,
    AhY hQP hbound⟩
end Erdos625
