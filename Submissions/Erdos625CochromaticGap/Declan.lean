      (m.descFactorial x * D) * (W * (m - x).factorial) =
        m.factorial * N := by
    calc
      (m.descFactorial x * D) * (W * (m - x).factorial) =
          ((m - x).factorial * m.descFactorial x) * (W * D) := by
        ac_rfl
      _ = m.factorial * N := by
        rw [Nat.factorial_mul_descFactorial WQ, AXb]
  have AX6 : 0 < m.descFactorial x * D := by
    apply Nat.mul_pos (Nat.descFactorial_pos.mpr WQ)
    simp [D, Jx, Nat.factorial_pos]
  have AX8 :
      ((m.descFactorial x * D : ℕ) : ℝ≥0∞) ≠ 0 := by
    exact_mod_cast AX6.ne'
  have AX7 :
      ((m.descFactorial x * D : ℕ) : ℝ≥0∞) ≠ ∞ := by
    exact ENNReal.natCast_ne_top _
  have AW3 : ((m.factorial : ℕ) : ℝ≥0∞) ≠ 0 := by
    exact_mod_cast m.factorial_ne_zero
  have AW2 : ((m.factorial : ℕ) : ℝ≥0∞) ≠ ∞ := by
    exact ENNReal.natCast_ne_top _
