section M398
namespace Erdos625
noncomputable section
def Nq (a b : ℕ) : ℕ :=
  (a + b - 1) / b
theorem Amc
    {V : Type*} [Fintype V] [DecidableEq V]
    (G : SimpleGraph V) [DecidableRel G.Adj]
    (cutoff block : ℕ) (FU : 1 ≤ block)
    (AU4 : ∀ S : Finset V, cutoff ≤ S.card →
      ∃ I : Finset V,
        I ⊆ S ∧ block ≤ I.card ∧ G.IsIndepSet (I : Set V)) :
    ∀ U : Finset V,
      chromaticNumberNat (G.induce (U : Set V)) ≤
        Nq U.card block + cutoff := by
  intro U
  induction' U using Finset.strongInduction with U ih
  by_cases hU : U.card < cutoff
  · have AXk :
        ∀ H : SimpleGraph (↑U), chromaticNumberNat H ≤ U.card := by
      intro H
      have AXl : H.Colorable U.card := by
        convert H.colorable_of_fintype
        rw [Fintype.card_coe]
      exact Nat.cast_le.mp
        (le_trans
          (ENat.toNat_le_toNat
            (SimpleGraph.chromaticNumber_le_iff_colorable.mpr AXl)
            (by simp +decide))
          (by simp +decide))
    exact le_trans (AXk _) (by linarith)
  · obtain ⟨I, hI₁, hI₂, hI₃⟩ :=
      AU4 U (le_of_not_gt hU)
    simp_all +decide [SimpleGraph.induce]
    have U7 :
        ∃ f : (↑U) →
            Fin (Nq (U.card - I.card) block + cutoff + 1),
          ∀ u v : ↑U, u ≠ v → G.Adj u v → f u ≠ f v := by
      have U7 :
          ∃ f : (↑(U \ I)) →
              Fin (Nq (U.card - I.card) block + cutoff),
            ∀ u v : ↑(U \ I), u ≠ v → G.Adj u v → f u ≠ f v := by
        have U7 :
            chromaticNumberNat
                (SimpleGraph.comap
                  (⇑(Function.Embedding.subtype
                    fun x => x ∈ (↑(U \ I) : Set V))) G) ≤
              Nq (U.card - I.card) block + cutoff := by
          have AU2 : I.Nonempty := by
            exact Finset.card_pos.mp (by omega)
          have hdiff : U \ I ⊂ U :=
            Finset.sdiff_ssubset hI₁ AU2
          convert ih (U \ I) hdiff using 1
          · congr 1
          · rw [Finset.card_sdiff_of_subset hI₁]
        have U7 :
            SimpleGraph.Colorable
                (SimpleGraph.comap
                  (⇑(Function.Embedding.subtype
                    fun x => x ∈ (↑(U \ I) : Set V))) G)
              (Nq (U.card - I.card) block + cutoff) := by
          refine' SimpleGraph.chromaticNumber_le_iff_colorable.mp _ |>
            fun h => h.mono U7
          rw [chromaticNumberNat, ENat.coe_toNat]
          exact ne_of_lt
            (lt_of_le_of_lt
              (SimpleGraph.colorable_of_fintype _ |>
                SimpleGraph.Colorable.chromaticNumber_le)
              (WithTop.coe_lt_top _))
        obtain ⟨f, hf⟩ := U7
        exact ⟨f, fun u v huv huv' => by simpa [huv] using hf huv'⟩
      obtain ⟨f, hf⟩ := U7
      use fun u =>
        if hu : u.val ∈ I then Fin.last _
        else Fin.castSucc (f ⟨u.val, by aesop⟩)
      simp_all +decide [Fin.ext_iff]
      intro a ha b hb hab h
      split_ifs <;> simp_all +decide
      · exact hI₃ ‹_› ‹_› hab h
      · exact ne_of_gt (Fin.is_lt _)
      · exact ne_of_lt (Fin.is_lt _)
    have U7 :
        SimpleGraph.Colorable
            (SimpleGraph.comap
              (⇑(Function.Embedding.subtype fun x => x ∈ (↑U : Set V))) G)
          (Nq (U.card - I.card) block + cutoff + 1) := by
      obtain ⟨f, hf⟩ := U7
      use fun u => f u
      aesop
    have U7 :
        chromaticNumberNat
            (SimpleGraph.comap
              (⇑(Function.Embedding.subtype fun x => x ∈ (↑U : Set V))) G) ≤
          Nq (U.card - I.card) block + cutoff + 1 := by
      convert U7.chromaticNumber_le using 1
      rw [← ENat.coe_le_coe, chromaticNumberNat, ENat.coe_toNat]
      exact ne_of_lt
        (lt_of_le_of_lt
          (SimpleGraph.chromaticNumber_le_iff_colorable.mpr U7)
          (WithTop.coe_lt_top _))
    refine' le_trans _ (U7.trans _)
    · exact le_rfl
    · unfold Nq
      simp +arith +decide
      rw [Nat.div_lt_iff_lt_mul <| by positivity]
      rw [tsub_lt_iff_left]
      · linarith
          [Nat.div_add_mod (block + U.card - 1) block,
            Nat.mod_lt (block + U.card - 1) FU,
            Nat.sub_add_cancel
              (show 1 ≤ block + U.card by linarith),
            Nat.sub_add_cancel
              (show I.card ≤ U.card from Finset.card_le_card hI₁)]
      · exact le_add_right FU
end
end Erdos625
