  simp only [DB, List.mem_toFinset] at hcell
  obtain ⟨edge, hedge, DU⟩ := List.mem_filterMap.mp hcell
  obtain ⟨sourceCell, hsourceCell, hsourceDecode⟩ :=
    Zo p hedge
  have : sourceCell = cell := by
    exact Option.some.inj (hsourceDecode.symm.trans DU)
  simpa [this] using hsourceCell
theorem A1y
    {A B : Type*} [DecidableEq A] [DecidableEq B]
    {C : Finset (A × B)} {v w : A ⊕ B}
