    {L : ℕ} {v w : V} (code : NG V L v w) :
    code.weight K = Tv K code.vertex :=
  FH.AII K code.2
end NG
theorem Anl
    {V : Type*} [Fintype V] [DecidableEq V]
    (K : V → V → ℝ≥0∞) (L : ℕ) (v w : V) :
    (∑ code : NG V L v w, code.weight K) =
      JK K L v w := by
  rw [Fintype.sum_sigma]
  simp only [NG.weight]
  simp_rw [A7r]
  rw [Fin.sum_univ_eq_sum_range
    (fun ell => Fe K (ell + 1) v w)]
  unfold JK
  rfl
theorem AHI
    {V : Type*} [Fintype V] [DecidableEq V]
    (K : V → V → ℝ≥0∞) (ell : ℕ) (v : V) :
    (∑ w, Fe K ell v w) =
      Ek K ell v := by
  induction ell generalizing v with
  | zero =>
      simp [Fe, Ek]
  | succ ell ih =>
      simp only [Fe, Ek]
      rw [Finset.sum_comm]
