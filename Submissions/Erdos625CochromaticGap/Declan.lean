      exact_mod_cast hnSub
    have hmul :
        ((n - 1 : ℕ) : ℝ) * Lambda ≤ (n : ℝ) * Lambda :=
      mul_le_mul_of_nonneg_right hcast GU
    nlinarith [mul_nonneg (Nat.cast_nonneg (n - 1)) GU]
