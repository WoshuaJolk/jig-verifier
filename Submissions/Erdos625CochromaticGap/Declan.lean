section M224
namespace Erdos625
open Filter Finset
open scoped BigOperators Topology
noncomputable section
theorem AN1 {b : ℕ} (hb : 0 < b) :
    Differentiable ℝ (Db b) :=
  fun t ↦ (zC hb t).differentiableAt
theorem AMH {b : ℕ} (hb : 0 < b) :
    Continuous (Db b) :=
  (AN1 hb).continuous
theorem kV {b : ℕ} (hb : 2 ≤ b) :
    StrictMono (Db b) := by
  have hbPos : 0 < b := lt_of_lt_of_le Nat.zero_lt_two hb
  apply strictMono_of_deriv_pos
  intro t
  rw [AMu hbPos]
  exact A7O hb t
def Ka (b : ℕ) (hb : 0 < b) : Fin b :=
  ⟨0, hb⟩
def Kd (b : ℕ) (hb : 0 < b) : Fin b :=
  ⟨b - 1, by omega⟩
@[simp] theorem Aj2 (b : ℕ) (hb : 0 < b) :
    D9 (Ka b hb) = 1 := by
  simp [D9, Ka]
@[simp] theorem Aj3 (b : ℕ) (hb : 0 < b) :
    D9 (Kd b hb) = (b : ℝ) := by
  simp only [D9, Kd]
  norm_cast
  omega
def Oi {b : ℕ} (base : Fin b) (t : ℝ) (i : Fin b) : ℝ :=
  Real.exp
    ((Ro i - Ro base) +
      t * (D9 i - D9 base))
def YK {b : ℕ} (base : Fin b) (t : ℝ) : ℝ :=
  ∑ i : Fin b, Oi base t i
def YL {b : ℕ} (base : Fin b) (t : ℝ) : ℝ :=
  ∑ i : Fin b, D9 i * Oi base t i
theorem AFz {b : ℕ}
    (base i : Fin b) (t : ℝ) :
    LX t i =
      LX t base * Oi base t i := by
  rw [LX, LX,
    Oi, ← Real.exp_add]
  congr 1
  ring
theorem AFs {b : ℕ} (base : Fin b) (t : ℝ) :
    Db b t =
      YL base t / YK base t := by
  rw [Db, gX, GK]
  have oC :
      (∑ i : Fin b, D9 i * LX t i) =
        LX t base * YL base t := by
    rw [YL, Finset.mul_sum]
    apply Finset.sum_congr rfl
    intro i _
    rw [AFz]
    ring
  have A38 :
      (∑ i : Fin b, LX t i) =
        LX t base * YK base t := by
    rw [YK, Finset.mul_sum]
    apply Finset.sum_congr rfl
    intro i _
    exact AFz base i t
  rw [oC, A38]
  field_simp [ne_of_gt (rT t base)]
private theorem AoR {a c : ℝ} (hc : c < 0) :
    Tendsto (fun t : ℝ ↦ Real.exp (a + t * c)) atTop (nhds 0) := by
  apply Real.tendsto_exp_atBot.comp
  have hlin : Tendsto (fun t : ℝ ↦ c * t + a) atTop atBot :=
    tendsto_atBot_add_const_right atTop a
      (tendsto_id.const_mul_atTop_of_neg hc)
  simpa only [mul_comm, add_comm] using hlin
private theorem AoP {a c : ℝ} (hc : 0 < c) :
    Tendsto (fun t : ℝ ↦ Real.exp (a + t * c)) atBot (nhds 0) := by
  apply Real.tendsto_exp_atBot.comp
  have hlin : Tendsto (fun t : ℝ ↦ c * t + a) atBot atBot :=
    tendsto_atBot_add_const_right atBot a (tendsto_id.const_mul_atBot hc)
  simpa only [mul_comm, add_comm] using hlin
private theorem Aj4 {b : ℕ} (hb : 0 < b)
    {i : Fin b} (hi : i ≠ Kd b hb) :
    D9 i < (b : ℝ) := by
  have hlt : i.1 + 1 < b := by
    have hle : i.1 + 1 ≤ b := by omega
    by_contra hnot
    have heq : i.1 + 1 = b := by omega
    apply hi
    apply Fin.ext
    simp only [Kd]
    omega
  change (((i.1 + 1 : ℕ) : ℝ)) < (b : ℝ)
  exact_mod_cast hlt
theorem A89 {b : ℕ} (hb : 0 < b)
    (i : Fin b) :
    Tendsto
      (fun t ↦ Oi (Kd b hb) t i)
      atTop (nhds (if i = Kd b hb then 1 else 0)) := by
  by_cases hi : i = Kd b hb
  · subst i
    simp [Oi]
  · rw [if_neg hi]
    apply AoR
    rw [Aj3]
    exact sub_neg.mpr (Aj4 hb hi)
theorem Aos {b : ℕ}
    (hb : 0 < b) :
    Tendsto
      (YK (Kd b hb))
      atTop (nhds 1) := by
  have hsum := tendsto_finsetSum (f := fun i t ↦
      Oi (Kd b hb) t i)
    (a := fun i ↦ if i = Kd b hb then 1 else 0)
    Finset.univ (fun i _ ↦ A89 hb i)
  change Tendsto
    (fun t ↦ ∑ i : Fin b,
      Oi (Kd b hb) t i)
    atTop (nhds 1)
  simpa using hsum
theorem Aou {b : ℕ}
    (hb : 0 < b) :
    Tendsto
      (YL (Kd b hb))
      atTop (nhds (b : ℝ)) := by
  have hterm : ∀ i : Fin b,
      Tendsto
        (fun t ↦ D9 i *
          Oi (Kd b hb) t i)
        atTop
        (nhds (if i = Kd b hb then (b : ℝ) else 0)) := by
    intro i
    by_cases hi : i = Kd b hb
    · subst i
      simpa using
        (A89 hb
          (Kd b hb)).const_mul
          (D9 (Kd b hb))
    · simpa [hi] using
        (A89 hb i).const_mul
          (D9 i)
  have hsum := tendsto_finsetSum (f := fun i t ↦ D9 i *
      Oi (Kd b hb) t i)
    (a := fun i ↦ if i = Kd b hb then (b : ℝ) else 0)
    Finset.univ (fun i _ ↦ hterm i)
  change Tendsto
    (fun t ↦ ∑ i : Fin b, D9 i *
      Oi (Kd b hb) t i)
    atTop (nhds (b : ℝ))
  simpa using hsum
theorem Aoq {b : ℕ} (hb : 0 < b) :
    Tendsto (Db b) atTop (nhds (b : ℝ)) := by
  rw [show Db b =
      fun t ↦ YL (Kd b hb) t /
        YK (Kd b hb) t from by
    funext t
    exact AFs (Kd b hb) t]
  have h : Tendsto
      (YL (Kd b hb) /
        YK (Kd b hb))
      atTop (nhds (b : ℝ)) := by
    simpa only [div_one] using
      (Aou hb).div
        (Aos hb)
        (by norm_num : (1 : ℝ) ≠ 0)
  convert h using 1
  ext t
  rfl
private theorem AQl {b : ℕ} (hb : 0 < b)
    {i : Fin b} (hi : i ≠ Ka b hb) :
    (1 : ℝ) < D9 i := by
  have hpos : 0 < i.1 := by
    by_contra hnot
    have hzero : i.1 = 0 := by omega
    apply hi
    apply Fin.ext
    simp [Ka, hzero]
  simp only [D9]
  exact_mod_cast (Nat.lt_add_one_iff.mpr hpos)
theorem A88 {b : ℕ} (hb : 0 < b)
    (i : Fin b) :
    Tendsto
      (fun t ↦ Oi (Ka b hb) t i)
      atBot (nhds (if i = Ka b hb then 1 else 0)) := by
  by_cases hi : i = Ka b hb
  · subst i
    simp [Oi]
  · rw [if_neg hi]
    apply AoP
    rw [Aj2]
    exact sub_pos.mpr (AQl hb hi)
theorem Aor {b : ℕ}
    (hb : 0 < b) :
    Tendsto
      (YK (Ka b hb))
      atBot (nhds 1) := by
  have hsum := tendsto_finsetSum (f := fun i t ↦
      Oi (Ka b hb) t i)
    (a := fun i ↦ if i = Ka b hb then 1 else 0)
    Finset.univ (fun i _ ↦ A88 hb i)
  change Tendsto
    (fun t ↦ ∑ i : Fin b,
      Oi (Ka b hb) t i)
    atBot (nhds 1)
  simpa using hsum
theorem Aot {b : ℕ}
    (hb : 0 < b) :
    Tendsto
      (YL (Ka b hb))
      atBot (nhds 1) := by
  have hterm : ∀ i : Fin b,
      Tendsto
        (fun t ↦ D9 i *
          Oi (Ka b hb) t i)
        atBot
        (nhds (if i = Ka b hb then 1 else 0)) := by
    intro i
    by_cases hi : i = Ka b hb
    · subst i
      simpa using
        (A88 hb
          (Ka b hb)).const_mul
          (D9 (Ka b hb))
    · simpa [hi] using
        (A88 hb i).const_mul
          (D9 i)
  have hsum := tendsto_finsetSum (f := fun i t ↦ D9 i *
      Oi (Ka b hb) t i)
    (a := fun i ↦ if i = Ka b hb then 1 else 0)
    Finset.univ (fun i _ ↦ hterm i)
  change Tendsto
    (fun t ↦ ∑ i : Fin b, D9 i *
      Oi (Ka b hb) t i)
    atBot (nhds 1)
  simpa using hsum
theorem Aop {b : ℕ} (hb : 0 < b) :
    Tendsto (Db b) atBot (nhds 1) := by
  rw [show Db b =
      fun t ↦ YL (Ka b hb) t /
        YK (Ka b hb) t from by
    funext t
    exact AFs (Ka b hb) t]
  have h : Tendsto
      (YL (Ka b hb) /
        YK (Ka b hb))
      atBot (nhds 1) := by
    simpa only [div_one] using
      (Aot hb).div
        (Aor hb)
        (by norm_num : (1 : ℝ) ≠ 0)
  convert h using 1
  ext t
  rfl
theorem AQ9 {b : ℕ} (hb : 2 ≤ b)
    {target : ℝ} (htarget : target ∈ Set.Ioo 1 (b : ℝ)) :
    ∃ t : ℝ, Db b t = target := by
  have hbPos : 0 < b := lt_of_lt_of_le Nat.zero_lt_two hb
  have hlow : ∀ᶠ t : ℝ in atBot, Db b t < target :=
    (Aop hbPos).eventually
      (Iio_mem_nhds htarget.1)
  have hhigh : ∀ᶠ t : ℝ in atTop, target < Db b t :=
    (Aoq hbPos).eventually
      (Ioi_mem_nhds htarget.2)
  obtain ⟨a, ha⟩ := hlow.exists
  obtain ⟨c, hc⟩ := hhigh.exists
  exact Set.mem_range.mp <|
    mem_range_of_exists_le_of_exists_ge
      (AMH hbPos) ⟨a, ha.le⟩ ⟨c, hc.le⟩
theorem AFt {b : ℕ} (hb : 2 ≤ b) :
    Function.Injective (Db b) :=
  (kV hb).injective
theorem AAR {b : ℕ} (hb : 2 ≤ b)
    {target : ℝ} (htarget : target ∈ Set.Ioo 1 (b : ℝ)) :
    ∃! t : ℝ, Db b t = target := by
  obtain ⟨t, ht⟩ := AQ9 hb htarget
  refine ⟨t, ht, ?_⟩
  intro u hu
  exact AFt hb (hu.trans ht.symm)
end
