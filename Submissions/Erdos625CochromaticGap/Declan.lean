section M107
namespace Erdos625
open scoped BigOperators
noncomputable section
theorem AHi
    {A B R : Type*} [Fintype A] [Fintype B]
    [DecidableEq A] [DecidableEq B] [AddCommMonoid R]
    {n : ℕ} (row : Fin n → A) (BU : B → ℕ)
    (weight : EO n row BU → R) :
    (∑ column : FL (V := Fin n) BU,
      weight (W3 row BU column)) =
      ∑ table : EO n row BU,
        Fintype.card (table.event row BU) • weight table := by
  calc
    (∑ column : FL (V := Fin n) BU,
        weight (W3 row BU column)) =
        ∑ point : Σ table : EO n row BU,
          table.event row BU, weight point.1 := by
      apply Fintype.sum_equiv
        (AAs row BU)
      intro column
      rfl
    _ = ∑ table : EO n row BU,
        ∑ AqJ : table.event row BU, weight table := by
      exact Fintype.sum_sigma _
    _ = ∑ table : EO n row BU,
        Fintype.card (table.event row BU) • weight table := by
      apply Finset.sum_congr rfl
      intro table _
      simp [Finset.sum_const]
theorem AyA
    {A B : Type*} [Fintype A] [Fintype B]
    [DecidableEq A] [DecidableEq B]
    {n : ℕ} (row : Fin n → A) (BU : B → ℕ)
    (weight : EO n row BU → ℚ) :
    (∑ column : FL (V := Fin n) BU,
      weight (W3 row BU column)) =
      ∑ table : EO n row BU,
        (Fintype.card (table.event row BU) : ℚ) * weight table := by
  simpa only [nsmul_eq_mul] using
    (AHi
      row BU weight)
theorem A7w
    {b n : ℕ} {R : Type*} {k : AG b} [AddCommMonoid R]
    (row : Ac n k) (weight : Eb n k → R) :
    (∑ column : Ac n k,
      weight (G7 row column)) =
      ∑ table : Eb n k,
        Fintype.card ((Vf row table).event row.1
          (AO k)) • weight table := by
  calc
    (∑ column : Ac n k,
        weight (G7 row column)) =
        ∑ table : EO n row.1 (AO k),
          Fintype.card (table.event row.1 (AO k)) •
            weight (XI row table) := by
      simpa only [G7] using
        (AHi
          row.1 (AO k)
          (fun table => weight (XI row table)))
    _ = ∑ table : Eb n k,
        Fintype.card ((Vf row table).event row.1
          (AO k)) • weight table := by
      calc
        (∑ table : EO n row.1 (AO k),
          Fintype.card (table.event row.1 (AO k)) •
            weight (XI row table)) =
            ∑ table : Eb n k,
              Fintype.card ((Vf row table).event row.1
                (AO k)) •
                  weight (XI row
                    (Vf row table)) :=
          (Equiv.sum_comp (Vf row)
            (fun table : EO n row.1 (AO k) =>
              Fintype.card (table.event row.1 (AO k)) •
                weight (XI row table))).symm
        _ = ∑ table : Eb n k,
