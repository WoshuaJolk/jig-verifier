section M050
namespace Erdos625
open scoped BigOperators
noncomputable section
set_option autoImplicit false
theorem VZ (alpha : Nat)
    (A8 : 5 < alpha) (k : AG (alpha + 1))
    (AN : CZ alpha A8 k)
    (a : Σ i : Fin 4, Fin (Bz alpha A8 k i)) :
    AO k
        (Bc alpha A8 k AN a) =
      BK alpha A8 a.1 := by
  have hmem := (AN a.1 a.2).2
  have hEq : AO k (AN a.1 a.2).1 =
      BK alpha A8 a.1 := by
    simpa only [GR, Finset.mem_filter,
      Finset.mem_univ, true_and] using hmem
  exact hEq
theorem M4 (alpha : Nat)
    (A8 : 5 < alpha) (k : AG (alpha + 1))
    (AN : CZ alpha A8 k) :
    Function.Injective
      (Bc alpha A8 k AN) := by
  rintro ⟨i, a⟩ ⟨j, b⟩ hab
  have hs : BK alpha A8 i =
      BK alpha A8 j := by
    rw [← VZ
      alpha A8 k AN ⟨i, a⟩,
      ← VZ
      alpha A8 k AN ⟨j, b⟩, hab]
  have hij : i = j := by
    have hi := (c7 alpha A8 k).1 i
    have hj := (c7 alpha A8 k).1 j
    rw [hi, hj] at hs
    apply Fin.ext
    omega
  subst j
  have hab' : AN i a = AN i b := by
    exact Subtype.ext hab
  have : a = b := (AN i).injective hab'
  subst b
  rfl
noncomputable def NW
    (alpha : Nat) (A8 : 5 < alpha) (k : AG (alpha + 1))
    (L : Bh)
    (AN : CZ alpha A8 k)
    (D : J9 alpha A8 k L)
    (e : ↥D.1.1.edges)
    (p : Cj (fun _ : Unit => BK alpha A8 e.1.1.1) ×
      Cm (fun _ : Unit => BK alpha A8 e.1.2.1)) :
    Cj (AO k) × Cm (AO k) :=
  let ha := VZ
    alpha A8 k AN e.1.1
  let hb := VZ
    alpha A8 k AN e.1.2
  (⟨Bc alpha A8 k AN e.1.1,
      ⟨p.1.2.val, by rw [ha]; exact p.1.2.isLt⟩⟩,
   ⟨Bc alpha A8 k AN e.1.2,
      ⟨p.2.2.val, by rw [hb]; exact p.2.2.isLt⟩⟩)
noncomputable def XU
    (alpha : Nat) (A8 : 5 < alpha) (k : AG (alpha + 1))
