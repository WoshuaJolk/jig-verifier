  rw [Nat.card_eq_fintype_card]
  change Fintype.card (BT n k) = m.bell
  have hD : 0 < D := by
    dsimp only [D]
    apply Nat.mul_pos
    · apply Multiset.prod_pos
      intro a ha
      obtain ⟨x, _hx, rfl⟩ := Multiset.mem_map.mp ha
