            Fd exceptional p N -
          tilt * KO exceptional p N)
    (hmass : Tendsto (Fd exceptional p)
      atTop (nhds 1))
    (Se : Tendsto (KO exceptional p)
      atTop (nhds target))
    (Qv : Tendsto (KM q exceptional p)
      atTop (nhds L7))
    (ow :
      Bd q tilt /
          ProfileEntropyS4.partition Ak tilt <
        (153 / 100 : ℝ)) :
    Real.log (200 / 153 : ℝ) <
      q - (L7 -
        ProfileEntropyS4.D7 Ak target) := by
  apply AGx ZJ
  · exact wP
      UA hp hfinite hmass Se Qv
  · exact ow
theorem AxZ
    {L7 exceptional : ℝ} {p : ℕ → ℝ}
    (UA : 0 ≤ exceptional)
    (hp : ∀ d, 0 ≤ p d)
    (hfinite : 0 ≤ exceptional → (∀ d, 0 ≤ p d) → ∀ N,
