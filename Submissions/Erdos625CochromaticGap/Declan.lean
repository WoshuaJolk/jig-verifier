  ENNReal.div_mul_cancel
    (A0l row₀)
    (A0k n k)
theorem A9o
    {b n : ℕ} {k : AG b}
    (row₀ : Ac n k) (x y : ENNReal) :
    x / DY n k ^ 2 = y ↔
      x = DY n k ^ 2 * y := by
  let d : ENNReal := DY n k ^ 2
  have hd0 : d ≠ 0 := by
    simpa only [d] using
      A0l row₀
  have hdtop : d ≠ ∞ := by
    simpa only [d] using A0k n k
  constructor
  · intro h
    calc
      x = (x / d) * d := (ENNReal.div_mul_cancel hd0 hdtop).symm
      _ = y * d := by rw [h]
      _ = d * y := by ac_rfl
  · intro h
    change x / d = y
    rw [h, ENNReal.div_eq_inv_mul]
    calc
      d⁻¹ * (d * y) = (d⁻¹ * d) * y := by ac_rfl
      _ = y := by rw [ENNReal.inv_mul_cancel hd0 hdtop, one_mul]
theorem AF1
    {b n : ℕ} {k : AG b}
    (row₀ : Ac n k) {secondMoment normalized : ENNReal}
    (h : secondMoment = DY n k ^ 2 * normalized) :
    secondMoment / DY n k ^ 2 = normalized :=
  (A9o
    row₀ secondMoment normalized).mpr h
theorem Aw1
    {b n : ℕ} {k : AG b}
    (row₀ : Ac n k) {secondMoment normalized : ENNReal}
    (h : secondMoment = normalized * DY n k ^ 2) :
    secondMoment / DY n k ^ 2 = normalized :=
  AF1 row₀
    (by simpa [mul_comm] using h)
theorem ArL
    {b n : ℕ} {k : AG b}
    (row₀ : Ac n k) {secondMoment normalized : ENNReal}
    (h : secondMoment / DY n k ^ 2 = normalized) :
    secondMoment = DY n k ^ 2 * normalized :=
  (A9o
    row₀ secondMoment normalized).mp h
end
