    ⟨FJ, Nt, AL8⟩
  refine ⟨witness, ?_⟩
  rw [aZ]
  intro a b stub
  change matching ⟨a, stub.1⟩ = ⟨b, Yp a b stub⟩
  exact sP _ (UC a b stub)
noncomputable instance AvB
    {A B : Type*}
    [Fintype A] [Fintype B] [DecidableEq A] [DecidableEq B]
    (demand : A → B → ℕ) (row : A → ℕ) (col : B → ℕ) :
    Fintype
