    (S : ℕ → Type*)
    (A1P : ∀ n, S n → ℝ)
    (m₀ : ∀ n, S n → ℕ)
    (C : ℝ) (hC : 0 ≤ C)
    (Fw : ∀ᶠ n : ℕ in atTop,
      ∀ s : S n,
        (n : ℝ) / Real.log (n : ℝ) ^ 6 ≤ (m₀ n s : ℝ) →
        A1P n s ≤ Real.exp (C * Real.log (n : ℝ) ^ 8))
