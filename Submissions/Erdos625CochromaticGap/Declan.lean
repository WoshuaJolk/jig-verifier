    symm
    apply Finset.card_bij
      (fun a _ => (QS P)
        ⟨(a, b), hF (a, b) (by simpa [Vw] using ‹a ∈ Vw F b›)⟩)
    · intro a ha
      simp only [Uv, Finset.mem_filter,
        Finset.mem_univ, true_and]
      constructor
      · simp [XB, Finset.mem_subtype,
          Vw] at ha ⊢
        exact ha
      · simp [QS]
    · intro a₁ ha₁ a₂ ha₂ heq
      have := (QS P).injective heq
      simpa using congrArg (fun e => e.1.1) this
    · intro e he
      simp only [Uv, Finset.mem_filter,
        Finset.mem_univ, true_and] at he
      obtain ⟨heF, heVertex⟩ := he
