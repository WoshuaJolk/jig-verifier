            Ld Ol (fun x ↦ Real.exp (t * (fₐ a x - ED m)))) ≤
          ED (fun a ↦ R * Real.exp (t * (m a - ED m))) := by
            exact A2V AYy
        _ = R * ED (fun a ↦ Real.exp (t * (m a - ED m))) :=
          AAn _ _
        _ ≤ R * Real.exp (((c 0 : ℝ) / 2) ^ 2 * t ^ 2 / 2) := by
          exact mul_le_mul_of_nonneg_left hhead (Real.exp_nonneg _)
        _ = Real.exp ((Ou c : ℝ) * t ^ 2 / 2) := by
          rw [AJe]
          push_cast
          rw [← Real.exp_add]
          congr 1
          dsimp only [R, c']
          ring
noncomputable def W2 {n : ℕ} (Omega : Fin n → Type u)
    [∀ i, Fintype (Omega i)] [∀ i, Nonempty (Omega i)]
    (f : (∀ i, Omega i) → ℝ) : ℝ :=
  @MeasureTheory.integral (∀ i, Omega i) ℝ _ _ ⊤ (S7 Omega) f
theorem AJZ {n : ℕ} (Omega : Fin n → Type u)
    [∀ i, Fintype (Omega i)] [∀ i, Nonempty (Omega i)]
    (f : (∀ i, Omega i) → ℝ) :
    W2 Omega f = Ld Omega f := by
  exact AE9 Omega f
theorem vF {n : ℕ}
    {Omega : Fin n → Type u} [∀ i, Fintype (Omega i)]
    [∀ i, Nonempty (Omega i)]
    {f : (∀ i, Omega i) → ℝ} {c : Fin n → ℝ≥0}
    (h : RH f c) :
    @HasSubgaussianMGF (∀ i, Omega i) ⊤
      (fun x ↦ f x - W2 Omega f)
      (Ou c) (S7 Omega) := by
  letI : MeasurableSpace (∀ i, Omega i) := ⊤
  letI : IsProbabilityMeasure (S7 Omega) := by
    dsimp only [S7]
    infer_instance
  have hmean : W2 Omega f = Ld Omega f :=
    AJZ Omega f
  constructor
  · intro t
    have hi : IntegrableOn
        (fun x ↦ Real.exp (t * (f x - W2 Omega f)))
        Set.univ (S7 Omega) :=
      IntegrableOn.of_finite Set.finite_univ
    change Integrable
      (fun x ↦ Real.exp (t * (f x - W2 Omega f)))
      ((S7 Omega).restrict Set.univ) at hi
    rw [Measure.restrict_univ] at hi
    exact hi
  · intro t
    rw [ProbabilityTheory.mgf, AE9, hmean]
    exact AJa n Omega f c h t
theorem A8i {n : ℕ}
    {Omega : Fin n → Type u} [∀ i, Fintype (Omega i)]
    [∀ i, Nonempty (Omega i)]
    {f : (∀ i, Omega i) → ℝ} {c : Fin n → ℝ≥0}
    (h : RH f c) {t : ℝ} (ht : 0 ≤ t) :
    (S7 Omega).real
        {x | t ≤ f x - W2 Omega f} ≤
      Real.exp (-t ^ 2 / (2 * Ou c)) :=
  by
    letI : MeasurableSpace (∀ i, Omega i) := ⊤
    exact (vF h).measure_ge_le ht
theorem A8h {n : ℕ}
    {Omega : Fin n → Type u} [∀ i, Fintype (Omega i)]
    [∀ i, Nonempty (Omega i)]
    {f : (∀ i, Omega i) → ℝ} {c : Fin n → ℝ≥0}
    (h : RH f c) {t : ℝ} (ht : 0 ≤ t) :
    (S7 Omega).real
        {x | t ≤ |f x - W2 Omega f|} ≤
      2 * Real.exp (-t ^ 2 / (2 * Ou c)) :=
  by
    letI : MeasurableSpace (∀ i, Omega i) := ⊤
    exact AHB (vF h) ht
@[simp]
theorem AqU {n : ℕ} :
    Ou (fun _ : Fin n ↦ (0 : ℝ≥0)) = 0 := by
  simp [Ou]
theorem AYW {n : ℕ}
    {Omega : Fin n → Type u} [∀ i, Subsingleton (Omega i)]
    (f : (∀ i, Omega i) → ℝ) :
    RH f (fun _ ↦ 0) := by
  intro i x y _hxy
  have hxy : x = y := by
    funext j
    exact Subsingleton.elim _ _
  simp [hxy]
theorem AJX {n : ℕ}
    {Omega : Fin n → Type u} [∀ i, Fintype (Omega i)]
    [∀ i, Nonempty (Omega i)]
    {f : (∀ i, Omega i) → ℝ}
    (h : RH f (fun _ ↦ 0)) :
    @HasSubgaussianMGF (∀ i, Omega i) ⊤
      (fun x ↦ f x - W2 Omega f) 0 (S7 Omega) := by
  simpa using vF h
theorem AqT {n : ℕ}
    {Omega : Fin n → Type u} [∀ i, Fintype (Omega i)]
    [∀ i, Nonempty (Omega i)] [∀ i, Subsingleton (Omega i)]
    (f : (∀ i, Omega i) → ℝ) :
    @HasSubgaussianMGF (∀ i, Omega i) ⊤
      (fun x ↦ f x - W2 Omega f) 0 (S7 Omega) := by
  exact AJX
    (AYW f)
end Erdos625
end M373

section M374
open MeasureTheory Set
open scoped ENNReal NNReal
namespace Erdos625
abbrev XG {n : ℕ} (v : Fin n) := Fin v.val → Bool
abbrev Oq (n : ℕ) := ∀ v : Fin n, XG v
def Rj {n : ℕ} (v : Fin n) (u : Fin v.val) : Fin n :=
  ⟨u.val, lt_trans u.isLt v.isLt⟩
@[simp]
theorem AEU {n : ℕ} (v : Fin n) (u : Fin v.val) :
    (Rj v u).val = u.val := rfl
theorem AfV {n : ℕ} (v : Fin n) (u : Fin v.val) :
    Rj v u < v := u.isLt
def Km {n : ℕ} (x : Oq n) : LabeledGraph n :=
  SimpleGraph.fromRel fun u v ↦
    ∃ h : u.val < v.val, x v ⟨u.val, h⟩ = true
noncomputable def Xf {n : ℕ} (G : LabeledGraph n) : Oq n :=
  by
    classical
    exact fun v u ↦ decide (G.Adj (Rj v u) v)
theorem Zw {n : ℕ} (x : Oq n)
    (v : Fin n) (u : Fin v.val) :
    (Km x).Adj (Rj v u) v ↔ x v u = true := by
  change
    (SimpleGraph.fromRel fun a b : Fin n ↦
      ∃ h : a.val < b.val, x b ⟨a.val, h⟩ = true).Adj
        (Rj v u) v ↔ x v u = true
  rw [SimpleGraph.fromRel_adj]
  constructor
  · rintro ⟨_, ⟨h, hx⟩ | ⟨h, _⟩⟩
    · simpa only [AEU] using hx
    · exact (Nat.not_lt_of_ge (Nat.le_of_lt u.isLt) h).elim
  · intro hx
    refine ⟨?_, Or.inl ⟨u.isLt, ?_⟩⟩
    · exact ne_of_lt (AfV v u)
    · simpa only [AEU] using hx
theorem ABc {n : ℕ} (x : Oq n) :
    Xf (Km x) = x := by
  classical
  funext v u
  change decide ((Km x).Adj (Rj v u) v) = x v u
  rw [Zw]
  cases x v u <;> simp
theorem A8m {n : ℕ} (G : LabeledGraph n) :
    Km (Xf G) = G := by
  ext u v
  rcases lt_trichotomy u.val v.val with huv | huv | huv
  · let a : Fin v.val := ⟨u.val, huv⟩
    have hua : Rj v a = u := Fin.ext rfl
    rw [← hua, Zw]
    simp only [Xf, decide_eq_true_eq, hua]
  · have huv' : u = v := Fin.ext huv
    subst v
    simp
  · let a : Fin u.val := ⟨v.val, huv⟩
    have hva : Rj u a = v := Fin.ext rfl
    calc
      (Km (Xf G)).Adj u v ↔
          (Km (Xf G)).Adj (Rj u a) u := by
            rw [hva, SimpleGraph.adj_comm]
      _ ↔ Xf G u a = true := Zw _ _ _
      _ ↔ G.Adj (Rj u a) u := by
        simp only [Xf, decide_eq_true_eq]
      _ ↔ G.Adj u v := by rw [hva, SimpleGraph.adj_comm]
noncomputable def AyU (n : ℕ) : Oq n ≃ LabeledGraph n where
  toFun := Km
  invFun := Xf
  left_inv := ABc
  right_inv := A8m
theorem AL0 (n : ℕ) :
    Fintype.card (Oq n) = 2 ^ n.choose 2 := by
  classical
  rw [Fintype.card_pi]
  simp only [XG, Fintype.card_fun, Fintype.card_fin, Fintype.card_bool]
  rw [Finset.prod_pow_eq_pow_sum]
  congr 1
  calc
    ∑ i : Fin n, i.val = ∑ i ∈ Finset.range n, i := by
      simpa using (Fin.sum_univ_eq_sum_range (fun i : ℕ ↦ i) n)
    _ = n * (n - 1) / 2 := Finset.sum_range_id n
    _ = n.choose 2 := (Nat.choose_two_right n).symm
noncomputable def YZ (n : ℕ) :
    @Measure (Oq n) ⊤ :=
  S7 (fun v : Fin n ↦ XG v)
theorem Apu (n : ℕ) (x : Oq n) :
    YZ n {x} = (1 / 2 : ENNReal) ^ n.choose 2 := by
  letI : MeasurableSpace (Oq n) := ⊤
  unfold YZ S7 A8l wT
  rw [PMF.toMeasure_apply_singleton _ _ (by simp)]
  rw [PMF.uniformOfFintype_apply, AL0]
  simpa only [Nat.cast_ofNat, Nat.cast_pow, one_div] using
    (ENNReal.inv_pow (a := (2 : ENNReal)) (n := n.choose 2))
theorem A6e (n : ℕ) :
    @Measurable (Oq n) (LabeledGraph n) ⊤ _ Km := by
  letI : MeasurableSpace (Oq n) := ⊤
  exact measurable_of_finite _
theorem AEX (n : ℕ) :
    @Measure.map (Oq n) (LabeledGraph n) ⊤ _ Km
        (YZ n) = randomGraphMeasure n := by
  apply Measure.ext_of_singleton
  intro G
  rw [Measure.map_apply (A6e n)
    (measurableSet_singleton G)]
  have hpre : Km ⁻¹' ({G} : Set (LabeledGraph n)) =
      {Xf G} := by
    ext x
    simp only [Set.mem_preimage, Set.mem_singleton_iff]
    constructor
    · intro hx
      rw [← hx]
      exact (ABc x).symm
    · intro hx
      rw [hx]
      exact A8m G
  rw [hpre, Apu,
    Wt]
theorem tq (n : ℕ)
    (A : Set (LabeledGraph n)) :
    YZ n (Km ⁻¹' A) = randomGraphMeasure n A := by
  have hA : MeasurableSet A := Set.toFinite A |>.measurableSet
  have h := congrArg (fun μ : Measure (LabeledGraph n) ↦ μ A)
    (AEX n)
  rw [Measure.map_apply (A6e n) hA] at h
  exact h
theorem AJf {n : ℕ}
    {x y : Oq n} {i u v : Fin n}
    (hxy : ∀ j, j ≠ i → x j = y j) (hu : u ≠ i) (hv : v ≠ i) :
    (Km x).Adj u v ↔ (Km y).Adj u v := by
  rcases lt_trichotomy u.val v.val with huv | huv | huv
  · let a : Fin v.val := ⟨u.val, huv⟩
    have hua : Rj v a = u := Fin.ext rfl
    rw [← hua, Zw, Zw, hxy v hv]
  · have huv' : u = v := Fin.ext huv
    subst v
    simp
  · let a : Fin u.val := ⟨v.val, huv⟩
    have hva : Rj u a = v := Fin.ext rfl
    calc
      (Km x).Adj u v ↔
          (Km x).Adj (Rj u a) u := by
            rw [hva, SimpleGraph.adj_comm]
      _ ↔ x u a = true := Zw _ _ _
      _ ↔ y u a = true := by rw [hxy u hu]
      _ ↔ (Km y).Adj (Rj u a) u :=
        (Zw _ _ _).symm
      _ ↔ (Km y).Adj u v := by
        rw [hva, SimpleGraph.adj_comm]
theorem AJg {n : ℕ} {x y : Oq n}
    {i : Fin n} (hxy : ∀ j, j ≠ i → x j = y j) :
    (Km x).induce {v | v ≠ i} =
      (Km y).induce {v | v ≠ i} := by
  ext u v
  exact AJf hxy u.property v.property
def lB {n : ℕ} (F : LabeledGraph n → ℝ)
    (c : Fin n → ℝ≥0) : Prop :=
  ∀ i G H, G.induce {v | v ≠ i} = H.induce {v | v ≠ i} →
    |F G - F H| ≤ (c i : ℝ)
theorem lB.hasBlockOscillation {n : ℕ}
    {F : LabeledGraph n → ℝ} {c : Fin n → ℝ≥0}
    (h : lB F c) :
    RH (fun x : Oq n ↦ F (Km x)) c := by
  intro i x y hxy
  exact h i (Km x) (Km y)
    (AJg hxy)
noncomputable def Rq {n : ℕ}
    (F : LabeledGraph n → ℝ) : ℝ :=
  W2 (fun v : Fin n ↦ XG v)
    (fun x : Oq n ↦ F (Km x))
theorem Ax1 {n : ℕ}
    {F : LabeledGraph n → ℝ} {c : Fin n → ℝ≥0}
    (h : lB F c) {t : ℝ} (ht : 0 ≤ t) :
    (randomGraphMeasure n).real
        {G | t ≤ F G - Rq F} ≤
      Real.exp (-t ^ 2 / (2 * Ou c)) := by
  have hb := A8i
    (Omega := fun v : Fin n ↦ XG v)
    h.hasBlockOscillation ht
  change (randomGraphMeasure n
    {G | t ≤ F G - Rq F}).toReal ≤ _
  rw [← tq]
  simpa only [Set.preimage_setOf_eq, Rq,
    YZ, Measure.real] using hb
theorem Ax0 {n : ℕ}
    {F : LabeledGraph n → ℝ} {c : Fin n → ℝ≥0}
    (h : lB F c) {t : ℝ} (ht : 0 ≤ t) :
    (randomGraphMeasure n).real
        {G | t ≤ |F G - Rq F|} ≤
      2 * Real.exp (-t ^ 2 / (2 * Ou c)) := by
  have hb := A8h
    (Omega := fun v : Fin n ↦ XG v)
    h.hasBlockOscillation ht
  change (randomGraphMeasure n
    {G | t ≤ |F G - Rq F|}).toReal ≤ _
  rw [← tq]
  simpa only [Set.preimage_setOf_eq, Rq,
    YZ, Measure.real] using hb
end Erdos625
