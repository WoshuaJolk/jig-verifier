        (MQ S.1 i j r').1 = p.1 := by
      simpa [r', p] using sw S.1 i j r'
    have RY := S.1.leftUnique _ A2v _ A3O (by
      exact Sigma.ext rfl (heq_of_eq OX))
    have NY :
        (MQ S.1 i j r').2 = p.2 :=
      eq_of_heq (Sigma.mk.inj_iff.mp (congrArg Prod.snd RY)).2
    change
      YV
          (tj L k ell S)
          ⟨i, j, r'⟩ =
        ((⟨i, r⟩, ⟨j, c⟩) :
          Cj k × Cm ell)
    rw [AGO L k ell S i j r']
    apply Prod.ext
    · exact Sigma.ext rfl (heq_of_eq rfl)
    · exact Sigma.ext rfl (heq_of_eq (by simpa [p] using NY))
private theorem AI7
    {I J : Type*}
    [Fintype I] [Fintype J] [DecidableEq I] [DecidableEq J]
    {L : I -> J -> Nat} {k : I -> Nat} {ell : J -> Nat}
    (matching : Jv L k ell) (i : I) (j : J) :
    (OI matching).rowCell i j =
      (matching.FJ i).1 j := by
  ext r
  simp [Bm.rowCell,
    Bm.cellEdges,
    OI,
    YV,
    tZ,
    A15,
    YW]
private theorem AI6
    {I J : Type*}
    [Fintype I] [Fintype J] [DecidableEq I] [DecidableEq J]
    {L : I -> J -> Nat} {k : I -> Nat} {ell : J -> Nat}
    (matching : Jv L k ell) (i : I) (j : J) :
    (OI matching).Lj i j =
      (matching.Ov j).1 i := by
  ext c
  constructor
  · intro hc
    rw [Bm.Lj, Finset.mem_image] at hc
    obtain ⟨p, hp, rfl⟩ := hc
    rw [Bm.cellEdges, Finset.mem_filter] at hp
    obtain ⟨_, hp⟩ := hp
    rw [OI, Finset.mem_map] at hp
    obtain ⟨atom, _, hAtom⟩ := hp
    have hRow := congrArg Prod.fst hAtom
    have Pz := congrArg Prod.snd hAtom
    obtain ⟨i', j', r⟩ := atom
    simp [YV,
      tZ,
      A15,
      YW] at hRow Pz
    obtain ⟨hI, _⟩ := hRow
    obtain ⟨hJ, hC⟩ := Pz
    subst i'
    subst j'
    rw [← eq_of_heq hC]
    exact (matching.pairing i j r).2
  · intro hc
    let c' :
        ((matching.Ov j).1 i :
          Finset (Fin (ell j))) := ⟨c, hc⟩
    let r' := (matching.pairing i j).symm c'
    let p : Fin (k i) × Fin (ell j) := (r'.1, c)
    rw [Bm.Lj, Finset.mem_image]
    refine ⟨p, ?_, rfl⟩
    rw [Bm.cellEdges, Finset.mem_filter]
    refine ⟨Finset.mem_univ _, ?_⟩
    rw [OI, Finset.mem_map]
    refine ⟨(⟨i, j, r'⟩ :
      TY matching), Finset.mem_univ _, ?_⟩
    apply Prod.ext
    · exact Sigma.ext rfl (heq_of_eq rfl)
    · change
        (YV matching
          (⟨i, j, r'⟩ : TY matching)).2 =
          (⟨j, c⟩ : Cm ell)
      change
        (⟨j, ((matching.pairing i j) r' : Fin (ell j))⟩ :
          Cm ell) =
          ⟨j, c⟩
      exact Sigma.ext rfl (heq_of_eq (by
        change ((matching.pairing i j) r' : Fin (ell j)) = c
        simp [r', c']))
private theorem ApU
    {I J : Type*}
    [Fintype I] [Fintype J] [DecidableEq I] [DecidableEq J]
    {L : I -> J -> Nat} {k : I -> Nat} {ell : J -> Nat} :
    Function.Injective
      (OI :
        Jv L k ell ->
          Bm k ell) := by
  intro matching₁ matching₂ Q7
  have hRows :
      matching₁.FJ = matching₂.FJ := by
    funext i
    apply Subtype.ext
    funext j
    rw [← AI7 matching₁ i j,
      Q7,
      AI7 matching₂ i j]
  have ASf :
      matching₁.Ov = matching₂.Ov := by
    funext j
    apply Subtype.ext
    funext i
    rw [← AI6 matching₁ i j,
      Q7,
      AI6 matching₂ i j]
  obtain ⟨rowAllocation₁, columnAllocation₁, pairing₁⟩ := matching₁
  obtain ⟨rowAllocation₂, columnAllocation₂, pairing₂⟩ := matching₂
  simp only at hRows ASf
  subst rowAllocation₂
  subst columnAllocation₂
  have Ast : pairing₁ = pairing₂ := by
    funext i j
    apply Equiv.ext
    intro r
    let matching₁ : Jv L k ell :=
      { FJ := rowAllocation₁
        Ov := columnAllocation₁
        pairing := pairing₁ }
    let matching₂ : Jv L k ell :=
      { FJ := rowAllocation₁
        Ov := columnAllocation₁
        pairing := pairing₂ }
    let atom₁ : TY matching₁ := ⟨i, j, r⟩
    let atom₂ : TY matching₂ := ⟨i, j, r⟩
    let edge₁ := YV matching₁ atom₁
    let edge₂ := YV matching₂ atom₂
    have hEdge₁ :
        edge₁ ∈
          (OI matching₁).edges := by
      simp [edge₁, atom₁, OI]
    have hEdge₂ :
        edge₂ ∈
          (OI matching₂).edges := by
      simp [edge₂, atom₂, OI]
    have AWh :
        OI matching₁ =
          OI matching₂ := by
      simpa [matching₁, matching₂] using Q7
    have hEdge₁' :
        edge₁ ∈
          (OI matching₂).edges := by
      rw [← AWh]
      exact hEdge₁
    have hLeft : edge₁.1 = edge₂.1 := by
      rfl
    have RY :=
      (OI matching₂).leftUnique
        edge₁ hEdge₁' edge₂ hEdge₂ hLeft
    apply Subtype.ext
    exact eq_of_heq
      (Sigma.mk.inj_iff.mp (congrArg Prod.snd RY)).2
  subst pairing₂
  rfl
noncomputable def A8G
    {I J : Type*}
    [Fintype I] [Fintype J] [DecidableEq I] [DecidableEq J]
    (L : I -> J -> Nat) (k : I -> Nat) (ell : J -> Nat) :
    Jv L k ell ≃
      {S : Bm k ell // S.typeTable = L} :=
  Equiv.ofBijective
    (AI5 L k ell)
    ⟨by
      intro matching₁ matching₂ h
      apply ApU
      exact congrArg Subtype.val h,
    by
      intro S
      refine ⟨tj L k ell S, ?_⟩
      apply Subtype.ext
      apply Bm.ext
      exact Aph L k ell S⟩
theorem A9D
    {I J : Type*}
    [Fintype I] [Fintype J] [DecidableEq I] [DecidableEq J]
    (L : I -> J -> Nat) (k : I -> Nat) (ell : J -> Nat) :
    Fintype.card
          {S : Bm k ell // S.typeTable = L} *
        Finset.univ.prod
          (fun i => Finset.univ.prod (fun j => (L i j).factorial)) =
      (Finset.univ.prod
          (fun i => (k i).descFactorial (Finset.univ.sum (L i)))) *
      (Finset.univ.prod
          (fun j =>
            (ell j).descFactorial
              (Finset.univ.sum (fun i => L i j)))) := by
  rw [← Fintype.card_congr
    (A8G L k ell)]
  exact AKx L k ell
end
