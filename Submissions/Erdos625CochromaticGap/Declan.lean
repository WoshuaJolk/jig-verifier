    dsimp [p]
    split_ifs <;> first | exact hw0 _ | exact le_rfl
  have A5n (d : ℕ) (hd : 6 ≤ d) : p d = 0 := by
    have h2 : d ≠ 2 := by omega
    have h3 : d ≠ 3 := by omega
    have h4 : d ≠ 4 := by omega
    have h5 : d ≠ 5 := by omega
    simp [p, h2, h3, h4, h5]
  have PS (i : Fin 4) :
      Ly q (i.1 + 2) = Ak i := by
    simp [Ly, Ak,
      ProfileEntropyS4.support]
    ring
  have hfinite (N : ℕ) :
      KM q 0 p N ≤
        Py q 0 N -
          Fd 0 p N +
          Real.log (Bd q 0) *
            Fd 0 p N := by
    have hZ : 0 < Bd q 0 :=
      Tw q_pos
    have hterm (d : ℕ) :
        -p d * Real.log (p d) + p d * Ly q d ≤
          B8 q 0 d / Bd q 0 - p d +
            Real.log (Bd q 0) * p d := by
      have hy : 0 < B8 q 0 d /
          Bd q 0 :=
        div_pos (Nu q 0 d) hZ
      have hh := ProfileEntropyS4.ZU (hp0 d) hy
      have hlog : Real.log (B8 q 0 d /
            Bd q 0) =
          Ly q d -
            Real.log (Bd q 0) := by
        rw [Real.log_div (Nu q 0 d).ne'
          hZ.ne', B8, Real.log_exp]
        simp [Ly]
