namespace TW
def weight {V : Type*}
    (K P : V → V → ℝ≥0∞) (x : V) {L : ℕ} {v : V}
    (code : TW V L v) : ℝ≥0∞ :=
  code.2.weight K * P code.1 x
@[simp]
theorem Aq0 {V : Type*}
    (K P : V → V → ℝ≥0∞) {L : ℕ} {v u x : V}
    (path : NG V L v u) :
    weight K P x (Sigma.mk u path :
      TW V L v) =
      path.weight K * P u x := rfl
end TW
theorem AHY
    {V : Type*} [Fintype V] [DecidableEq V]
    (K P : V → V → ℝ≥0∞) (L : ℕ) (v x : V) :
    (∑ code : TW V L v,
        code.weight K P x) =
      JI (JK K L) P v x := by
  rw [Fintype.sum_sigma]
  unfold JI
  apply Finset.sum_congr rfl
  intro u hu
  change
    (∑ path : NG V L v u,
        path.weight K * P u x) =
      JK K L v u * P u x
  rw [← Finset.sum_mul]
  rw [Anl]
def E9 (V : Type*) (L : ℕ) : ℕ → V → V → Type _
  | 0, v, w => FH V 0 v w
  | r + 1, v, w =>
      Σ x : V,
        TW V L v ×
          E9 V L r x w
noncomputable instance AvF
    {V : Type*} [Fintype V] [DecidableEq V]
    (L r : ℕ) (v w : V) : Fintype (E9 V L r v w) := by
  induction r generalizing v with
  | zero =>
      change Fintype (FH V 0 v w)
      infer_instance
  | succ r ih =>
      change Fintype
        (Σ x : V,
          TW V L v ×
            E9 V L r x w)
      letI (x : V) : Fintype (E9 V L r x w) := ih x
      infer_instance
namespace E9
def weight {V : Type*} (K P : V → V → ℝ≥0∞) {L : ℕ} :
    {r : ℕ} → {v w : V} → E9 V L r v w → ℝ≥0∞
  | 0, _, _, code => FH.weight K code
  | _ + 1, _, _, code =>
      code.2.1.weight K P code.1 * weight K P code.2.2
@[simp]
theorem Aq1 {V : Type*}
    (K P : V → V → ℝ≥0∞) {L : ℕ} {v w : V}
    (code : E9 V L 0 v w) :
    code.weight K P = 1 := rfl
@[simp]
theorem A8K {V : Type*}
    (K P : V → V → ℝ≥0∞) {L r : ℕ} {v w : V}
    (code : E9 V L (r + 1) v w) :
    code.weight K P =
      code.2.1.weight K P code.1 * code.2.2.weight K P := rfl
end E9
theorem AHe
    {V : Type*} [Fintype V] [DecidableEq V]
    (K P : V → V → ℝ≥0∞) (L r : ℕ) (v w : V) :
    (∑ code : E9 V L r v w,
        code.weight K P) =
      Fe
        (JI (JK K L) P) r v w := by
  induction r generalizing v with
  | zero =>
      change
        (∑ code : FH V 0 v w, code.weight K) =
          Fe
            (JI (JK K L) P) 0 v w
      exact
        A7r
          (JI (JK K L) P) 0 v w
  | succ r ih =>
      change
        (∑ code :
            Σ x : V,
              TW V L v ×
                E9 V L r x w,
            code.2.1.weight K P code.1 * code.2.2.weight K P) =
          ∑ x,
            JI (JK K L) P v x *
              Fe
                (JI (JK K L) P) r x w
      rw [Fintype.sum_sigma]
      apply Finset.sum_congr rfl
      intro x hx
      rw [Fintype.sum_prod_type]
      calc
        (∑ block : TW V L v,
            ∑ tail : E9 V L r x w,
              block.weight K P x * tail.weight K P) =
            ∑ block : TW V L v,
              block.weight K P x *
                ∑ tail : E9 V L r x w,
                  tail.weight K P := by
            apply Finset.sum_congr rfl
            intro block FU
            rw [Finset.mul_sum]
        _ =
            (∑ block : TW V L v,
                block.weight K P x) *
              ∑ tail : E9 V L r x w,
                tail.weight K P := by
            rw [Finset.sum_mul]
        _ =
            JI (JK K L) P v x *
              Fe
                (JI (JK K L) P) r x w := by
            rw [
              AHY,
              ih x]
#print axioms
  AHY
#print axioms
  AHe
end
