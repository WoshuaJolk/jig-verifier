    {V : Type*} [Fintype V] [DecidableEq V]
    (G : SimpleGraph V) [DecidableRel G.Adj] :
    Nat.card (Zp G) =
      2 ^ Fintype.card G.ConnectedComponent := by
  rw [Nat.card_congr (ALw G), Nat.card_fun,
    Nat.card_eq_fintype_card]
  norm_num [Nat.card_eq_fintype_card]
