        matching ∈ O9 demand row col} :=
  Fintype.ofFinite _
noncomputable def AFi
    {A B : Type*}
    [Fintype A] [Fintype B] [DecidableEq A] [DecidableEq B]
    {demand : A → B → ℕ} {row : A → ℕ} {col : B → ℕ}
    (matching :
      {matching : BZ row col //
        matching ∈ O9 demand row col}) :
    BW demand row col :=
  Classical.choose
    (wI matching.2)
theorem Aim
    {A B : Type*}
    [Fintype A] [Fintype B] [DecidableEq A] [DecidableEq B]
    {demand : A → B → ℕ} {row : A → ℕ} {col : B → ℕ}
    (matching :
      {matching : BZ row col //
        matching ∈ O9 demand row col}) :
    H7 matching.1
      (AFi matching) :=
  Classical.choose_spec
    (wI matching.2)
noncomputable def Ail
    {A B : Type*}
    [Fintype A] [Fintype B] [DecidableEq A] [DecidableEq B]
    {demand : A → B → ℕ} {row : A → ℕ} {col : B → ℕ} :
    {matching : BZ row col //
        matching ∈ O9 demand row col} ↪
      (Σ witness : BW demand row col,
        {matching : BZ row col //
          H7 matching witness}) where
  toFun matching :=
    ⟨AFi matching,
      ⟨matching.1, Aim matching⟩⟩
  inj' := by
    intro x y hxy
    apply Subtype.ext
    exact congrArg (fun z ↦ z.2.1) hxy
noncomputable instance Auz
    {A B : Type*}
    [Fintype A] [Fintype B] [DecidableEq A] [DecidableEq B]
    {demand : A → B → ℕ} {row : A → ℕ} {col : B → ℕ}
    (witness : BW demand row col) :
    Fintype
      {matching : BZ row col //
        H7 matching witness} :=
  Fintype.ofFinite _
theorem AKM
    {A B : Type*}
    [Fintype A] [Fintype B] [DecidableEq A] [DecidableEq B]
    {demand : A → B → ℕ} {row : A → ℕ} {col : B → ℕ}
    (B9 : Finset.univ.sum row = Finset.univ.sum col)
    (witness : BW demand row col) :
    Fintype.card
        {matching : BZ row col //
          H7 matching witness} =
      (Finset.univ.sum row -
        Finset.univ.sum (fun a ↦ Finset.univ.sum (demand a))).factorial := by
  have hcard : Fintype.card (Cj row) = Fintype.card (Cm col) := by
    rw [XK, j7, B9]
  simpa [H7,
    Yb, lN witness] using
      AKN hcard
        (Yc witness)
        (Yb witness)
theorem AKh
    {A B : Type*}
    [Fintype A] [Fintype B] [DecidableEq A] [DecidableEq B]
    (demand : A → B → ℕ) (row : A → ℕ) (col : B → ℕ)
    (B9 : Finset.univ.sum row = Finset.univ.sum col) :
    Fintype.card
        {matching : BZ row col //
          matching ∈ O9 demand row col} ≤
      Fintype.card (BW demand row col) *
        (Finset.univ.sum row -
          Finset.univ.sum (fun a ↦ Finset.univ.sum (demand a))).factorial := by
  calc
    Fintype.card
        {matching : BZ row col //
          matching ∈ O9 demand row col} ≤
        Fintype.card
          (Σ witness : BW demand row col,
            {matching : BZ row col //
              H7 matching witness}) :=
      Fintype.card_le_of_embedding Ail
    _ = ∑ witness : BW demand row col,
          Fintype.card
            {matching : BZ row col //
              H7 matching witness} :=
      Fintype.card_sigma
    _ = _ := by
      simp_rw [AKM B9]
      simp
