theorem AMX
    (n : ℕ) (G : LabeledGraph n)
    (hG : G ∈ OU n) :
    ∀ S : Finset (Fin n), S.card = Er n →
      Um Gᶜ S := by
  classical
  intro S hS
  have AWQ : S ∈ Vg n := by
    simp [Vg, hS]
  have ATw : G ∉ ⋃ T ∈ Vg n,
      fO n T := by
    simpa [OU] using hG
  have AVN : ¬ (VL (↑S : Set (Fin n)) G : ℝ) ≤
      ((Nat.card (↑S : Set (Fin n))).choose 2 : ℝ) / 4 := by
    intro hBad
    apply ATw
    exact Set.mem_iUnion_of_mem S (Set.mem_iUnion_of_mem AWQ hBad)
  have z5 : ((S.card.choose 2 : ℕ) : ℝ) / 4 <
      (VL (↑S : Set (Fin n)) G : ℝ) := by
    exact lt_of_not_ge (by simpa using AVN)
  have ASV : S.card.choose 2 <
      4 * VL (↑S : Set (Fin n)) G := by
    have hReal : ((S.card.choose 2 : ℕ) : ℝ) <
        4 * (VL (↑S : Set (Fin n)) G : ℝ) := by
      nlinarith
    exact_mod_cast hReal
  have ATK : S.card * (S.card - 1) ≤
      8 * VL (↑S : Set (Fin n)) G := by
    calc
      S.card * (S.card - 1) = 2 * (S.card.choose 2) := by
        rw [Nat.choose_two_right]
        calc
          S.card * (S.card - 1) = (S.card * (S.card - 1) / 2) * 2 :=
            (Nat.div_two_mul_two_of_even (Nat.even_mul_pred_self S.card)).symm
          _ = 2 * (S.card * (S.card - 1) / 2) := Nat.mul_comm _ _
      _ ≤ 2 * (4 * VL (↑S : Set (Fin n)) G) :=
        Nat.mul_le_mul_left 2 (Nat.le_of_lt ASV)
      _ = 8 * VL (↑S : Set (Fin n)) G := by ring
  unfold Um
  simpa [VL, SimpleGraph.edgeFinset,
    Set.ncard_eq_toFinset_card'] using ATK
theorem AMW
    (n : ℕ) (G : LabeledGraph n)
    (hG : G ∈ OU n)
    (PN : 2 ≤ Er n) :
    ∀ S : Finset (Fin n), Er n ≤ S.card →
      Um Gᶜ S := by
  exact AkD Gᶜ (Er n)
    PN (AMX n G hG)
