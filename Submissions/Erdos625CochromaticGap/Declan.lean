      rw [Finset.mul_sum]
      apply Finset.sum_congr rfl
      intro k hk
      rw [← pow_mul]
      rw [← pow_add]
      congr 1
      omega
    _ ≤ tau ^ 4 * ∑' k : ℕ, (tau ^ 2) ^ k := by
      exact mul_le_mul_right (ENNReal.sum_le_tsum (Finset.range L)) (tau ^ 4)
    _ = tau ^ 4 * (1 - tau ^ 2)⁻¹ := by
      rw [ENNReal.tsum_geometric]
theorem Axs
    {V : Type*} [Fintype V] (K : V → V → ℝ≥0∞) (tau : ℝ≥0∞)
