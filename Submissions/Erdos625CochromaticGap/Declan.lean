    exact Filter.Tendsto.congr' (Filter.EventuallyEq.symm I8)
      tendsto_const_nhds
  · have I8 : ∀ᶠ N : ℕ in atTop,
        KM q 0 p N =
          ProfileEntropyS4.D7 Ak target := by
      filter_upwards [eventually_atTop.2 ⟨6, fun _ hN ↦ hN⟩] with N hN
      rw [← Ae9]
      unfold KM
      simp only [zero_mul, neg_zero, Real.log_zero, zero_add]
      rw [← Finset.sum_subset (show Finset.range 6 ⊆ Finset.range N by
        intro d hd
        simp only [Finset.mem_range] at hd ⊢
        omega) (fun d _hdN hd6 ↦ by
          rw [A5n d (by
            simp only [Finset.mem_range] at hd6
            omega)]
          simp)]
      have hs0 := PS (0 : Fin 4)
      have hs1 := PS (1 : Fin 4)
      have hs2 := PS (2 : Fin 4)
      have hs3 := PS (3 : Fin 4)
      norm_num [Finset.sum_range_succ, p]
      norm_num at hs0 hs1 hs2 hs3
      rw [hs0, hs1, hs2, hs3]
      simp [Fin.sum_univ_four]
      ring
    exact Filter.Tendsto.congr' (Filter.EventuallyEq.symm I8)
      tendsto_const_nhds
