section M130
namespace Erdos625
open scoped BigOperators ENNReal
noncomputable section
theorem AG8
    {b n : ℕ} {k : AG b}
    (row₀ : Ac n k) :
    Nonempty (BT n k) := by
  let labelled : FN n k :=
    (Aeq k).symm row₀
  exact ⟨labelled.1⟩
theorem AKk
    {b n : ℕ} {k : AG b}
    (row₀ : Ac n k) :
    0 < Fintype.card (BT n k) :=
  Fintype.card_pos_iff.mpr
    (AG8 row₀)
theorem Aga
    {b n : ℕ} {k : AG b}
    (row₀ : Ac n k) :
    0 < Nat.card (BT n k) := by
  rw [Nat.card_eq_fintype_card]
  exact AKk row₀
theorem Aix
    {b : ℕ} (k : AG b)
    (C7 : 0 < AG.D8 k) :
    Nonempty (Bl k) := by
  apply Fintype.card_pos_iff.mp
  rw [A96]
  exact C7
theorem Aqn
    {b : ℕ} (k : AG b) :
    0 < Fintype.card (Bl k) ↔
      0 < AG.D8 k := by
  rw [A96]
theorem AhX
    {b n : ℕ} {k : AG b}
    (row₀ : Ac n k) (hn : 0 < n) :
    0 < AG.D8 k := by
  obtain ⟨P⟩ := AG8 row₀
  rw [← P.card_parts_eq]
  apply Finset.card_pos.mpr
  let v : Fin n := ⟨0, hn⟩
  exact ⟨P.1.part v, P.1.part_mem.mpr (Finset.mem_univ v)⟩
theorem AFk
    {b n : ℕ} {k : AG b}
    (row₀ : Ac n k) (hn : 0 < n) :
    Nonempty (Bl k) :=
  Aix k
    (AhX row₀ hn)
theorem Aqo
    {b n : ℕ} {k : AG b}
    (row₀ : Ac n k) (hn : 0 < n) :
    0 < Fintype.card (Bl k) :=
  Fintype.card_pos_iff.mpr
    (AFk row₀ hn)
theorem AwK
    {b n : ℕ} {k : AG b}
    (row₀ : Ac n k) :
    Nonempty (Bl k) ∨ n = 0 := by
  by_cases hn : n = 0
  · exact Or.inr hn
  · exact Or.inl
      (AFk row₀
        (Nat.pos_of_ne_zero hn))
theorem AGq
    {b : ℕ} (n : ℕ) (k : AG b) :
    DY n k ≠ ∞ := by
  rw [kR, kA]
  apply ENNReal.mul_ne_top
  · exact ENNReal.pow_ne_top (by norm_num)
  · apply ENNReal.mul_ne_top
    · exact ENNReal.natCast_ne_top _
    · exact ENNReal.pow_ne_top (by norm_num)
theorem AmJ
    {b n : ℕ} {k : AG b}
    (row₀ : Ac n k) :
