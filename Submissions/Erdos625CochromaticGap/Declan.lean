section M342
namespace Erdos625
open scoped BigOperators
noncomputable section
@[simp] theorem Ajr {b n : ℕ}
    (G : LabeledGraph n) {k : AG b}
    (P : BT n k) :
    0 < gY G P ↔
      G ∈ KX P.1 := by
  classical
  by_cases h : G ∈ KX P.1 <;>
    simp [gY, h]
theorem Aj5 {b n : ℕ}
    (G : LabeledGraph n) (k : AG b) :
    0 < rO G k ↔
      ∃ P : BT n k,
        G ∈ KX P.1 := by
  classical
  unfold rO
  rw [show (∑ P : BT n k,
      gY G P) =
      ∑ P ∈ (Finset.univ : Finset (BT n k)),
        gY G P by simp,
    Finset.sum_pos_iff]
  simp only [Finset.mem_univ, true_and, Ajr]
theorem AJj {n : ℕ}
    (G : LabeledGraph n) (b parts : ℕ) :
    0 < RK G b parts ↔
      ∃ k ∈ Nm n b parts,
        ∃ P : BT n k,
          G ∈ KX P.1 := by
  classical
  unfold RK
  rw [Finset.sum_pos_iff]
  simp only [Aj5]
end
