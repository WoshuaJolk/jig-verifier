section M376
open Finset Set MeasureTheory
open scoped ENNReal NNReal
namespace Erdos625
noncomputable section
namespace CoColoring
def pullback {U V : Type*} {kappa : Type*} {G : SimpleGraph V}
    {H : SimpleGraph U} (C : CoColoring G kappa) (f : U → V)
    (hf : Function.Injective f)
    (hadj : ∀ u v, H.Adj u v ↔ G.Adj (f u) (f v)) :
    CoColoring H kappa where
  color := fun u ↦ C.color (f u)
  kind := C.kind
  valid := by
    intro c
    cases hkind : C.kind c with
    | independent =>
        intro x hx y hy hxy hH
        exact (C.A17 hkind) hx hy (hf.ne hxy)
          ((hadj x y).mp hH)
    | clique =>
        intro x hx y hy hxy
        exact (hadj x y).mpr
          ((C.A16 hkind) hx hy (hf.ne hxy))
end CoColoring
theorem ALZ {V : Type*} {G : SimpleGraph V}
    {U W : Set V} {k : ℕ} (hUW : U ⊆ W)
    (hW : CoColorable (G.induce W) k) : CoColorable (G.induce U) k := by
  let f : U → W := fun u ↦ ⟨u.val, hUW u.property⟩
  have hf : Function.Injective f := by
    intro x y h
    apply Subtype.ext
    exact congrArg (fun z : W ↦ z.val) h
  exact ⟨hW.some.pullback f hf (fun _ _ ↦ Iff.rfl)⟩
theorem ALa {V : Type*} {G : SimpleGraph V}
    {W : Set V} {k : ℕ} (h : CoColorable G k) :
    CoColorable (G.induce W) k := by
  exact ⟨h.some.pullback Subtype.val Subtype.val_injective
    (fun _ _ ↦ Iff.rfl)⟩
theorem AeU {n : ℕ} {G H : LabeledGraph n}
    {i : Fin n} (hGH : G.induce {v | v ≠ i} = H.induce {v | v ≠ i})
    {U : Set (Fin n)} (hU : U ⊆ {v | v ≠ i}) :
    G.induce U = H.induce U := by
  ext u v
  let u' : {x : Fin n // x ≠ i} := ⟨u.val, hU u.property⟩
  let v' : {x : Fin n // x ≠ i} := ⟨v.val, hU v.property⟩
  have hAdj : (G.induce {x | x ≠ i}).Adj u' v' ↔
      (H.induce {x | x ≠ i}).Adj u' v' := by
    rw [hGH]
  exact hAdj
theorem ALX {n k : ℕ}
    {G H : LabeledGraph n} {i : Fin n} {W : Finset (Fin n)}
    (hGH : G.induce {v | v ≠ i} = H.induce {v | v ≠ i})
    (hW : CoColorable (G.induce (↑W : Set (Fin n))) k) :
    CoColorable (H.induce (↑(W.erase i) : Set (Fin n))) k := by
  have PL : (↑(W.erase i) : Set (Fin n)) ⊆ (↑W : Set (Fin n)) := by
    intro v hv
    exact (Finset.mem_erase.mp hv).2
  have ARy : (↑(W.erase i) : Set (Fin n)) ⊆ {v | v ≠ i} := by
    intro v hv
    exact (Finset.mem_erase.mp hv).1
  have ACZ :
      CoColorable (G.induce (↑(W.erase i) : Set (Fin n))) k :=
    ALZ PL hW
  rw [AeU hGH ARy] at ACZ
  exact ACZ
theorem ALY {V : Type*} (G : SimpleGraph V) (k : ℕ) :
    CoColorable (G.induce (∅ : Set V)) k := by
  let C : CoColoring (G.induce (∅ : Set V)) (Fin k) := {
    color := fun v ↦ v.property.elim
    kind := fun _ ↦ .independent
    valid := by
      intro c
      simp only
      intro x
      exact x.property.elim }
  exact ⟨C⟩
noncomputable def Tf {n : ℕ} (G : LabeledGraph n)
    (k : ℕ) : Finset (Finset (Fin n)) := by
  classical
  exact Finset.univ.powerset.filter fun W ↦
    CoColorable (G.induce (↑W : Set (Fin n))) k
theorem AOM {n : ℕ} (G : LabeledGraph n)
    (k : ℕ) : ∅ ∈ Tf G k := by
  classical
  rw [Tf, Finset.mem_filter]
  constructor
  · simp
  · rw [show (↑(∅ : Finset (Fin n)) : Set (Fin n)) = ∅ by ext; simp]
    exact ALY G k
theorem ALg {n : ℕ} (G : LabeledGraph n)
    (k : ℕ) : (Tf G k).Nonempty :=
  ⟨∅, AOM G k⟩
noncomputable def Cr {n : ℕ} (G : LabeledGraph n)
    (k : ℕ) : ℕ :=
  ((Tf G k).image Finset.card).max'
    (Finset.Nonempty.image (ALg G k) Finset.card)
theorem A93 {n : ℕ} {G : LabeledGraph n}
    {k : ℕ} {W : Finset (Fin n)}
    (hW : CoColorable (G.induce (↑W : Set (Fin n))) k) :
    W.card ≤ Cr G k := by
  classical
  apply Finset.le_max'
  apply Finset.mem_image_of_mem
  simp only [Tf, Finset.mem_filter,
    Finset.mem_powerset]
  exact ⟨Finset.subset_univ W, hW⟩
theorem vV {n : ℕ} (G : LabeledGraph n)
    (k : ℕ) : Cr G k ≤ n := by
  classical
  have hmem : Cr G k ∈
      (Tf G k).image Finset.card :=
    Finset.max'_mem _ _
  rw [Finset.mem_image] at hmem
  obtain ⟨W, _hW, hcard⟩ := hmem
  rw [← hcard]
  simpa using Finset.card_le_univ W
theorem A9K {V : Type*} {G : SimpleGraph V}
    {W : Set V} {k : ℕ} (hFull : ∀ v, v ∈ W)
    (h : CoColorable (G.induce W) k) : CoColorable G k := by
  let f : V → W := fun v ↦ ⟨v, hFull v⟩
  have hf : Function.Injective f := by
    intro x y hxy
    exact congrArg Subtype.val hxy
  exact ⟨h.some.pullback f hf (fun _ _ ↦ Iff.rfl)⟩
theorem Aqt {V : Type*} {G : SimpleGraph V}
    {k : ℕ} (h : CoColorable (G.induce (Set.univ : Set V)) k) :
    CoColorable G k :=
  A9K (fun _ ↦ Set.mem_univ _) h
theorem ALh {n k : ℕ}
    (G : LabeledGraph n) :
    Cr G k = n ↔ CoColorable G k := by
  classical
  constructor
  · intro xT
    have hmem : Cr G k ∈
        (Tf G k).image Finset.card :=
      Finset.max'_mem _ _
    rw [Finset.mem_image] at hmem
    obtain ⟨W, hWmem, Xq⟩ := hmem
    have hCard : W.card = n := by omega
    have hUniv : W = Finset.univ := by
      rw [← Finset.card_eq_iff_eq_univ]
      simpa using hCard
    subst W
    rw [Tf, Finset.mem_filter] at hWmem
    exact A9K (W :=
      (↑(Finset.univ : Finset (Fin n)) : Set (Fin n))) (by simp) hWmem.2
  · intro A2y
    apply Nat.le_antisymm (vV G k)
    have AU8 :
        CoColorable
          (G.induce (↑(Finset.univ : Finset (Fin n)) : Set (Fin n))) k :=
      ALa A2y
    simpa using
      (A93 (G := G) (k := k)
        (W := Finset.univ) AU8)
theorem A9L
    {n k : ℕ} {G H : LabeledGraph n} {i : Fin n}
    (hGH : G.induce {v | v ≠ i} = H.induce {v | v ≠ i}) :
    Cr G k ≤
      Cr H k + 1 := by
  classical
  have hmem : Cr G k ∈
      (Tf G k).image Finset.card :=
    Finset.max'_mem _ _
  rw [Finset.mem_image] at hmem
  obtain ⟨W, hWmem, Xq⟩ := hmem
  rw [Tf, Finset.mem_filter] at hWmem
  have A3J :
      CoColorable (H.induce (↑(W.erase i) : Set (Fin n))) k :=
    ALX hGH hWmem.2
  have AsZ : (W.erase i).card ≤ Cr H k :=
    A93 A3J
  have hCard : W.card ≤ (W.erase i).card + 1 := by
    by_cases hi : i ∈ W
    · have h := Finset.card_erase_add_one hi
      omega
    · rw [Finset.erase_eq_of_notMem hi]
      omega
  omega
theorem ALi
    (n k : ℕ) :
    lB
      (fun G : LabeledGraph n ↦ (Cr G k : ℝ))
      (fun _ ↦ (1 : NNReal)) := by
  intro i G H hGH
  have ATs :=
    A9L (k := k) hGH
  have AS2 :=
    A9L (k := k) hGH.symm
  have Asc : (Cr G k : ℝ) ≤
