section M079
namespace Erdos625
open scoped BigOperators
def Yd {A B : Type*} [Fintype A] [Fintype B]
    (x : A → B → ZMod 2) : Prop :=
  (∀ a, ∑ b, x a b = 0) ∧ (∀ b, ∑ a, x a b = 0)
theorem AOk
    {A B : Type*} [Fintype A] [Fintype B]
    (x : A → B → ZMod 2) (M : A → B → Prop)
    (heven : Yd x)
    (Cv : ∀ a b₁ b₂, M a b₁ → M a b₂ → b₁ = b₂)
    (hsupport : ∀ a b, x a b ≠ 0 → M a b) :
    x = 0 := by
  funext a b
  simp only [Pi.zero_apply]
  by_contra hb
  have hrow : ∑ b', x a b' = x a b := by
    refine Finset.sum_eq_single b ?_ ?_
    · intro b' _ hne
      by_contra hb'
      exact hne (Cv a b' b (hsupport a b' hb') (hsupport a b hb))
    · intro hmem
      exact absurd (Finset.mem_univ b) hmem
  have hzero := heven.1 a
  rw [hrow] at hzero
  exact hb hzero
end Erdos625
end M079

section M080
namespace Erdos625
open scoped BigOperators
def Vz
    {A B : Type*} [Fintype B] [DecidableEq A] [DecidableEq B]
    (F : Finset (A × B)) (a : A) : Finset B :=
  Finset.univ.filter fun b ↦ (a, b) ∈ F
def Vw
    {A B : Type*} [Fintype A] [DecidableEq A] [DecidableEq B]
    (F : Finset (A × B)) (b : B) : Finset A :=
  Finset.univ.filter fun a ↦ (a, b) ∈ F
def XH
    {A B : Type*} [DecidableEq A] [DecidableEq B]
    (F : Finset (A × B)) : A → B → ZMod 2 :=
  fun a b ↦ if (a, b) ∈ F then 1 else 0
@[simp] theorem v9
    {A B : Type*} [DecidableEq A] [DecidableEq B]
    (F : Finset (A × B)) (a : A) (b : B) :
    XH F a b = 1 ↔ (a, b) ∈ F := by
  simp [XH]
@[simp] theorem AJO
    {A B : Type*} [DecidableEq A] [DecidableEq B]
    (F : Finset (A × B)) (a : A) (b : B) :
    XH F a b ≠ 0 ↔ (a, b) ∈ F := by
  simp [XH]
theorem AJQ
    {A B : Type*} [DecidableEq A] [DecidableEq B] :
    Function.Injective
      (XH : Finset (A × B) → A → B → ZMod 2) := by
  intro F G h
  ext p
  have hp := congrFun (congrFun h p.1) p.2
  constructor
  · intro hpF
    apply (v9 G p.1 p.2).mp
    rw [← hp]
    exact (v9 F p.1 p.2).mpr hpF
  · intro hpG
    apply (v9 F p.1 p.2).mp
    rw [hp]
    exact (v9 G p.1 p.2).mpr hpG
theorem AHF
    {A B : Type*} [Fintype B] [DecidableEq A] [DecidableEq B]
    (F : Finset (A × B)) (a : A) :
    ∑ b, XH F a b =
      ((Vz F a).card : ZMod 2) := by
  change (∑ b, if (a, b) ∈ F then (1 : ZMod 2) else 0) =
    ((Finset.univ.filter (fun b ↦ (a, b) ∈ F)).card : ZMod 2)
  rw [← Finset.sum_filter]
  simp
theorem AHE
    {A B : Type*} [Fintype A] [DecidableEq A] [DecidableEq B]
    (F : Finset (A × B)) (b : B) :
    ∑ a, XH F a b =
      ((Vw F b).card : ZMod 2) := by
  change (∑ a, if (a, b) ∈ F then (1 : ZMod 2) else 0) =
    ((Finset.univ.filter (fun a ↦ (a, b) ∈ F)).card : ZMod 2)
  rw [← Finset.sum_filter]
  simp
def lA
    {A B : Type*} [Fintype A] [Fintype B]
    [DecidableEq A] [DecidableEq B]
    (F : Finset (A × B)) : Prop :=
  (∀ a, Even (Vz F a).card) ∧
    (∀ b, Even (Vw F b).card)
theorem AJP
    {A B : Type*} [Fintype A] [Fintype B]
    [DecidableEq A] [DecidableEq B]
    (F : Finset (A × B)) :
    Yd (XH F) ↔
      lA F := by
  constructor
  · intro h
    constructor
    · intro a
      apply ZMod.natCast_eq_zero_iff_even.mp
      rw [← AHF]
      exact h.1 a
    · intro b
      apply ZMod.natCast_eq_zero_iff_even.mp
      rw [← AHE]
      exact h.2 b
  · intro h
    constructor
    · intro a
      rw [AHF]
      exact ZMod.natCast_eq_zero_iff_even.mpr (h.1 a)
    · intro b
      rw [AHE]
      exact ZMod.natCast_eq_zero_iff_even.mpr (h.2 b)
end Erdos625
end M080

section M081
open scoped BigOperators
namespace Erdos625
variable {A B : Type*} [Fintype A] [Fintype B]
theorem Ao3
    (table : A → B → ℕ) :
    (∑ a, ∑ b, table a b) = ∑ b, ∑ a, table a b := by
  rw [Finset.sum_comm]
theorem Axj
    (demand table : A → B → ℕ)
    (V8 : ∀ a b, demand a b ≤ table a b) :
    (∑ a, ∑ b, demand a b) ≤ ∑ a, ∑ b, table a b := by
  exact Finset.sum_le_sum fun a _ => Finset.sum_le_sum fun b _ => V8 a b
theorem Avz
    [DecidableEq A] [DecidableEq B]
    (demand : A → B → ℕ)
    (row : A → ℕ) (column : B → ℕ)
    (hbad :
      (∃ a, row a < ∑ b, demand a b) ∨
      (∃ b, column b < ∑ a, demand a b) ∨
      (∑ a, row a) ≠ ∑ b, column b) :
    ¬ ∃ table : A → B → ℕ,
      (∀ a, (∑ b, table a b) = row a) ∧
      (∀ b, (∑ a, table a b) = column b) ∧
      ∀ a b, demand a b ≤ table a b := by
  rintro ⟨table, hrow, IT, V8⟩
  rcases hbad with hbadRow | hbadColumn | hbadTotal
  · obtain ⟨a, ha⟩ := hbadRow
    have hle : (∑ b, demand a b) ≤ ∑ b, table a b :=
      Finset.sum_le_sum fun b _ => V8 a b
    have : (∑ b, demand a b) ≤ row a := by
      simpa only [hrow a] using hle
    exact (Nat.not_lt_of_ge this) ha
  · obtain ⟨b, hb⟩ := hbadColumn
    have hle : (∑ a, demand a b) ≤ ∑ a, table a b :=
      Finset.sum_le_sum fun a _ => V8 a b
    have : (∑ a, demand a b) ≤ column b := by
      simpa only [IT b] using hle
    exact (Nat.not_lt_of_ge this) hb
  · apply hbadTotal
    calc
      (∑ a, row a) = ∑ a, ∑ b, table a b := by
        apply Finset.sum_congr rfl
        intro a _
        exact (hrow a).symm
      _ = ∑ b, ∑ a, table a b := Ao3 table
      _ = ∑ b, column b := by
        apply Finset.sum_congr rfl
        intro b _
        exact IT b
theorem AaY
    [DecidableEq A] [DecidableEq B]
    (table : A → B → ℕ) (U : ℕ)
    (hrow : ∀ a, (∑ b, table a b) ≤ U)
    (IT : ∀ b, (∑ a, table a b) ≤ U) :
    (∀ a b₁ b₂,
      U / 2 < table a b₁ → U / 2 < table a b₂ → b₁ = b₂) ∧
    (∀ b a₁ a₂,
      U / 2 < table a₁ b → U / 2 < table a₂ b → a₁ = a₂) := by
  constructor
  · intro a b₁ b₂ hb₁ hb₂
    by_contra hne
    have hpair :
        (∑ b ∈ ({b₁, b₂} : Finset B), table a b) ≤ ∑ b, table a b :=
      Finset.sum_le_sum_of_subset (by simp)
    have htwo : table a b₁ + table a b₂ ≤ ∑ b, table a b := by
      simpa [hne] using hpair
    have hle : table a b₁ + table a b₂ ≤ U := htwo.trans (hrow a)
    omega
  · intro b a₁ a₂ ha₁ ha₂
    by_contra hne
    have hpair :
        (∑ a ∈ ({a₁, a₂} : Finset A), table a b) ≤ ∑ a, table a b :=
      Finset.sum_le_sum_of_subset (by simp)
    have htwo : table a₁ b + table a₂ b ≤ ∑ a, table a b := by
      simpa [hne] using hpair
    have hle : table a₁ b + table a₂ b ≤ U := htwo.trans (IT b)
    omega
end Erdos625
end M081

section M082
namespace Erdos625
open scoped BigOperators
private def Amu
    {A : Type*} {p : A → Type*} (P : (Σ a, p a) → Prop) :
    {x : Σ a, p a // P x} ≃ Σ a, {y : p a // P ⟨a, y⟩} where
  toFun x := ⟨x.1.1, ⟨x.1.2, x.2⟩⟩
  invFun x := ⟨⟨x.1, x.2.1⟩, x.2.2⟩
  left_inv _ := rfl
  right_inv _ := rfl
theorem A0s
    {A B : Type*}
    [Fintype A] [Fintype B] [DecidableEq B]
    {row : A → ℕ} {col : B → ℕ}
    (matching : BZ row col) (a : A) :
    (∑ b, BX matching a b) = row a := by
  classical
  simpa [BX] using
    (Finset.sum_card_fiberwise_eq_card_filter
      (Finset.univ : Finset (Fin (row a)))
      (Finset.univ : Finset B)
      (fun stub : Fin (row a) => (matching ⟨a, stub⟩).1))
theorem An2
    {A B : Type*}
    [Fintype A] [Fintype B] [DecidableEq A] [DecidableEq B]
    {row : A → ℕ} {col : B → ℕ}
    (matching : BZ row col) (b : B) :
    (∑ a, BX matching a b) = col b := by
  classical
  let P : Cj row → Prop := fun x => (matching x).1 = b
  let AlU :
      {x : Cj row // P x} ≃
        Σ a, {stub : Fin (row a) // P ⟨a, stub⟩} :=
    Amu P
  let Afl :
      {x : Cj row // P x} ≃
        {y : Cm col // y.1 = b} :=
    Equiv.subtypeEquiv matching (fun _ => Iff.rfl)
  calc
    (∑ a, BX matching a b) =
        Fintype.card (Σ a, {stub : Fin (row a) // P ⟨a, stub⟩}) := by
      rw [Fintype.card_sigma]
      apply Finset.sum_congr rfl
      intro a _
      rw [BX, ← Fintype.card_coe
        (Finset.univ.filter
          (fun stub : Fin (row a) => (matching ⟨a, stub⟩).1 = b))]
      apply Fintype.card_congr
      exact Equiv.subtypeEquiv (Equiv.refl _) (fun _ => by
        simp [P])
    _ = Fintype.card {x : Cj row // P x} :=
      Fintype.card_congr AlU.symm
    _ = Fintype.card {y : Cm col // y.1 = b} :=
      Fintype.card_congr Afl
    _ = col b := by
      simpa using Fintype.card_congr
        (Equiv.sigmaSubtype (β := fun b : B => Fin (col b)) b)
theorem AM2
    {A B : Type*}
    [Fintype A] [Fintype B] [DecidableEq A] [DecidableEq B]
    {row : A → ℕ} {col : B → ℕ}
    (matching : BZ row col) (U : ℕ)
    (hrow : ∀ a, row a ≤ U)
    (hcol : ∀ b, col b ≤ U) :
    (∀ a b₁ b₂,
      U / 2 < BX matching a b₁ →
      U / 2 < BX matching a b₂ →
      b₁ = b₂) ∧
    (∀ b a₁ a₂,
      U / 2 < BX matching a₁ b →
      U / 2 < BX matching a₂ b →
      a₁ = a₂) := by
  apply AaY (table := BX matching) U
  · intro a
    rw [A0s]
    exact hrow a
  · intro b
    rw [An2]
    exact hcol b
end Erdos625
end M082

section M083
namespace Erdos625
open scoped BigOperators
theorem ApR
    {E : Type*} [Fintype E] [DecidableEq E]
    (selected : Finset E) (mass : E → ℕ) (m : ℕ)
    (Kt : ∀ e ∈ selected, 2 ≤ mass e)
    (B9 : ∑ e, mass e = m) :
    2 * selected.card ≤ m := by
  calc
    2 * selected.card = ∑ _e ∈ selected, 2 := by simp [mul_comm]
    _ ≤ ∑ e ∈ selected, mass e := by
      exact Finset.sum_le_sum fun e he ↦ Kt e he
    _ ≤ ∑ e, mass e :=
      Finset.sum_le_univ_sum_of_nonneg fun e ↦ Nat.zero_le (mass e)
    _ = m := B9
theorem AKn
    {E : Type*} [Fintype E] [DecidableEq E]
    (selected : Finset E) (mass : E → ℕ) (m : ℕ)
    (Kt : ∀ e ∈ selected, 2 ≤ mass e)
    (B9 : ∑ e, mass e = m) :
    selected.card ≤ m / 2 := by
  have h := ApR
    selected mass m Kt B9
  omega
end Erdos625
end M083

section M084
namespace Erdos625
open scoped BigOperators
def Qb
    {A B : Type*}
    [Fintype A] [Fintype B] [DecidableEq B]
    {row : A → ℕ} {col : B → ℕ}
    (matching : BZ row col) : A → B → Prop :=
  fun a b ↦ 2 ≤ BX matching a b
def S9
    {A B : Type*}
    [Fintype A] [Fintype B] [DecidableEq A] [DecidableEq B]
    {row : A → ℕ} {col : B → ℕ}
    (matching : BZ row col) : Finset (A × B) :=
  Finset.univ.filter fun p ↦
    2 ≤ BX matching p.1 p.2
@[simp] theorem A6g
    {A B : Type*}
    [Fintype A] [Fintype B] [DecidableEq A] [DecidableEq B]
    {row : A → ℕ} {col : B → ℕ}
    (matching : BZ row col) (p : A × B) :
    p ∈ S9 matching ↔
      2 ≤ BX matching p.1 p.2 := by
  simp [S9]
theorem AHG
    {A B : Type*}
    [Fintype A] [Fintype B] [DecidableEq B]
    {row : A → ℕ} {col : B → ℕ}
    (matching : BZ row col) :
    (∑ p : A × B, BX matching p.1 p.2) =
      ∑ a, row a := by
  rw [Fintype.sum_prod_type]
  apply Finset.sum_congr rfl
  intro a _
  exact A0s matching a
theorem vN
    {A B : Type*}
    [Fintype A] [Fintype B] [DecidableEq A] [DecidableEq B]
    {row : A → ℕ} {col : B → ℕ}
    (matching : BZ row col) :
    (S9 matching).card ≤
      (∑ a, row a) / 2 := by
  apply AKn
    (S9 matching)
    (fun p : A × B ↦ BX matching p.1 p.2)
    (∑ a, row a)
  · intro p hp
    exact (A6g matching p).mp hp
  · exact AHG matching
theorem AKK
    {A B : Type*}
    [Fintype A] [Fintype B] [DecidableEq A] [DecidableEq B]
    {row : A → ℕ} {col : B → ℕ}
    (matching : BZ row col) :
    (S9 matching).card ≤
      Fintype.card (Cj row) / 2 := by
  rw [XK]
  exact vN matching
end Erdos625
