  rw [AA7]
  · apply Finset.prod_congr rfl
    intro a ha
    rw [AA7]
    intro b hb
    exact Nat.factorial_ne_zero _
  · intro a ha
    exact Finset.prod_ne_zero_iff.mpr (fun b hb ↦ Nat.factorial_ne_zero _)
theorem AM6
    {A B : Type*} [Fintype A] [Fintype B]
    (demand : A → B → ℕ) (row : A → ℕ) (col : B → ℕ) (m : ℕ)
    (hm : 0 < m) :
    Finset.univ.prod (fun a ↦ Finset.univ.prod (fun b ↦
        Ck row col m a b ^ demand a b /
          ((demand a b).factorial : ℝ≥0∞))) =
      (Lg demand row col : ℝ≥0∞) /
        ((((m : ℝ≥0∞) / C6) ^ E4 demand) *
          (Jx demand : ℝ≥0∞)) := by
  have A3o : (m : ℝ≥0∞) ≠ 0 := by
    exact_mod_cast hm.ne'
  have hMtop : (m : ℝ≥0∞) ≠ ∞ := ENNReal.natCast_ne_top _
  have hinv : ((m : ℝ≥0∞) / C6)⁻¹ =
      C6 / (m : ℝ≥0∞) :=
    ENNReal.inv_div (Or.inr hMtop) (Or.inr A3o)
  have A03 :
      (Lg demand row col : ℝ≥0∞) *
          (C6 / (m : ℝ≥0∞)) ^ E4 demand =
        (Lg demand row col : ℝ≥0∞) /
          (((m : ℝ≥0∞) / C6) ^ E4 demand) := by
    calc
      (Lg demand row col : ℝ≥0∞) *
          (C6 / (m : ℝ≥0∞)) ^ E4 demand =
        (Lg demand row col : ℝ≥0∞) *
          (((m : ℝ≥0∞) / C6) ^ E4 demand)⁻¹ := by
        rw [← hinv, ← ENNReal.inv_pow]
      _ = (((m : ℝ≥0∞) / C6) ^ E4 demand)⁻¹ *
          (Lg demand row col : ℝ≥0∞) := mul_comm _ _
      _ = (Lg demand row col : ℝ≥0∞) /
          (((m : ℝ≥0∞) / C6) ^ E4 demand) :=
        (ENNReal.div_eq_inv_mul).symm
  calc
    Finset.univ.prod (fun a ↦ Finset.univ.prod (fun b ↦
        Ck row col m a b ^ demand a b /
          ((demand a b).factorial : ℝ≥0∞))) =
        (Finset.univ.prod (fun a ↦ Finset.univ.prod (fun b ↦
          Ck row col m a b ^ demand a b))) /
        (Jx demand : ℝ≥0∞) := by
      rw [ENNReal.div_eq_inv_mul, AeZ]
      simp only [ENNReal.div_eq_inv_mul, Finset.prod_mul_distrib]
    _ = ((Lg demand row col : ℝ≥0∞) *
          (C6 / (m : ℝ≥0∞)) ^ E4 demand) /
        (Jx demand : ℝ≥0∞) := by
      rw [AM5]
    _ = ((Lg demand row col : ℝ≥0∞) /
          (((m : ℝ≥0∞) / C6) ^ E4 demand)) /
        (Jx demand : ℝ≥0∞) := by rw [A03]
    _ = (Lg demand row col : ℝ≥0∞) /
        ((((m : ℝ≥0∞) / C6) ^ E4 demand) *
          (Jx demand : ℝ≥0∞)) := by
      have A3F : (Jx demand : ℝ≥0∞) ≠ 0 := by
        exact_mod_cast (by
          simp only [Jx]
          exact Finset.prod_ne_zero_iff.mpr (fun a ha ↦
            Finset.prod_ne_zero_iff.mpr (fun b hb ↦
              Nat.factorial_ne_zero _)) :
            Jx demand ≠ 0)
      have hDtop : (Jx demand : ℝ≥0∞) ≠ ∞ :=
        ENNReal.natCast_ne_top _
      have AbV := ENNReal.mul_inv
        (a := ((m : ℝ≥0∞) / C6) ^ E4 demand)
        (b := (Jx demand : ℝ≥0∞))
        (Or.inr hDtop) (Or.inr A3F)
      calc
        ((Lg demand row col : ℝ≥0∞) /
            (((m : ℝ≥0∞) / C6) ^ E4 demand)) /
            (Jx demand : ℝ≥0∞) =
          (Jx demand : ℝ≥0∞)⁻¹ *
            ((((m : ℝ≥0∞) / C6) ^ E4 demand)⁻¹ *
              (Lg demand row col : ℝ≥0∞)) := by
            rw [ENNReal.div_eq_inv_mul, ENNReal.div_eq_inv_mul]
        _ = ((((m : ℝ≥0∞) / C6) ^ E4 demand)⁻¹ *
              (Jx demand : ℝ≥0∞)⁻¹) *
            (Lg demand row col : ℝ≥0∞) := by ac_rfl
        _ = ((((m : ℝ≥0∞) / C6) ^ E4 demand) *
              (Jx demand : ℝ≥0∞))⁻¹ *
            (Lg demand row col : ℝ≥0∞) := by rw [AbV]
        _ = (Lg demand row col : ℝ≥0∞) /
            ((((m : ℝ≥0∞) / C6) ^ E4 demand) *
              (Jx demand : ℝ≥0∞)) :=
          (ENNReal.div_eq_inv_mul).symm
