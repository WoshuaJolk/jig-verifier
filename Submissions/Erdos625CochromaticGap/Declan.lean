    Fintype.equivOfCardEq (by simpa only [Fintype.card_fin] using Ad7.symm)
  have AYS :
      Fintype.card (Fin n ≃ Dm m) = Nat.factorial n := by
    simpa only [Fintype.card_fin] using Fintype.card_equiv e₀
  obtain ⟨e⟩ := h
  have AcC :
      Fintype.card (BT n k) * D = Nat.factorial n := by
    calc
      Fintype.card (BT n k) * D =
          Fintype.card (Zu n k) := B9.symm
      _ = Fintype.card (Fin n ≃ Dm m) := Fintype.card_congr e
      _ = Nat.factorial n := AYS
  have AYp : m.bell * D = Nat.factorial n := by
    have hzero : 0 ∉ m.toFinset := by
      simpa only [Multiset.mem_toFinset, m] using A8M k
