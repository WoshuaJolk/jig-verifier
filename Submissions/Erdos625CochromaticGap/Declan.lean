      ∀ (U m₀ : ℕ),
        0 < m₀ →
        (n : ℝ) / Real.log (n : ℝ) ^ 6 ≤ (m₀ : ℝ) →
        (U : ℝ) ≤ 4 * (Real.log (n : ℝ) / Real.log 2) →
        C * (U : ℝ) ^ 3 / (m₀ : ℝ) ≤
          (64 * C / Real.log 2 ^ 3) *
            (Real.log (n : ℝ) ^ 9 / (n : ℝ)) := by
    refine Filter.eventually_atTop.mpr ⟨2, fun n hn => ?_⟩
    intro U m₀ hm₀ hmass hU
