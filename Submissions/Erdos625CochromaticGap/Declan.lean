    · exact fun h => absurd (Nat.descFactorial_eq_zero_iff_lt.mp h) (by omega)
  have hnat : (P8 alpha A8 k L *
        Oy alpha A8 k L) ^ 2 *
        (KI alpha A8 (fun i => E3 L i) *
          KI alpha A8 (fun j => El L j)) *
        (LH n alpha A8 (fun i => E3 L i) *
          LH n alpha A8 (fun j => El L j))
