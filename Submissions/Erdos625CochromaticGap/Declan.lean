                B8 a lambda k))
        atTop (nhds ((k : ℝ) - R)) := by
    have h := tendsto_finsetSum (Finset.range (k + 1)) Ade
    simpa [hkMem] using h
  have AZu :
      Tendsto
        (fun lambda : ℝ ↦
          (-(R + 1)) *
            (D6 a lambda /
              B8 a lambda k))
        atTop (nhds 0) := by
    simpa using tendsto_const_nhds.mul
      (AoS a k)
  have Act :
      Tendsto
        (fun lambda : ℝ ↦
          (-(R + 1)) *
              (D6 a lambda /
                B8 a lambda k) +
            ∑ d ∈ Finset.range (k + 1),
              ((d : ℝ) - R) *
                (B8 a lambda d /
                  B8 a lambda k))
        atTop (nhds ((k : ℝ) - R)) := by
    simpa using AZu.add AdJ
  have Acu : ∀ᶠ lambda : ℝ in atTop,
