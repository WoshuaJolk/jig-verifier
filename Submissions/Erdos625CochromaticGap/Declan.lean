  code.1.1 + 1
def vertex {V : Type*} {L : ℕ} {v w : V}
    (code : NG V L v w) :
    Fin (code.length + 1) → V :=
  code.2.vertex
def weight {V : Type*} (K : V → V → ℝ≥0∞)
