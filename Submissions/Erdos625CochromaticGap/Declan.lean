          intro x y hxy
          apply Subtype.ext
          have AbI :
              matching ⟨a, x.1⟩ = matching ⟨a, y.1⟩ := by
            calc
              matching ⟨a, x.1⟩ = ⟨b, Yp a b x⟩ :=
                sP _ (UC a b x)
              _ = ⟨b, Yp a b y⟩ := by rw [hxy]
              _ = matching ⟨a, y.1⟩ :=
                (sP _ (UC a b y)).symm
