theorem AR2
    (alpha : Nat) (A8 : 5 < alpha) (k : AG (alpha + 1))
    (L : Bh)
    (AN : CZ alpha A8 k)
    (D : J9 alpha A8 k L)
    (i j : Fin 4) :
    (((GR alpha A8 k i).product
      (GR alpha A8 k j)).filter
        (fun ab => (Jy alpha A8 k L AN D).typeTable
