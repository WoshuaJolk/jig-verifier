    Real.isLittleO_log_id_atTop.comp_tendsto CQ
theorem Af4 :
    (fun n : ℕ ↦ AY n) =o[atTop] (fun n : ℕ ↦ (n : ℝ)) :=
  QC.trans r6
theorem AiY :
    (fun n : ℕ ↦ Jk n) =o[atTop] (fun n : ℕ ↦ (n : ℝ)) := by
