          (fun lambda : ℝ ↦
            ((k : ℝ) - R) *
              (B8 a lambda k /
                B8 a lambda k)) =
            fun _ : ℝ ↦ (k : ℝ) - R := by
        funext lambda
        rw [div_self (ne_of_gt
          (Nu a lambda k))]
        ring
