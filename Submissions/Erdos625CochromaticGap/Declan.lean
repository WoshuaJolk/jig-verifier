    (randomGraphMeasure n).real (OU n)ᶜ ≤
        ∑ S ∈ Vg n,
          (randomGraphMeasure n).real (fO n S) :=
      AMT n
    _ ≤ ∑ S ∈ Vg n,
        Real.exp (-((S.card.choose 2 : ℕ) : ℝ) / 16) := by
      exact Finset.sum_le_sum fun S hS =>
        AeV n S
    _ = ∑ _S ∈ Vg n,
        Real.exp (-((Er n).choose 2 : ℕ) / 16 : ℝ) := by
