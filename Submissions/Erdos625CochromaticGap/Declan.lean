      Finset.univ.prod (fun a ↦ Finset.univ.prod (fun b ↦
        Ck row col (Finset.univ.sum row) a b ^
            demand a b /
          ((demand a b).factorial : ℝ≥0∞))) := by
  let m := Finset.univ.sum row
  let x := E4 demand
  let F := m.descFactorial x
  let D := Jx demand
  let N := Wv demand row *
    W6 demand col
  let C := Lg demand row col
  have h68 := Ael demand row col B9 WQ
  change _ ≤ (N : ℝ≥0∞) / ((F * D : ℕ) : ℝ≥0∞) at h68
  have hnum : (N : ℝ≥0∞) ≤ (C : ℝ≥0∞) := by
    exact_mod_cast
      AlV demand row col
  have hfall : ((m : ℝ≥0∞) / C6) ^ x ≤ (F : ℝ≥0∞) := by
    exact AOU hm WQ
  have hden :
      ((m : ℝ≥0∞) / C6) ^ x * (D : ℝ≥0∞) ≤
        ((F * D : ℕ) : ℝ≥0∞) := by
    simpa [Nat.cast_mul] using
      (mul_le_mul_left hfall (D : ℝ≥0∞))
  calc
    (F5 row col B9).toOuterMeasure
        (O9 demand row col) ≤
        (N : ℝ≥0∞) / ((F * D : ℕ) : ℝ≥0∞) := h68
    _ ≤ (C : ℝ≥0∞) /
        ((((m : ℝ≥0∞) / C6) ^ x) * (D : ℝ≥0∞)) :=
      ENNReal.div_le_div hnum hden
    _ = Finset.univ.prod (fun a ↦ Finset.univ.prod (fun b ↦
        Ck row col m a b ^ demand a b /
          ((demand a b).factorial : ℝ≥0∞))) := by
