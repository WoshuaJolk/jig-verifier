section M009
namespace Erdos625
open scoped BigOperators
def EH
    {V A : Type*} [Fintype V] [DecidableEq A]
    (label : V → A) (a : A) : ℕ :=
  (Finset.univ.filter fun v ↦ label v = a).card
def J5
    {V A B : Type*} [Fintype V] [DecidableEq A] [DecidableEq B]
    (row : V → A) (column : V → B) (a : A) (b : B) : ℕ :=
  (Finset.univ.filter fun v ↦ row v = a ∧ column v = b).card
def FL
    {V B : Type*} [Fintype V] [Fintype B] [DecidableEq B]
    (margin : B → ℕ) :=
  {column : V → B // ∀ b, EH column b = margin b}
def OP
    {V A B : Type*}
    [Fintype V] [Fintype A] [Fintype B]
    [DecidableEq A] [DecidableEq B]
    (row : V → A) (table : A → B → ℕ) :=
  {column : V → B //
    ∀ a b, J5 row column a b = table a b}
instance Auf
    {V B : Type*} [Fintype V] [Fintype B] [DecidableEq B]
    (margin : B → ℕ) :
    Finite (FL (V := V) margin) := by
  unfold FL
  infer_instance
noncomputable instance Av0
    {V B : Type*} [Fintype V] [Fintype B] [DecidableEq B]
    (margin : B → ℕ) :
    Fintype (FL (V := V) margin) :=
  Fintype.ofFinite _
instance Auj
    {V A B : Type*}
    [Fintype V] [Fintype A] [Fintype B]
    [DecidableEq A] [DecidableEq B]
    (row : V → A) (table : A → B → ℕ) :
    Finite (OP row table) := by
  unfold OP
  infer_instance
noncomputable instance AvA
    {V A B : Type*}
    [Fintype V] [Fintype A] [Fintype B]
    [DecidableEq A] [DecidableEq B]
    (row : V → A) (table : A → B → ℕ) :
    Fintype (OP row table) :=
  Fintype.ofFinite _
theorem A0t
    {V A : Type*} [Fintype V] [Fintype A] [DecidableEq A]
    (label : V → A) :
    ∑ a, EH label a = Fintype.card V := by
  simp only [EH, Finset.card_filter]
  rw [Finset.sum_comm]
  simp
theorem W5
    {V A : Type*} [Fintype V] [DecidableEq A]
    (label : V → A) (a : A) :
    Fintype.card {v : V // label v = a} = EH label a := by
  rw [Fintype.card_subtype]
  rfl
noncomputable def AAk
    {V B : Type*} [DecidableEq B]
    (margin : B → ℕ) (equiv : V ≃ Σ b, Fin (margin b)) (b : B) :
    {v : V // (equiv v).1 = b} ≃ Fin (margin b) where
  toFun v := v.2 ▸ (equiv v.1).2
  invFun i := ⟨equiv.symm ⟨b, i⟩, by simp⟩
  left_inv := by
    rintro ⟨v, rfl⟩
    simp
  right_inv := by
    intro i
    have h := equiv.apply_symm_apply (⟨b, i⟩ : Σ b, Fin (margin b))
    refine eq_of_heq ?_
    rw [eqRec_heq_iff_heq, h]
noncomputable def A0j
    {V B : Type*} [DecidableEq B]
    (margin : B → ℕ) (column : V → B)
    (orders : ∀ b, {v : V // column v = b} ≃ Fin (margin b)) :
    V ≃ Σ b, Fin (margin b) :=
  (Equiv.sigmaFiberEquiv column).symm.trans
    (Equiv.sigmaCongrRight orders)
@[simp]
theorem Am3
    {V B : Type*} [DecidableEq B]
    (margin : B → ℕ) (column : V → B)
    (orders : ∀ b, {v : V // column v = b} ≃ Fin (margin b))
    (v : V) :
    A0j margin column orders v =
      ⟨column v, orders (column v) ⟨v, rfl⟩⟩ := by
  rfl
noncomputable def Akg
    {V B : Type*} [DecidableEq B] (margin : B → ℕ) :
    (V ≃ Σ b, Fin (margin b)) ≃
      Σ column : V → B,
        ∀ b, {v : V // column v = b} ≃ Fin (margin b) where
  toFun equiv :=
    ⟨fun v ↦ (equiv v).1, fun b ↦ AAk margin equiv b⟩
  invFun data := A0j margin data.1 data.2
  left_inv := by
    intro equiv
    apply Equiv.ext
    intro v
    simp [AAk]
  right_inv := by
    rintro ⟨column, orders⟩
    refine Sigma.ext rfl (heq_of_eq ?_)
    funext b
    apply Equiv.ext
    rintro ⟨v, hv⟩
    have hvb : column v = b := by
      simpa only [Am3] using hv
    cases hvb
    change column v = column v at hv
    have Adz : hv = rfl := Subsingleton.elim _ _
    cases Adz
    rfl
noncomputable def Akh
    {V B : Type*} [Fintype V] [Fintype B] [DecidableEq B]
    (margin : B → ℕ) :
    (Σ column : V → B,
        ∀ b, {v : V // column v = b} ≃ Fin (margin b)) ≃
      Σ column : FL (V := V) margin,
        ∀ b, {v : V // column.1 v = b} ≃ Fin (margin b) where
  toFun data := by
    have NZ : ∀ b, EH data.1 b = margin b := by
      intro b
      rw [← W5 data.1 b]
      simpa using Fintype.card_congr (data.2 b)
    exact ⟨⟨data.1, NZ⟩, data.2⟩
  invFun data := ⟨data.1.1, data.2⟩
  left_inv := by
    intro data
    rfl
  right_inv := by
    rintro ⟨⟨column, NZ⟩, orders⟩
    apply Sigma.ext
    · apply Subtype.ext
      rfl
    · rfl
noncomputable def A2a
    {V B : Type*} [Fintype V] [Fintype B] [DecidableEq B]
    (margin : B → ℕ) :
    (V ≃ Σ b, Fin (margin b)) ≃
      Σ column : FL (V := V) margin,
        ∀ b, {v : V // column.1 v = b} ≃ Fin (margin b) :=
  (Akg margin).trans
    (Akh margin)
theorem vO
    {V B : Type*} [Fintype V] [Fintype B] [DecidableEq B]
    (margin : B → ℕ)
    (B9 : ∑ b, margin b = Fintype.card V) :
    Fintype.card (FL (V := V) margin) *
        ∏ b, (margin b).factorial =
      (Fintype.card V).factorial := by
  classical
  have A4r : Fintype.card V = Fintype.card (Σ b, Fin (margin b)) := by
    rw [Fintype.card_sigma]
    simpa using B9.symm
  let AIt : V ≃ Σ b, Fin (margin b) :=
    Fintype.equivOfCardEq A4r
  have AYV :
      Fintype.card (V ≃ Σ b, Fin (margin b)) =
        (Fintype.card V).factorial := by
    exact Fintype.card_equiv AIt
  have A5k : ∀ column : FL (V := V) margin,
      Fintype.card (∀ b, {v : V // column.1 v = b} ≃ Fin (margin b)) =
        ∏ b, (margin b).factorial := by
    intro column
    rw [Fintype.card_pi]
    apply Finset.prod_congr rfl
    intro b hb
    have zP :
        Fintype.card {v : V // column.1 v = b} = Fintype.card (Fin (margin b)) := by
      rw [W5, column.2 b, Fintype.card_fin]
    calc
      Fintype.card ({v : V // column.1 v = b} ≃ Fin (margin b)) =
          (Fintype.card {v : V // column.1 v = b}).factorial :=
        Fintype.card_equiv (Fintype.equivOfCardEq zP)
      _ = (margin b).factorial := by
        rw [zP, Fintype.card_fin]
  calc
    Fintype.card (FL (V := V) margin) *
          ∏ b, (margin b).factorial =
        ∑ AqC : FL (V := V) margin,
          ∏ b, (margin b).factorial := by simp
    _ = ∑ column : FL (V := V) margin,
          Fintype.card
            (∀ b, {v : V // column.1 v = b} ≃ Fin (margin b)) := by
      apply Finset.sum_congr rfl
      intro column IT
      exact (A5k column).symm
    _ = Fintype.card
          (Σ column : FL (V := V) margin,
            ∀ b, {v : V // column.1 v = b} ≃ Fin (margin b)) := by
      rw [Fintype.card_sigma]
    _ = Fintype.card (V ≃ Σ b, Fin (margin b)) := by
      exact Fintype.card_congr (A2a margin).symm
    _ = (Fintype.card V).factorial := AYV
theorem A7c
    {V A B : Type*}
    [Fintype V] [DecidableEq A] [DecidableEq B]
    (row : V → A) (column : V → B) (a : A) (b : B) :
    EH (fun v : {v : V // row v = a} ↦ column v.1) b =
      J5 row column a b := by
  rw [← W5]
  rw [J5, ← Fintype.card_subtype]
  apply Fintype.card_congr
  exact
    { toFun := fun v ↦ ⟨v.1.1, v.1.2, v.2⟩
      invFun := fun v ↦ ⟨⟨v.1, v.2.1⟩, v.2.2⟩
      left_inv := fun v ↦ rfl
      right_inv := fun v ↦ rfl }
theorem AHV
    {V A B : Type*}
    [Fintype V] [Fintype B] [DecidableEq A] [DecidableEq B]
    (row : V → A) (column : V → B) (a : A) :
    ∑ b, J5 row column a b =
      EH row a := by
  calc
    ∑ b, J5 row column a b =
        ∑ b, EH
          (fun v : {v : V // row v = a} ↦ column v.1) b := by
      apply Finset.sum_congr rfl
      intro b hb
      exact (A7c
        row column a b).symm
    _ = Fintype.card {v : V // row v = a} :=
      A0t _
    _ = EH row a := W5 row a
theorem Ah8
    {V A B : Type*}
    [Fintype V] [DecidableEq A] [DecidableEq B]
    (row : V → A) (column : V → B) (a : A) (b : B) :
    J5 row column a b =
      J5 column row b a := by
  unfold J5
  congr 1
  ext v
  simp only [Finset.mem_filter, Finset.mem_univ, true_and]
  exact and_comm
theorem AHU
    {V A B : Type*}
    [Fintype V] [Fintype A] [DecidableEq A] [DecidableEq B]
    (row : V → A) (column : V → B) (b : B) :
    ∑ a, J5 row column a b =
      EH column b := by
  calc
    ∑ a, J5 row column a b =
        ∑ a, J5 column row b a := by
      apply Finset.sum_congr rfl
      intro a ha
      exact Ah8 row column a b
    _ = EH column b :=
      AHV column row b
def Yf
    {V A B : Type*}
    [Fintype V] [Fintype A] [Fintype B]
    [DecidableEq A] [DecidableEq B]
    (row : V → A) (table : A → B → ℕ) (BU : B → ℕ) :=
  {column : FL (V := V) BU //
    ∀ a b, J5 row column.1 a b = table a b}
instance Auh
    {V A B : Type*}
    [Fintype V] [Fintype A] [Fintype B]
    [DecidableEq A] [DecidableEq B]
    (row : V → A) (table : A → B → ℕ) (BU : B → ℕ) :
    Finite (Yf row table BU) := by
  unfold Yf
  infer_instance
noncomputable instance Av1
    {V A B : Type*}
    [Fintype V] [Fintype A] [Fintype B]
    [DecidableEq A] [DecidableEq B]
    (row : V → A) (table : A → B → ℕ) (BU : B → ℕ) :
    Fintype (Yf row table BU) :=
  Fintype.ofFinite _
def AhC
    {V A B : Type*}
    [Fintype V] [Fintype A] [Fintype B]
    [DecidableEq A] [DecidableEq B]
    (row : V → A) (table : A → B → ℕ) (BU : B → ℕ)
    (IT : ∀ b, ∑ a, table a b = BU b) :
    OP row table ≃
      Yf row table BU where
  toFun column := by
    have NZ : ∀ b, EH column.1 b = BU b := by
      intro b
      calc
        EH column.1 b =
            ∑ a, J5 row column.1 a b :=
          (AHU row column.1 b).symm
        _ = ∑ a, table a b := by
          apply Finset.sum_congr rfl
          intro a ha
          exact column.2 a b
        _ = BU b := IT b
    exact ⟨⟨column.1, NZ⟩, column.2⟩
  invFun column := ⟨column.1.1, column.2⟩
  left_inv := by
    intro column
    apply Subtype.ext
    rfl
  right_inv := by
    intro column
    apply Subtype.ext
    apply Subtype.ext
    rfl
theorem A1X
    {V A B : Type*}
    [Fintype V] [Fintype A] [Fintype B]
    [DecidableEq A] [DecidableEq B]
    (row : V → A) (table : A → B → ℕ) (BU : B → ℕ)
    (IT : ∀ b, ∑ a, table a b = BU b) :
    Fintype.card (Yf row table BU) =
      Fintype.card (OP row table) :=
  Fintype.card_congr
    (AhC
      row table BU IT).symm
def AhD
    {V A B : Type*}
    [Fintype V] [Fintype A] [Fintype B]
    [DecidableEq A] [DecidableEq B]
    (row : V → A) (table : A → B → ℕ) :
    OP row table ≃
      ∀ a, FL (V := {v : V // row v = a}) (table a) where
  toFun column a :=
    ⟨fun v ↦ column.1 v.1, fun b ↦ by
      rw [A7c]
      exact column.2 a b⟩
  invFun rows :=
    ⟨fun v ↦ (rows (row v)).1 ⟨v, rfl⟩, fun a b ↦ by
      rw [← A7c]
      have AaO :
          (fun v : {v : V // row v = a} ↦
            (rows (row v.1)).1 ⟨v.1, rfl⟩) = (rows a).1 := by
        funext v
        rcases v with ⟨v, hv⟩
        cases hv
        rfl
      rw [AaO]
      exact (rows a).2 b⟩
  left_inv := by
    intro column
    apply Subtype.ext
    funext v
    rfl
  right_inv := by
    intro rows
    funext a
    apply Subtype.ext
    funext v
    rcases v with ⟨v, hv⟩
    cases hv
    rfl
theorem A1a
    {V A B : Type*}
    [Fintype V] [Fintype A] [Fintype B]
    [DecidableEq A] [DecidableEq B]
    (row : V → A) (table : A → B → ℕ)
    (hrow : ∀ a, ∑ b, table a b = EH row a) :
    Fintype.card (OP row table) *
        ∏ a, ∏ b, (table a b).factorial =
      ∏ a, (EH row a).factorial := by
  classical
  have A07 : ∀ a,
      ∑ b, table a b = Fintype.card {v : V // row v = a} := by
    intro a
    rw [hrow a, W5]
  have A6A : ∀ a,
      Fintype.card
          (FL (V := {v : V // row v = a}) (table a)) *
          ∏ b, (table a b).factorial =
        (EH row a).factorial := by
    intro a
    simpa [W5] using
      vO (table a) (A07 a)
  rw [Fintype.card_congr (AhD row table),
    Fintype.card_pi]
  calc
    (∏ a, Fintype.card
        (FL (V := {v : V // row v = a}) (table a))) *
          ∏ a, ∏ b, (table a b).factorial =
        ∏ a, (Fintype.card
          (FL (V := {v : V // row v = a}) (table a)) *
            ∏ b, (table a b).factorial) := by
      rw [Finset.prod_mul_distrib]
    _ = ∏ a, (EH row a).factorial := by
      apply Finset.prod_congr rfl
      intro a ha
      exact A6A a
theorem AKa
    {V A B : Type*}
    [Fintype V] [Fintype A] [Fintype B]
    [DecidableEq A] [DecidableEq B]
    (row : V → A) (table : A → B → ℕ) (BU : B → ℕ)
    (hrow : ∀ a, ∑ b, table a b = EH row a)
    (IT : ∀ b, ∑ a, table a b = BU b) :
    Fintype.card (OP row table) *
          (Fintype.card V).factorial *
          (∏ a, ∏ b, (table a b).factorial) =
      Fintype.card (FL (V := V) BU) *
          (∏ a, (EH row a).factorial) *
          (∏ b, (BU b).factorial) := by
  classical
  have B9 : ∑ b, BU b = Fintype.card V := by
    calc
      ∑ b, BU b = ∑ b, ∑ a, table a b := by
        apply Finset.sum_congr rfl
        intro b hb
        exact (IT b).symm
      _ = ∑ a, ∑ b, table a b := Finset.sum_comm
      _ = ∑ a, EH row a := by
        apply Finset.sum_congr rfl
        intro a ha
        exact hrow a
      _ = Fintype.card V := A0t row
  have A5l := A1a row table hrow
  have NZ := vO BU B9
  calc
    Fintype.card (OP row table) *
          (Fintype.card V).factorial *
          (∏ a, ∏ b, (table a b).factorial) =
        (Fintype.card (OP row table) *
          (∏ a, ∏ b, (table a b).factorial)) *
          (Fintype.card V).factorial := by ac_rfl
    _ = (∏ a, (EH row a).factorial) *
          (Fintype.card V).factorial := by rw [A5l]
    _ = (∏ a, (EH row a).factorial) *
          (Fintype.card (FL (V := V) BU) *
            ∏ b, (BU b).factorial) := by rw [NZ]
    _ = Fintype.card (FL (V := V) BU) *
          (∏ a, (EH row a).factorial) *
          (∏ b, (BU b).factorial) := by ac_rfl
theorem AhE
    {V A B : Type*}
    [Fintype V] [Fintype A] [Fintype B]
    [DecidableEq A] [DecidableEq B]
    (row : V → A) (table : A → B → ℕ) (BU : B → ℕ)
    (hrow : ∀ a, ∑ b, table a b = EH row a)
    (IT : ∀ b, ∑ a, table a b = BU b) :
    (Fintype.card (OP row table) : ℚ) /
          Fintype.card (FL (V := V) BU) =
      ((∏ a, (EH row a).factorial) *
          ∏ b, (BU b).factorial : ℕ) /
        (((Fintype.card V).factorial *
          ∏ a, ∏ b, (table a b).factorial : ℕ) : ℚ) := by
  classical
  have B9 : ∑ b, BU b = Fintype.card V := by
    calc
      ∑ b, BU b = ∑ b, ∑ a, table a b := by
        apply Finset.sum_congr rfl
        intro b hb
        exact (IT b).symm
      _ = ∑ a, ∑ b, table a b := Finset.sum_comm
      _ = ∑ a, EH row a := by
        apply Finset.sum_congr rfl
        intro a ha
        exact hrow a
      _ = Fintype.card V := A0t row
  have NZ := vO BU B9
  have AbA :
      Fintype.card (FL (V := V) BU) ≠ 0 := by
    intro hzero
    rw [hzero, zero_mul] at NZ
    exact Nat.factorial_ne_zero _ NZ.symm
  have AdT :
      (∏ a, ∏ b, (table a b).factorial) ≠ 0 := by
    exact Finset.prod_ne_zero_iff.mpr fun a ha ↦
      Finset.prod_ne_zero_iff.mpr fun b hb ↦ Nat.factorial_ne_zero _
  have AZe :
      (Fintype.card V).factorial *
          (∏ a, ∏ b, (table a b).factorial) ≠ 0 :=
    Nat.mul_ne_zero (Nat.factorial_ne_zero _) AdT
  have e6 :=
    AKa
      row table BU hrow IT
  have AZT :
      Fintype.card (OP row table) *
          ((Fintype.card V).factorial *
            (∏ a, ∏ b, (table a b).factorial)) =
        ((∏ a, (EH row a).factorial) *
            ∏ b, (BU b).factorial) *
          Fintype.card (FL (V := V) BU) := by
    calc
      Fintype.card (OP row table) *
          ((Fintype.card V).factorial *
            (∏ a, ∏ b, (table a b).factorial)) =
        Fintype.card (OP row table) *
          (Fintype.card V).factorial *
          (∏ a, ∏ b, (table a b).factorial) := by ac_rfl
      _ = Fintype.card (FL (V := V) BU) *
          (∏ a, (EH row a).factorial) *
          (∏ b, (BU b).factorial) := e6
      _ = ((∏ a, (EH row a).factorial) *
            ∏ b, (BU b).factorial) *
          Fintype.card (FL (V := V) BU) := by ac_rfl
  apply (div_eq_div_iff (by exact_mod_cast AbA)
    (by exact_mod_cast AZe)).2
  exact_mod_cast AZT
theorem AQo
    {V A B : Type*}
    [Fintype V] [Fintype A] [Fintype B]
    [DecidableEq A] [DecidableEq B]
    (row : V → A) (table : A → B → ℕ) (BU : B → ℕ)
    (hrow : ∀ a, ∑ b, table a b = EH row a)
    (IT : ∀ b, ∑ a, table a b = BU b) :
    (Fintype.card (Yf row table BU) : ℚ) /
          Fintype.card (FL (V := V) BU) =
      ((∏ a, (EH row a).factorial) *
          ∏ b, (BU b).factorial : ℕ) /
        (((Fintype.card V).factorial *
          ∏ a, ∏ b, (table a b).factorial : ℕ) : ℚ) := by
  rw [A1X row table BU IT]
  exact AhE
    row table BU hrow IT
end Erdos625
end M009

section M010
namespace Erdos625
open MeasureTheory SimpleGraph
open scoped BigOperators ENNReal symmDiff
noncomputable section
def QK {b n : ℕ} {k : AG b}
    (G : LabeledGraph n) (P : BT n k)
    (σ : P.1.parts → Bool) : Prop :=
  ∀ B : P.1.parts,
    match σ B with
    | false => G.IsIndepSet (B.1 : Set (Fin n))
    | true => G.IsClique (B.1 : Set (Fin n))
abbrev OQ {b : ℕ} (n : ℕ)
    (k : AG b) :=
  Σ P : BT n k, P.1.parts → Bool
def AID {b n : ℕ} {k : AG b}
    (G : LabeledGraph n) (w : OQ n k) : Prop :=
  QK G w.1 w.2
noncomputable def PZ {b n : ℕ}
    (G : LabeledGraph n) (k : AG b) : ℕ := by
  classical
  exact (Finset.univ.filter fun w : OQ n k =>
    AID G w).card
noncomputable def Gt {b n : ℕ}
    {k : AG b} (P : BT n k)
    (σ : P.1.parts → Bool) : LabeledGraph n :=
  P.1.parts.attach.sup fun B => if σ B then completeOn B.1 else ⊥
theorem AmM
    {b n : ℕ} {k : AG b}
    (P : BT n k) (σ : P.1.parts → Bool) :
    Gt P σ ≤ Gq P.1 := by
  classical
  unfold Gt Gq
  refine Finset.sup_le_iff.mpr ?_
  intro B hB
  by_cases hσ : σ B
  · simp only [hσ, ite_true]
    exact Finset.le_sup B.2
  · simp [hσ]
theorem lU
    {b n : ℕ} {k : AG b}
    (P : BT n k) (σ : P.1.parts → Bool)
    (B : P.1.parts) (hB : σ B = true) :
    completeOn B.1 ≤ Gt P σ := by
  classical
  unfold Gt
  refine Finset.le_sup_of_le
    (s := P.1.parts.attach)
    (f := fun C => if σ C then completeOn C.1 else ⊥)
    (Finset.mem_attach P.1.parts B) ?_
  simp [hB]
theorem AmL
    {b n : ℕ} {k : AG b}
    (P : BT n k) (σ : P.1.parts → Bool)
    (B : P.1.parts) (hB : σ B = false) :
    Disjoint (Gt P σ) (completeOn B.1) := by
  classical
  unfold Gt
  rw [Finset.disjoint_sup_left]
  intro C hC
  by_cases A32 : σ C
  · rw [if_pos A32]
    apply w5
    apply P.1.disjoint C.2 B.2
    intro hCB
    have hCB' : C = B := Subtype.ext hCB
    subst C
    simp [hB] at A32
  · simp [A32]
theorem A6V {n : ℕ} (G : LabeledGraph n)
    (S : Finset (Fin n)) :
    G.IsClique (S : Set (Fin n)) ↔ completeOn S ≤ G := by
  constructor
  · intro h x y hxy
    rw [completeOn, SimpleGraph.map_adj] at hxy
    obtain ⟨x', y', hne, rfl, rfl⟩ := hxy
    exact h x'.property y'.property (by simpa using hne)
  · intro h x hx y hy hxy
    apply h
    rw [completeOn, SimpleGraph.map_adj]
    exact ⟨⟨x, hx⟩, ⟨y, hy⟩, by simpa using hxy, rfl, rfl⟩
theorem AmN
    {b n : ℕ} {k : AG b}
    (P : BT n k) (σ : P.1.parts → Bool)
    (B : P.1.parts) (hB : σ B = true) :
    Disjoint
      (Gt P σ ∆ completeOn B.1)
      (completeOn B.1) := by
  have hle : completeOn B.1 ≤ Gt P σ :=
    lU P σ B hB
  rw [symmDiff_of_ge hle]
  exact disjoint_sdiff_self_left
theorem AEB
    {b n : ℕ} {k : AG b} (G : LabeledGraph n)
    (P : BT n k) (σ : P.1.parts → Bool)
    (B : P.1.parts) (hB : σ B = false) :
    (G ∆ Gt P σ).IsIndepSet (B.1 : Set (Fin n)) ↔
      G.IsIndepSet (B.1 : Set (Fin n)) := by
  rw [ZM,
    ZM]
  have hdis : Disjoint (Gt P σ) (completeOn B.1) :=
    AmL P σ B hB
  constructor
  · intro h
    have h' : Disjoint
        ((G ∆ Gt P σ) ∆
          Gt P σ)
        (completeOn B.1) := h.symmDiff_left hdis
    simpa using h'
  · intro h
    exact h.symmDiff_left hdis
theorem AEA
    {b n : ℕ} {k : AG b} (G : LabeledGraph n)
    (P : BT n k) (σ : P.1.parts → Bool)
    (B : P.1.parts) (hB : σ B = true) :
    (G ∆ Gt P σ).IsIndepSet (B.1 : Set (Fin n)) ↔
      G.IsClique (B.1 : Set (Fin n)) := by
  rw [ZM,
    A6V]
  let H := Gt P σ
  let C := completeOn B.1
  have hHC : Disjoint (H ∆ C) C := by
    simpa only [H, C] using
      (AmN
        P σ B hB)
  have hswap : (G ∆ H) ∆ (H ∆ C) = G ∆ C := by
    rw [symmDiff_assoc]
    simp
  have A6N : (G ∆ C) ∆ (H ∆ C) = G ∆ H := by
    calc
      (G ∆ C) ∆ (H ∆ C) = G ∆ (C ∆ (H ∆ C)) :=
        symmDiff_assoc G C (H ∆ C)
      _ = G ∆ ((C ∆ H) ∆ C) :=
        congrArg (fun X => G ∆ X) (symmDiff_assoc C H C).symm
      _ = G ∆ ((H ∆ C) ∆ C) :=
        congrArg (fun X => G ∆ (X ∆ C)) (symmDiff_comm C H)
      _ = G ∆ H := by simp
  constructor
  · intro h
    have hrem : Disjoint (G ∆ C) C := by
      rw [← hswap]
      exact h.symmDiff_left hHC
    have hle : C ≤ (G ∆ C) ∆ C :=
      Iff.mpr (le_symmDiff_iff_right (G ∆ C) C) hrem
    simpa using hle
  · intro h
    have hGC : Disjoint (G ∆ C) C := by
      rw [symmDiff_of_ge h]
      exact disjoint_sdiff_self_left
    rw [← A6N]
    exact hGC.symmDiff_left hHC
theorem Ajy
    {b n : ℕ} {k : AG b} (G : LabeledGraph n)
    (P : BT n k) (σ : P.1.parts → Bool) :
    QK G P σ ↔
      G ∆ Gt P σ ∈ KX P.1 := by
  constructor
  · intro h
    change ∀ B ∈ P.1.parts,
      (G ∆ Gt P σ).IsIndepSet (B : Set (Fin n))
    intro B hB
    let B' : P.1.parts := ⟨B, hB⟩
    cases hsign : σ B' with
    | false =>
        exact (AEB
          G P σ B' hsign).mpr (by simpa [hsign] using h B')
    | true =>
        exact
          (AEA
            G P σ B' hsign).mpr (by simpa [hsign] using h B')
  · intro h B
    have hB : (G ∆ Gt P σ).IsIndepSet
        (B.1 : Set (Fin n)) := h B.1 B.2
    cases hsign : σ B with
    | false =>
        exact (AEB
          G P σ B hsign).mp hB
    | true =>
        exact
          (AEA
            G P σ B hsign).mp hB
theorem AkW (n : ℕ) (H : LabeledGraph n) :
    (randomGraphMeasure n).map (fun G : LabeledGraph n => G ∆ H) =
      randomGraphMeasure n := by
  classical
  apply Measure.ext_of_singleton
  intro G
  rw [Measure.map_apply (measurable_of_finite _) (MeasurableSet.singleton G)]
  have hpre :
      (fun K : LabeledGraph n => K ∆ H) ⁻¹' ({G} : Set (LabeledGraph n)) =
        {G ∆ H} := by
    ext K
    simp only [Set.mem_preimage, Set.mem_singleton_iff]
    constructor
    · intro h
      calc
        K = (K ∆ H) ∆ H := (symmDiff_symmDiff_cancel_right H K).symm
        _ = G ∆ H := congrArg (fun X => X ∆ H) h
    · intro h
      calc
        K ∆ H = (G ∆ H) ∆ H := congrArg (fun X => X ∆ H) h
        _ = G := symmDiff_symmDiff_cancel_right H G
  rw [hpre, Wt,
    Wt]
theorem Akc
    (n : ℕ) (H : LabeledGraph n) (A : Set (LabeledGraph n)) :
    randomGraphMeasure n {G | G ∆ H ∈ A} = randomGraphMeasure n A := by
  calc
    randomGraphMeasure n {G | G ∆ H ∈ A} =
        randomGraphMeasure n ((fun G : LabeledGraph n => G ∆ H) ⁻¹' A) := rfl
    _ = ((randomGraphMeasure n).map
        (fun G : LabeledGraph n => G ∆ H)) A :=
      (Measure.map_apply (measurable_of_finite _)
        (Set.toFinite A |>.measurableSet)).symm
    _ = randomGraphMeasure n A := by rw [AkW]
def TP {b n : ℕ} {k : AG b}
    (P : BT n k) (σ : P.1.parts → Bool) :
    Set (LabeledGraph n) :=
  {G | QK G P σ}
theorem AkZ
    {b n : ℕ} {k : AG b}
    (P : BT n k) (σ : P.1.parts → Bool) :
    randomGraphMeasure n (TP P σ) =
      (1 / 2 : ENNReal) ^ AG.Eo k := by
  have I8 : TP P σ =
      {G | G ∆ Gt P σ ∈
        KX P.1} := by
    ext G
    exact Ajy G P σ
  rw [I8, Akc,
    AGK]
noncomputable def NA {b n : ℕ}
    (G : LabeledGraph n) {k : AG b}
    (P : BT n k) (σ : P.1.parts → Bool) : ℕ := by
  classical
  exact if QK G P σ then 1 else 0
theorem AGp {b n : ℕ}
    (G : LabeledGraph n) (k : AG b) :
    PZ G k =
      ∑ P : BT n k, ∑ σ : P.1.parts → Bool,
        NA G P σ := by
  classical
  unfold PZ NA
  rw [Finset.card_filter, Fintype.sum_sigma]
  rfl
theorem Ao0 {b n : ℕ}
    {k : AG b} (P : BT n k)
    (σ : P.1.parts → Bool) :
    (∑ G : LabeledGraph n,
      (NA G P σ : ENNReal) *
        randomGraphMeasure n {G}) =
      randomGraphMeasure n (TP P σ) := by
  classical
  let T := (Finset.univ : Finset (LabeledGraph n)).filter
    fun G => QK G P σ
  calc
    _ = ∑ G : LabeledGraph n,
        if QK G P σ then randomGraphMeasure n {G} else 0 := by
      apply Finset.sum_congr rfl
      intro G _
      by_cases h : QK G P σ <;>
        simp [NA, h]
    _ = ∑ G ∈ T, randomGraphMeasure n {G} := by
      simp only [T, Finset.sum_filter]
    _ = randomGraphMeasure n (T : Set (LabeledGraph n)) := by
      rw [MeasureTheory.sum_measure_singleton]
    _ = randomGraphMeasure n (TP P σ) := by
      congr 1
      ext G
      simp [T, TP]
noncomputable def DY {b : ℕ}
    (n : ℕ) (k : AG b) : ENNReal :=
  ∑ G : LabeledGraph n,
    (PZ G k : ENNReal) * randomGraphMeasure n {G}
theorem kR {b : ℕ}
    (n : ℕ) (k : AG b) :
    DY n k =
      (2 : ENNReal) ^ AG.D8 k *
        JT n k := by
  classical
  let p : ENNReal := (1 / 2 : ENNReal) ^ AG.Eo k
  have hsign (P : BT n k) :
      (∑ _σ : P.1.parts → Bool, p) =
        (2 : ENNReal) ^ AG.D8 k * p := by
    simp [p, nsmul_eq_mul, P.card_parts_eq]
  unfold DY
  simp_rw [AGp, Nat.cast_sum,
    Finset.sum_mul]
  calc
    (∑ G : LabeledGraph n,
      ∑ P : BT n k, ∑ σ : P.1.parts → Bool,
        (NA G P σ : ENNReal) *
          randomGraphMeasure n {G}) =
        ∑ P : BT n k, ∑ σ : P.1.parts → Bool,
          ∑ G : LabeledGraph n,
            (NA G P σ : ENNReal) *
              randomGraphMeasure n {G} := by
          rw [Finset.sum_comm]
          apply Finset.sum_congr rfl
          intro P _
          rw [Finset.sum_comm]
    _ = ∑ P : BT n k, ∑ σ : P.1.parts → Bool, p := by
          apply Finset.sum_congr rfl
          intro P _
          apply Finset.sum_congr rfl
          intro σ _
          rw [Ao0,
            AkZ]
    _ = (2 : ENNReal) ^ AG.D8 k *
        JT n k := by
          simp_rw [hsign]
          rw [kA]
          simp [Finset.sum_const, nsmul_eq_mul, Nat.card_eq_fintype_card,
            p, mul_assoc, mul_comm, mul_left_comm]
noncomputable def Ajw {b n : ℕ} {k : AG b}
    {G : LabeledGraph n} (P : BT n k)
    (σ : P.1.parts → Bool) (hσ : QK G P σ) :
    CoColoring G P.1.parts := by
  classical
  let color : Fin n → P.1.parts := fun v =>
    ⟨P.1.part v, P.1.part_mem.mpr (Finset.mem_univ v)⟩
  have Nz (B : P.1.parts) :
      {v | color v = B} = (B.1 : Set (Fin n)) := by
    ext v
    dsimp [color]
    constructor
    · intro h
      exact (P.1.part_eq_iff_mem B.2).mp (congrArg Subtype.val h)
    · intro h
      apply Subtype.ext
      exact (P.1.part_eq_iff_mem B.2).mpr h
  exact
    { color := color
      kind := fun B => if σ B then .clique else .independent
      valid := by
        intro B
        rw [Nz B]
        cases hB : σ B with
        | false => simpa [hB] using hσ B
        | true => simpa [hB] using hσ B }
theorem Ajx {b n : ℕ} {k : AG b}
    {G : LabeledGraph n} (P : BT n k)
    (σ : P.1.parts → Bool) (hσ : QK G P σ) :
    CoColorable G (AG.D8 k) := by
  classical
  have hcard : P.1.parts.card = AG.D8 k :=
    P.card_parts_eq
  exact ⟨(Ajw P σ hσ).relabel
    (Finset.equivFinOfCardEq hcard)⟩
theorem AmF
    {b n : ℕ} {G : LabeledGraph n} {k : AG b} :
    0 < PZ G k →
      CoColorable G (AG.D8 k) := by
  classical
  intro hpos
  unfold PZ at hpos
  obtain ⟨w, hw⟩ := Finset.card_pos.mp hpos
  rw [Finset.mem_filter] at hw
  exact Ajx w.1 w.2 hw.2
end
end Erdos625
end M010

section M011
namespace Erdos625
open scoped BigOperators
noncomputable section
abbrev Bl {b : ℕ} (k : AG b) :=
  G9 (AG.sizes k)
def AO {b : ℕ} (k : AG b) :
    Bl k → ℕ := fun q => q.1
abbrev Ac {b : ℕ} (n : ℕ)
    (k : AG b) :=
  FL (V := Fin n) (AO k)
abbrev Om {b n : ℕ} {k : AG b}
    (P : BT n k) :=
  ∀ s : (AG.sizes k).toFinset,
    HW P s.1 ≃
      Fin ((AG.sizes k).count (s : ℕ))
def Aiz {b : ℕ}
    (k : AG b) :
    (Σ q : Bl k, Fin (AO k q)) ≃
      Dm (AG.sizes k) where
  toFun x := ⟨x.1.1, x.1.2, x.2⟩
  invFun x := ⟨⟨x.1, x.2.1⟩, x.2.2⟩
  left_inv := fun _ => rfl
  right_inv := fun _ => rfl
abbrev FN {b : ℕ} (n : ℕ)
    (k : AG b) :=
  Σ P : BT n k, Om P
def N5 {b : ℕ} (k : AG b) : ℕ :=
  ∏ s : (AG.sizes k).toFinset,
    Nat.factorial ((AG.sizes k).count (s : ℕ))
theorem AFl
    {b : ℕ} (k : AG b) :
    N5 k =
      ∏ i : Fin b, Nat.factorial (k i) := by
  rw [N5]
  rw [show
      (Finset.univ : Finset (AG.sizes k).toFinset) =
        (AG.sizes k).toFinset.attach by
    ext s
    simp]
  rw [Finset.prod_attach
    (s := (AG.sizes k).toFinset)
    (f := fun s : ℕ =>
      Nat.factorial ((AG.sizes k).count s))]
  have hzero : 0 ∉ (AG.sizes k).toFinset := by
    simpa only [Multiset.mem_toFinset] using A8M k
  rw [← Finset.erase_eq_of_notMem hzero]
  exact AG.A7D k
theorem vQ {b n : ℕ} {k : AG b}
    (P : BT n k) :
    Fintype.card (Om P) =
      N5 k := by
  classical
  rw [Fintype.card_pi, N5]
  apply Finset.prod_congr rfl
  intro s hs
  have C7 :
      Fintype.card (HW P s.1) =
        (AG.sizes k).count (s : ℕ) :=
    A98 P s.1
  let e : HW P s ≃
      Fin ((AG.sizes k).count (s : ℕ)) :=
    Fintype.equivOfCardEq
      (C7.trans (Fintype.card_fin _).symm)
  calc
    Fintype.card
        (HW P s ≃
          Fin ((AG.sizes k).count (s : ℕ))) =
        Nat.factorial (Fintype.card (HW P s)) :=
      Fintype.card_equiv e
    _ = Nat.factorial ((AG.sizes k).count (s : ℕ)) := by
      rw [C7]
theorem kZ {b : ℕ}
    (k : AG b) :
    ∑ q : Bl k, AO k q =
      AG.DK k := by
  calc
    (∑ q : Bl k, AO k q) =
        ∑ q : Bl k,
          Fintype.card (Fin (AO k q)) := by
      simp
    _ = Fintype.card
          (Σ q : Bl k, Fin (AO k q)) :=
      Fintype.card_sigma.symm
    _ = Fintype.card (Dm (AG.sizes k)) :=
      Fintype.card_congr (Aiz k)
    _ = (AG.sizes k).sum :=
      A1d (AG.sizes k)
    _ = AG.DK k := rfl
theorem Ac.vertexMass_eq
    {b n : ℕ} {k : AG b}
    (P : Ac n k) :
    AG.DK k = n := by
  calc
    AG.DK k =
        ∑ q : Bl k, AO k q :=
      (kZ k).symm
    _ = ∑ q : Bl k,
          EH P.1 q := by
      apply Finset.sum_congr rfl
      intro q hq
      exact (P.2 q).symm
    _ = Fintype.card (Fin n) := A0t P.1
    _ = n := Fintype.card_fin n
theorem Aiq {b : ℕ}
    (k : AG b) :
    (∏ q : Bl k,
        Nat.factorial (AO k q)) =
      ∏ i : Fin b, (Nat.factorial (i.1 + 1)) ^ k i := by
  let m := AG.sizes k
  change (∏ q : G9 m, Nat.factorial (q.1 : ℕ)) = _
  rw [Fintype.prod_sigma]
  simp only [Finset.prod_const, Finset.card_univ, Fintype.card_fin]
  rw [show (Finset.univ : Finset m.toFinset) = m.toFinset.attach by
    ext s
    simp]
  rw [Finset.prod_attach
    (s := m.toFinset)
    (f := fun s : ℕ => Nat.factorial s ^ m.count s)]
  calc
    (∏ s ∈ m.toFinset, Nat.factorial s ^ m.count s) =
        (m.map Nat.factorial).prod := by
      rw [Finset.prod_multiset_map_count]
    _ = ∏ i : Fin b, (Nat.factorial (i.1 + 1)) ^ k i := by
      exact AG.A7E k
theorem A95
    {b n : ℕ} (k : AG b)
    (hmass : AG.DK k = n) :
    Fintype.card (Ac n k) *
        (∏ i : Fin b, (Nat.factorial (i.1 + 1)) ^ k i) =
      Nat.factorial n := by
  have B9 :
      ∑ q : Bl k, AO k q =
        Fintype.card (Fin n) := by
    rw [kZ, hmass,
      Fintype.card_fin]
  simpa only [Fintype.card_fin, Aiq] using
    vO
      (V := Fin n) (AO k) B9
theorem Aql {b n : ℕ}
    (k : AG b)
    (hmass : AG.DK k = n) :
    Fintype.card (Ac n k) =
      Nat.factorial n /
        (∏ i : Fin b, (Nat.factorial (i.1 + 1)) ^ k i) := by
  let A := ∏ i : Fin b, (Nat.factorial (i.1 + 1)) ^ k i
  have hA : A ≠ 0 := by
    exact Finset.prod_ne_zero_iff.mpr fun i hi =>
      pow_ne_zero _ (Nat.factorial_ne_zero _)
  apply Nat.eq_div_of_mul_eq_left hA
  simpa only [A] using
    A95 k hmass
theorem A92 {b n : ℕ}
    (k : AG b) :
    Fintype.card (FN n k) =
      Fintype.card (BT n k) *
        N5 k := by
  classical
  calc
    Fintype.card (FN n k) =
        ∑ P : BT n k,
          Fintype.card (Om P) := Fintype.card_sigma
    _ = ∑ _P : BT n k,
          N5 k := by
      apply Finset.sum_congr rfl
      intro P hP
