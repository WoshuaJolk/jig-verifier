structure QX
    {A B : Type*} [Fintype A] [Fintype B]
    [DecidableEq A] [DecidableEq B]
    (C M : Finset (A × B)) (code : Jt A B) : Prop where
  A1T : code.W0 = (C ∩ M).card
  A6a :
    ∃ z ∈ Kw (C ∩ M),
      code.start = J6 z ∧
        (GO code.chain).getLast? =
          some (rG z)
  A0Z : Yq code.chain = C \ M
  A14 : XO code.chain = C ∩ M
  AFC : (ML code.chain).Nodup
  A7Z :
    ∀ edge ∈ Fj code.chain,
      ∃ cell, DS edge = some cell
  A8D :
    ∀ edge ∈ GO code.chain,
      ∃ cell, DS edge = some cell
  A7Y :
    ((Fj code.chain).filterMap
      DS).Nodup
  AI3 :
    ((GO code.chain).filterMap
      DS).Nodup
