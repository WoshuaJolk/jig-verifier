      A1Y ((Hpresent ⊔ E0)ᶜ)
    _ = 2 ^ (n.choose 2 -
        (Hpresent.edgeSet.ncard + E0.edgeSet.ncard)) := by
      rw [AEp,
        AEr hdis]
theorem AkX {n : ℕ}
    (Hpresent E0 : LabeledGraph n)
    (hdis : Disjoint Hpresent E0) :
    randomGraphMeasure n (Mt Hpresent E0) =
      (1 / 2 : ENNReal) ^
        (Hpresent.edgeSet.ncard + E0.edgeSet.ncard) := by
  classical
  let T := (Finset.univ : Finset (LabeledGraph n)).filter
    fun G ↦ G ∈ Mt Hpresent E0
  have hcard : T.card =
      2 ^ (n.choose 2 -
        (Hpresent.edgeSet.ncard + E0.edgeSet.ncard)) := by
    calc
      T.card = Fintype.card {G : LabeledGraph n //
          G ∈ Mt Hpresent E0} := by
        simp [T]
      _ = Nat.card {G : LabeledGraph n //
          G ∈ Mt Hpresent E0} := by
        rw [Nat.card_eq_fintype_card]
      _ = 2 ^ (n.choose 2 -
          (Hpresent.edgeSet.ncard + E0.edgeSet.ncard)) := by
        change (Mt Hpresent E0).ncard = _
        exact Agg Hpresent E0 hdis
  have hunion : (Hpresent ⊔ E0).edgeSet.ncard ≤ n.choose 2 := by
    calc
      (Hpresent ⊔ E0).edgeSet.ncard ≤
          (Sym2.diagSetᶜ : Set (Sym2 (Fin n))).ncard :=
        Set.ncard_le_ncard (Hpresent ⊔ E0).edgeSet_subset_compl_diagSet
