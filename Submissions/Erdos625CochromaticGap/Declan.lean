theorem Agb (d r : ℕ) :
    d + r = d ↔ r = 0 := by
  constructor
  · intro h
    exact Nat.add_left_cancel (n := d) (m := r) (k := 0)
      (by simpa using h)
  · rintro rfl
    simp
theorem Agc {d r cap : ℕ} (hcap : d ≤ cap) :
    d + r ≤ cap ↔ r ≤ cap - d := by
  constructor
  · intro h
    exact (Nat.le_sub_iff_add_le hcap).2 (by
      simpa [Nat.add_comm] using h)
  · intro h
    have := (Nat.le_sub_iff_add_le hcap).1 h
    simpa [Nat.add_comm] using this
theorem AQJ
    (full demand residual cap : ℕ)
    (hsplit : full = demand + residual) (hcap : demand ≤ cap) :
    (full = demand ↔ residual = 0) ∧
      (full ≤ cap ↔ residual ≤ cap - demand) := by
  rw [hsplit]
  exact ⟨Agb demand residual,
    Agc hcap⟩
theorem A9Q
    {A B : Type*} [Fintype A] [Fintype B]
    [DecidableEq A] [DecidableEq B]
    {demand : A → B → ℕ} {row : A → ℕ} {col : B → ℕ}
    (witness : BW demand row col)
    (extension : {matching : BZ row col //
      H7 matching witness})
    (a : A) (b : B) (cap : ℕ) (hcap : demand a b ≤ cap) :
    (BX extension.1 a b = demand a b ↔
        BX
          (WA witness extension)
          a b = 0) ∧
      (BX extension.1 a b ≤ cap ↔
        BX
          (WA witness extension)
          a b ≤ cap - demand a b) := by
  exact AQJ
    (BX extension.1 a b)
    (demand a b)
    (BX
      (WA witness extension) a b)
    cap
    (j8 witness extension a b)
    hcap
