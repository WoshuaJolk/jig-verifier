theorem AL7 (a b : ℕ) (hb : 1 ≤ b) :
    Nq a b ≤ a / b + 1 := by
  unfold Nq
  calc
    (a + b - 1) / b ≤ (a + b) / b :=
      Nat.div_le_div_right (Nat.sub_le (a + b) 1)
