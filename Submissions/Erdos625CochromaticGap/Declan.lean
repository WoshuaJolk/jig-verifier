  fun i ↦ a i + YU a K D i
def AyD (K : Nat) (p : Fin 4 → Real) : Int :=
  XC (NC K p) (K : Int)
def AyE (K D : Nat) (p : Fin 4 → Real) : Int :=
  XD (NC K p) (D : Int)
def YP (K D : Nat) (p : Fin 4 → Real) : Int :=
