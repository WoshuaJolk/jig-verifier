    Nat.card {G : LabeledGraph n //
        G ∈ Mt Hpresent E0} =
        Nat.card {F : LabeledGraph n // F ≤ (Hpresent ⊔ E0)ᶜ} :=
      Nat.card_congr (AgK Hpresent E0 hdis)
