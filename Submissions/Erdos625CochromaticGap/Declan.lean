section M019
namespace Erdos625
open scoped BigOperators ENNReal
noncomputable section
namespace AG
theorem A29 {b : ℕ} (k : AG b) :
    0 < Ow k := by
  by_contra h
  have hzero : Ow k = 0 := Nat.eq_zero_of_not_pos h
  have Aa3 : Nat.factorial (DK k) = 0 := by
    rw [← A28 k, hzero]
    simp
  exact (Nat.factorial_ne_zero _) Aa3
private theorem Af8 {b : ℕ}
    (k : AG b) :
    Real.log
        ((∏ i : Fin b, (Nat.factorial (i.1 + 1)) ^ k i : ℕ) : ℝ) =
      ∑ i : Fin b,
        (k i : ℝ) * Real.log (Nat.factorial (i.1 + 1) : ℝ) := by
  rw [Nat.cast_prod, Real.log_prod]
  · apply Finset.sum_congr rfl
    intro i _
    rw [Nat.cast_pow, Real.log_pow]
  · intro i _
    positivity
private theorem Af9 {b : ℕ}
    (k : AG b) :
    Real.log ((∏ i : Fin b, Nat.factorial (k i) : ℕ) : ℝ) =
      ∑ i : Fin b, Real.log (Nat.factorial (k i) : ℝ) := by
  rw [Nat.cast_prod, Real.log_prod]
  intro i _
  positivity
theorem AfD {b : ℕ} (k : AG b) :
    Real.log (Ow k : ℝ) =
      Real.log (Nat.factorial (DK k) : ℝ) -
        ∑ i : Fin b,
          (k i : ℝ) * Real.log (Nat.factorial (i.1 + 1) : ℝ) -
        ∑ i : Fin b, Real.log (Nat.factorial (k i) : ℝ) := by
  let A : ℕ := Ow k
  let B : ℕ := ∏ i : Fin b, (Nat.factorial (i.1 + 1)) ^ k i
  let C : ℕ := ∏ i : Fin b, Nat.factorial (k i)
  have hA : (A : ℝ) ≠ 0 := by
    exact_mod_cast (A29 k).ne'
  have hB : (B : ℝ) ≠ 0 := by
    dsimp only [B]
    positivity
  have hC : (C : ℝ) ≠ 0 := by
    dsimp only [C]
    positivity
  have AbW : A * B * C = Nat.factorial (DK k) := by
    simpa only [A, B, C] using
      A28 k
  have AbX : (A : ℝ) * (B : ℝ) * (C : ℝ) =
      (Nat.factorial (DK k) : ℝ) := by
    exact_mod_cast AbW
  have hlog : Real.log (A : ℝ) + Real.log (B : ℝ) +
      Real.log (C : ℝ) =
        Real.log (Nat.factorial (DK k) : ℝ) := by
    calc
      Real.log (A : ℝ) + Real.log (B : ℝ) + Real.log (C : ℝ) =
          Real.log ((A : ℝ) * (B : ℝ)) + Real.log (C : ℝ) := by
            rw [Real.log_mul hA hB]
      _ = Real.log (((A : ℝ) * (B : ℝ)) * (C : ℝ)) := by
            rw [Real.log_mul (mul_ne_zero hA hB) hC]
      _ = Real.log (Nat.factorial (DK k) : ℝ) := by
            rw [AbX]
  rw [show A = Ow k by rfl,
    show B = ∏ i : Fin b, (Nat.factorial (i.1 + 1)) ^ k i by rfl,
    show C = ∏ i : Fin b, Nat.factorial (k i) by rfl,
    Af8, Af9] at hlog
  linarith
end AG
noncomputable def QI {b : ℕ}
    (n : ℕ) (k : AG b) : ℝ :=
  Real.log (Nat.factorial n : ℝ) -
    ∑ i : Fin b,
      (k i : ℝ) * Real.log (Nat.factorial (i.1 + 1) : ℝ) -
    ∑ i : Fin b, Real.log (Nat.factorial (k i) : ℝ) -
    (AG.Eo k : ℝ) * Real.log 2
theorem A7G {b : ℕ}
    (n : ℕ) (k : AG b)
    (hMass : AG.DK k = n) :
    0 < JT n k := by
  rw [rP n k
    (kG n k hMass)]
  apply ENNReal.mul_pos
  · exact_mod_cast (AG.A29 k).ne'
  · exact pow_ne_zero _ (by norm_num)
theorem AEQ
    {b : ℕ} (n : ℕ) (k : AG b)
    (hMass : AG.DK k = n) :
    Real.log (JT n k).toReal =
      QI n k := by
  have A3H :=
    rP n k
      (kG n k hMass)
  have AXF :
      (JT n k).toReal =
        (AG.Ow k : ℝ) *
          (1 / 2 : ℝ) ^ AG.Eo k := by
    rw [A3H, ENNReal.toReal_mul, ENNReal.toReal_pow]
    norm_num
  rw [AXF, Real.log_mul]
  · rw [Real.log_pow, AG.AfD,
      hMass, Real.log_div]
    · simp only [Real.log_one, zero_sub]
      unfold QI
      ring
    · norm_num
    · norm_num
  · exact_mod_cast (AG.A29 k).ne'
  · positivity
end
end Erdos625
end M019

section M020
namespace Erdos625
open Filter Asymptotics
noncomputable def Dq : ℝ := 1 + Real.log q - q
noncomputable def Jk (n : ℕ) : ℝ :=
  AH n - AY n + Dq
noncomputable def GJ (n : ℕ) : ℝ := 1 - C4 n
noncomputable def N4 (delta : ℝ) : ℝ :=
  delta * Dq + q / 2 * delta * (1 - delta) - 2 * Dq / q -
    (1 - delta) - (1 / 2 : ℝ) * Real.log (2 * Real.pi) - q / 2 +
    (1 / 2 : ℝ) * Real.log q
theorem k7 (n : ℕ) : 0 < GJ n := by
  exact sub_pos.mpr (JQ n)
theorem k6 (n : ℕ) : GJ n ≤ 1 := by
  exact sub_le_self 1 (Jj n)
theorem AwA (n : ℕ) : GJ n ∈ Set.Ioc (0 : ℝ) 1 :=
  ⟨k7 n, k6 n⟩
private theorem AfG {n : ℕ} (hn : 1 < n) :
    Real.log (Y6 (n : ℝ)) = AY n - Real.log q := by
  have Mj : (1 : ℝ) < n := by exact_mod_cast hn
  have hlog : AH n ≠ 0 := ne_of_gt (Real.log_pos Mj)
  have hlog' : Real.log (n : ℝ) ≠ 0 := by
    simpa only [AH] using hlog
  simpa only [Y6, AH, AY] using
    (Real.log_div hlog' q_ne_zero)
private theorem AfE :
    Real.log (Real.exp 1 / 2) = 1 - q := by
  rw [Real.log_div (Real.exp_ne_zero 1) (by norm_num : (2 : ℝ) ≠ 0)]
  simp [q]
theorem uj {n : ℕ} (hn : 1 < n) :
    JE n = 2 * Jk n / q + 1 := by
  rw [JE]
  change
    2 * (AH n / q) -
          2 * (Real.log (Y6 (n : ℝ)) / q) +
        2 * (Real.log (Real.exp 1 / 2) / q) + 1 =
      2 * Jk n / q + 1
  rw [AfG hn, AfE]
  simp only [Jk, Dq]
  ring
theorem AiG {n : ℕ} (hn : 1 < n) :
    (R7 n : ℝ) = 2 * Jk n / q + GJ n := by
  have hzero := uj hn
  have hfloor := A8a n
  simp only [GJ]
  linarith
theorem ZW {n : ℕ}
    (hn : Iv n) :
    (A9 n : ℝ) = 2 * Jk n / q + GJ n := by
  rw [A0P hn]
  exact AiG hn.1
theorem A1t : Continuous N4 := by
  unfold N4
  fun_prop
theorem AwD : BddAbove (N4 '' Set.Icc (0 : ℝ) 1) :=
  isCompact_Icc.bddAbove_image A1t.continuousOn
theorem AwE : BddBelow (N4 '' Set.Icc (0 : ℝ) 1) :=
  isCompact_Icc.bddBelow_image A1t.continuousOn
theorem wJ :
    ∃ M : ℝ, ∀ delta ∈ Set.Icc (0 : ℝ) 1, |N4 delta| ≤ M := by
  have hbounded : BddAbove ((fun delta : ℝ ↦ |N4 delta|) '' Set.Icc 0 1) :=
    isCompact_Icc.bddAbove_image A1t.abs.continuousOn
  obtain ⟨M, hM⟩ := bddAbove_def.mp hbounded
  refine ⟨M, ?_⟩
  intro delta hdelta
  exact hM _ (Set.mem_image_of_mem (fun x : ℝ ↦ |N4 x|) hdelta)
theorem CQ : Tendsto AH atTop atTop := by
  change Tendsto (fun n : ℕ ↦ Real.log (n : ℝ)) atTop atTop
