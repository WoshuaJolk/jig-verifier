private lemma ANP (n alpha : Nat) (A8 : 5 < alpha) (i j : Fin 4) :
    (LL alpha A8 i j *
        Gh n alpha A8 i j) ^ 2 *
        (((n + 1) ^ (DQ i j) : ℕ) : ENNReal)
      = ((Lm alpha A8 i * Lm alpha A8 j : ℕ) : ENNReal) *
          (KJ n alpha A8 i j * KJ n alpha A8 j i) := by
