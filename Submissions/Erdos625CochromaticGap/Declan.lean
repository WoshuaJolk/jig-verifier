namespace Erdos625
open scoped BigOperators ENNReal
noncomputable section
def Rh {V : Type*} :
    {ell : ℕ} → {v w : V} →
      FH V ell v w → List (V × V)
  | 0, _, _, _ => []
  | _ + 1, v, _, code =>
      (v, code.1) :: Rh code.2
@[simp]
theorem Aeo
    {V : Type*} {ell : ℕ} {v w : V}
    (code : FH V ell v w) :
    (Rh code).length = ell := by
  induction ell generalizing v with
  | zero => rfl
  | succ ell ih =>
      simp [Rh, ih code.2]
def F6.Joins {V : Type*} :
    V → List (V × V) → V → Prop
  | v, [], w => v = w
  | v, (x, y) :: edges, w => x = v ∧ Joins y edges w
namespace F6
@[simp]
theorem AvR {V : Type*} {v w : V} :
    Joins v [] w ↔ v = w := Iff.rfl
@[simp]
theorem AvQ {V : Type*} {v x y w : V}
    {edges : List (V × V)} :
    Joins v ((x, y) :: edges) w ↔ x = v ∧ Joins y edges w := Iff.rfl
theorem jh {V : Type*} {u v w : V}
    {left right : List (V × V)}
    (hleft : Joins u left v) (hright : Joins v right w) :
    Joins u (left ++ right) w := by
  induction left generalizing u with
  | nil =>
      simpa [Joins] using hleft ▸ hright
  | cons edge tail ih =>
      rcases edge with ⟨x, y⟩
      simp only [Joins] at hleft ⊢
      exact ⟨hleft.1, ih hleft.2⟩
end F6
theorem AEE
    {V : Type*} {ell : ℕ} {v w : V}
    (code : FH V ell v w) :
    F6.Joins v (Rh code) w := by
  induction ell generalizing v with
  | zero =>
      exact code.2.1.symm.trans code.2.2
  | succ ell ih =>
      exact ⟨rfl, ih code.2⟩
def YG {V : Type*} {L : ℕ} {v w : V}
    (code : NG V L v w) : List (V × V) :=
  Rh code.2
@[simp]
theorem AFh
    {V : Type*} {L : ℕ} {v w : V}
    (code : NG V L v w) :
    (YG code).length = code.length := by
  exact Aeo code.2
theorem AwI
    {V : Type*} {L : ℕ} {v w : V}
    (code : NG V L v w) :
    0 < (YG code).length := by
  simp [YG]
theorem AwH
    {V : Type*} {L : ℕ} {v w : V}
    (code : NG V L v w) :
    (YG code).length ≤ L := by
  rw [AFh]
  exact code.1.2
theorem Aij
    {V : Type*} {L : ℕ} {v w : V}
    (code : NG V L v w) :
    F6.Joins v (YG code) w :=
  AEE code.2
def Fj {V : Type*} {L : ℕ} :
    {r : ℕ} → {v w : V} →
      E9 V L r v w → List (V × V)
  | 0, _, _, _ => []
  | _ + 1, _, _, code =>
      YG code.2.1.2 ++
        Fj code.2.2
def GO {V : Type*} {L : ℕ} :
    {r : ℕ} → {v w : V} →
      E9 V L r v w → List (V × V)
  | 0, _, _, _ => []
  | _ + 1, _, _, code =>
      (code.2.1.1, code.1) :: GO code.2.2
def ML {V : Type*} {L : ℕ} :
    {r : ℕ} → {v w : V} →
      E9 V L r v w → List (V × V)
  | 0, _, _, _ => []
  | _ + 1, _, _, code =>
      YG code.2.1.2 ++
        (code.2.1.1, code.1) :: ML code.2.2
def YN {V : Type*} {L : ℕ} :
    {r : ℕ} → {v w : V} →
      E9 V L r v w → List ℕ
  | 0, _, _, _ => []
  | _ + 1, _, _, code =>
      code.2.1.2.length :: YN code.2.2
@[simp]
theorem AGR
    {V : Type*} {L r : ℕ} {v w : V}
    (code : E9 V L r v w) :
    (GO code).length = r := by
  induction r generalizing v with
  | zero => rfl
  | succ r ih =>
      simp [GO, ih code.2.2]
@[simp]
theorem Ax8
    {V : Type*} {L r : ℕ} {v w : V}
    (code : E9 V L r v w) :
    (YN code).length = r := by
  induction r generalizing v with
  | zero => rfl
  | succ r ih =>
      simp [YN, ih code.2.2]
theorem Akr
    {V : Type*} {L r : ℕ} {v w : V}
    (code : E9 V L r v w) :
    ∀ ell ∈ YN code, 0 < ell ∧ ell ≤ L := by
  induction r generalizing v with
  | zero => simp [YN]
  | succ r ih =>
      intro ell hell
      simp only [YN, List.mem_cons] at hell
      rcases hell with rfl | hell
      · exact ⟨by simp [NG.length], code.2.1.2.1.2⟩
      · exact ih code.2.2 ell hell
@[simp]
theorem Ax9
    {V : Type*} {L r : ℕ} {v w : V}
    (code : E9 V L r v w) :
    (Fj code).length =
      (YN code).sum := by
  induction r generalizing v with
  | zero => rfl
  | succ r ih =>
      simp [Fj, YN,
        ih code.2.2]
theorem AxA
    {V : Type*} {L r : ℕ} {v w : V}
    (code : E9 V L r v w) :
    r ≤ (Fj code).length := by
  induction r generalizing v with
  | zero => exact Nat.zero_le _
  | succ r ih =>
      simp only [Fj, List.length_append,
        AFh]
      calc
        r + 1 = 1 + r := Nat.add_comm _ _
        _ ≤ code.2.1.2.length +
              (Fj code.2.2).length :=
          Nat.add_le_add
            (by simp [NG.length])
            (ih code.2.2)
@[simp]
theorem Ax7
    {V : Type*} {L r : ℕ} {v w : V}
    (code : E9 V L r v w) :
    (ML code).length =
      (Fj code).length + r := by
  induction r generalizing v with
  | zero => rfl
  | succ r ih =>
      simp [ML, Fj,
        ih code.2.2, Nat.add_assoc, Nat.add_left_comm, Nat.add_comm]
theorem Akq
    {V : Type*} {L r : ℕ} {v w : V}
    (code : E9 V L r v w) :
    F6.Joins v (ML code) w := by
  induction r generalizing v with
  | zero =>
      exact AEE code
  | succ r ih =>
      apply F6.jh
        (Aij code.2.1.2)
      exact ⟨rfl, ih code.2.2⟩
theorem AGQ
    {V : Type*} {L r : ℕ} {v : V}
    (code : E9 V L r v v) :
    F6.Joins v (ML code) v :=
  Akq code
theorem AxB
    {V : Type*} {L r : ℕ} {v w : V}
    (code : E9 V L (r + 1) v w) :
    (GO code.2.2).length = r :=
  AGR code.2.2
def DS {A B : Type*} :
    (A ⊕ B) × (A ⊕ B) → Option (A × B)
  | (Sum.inl a, Sum.inr b) => some (a, b)
  | (Sum.inr b, Sum.inl a) => some (a, b)
  | _ => none
theorem A2T
    {α β : Type*} (f : α → Option β) (items : List α)
    (DU : ∀ item ∈ items, ∃ value, f item = some value) :
    (items.filterMap f).length = items.length := by
  induction items with
  | nil => rfl
  | cons item tail ih =>
      obtain ⟨value, hvalue⟩ := DU item (by simp)
      have htail : ∀ x ∈ tail, ∃ y, f x = some y := by
        intro x hx
        exact DU x (by simp [hx])
      simp [hvalue, ih htail]
def DB {A B : Type*} [DecidableEq A] [DecidableEq B]
    (edges : List ((A ⊕ B) × (A ⊕ B))) : Finset (A × B) :=
  (edges.filterMap DS).toFinset
theorem A9W
    {A B : Type*} [DecidableEq A] [DecidableEq B]
    (left right : List ((A ⊕ B) × (A ⊕ B))) :
    DB (left ++ right) =
      DB left ∪ DB right := by
  ext edge
  simp [DB]
def A9V {A B : Type*} [DecidableEq A] [DecidableEq B]
    (edge : (A ⊕ B) × (A ⊕ B)) : Finset (A × B) :=
  match DS edge with
  | some cell => {cell}
  | none => ∅
theorem A9X
    {A B : Type*} [DecidableEq A] [DecidableEq B]
    (edge : (A ⊕ B) × (A ⊕ B))
    (tail : List ((A ⊕ B) × (A ⊕ B))) :
    DB (edge :: tail) =
      A9V edge ∪ DB tail := by
  ext cell
  rcases edge with ⟨u, v⟩
  rcases u with a | b <;> rcases v with a' | b' <;>
    simp [DB, A9V, DS]
def Yq
    {A B : Type*} [DecidableEq A] [DecidableEq B]
    {L r : ℕ} {v w : A ⊕ B}
    (code : E9 (A ⊕ B) L r v w) :
    Finset (A × B) :=
  DB (Fj code)
def XO
    {A B : Type*} [DecidableEq A] [DecidableEq B]
    {L r : ℕ} {v w : A ⊕ B}
    (code : E9 (A ⊕ B) L r v w) :
    Finset (A × B) :=
  DB (GO code)
def Tj
    {A B : Type*} [DecidableEq A] [DecidableEq B]
    {L r : ℕ} {v w : A ⊕ B}
    (code : E9 (A ⊕ B) L r v w) :
    Finset (A × B) :=
  DB (ML code)
theorem AMf
    {A B : Type*} [DecidableEq A] [DecidableEq B]
    {L r : ℕ} {v w : A ⊕ B}
    (code : E9 (A ⊕ B) L r v w) :
    Tj code =
      Yq code ∪
        XO code := by
  induction r generalizing v with
  | zero =>
      simp [Tj, Yq,
        XO, ML,
        Fj, GO,
        DB]
  | succ r ih =>
      have htail :
          DB
              (ML code.2.2) =
            DB
                (Fj code.2.2) ∪
              DB
                (GO code.2.2) := by
        simpa only [Tj,
          Yq, XO] using
          ih code.2.2
      simp only [Tj, Yq,
        XO, ML,
        Fj, GO,
        A9W, A9X]
      rw [htail]
      ext cell
      simp only [Finset.mem_union]
      tauto
theorem Aks
    {V : Type*} {L r : ℕ} {v w : V}
    (code : E9 V L r v w) :
    List.Sublist (Fj code)
      (ML code) := by
  induction r generalizing v with
  | zero => exact List.Sublist.refl []
  | succ r ih =>
      simp only [Fj, ML]
      exact (List.Sublist.refl _).append
        (List.Sublist.cons _ (ih code.2.2))
theorem Akt
    {V : Type*} {L r : ℕ} {v w : V}
    (code : E9 V L r v w) :
    List.Sublist (GO code)
      (ML code) := by
  induction r generalizing v with
  | zero => exact List.Sublist.refl []
  | succ r ih =>
      simp only [GO, ML]
      exact (List.Sublist.cons_cons _ (ih code.2.2)).trans
        (List.sublist_append_right _ _)
theorem Aku
    {V : Type*} {L r : ℕ} {v w : V}
    (code : E9 V L r v w)
    (hnodup : (ML code).Nodup) :
    (Fj code).Nodup ∧
      (GO code).Nodup :=
  ⟨hnodup.sublist (Aks code),
    hnodup.sublist (Akt code)⟩
def O6 {V : Type*}
    (K : V → V → ℝ≥0∞) (edges : List (V × V)) : ℝ≥0∞ :=
  (edges.map fun edge => K edge.1 edge.2).prod
theorem AJN
    {A B : Type*} (q : A → B → ℝ≥0∞)
    {edge : (A ⊕ B) × (A ⊕ B)} {cell : A × B}
    (DU : DS edge = some cell) :
    EW q edge.1 edge.2 = q cell.1 cell.2 := by
  rcases edge with ⟨u, v⟩
  rcases u with a | b <;> rcases v with a' | b' <;>
    simp [DS, EW] at DU ⊢
  all_goals subst cell
  all_goals rfl
theorem Afm
    {A B : Type*} [DecidableEq A] [DecidableEq B]
    (M : Finset (A × B))
    {edge : (A ⊕ B) × (A ⊕ B)} {cell : A × B}
    (DU : DS edge = some cell) (hcell : cell ∈ M) :
    IG M edge.1 edge.2 = 1 := by
  rcases edge with ⟨u, v⟩
  rcases u with a | b <;> rcases v with a' | b' <;>
    simp [DS, IG] at DU ⊢
  all_goals subst cell
  all_goals simp [hcell]
theorem AFA
    {A B : Type*} (q : A → B → ℝ≥0∞)
    (edges : List ((A ⊕ B) × (A ⊕ B)))
    (DU : ∀ edge ∈ edges,
      ∃ cell, DS edge = some cell) :
    O6 (EW q) edges =
      ((edges.filterMap DS).map
        fun cell => q cell.1 cell.2).prod := by
  induction edges with
  | nil => rfl
  | cons edge tail ih =>
      obtain ⟨cell, hcell⟩ := DU edge (by simp)
      have htail : ∀ e ∈ tail,
          ∃ c, DS e = some c := by
        intro e he
        exact DU e (by simp [he])
      simp only [O6, List.map_cons, List.prod_cons]
      rw [AJN q hcell]
      have ADq := ih htail
      unfold O6 at ADq
      rw [ADq]
      simp [hcell]
theorem AhO
    {A B : Type*} [DecidableEq A] [DecidableEq B]
    (M : Finset (A × B))
    (edges : List ((A ⊕ B) × (A ⊕ B)))
    (DU : ∀ edge ∈ edges,
      ∃ cell, DS edge = some cell ∧ cell ∈ M) :
    O6 (IG M) edges = 1 := by
  induction edges with
  | nil => rfl
  | cons edge tail ih =>
      obtain ⟨cell, hcell, hmem⟩ := DU edge (by simp)
      have htail : ∀ e ∈ tail,
          ∃ c, DS e = some c ∧ c ∈ M := by
        intro e he
        exact DU e (by simp [he])
      simp only [O6, List.map_cons, List.prod_cons]
      rw [Afm
        M hcell hmem]
      simpa [O6] using ih htail
theorem AEC
    {V : Type*} (K : V → V → ℝ≥0∞)
    {ell : ℕ} {v w : V} (code : FH V ell v w) :
    code.weight K = O6 K (Rh code) := by
  induction ell generalizing v with
  | zero => rfl
  | succ ell ih =>
      simp [FH.weight, Rh,
        O6, ih code.2]
theorem Aii
    {V : Type*} (K : V → V → ℝ≥0∞)
    {L : ℕ} {v w : V} (code : NG V L v w) :
    code.weight K = O6 K (YG code) :=
  AEC K code.2
theorem AGP
    {V : Type*} (K P : V → V → ℝ≥0∞)
    {L r : ℕ} {v w : V}
    (code : E9 V L r v w) :
    code.weight K P =
      O6 K (Fj code) *
        O6 P (GO code) := by
  induction r generalizing v with
  | zero =>
      simp [Fj, GO,
        O6]
  | succ r ih =>
      rw [E9.A8K]
      rw [TW.Aq0]
      rw [Aii]
      rw [ih code.2.2]
      simp only [Fj, GO,
        O6, List.map_append, List.prod_append,
        List.map_cons, List.prod_cons]
      ac_rfl
theorem Ax6
    {A B : Type*} [DecidableEq A] [DecidableEq B]
    (q : A → B → ℝ≥0∞) (M : Finset (A × B))
    {L r : ℕ} {v w : A ⊕ B}
    (code : E9 (A ⊕ B) L r v w) :
    code.weight (EW q) (IG M) =
      O6 (EW q)
          (Fj code) *
        O6 (IG M)
          (GO code) :=
  AGP _ _ code
theorem AJW
    {A B : Type*} [Fintype A] [DecidableEq A] [DecidableEq B]
    (M : Finset (A × B)) (hM : DZ M) :
    M.card ≤ Fintype.card A := by
  calc
    M.card = (M.image Prod.fst).card := by
      symm
      rw [Finset.card_image_iff.mpr]
      intro x hx y hy hxy
      exact Prod.ext hxy (hM.1 x.1 x.2 y.2 hx (by simpa [hxy] using hy))
    _ ≤ (Finset.univ : Finset A).card :=
      Finset.card_le_card (Finset.subset_univ _)
    _ = Fintype.card A := Finset.card_univ
theorem AMc
    {A B : Type*} [Fintype A] [Fintype B]
    [DecidableEq A] [DecidableEq B]
    (C M : Finset (A × B)) (hM : DZ M) :
    (C ∩ M).card ≤ Fintype.card (A ⊕ B) := by
  calc
    (C ∩ M).card ≤ M.card :=
      Finset.card_le_card (Finset.inter_subset_right)
    _ ≤ Fintype.card A := AJW M hM
    _ ≤ Fintype.card (A ⊕ B) := by
      simp only [Fintype.card_sum]
      exact Nat.le_add_right _ _
abbrev Jt
    (A B : Type*) [Fintype A] [Fintype B] :=
  Σ r : {r : ℕ // 0 < r},
    Σ v : A ⊕ B,
      E9 (A ⊕ B)
        (Fintype.card (A ⊕ B)) r.1 v v
namespace Jt
def W0
    {A B : Type*} [Fintype A] [Fintype B]
    (code : Jt A B) : ℕ :=
  code.1.1
def start
    {A B : Type*} [Fintype A] [Fintype B]
    (code : Jt A B) : A ⊕ B :=
  code.2.1
def chain
    {A B : Type*} [Fintype A] [Fintype B]
    (code : Jt A B) :
    E9 (A ⊕ B)
      (Fintype.card (A ⊕ B)) code.W0 code.start code.start :=
  code.2.2
theorem A8j
    {A B : Type*} [Fintype A] [Fintype B]
    (code : Jt A B) :
    0 < code.W0 :=
  code.1.2
@[simp]
theorem A8E
    {A B : Type*} [Fintype A] [Fintype B]
    (code : Jt A B) :
    (GO code.chain).length = code.W0 :=
  AGR code.chain
theorem Aw9
    {A B : Type*} [Fintype A] [Fintype B]
    (code : Jt A B) :
    ∀ ell ∈ YN code.chain,
      0 < ell ∧ ell ≤ Fintype.card (A ⊕ B) :=
  Akr code.chain
theorem closed
    {A B : Type*} [Fintype A] [Fintype B]
    (code : Jt A B) :
    F6.Joins code.start
      (ML code.chain) code.start :=
  AGQ code.chain
end Jt
def rG
    {A B : Type*} : ((A × B) × Bool) → (A ⊕ B) × (A ⊕ B)
  | ((a, b), true) => (Sum.inr b, Sum.inl a)
  | ((a, b), false) => (Sum.inl a, Sum.inr b)
@[simp]
theorem Aw6
    {A B : Type*} (z : (A × B) × Bool) :
    (rG z).2 = J6 z := by
