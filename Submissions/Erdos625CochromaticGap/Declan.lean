def BX
    {A B : Type*}
    [Fintype A] [Fintype B] [DecidableEq B]
    {row : A → ℕ} {col : B → ℕ}
    (matching : BZ row col) (a : A) (b : B) : ℕ :=
  (Finset.univ.filter
    (fun stub : Fin (row a) ↦ (matching ⟨a, stub⟩).1 = b)).card
def O9
    {A B : Type*}
    [Fintype A] [Fintype B] [DecidableEq B]
    (demand : A → B → ℕ) (row : A → ℕ) (col : B → ℕ) :
    Set (BZ row col) :=
  {matching | ∀ a b, demand a b ≤ BX matching a b}
noncomputable def Yb
    {A B : Type*}
    [Fintype A] [Fintype B] [DecidableEq A] [DecidableEq B]
