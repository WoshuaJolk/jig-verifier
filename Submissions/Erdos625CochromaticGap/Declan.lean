      · simp [Lg]
      · simp [E4, Finset.prod_pow_eq_pow_sum]
private theorem AA7
    {ι : Type*} (s : Finset ι) (f : ι → ℕ)
    (hf : ∀ i ∈ s, f i ≠ 0) :
    (((∏ i ∈ s, f i) : ℕ) : ℝ≥0∞)⁻¹ =
      ∏ i ∈ s, ((f i : ℕ) : ℝ≥0∞)⁻¹ := by
