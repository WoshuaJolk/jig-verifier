section M116
namespace Erdos625
open scoped BigOperators ENNReal
noncomputable section
set_option autoImplicit false
def S6 (n m : Nat) : ENNReal :=
  (n : ENNReal) * (m : ENNReal) /
    (2 : ENNReal) ^ ((2 * m) / 3)
def j4 (a m : Nat) : Fin 1 → Finset (Fin (m + 1)) :=
  QE m (QZ a m)
theorem AqR
    (n a m d : Nat) :
    (∑ choice : KD (Fin 1) (Fin (m + 1))
        (j4 a m),
      JO (j4 a m)
        (VO n m d (QZ a m)) choice) =
      1 + ∑ q ∈ j4 a m 0,
        GI n m d q.1 := by
  rw [iO]
  simp [j4, VO]
theorem AEu
    (n m d e : Nat) (hhalf : 2 * e < m) :
    GI n m d e ≤ S6 n m ^ e := by
  let den : Nat := ∏ t ∈ Finset.Icc 1 e, (d + t : Nat)
  let exponent : Nat := e * m - e * (e + 1) / 2
  let budget : Nat := (2 * m) / 3
  have Qt : 0 < den := by
    dsimp [den]
    apply Finset.prod_pos
    intro t ht
    simp only [Finset.mem_Icc] at ht
    omega
  have pN : 1 ≤ den := Nat.one_le_iff_ne_zero.mpr Qt.ne'
  have pQ : (den : ENNReal) ≠ 0 := by
    exact_mod_cast Qt.ne'
  have pO : (den : ENNReal) ≠ ∞ := ENNReal.natCast_ne_top den
  have pD : Nat.choose m e ≤ m ^ e := Nat.choose_le_pow m e
  have hchoose : (Nat.choose m e : ENNReal) ≤ (m : ENNReal) ^ e := by
    exact_mod_cast pD
  have hdiv :
      ((n : ENNReal) ^ e * (Nat.choose m e : ENNReal)) /
          (den : ENNReal) ≤
        (n : ENNReal) ^ e * (Nat.choose m e : ENNReal) := by
    apply (ENNReal.div_le_iff_le_mul (Or.inl pQ) (Or.inl pO)).2
    exact le_mul_of_one_le_right bot_le (by exact_mod_cast pN)
  have Jb :
      ((n : ENNReal) ^ e * (Nat.choose m e : ENNReal)) /
          (den : ENNReal) ≤
        (n : ENNReal) ^ e * (m : ENNReal) ^ e :=
    hdiv.trans (mul_le_mul_right hchoose _)
  have p9 : e * budget ≤ exponent := by
    dsimp [budget, exponent]
    exact AaZ m e hhalf
  have qJ : 2 ^ (e * budget) ≤ 2 ^ exponent :=
    Nat.pow_le_pow_right (by decide) p9
  have hpow :
      (2 : ENNReal) ^ (e * budget) ≤ (2 : ENNReal) ^ exponent := by
    exact_mod_cast qJ
  have hinv :
      ((2 : ENNReal) ^ exponent)⁻¹ ≤
        ((2 : ENNReal) ^ (e * budget))⁻¹ := by
    rw [ENNReal.inv_le_inv]
    exact hpow
  calc
    GI n m d e =
        (((n : ENNReal) ^ e * (Nat.choose m e : ENNReal)) /
          (den : ENNReal)) * ((2 : ENNReal) ^ exponent)⁻¹ := by
      simp only [GI, den, exponent]
    _ ≤ ((n : ENNReal) ^ e * (m : ENNReal) ^ e) *
          ((2 : ENNReal) ^ (e * budget))⁻¹ :=
      mul_le_mul' Jb hinv
    _ = ((n : ENNReal) ^ e * (m : ENNReal) ^ e) *
          (((2 : ENNReal) ^ budget)⁻¹) ^ e := by
      have heb : e * budget = budget * e := Nat.mul_comm _ _
      rw [heb, pow_mul, ENNReal.inv_pow]
