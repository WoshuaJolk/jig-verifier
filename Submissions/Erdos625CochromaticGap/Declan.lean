theorem AMz
    (a : ℝ) (ha : 0 < a) :
    Differentiable ℝ (Ls a) :=
  fun lambda ↦ (ACq a lambda ha).differentiableAt
theorem AMF
    (a : ℝ) (ha : 0 < a) :
