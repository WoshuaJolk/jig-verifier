    FI (alpha + 1) ((alpha : ℝ) - target)
@[simp] theorem A0T
    (alpha : ℕ) (target : ℝ) :
    Dt alpha - DX alpha target =
      FI (alpha + 1) ((alpha : ℝ) - target) := by
  simp [DX]
theorem AMq
    (alpha : ℕ) (target : ℝ) :
    target ∈ Ioo (-1 : ℝ) ((alpha : ℝ) - 1) ↔
      (alpha : ℝ) - target ∈ Ioo (1 : ℝ) ((alpha + 1 : ℕ) : ℝ) := by
  norm_num [Set.mem_Ioo]
  constructor <;> rintro ⟨hleft, hright⟩ <;> constructor <;> linarith
theorem A0U
    {alpha : ℕ} (C9 : 0 < alpha) {target : ℝ}
    (htarget : target ∈ Ioo (-1 : ℝ) ((alpha : ℝ) - 1)) :
