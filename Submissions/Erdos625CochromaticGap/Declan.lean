          _ ≤ (4 : ℝ)⁻¹ ^ i * ((T.card : ℝ) + 1 / 3) - 1 / 3 := by
                linarith
      have ATJ : ∀ U : Finset V, U ⊆ T → cutoff ≤ U.card → Um H U := by
        intro U hUT hUcard
