section M225
namespace Erdos625
open Filter
open scoped Topology
noncomputable section
noncomputable def FI (b : ℕ) (target : ℝ) : ℝ :=
  if h : 2 ≤ b ∧ target ∈ Set.Ioo (1 : ℝ) (b : ℝ) then
    Classical.choose
      (AAR h.1 h.2).exists
  else 0
theorem Wr {b : ℕ} (hb : 2 ≤ b)
    {target : ℝ} (htarget : target ∈ Set.Ioo (1 : ℝ) (b : ℝ)) :
    Db b (FI b target) = target := by
  rw [FI, dif_pos ⟨hb, htarget⟩]
  exact Classical.choose_spec
    (AAR hb htarget).exists
theorem AOf {b : ℕ} (hb : 2 ≤ b)
    {target t : ℝ} (htarget : target ∈ Set.Ioo (1 : ℝ) (b : ℝ))
    (ht : Db b t = target) :
    t = FI b target :=
  AFt hb
    (ht.trans (Wr hb htarget).symm)
theorem AwT {b : ℕ} (hb : 2 ≤ b)
    {target t : ℝ} (htarget : target ∈ Set.Ioo (1 : ℝ) (b : ℝ)) :
    Db b t = target ↔ t = FI b target := by
  constructor
  · exact AOf hb htarget
  · rintro rfl
    exact Wr hb htarget
theorem Aov
    {A : Type*} {l : Filter A} {b : ℕ} (hb : 2 ≤ b)
    (target : A → ℝ) {target₀ : ℝ}
    (htarget : Tendsto target l (𝓝 target₀))
    (htarget₀ : target₀ ∈ Set.Ioo (1 : ℝ) (b : ℝ)) :
    Tendsto (fun a ↦ FI b (target a)) l
      (𝓝 (FI b target₀)) := by
  rw [tendsto_order]
  constructor
  · intro lower Qw
    have A3m : Db b lower < target₀ := by
      calc
        Db b lower <
            Db b (FI b target₀) :=
          kV hb Qw
        _ = target₀ := Wr hb htarget₀
    have Xh : ∀ᶠ a in l, Db b lower < target a :=
      (tendsto_const_nhds.eventually_lt htarget) A3m
    have d6 : ∀ᶠ a in l,
        target a ∈ Set.Ioo (1 : ℝ) (b : ℝ) :=
      htarget (isOpen_Ioo.mem_nhds htarget₀)
    filter_upwards [Xh, d6] with a ha hTa
    rw [← Wr hb hTa] at ha
    exact (kV hb).lt_iff_lt.mp ha
  · intro upper Qz
    have A3n : target₀ < Db b upper := by
      calc
        target₀ = Db b (FI b target₀) :=
          (Wr hb htarget₀).symm
        _ < Db b upper :=
          kV hb Qz
    have Xh : ∀ᶠ a in l, target a < Db b upper :=
      (htarget.eventually_lt tendsto_const_nhds) A3n
    have d6 : ∀ᶠ a in l,
        target a ∈ Set.Ioo (1 : ℝ) (b : ℝ) :=
      htarget (isOpen_Ioo.mem_nhds htarget₀)
    filter_upwards [Xh, d6] with a ha hTa
    rw [← Wr hb hTa] at ha
    exact (kV hb).lt_iff_lt.mp ha
theorem AME {b : ℕ} (hb : 2 ≤ b)
    {target : ℝ} (htarget : target ∈ Set.Ioo (1 : ℝ) (b : ℝ)) :
    ContinuousAt (FI b) target :=
  Aov hb id tendsto_id htarget
theorem ACv {b : ℕ} (hb : 2 ≤ b)
    {target : ℝ} (htarget : target ∈ Set.Ioo (1 : ℝ) (b : ℝ)) :
    HasDerivAt (FI b)
      (Vd b (FI b target))⁻¹ target := by
  have hbPos : 0 < b := lt_of_lt_of_le Nat.zero_lt_two hb
  have A3U : ∀ᶠ y in 𝓝 target,
      Db b (FI b y) = y := by
    filter_upwards [isOpen_Ioo.mem_nhds htarget] with y hy
    exact Wr hb hy
  exact (zC hbPos (FI b target)).of_local_left_inverse
    (AME hb htarget)
    (A7O hb (FI b target)).ne'
    A3U
theorem Ar8 {b : ℕ} (hb : 2 ≤ b)
    {target : ℝ} (htarget : target ∈ Set.Ioo (1 : ℝ) (b : ℝ)) :
    deriv (FI b) target =
      (Vd b (FI b target))⁻¹ :=
  (ACv hb htarget).deriv
def gW (b : ℕ) (target : ℝ) : ℝ :=
  Real.log (GK b (FI b target)) -
    FI b target * target
theorem ACt {b : ℕ} (hb : 2 ≤ b)
    {target : ℝ} (htarget : target ∈ Set.Ioo (1 : ℝ) (b : ℝ)) :
    HasDerivAt (gW b)
      (-FI b target) target := by
  have hbPos : 0 < b := lt_of_lt_of_le Nat.zero_lt_two hb
  have hTilt := ACv hb htarget
  have hLog :=
    (A4k hbPos
      (FI b target)).comp target hTilt
  have PI := hTilt.mul (hasDerivAt_id target)
  have hMean := Wr hb htarget
  have hSub := (hLog.sub PI).congr_of_eventuallyEq
    (Filter.Eventually.of_forall fun _ ↦ rfl)
  apply hSub.congr_deriv
  simp only [id_eq]
  rw [hMean]
  ring
theorem Ar7 {b : ℕ} (hb : 2 ≤ b)
    {target : ℝ} (htarget : target ∈ Set.Ioo (1 : ℝ) (b : ℝ)) :
    deriv (gW b) target =
      -FI b target :=
  (ACt hb htarget).deriv
def Rm (b : ℕ) (n parts : ℝ) : ℝ :=
  n * Real.log n - n + parts - parts * Real.log parts +
    parts * gW b (n / parts)
theorem A7N
    (b : ℕ) {n parts : ℝ} (C7 : parts ≠ 0) :
    Rm b n parts =
      Gz b n parts (FI b (n / parts)) := by
  unfold Rm gW Gz
  field_simp [C7]
  ring
theorem AwV
    {b : ℕ} (hb : 2 ≤ b) {n parts : ℝ} (C7 : 0 < parts)
    (htarget : n / parts ∈ Set.Ioo (1 : ℝ) (b : ℝ)) :
    IsGreatest
      (RA n ''
        {x : EK b |
          EK.QY x n parts})
      (Rm b n parts) := by
  have hbPos : 0 < b := lt_of_lt_of_le Nat.zero_lt_two hb
  have hMean := Wr hb htarget
  have hMass : parts *
      Db b (FI b (n / parts)) = n := by
    rw [hMean]
    field_simp [C7.ne']
  rw [A7N b C7.ne']
  exact AjV
    hbPos C7 hMass
theorem zD
    {b : ℕ} (hb : 2 ≤ b) {n parts : ℝ} (C7 : 0 < parts)
    (htarget : n / parts ∈ Set.Ioo (1 : ℝ) (b : ℝ)) :
    HasDerivAt (fun k ↦ Rm b n k)
      (Real.log (GK b
          (FI b (n / parts))) - Real.log parts) parts := by
  have Iz : HasDerivAt (fun k : ℝ ↦ n / k)
      (-n / parts ^ 2) parts := by
    change HasDerivAt ((fun _ : ℝ ↦ n) / id) (-n / parts ^ 2) parts
    apply ((hasDerivAt_const parts n).div
      (hasDerivAt_id parts) C7.ne').congr_deriv
    simp only [id_eq, zero_mul, mul_one, zero_sub]
  have P9 :=
    (ACt hb htarget).comp parts Iz
  have AUi := Real.hasDerivAt_log C7.ne'
  have AUR := (hasDerivAt_id parts).mul P9
  have hMain :=
    (((hasDerivAt_const parts (n * Real.log n - n)).add
      (hasDerivAt_id parts)).sub
        ((hasDerivAt_id parts).mul AUi)).add AUR
  have A3M : HasDerivAt
      (fun k ↦ Rm b n k)
      (0 + 1 - (1 * Real.log parts + parts * parts⁻¹) +
        (1 * gW b (n / parts) +
          parts *
            (-FI b (n / parts) * (-n / parts ^ 2)))) parts := by
    have h := hMain.congr_of_eventuallyEq
      (f₁ := fun k ↦ Rm b n k)
      (Filter.Eventually.of_forall fun k ↦ by
        unfold Rm
        rfl)
    simpa only [id_eq, Function.comp_apply] using h
  apply A3M.congr_deriv
  simp only [gW]
  field_simp [C7.ne']
  ring
theorem AMv
    {b : ℕ} (hb : 2 ≤ b) {n parts : ℝ} (C7 : 0 < parts)
    (htarget : n / parts ∈ Set.Ioo (1 : ℝ) (b : ℝ)) :
    deriv (fun k ↦ Rm b n k) parts =
      Real.log (GK b
        (FI b (n / parts))) - Real.log parts :=
  (zD hb C7 htarget).deriv
