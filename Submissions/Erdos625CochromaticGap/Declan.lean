  · exact hvw.ne rfl
  · rename_i x hx p
    specialize h v x w
    simp_all +decide
lemma AJU
    {A B : Type*} (M : A → B → Prop)
    (Ra : ∀ a b₁ b₂, M a b₁ → M a b₂ → b₁ = b₂)
    (WO : ∀ b a₁ a₂, M a₁ b → M a₂ b → a₁ = a₂) :
    (CX M).IsAcyclic := by
  convert Aec (CX M) _ using 1
  intro v w w' hv hw
  unfold CX at hv hw
  rw [SimpleGraph.fromRel_adj] at hv hw
  rcases v with (a | b) <;> rcases w with (c | d) <;>
    rcases w' with (e | f) <;> tauto
lemma AOH
    {V : Type*} [Fintype V] [DecidableEq V]
    (G : SimpleGraph V) [DecidableRel G.Adj]
    [∀ c : G.ConnectedComponent, Fintype c]
    [∀ c : G.ConnectedComponent, DecidableRel c.toSimpleGraph.Adj]
    [∀ c : G.ConnectedComponent, Fintype c.toSimpleGraph.edgeSet] :
    G.edgeFinset =
      Finset.biUnion (Finset.univ : Finset G.ConnectedComponent)
        (fun c => c.toSimpleGraph.edgeFinset.image
          (Sym2.map fun v : c => v.1)) := by
  ext e
  constructor
  · intro he
    rw [Finset.mem_biUnion]
    induction e using Sym2.inductionOn
    rename_i u v
    have huv : G.Adj u v := by
      simpa [SimpleGraph.mem_edgeFinset] using he
    let c : G.ConnectedComponent := G.connectedComponentMk u
    have hu : u ∈ c.supp := by
      simp [c]
    have hv : v ∈ c.supp := c.mem_supp_of_adj_mem_supp hu huv
    let eu : c := ⟨u, hu⟩
    let ev : c := ⟨v, hv⟩
    refine ⟨c, Finset.mem_univ c, ?_⟩
    rw [Finset.mem_image]
    refine ⟨s(eu, ev), ?_, rfl⟩
    simpa [ConnectedComponent.toSimpleGraph, eu, ev,
      SimpleGraph.mem_edgeFinset] using huv
  · intro he
    rw [Finset.mem_biUnion] at he
    obtain ⟨c, _hc, WS⟩ := he
    rw [Finset.mem_image] at WS
    obtain ⟨f, hf, rfl⟩ := WS
    induction f using Sym2.inductionOn
    rename_i u v
    have huv : c.toSimpleGraph.Adj u v := by
      simpa [SimpleGraph.mem_edgeFinset] using hf
    have huv' : G.Adj u.1 v.1 :=
      (c.toSimpleGraph_adj u.2 v.2).mp huv
    simpa [SimpleGraph.mem_edgeFinset] using huv'
lemma AIi
    {V : Type*} [Fintype V] [DecidableEq V]
    (G : SimpleGraph V) [DecidableRel G.Adj]
    (A2l : G.IsAcyclic) :
    G.edgeFinset.card + Fintype.card G.ConnectedComponent ≤ Fintype.card V := by
  letI : ∀ c : G.ConnectedComponent, Fintype c :=
    fun c ↦ Fintype.ofFinite c
  letI : ∀ c : G.ConnectedComponent, DecidableRel c.toSimpleGraph.Adj :=
    fun c ↦ Classical.decRel _
  letI : ∀ c : G.ConnectedComponent, Fintype c.toSimpleGraph.edgeSet :=
    fun c ↦ Fintype.ofFinite c.toSimpleGraph.edgeSet
  have ASi : ∀ c : G.ConnectedComponent,
      c.toSimpleGraph.edgeFinset.card ≤ Fintype.card c - 1 := by
    intro c
    have hTree : c.toSimpleGraph.IsTree := A2l.isTree_connectedComponent c
    have hCard := hTree.card_edgeFinset
    omega
  have RY : G.edgeFinset.card ≤
      ∑ c : G.ConnectedComponent, c.toSimpleGraph.edgeFinset.card := by
    rw [AOH G]
    exact Finset.card_biUnion_le.trans
      (Finset.sum_le_sum fun (c : G.ConnectedComponent) _ ↦
        (Finset.card_image_le :
          (c.toSimpleGraph.edgeFinset.image
            (Sym2.map fun v : c ↦ v.1)).card ≤
          c.toSimpleGraph.edgeFinset.card))
  have AXW :
      ∑ c : G.ConnectedComponent, Fintype.card c = Fintype.card V := by
    let AM0 : V ≃ (Σ c : G.ConnectedComponent, c) :=
      (Equiv.sigmaFiberEquiv G.connectedComponentMk).symm
    calc
      ∑ c : G.ConnectedComponent, Fintype.card c =
          Fintype.card (Σ c : G.ConnectedComponent, c) :=
        Fintype.card_sigma.symm
      _ = Fintype.card V := (Fintype.card_congr AM0).symm
  calc
    G.edgeFinset.card + Fintype.card G.ConnectedComponent ≤
        (∑ c : G.ConnectedComponent,
          c.toSimpleGraph.edgeFinset.card) +
          Fintype.card G.ConnectedComponent := Nat.add_le_add_right RY _
    _ ≤ (∑ c : G.ConnectedComponent, (Fintype.card c - 1)) +
          Fintype.card G.ConnectedComponent := by
      gcongr with c
      exact ASi c
    _ = ∑ c : G.ConnectedComponent, Fintype.card c := by
      have hPos : ∀ c : G.ConnectedComponent, 0 < Fintype.card c := by
        intro c
        exact Fintype.card_pos_iff.mpr ⟨c.out, c.out_eq⟩
      calc
        (∑ c : G.ConnectedComponent, (Fintype.card c - 1)) +
              Fintype.card G.ConnectedComponent =
            (∑ c : G.ConnectedComponent, (Fintype.card c - 1)) +
              ∑ _c : G.ConnectedComponent, 1 := by simp
        _ = ∑ c : G.ConnectedComponent, ((Fintype.card c - 1) + 1) := by
          rw [Finset.sum_add_distrib]
        _ = ∑ c : G.ConnectedComponent, Fintype.card c := by
          apply Finset.sum_congr rfl
          intro c _
          exact Nat.sub_add_cancel (Nat.one_le_iff_ne_zero.mpr
            (Nat.ne_of_gt (hPos c)))
    _ = Fintype.card V := AXW
lemma vE {A B : Type*} (M R : A → B → Prop) :
    CX (fun a b ↦ M a b ∨ R a b) =
      CX M ⊔ CX R := by
  ext u v
  simp [SimpleGraph.sup_adj]
  cases u <;> cases v <;> simp [CX]
lemma AJT
    {A B : Type*} [Fintype A] [Fintype B]
    (R : A → B → Prop) [DecidableRel (CX R).Adj] :
    (CX R).edgeFinset.card ≤ (Rr R).card := by
  classical
  let encode : A × B → Sym2 (A ⊕ B) :=
    fun p ↦ s(Sum.inl p.1, Sum.inr p.2)
  have WS : (CX R).edgeFinset =
      (Rr R).image encode := by
    ext e
    induction e using Sym2.inductionOn
    rename_i u v
    rcases u with (a | b) <;> rcases v with (c | d) <;>
      simp [SimpleGraph.mem_edgeFinset, Rr, encode, CX,
        SimpleGraph.fromRel_adj, or_comm]
  rw [WS]
  exact Finset.card_image_le
lemma AOL
    {A B : Type*} [Fintype A] [Fintype B]
    (M R : A → B → Prop)
    [DecidableRel (CX (fun a b ↦ M a b ∨ R a b)).Adj]
    [DecidableRel (CX M).Adj] :
    (CX (fun a b ↦ M a b ∨ R a b)).edgeFinset.card -
        (CX M).edgeFinset.card ≤
      (Rr R).card := by
  classical
  letI : DecidableRel (CX R).Adj := Classical.decRel _
  have hUnion :
      (CX (fun a b ↦ M a b ∨ R a b)).edgeFinset ⊆
        (CX M).edgeFinset ∪ (CX R).edgeFinset := by
    intro e he
    simpa [SimpleGraph.mem_edgeFinset, vE,
      SimpleGraph.sup_adj] using he
  have hCard :
      (CX (fun a b ↦ M a b ∨ R a b)).edgeFinset.card ≤
        (CX M).edgeFinset.card +
          (CX R).edgeFinset.card := by
    exact (Finset.card_le_card hUnion).trans
      ((Finset.card_union_le _ _).trans_eq rfl)
  have jR := AJT R
  rw [Nat.sub_le_iff_le_add]
  calc
    (CX (fun a b ↦ M a b ∨ R a b)).edgeFinset.card ≤
        (CX M).edgeFinset.card +
          (CX R).edgeFinset.card := hCard
    _ ≤ (CX M).edgeFinset.card + (Rr R).card :=
      Nat.add_le_add_left jR _
    _ = (Rr R).card + (CX M).edgeFinset.card :=
      Nat.add_comm _ _
theorem AMa
    {A B : Type*} [Fintype A] [Fintype B]
    (M R : A → B → Prop)
    (Ra : ∀ a b₁ b₂, M a b₁ → M a b₂ → b₁ = b₂)
    (WO : ∀ b a₁ a₂, M a₁ b → M a₂ b → a₁ = a₂) :
    IQ (CX fun a b ↦ M a b ∨ R a b) ≤
      (Rr R).card := by
  classical
  have AC4 :
      (CX (fun a b ↦ M a b ∨ R a b)).edgeFinset.card -
          (CX M).edgeFinset.card ≤
      (Rr R).card := by
    exact AOL M R
  have ATr :
      (CX M).edgeFinset.card +
          Nat.card (CX M).ConnectedComponent ≤
        Nat.card (A ⊕ B) := by
    simpa only [← Nat.card_eq_fintype_card] using
      AIi (CX M)
        (AJU M Ra WO)
  have ASj :
      Nat.card
          (CX (fun a b ↦ M a b ∨ R a b)).ConnectedComponent ≤
        Nat.card (CX M).ConnectedComponent := by
    apply SimpleGraph.ConnectedComponent.card_le_card_of_le
    rw [vE]
    exact le_sup_left
  unfold IQ
  simp only [← Nat.card_eq_fintype_card]
  rw [Nat.sub_le_iff_le_add] at AC4 ⊢
  calc
    (CX (fun a b ↦ M a b ∨ R a b)).edgeFinset.card +
          Nat.card
            (CX (fun a b ↦ M a b ∨ R a b)).ConnectedComponent ≤
        ((Rr R).card + (CX M).edgeFinset.card) +
          Nat.card
            (CX (fun a b ↦ M a b ∨ R a b)).ConnectedComponent :=
      Nat.add_le_add_right AC4 _
    _ ≤ ((Rr R).card + (CX M).edgeFinset.card) +
          Nat.card (CX M).ConnectedComponent :=
      Nat.add_le_add_left ASj _
    _ = (Rr R).card +
          ((CX M).edgeFinset.card +
            Nat.card (CX M).ConnectedComponent) := by
      omega
    _ ≤ (Rr R).card + Nat.card (A ⊕ B) :=
      Nat.add_le_add_left ATr _
end Erdos625
end M098

section M099
namespace Erdos625
open scoped BigOperators
noncomputable section
theorem AlH
    (demand residual : ℕ)
    (qE : demand ≠ 0 → residual = 0) :
    JX (demand + residual) =
      C8 demand * JX residual := by
  by_cases V8 : demand = 0
  · subst demand
    simp [C8, JX]
  · rw [qE V8]
    simp [A0e, C8]
theorem Aiv
    {A B : Type*}
    [Fintype A] [Fintype B] [DecidableEq A] [DecidableEq B]
    (demand residual : A → B → ℕ)
    (qE : ∀ a b, demand a b ≠ 0 → residual a b = 0) :
    (∏ a : A, ∏ b : B,
        JX (demand a b + residual a b)) =
      (∏ e ∈ Bn demand,
        C8 (demand e.1 e.2)) *
        (∏ a : A, ∏ b : B, JX (residual a b)) := by
  classical
  have hsupport :
      (∏ e ∈ Bn demand,
          C8 (demand e.1 e.2)) =
        ∏ a : A, ∏ b : B, C8 (demand a b) := by
    rw [← Fintype.prod_ite_mem]
    calc
      (∏ e : A × B,
          if e ∈ Bn demand then
            C8 (demand e.1 e.2) else 1) =
          ∏ e : A × B, C8 (demand e.1 e.2) := by
            apply Fintype.prod_congr
            intro e
            by_cases he : demand e.1 e.2 = 0
            · simp [Bn, he, C8]
            · simp [Bn, he]
      _ = ∏ a : A, ∏ b : B, C8 (demand a b) :=
        Fintype.prod_prod_type'
          (fun a : A ↦ fun b : B ↦ C8 (demand a b))
  simp_rw [AlH _ _ (qE _ _)]
  simp_rw [Finset.prod_mul_distrib]
  rw [hsupport]
theorem ApP
    (demand residual : ℕ)
    (K4 : demand ≠ 0 → 2 ≤ demand) :
    2 ≤ demand + residual ↔ demand ≠ 0 ∨ 2 ≤ residual := by
  by_cases V8 : demand = 0
  · simp [V8]
  · have htwo := K4 V8
    omega
theorem AJV
    {A B : Type*}
    [Fintype A] [Fintype B] [DecidableEq A] [DecidableEq B]
    (demand residual : A → B → ℕ)
    (K4 : ∀ a b, demand a b ≠ 0 → 2 ≤ demand a b) :
    CX (fun a b ↦ 2 ≤ demand a b + residual a b) =
      CX
          (fun a b ↦ (a, b) ∈ Bn demand) ⊔
        CX (fun a b ↦ 2 ≤ residual a b) := by
  rw [← vE]
  apply congrArg CX
  funext a b
  apply propext
  simpa only [Bn, Finset.mem_filter, Finset.mem_univ,
    true_and] using
      ApP
        (demand a b) (residual a b) (K4 a b)
theorem AQq
    {A B : Type*}
    [Fintype A] [Fintype B] [DecidableEq A] [DecidableEq B]
    {row : A → ℕ} {col : B → ℕ} (U : ℕ)
    (hU : 2 ≤ U)
    (demand : Dv row col U)
    (witness : BW demand.1 row col)
    (extension : Lz witness)
    (I8 : extension ∈ U3 witness U) :
    let residual := LI witness extension
    ((∏ a : A, ∏ b : B,
          JX (BX extension.1 a b)) =
        (∏ e ∈ Bn demand.1,
          C8 (demand.1 e.1 e.2)) *
          (∏ a : A, ∏ b : B,
            JX (BX residual a b))) ∧
      (CX
          (fun a b ↦ 2 ≤ BX extension.1 a b) =
        CX
            (fun a b ↦ (a, b) ∈ Bn demand.1) ⊔
          CX
            (fun a b ↦ 2 ≤ BX residual a b)) := by
  dsimp only
  let residual := LI witness extension
  have hhigh : ∀ a b, demand.1 a b ≠ 0 → U / 2 < demand.1 a b :=
    Yl row col U demand
  have Nb : residual ∈ Dw witness U := by
    exact (A0G
      witness U hhigh extension).mp I8
  have qE : ∀ a b, demand.1 a b ≠ 0 →
      BX residual a b = 0 := by
    intro a b hab
    exact (Nb a b).2 hab
  have K4 : ∀ a b, demand.1 a b ≠ 0 → 2 ≤ demand.1 a b := by
    intro a b hab
    have AtU := hhigh a b hab
    omega
  have hcell : ∀ a b,
      BX extension.1 a b =
        demand.1 a b + BX residual a b := by
    intro a b
    exact j8
      witness extension a b
  constructor
  · simp_rw [hcell]
    exact Aiv
      demand.1 (BX residual) qE
  · simp_rw [hcell]
    exact AJV
      demand.1 (BX residual) K4
end
end Erdos625
end M099

section M100
namespace Erdos625
open scoped BigOperators
open Matrix Module SimpleGraph
noncomputable section
def SJ
    {V : Type*} [Fintype V] [DecidableEq V]
    (G : SimpleGraph V) [DecidableRel G.Adj] :
    Matrix V G.edgeSet (ZMod 2) :=
  fun v e => if v ∈ (e.1 : Sym2 V) then 1 else 0
lemma AIL (a b : ZMod 2) : a + b = 0 ↔ a = b := by
  have hself (x : ZMod 2) : x + x = 0 := by
    have htwo : (2 : ZMod 2) = 0 := ZMod.natCast_self 2
    rw [← two_mul, htwo, zero_mul]
  constructor
  · intro h
    apply add_right_cancel (b := b)
    exact h.trans (hself b).symm
  · intro h
    subst a
    exact hself _
lemma ABa
    {V : Type*} [Fintype V] [DecidableEq V]
    (G : SimpleGraph V) [DecidableRel G.Adj]
    (x : V → ZMod 2) {u v : V} (huv : G.Adj u v) :
    ((SJ G)ᵀ *ᵥ x)
        ⟨s(u, v), G.mem_edgeSet.mpr huv⟩ = x u + x v := by
  simp only [SJ, Matrix.mulVec, dotProduct,
    Matrix.transpose_apply, ite_mul, one_mul, zero_mul, Sym2.mem_iff]
  have hsplit (w : V) :
      (if w = u ∨ w = v then x w else 0) =
        (if w = u then x u else 0) + (if w = v then x v else 0) := by
    by_cases hwu : w = u
    · subst w
      simp [huv.ne]
    · by_cases hwv : w = v
      · subst w
        simp [hwu]
      · simp [hwu, hwv]
  calc
    (∑ w, if w = u ∨ w = v then x w else 0) =
        ∑ w, ((if w = u then x u else 0) +
          (if w = v then x v else 0)) := by
      exact Finset.sum_congr rfl fun w _ => hsplit w
    _ = (∑ w, if w = u then x u else 0) +
        ∑ w, if w = v then x v else 0 := Finset.sum_add_distrib
    _ = x u + x v := by simp
lemma Arz
    {α : Type*} (F : Finset α) (S : Set α) (h : (F : Set α) = S) :
    F.card = Nat.card S := by
  rw [← Nat.card_eq_finsetCard]
  exact Nat.card_congr (Equiv.setCongr h)
lemma ARm
    {V : Type*} [Fintype V] [DecidableEq V]
    (G : SimpleGraph V) [DecidableRel G.Adj] (x : V → ZMod 2) :
    (SJ G)ᵀ *ᵥ x = 0 ↔
      ∀ u v : V, G.Adj u v → x u = x v := by
  constructor
  · intro hx u v huv
    have h := congrFun hx ⟨s(u, v), G.mem_edgeSet.mpr huv⟩
    rw [ABa G x huv] at h
    exact (AIL _ _).mp h
  · intro hx
    funext e
    rcases e with ⟨e, he⟩
    induction e using Sym2.inductionOn with
    | _ u v =>
      have huv : G.Adj u v := G.mem_edgeSet.mp he
      rw [ABa G x huv]
      exact (AIL _ _).mpr (hx u v huv)
lemma ABb
    {V : Type*} [Fintype V] [DecidableEq V]
    (G : SimpleGraph V) [DecidableRel G.Adj] (x : V → ZMod 2) :
    (SJ G)ᵀ *ᵥ x = 0 ↔
      ∀ u v : V, G.Reachable u v → x u = x v := by
  rw [ARm]
  refine ⟨?_, fun h u v huv => h u v huv.reachable⟩
  intro h u v ⟨w⟩
  induction w with
  | nil => rfl
  | cons huv _ ih => exact (h _ _ huv).trans ih
def qw
    {V : Type*} [Fintype V] [DecidableEq V]
    (G : SimpleGraph V) [DecidableRel G.Adj]
    [DecidableEq G.ConnectedComponent]
    (c : G.ConnectedComponent) :
    LinearMap.ker (SJ G)ᵀ.mulVecLin := by
  refine ⟨fun v => if G.connectedComponentMk v = c then 1 else 0, ?_⟩
  rw [LinearMap.mem_ker, Matrix.mulVecLin_apply,
    ABb]
  intro u v huv
  rw [ConnectedComponent.sound huv]
lemma AeO
    {V : Type*} [Fintype V] [DecidableEq V]
    (G : SimpleGraph V) [DecidableRel G.Adj]
    [DecidableEq G.ConnectedComponent] :
    LinearIndependent (ZMod 2) (qw G) := by
  rw [Fintype.linearIndependent_iff]
  intro coefficients hzero
  rw [Subtype.ext_iff] at hzero
  have hsum :
      ∑ c, coefficients c • qw G c =
        fun v => coefficients (G.connectedComponentMk v) := by
    simp only [qw, SetLike.mk_smul_mk]
    repeat rw [AddSubmonoid.coe_finsetSum]
    ext v
    simp only [Finset.sum_apply, Pi.smul_apply, smul_eq_mul, mul_ite,
      mul_one, mul_zero, Finset.sum_ite_eq, Finset.mem_univ, ↓reduceIte]
  rw [hsum] at hzero
  intro c
  obtain ⟨v, hv⟩ : ∃ v : V, G.connectedComponentMk v = c := Quot.exists_rep c
  exact hv ▸ congrFun hzero v
lemma AeP
    {V : Type*} [Fintype V] [DecidableEq V]
    (G : SimpleGraph V) [DecidableRel G.Adj]
    [DecidableEq G.ConnectedComponent] :
    ⊤ ≤ Submodule.span (ZMod 2)
      (Set.range (qw G)) := by
  intro x _
  rw [Submodule.mem_span_range_iff_exists_fun]
  use Quot.lift x.val (by
    rw [← ABb G,
      ← Matrix.mulVecLin_apply, LinearMap.map_coe_ker])
  ext v
  simp only [qw]
  rw [AddSubmonoid.coe_finsetSum]
  simp only [SetLike.mk_smul_mk, Finset.sum_apply, Pi.smul_apply,
    smul_eq_mul, mul_ite, mul_one, mul_zero, Finset.sum_ite_eq,
    Finset.mem_univ, ↓reduceIte]
  rfl
def AeN
    {V : Type*} [Fintype V] [DecidableEq V]
    (G : SimpleGraph V) [DecidableRel G.Adj]
    [DecidableEq G.ConnectedComponent] :
    Basis G.ConnectedComponent (ZMod 2)
      (LinearMap.ker (SJ G)ᵀ.mulVecLin) :=
  Basis.mk (AeO G)
    (AeP G)
lemma A2Z
    {V : Type*} [Fintype V] [DecidableEq V]
    (G : SimpleGraph V) [DecidableRel G.Adj] :
    Module.finrank (ZMod 2)
        (LinearMap.ker (SJ G)ᵀ.mulVecLin) =
      Fintype.card G.ConnectedComponent := by
  classical
  rw [Module.finrank_eq_card_basis (AeN G)]
abbrev Z8
    {V : Type*} [Fintype V] [DecidableEq V]
    (G : SimpleGraph V) [DecidableRel G.Adj] :=
  LinearMap.ker (SJ G).mulVecLin
theorem AAr
    {V : Type*} [Fintype V] [DecidableEq V]
    (G : SimpleGraph V) [DecidableRel G.Adj] :
    Module.finrank (ZMod 2) (Z8 G) = IQ G := by
  classical
  let A := SJ G
  have z7 :
      A.rank + Fintype.card G.ConnectedComponent = Fintype.card V := by
    calc
      A.rank + Fintype.card G.ConnectedComponent =
          Aᵀ.rank + Module.finrank (ZMod 2) (LinearMap.ker Aᵀ.mulVecLin) := by
        rw [Matrix.rank_transpose, A2Z G]
      _ = Module.finrank (ZMod 2) (LinearMap.range Aᵀ.mulVecLin) +
          Module.finrank (ZMod 2) (LinearMap.ker Aᵀ.mulVecLin) := rfl
      _ = Module.finrank (ZMod 2) (V → ZMod 2) :=
        LinearMap.finrank_range_add_finrank_ker Aᵀ.mulVecLin
      _ = Fintype.card V := by simp
  have A3v :
      A.rank + Module.finrank (ZMod 2) (LinearMap.ker A.mulVecLin) =
        Fintype.card G.edgeSet := by
    calc
      A.rank + Module.finrank (ZMod 2) (LinearMap.ker A.mulVecLin) =
          Module.finrank (ZMod 2) (LinearMap.range A.mulVecLin) +
            Module.finrank (ZMod 2) (LinearMap.ker A.mulVecLin) := rfl
      _ = Module.finrank (ZMod 2) (G.edgeSet → ZMod 2) :=
        LinearMap.finrank_range_add_finrank_ker A.mulVecLin
      _ = Fintype.card G.edgeSet := by simp
  have AtA :
      A.rank + Nat.card G.ConnectedComponent = Nat.card V := by
    simpa only [Nat.card_eq_fintype_card] using z7
  have Asp :
      A.rank + Module.finrank (ZMod 2) (LinearMap.ker A.mulVecLin) =
        Nat.card G.edgeSet := by
    simpa only [Nat.card_eq_fintype_card] using A3v
  have A3D :
      Module.finrank (ZMod 2) (Z8 G) =
        Nat.card G.edgeSet + Nat.card G.ConnectedComponent - Nat.card V := by
    change Module.finrank (ZMod 2) (LinearMap.ker A.mulVecLin) = _
    omega
  have AT3 :
      IQ G =
        Nat.card G.edgeSet + Nat.card G.ConnectedComponent - Nat.card V := by
    letI : DecidableEq V := Classical.decEq V
    letI : DecidableRel G.Adj := Classical.decRel _
    unfold IQ
    rw [G.edgeFinset_card]
    simp only [← Nat.card_eq_fintype_card]
  exact A3D.trans AT3.symm
theorem AgZ
    {V : Type*} [Fintype V] [DecidableEq V]
    (G : SimpleGraph V) [DecidableRel G.Adj] :
    Nat.card (Z8 G) = 2 ^ IQ G := by
  calc
    Nat.card (Z8 G) =
        Nat.card (ZMod 2) ^ Module.finrank (ZMod 2) (Z8 G) :=
      Module.natCard_eq_pow_finrank
    _ = 2 ^ IQ G := by
      rw [Nat.card_eq_fintype_card, ZMod.card,
        AAr]
def Uv
    {V : Type*} [Fintype V] [DecidableEq V]
    {G : SimpleGraph V} [DecidableRel G.Adj]
    (F : Finset G.edgeSet) (v : V) : Finset G.edgeSet :=
  Finset.univ.filter fun e => e ∈ F ∧ v ∈ (e.1 : Sym2 V)
def A19
    {V : Type*} [Fintype V] [DecidableEq V]
    (G : SimpleGraph V) [DecidableRel G.Adj] :=
  {F : Finset G.edgeSet //
    ∀ v, Even (Uv F v).card}
def Xd
    {V : Type*} [Fintype V] [DecidableEq V]
    {G : SimpleGraph V} [DecidableRel G.Adj]
    (F : Finset G.edgeSet) : G.edgeSet → ZMod 2 :=
  fun e => if e ∈ F then 1 else 0
lemma ABZ
    {V : Type*} [Fintype V] [DecidableEq V]
    (G : SimpleGraph V) [DecidableRel G.Adj]
    (F : Finset G.edgeSet) (v : V) :
    (SJ G *ᵥ Xd F) v =
      ((Uv F v).card : ZMod 2) := by
  simp only [SJ, Xd,
    Uv, Matrix.mulVec, dotProduct, ite_mul,
    one_mul, zero_mul]
  change (∑ e, if v ∈ (e.1 : Sym2 V) then
      (if e ∈ F then (1 : ZMod 2) else 0) else 0) =
    ((Finset.univ.filter fun e => e ∈ F ∧ v ∈ (e.1 : Sym2 V)).card : ZMod 2)
  rw [← Finset.sum_filter]
  rw [Finset.sum_boole]
  have hfilter :
      ((Finset.univ.filter fun e : G.edgeSet => v ∈ (e.1 : Sym2 V)).filter
          fun e => e ∈ F) =
        Finset.univ.filter fun e => e ∈ F ∧ v ∈ (e.1 : Sym2 V) := by
    ext e
    simp [and_comm]
  rw [hfilter]
lemma ABY
    {V : Type*} [Fintype V] [DecidableEq V]
    (G : SimpleGraph V) [DecidableRel G.Adj]
    (F : Finset G.edgeSet) :
    Xd F ∈ Z8 G ↔
      ∀ v, Even (Uv F v).card := by
  rw [LinearMap.mem_ker, Matrix.mulVecLin_apply]
  constructor
  · intro h v
    apply ZMod.natCast_eq_zero_iff_even.mp
    rw [← ABZ G F v]
    exact congrFun h v
  · intro h
    funext v
    rw [ABZ]
    exact ZMod.natCast_eq_zero_iff_even.mpr (h v)
lemma Aq6 (x : ZMod 2) (hx : x ≠ 0) : x = 1 := by
  have hlt : x.val < 2 := ZMod.val_lt x
  have hval : x.val = 0 ∨ x.val = 1 := by omega
  rcases hval with hzero | hone
  · exfalso
    apply hx
    rw [← ZMod.natCast_zmod_val x, hzero]
    norm_num
  · rw [← ZMod.natCast_zmod_val x, hone]
    norm_num
def jL
    {V : Type*} [Fintype V] [DecidableEq V]
    {G : SimpleGraph V} [DecidableRel G.Adj]
    (x : G.edgeSet → ZMod 2) : Finset G.edgeSet :=
  Finset.univ.filter fun e => x e ≠ 0
@[simp] lemma ARl
    {V : Type*} [Fintype V] [DecidableEq V]
    {G : SimpleGraph V} [DecidableRel G.Adj]
    (F : Finset G.edgeSet) :
    jL (Xd F) = F := by
  ext e
  simp [jL, Xd]
lemma ABX
    {V : Type*} [Fintype V] [DecidableEq V]
    {G : SimpleGraph V} [DecidableRel G.Adj]
    (x : G.edgeSet → ZMod 2) :
    Xd (jL x) = x := by
  funext e
  by_cases he : x e = 0
  · simp [Xd, jL, he]
  · have heOne : x e = 1 := Aq6 (x e) he
    simp [Xd, jL, heOne]
def AOi
    {V : Type*} [Fintype V] [DecidableEq V]
    (G : SimpleGraph V) [DecidableRel G.Adj] :
    A19 G ≃ Z8 G where
  toFun F :=
    ⟨Xd F.1,
      (ABY G F.1).mpr F.2⟩
  invFun x := by
    refine ⟨jL x.1, ?_⟩
    apply (ABY G _).mp
    rw [ABX]
    exact x.2
  left_inv F := by
    apply Subtype.ext
    exact ARl F.1
  right_inv x := by
    apply Subtype.ext
    exact ABX x.1
theorem AgY
    {V : Type*} [Fintype V] [DecidableEq V]
    (G : SimpleGraph V) [DecidableRel G.Adj] :
    Nat.card (A19 G) = 2 ^ IQ G := by
  rw [Nat.card_congr (AOi G),
    AgZ]
end
