    _ = (C \ M).prod (fun cell => q cell.1 cell.2) := by
      rw [hcut.A0Z]
theorem ApG
    {A B : Type*} [Fintype A] [Fintype B]
    [DecidableEq A] [DecidableEq B]
    {C M : Finset (A × B)} {code : Jt A B}
    (hcut : QX C M code) :
    O6 (IG M)
      (GO code.chain) = 1 := by
  apply AhO M
  intro edge hedge
  obtain ⟨cell, DU⟩ := hcut.A8D edge hedge
  refine ⟨cell, DU, ?_⟩
  have hcell : cell ∈ XO code.chain := by
    simp only [XO, DB,
      List.mem_toFinset]
    exact List.mem_filterMap.mpr ⟨edge, hedge, DU⟩
  rw [hcut.A14] at hcell
