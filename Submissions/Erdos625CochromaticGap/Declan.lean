  have hsqrt : 0 < Real.sqrt (n : ℝ) := Real.sqrt_pos.mpr hnpos
  obtain ⟨s, hs⟩ : ∃ s : ℝ, s = AH n ^ (5 / 2 : ℝ) / Real.sqrt n := ⟨_, rfl⟩
  have AaT : (1 : ℝ) + (32 * Real.exp 5 + 3) * AH n ^ (5 / 2 : ℝ) / Real.sqrt n
      = 1 + (32 * Real.exp 5 + 3) * s := by rw [hs]; ring
  rw [AaT]
  have hspos : 0 < s := by
    rw [hs]
    exact div_pos (Real.rpow_pos_of_pos hLpos _) hsqrt
  have hs1 : s ≤ 1 := by
    have hid : AH n ^ (5 / 2 : ℝ) = Real.sqrt (AH n ^ 5) := by
      rw [Real.sqrt_eq_rpow, ← Real.rpow_natCast (AH n) 5, ← Real.rpow_mul hLpos.le]
      norm_num
    rw [hs, hid, div_le_one hsqrt]
    exact Real.sqrt_le_sqrt hLn
  have je : 7 ≤ A9 n := by
    have h7 : (7 : ℝ) ≤ (A9 n : ℝ) :=
      le_trans (le_trans AOA hL4) Br.1
    exact_mod_cast h7
  have AYo : ∀ i j : Fin 4,
      Iq n
        (BL (A9 n) A8 i j) ≠ ⊤ := by
    intro i j
    rw [Iq]
    exact ENNReal.div_ne_top
      (ENNReal.mul_ne_top (ENNReal.natCast_ne_top n) (ENNReal.natCast_ne_top _))
      (pow_ne_zero _ (by norm_num : (2 : ENNReal) ≠ 0))
  have hfac : ∀ i j : Fin 4,
      Gh n (A9 n) A8 i j ≤
        ENNReal.ofReal (1 + 8 * Real.exp 5 * s) := by
    intro i j
    have hb := ANw n hdom A8 je hLpos Br.2 i j
    have hnn : (0 : ℝ) ≤ (Iq n
        (BL (A9 n) A8 i j)).toReal := ENNReal.toReal_nonneg
    have hrw : Iq n
        (BL (A9 n) A8 i j) =
        ENNReal.ofReal (Iq n
          (BL (A9 n) A8 i j)).toReal :=
      (ENNReal.ofReal_toReal (AYo i j)).symm
    rw [Gh, hrw, AO3 _ hnn]
    apply ENNReal.ofReal_le_ofReal
    rw [← hs] at hb
    linarith
  apply Finset.sup_le
  intro i _
  have hrow : RV n (A9 n) A8 i ≤
      ENNReal.ofReal ((1 + 8 * Real.exp 5 * s) + 3 * ((1 + 8 * Real.exp 5 * s) * s)) := by
    rw [RV]
    apply AOB _ i _ _ (by positivity) (by positivity)
    · rw [M5, ANs, ENNReal.ofReal_one, mul_one]
      exact hfac i i
    · intro j hj
      rw [M5]
      have hQ : KR n (A9 n) A8 i j ≤ s := by
        rw [hs]
        exact ANu n hdom A8 hL4 Br.2 hLn (Ne.symm hj)
      calc Gh n (A9 n) A8 i j *
            ENNReal.ofReal (KR n (A9 n) A8 i j)
          ≤ ENNReal.ofReal (1 + 8 * Real.exp 5 * s) * ENNReal.ofReal s :=
            mul_le_mul' (hfac i j) (ENNReal.ofReal_le_ofReal hQ)
        _ = ENNReal.ofReal ((1 + 8 * Real.exp 5 * s) * s) := by
            rw [← ENNReal.ofReal_mul (by positivity)]
  refine hrow.trans (ENNReal.ofReal_le_ofReal ?_)
  have hexp : (0 : ℝ) < Real.exp 5 := Real.exp_pos 5
  have hsq : s * s ≤ s := by nlinarith
  nlinarith [hspos, hs1, hexp, hsq]
end
