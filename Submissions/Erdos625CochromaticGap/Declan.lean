def AIT
    {A B : Type*} [Fintype A] [Fintype B]
    [DecidableEq A] [DecidableEq B]
    (C M : Finset (A × B)) : Prop :=
  ∃ code : Jt A B, QX C M code
def AIY
    {A B : Type*} [Fintype A] [Fintype B]
    [DecidableEq A] [DecidableEq B]
    (M : Finset (A × B)) : Prop :=
  DZ M →
    ∀ C : Finset (A × B),
      Uj C → (C ∩ M).Nonempty →
        AIT C M
