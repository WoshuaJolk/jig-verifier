    (v : Fin n) :
    (d.2 (G8 P v) ⟨v, Y7 P v⟩ : ℕ) =
      (e.2 (G8 P v) ⟨v, Y7 P v⟩ : ℕ) := by
  have hpoint := congrArg
    (fun E : Fin n ≃ Dm (AG.sizes k) ↦ E v) h
  exact congrArg
    (fun y : Dm (AG.sizes k) ↦ (y.2.2 : ℕ)) hpoint
theorem AjB
    {b n : ℕ} {k : AG b}
    (P : BT n k) (d e : LG P)
    (h : Lk P d = Lk P e) :
    d.1 = e.1 := by
  funext s
  apply Equiv.ext
  intro Bs
  apply Fin.ext
  let B : P.1.parts := Bs.1
  obtain ⟨v, hv⟩ := P.1.nonempty_of_mem_parts B.2
  let Bv := G8 P v
  let sv := Kh P Bv
  let Bsv : HW P sv.1 := ⟨Bv, rfl⟩
  have hBv : Bv = B := kH P v B hv
  have hs : sv = s := by
    apply Subtype.ext
    change Bv.1.card = (s : ℕ)
    rw [hBv]
    exact Bs.2
  have U9 := AMo P d e h v
  change (d.1 sv Bsv : ℕ) = (e.1 sv Bsv : ℕ) at U9
  calc
    (d.1 s Bs : ℕ) = (d.1 sv Bsv : ℕ) :=
      (A9f P d sv s Bsv Bs hs hBv).symm
    _ = (e.1 sv Bsv : ℕ) := U9
    _ = (e.1 s Bs : ℕ) :=
      A9f P e sv s Bsv Bs hs hBv
theorem AjC
    {b n : ℕ} {k : AG b}
    (P : BT n k) (d e : LG P)
    (h : Lk P d = Lk P e) :
    d.2 = e.2 := by
  funext B
  apply Equiv.ext
  intro z
  apply Fin.ext
  let Bv := G8 P z.1
  let zv : Bv.1 := ⟨z.1, Y7 P z.1⟩
  have hBv : Bv = B := kH P z.1 B z.2
  have U9 := AMp P d e h z.1
  change (d.2 Bv zv : ℕ) = (e.2 Bv zv : ℕ) at U9
  calc
    (d.2 B z : ℕ) = (d.2 Bv zv : ℕ) :=
      A9g P d z zv hBv.symm rfl
    _ = (e.2 Bv zv : ℕ) := U9
    _ = (e.2 B z : ℕ) :=
      A9g P e zv z hBv rfl
theorem AjA
    {b n : ℕ} {k : AG b}
    (P : BT n k) (d e : LG P)
    (h : Lk P d = Lk P e) : d = e := by
  apply Prod.ext
  · exact AjB P d e h
  · exact AjC P d e h
theorem ApC
    {b n : ℕ} {k : AG b} :
    Function.Injective
      (A13 (b := b) (n := n) (k := k)) := by
  rintro ⟨P, d⟩ ⟨Q, e⟩ h
  have C7 : P.1 = Q.1 := by
    calc
      P.1 = F8 (Lk P d) :=
        (AH5 P d).symm
      _ = F8 (Lk Q e) :=
        congrArg
          (fun E : Fin n ≃ Dm (AG.sizes k) ↦
            F8 E) h
      _ = Q.1 := AH5 Q e
  have hP : P = Q := Subtype.ext C7
  cases hP
  exact congrArg (Sigma.mk P) (AjA P d e h)
theorem ApE
    {b n : ℕ} {k : AG b} :
    Function.Surjective
      (A13 (b := b) (n := n) (k := k)) := by
  intro E
  exact ⟨AH7 E,
    ApD E⟩
noncomputable def ApB
    {b : ℕ} (n : ℕ) (k : AG b) :
    Zu n k ≃
      (Fin n ≃ Dm (AG.sizes k)) :=
  Equiv.ofBijective A13
    ⟨ApC,
      ApE⟩
theorem Aj9
    {b : ℕ} (n : ℕ) (k : AG b) :
    A8S n k :=
  ⟨ApB n k⟩
theorem kG
    {b : ℕ} (n : ℕ) (k : AG b)
    (hMass : AG.DK k = n) :
    Zq n k :=
  AjZ n k hMass
    (Aj9 n k)
theorem AwL
    {b : ℕ} (n : ℕ) (k : AG b)
    (hMass : AG.DK k = n) :
    JT n k =
      ((Nat.factorial n /
          ((∏ i : Fin b, (Nat.factorial (i.1 + 1)) ^ k i) *
            ∏ i : Fin b, Nat.factorial (k i)) : ℕ) : ENNReal) *
        (1 / 2 : ENNReal) ^ AG.Eo k :=
  Aj7 n k hMass
    (kG n k hMass)
end
