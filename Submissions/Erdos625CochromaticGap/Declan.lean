    simpa [f] using NormedSpace.expSeries_div_summable x
  calc
    ∑ r ∈ Finset.range (bound + 1), x ^ r / (r.factorial : Real) =
        ∑ r ∈ Finset.range (bound + 1), f r := by rfl
    _ ≤ ∑' r, f r := by
      apply hsum.sum_le_tsum
      intro r hr
      exact div_nonneg (pow_nonneg hx _) (by positivity)
