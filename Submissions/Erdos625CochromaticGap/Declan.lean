    ((A7m P Q σ τ).mp
      AaK)
theorem AmR
    {b n : ℕ} {k : AG b}
    (P Q : BT n k)
    (σ : P.1.parts → Bool) (τ : Q.1.parts → Bool) :
    UZ P Q σ τ ⊔
        UR P Q σ τ =
      Gq P.1 ⊔ Gq Q.1 := by
  rw [UZ, UR]
  calc
    (Gt P σ ⊔ Gt Q τ) ⊔
        (Nj P σ ⊔ Nj Q τ) =
      (Gt P σ ⊔ Nj P σ) ⊔
        (Gt Q τ ⊔ Nj Q τ) := by
          ac_rfl
    _ = Gq P.1 ⊔ Gq Q.1 := by
      rw [AGs,
        AGs]
private theorem AFD
    {b n : ℕ} {k : AG b}
    (P Q : BT n k) :
    K6 (fun A B => P.overlapCellCount Q A B) =
      ∑ A ∈ P.1.parts, ∑ B ∈ Q.1.parts,
        (TK A B).choose 2 := by
  classical
  simp [K6, BT.overlapCellCount,
    TK]
  calc
    (∑ A ∈ P.1.parts.attach, ∑ B ∈ Q.1.parts.attach,
        (A.1 ∩ B.1).card.choose 2) =
      ∑ A ∈ P.1.parts.attach, ∑ B ∈ Q.1.parts,
        (A.1 ∩ B).card.choose 2 := by
          apply Finset.sum_congr rfl
          intro A hA
          exact Finset.sum_attach Q.1.parts
            (fun B => (A.1 ∩ B).card.choose 2)
    _ = ∑ A ∈ P.1.parts, ∑ B ∈ Q.1.parts,
        (A ∩ B).card.choose 2 :=
      Finset.sum_attach P.1.parts
        (fun A => ∑ B ∈ Q.1.parts, (A ∩ B).card.choose 2)
theorem AmT
    {b n : ℕ} {k : AG b}
    (P Q : BT n k)
    (σ : P.1.parts → Bool) (τ : Q.1.parts → Bool)
    (OZ : ∀ A B,
      2 ≤ P.overlapCellCount Q A B → σ A = τ B) :
    (UZ P Q σ τ).edgeSet.ncard +
        (UR P Q σ τ).edgeSet.ncard +
        K6 (fun A B => P.overlapCellCount Q A B) =
      2 * AG.Eo k := by
  have hdis : Disjoint
      (UZ P Q σ τ)
      (UR P Q σ τ) :=
    (A7m P Q σ τ).mpr
      OZ
  have hcard :
      (UZ P Q σ τ ⊔
          UR P Q σ τ).edgeSet.ncard =
        (UZ P Q σ τ).edgeSet.ncard +
          (UR P Q σ τ).edgeSet.ncard := by
    rw [SimpleGraph.edgeSet_sup]
    exact Set.ncard_union_eq (SimpleGraph.disjoint_edgeSet.mpr hdis)
  rw [← hcard, AmR,
    AFD]
  exact A6o P Q
theorem AmS
    {b n : ℕ} {k : AG b}
    (P Q : BT n k)
    (σ : P.1.parts → Bool) (τ : Q.1.parts → Bool)
    (OZ : ∀ A B,
