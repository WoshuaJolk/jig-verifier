section M046
namespace Erdos625
set_option autoImplicit false
def AIQ (alpha : Nat) (A8 : 5 < alpha)
    (k : AG (alpha + 1)) : Prop :=
  (forall i, BK alpha A8 i = alpha - 2 - i.val) /\
    (forall i,
      (GR alpha A8 k i).card =
        Bz alpha A8 k i) /\
      (forall i j, i != j ->
        Disjoint (GR alpha A8 k i)
          (GR alpha A8 k j))
theorem c7
    (alpha : Nat) (A8 : 5 < alpha)
    (k : AG (alpha + 1)) :
    AIQ alpha A8 k := by
  have hsize : ∀ i, BK alpha A8 i = alpha - 2 - i.val := by
    intro i
    unfold BK Oz GQ
    simp [Ao]
    omega
  refine ⟨hsize, ?_, ?_⟩
  · intro i
    rw [show (GR alpha A8 k i).card =
        Fintype.card {q : Bl k //
          AO k q = BK alpha A8 i} by
      rw [Fintype.card_subtype]
      rfl]
    change Fintype.card {q : G9 (AG.sizes k) //
      (q.1 : Nat) = BK alpha A8 i} = _
    rw [A1c]
    rw [show BK alpha A8 i =
        (Oz alpha A8 i).val + 1 by rfl]
    rw [AG.A1u]
    rfl
  · intro i j hij
    rw [Finset.disjoint_left]
    intro q hqi hqj
    simp only [GR, Finset.mem_filter, Finset.mem_univ,
      true_and] at hqi hqj
    have hs : BK alpha A8 i = BK alpha A8 j :=
      hqi.symm.trans hqj
    have heq : i = j := by
      apply Fin.ext
      rw [hsize i, hsize j] at hs
      omega
    subst j
    simp at hij
end Erdos625
