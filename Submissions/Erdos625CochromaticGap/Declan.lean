    calc (2 * a) ^ 2 = 4 * a ^ 2 := by ring
      _ ≤ 4 * (x * y) := by gcongr
  have h4 : 4 * (x * y) ≤ (x + y) ^ 2 := by
    have h5 := ANr x y
    calc (4 : ENNReal) * (x * y) = 2 * (x * y) + 2 * (x * y) := by ring
      _ ≤ (x ^ 2 + y ^ 2) + 2 * (x * y) := by gcongr
      _ = (x + y) ^ 2 := by ring
