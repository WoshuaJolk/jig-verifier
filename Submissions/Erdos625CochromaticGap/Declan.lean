def Fe {V : Type*} [Fintype V] [DecidableEq V]
    (K : V → V → ℝ≥0∞) : ℕ → V → V → ℝ≥0∞
  | 0, v, w => if v = w then 1 else 0
  | ell + 1, v, w => ∑ u, K v u * Fe K ell u w
def JK {V : Type*} [Fintype V] [DecidableEq V]
    (K : V → V → ℝ≥0∞) (L : ℕ) (v w : V) : ℝ≥0∞ :=
  ∑ ell ∈ Finset.range L, Fe K (ell + 1) v w
theorem AQe
    {V : Type*} [Fintype V] [DecidableEq V]
    (K : V → V → ℝ≥0∞) (tau : ℝ≥0∞)
    (hRow : ∀ v, ∑ w, K v w ≤ tau) (L : ℕ) :
    (∀ ell v,
        (∑ w, Fe K ell v w) =
          Ek K ell v) ∧
      ∀ v, ∑ w, JK K L v w ≤
        tau * (1 - tau)⁻¹ := by
  have AC5 : ∀ ell v,
      (∑ w, Fe K ell v w) =
        Ek K ell v := by
    intro ell v
    induction ell generalizing v with
    | zero => simp [Fe, Ek]
    | succ ell ih =>
        simp only [Fe, Ek]
        rw [Finset.sum_comm]
        apply Finset.sum_congr rfl
        intro u hu
        rw [← Finset.mul_sum, ih u]
  refine ⟨AC5, ?_⟩
  intro v
  calc
    (∑ w, JK K L v w) =
        ∑ ell ∈ Finset.range L,
          ∑ w, Fe K (ell + 1) v w := by
      simp only [JK]
      rw [Finset.sum_comm]
    _ = ∑ ell ∈ Finset.range L,
          Ek K (ell + 1) v := by
      apply Finset.sum_congr rfl
      intro ell hell
      rw [AC5]
    _ ≤ ∑ ell ∈ Finset.range L, tau ^ (ell + 1) := by
      apply Finset.sum_le_sum
      intro ell hell
      exact jB K tau hRow (ell + 1) v
    _ ≤ tau * (1 - tau)⁻¹ := AHd tau L
