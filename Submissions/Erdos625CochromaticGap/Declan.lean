section M085
namespace Erdos625
noncomputable section
theorem AOj
    {A B : Type*} [Fintype A] [Fintype B]
    (x y : A → B → ZMod 2) (M R : A → B → Prop)
    (AE1 : Yd x)
    (AE3 : Yd y)
    (Cv : ∀ a b₁ b₂, M a b₁ → M a b₂ → b₁ = b₂)
    (AeC : ∀ a b, x a b ≠ 0 → M a b ∨ R a b)
    (AeG : ∀ a b, y a b ≠ 0 → M a b ∨ R a b)
    (Nb : ∀ a b, R a b → x a b = y a b) :
    x = y := by
  let z : A → B → ZMod 2 := fun a b ↦ x a b - y a b
  have AeI : Yd z := by
    constructor
    · intro a
      simp only [z, Finset.sum_sub_distrib, AE1.1 a, AE3.1 a, sub_self]
    · intro b
      simp only [z, Finset.sum_sub_distrib, AE1.2 b, AE3.2 b, sub_self]
  have AeK : ∀ a b, z a b ≠ 0 → M a b := by
    intro a b hz
    have hxy : x a b ≠ y a b := sub_ne_zero.mp hz
    by_contra hM
    have hR : R a b := by
      by_cases hx0 : x a b = 0
      · have hy0 : y a b ≠ 0 := by
          intro hy0
          exact hxy (hx0.trans hy0.symm)
        exact (AeG a b hy0).resolve_left hM
      · exact (AeC a b hx0).resolve_left hM
    exact hxy (Nb a b hR)
  have AeL : z = 0 :=
    AOk z M AeI Cv AeK
  funext a b
  have hab : z a b = 0 := by rw [AeL]; rfl
  exact sub_eq_zero.mp hab
def Uh
    {A B : Type*} [Fintype A] [Fintype B]
    (M R : A → B → Prop) :=
  {x : A → B → ZMod 2 //
    Yd x ∧ ∀ a b, x a b ≠ 0 → M a b ∨ R a b}
def Oo
    {A B : Type*} (R : A → B → Prop) :=
  {e : A × B // R e.1 e.2}
def AGb
    {A B : Type*} [Fintype A] [Fintype B]
    (M R : A → B → Prop) :
    Uh M R → Oo R → ZMod 2 :=
  fun x e ↦ x.1 e.1.1 e.1.2
theorem AlG
    {A B : Type*} [Fintype A] [Fintype B]
    (M R : A → B → Prop)
    (Cv : ∀ a b₁ b₂, M a b₁ → M a b₂ → b₁ = b₂) :
    Function.Injective (AGb M R) := by
  intro x y hxy
  apply Subtype.ext
  apply AOj x.1 y.1 M R
    x.2.1 y.2.1 Cv x.2.2 y.2.2
  intro a b hR
  exact congrFun hxy ⟨(a, b), hR⟩
theorem AKL
    {A B : Type*} [Fintype A] [Fintype B]
    (M R : A → B → Prop)
    (Cv : ∀ a b₁ b₂, M a b₁ → M a b₂ → b₁ = b₂) :
    Nat.card (Uh M R) ≤
      2 ^ Nat.card (Oo R) := by
  letI : Finite (Uh M R) :=
    Finite.of_injective Subtype.val Subtype.val_injective
  letI : Finite (Oo R) :=
    Finite.of_injective Subtype.val Subtype.val_injective
  letI : Fintype (Uh M R) := Fintype.ofFinite _
  letI : Fintype (Oo R) := Fintype.ofFinite _
  letI : DecidableEq (Oo R) := Classical.decEq _
  calc
    Nat.card (Uh M R) =
        Fintype.card (Uh M R) := Nat.card_eq_fintype_card
    _ ≤ Fintype.card (Oo R → ZMod 2) :=
      Fintype.card_le_of_injective (AGb M R)
        (AlG M R Cv)
    _ = 2 ^ Nat.card (Oo R) := by
      rw [Fintype.card_fun, Nat.card_eq_fintype_card]
      norm_num
end
end Erdos625
end M085

section M086
namespace Erdos625
open scoped BigOperators
noncomputable section
theorem A90
    {X A B : Type*} [Finite X] [Fintype A] [Fintype B]
    (encode : X → A → B → ZMod 2) (M R : A → B → Prop)
    (e9 : Function.Injective encode)
    (heven : ∀ x, Yd (encode x))
    (hsupport : ∀ x a b, encode x a b ≠ 0 → M a b ∨ R a b)
    (Cv : ∀ a b₁ b₂, M a b₁ → M a b₂ → b₁ = b₂) :
    Nat.card X ≤ 2 ^ Nat.card (Oo R) := by
  let AI1 : X → Uh M R :=
    fun x ↦ ⟨encode x, heven x, hsupport x⟩
  have AX1 : Function.Injective AI1 := by
    intro x y hxy
    apply e9
    exact congrArg Subtype.val hxy
  letI : Finite (Uh M R) :=
    Finite.of_injective Subtype.val Subtype.val_injective
  letI : Fintype X := Fintype.ofFinite X
  letI : Fintype (Uh M R) := Fintype.ofFinite _
