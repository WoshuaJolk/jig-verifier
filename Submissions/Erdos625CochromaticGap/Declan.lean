    simpa only [Function.comp_def, id_eq] using
      (isLittleO_const_id_atTop Dq).comp_tendsto
        (tendsto_natCast_atTop_atTop (R := ℝ))
  simpa only [Jk] using
    (r6.sub Af4).add hC
theorem AIr :
    (fun n : ℕ ↦ JE n) =o[atTop] (fun n : ℕ ↦ (n : ℝ)) := by
  have hOne : (fun _n : ℕ ↦ (1 : ℝ)) =o[atTop] (fun n : ℕ ↦ (n : ℝ)) := by
    simpa only [Function.comp_def, id_eq] using
