    (A1V e).symm g a = g (e a) := rfl
abbrev A1E {b : Nat} (n : Nat) (k : AG b) :=
  Σ x : FN n k, x.1.1.parts → Bool
abbrev uO {b : Nat} (n : Nat) (k : AG b) :=
  Σ _ : Ac n k, Bl k → Bool
noncomputable def Sz
    {b n : Nat} (k : AG b) :
    A1E n k ≃ uO n k :=
  Equiv.sigmaCongr (r5 k)
