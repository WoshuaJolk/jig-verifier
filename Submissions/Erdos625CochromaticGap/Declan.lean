  classical
  let encode : {e : A × B // P e.1 e.2} →
      (CX P).edgeSet := fun e =>
    ⟨s(Sum.inl e.1.1, Sum.inr e.1.2), by
      simpa [CX, SimpleGraph.fromRel_adj] using e.2⟩
  refine Equiv.ofBijective encode ⟨?_, ?_⟩
  · intro e f hef
    apply Subtype.ext
