theorem A2d
    (alpha : Nat) (A8 : 5 < alpha) (k : AG (alpha + 1))
    (L : Bh)
    (AN : CZ alpha A8 k)
    (D : J9 alpha A8 k L)
    (e : ↥D.1.1.edges) :
    (Jy alpha A8 k L AN D).edges.filter
        (fun z => z.1.1 = Bc alpha A8 k AN e.1.1 ∧
          z.2.1 = Bc alpha A8 k AN e.1.2) =
