    have h := (div_le_iff₀ A38).mp dH
    nlinarith
  have PI : 0 ≤ 2 * v * Lambda :=
    mul_nonneg (mul_nonneg (by norm_num) hv.le) GU
  have At8 : (Real.sqrt (2 * v * Lambda)) ^ 2 = 2 * v * Lambda :=
    Real.sq_sqrt PI
