          Cj k × Cm ell) ∈ S.edges := by
      simpa [Bm.cellEdges] using hp
    have OX :
        (MQ S i j r).1 = p.1 := by
      simpa [r] using sw S i j r
    have cw := S.leftUnique _ A2v _ A3O (by
      exact Sigma.ext rfl (heq_of_eq OX))
    exact (eq_of_heq
      (Sigma.mk.inj_iff.mp (congrArg Prod.snd cw)).2).trans NY
@[simp]
private theorem Ame
    {I J : Type*}
    [Fintype I] [Fintype J] [DecidableEq I] [DecidableEq J]
    {k : I -> Nat} {ell : J -> Nat}
    (S : Bm k ell) (i : I) (j : J)
    (r : ↑(S.rowCell i j)) :
    ((AGz S i j r : ↑(S.Lj i j)) :
      Fin (ell j)) =
      (MQ S i j r).2 := by
  rfl
def YV
    {I J : Type*}
    [Fintype I] [Fintype J] [DecidableEq I] [DecidableEq J]
    {L : I -> J -> Nat} {k : I -> Nat} {ell : J -> Nat}
    (matching : Jv L k ell) :
    TY matching ↪
      (Cj k × Cm ell) where
  toFun atom :=
    (tZ matching atom,
      A15 matching
        (YW matching atom))
  inj' := by
    intro atom₁ atom₂ h
    apply (tZ matching).injective
    exact congrArg Prod.fst h
def OI
    {I J : Type*}
    [Fintype I] [Fintype J] [DecidableEq I] [DecidableEq J]
    {L : I -> J -> Nat} {k : I -> Nat} {ell : J -> Nat}
    (matching : Jv L k ell) :
    Bm k ell where
  edges := Finset.univ.map (YV matching)
  leftUnique := by
    intro e₁ he₁ e₂ he₂ hLeft
    rw [Finset.mem_map] at he₁ he₂
    obtain ⟨atom₁, _, rfl⟩ := he₁
    obtain ⟨atom₂, _, rfl⟩ := he₂
    have hAtom :
        atom₁ = atom₂ :=
      (tZ matching).injective hLeft
    subst atom₂
    rfl
  QN := by
    intro e₁ he₁ e₂ he₂ WX
    rw [Finset.mem_map] at he₁ he₂
    obtain ⟨atom₁, _, rfl⟩ := he₁
    obtain ⟨atom₂, _, rfl⟩ := he₂
    have AVY :
        YW matching atom₁ =
          YW matching atom₂ :=
      (A15 matching).injective WX
    have hAtom :
        atom₁ = atom₂ :=
      (YW matching).injective AVY
    subst atom₂
    rfl
private theorem AKs
    {I J : Type*}
    [Fintype I] [Fintype J] [DecidableEq I] [DecidableEq J]
    {L : I -> J -> Nat} {k : I -> Nat} {ell : J -> Nat}
    (matching : Jv L k ell) (i : I) (j : J) :
    (Finset.univ.filter
        (fun atom : TY matching =>
          atom.1 = i ∧ atom.2.1 = j)).card =
      ((matching.FJ i).1 j).card := by
  symm
  refine Finset.card_bij
    (fun stub hStub =>
      (⟨i, j, ⟨stub, hStub⟩⟩ :
        TY matching)) ?_ ?_ ?_
  · intro stub hStub
    simp
  · intro stub₁ hStub₁ stub₂ hStub₂ hEq
    have AXO :
        (⟨stub₁, hStub₁⟩ :
          ((matching.FJ i).1 j : Finset (Fin (k i)))) =
        ⟨stub₂, hStub₂⟩ := by
      exact eq_of_heq (Sigma.mk.inj_iff.mp
        (eq_of_heq (Sigma.mk.inj_iff.mp hEq).2)).2
    exact congrArg Subtype.val AXO
  · intro atom hAtom
    rw [Finset.mem_filter] at hAtom
    obtain ⟨_, hI, hJ⟩ := hAtom
    obtain ⟨i', j', stub⟩ := atom
    simp only at hI hJ
    subst i'
    subst j'
    exact ⟨stub.1, stub.2, rfl⟩
theorem ApV
    {I J : Type*}
    [Fintype I] [Fintype J] [DecidableEq I] [DecidableEq J]
    {L : I -> J -> Nat} {k : I -> Nat} {ell : J -> Nat}
    (matching : Jv L k ell) :
    (OI matching).typeTable = L := by
  funext i j
  unfold Bm.typeTable
  change
    ((Finset.univ.map (YV matching)).filter
      (fun e => e.1.1 = i ∧ e.2.1 = j)).card = L i j
  rw [Finset.filter_map, Finset.card_map]
  change
    (Finset.univ.filter
      (fun atom : TY matching =>
        atom.1 = i ∧ atom.2.1 = j)).card = L i j
  rw [AKs matching i j]
  simpa using (matching.FJ i).2.1 j
def AI5
    {I J : Type*}
    [Fintype I] [Fintype J] [DecidableEq I] [DecidableEq J]
    (L : I -> J -> Nat) (k : I -> Nat) (ell : J -> Nat) :
    Jv L k ell ->
      {S : Bm k ell // S.typeTable = L} :=
  fun matching =>
    ⟨OI matching,
      ApV matching⟩
noncomputable def tj
    {I J : Type*}
    [Fintype I] [Fintype J] [DecidableEq I] [DecidableEq J]
    (L : I -> J -> Nat) (k : I -> Nat) (ell : J -> Nat) :
    {S : Bm k ell // S.typeTable = L} ->
      Jv L k ell :=
  fun S =>
    { FJ := Amg S.1 S.2
      Ov := Amf S.1 S.2
      pairing := fun i j => AGz S.1 i j }
private theorem AGO
    {I J : Type*}
    [Fintype I] [Fintype J] [DecidableEq I] [DecidableEq J]
    (L : I -> J -> Nat) (k : I -> Nat) (ell : J -> Nat)
    (S : {S : Bm k ell // S.typeTable = L})
    (i : I) (j : J) (r : ↑(S.1.rowCell i j)) :
    YV
        (tj L k ell S)
        ⟨i, j, r⟩ =
      ((⟨i, r.1⟩,
          ⟨j, (MQ S.1 i j r).2⟩) :
        Cj k × Cm ell) := by
  apply Prod.ext
  · rfl
  · apply Sigma.ext rfl
    exact heq_of_eq (Ame S.1 i j r)
private theorem Aph
    {I J : Type*}
    [Fintype I] [Fintype J] [DecidableEq I] [DecidableEq J]
    (L : I -> J -> Nat) (k : I -> Nat) (ell : J -> Nat)
    (S : {S : Bm k ell // S.typeTable = L}) :
    (OI
      (tj L k ell S)).edges =
      S.1.edges := by
  ext e
  constructor
  · intro he
    rw [OI, Finset.mem_map] at he
    obtain ⟨atom, _, rfl⟩ := he
    obtain ⟨i, j, r⟩ := atom
    change ↑(S.1.rowCell i j) at r
    have hCell :=
      kS S.1 i j r
    have hEdge :
        ((⟨i, (MQ S.1 i j r).1⟩,
            ⟨j, (MQ S.1 i j r).2⟩) :
          Cj k × Cm ell) ∈ S.1.edges := by
      simpa [Bm.cellEdges] using hCell
    have OX :
        (MQ S.1 i j r).1 = r.1 :=
      sw S.1 i j r
    rw [AGO L k ell S i j r]
    simpa [OX] using hEdge
  · intro he
    obtain ⟨⟨i, r⟩, ⟨j, c⟩⟩ := e
    let p : Fin (k i) × Fin (ell j) := (r, c)
    have hp : p ∈ S.1.cellEdges i j := by
      simp [p, Bm.cellEdges, he]
    let r' : ↑(S.1.rowCell i j) :=
      ⟨r, Finset.mem_image.mpr ⟨p, hp, rfl⟩⟩
    let atom :
        TY
          (tj L k ell S) :=
      ⟨i, j, r'⟩
    rw [OI, Finset.mem_map]
    refine ⟨atom, Finset.mem_univ _, ?_⟩
    have A2v :
        ((⟨i, (MQ S.1 i j r').1⟩,
            ⟨j, (MQ S.1 i j r').2⟩) :
          Cj k × Cm ell) ∈ S.1.edges := by
      simpa [Bm.cellEdges] using
        kS S.1 i j r'
    have A3O :
        ((⟨i, p.1⟩, ⟨j, p.2⟩) :
