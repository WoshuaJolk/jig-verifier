theorem Ael
    {A B : Type*}
    [Fintype A] [Fintype B] [DecidableEq A] [DecidableEq B]
    (demand : A → B → ℕ) (row : A → ℕ) (col : B → ℕ)
    (B9 : Finset.univ.sum row = Finset.univ.sum col)
    (WQ : E4 demand ≤ Finset.univ.sum row) :
    (F5 row col B9).toOuterMeasure
        (O9 demand row col) ≤
      ((Wv demand row *
          W6 demand col : ℕ) : ℝ≥0∞) /
        (((Finset.univ.sum row).descFactorial (E4 demand) *
          Jx demand : ℕ) : ℝ≥0∞) := by
  let m := Finset.univ.sum row
  let x := E4 demand
  let W := Fintype.card (BW demand row col)
  let D := Jx demand
  let N := Wv demand row *
    W6 demand col
  have hraw :=
    ApZ
      demand row col B9
  change _ ≤ (W : ℝ≥0∞) * ((m - x).factorial : ℝ≥0∞) /
    (m.factorial : ℝ≥0∞) at hraw
  change _ ≤ (N : ℝ≥0∞) /
    ((m.descFactorial x * D : ℕ) : ℝ≥0∞)
