          ((LH n alpha A8 r : ℕ) : ENNReal) := by
  unfold DG NU LH
  rw [ANB, A9w]
  push_cast
  ring_nf
private lemma A9t (n alpha : Nat) (A8 : 5 < alpha)
    (k : AG (alpha + 1)) (L : Bh) :
