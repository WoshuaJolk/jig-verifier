section M057
namespace Erdos625
def Np
    {A B : Type*}
    [Fintype A] [Fintype B] [DecidableEq A] [DecidableEq B]
    {row : A → ℕ} {col : B → ℕ}
    (matching : BZ row col) (U : ℕ) : A → B → ℕ :=
  KE (BX matching) U
private theorem AGd
    {A B : Type*}
    [Fintype A] [Fintype B] [DecidableEq A] [DecidableEq B]
    {demand : A → B → ℕ} {row : A → ℕ} {col : B → ℕ}
    (matching : BZ row col)
    (witness : BW demand row col)
    (A5J : H7 matching witness)
    (a : A) (b : B) :
    (witness.1 a).1 b ⊆
      Finset.univ.filter
        (fun stub : Fin (row a) ↦ (matching ⟨a, stub⟩).1 = b) := by
  intro stub hstub
  simp only [Finset.mem_filter, Finset.mem_univ, true_and]
  have hpair :=
    (aZ matching witness).1
      A5J a b ⟨stub, hstub⟩
  exact congrArg Sigma.fst hpair
private theorem ALA
    {A B : Type*}
    [Fintype A] [Fintype B] [DecidableEq A] [DecidableEq B]
    {demand : A → B → ℕ} {row : A → ℕ} {col : B → ℕ}
    (matching : BZ row col)
    (FJ : ∀ a, JZ (row a) (demand a))
    (Nt : ∀ b, JZ (col b) (fun a ↦ demand a b))
    (pairing₁ pairing₂ : ∀ a b,
      (↑((FJ a).1 b)) ≃ (↑((Nt b).1 a)))
    (h₁ : H7 matching
      ⟨FJ, Nt, pairing₁⟩)
    (h₂ : H7 matching
      ⟨FJ, Nt, pairing₂⟩) :
    pairing₁ = pairing₂ := by
  funext a b
  apply Equiv.ext
  intro stub
  apply Subtype.ext
  have hpair₁ :=
    (aZ matching
      ⟨FJ, Nt, pairing₁⟩).1 h₁ a b stub
  have hpair₂ :=
    (aZ matching
      ⟨FJ, Nt, pairing₂⟩).1 h₂ a b stub
  exact eq_of_heq (Sigma.mk.inj_iff.mp (hpair₁.symm.trans hpair₂)).2
private theorem AQU
    {A B : Type*}
    [Fintype A] [Fintype B] [DecidableEq A] [DecidableEq B]
    {demand : A → B → ℕ} {row : A → ℕ} {col : B → ℕ}
    (matching : BZ row col)
    (hfull : ∀ a b, demand a b = BX matching a b ∨
      demand a b = 0)
    (w₁ w₂ : BW demand row col)
    (h₁ : H7 matching w₁)
    (h₂ : H7 matching w₂) :
    w₁ = w₂ := by
  obtain ⟨w₁_row, w₁_col, w₁_eq⟩ := w₁
  obtain ⟨w₂_row, w₂_col, w₂_eq⟩ := w₂
  have h_row : w₁_row = w₂_row := by
    funext a
    apply Subtype.ext
    funext b
    by_cases A4Z :
        demand a b = BX matching a b
    · have hw₁_full :
          (w₁_row a).1 b =
            Finset.univ.filter
              (fun stub : Fin (row a) ↦ (matching ⟨a, stub⟩).1 = b) := by
        refine Finset.eq_of_subset_of_card_le
          (AGd matching
            ⟨w₁_row, w₁_col, w₁_eq⟩ h₁ a b) ?_
        rw [(w₁_row a).2.1 b, A4Z]
        rfl
      have hw₂_full :
          (w₂_row a).1 b =
            Finset.univ.filter
              (fun stub : Fin (row a) ↦ (matching ⟨a, stub⟩).1 = b) := by
        refine Finset.eq_of_subset_of_card_le
          (AGd matching
            ⟨w₂_row, w₂_col, w₂_eq⟩ h₂ a b) ?_
        rw [(w₂_row a).2.1 b, A4Z]
        rfl
      exact hw₁_full.trans hw₂_full.symm
    · have hzero : demand a b = 0 :=
        (hfull a b).resolve_left A4Z
      have hw₁_zero : (w₁_row a).1 b = ∅ := by
        apply Finset.card_eq_zero.mp
        exact ((w₁_row a).2.1 b).trans hzero
      have hw₂_zero : (w₂_row a).1 b = ∅ := by
        apply Finset.card_eq_zero.mp
        exact ((w₂_row a).2.1 b).trans hzero
      exact hw₁_zero.trans hw₂_zero.symm
  cases h_row
  have h_col : w₁_col = w₂_col := by
    funext b
    apply Subtype.ext
    funext a
    apply Finset.eq_of_subset_of_card_le
    · intro x hx
      let y : ↑((w₁_row a).1 b) :=
        (w₁_eq a b).symm ⟨x, hx⟩
      have hy : (w₁_eq a b y).1 = x :=
        congrArg Subtype.val ((w₁_eq a b).apply_symm_apply ⟨x, hx⟩)
      have hpair₁ :=
        (aZ matching
          ⟨w₁_row, w₁_col, w₁_eq⟩).1 h₁ a b y
      have hpair₂ :=
        (aZ matching
          ⟨w₁_row, w₂_col, w₂_eq⟩).1 h₂ a b y
      have hvalue : (w₁_eq a b y).1 = (w₂_eq a b y).1 :=
        eq_of_heq
          (Sigma.mk.inj_iff.mp (hpair₁.symm.trans hpair₂)).2
      have AeD : x = (w₂_eq a b y).1 := hy.symm.trans hvalue
      rw [AeD]
      exact (w₂_eq a b y).2
    · rw [(w₂_col b).2.1 a, (w₁_col b).2.1 a]
  cases h_col
  have h_eq : w₁_eq = w₂_eq :=
    ALA matching w₁_row w₁_col
      w₁_eq w₂_eq h₁ h₂
  cases h_eq
  rfl
private theorem AJw
    {A B : Type*}
    [Fintype A] [Fintype B] [DecidableEq A] [DecidableEq B]
    {row : A → ℕ} {col : B → ℕ}
    (matching : BZ row col) (U : ℕ) :
    ∀ a b,
      Np matching U a b ≤
        BX matching a b := by
  intro a b
  by_cases hhigh : U / 2 < BX matching a b
  · rw [Np, KE, if_pos hhigh]
  · rw [Np, KE, if_neg hhigh]
    exact Nat.zero_le _
private theorem AJu
    {A B : Type*}
    [Fintype A] [Fintype B] [DecidableEq A] [DecidableEq B]
    {row : A → ℕ} {col : B → ℕ}
    (matching : BZ row col) (U : ℕ) :
    ∀ a b,
      Np matching U a b =
          BX matching a b ∨
        Np matching U a b = 0 := by
  intro a b
  by_cases hhigh : U / 2 < BX matching a b
  · left
    rw [Np, KE, if_pos hhigh]
  · right
    rw [Np, KE, if_neg hhigh]
theorem APf
    {A B : Type*}
    [Fintype A] [Fintype B] [DecidableEq A] [DecidableEq B]
    (row : A → ℕ) (col : B → ℕ)
    (matching : BZ row col) (U : ℕ) :
    ∃! witness : BW
        (Np matching U) row col,
      H7 matching witness := by
  obtain ⟨w₁, hw₁⟩ :=
    wI
      (matching := matching)
      (AJw matching U)
  refine ⟨w₁, hw₁, ?_⟩
  intro w₂ hw₂
  exact AQU matching
    (AJu matching U)
    w₂ w₁ hw₂ hw₁
end Erdos625
