  simp [Bm.typeTable]
def Bm.cellEdges
    {I J : Type*}
    [Fintype I] [Fintype J] [DecidableEq I] [DecidableEq J]
    {k : I -> Nat} {ell : J -> Nat}
    (S : Bm k ell) (i : I) (j : J) :
    Finset (Fin (k i) × Fin (ell j)) :=
  Finset.univ.filter
    (fun p => ((⟨i, p.1⟩, ⟨j, p.2⟩) :
      Cj k × Cm ell) ∈ S.edges)
def Bm.rowCell
    {I J : Type*}
    [Fintype I] [Fintype J] [DecidableEq I] [DecidableEq J]
    {k : I -> Nat} {ell : J -> Nat}
    (S : Bm k ell) (i : I) (j : J) :
    Finset (Fin (k i)) :=
  (S.cellEdges i j).image Prod.fst
def Bm.Lj
    {I J : Type*}
    [Fintype I] [Fintype J] [DecidableEq I] [DecidableEq J]
    {k : I -> Nat} {ell : J -> Nat}
    (S : Bm k ell) (i : I) (j : J) :
    Finset (Fin (ell j)) :=
  (S.cellEdges i j).image Prod.snd
private theorem A9H
    {I J : Type*}
    [Fintype I] [Fintype J] [DecidableEq I] [DecidableEq J]
    {k : I -> Nat} {ell : J -> Nat}
    (S : Bm k ell) (i : I) (j : J) :
    (S.cellEdges i j).card = S.typeTable i j := by
  unfold Bm.cellEdges
    Bm.typeTable
  refine Finset.card_bij
    (fun p _ =>
      ((⟨i, p.1⟩, ⟨j, p.2⟩) :
        Cj k × Cm ell)) ?_ ?_ ?_
  · intro p hp
    rw [Finset.mem_filter] at hp ⊢
    exact ⟨hp.2, rfl, rfl⟩
  · intro p₁ hp₁ p₂ hp₂ hEq
    exact Prod.ext
      (eq_of_heq (Sigma.mk.inj_iff.mp (congrArg Prod.fst hEq)).2)
      (eq_of_heq (Sigma.mk.inj_iff.mp (congrArg Prod.snd hEq)).2)
  · intro e he
    rw [Finset.mem_filter] at he
    obtain ⟨hEdge, hI, hJ⟩ := he
    obtain ⟨⟨i', r⟩, ⟨j', c⟩⟩ := e
    simp only at hI hJ
    subst i'
    subst j'
    exact ⟨(r, c), by simp [hEdge], rfl⟩
private theorem AlS
    {I J : Type*}
    [Fintype I] [Fintype J] [DecidableEq I] [DecidableEq J]
    {k : I -> Nat} {ell : J -> Nat}
    (S : Bm k ell) (i : I) (j : J) :
    (S.rowCell i j).card = S.typeTable i j := by
  rw [Bm.rowCell,
    Finset.card_image_of_injOn]
  · exact A9H S i j
  · intro p₁ hp₁ p₂ hp₂ OX
    have hEdge₁ :
        ((⟨i, p₁.1⟩, ⟨j, p₁.2⟩) :
          Cj k × Cm ell) ∈ S.edges := by
      simpa [Bm.cellEdges] using hp₁
    have hEdge₂ :
        ((⟨i, p₂.1⟩, ⟨j, p₂.2⟩) :
          Cj k × Cm ell) ∈ S.edges := by
      simpa [Bm.cellEdges] using hp₂
    have cw := S.leftUnique _ hEdge₁ _ hEdge₂ (by
      exact Sigma.ext rfl (heq_of_eq OX))
    exact Prod.ext OX
      (eq_of_heq (Sigma.mk.inj_iff.mp (congrArg Prod.snd cw)).2)
private theorem ALu
    {I J : Type*}
    [Fintype I] [Fintype J] [DecidableEq I] [DecidableEq J]
    {k : I -> Nat} {ell : J -> Nat}
    (S : Bm k ell) (i : I) (j : J) :
    (S.Lj i j).card = S.typeTable i j := by
  rw [Bm.Lj,
    Finset.card_image_of_injOn]
  · exact A9H S i j
  · intro p₁ hp₁ p₂ hp₂ NY
    have hEdge₁ :
        ((⟨i, p₁.1⟩, ⟨j, p₁.2⟩) :
          Cj k × Cm ell) ∈ S.edges := by
      simpa [Bm.cellEdges] using hp₁
    have hEdge₂ :
        ((⟨i, p₂.1⟩, ⟨j, p₂.2⟩) :
          Cj k × Cm ell) ∈ S.edges := by
      simpa [Bm.cellEdges] using hp₂
    have cw := S.QN _ hEdge₁ _ hEdge₂ (by
      exact Sigma.ext rfl (heq_of_eq NY))
    exact Prod.ext
      (eq_of_heq (Sigma.mk.inj_iff.mp (congrArg Prod.fst cw)).2)
      NY
private theorem AlT
    {I J : Type*}
    [Fintype I] [Fintype J] [DecidableEq I] [DecidableEq J]
    {k : I -> Nat} {ell : J -> Nat}
    (S : Bm k ell) (i : I)
    (j₁ j₂ : J) (hNe : j₁ ≠ j₂) :
    Disjoint (S.rowCell i j₁) (S.rowCell i j₂) := by
  rw [Finset.disjoint_left]
  intro r hr₁ hr₂
  rw [Bm.rowCell, Finset.mem_image] at hr₁ hr₂
  obtain ⟨p₁, hp₁, hFirst₁⟩ := hr₁
  obtain ⟨p₂, hp₂, hFirst₂⟩ := hr₂
  have hEdge₁ :
      ((⟨i, p₁.1⟩, ⟨j₁, p₁.2⟩) :
        Cj k × Cm ell) ∈ S.edges := by
    simpa [Bm.cellEdges] using hp₁
  have hEdge₂ :
      ((⟨i, p₂.1⟩, ⟨j₂, p₂.2⟩) :
        Cj k × Cm ell) ∈ S.edges := by
    simpa [Bm.cellEdges] using hp₂
  have hLeft : (⟨i, p₁.1⟩ : Cj k) = ⟨i, p₂.1⟩ := by
    exact Sigma.ext rfl (heq_of_eq (hFirst₁.trans hFirst₂.symm))
  have RY := S.leftUnique _ hEdge₁ _ hEdge₂ hLeft
  exact hNe (congrArg (fun e => e.2.1) RY)
private theorem ALv
    {I J : Type*}
    [Fintype I] [Fintype J] [DecidableEq I] [DecidableEq J]
    {k : I -> Nat} {ell : J -> Nat}
    (S : Bm k ell) (j : J)
    (i₁ i₂ : I) (hNe : i₁ ≠ i₂) :
    Disjoint (S.Lj i₁ j) (S.Lj i₂ j) := by
  rw [Finset.disjoint_left]
  intro c hc₁ hc₂
  rw [Bm.Lj, Finset.mem_image] at hc₁ hc₂
  obtain ⟨p₁, hp₁, hSecond₁⟩ := hc₁
  obtain ⟨p₂, hp₂, hSecond₂⟩ := hc₂
  have hEdge₁ :
      ((⟨i₁, p₁.1⟩, ⟨j, p₁.2⟩) :
        Cj k × Cm ell) ∈ S.edges := by
    simpa [Bm.cellEdges] using hp₁
  have hEdge₂ :
      ((⟨i₂, p₂.1⟩, ⟨j, p₂.2⟩) :
        Cj k × Cm ell) ∈ S.edges := by
    simpa [Bm.cellEdges] using hp₂
  have WX : (⟨j, p₁.2⟩ : Cm ell) = ⟨j, p₂.2⟩ := by
    exact Sigma.ext rfl (heq_of_eq (hSecond₁.trans hSecond₂.symm))
  have RY := S.QN _ hEdge₁ _ hEdge₂ WX
  exact hNe (congrArg (fun e => e.1.1) RY)
private def Amg
    {I J : Type*}
    [Fintype I] [Fintype J] [DecidableEq I] [DecidableEq J]
    {L : I -> J -> Nat} {k : I -> Nat} {ell : J -> Nat}
    (S : Bm k ell) (V6 : S.typeTable = L)
    (i : I) :
    JZ (k i) (L i) :=
  ⟨S.rowCell i, by
    constructor
    · intro j
      rw [AlS]
      exact congrFun (congrFun V6 i) j
    · intro j₁ j₂ hNe
      exact AlT S i j₁ j₂ hNe⟩
private def Amf
    {I J : Type*}
    [Fintype I] [Fintype J] [DecidableEq I] [DecidableEq J]
    {L : I -> J -> Nat} {k : I -> Nat} {ell : J -> Nat}
    (S : Bm k ell) (V6 : S.typeTable = L)
    (j : J) :
    JZ (ell j) (fun i => L i j) :=
  ⟨fun i => S.Lj i j, by
    constructor
    · intro i
      rw [ALu]
      exact congrFun (congrFun V6 i) j
    · intro i₁ i₂ hNe
      exact ALv S j i₁ i₂ hNe⟩
private noncomputable def MQ
    {I J : Type*}
    [Fintype I] [Fintype J] [DecidableEq I] [DecidableEq J]
    {k : I -> Nat} {ell : J -> Nat}
    (S : Bm k ell) (i : I) (j : J)
    (r : ↑(S.rowCell i j)) :
    Fin (k i) × Fin (ell j) :=
  Classical.choose (Finset.mem_image.mp r.2)
private theorem kS
    {I J : Type*}
    [Fintype I] [Fintype J] [DecidableEq I] [DecidableEq J]
    {k : I -> Nat} {ell : J -> Nat}
    (S : Bm k ell) (i : I) (j : J)
    (r : ↑(S.rowCell i j)) :
    MQ S i j r ∈ S.cellEdges i j :=
  (Classical.choose_spec (Finset.mem_image.mp r.2)).1
private theorem sw
    {I J : Type*}
    [Fintype I] [Fintype J] [DecidableEq I] [DecidableEq J]
    {k : I -> Nat} {ell : J -> Nat}
    (S : Bm k ell) (i : I) (j : J)
    (r : ↑(S.rowCell i j)) :
    (MQ S i j r).1 = r.1 :=
  (Classical.choose_spec (Finset.mem_image.mp r.2)).2
private noncomputable def AGz
    {I J : Type*}
    [Fintype I] [Fintype J] [DecidableEq I] [DecidableEq J]
    {k : I -> Nat} {ell : J -> Nat}
    (S : Bm k ell) (i : I) (j : J) :
    ↑(S.rowCell i j) ≃ ↑(S.Lj i j) := by
  let toColumn :
      ↑(S.rowCell i j) -> ↑(S.Lj i j) :=
    fun r =>
      ⟨(MQ S i j r).2,
        Finset.mem_image.mpr
          ⟨MQ S i j r,
            kS S i j r, rfl⟩⟩
  refine Equiv.ofBijective toColumn ⟨?_, ?_⟩
  · intro r₁ r₂ Pz
    have hEdge₁ :
        ((⟨i, (MQ S i j r₁).1⟩,
            ⟨j, (MQ S i j r₁).2⟩) :
          Cj k × Cm ell) ∈ S.edges := by
      simpa [Bm.cellEdges] using
        kS S i j r₁
    have hEdge₂ :
        ((⟨i, (MQ S i j r₂).1⟩,
            ⟨j, (MQ S i j r₂).2⟩) :
          Cj k × Cm ell) ∈ S.edges := by
      simpa [Bm.cellEdges] using
        kS S i j r₂
    have NY :
        (MQ S i j r₁).2 =
          (MQ S i j r₂).2 :=
      congrArg Subtype.val Pz
    have cw := S.QN _ hEdge₁ _ hEdge₂ (by
      exact Sigma.ext rfl (heq_of_eq NY))
    apply Subtype.ext
    rw [← sw S i j r₁,
      ← sw S i j r₂]
    exact eq_of_heq
      (Sigma.mk.inj_iff.mp (congrArg Prod.fst cw)).2
  · intro c
    have hc := c.2
    change c.1 ∈ (S.cellEdges i j).image Prod.snd at hc
    rw [Finset.mem_image] at hc
    obtain ⟨p, hp, NY⟩ := hc
    let r : ↑(S.rowCell i j) :=
      ⟨p.1, Finset.mem_image.mpr ⟨p, hp, rfl⟩⟩
