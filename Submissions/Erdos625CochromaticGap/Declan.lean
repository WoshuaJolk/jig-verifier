    obtain ⟨x, hx⟩ := hc
    obtain ⟨y, hy⟩ := hc'
    change Yp a b x = c at hx
    change Yp a' b y = c at hy
    have AbK : matching ⟨a, x.1⟩ = ⟨b, c⟩ := by
      calc
        matching ⟨a, x.1⟩ = ⟨b, Yp a b x⟩ :=
          sP _ (UC a b x)
        _ = ⟨b, c⟩ := by rw [hx]
    have AbL : matching ⟨a', y.1⟩ = ⟨b, c⟩ := by
      calc
        matching ⟨a', y.1⟩ = ⟨b, Yp a' b y⟩ :=
          sP _ (UC a' b y)
        _ = ⟨b, c⟩ := by rw [hy]
