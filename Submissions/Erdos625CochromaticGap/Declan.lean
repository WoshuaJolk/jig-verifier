    ∀ e₁ ∈ edges, ∀ e₂ ∈ edges, e₁.1 = e₂.1 -> e₁ = e₂
  QN :
    ∀ e₁ ∈ edges, ∀ e₂ ∈ edges, e₁.2 = e₂.2 -> e₁ = e₂
@[ext]
theorem Bm.ext
    {I J : Type*}
    [Fintype I] [Fintype J] [DecidableEq I] [DecidableEq J]
    {k : I -> Nat} {ell : J -> Nat}
    {S T : Bm k ell}
    (RY : S.edges = T.edges) :
    S = T := by
  cases S
  cases T
  simp_all
noncomputable instance AvI
    {I J : Type*}
    [Fintype I] [Fintype J] [DecidableEq I] [DecidableEq J]
    (k : I -> Nat) (ell : J -> Nat) :
    Fintype (Bm k ell) := by
  letI : Finite (Bm k ell) :=
    Finite.of_injective
      (fun S : Bm k ell => S.edges)
      (fun _ _ h => Bm.ext h)
  exact Fintype.ofFinite _
def Bm.typeTable
    {I J : Type*}
    [Fintype I] [Fintype J] [DecidableEq I] [DecidableEq J]
    {k : I -> Nat} {ell : J -> Nat}
    (S : Bm k ell) (i : I) (j : J) : Nat :=
  (S.edges.filter (fun e => e.1.1 = i ∧ e.2.1 = j)).card
theorem Bm.typeTable_ne_zero_iff_exists_physical_edge
    {A B : Type*}
