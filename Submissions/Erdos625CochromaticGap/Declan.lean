noncomputable section
def Oj (C : ℝ) (n : ℕ) :
    Set (LabeledGraph n) :=
  {G | ∀ U : Finset (Fin n),
    (chromaticNumberNat (G.induce (U : Set (Fin n))) : ℝ) ≤
      C * (U.card : ℝ) / Real.log (n : ℝ) +
        (n : ℝ) ^ (1 / 3 : ℝ)}
theorem ALR
    {n : ℕ} (G : LabeledGraph n) (U : Finset (Fin n)) :
    chromaticNumberNat (G.induce (U : Set (Fin n))) ≤ U.card := by
  classical
  have A2y :
      (G.induce (U : Set (Fin n))).Colorable U.card := by
    simpa using (G.induce (U : Set (Fin n))).colorable_of_fintype
  exact Nat.cast_le.mp
    (le_trans
      (ENat.toNat_le_toNat
        (SimpleGraph.chromaticNumber_le_iff_colorable.mpr A2y)
        (by simp +decide))
      (by simp +decide))
theorem ALT
    (n : ℕ) (G : LabeledGraph n)
    (hG : G ∈ OD n)
    (FU : 1 ≤ GW n) :
    ∀ U : Finset (Fin n),
      chromaticNumberNat (G.induce (U : Set (Fin n))) ≤
        Ze n U.card := by
  intro U
  by_cases DH : U.card < Ip n
  · rw [Ze, if_pos DH]
    exact ALR G U
  · rw [Ze, if_neg DH]
    exact
      ALS
        n G hG FU U
theorem Ak6
    (n : ℕ) (C : ℝ) (FU : 1 ≤ GW n)
    (hCost : ∀ u : ℕ, u ≤ n →
      (Ze n u : ℝ) ≤
        C * (u : ℝ) / Real.log (n : ℝ) +
          (n : ℝ) ^ (1 / 3 : ℝ)) :
    OD n ⊆
      Oj C n := by
  intro G hG U
  have hUle : U.card ≤ n := by
    simpa using Finset.card_le_univ U
  have hNat :=
    ALT
      n G hG FU U
  have hReal :
      (chromaticNumberNat (G.induce (U : Set (Fin n))) : ℝ) ≤
        (Ze n U.card : ℝ) := by
    exact_mod_cast hNat
  exact hReal.trans (hCost U.card hUle)
theorem
    A2Q :
    ∃ C : ℝ, 0 < C ∧
      ∀ᶠ n : ℕ in atTop,
        OD n ⊆
          Oj C n := by
  obtain ⟨C, hC, hCost⟩ :=
    Ak5
  refine ⟨C, hC, ?_⟩
  filter_upwards [AF4, hCost]
    with n FU ASv
  exact
    Ak6
      n C FU ASv
theorem AGC
    (C : ℝ)
    (PL : ∀ᶠ n : ℕ in atTop,
      OD n ⊆
        Oj C n) :
    Tendsto
      (fun n ↦ randomGraphMeasure n (Oj C n))
      atTop (nhds 1) := by
  exact tendsto_of_tendsto_of_tendsto_of_le_of_le'
    AGA
    tendsto_const_nhds
    (PL.mono fun n hn ↦ measure_mono hn)
    (Filter.Eventually.of_forall fun n ↦ by
      calc
        randomGraphMeasure n (Oj C n) ≤
            randomGraphMeasure n Set.univ :=
          measure_mono (Set.subset_univ _)
        _ = 1 := measure_univ)
theorem Arf :
    ∃ C : ℝ, 0 < C ∧
      Tendsto
        (fun n ↦ randomGraphMeasure n (Oj C n))
        atTop (nhds 1) := by
  obtain ⟨C, hC, PL⟩ :=
    A2Q
  exact
    ⟨C, hC,
      AGC
        C PL⟩
theorem AGB
    (C : ℝ)
    (PL : ∀ᶠ n : ℕ in atTop,
      OD n ⊆
        Oj C n) :
    ∀ᶠ n : ℕ in atTop,
      (randomGraphMeasure n).real
          (Oj C n)ᶜ ≤
        Zi n := by
  filter_upwards [PL] with n hn
  unfold Zi
  apply measureReal_mono (h₂ := by finiteness)
  exact Set.compl_subset_compl.mpr hn
theorem Ard :
    ∃ C : ℝ, 0 < C ∧
      (∀ᶠ n : ℕ in atTop,
        OD n ⊆
          Oj C n) ∧
      Tendsto
        (fun n ↦ randomGraphMeasure n (Oj C n))
        atTop (nhds 1) ∧
      (∀ᶠ n : ℕ in atTop,
        (randomGraphMeasure n).real
            (Oj C n)ᶜ ≤
          Zi n) := by
  obtain ⟨C, hC, PL⟩ :=
    A2Q
  refine ⟨C, hC, PL, ?_, ?_⟩
  · exact
      AGC
        C PL
  · exact
      AGB
        C PL
end
end Erdos625
