theorem AI9
    {D : Type*} {X : D -> Type*}
    [Fintype D] [(d : D) -> Fintype (X d)]
    [Nonempty (Sigma X)]
    (d : D) :
    ((PMF.uniformOfFintype (Sigma X)).map
        (fun z : Sigma X => z.1)) d =
      (Fintype.card (X d) : ENNReal) /
        (Fintype.card (Sigma X) : ENNReal) := by
