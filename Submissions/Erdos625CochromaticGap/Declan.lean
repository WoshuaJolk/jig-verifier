section M016
namespace Erdos625
open scoped BigOperators
private def AGk
    {I : Type*} {f : I → Type*}
    (z : Σ i, f i) {i : I} (h : z.1 = i) : f i :=
  h ▸ z.2
private theorem sP
    {I : Type*} {f : I → Type*}
    (z : Σ i, f i) {i : I} (h : z.1 = i) :
    z = ⟨i, AGk z h⟩ := by
  cases z with
  | mk j x =>
      simp only at h
      subst i
      rfl
abbrev Cj {A : Type*} [Fintype A] (row : A → ℕ) :=
  Σ a, Fin (row a)
abbrev Cm {B : Type*} [Fintype B] (col : B → ℕ) :=
  Σ b, Fin (col b)
abbrev BZ
    {A B : Type*} [Fintype A] [Fintype B]
    (row : A → ℕ) (col : B → ℕ) :=
  Cj row ≃ Cm col
noncomputable instance Auy
    {A B : Type*} [Fintype A] [Fintype B]
    [DecidableEq A] [DecidableEq B]
    (row : A → ℕ) (col : B → ℕ) :
    Fintype (BZ row col) := by
  unfold BZ
  infer_instance
theorem XK
    {A : Type*} [Fintype A] (row : A → ℕ) :
    Fintype.card (Cj row) = Finset.univ.sum row := by
  rw [Fintype.card_sigma]
  apply Finset.sum_congr rfl
  intro a _
  rw [Fintype.card_fin]
theorem j7
    {B : Type*} [Fintype B] (col : B → ℕ) :
    Fintype.card (Cm col) = Finset.univ.sum col := by
  rw [Fintype.card_sigma]
  apply Finset.sum_congr rfl
  intro b _
  rw [Fintype.card_fin]
theorem vI
    {A B : Type*}
    [Fintype A] [Fintype B] [DecidableEq A] [DecidableEq B]
    (row : A → ℕ) (col : B → ℕ)
    (B9 : Finset.univ.sum row = Finset.univ.sum col) :
    Fintype.card (BZ row col) =
      (Finset.univ.sum row).factorial := by
  let e : Cj row ≃ Cm col :=
    Fintype.equivOfCardEq (by
      rw [XK, j7, B9])
  calc
    Fintype.card (BZ row col) =
        (Fintype.card (Cj row)).factorial :=
      Fintype.card_equiv e
    _ = (Finset.univ.sum row).factorial := by rw [XK]
abbrev RJ
    {A B : Type*}
    [Fintype A] [Fintype B] [DecidableEq A] [DecidableEq B]
    {demand : A → B → ℕ} {row : A → ℕ} {col : B → ℕ}
    (witness : BW demand row col) :=
  Σ a, Σ b, ↑((witness.1 a).1 b)
abbrev uY
    {A B : Type*}
    [Fintype A] [Fintype B] [DecidableEq A] [DecidableEq B]
    {demand : A → B → ℕ} {row : A → ℕ} {col : B → ℕ}
    (witness : BW demand row col) :=
  Σ a, Σ b, ↑((witness.2.1 b).1 a)
noncomputable def A8L
    {A B : Type*}
    [Fintype A] [Fintype B] [DecidableEq A] [DecidableEq B]
    {demand : A → B → ℕ} {row : A → ℕ} {col : B → ℕ}
    (witness : BW demand row col) :
    RJ witness ≃ uY witness where
  toFun atom :=
    ⟨atom.1, atom.2.1, witness.2.2 atom.1 atom.2.1 atom.2.2⟩
  invFun atom :=
    ⟨atom.1, atom.2.1, (witness.2.2 atom.1 atom.2.1).symm atom.2.2⟩
  left_inv atom := by
    obtain ⟨a, b, stub⟩ := atom
    simp
  right_inv atom := by
    obtain ⟨a, b, stub⟩ := atom
    simp
def Yc
    {A B : Type*}
    [Fintype A] [Fintype B] [DecidableEq A] [DecidableEq B]
    {demand : A → B → ℕ} {row : A → ℕ} {col : B → ℕ}
    (witness : BW demand row col) :
    RJ witness ↪ Cj row where
  toFun atom := ⟨atom.1, atom.2.2.1⟩
  inj' := by
    rintro ⟨a, b, stub⟩ ⟨a', b', stub'⟩ h
    have ha : a = a' := (Sigma.mk.inj_iff.mp h).1
    subst a'
    have hstub : (stub : Fin (row a)) = stub' :=
      eq_of_heq (Sigma.mk.inj_iff.mp h).2
    by_cases hbb : b = b'
    · subst b'
      exact Sigma.ext rfl <| heq_of_eq <|
        Sigma.ext rfl <| heq_of_eq <| Subtype.ext hstub
    · have hdisjoint := (witness.1 a).2.2 b b' hbb
      have hmem : (stub : Fin (row a)) ∈ (witness.1 a).1 b' := by
        rw [hstub]
        exact stub'.2
      exact False.elim <|
        (Finset.disjoint_left.mp hdisjoint) stub.2 hmem
def AIK
    {A B : Type*}
    [Fintype A] [Fintype B] [DecidableEq A] [DecidableEq B]
    {demand : A → B → ℕ} {row : A → ℕ} {col : B → ℕ}
    (witness : BW demand row col) :
    uY witness ↪ Cm col where
  toFun atom := ⟨atom.2.1, atom.2.2.1⟩
  inj' := by
    rintro ⟨a, b, stub⟩ ⟨a', b', stub'⟩ h
    have hb : b = b' := (Sigma.mk.inj_iff.mp h).1
    subst b'
    have hstub : (stub : Fin (col b)) = stub' :=
      eq_of_heq (Sigma.mk.inj_iff.mp h).2
    by_cases haa : a = a'
    · subst a'
      exact Sigma.ext rfl <| heq_of_eq <|
        Sigma.ext rfl <| heq_of_eq <| Subtype.ext hstub
    · have hdisjoint := (witness.2.1 b).2.2 a a' haa
      have hmem : (stub : Fin (col b)) ∈ (witness.2.1 b).1 a' := by
        rw [hstub]
        exact stub'.2
      exact False.elim <|
        (Finset.disjoint_left.mp hdisjoint) stub.2 hmem
theorem lN
    {A B : Type*}
    [Fintype A] [Fintype B] [DecidableEq A] [DecidableEq B]
    {demand : A → B → ℕ} {row : A → ℕ} {col : B → ℕ}
    (witness : BW demand row col) :
    Fintype.card (RJ witness) =
      Finset.univ.sum (fun a ↦ Finset.univ.sum (demand a)) := by
  rw [Fintype.card_sigma]
  apply Finset.sum_congr rfl
  intro a _
  rw [Fintype.card_sigma]
  apply Finset.sum_congr rfl
  intro b _
  rw [Fintype.card_coe, (witness.1 a).2.1 b]
theorem Aqq
    {A B : Type*}
    [Fintype A] [Fintype B] [DecidableEq A] [DecidableEq B]
    {demand : A → B → ℕ} {row : A → ℕ} {col : B → ℕ}
    (witness : BW demand row col) :
    Fintype.card (uY witness) =
      Finset.univ.sum (fun a ↦ Finset.univ.sum (demand a)) := by
