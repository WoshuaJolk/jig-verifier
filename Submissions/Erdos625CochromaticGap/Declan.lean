      rw [← hqr]
      exact (F8 e).mem_part (Finset.mem_univ _)
    have hindex :=
      (r8 e
        (Pd e r) (Pd e q)).mp hmem
    simpa using hindex.symm
  · intro B
    obtain ⟨v, hv⟩ := (F8 e).nonempty_of_mem_parts B.2
    let q := Rw e v
    refine ⟨q, Subtype.ext ?_⟩
