section M049
namespace Erdos625
open scoped BigOperators
noncomputable section
set_option autoImplicit false
abbrev CZ (alpha : Nat) (A8 : 5 < alpha)
    (k : AG (alpha + 1)) :=
  ∀ i : Fin 4, Fin (Bz alpha A8 k i) ≃
    ↥(GR alpha A8 k i)
noncomputable def AJz (alpha : Nat)
    (A8 : 5 < alpha) (k : AG (alpha + 1)) :
    CZ alpha A8 k := fun i =>
  Fintype.equivOfCardEq (by
    simpa only [Fintype.card_fin, Fintype.card_coe] using
      ((c7 alpha A8 k).2.1 i).symm)
def Bc (alpha : Nat) (A8 : 5 < alpha)
    (k : AG (alpha + 1))
    (AN : CZ alpha A8 k)
    (a : Σ i : Fin 4, Fin (Bz alpha A8 k i)) :
    Bl k :=
  (AN a.1 a.2).1
abbrev u7 (alpha : Nat) (A8 : 5 < alpha)
    (k : AG (alpha + 1)) (L : Bh)
    (P : Ej alpha A8 k L) (e : ↥P.1.edges) :=
  Zt
    (BK alpha A8 e.1.1.1)
    (BK alpha A8 e.1.2.1)
    (BL alpha A8 e.1.1.1 e.1.2.1)
abbrev J9 (alpha : Nat) (A8 : 5 < alpha)
    (k : AG (alpha + 1)) (L : Bh) :=
  Σ P : Ej alpha A8 k L,
    ∀ e : ↥P.1.edges,
      u7 alpha A8 k L P e
def Qg (alpha : Nat) (A8 : 5 < alpha)
    (L : Bh) : Nat :=
  ∏ i : Fin 4, ∏ j : Fin 4,
    (BL alpha A8 i j).factorial ^ L.toFun i j
def WD (alpha : Nat) (A8 : 5 < alpha)
    (L : Bh) : Nat :=
  ∏ i : Fin 4, ∏ j : Fin 4,
    (((BK alpha A8 i).descFactorial
        (BL alpha A8 i j)) *
      ((BK alpha A8 j).descFactorial
        (BL alpha A8 i j))) ^ L.toFun i j
theorem AKR
    (alpha : Nat) (A8 : 5 < alpha)
    (k : AG (alpha + 1)) (L : Bh) :
    Fintype.card (J9 alpha A8 k L) *
        Qg alpha A8 L =
      Fintype.card (Ej alpha A8 k L) *
        WD alpha A8 L := by
  let fac : Fin 4 → Fin 4 → Nat := fun i j =>
    (BL alpha A8 i j).factorial
  let sel : Fin 4 → Fin 4 → Nat := fun i j =>
    (BK alpha A8 i).descFactorial
        (BL alpha A8 i j) *
      (BK alpha A8 j).descFactorial
        (BL alpha A8 i j)
  have ADF (P : Ej alpha A8 k L)
      (f : Fin 4 → Fin 4 → Nat) :
      (∏ e ∈ P.1.edges, f e.1.1 e.2.1) =
        ∏ i : Fin 4, ∏ j : Fin 4, (f i j) ^ L.toFun i j := by
    rw [← Finset.prod_fiberwise' P.1.edges
      (fun e => (e.1.1, e.2.1))
      (fun ij : Fin 4 × Fin 4 => f ij.1 ij.2)]
    rw [Fintype.prod_prod_type]
    apply Finset.prod_congr rfl
    intro i hi
    apply Finset.prod_congr rfl
    intro j hj
    rw [Finset.prod_const]
    apply congrArg (fun n => (f i j) ^ n)
    calc
      _ = (P.1.edges.filter
          (fun e => e.1.1 = i ∧ e.2.1 = j)).card := by
        congr 1
        ext e
        simp [Prod.ext_iff]
      _ = P.1.typeTable i j := rfl
      _ = L.toFun i j := congrFun (congrFun P.2 i) j
  have zP (P : Ej alpha A8 k L) :
      Fintype.card (∀ e : ↥P.1.edges,
          u7 alpha A8 k L P e) *
          Qg alpha A8 L =
        WD alpha A8 L := by
    rw [Fintype.card_pi]
    rw [← Finset.prod_subtype P.1.edges (fun _ => Iff.rfl)
      (fun e => Fintype.card (Zt
        (BK alpha A8 e.1.1)
        (BK alpha A8 e.2.1)
        (BL alpha A8 e.1.1 e.2.1)))]
    unfold Qg
      WD
    rw [← ADF P fac, ← ADF P sel]
    rw [← Finset.prod_mul_distrib]
    apply Finset.prod_congr rfl
    intro e he
    exact A1e _ _ _
  rw [Fintype.card_sigma]
  simp_rw [Finset.sum_mul, zP]
  simp
end
end Erdos625
