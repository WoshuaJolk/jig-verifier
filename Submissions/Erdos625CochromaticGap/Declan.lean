open scoped BigOperators ENNReal
noncomputable section
set_option autoImplicit false
abbrev Rz
    {A B : Type*}
    [Fintype A] [Fintype B] [DecidableEq A] [DecidableEq B]
    (demand : A → B → Nat) (row : A → Nat) (col : B → Nat) :=
  ∀ e : ↥(Bn demand),
    Zt (row e.1.1) (col e.1.2)
      (demand e.1.1 e.1.2)
def T8
    {A B : Type*}
    [Fintype A] [Fintype B] [DecidableEq A] [DecidableEq B]
    {demand : A → B → Nat} {row : A → Nat} {col : B → Nat}
    (e : ↥(Bn demand))
    (p : Cj (fun _ : Unit => row e.1.1) ×
      Cm (fun _ : Unit => col e.1.2)) :
    Cj row × Cm col :=
  (⟨e.1.1, p.1.2⟩, ⟨e.1.2, p.2.2⟩)
theorem A6c
    {A B : Type*}
    [Fintype A] [Fintype B] [DecidableEq A] [DecidableEq B]
    {demand : A → B → Nat} {row : A → Nat} {col : B → Nat}
    (e : ↥(Bn demand)) :
    Function.Injective
      (T8
        (demand := demand) (row := row) (col := col) e) := by
  intro p q hpq
  apply Prod.ext
  · apply Sigma.ext (x := p.1) (y := q.1) rfl
    apply heq_of_eq
    apply Fin.ext
    simpa only [T8] using
      congrArg (fun z => z.1.2.val) hpq
  · apply Sigma.ext (x := p.2) (y := q.2) rfl
    apply heq_of_eq
    apply Fin.ext
    simpa only [T8] using
      congrArg (fun z => z.2.2.val) hpq
def ZQ
    {A B : Type*}
    [Fintype A] [Fintype B] [DecidableEq A] [DecidableEq B]
    {demand : A → B → Nat} {row : A → Nat} {col : B → Nat}
    (D : Rz demand row col) :
    Finset (Cj row × Cm col) :=
  (Bn demand).attach.biUnion fun e =>
    (D e).1.edges.image fun p => T8 e p
def T7
    {A B : Type*}
    [Fintype A] [Fintype B] [DecidableEq A] [DecidableEq B]
    {demand : A → B → Nat} {row : A → Nat} {col : B → Nat}
    (Cv : DZ (Bn demand))
    (D : Rz demand row col) :
    Bm row col where
  edges := ZQ D
  leftUnique := by
    intro x hx y hy hxy
    simp only [ZQ, Finset.mem_biUnion,
      Finset.mem_attach, true_and, Finset.mem_image] at hx hy
    obtain ⟨ex, px, hpx, rfl⟩ := hx
    obtain ⟨ey, py, hpy, rfl⟩ := hy
    have ha : ex.1.1 = ey.1.1 := (Sigma.mk.inj_iff.mp hxy).1
    have hb : ex.1.2 = ey.1.2 :=
      Cv.1 ex.1.1 ex.1.2 ey.1.2 ex.2 (by
        rw [ha]
        exact ey.2)
    have he : ex = ey := Subtype.ext (Prod.ext ha hb)
    subst ey
    have hpl : px.1 = py.1 := by
      apply Sigma.ext (x := px.1) (y := py.1) rfl
      exact (Sigma.mk.inj_iff.mp hxy).2
    have hp : px = py := (D ex).1.leftUnique px hpx py hpy hpl
    subst py
    rfl
  QN := by
    intro x hx y hy hxy
    simp only [ZQ, Finset.mem_biUnion,
      Finset.mem_attach, true_and, Finset.mem_image] at hx hy
    obtain ⟨ex, px, hpx, rfl⟩ := hx
    obtain ⟨ey, py, hpy, rfl⟩ := hy
    have hb : ex.1.2 = ey.1.2 := (Sigma.mk.inj_iff.mp hxy).1
    have ha : ex.1.1 = ey.1.1 :=
      Cv.2 ex.1.2 ex.1.1 ey.1.1 ex.2 (by
        rw [hb]
        exact ey.2)
    have he : ex = ey := Subtype.ext (Prod.ext ha hb)
    subst ey
    have hpr : px.2 = py.2 := by
      apply Sigma.ext (x := px.2) (y := py.2) rfl
      exact (Sigma.mk.inj_iff.mp hxy).2
    have hp : px = py := (D ex).1.QN px hpx py hpy hpr
    subst py
    rfl
theorem A6b
    {A B : Type*}
    [Fintype A] [Fintype B] [DecidableEq A] [DecidableEq B]
    {demand : A → B → Nat} {row : A → Nat} {col : B → Nat}
    (Cv : DZ (Bn demand))
    (D : Rz demand row col)
    (e : ↥(Bn demand)) :
    (T7 Cv D).edges.filter
        (fun z => z.1.1 = e.1.1 ∧ z.2.1 = e.1.2) =
      (D e).1.edges.image fun p => T8 e p := by
  ext z
  constructor
  · intro hz
    rw [Finset.mem_filter] at hz
    rcases hz with ⟨hz, hztype⟩
    simp only [T7,
      ZQ, Finset.mem_biUnion,
      Finset.mem_attach, true_and, Finset.mem_image] at hz
    obtain ⟨e', p, hp, rfl⟩ := hz
    have he : e' = e := Subtype.ext (Prod.ext hztype.1 hztype.2)
    subst e'
    exact Finset.mem_image.mpr ⟨p, hp, rfl⟩
  · intro hz
    rw [Finset.mem_image] at hz
    obtain ⟨p, hp, rfl⟩ := hz
    rw [Finset.mem_filter]
    constructor
    · simp only [T7,
        ZQ, Finset.mem_biUnion,
        Finset.mem_attach, true_and]
      exact ⟨e, Finset.mem_image.mpr ⟨p, hp, rfl⟩⟩
    · simp [T8]
theorem Afd
    {A B : Type*}
    [Fintype A] [Fintype B] [DecidableEq A] [DecidableEq B]
    {demand : A → B → Nat} {row : A → Nat} {col : B → Nat}
    (Cv : DZ (Bn demand))
    (D : Rz demand row col)
    (e : ↥(Bn demand)) :
    (T7 Cv D).typeTable
        e.1.1 e.1.2 = demand e.1.1 e.1.2 := by
  unfold Bm.typeTable
  rw [A6b Cv D e]
  rw [Finset.card_image_of_injective]
  · simpa [Bm.typeTable] using (D e).2
  · exact A6c e
theorem Afe
    {A B : Type*}
    [Fintype A] [Fintype B] [DecidableEq A] [DecidableEq B]
    {demand : A → B → Nat} {row : A → Nat} {col : B → Nat}
    (Cv : DZ (Bn demand))
    (D : Rz demand row col)
    (a : A) (b : B) (hzero : demand a b = 0) :
    (T7 Cv D).typeTable a b = 0 := by
  unfold Bm.typeTable
  have hfilter :
      (T7 Cv D).edges.filter
          (fun z => z.1.1 = a ∧ z.2.1 = b) = ∅ := by
    ext z
    constructor
    · intro hz
      rw [Finset.mem_filter] at hz
      rcases hz with ⟨hz, ha, hb⟩
      simp only [T7,
        ZQ, Finset.mem_biUnion,
        Finset.mem_attach, true_and, Finset.mem_image] at hz
      obtain ⟨e, p, hp, hzp⟩ := hz
      have hea : e.1.1 = a :=
        (congrArg (fun x => x.1.1) hzp).trans ha
      have heb : e.1.2 = b :=
        (congrArg (fun x => x.2.1) hzp).trans hb
      have hepos : demand e.1.1 e.1.2 ≠ 0 := by
        simpa only [Bn, Finset.mem_filter,
          Finset.mem_univ, true_and] using e.2
      have habpos : demand a b ≠ 0 := by
        simpa [hea, heb] using hepos
      exact (habpos hzero).elim
    · simp
  rw [hfilter]
  simp
theorem Afc
    {A B : Type*}
    [Fintype A] [Fintype B] [DecidableEq A] [DecidableEq B]
    {demand : A → B → Nat} {row : A → Nat} {col : B → Nat}
    (Cv : DZ (Bn demand))
    (D : Rz demand row col) :
    (T7 Cv D).typeTable = demand := by
  funext a b
  by_cases hzero : demand a b = 0
  · simpa [hzero] using
      Afe
        Cv D a b hzero
  · let e : ↥(Bn demand) :=
      ⟨(a, b), by simp [Bn, hzero]⟩
    simpa [e] using
      Afd Cv D e
def g4
    {A B : Type*}
    [Fintype A] [Fintype B] [DecidableEq A] [DecidableEq B]
    (demand : A → B → Nat) (row : A → Nat) (col : B → Nat)
    (Cv : DZ (Bn demand)) :
    Rz demand row col →
      {S : Bm row col // S.typeTable = demand} := fun D =>
  ⟨T7 Cv D,
    Afc Cv D⟩
theorem AfX
    {A B : Type*}
    [Fintype A] [Fintype B] [DecidableEq A] [DecidableEq B]
    (demand : A → B → Nat) (row : A → Nat) (col : B → Nat)
    (Cv : DZ (Bn demand)) :
    Function.Injective
      (g4 demand row col Cv) := by
  intro D₁ D₂ A3y
  have Q7 :
      T7 Cv D₁ =
        T7 Cv D₂ :=
    congrArg Subtype.val A3y
  funext e
  have WS :
      (D₁ e).1.edges.image (fun p => T8 e p) =
        (D₂ e).1.edges.image (fun p => T8 e p) := by
    rw [← A6b
      Cv D₁ e]
    rw [← A6b
      Cv D₂ e]
    rw [Q7]
  have A3a : (D₁ e).1.edges = (D₂ e).1.edges := by
    ext p
    constructor
    · intro hp
      have VE : T8 e p ∈
          (D₁ e).1.edges.image (fun q =>
            T8 e q) :=
        Finset.mem_image.mpr ⟨p, hp, rfl⟩
      rw [WS] at VE
      obtain ⟨q, hq, hpq⟩ := Finset.mem_image.mp VE
      have hpq' : p = q :=
        A6c e hpq.symm
      simpa [hpq'] using hq
    · intro hp
      have VE : T8 e p ∈
          (D₂ e).1.edges.image (fun q =>
            T8 e q) :=
        Finset.mem_image.mpr ⟨p, hp, rfl⟩
      rw [← WS] at VE
      obtain ⟨q, hq, hpq⟩ := Finset.mem_image.mp VE
      have hpq' : p = q :=
        A6c e hpq.symm
      simpa [hpq'] using hq
  exact Subtype.ext (Bm.ext A3a)
def g5
    {A B : Type*}
    [Fintype A] [Fintype B] [DecidableEq A] [DecidableEq B]
    {demand : A → B → Nat} {row : A → Nat} {col : B → Nat}
    (e : ↥(Bn demand)) :
    Fin (row e.1.1) × Fin (col e.1.2) →
      Cj (fun _ : Unit => row e.1.1) ×
        Cm (fun _ : Unit => col e.1.2) := fun p =>
  (⟨(), p.1⟩, ⟨(), p.2⟩)
theorem Afg
    {A B : Type*}
    [Fintype A] [Fintype B] [DecidableEq A] [DecidableEq B]
    {demand : A → B → Nat} {row : A → Nat} {col : B → Nat}
    (e : ↥(Bn demand)) :
    Function.Injective
      (g5
        (demand := demand) (row := row) (col := col) e) := by
  intro p q hpq
  apply Prod.ext
  · exact eq_of_heq (Sigma.mk.inj_iff.mp (congrArg Prod.fst hpq)).2
  · exact eq_of_heq (Sigma.mk.inj_iff.mp (congrArg Prod.snd hpq)).2
def ZR
    {A B : Type*}
    [Fintype A] [Fintype B] [DecidableEq A] [DecidableEq B]
    {demand : A → B → Nat} {row : A → Nat} {col : B → Nat}
    (S : {S : Bm row col // S.typeTable = demand})
    (e : ↥(Bn demand)) :
    Bm (fun _ : Unit => row e.1.1)
      (fun _ : Unit => col e.1.2) where
  edges := (S.1.cellEdges e.1.1 e.1.2).image
    (g5 e)
  leftUnique := by
    intro x hx y hy hxy
    rw [Finset.mem_image] at hx hy
    obtain ⟨p, hp, rfl⟩ := hx
    obtain ⟨q, hq, rfl⟩ := hy
    have Xz : p.1 = q.1 :=
      eq_of_heq (Sigma.mk.inj_iff.mp hxy).2
    have eo :
        ((⟨e.1.1, p.1⟩, ⟨e.1.2, p.2⟩) : Cj row × Cm col) ∈
          S.1.edges := by
      simpa [Bm.cellEdges] using hp
    have f5 :
        ((⟨e.1.1, q.1⟩, ⟨e.1.2, q.2⟩) : Cj row × Cm col) ∈
          S.1.edges := by
      simpa [Bm.cellEdges] using hq
    have hrow : (⟨e.1.1, p.1⟩ : Cj row) = ⟨e.1.1, q.1⟩ :=
      Sigma.ext rfl (heq_of_eq Xz)
    have Ob := S.1.leftUnique _ eo _ f5 hrow
    have Y0 : p.2 = q.2 :=
      eq_of_heq (Sigma.mk.inj_iff.mp (congrArg Prod.snd Ob)).2
    exact congrArg (g5 e)
      (Prod.ext Xz Y0)
  QN := by
    intro x hx y hy hxy
    rw [Finset.mem_image] at hx hy
    obtain ⟨p, hp, rfl⟩ := hx
    obtain ⟨q, hq, rfl⟩ := hy
    have Y0 : p.2 = q.2 :=
      eq_of_heq (Sigma.mk.inj_iff.mp hxy).2
    have eo :
        ((⟨e.1.1, p.1⟩, ⟨e.1.2, p.2⟩) : Cj row × Cm col) ∈
          S.1.edges := by
      simpa [Bm.cellEdges] using hp
    have f5 :
        ((⟨e.1.1, q.1⟩, ⟨e.1.2, q.2⟩) : Cj row × Cm col) ∈
          S.1.edges := by
      simpa [Bm.cellEdges] using hq
    have hcol : (⟨e.1.2, p.2⟩ : Cm col) = ⟨e.1.2, q.2⟩ :=
      Sigma.ext rfl (heq_of_eq Y0)
    have Ob := S.1.QN _ eo _ f5 hcol
    have Xz : p.1 = q.1 :=
      eq_of_heq (Sigma.mk.inj_iff.mp (congrArg Prod.fst Ob)).2
    exact congrArg (g5 e)
      (Prod.ext Xz Y0)
theorem Afh
    {A B : Type*}
    [Fintype A] [Fintype B] [DecidableEq A] [DecidableEq B]
    {demand : A → B → Nat} {row : A → Nat} {col : B → Nat}
    (S : {S : Bm row col // S.typeTable = demand})
    (e : ↥(Bn demand)) :
    (ZR S e).typeTable () () =
      demand e.1.1 e.1.2 := by
  unfold Bm.typeTable
  have hAll :
      (ZR S e).edges.filter
          (fun z => z.1.1 = () ∧ z.2.1 = ()) =
        (ZR S e).edges := by
    ext z
    simp
  rw [hAll]
  change ((S.1.cellEdges e.1.1 e.1.2).image
    (g5 e)).card = _
  rw [Finset.card_image_of_injective]
  · have hcell : (S.1.cellEdges e.1.1 e.1.2).card =
        S.1.typeTable e.1.1 e.1.2 := by
      unfold Bm.cellEdges Bm.typeTable
      refine Finset.card_bij
        (fun p _ => ((⟨e.1.1, p.1⟩, ⟨e.1.2, p.2⟩) :
          Cj row × Cm col)) ?_ ?_ ?_
      · intro p hp
        rw [Finset.mem_filter] at hp ⊢
        exact ⟨hp.2, rfl, rfl⟩
      · intro p₁ hp₁ p₂ hp₂ hEq
        exact Prod.ext
          (eq_of_heq (Sigma.mk.inj_iff.mp (congrArg Prod.fst hEq)).2)
          (eq_of_heq (Sigma.mk.inj_iff.mp (congrArg Prod.snd hEq)).2)
      · intro edge hedge
        rw [Finset.mem_filter] at hedge
        obtain ⟨hEdge, hA, hB⟩ := hedge
        obtain ⟨⟨a, r⟩, ⟨b, c⟩⟩ := edge
        simp only at hA hB
        subst a
        subst b
        exact ⟨(r, c), by simp [hEdge], rfl⟩
    rw [hcell]
    exact congrFun (congrFun S.2 e.1.1) e.1.2
  · exact Afg e
def A6d
    {A B : Type*}
    [Fintype A] [Fintype B] [DecidableEq A] [DecidableEq B]
    (demand : A → B → Nat) (row : A → Nat) (col : B → Nat) :
    {S : Bm row col // S.typeTable = demand} →
      Rz demand row col := fun S e =>
  ⟨ZR S e,
    Afh S e⟩
theorem Afi
    {A B : Type*}
    [Fintype A] [Fintype B] [DecidableEq A] [DecidableEq B]
    {demand : A → B → Nat} {row : A → Nat} {col : B → Nat}
    (e : ↥(Bn demand))
    (p : Fin (row e.1.1) × Fin (col e.1.2)) :
    T8 e
        (g5 e p) =
      ((⟨e.1.1, p.1⟩, ⟨e.1.2, p.2⟩) :
        Cj row × Cm col) := by
  rfl
theorem AEY
    {A B : Type*}
    [Fintype A] [Fintype B] [DecidableEq A] [DecidableEq B]
    (demand : A → B → Nat) (row : A → Nat) (col : B → Nat)
    (Cv : DZ (Bn demand)) :
    Function.RightInverse
      (A6d demand row col)
      (g4 demand row col Cv) := by
  intro S
  apply Subtype.ext
  apply Bm.ext
  ext z
  constructor
  · intro hz
    simp only [g4,
      T7,
      ZQ, Finset.mem_biUnion,
      Finset.mem_attach, true_and, Finset.mem_image] at hz
    obtain ⟨e, p, hp, rfl⟩ := hz
    change p ∈ (ZR S e).edges at hp
    rw [ZR, Finset.mem_image] at hp
    obtain ⟨q, hq, rfl⟩ := hp
    rw [Afi]
    simpa [Bm.cellEdges] using hq
  · intro hz
    rcases z with ⟨⟨a, r⟩, ⟨b, c⟩⟩
    have AZB : demand a b ≠ 0 := by
      have Adr : S.1.typeTable a b ≠ 0 :=
        (S.1.typeTable_ne_zero_iff_exists_physical_edge a b).2
          ⟨((⟨a, r⟩, ⟨b, c⟩) : Cj row × Cm col), hz, rfl, rfl⟩
      have hcell := congrFun (congrFun S.2 a) b
      simpa only [hcell] using Adr
    let e : ↥(Bn demand) :=
      ⟨(a, b), by simp [Bn, AZB]⟩
    let q : Fin (row a) × Fin (col b) := (r, c)
    have hq : q ∈ S.1.cellEdges a b := by
      simp [q, Bm.cellEdges, hz]
    let p := g5 e q
    have hp : p ∈ (ZR S e).edges := by
      rw [ZR, Finset.mem_image]
      exact ⟨q, hq, rfl⟩
    simp only [g4,
      T7,
      ZQ, Finset.mem_biUnion,
      Finset.mem_attach, true_and]
    refine ⟨e, Finset.mem_image.mpr ⟨p, hp, ?_⟩⟩
    rfl
theorem AfY
    {A B : Type*}
    [Fintype A] [Fintype B] [DecidableEq A] [DecidableEq B]
    (demand : A → B → Nat) (row : A → Nat) (col : B → Nat)
    (Cv : DZ (Bn demand)) :
    Function.LeftInverse
      (A6d demand row col)
      (g4 demand row col Cv) := by
  intro D
  apply AfX
    demand row col Cv
  exact AEY
    demand row col Cv
      (g4 demand row col Cv D)
def AfW
    {A B : Type*}
    [Fintype A] [Fintype B] [DecidableEq A] [DecidableEq B]
    (demand : A → B → Nat) (row : A → Nat) (col : B → Nat)
    (Cv : DZ (Bn demand)) :
    Rz demand row col ≃
      {S : Bm row col // S.typeTable = demand} where
  toFun := g4 demand row col Cv
  invFun := A6d demand row col
  left_inv := AfY
    demand row col Cv
  right_inv := AEY
    demand row col Cv
end
end Erdos625
