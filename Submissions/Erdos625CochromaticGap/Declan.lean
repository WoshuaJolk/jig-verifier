    (Se : Tendsto (KO exceptional p)
      atTop (nhds i9))
    (Qv : Tendsto (KM q exceptional p)
      atTop (nhds L7)) :
    Real.log (200 / 153 : ℝ) <
      q - (L7 -
        ProfileEntropyS4.D7 Ak
          i9) := by
