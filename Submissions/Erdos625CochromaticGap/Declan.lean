section M001
namespace Erdos625
universe u v
abbrev LabeledGraph (n : ℕ) := SimpleGraph (Fin n)
inductive PartKind where
  | independent
  | clique
  deriving DecidableEq
structure CoColoring {V : Type u} (G : SimpleGraph V) (κ : Type v) where
  color : V → κ
  kind : κ → PartKind
  valid : ∀ c,
    match kind c with
    | .independent => G.IsIndepSet {v | color v = c}
    | .clique => G.IsClique {v | color v = c}
namespace CoColoring
variable {V : Type u} {κ : Type v} {κ₂ : Type*} {G : SimpleGraph V}
def colorClass (C : CoColoring G κ) (c : κ) : Set V :=
  {v | C.color v = c}
theorem A17 (C : CoColoring G κ) {c : κ}
    (h : C.kind c = .independent) : G.IsIndepSet (C.colorClass c) := by
  simpa [colorClass, h] using C.valid c
theorem A16 (C : CoColoring G κ) {c : κ}
    (h : C.kind c = .clique) : G.IsClique (C.colorClass c) := by
  simpa [colorClass, h] using C.valid c
def Ah0 (C : G.Coloring κ) : CoColoring G κ where
  color := fun v => C v
  kind := fun _ => .independent
  valid := fun c => by
    simpa [SimpleGraph.Coloring.colorClass] using C.isIndepSet_colorClass c
def AIj (C : CoColoring G κ) (κ₂ : Type*) :
    CoColoring G (Sum κ κ₂) where
  color := fun v => .inl (C.color v)
  kind := Sum.elim C.kind (fun _ => .independent)
  valid := by
    intro c
    cases c with
    | inl c => simpa using C.valid c
    | inr c => simp
noncomputable def relabel (C : CoColoring G κ) (e : κ ≃ κ₂) :
    CoColoring G κ₂ where
  color := fun v => e (C.color v)
  kind := fun c => C.kind (e.symm c)
  valid := by
    intro c
    cases hkind : C.kind (e.symm c) with
    | independent =>
        intro x hx y hy hxy
        have hx' : C.color x = e.symm c :=
          e.injective (by simpa using hx)
        have hy' : C.color y = e.symm c :=
          e.injective (by simpa using hy)
        exact (C.A17 hkind) hx' hy' hxy
    | clique =>
        intro x hx y hy hxy
        have hx' : C.color x = e.symm c :=
          e.injective (by simpa using hx)
        have hy' : C.color y = e.symm c :=
          e.injective (by simpa using hy)
        exact (C.A16 hkind) hx' hy' hxy
private noncomputable def Pe (W : Set V)
    (C₁ : CoColoring (G.induce W) κ)
    (C₂ : CoColoring (G.induce Wᶜ) κ₂) (v : V) : Sum κ κ₂ := by
  classical
  exact if hv : v ∈ W then .inl (C₁.color ⟨v, hv⟩)
  else .inr (C₂.color ⟨v, hv⟩)
noncomputable def Amv (W : Set V)
    (C₁ : CoColoring (G.induce W) κ)
    (C₂ : CoColoring (G.induce Wᶜ) κ₂) :
    CoColoring G (Sum κ κ₂) where
  color := Pe W C₁ C₂
  kind := Sum.elim C₁.kind C₂.kind
  valid := by
    intro c
    cases c with
    | inl c =>
        cases hkind : C₁.kind c with
        | independent =>
            simp only [Sum.elim_inl, hkind]
            intro x hx y hy hxy
            by_cases hxW : x ∈ W
            · by_cases hyW : y ∈ W
              · have hx' : C₁.color ⟨x, hxW⟩ = c := by
                  simpa [Pe, hxW] using hx
                have hy' : C₁.color ⟨y, hyW⟩ = c := by
                  simpa [Pe, hyW] using hy
                have hsub : (⟨x, hxW⟩ : W) ≠ ⟨y, hyW⟩ :=
                  fun h => hxy (congrArg Subtype.val h)
                exact (C₁.A17 hkind) hx' hy' hsub
              · simp [Pe, hyW] at hy
            · simp [Pe, hxW] at hx
        | clique =>
            simp only [Sum.elim_inl, hkind]
            intro x hx y hy hxy
            by_cases hxW : x ∈ W
            · by_cases hyW : y ∈ W
              · have hx' : C₁.color ⟨x, hxW⟩ = c := by
                  simpa [Pe, hxW] using hx
                have hy' : C₁.color ⟨y, hyW⟩ = c := by
                  simpa [Pe, hyW] using hy
                have hsub : (⟨x, hxW⟩ : W) ≠ ⟨y, hyW⟩ :=
                  fun h => hxy (congrArg Subtype.val h)
                exact (C₁.A16 hkind) hx' hy' hsub
              · simp [Pe, hyW] at hy
            · simp [Pe, hxW] at hx
    | inr c =>
        cases hkind : C₂.kind c with
        | independent =>
            simp only [Sum.elim_inr, hkind]
            intro x hx y hy hxy
            by_cases hxW : x ∈ W
            · simp [Pe, hxW] at hx
            · by_cases hyW : y ∈ W
              · simp [Pe, hyW] at hy
              · have hx' : C₂.color ⟨x, hxW⟩ = c := by
                  simpa [Pe, hxW] using hx
                have hy' : C₂.color ⟨y, hyW⟩ = c := by
                  simpa [Pe, hyW] using hy
                have hsub :
                    (⟨x, hxW⟩ : {v : V // v ∉ W}) ≠ ⟨y, hyW⟩ :=
                  fun h => hxy (congrArg Subtype.val h)
                exact (C₂.A17 hkind) hx' hy' hsub
        | clique =>
            simp only [Sum.elim_inr, hkind]
            intro x hx y hy hxy
            by_cases hxW : x ∈ W
            · simp [Pe, hxW] at hx
            · by_cases hyW : y ∈ W
              · simp [Pe, hyW] at hy
              · have hx' : C₂.color ⟨x, hxW⟩ = c := by
                  simpa [Pe, hxW] using hx
                have hy' : C₂.color ⟨y, hyW⟩ = c := by
                  simpa [Pe, hyW] using hy
                have hsub :
                    (⟨x, hxW⟩ : {v : V // v ∉ W}) ≠ ⟨y, hyW⟩ :=
                  fun h => hxy (congrArg Subtype.val h)
                exact (C₂.A16 hkind) hx' hy' hsub
end CoColoring
def CoColorable {V : Type u} (G : SimpleGraph V) (k : ℕ) : Prop :=
  Nonempty (CoColoring G (Fin k))
variable {V : Type u} {G : SimpleGraph V} {k : ℕ}
theorem A1m (h : G.Colorable k) : CoColorable G k :=
  ⟨CoColoring.Ah0 h.some⟩
theorem ALb {ℓ : ℕ} (h : k ≤ ℓ) :
    CoColorable G k → CoColorable G ℓ := by
  rintro ⟨C⟩
  let e : Sum (Fin k) (Fin (ℓ - k)) ≃ Fin ℓ :=
    finSumFinEquiv.trans (finCongr (Nat.add_sub_of_le h))
  exact ⟨CoColoring.relabel (C.AIj (Fin (ℓ - k))) e⟩
theorem ALd {ℓ : ℕ} (W : Set V)
    (hW : CoColorable (G.induce W) k)
    (hWc : CoColorable (G.induce Wᶜ) ℓ) :
    CoColorable G (k + ℓ) :=
  ⟨CoColoring.relabel
    (CoColoring.Amv W hW.some hWc.some)
    finSumFinEquiv⟩
theorem ALc {ℓ : ℕ} (W : Set V)
    (hW : CoColorable (G.induce W) k)
    (hWc : (G.induce Wᶜ).Colorable ℓ) :
    CoColorable G (k + ℓ) :=
  ALd W hW
    (A1m hWc)
theorem ALW [Fintype V] (G : SimpleGraph V) :
    CoColorable G (Fintype.card V) :=
  A1m (SimpleGraph.colorable_of_fintype G)
theorem A2M [Fintype V] (G : SimpleGraph V) :
    ∃ k : ℕ, CoColorable G k :=
  ⟨Fintype.card V, ALW G⟩
noncomputable def cochromaticNumber [Fintype V] (G : SimpleGraph V) : ℕ :=
  by
    classical
    exact Nat.find (A2M G)
theorem coColorable_cochromaticNumber [Fintype V] (G : SimpleGraph V) :
    CoColorable G (cochromaticNumber G) :=
  by
    classical
    exact Nat.find_spec (A2M G)
theorem cochromaticNumber_le_of_coColorable [Fintype V] (G : SimpleGraph V)
    (h : CoColorable G k) : cochromaticNumber G ≤ k :=
  by
    classical
    exact Nat.find_min' (A2M G) h
theorem Aqs [Fintype V]
    (G : SimpleGraph V) :
    CoColorable G k ↔ cochromaticNumber G ≤ k := by
  constructor
  · exact cochromaticNumber_le_of_coColorable G
  · intro h
    exact ALb h (coColorable_cochromaticNumber G)
noncomputable def chromaticNumberNat [Fintype V] (G : SimpleGraph V) : ℕ :=
  ENat.toNat G.chromaticNumber
theorem A1o [Fintype V] (G : SimpleGraph V) :
    G.Colorable (chromaticNumberNat G) := by
  exact SimpleGraph.colorable_chromaticNumber_of_fintype G
theorem Aqu [Fintype V] (G : SimpleGraph V) :
    cochromaticNumber G ≤ chromaticNumberNat G :=
  cochromaticNumber_le_of_coColorable G
    (A1m (A1o G))
end Erdos625
end M001

section M002
namespace Erdos625
open Filter MeasureTheory
noncomputable def halfProbability : unitInterval :=
  ⟨(1 : ℝ) / 2, by constructor <;> norm_num⟩
@[simp] theorem Ap8 :
    (unitInterval.toNNReal halfProbability : ENNReal) = 1 / 2 := by
  rw [← ENNReal.toReal_eq_toReal_iff' ENNReal.coe_ne_top (by finiteness)]
  norm_num [halfProbability]
@[simp] theorem Ap9 :
    (unitInterval.toNNReal (unitInterval.symm halfProbability) : ENNReal) =
      1 / 2 := by
  rw [← ENNReal.toReal_eq_toReal_iff' ENNReal.coe_ne_top (by finiteness)]
  norm_num [halfProbability]
noncomputable def randomGraphMeasure (n : ℕ) : Measure (LabeledGraph n) :=
  SimpleGraph.binomialRandom (Fin n) halfProbability
noncomputable instance AvN (n : ℕ) :
    IsProbabilityMeasure (randomGraphMeasure n) := by
  unfold randomGraphMeasure
  infer_instance
theorem Akb (n : ℕ) (G : LabeledGraph n) :
    randomGraphMeasure n {G} =
      (unitInterval.toNNReal halfProbability : ENNReal) ^ G.edgeSet.ncard *
      (unitInterval.toNNReal (unitInterval.symm halfProbability) : ENNReal) ^
        (n.choose 2 - G.edgeSet.ncard) := by
  simp [randomGraphMeasure, SimpleGraph.binomialRandom_singleton]
theorem Wt (n : ℕ) (G : LabeledGraph n) :
    randomGraphMeasure n {G} = (1 / 2 : ENNReal) ^ n.choose 2 := by
  have hE : G.edgeSet.ncard ≤ n.choose 2 := by
    calc
      G.edgeSet.ncard ≤
          (Sym2.diagSetᶜ : Set (Sym2 (Fin n))).ncard :=
        Set.ncard_le_ncard G.edgeSet_subset_compl_diagSet
          (Set.toFinite (Sym2.diagSetᶜ : Set (Sym2 (Fin n))))
      _ = (Nat.card (Fin n)).choose 2 := Sym2.ncard_diagSet_compl (Fin n)
      _ = n.choose 2 := by simp
  rw [Akb, Ap8,
    Ap9, ← pow_add, Nat.add_sub_of_le hE]
instance AvO (n : ℕ) :
    MeasurableSingletonClass (LabeledGraph n) where
  measurableSet_singleton G := by
    apply SimpleGraph.measurableEmbedding_edgeSet.measurableSet_image.mp
    simp
noncomputable def gapEvent (n : ℕ) : Set (LabeledGraph n) :=
  {G | gapScale n ≤
    (chromaticNumberNat G : ℝ) - (cochromaticNumber G : ℝ)}
theorem Avi (n : ℕ) : MeasurableSet (gapEvent n) :=
  Set.toFinite (gapEvent n) |>.measurableSet
noncomputable def gapProbability (n : ℕ) : ENNReal :=
  randomGraphMeasure n (gapEvent n)
def Erdos625Statement : Prop :=
  Tendsto gapProbability atTop (nhds 1)
theorem ARh (n : ℕ) : gapProbability n ≤ 1 := by
  calc
    gapProbability n ≤ randomGraphMeasure n Set.univ :=
      measure_mono (Set.subset_univ _)
    _ = 1 := measure_univ
theorem ArM :
    Erdos625Statement ↔
      Tendsto (fun n => (gapProbability n).toReal)
        atTop (nhds (1 : ℝ)) := by
  simpa [Erdos625Statement] using
    (ENNReal.tendsto_toReal_iff
      (fun n => ne_top_of_le_ne_top ENNReal.one_ne_top
        (ARh n))
      ENNReal.one_ne_top).symm
end Erdos625
end M002

section M003
namespace Erdos625
noncomputable def q : ℝ := Real.log 2
theorem q_pos : 0 < q := by
  exact Real.log_pos (by norm_num : (1 : ℝ) < 2)
theorem q_ne_zero : q ≠ 0 := ne_of_gt q_pos
noncomputable def AH (n : ℕ) : ℝ := Real.log (n : ℝ)
noncomputable def AY (n : ℕ) : ℝ := Real.log (AH n)
noncomputable def Y6 (x : ℝ) : ℝ := Real.log x / q
noncomputable def JE (n : ℕ) : ℝ :=
  2 * Y6 (n : ℝ) -
    2 * Y6 (Y6 (n : ℝ)) +
    2 * Y6 (Real.exp 1 / 2) + 1
noncomputable def R7 (n : ℕ) : ℤ := ⌊JE n⌋
noncomputable def A9 (n : ℕ) : ℕ := (R7 n).toNat
noncomputable def C4 (n : ℕ) : ℝ :=
  JE n - (R7 n : ℝ)
def Iv (n : ℕ) : Prop := 1 < n ∧ 0 ≤ JE n
theorem AwC {n : ℕ} (hn : Iv n) :
    0 < Y6 (n : ℝ) := by
  have hn' : (1 : ℝ) < n := by exact_mod_cast hn.1
  exact div_pos (Real.log_pos hn') q_pos
theorem AiH (n : ℕ) :
    (R7 n : ℝ) ≤ JE n := by
  exact Int.floor_le (JE n)
theorem AIs (n : ℕ) :
    JE n < (R7 n : ℝ) + 1 := by
  exact Int.lt_floor_add_one (JE n)
theorem Jj (n : ℕ) : 0 ≤ C4 n := by
  exact sub_nonneg.mpr (AiH n)
theorem JQ (n : ℕ) : C4 n < 1 := by
  dsimp [C4]
  linarith [AIs n]
theorem AwB (n : ℕ) : C4 n ∈ Set.Ico (0 : ℝ) 1 :=
  ⟨Jj n, JQ n⟩
theorem A8a (n : ℕ) :
    JE n = (R7 n : ℝ) + C4 n := by
  simp [C4]
theorem AiI {n : ℕ} (hn : Iv n) : 0 ≤ R7 n := by
  exact Int.floor_nonneg.mpr hn.2
theorem A76 {n : ℕ} (hn : Iv n) :
    (A9 n : ℤ) = R7 n := by
  simp [A9, Int.toNat_of_nonneg (AiI hn)]
theorem A0P {n : ℕ} (hn : Iv n) :
    (A9 n : ℝ) = (R7 n : ℝ) := by
  exact_mod_cast A76 hn
theorem Ot {n : ℕ} (hn : Iv n) :
    JE n = (A9 n : ℝ) + C4 n := by
  rw [A0P hn]
  exact A8a n
noncomputable def mu (v s : ℕ) : ℝ :=
  (v.choose s : ℝ) * ((2 : ℝ) ^ (s.choose 2))⁻¹
theorem ZT (v s : ℕ) : 0 ≤ mu v s := by
  unfold mu
  positivity
theorem Wj {v s : ℕ} (hsv : s ≤ v) : 0 < mu v s := by
  unfold mu
  exact mul_pos (by exact_mod_cast Nat.choose_pos hsv) (by positivity)
theorem jw {v s : ℕ} (hsv : s ≤ v) : mu v s ≠ 0 :=
  ne_of_gt (Wj hsv)
@[simp] theorem A1i (s : ℕ) :
    (s + 1).choose 2 = s.choose 2 + s := by
  rw [Nat.choose_succ_succ']
  simp [Nat.add_comm]
private theorem Aeb (a b : ℕ) :
    ((2 : ℝ) ^ (a + b))⁻¹ * (2 : ℝ) ^ b = ((2 : ℝ) ^ a)⁻¹ := by
  calc
    ((2 : ℝ) ^ (a + b))⁻¹ * (2 : ℝ) ^ b =
        ((2 : ℝ) ^ a)⁻¹ * (((2 : ℝ) ^ b)⁻¹ * (2 : ℝ) ^ b) := by
          rw [pow_add, mul_inv_rev]
          ring
    _ = ((2 : ℝ) ^ a)⁻¹ := by
      rw [inv_mul_cancel₀ (by positivity : (2 : ℝ) ^ b ≠ 0), mul_one]
theorem A6l (v s : ℕ) :
    mu v (s + 1) * ((s + 1 : ℕ) : ℝ) * (2 : ℝ) ^ s =
      mu v s * ((v - s : ℕ) : ℝ) := by
  have hchoose := congrArg (fun x : ℕ ↦ (x : ℝ))
    (Nat.choose_succ_right_eq v s)
  norm_num only [Nat.cast_mul] at hchoose
  rw [mu, mu, A1i]
  calc
    (v.choose (s + 1) : ℝ) * ((2 : ℝ) ^ (s.choose 2 + s))⁻¹ *
          ((s + 1 : ℕ) : ℝ) * (2 : ℝ) ^ s =
        ((v.choose (s + 1) : ℝ) * ((s + 1 : ℕ) : ℝ)) *
          (((2 : ℝ) ^ (s.choose 2 + s))⁻¹ * (2 : ℝ) ^ s) := by ring
    _ = ((v.choose s : ℝ) * ((v - s : ℕ) : ℝ)) *
          ((2 : ℝ) ^ (s.choose 2))⁻¹ := by
      rw [hchoose, Aeb]
    _ = (v.choose s : ℝ) * ((2 : ℝ) ^ (s.choose 2))⁻¹ *
          ((v - s : ℕ) : ℝ) := by ring
theorem AgQ {v s : ℕ} (hsv : s ≤ v) :
    mu v (s + 1) / mu v s =
      (((v - s : ℕ) : ℝ) / ((s + 1 : ℕ) : ℝ)) /
        (2 : ℝ) ^ s := by
  have hmu : mu v s ≠ 0 := jw hsv
  have hs : ((s + 1 : ℕ) : ℝ) ≠ 0 := by positivity
  have hp : (2 : ℝ) ^ s ≠ 0 := by positivity
  field_simp
  simpa [mul_assoc, mul_left_comm, mul_comm] using A6l v s
theorem AgP {v s : ℕ} (hs : 0 < s) (hsv : s ≤ v) :
    mu v (s - 1) * (((v - s : ℕ) + 1 : ℕ) : ℝ) =
      mu v s * (s : ℝ) * (2 : ℝ) ^ (s - 1) := by
  have h := A6l v (s - 1)
  have hs' : s - 1 + 1 = s := by omega
  have hv : v - (s - 1) = v - s + 1 := by omega
  simpa only [hs', hv] using h.symm
theorem AgO {v s : ℕ} (hs : 0 < s) (hsv : s ≤ v) :
    mu v (s - 1) / mu v s =
      ((s : ℝ) / (((v - s : ℕ) + 1 : ℕ) : ℝ)) *
        (2 : ℝ) ^ (s - 1) := by
  have hmu : mu v s ≠ 0 := jw hsv
  have hv : (((v - s : ℕ) + 1 : ℕ) : ℝ) ≠ 0 := by positivity
  field_simp
  simpa [mul_assoc, mul_left_comm, mul_comm] using AgP hs hsv
end Erdos625
end M003

section M004
namespace Erdos625
open MeasureTheory
open scoped BigOperators ENNReal
universe u
def completeOn {V : Type u} (S : Finset V) : SimpleGraph V :=
  (⊤ : SimpleGraph S).map
    (Function.Embedding.subtype (fun v ↦ v ∈ S))
theorem ZM {V : Type u} (G : SimpleGraph V)
    (S : Finset V) :
    G.IsIndepSet (S : Set V) ↔ Disjoint G (completeOn S) := by
  rw [SimpleGraph.disjoint_left]
  constructor
  · intro h x y hxy hcomplete
    rw [completeOn, SimpleGraph.map_adj] at hcomplete
    obtain ⟨x', y', hne, rfl, rfl⟩ := hcomplete
    exact h x'.property y'.property (by simpa using hne) hxy
  · intro h x hx y hy hxy hG
    exact (h x y hG) (by
      rw [completeOn, SimpleGraph.map_adj]
      exact ⟨⟨x, hx⟩, ⟨y, hy⟩, by simpa using hxy, rfl, rfl⟩)
theorem Aef {V : Type u} (G : SimpleGraph V)
    (S : Finset V) :
    G.IsIndepSet (S : Set V) ↔ G ≤ (completeOn S)ᶜ := by
  rw [le_compl_iff_disjoint_right]
  exact ZM G S
theorem A6n {V : Type u} [Fintype V] [DecidableEq V]
    (S : Finset V) :
    (completeOn S).edgeSet.ncard = S.card.choose 2 := by
  classical
  let f : S ↪ V := Function.Embedding.subtype (fun v ↦ v ∈ S)
  change (((⊤ : SimpleGraph S).map f).edgeSet).ncard = S.card.choose 2
  rw [SimpleGraph.edgeSet_map,
    Set.ncard_image_of_injective _ f.sym2Map.injective,
    SimpleGraph.edgeSet_top, Sym2.ncard_diagSet_compl]
  simp
theorem Agd {V : Type u} [Fintype V]
    [DecidableEq V] (S : Finset V) :
    ((completeOn S)ᶜ).edgeSet.ncard =
      (Fintype.card V).choose 2 - S.card.choose 2 := by
  rw [← top_sdiff, SimpleGraph.edgeSet_sdiff, SimpleGraph.edgeSet_top,
    Set.ncard_sdiff' (SimpleGraph.edgeSet_subset_compl_diagSet (completeOn S)),
    Sym2.ncard_diagSet_compl,
    A6n]
  simp
noncomputable def ARk {V : Type u} (H : SimpleGraph V) :
    {G : SimpleGraph V // G ≤ H} ≃ Set H.edgeSet where
  toFun G := {e | (e : Sym2 V) ∈ G.1.edgeSet}
  invFun s := ⟨SimpleGraph.fromEdgeSet (Subtype.val '' s), by
    rw [SimpleGraph.fromEdgeSet_le]
    intro e he
    obtain ⟨e', _, rfl⟩ := he.1
    exact e'.property⟩
  left_inv G := by
    apply Subtype.ext
    change SimpleGraph.fromEdgeSet
      (Subtype.val '' {e : H.edgeSet | (e : Sym2 V) ∈ G.1.edgeSet}) = G.1
    rw [show Subtype.val '' {e : H.edgeSet | (e : Sym2 V) ∈ G.1.edgeSet} =
        G.1.edgeSet by
      ext e
      constructor
      · rintro ⟨e', he', rfl⟩
        exact he'
      · intro he
        exact ⟨⟨e, (SimpleGraph.edgeSet_subset_edgeSet.mpr G.2) he⟩, he, rfl⟩]
    exact SimpleGraph.fromEdgeSet_edgeSet G.1
  right_inv s := by
    ext e
    simp only [Set.mem_setOf_eq, SimpleGraph.edgeSet_fromEdgeSet,
      Set.mem_sdiff, Set.mem_image]
    constructor
    · rintro ⟨⟨e', he', hval⟩, -⟩
      have heq : e' = e := Subtype.ext hval
      simpa [heq] using he'
    · intro he
      exact ⟨⟨e, he, rfl⟩, H.not_isDiag_of_mem_edgeSet e.property⟩
theorem A1Y {V : Type u} [Fintype V] [DecidableEq V]
    (H : SimpleGraph V) :
    Nat.card {G : SimpleGraph V // G ≤ H} = 2 ^ H.edgeSet.ncard := by
  classical
  letI : Fintype {G : SimpleGraph V // G ≤ H} := Fintype.ofFinite _
  letI : Fintype H.edgeSet := Fintype.ofFinite _
  rw [Nat.card_eq_fintype_card, Fintype.card_congr (ARk H), Fintype.card_set,
    ← Nat.card_eq_fintype_card, Nat.card_coe_set_eq]
def VK {n : ℕ} (S : Finset (Fin n)) : Set (LabeledGraph n) :=
  {G | G.IsIndepSet (S : Set (Fin n))}
theorem Avk {n : ℕ} (S : Finset (Fin n)) :
    MeasurableSet (VK S) :=
  Set.toFinite (VK S) |>.measurableSet
theorem Agf {n : ℕ} (S : Finset (Fin n)) :
    (VK S).ncard =
      2 ^ (n.choose 2 - S.card.choose 2) := by
  change Nat.card {G : LabeledGraph n //
    G.IsIndepSet (S : Set (Fin n))} = _
  calc
    _ = Nat.card {G : LabeledGraph n // G ≤ (completeOn S)ᶜ} :=
      Nat.card_congr (Equiv.subtypeEquivRight fun G ↦
        Aef G S)
    _ = 2 ^ ((completeOn S)ᶜ).edgeSet.ncard :=
      A1Y ((completeOn S)ᶜ)
    _ = 2 ^ (n.choose 2 - S.card.choose 2) := by
      rw [Agd]
      simp
theorem AkR {n : ℕ}
    (S : Finset (Fin n)) :
    randomGraphMeasure n (VK S) =
      (1 / 2 : ENNReal) ^ S.card.choose 2 := by
  classical
  letI : Fintype (VK S) := Fintype.ofFinite _
  let T := (VK S).toFinset
  have hcard : T.card = 2 ^ (n.choose 2 - S.card.choose 2) := by
    simpa [T] using Agf S
  have hk : S.card.choose 2 ≤ n.choose 2 := by
    exact Nat.choose_le_choose 2 (by simpa using Finset.card_le_univ S)
  calc
    randomGraphMeasure n (VK S) =
        randomGraphMeasure n (T : Set (LabeledGraph n)) := by
      simp [T]
    _ = ∑ G ∈ T, randomGraphMeasure n {G} := by
      rw [MeasureTheory.sum_measure_singleton]
    _ = ∑ _G ∈ T, (1 / 2 : ENNReal) ^ n.choose 2 := by
      simp_rw [Wt]
    _ = (2 : ENNReal) ^ (n.choose 2 - S.card.choose 2) *
        (1 / 2 : ENNReal) ^ n.choose 2 := by
      simp [Finset.sum_const, hcard, nsmul_eq_mul]
    _ = (1 / 2 : ENNReal) ^ S.card.choose 2 := by
      conv_lhs =>
        rhs
        rw [show n.choose 2 =
          (n.choose 2 - S.card.choose 2) + S.card.choose 2 by
            exact (Nat.sub_add_cancel hk).symm, pow_add]
      rw [← mul_assoc, ← mul_pow]
      rw [div_eq_mul_inv, one_mul,
        ENNReal.mul_inv_cancel (by norm_num) (by norm_num), one_pow, one_mul]
noncomputable def qz {n : ℕ} (G : LabeledGraph n)
    (S : Finset (Fin n)) : ℕ := by
  classical
  exact if G.IsIndepSet (S : Set (Fin n)) then 1 else 0
noncomputable def A08 {n : ℕ} (G : LabeledGraph n)
    (S : Finset (Fin n)) : ENNReal := by
  classical
  exact if G.IsIndepSet (S : Set (Fin n)) then 1 else 0
@[simp] theorem ALs {n : ℕ} (G : LabeledGraph n)
    (S : Finset (Fin n)) :
    (qz G S : ENNReal) = A08 G S := by
  classical
  by_cases h : G.IsIndepSet (S : Set (Fin n)) <;>
    simp [qz, A08, h]
noncomputable def UK {n : ℕ} (G : LabeledGraph n)
    (s : ℕ) : ℕ := by
  classical
  exact ∑ S ∈ (Finset.univ : Finset (Fin n)).powersetCard s,
    qz G S
noncomputable def jg (n s : ℕ) : ENNReal :=
  ∑ G : LabeledGraph n,
    (UK G s : ENNReal) * randomGraphMeasure n {G}
theorem AnQ {n : ℕ}
    (S : Finset (Fin n)) :
    (∑ G : LabeledGraph n,
      A08 G S * randomGraphMeasure n {G}) =
      randomGraphMeasure n (VK S) := by
  classical
  let T := (Finset.univ : Finset (LabeledGraph n)).filter
    (fun G ↦ G.IsIndepSet (S : Set (Fin n)))
  calc
    _ = ∑ G : LabeledGraph n,
        if G.IsIndepSet (S : Set (Fin n))
        then randomGraphMeasure n {G} else 0 := by
      apply Finset.sum_congr rfl
      intro G _
      by_cases h : G.IsIndepSet (S : Set (Fin n)) <;>
        simp [A08, h]
    _ = ∑ G ∈ T, randomGraphMeasure n {G} := by
      simp only [T, Finset.sum_filter]
    _ = randomGraphMeasure n (T : Set (LabeledGraph n)) := by
      rw [MeasureTheory.sum_measure_singleton]
    _ = randomGraphMeasure n (VK S) := by
      congr 1
      ext G
      simp [T, VK]
theorem AeS (n s : ℕ) :
    jg n s =
      (n.choose s : ENNReal) * (1 / 2 : ENNReal) ^ s.choose 2 := by
  classical
  unfold jg UK
  simp_rw [Nat.cast_sum, ALs, Finset.sum_mul]
  rw [Finset.sum_comm]
  simp_rw [AnQ]
  calc
    (∑ S ∈ (Finset.univ : Finset (Fin n)).powersetCard s,
        randomGraphMeasure n (VK S)) =
        ∑ _S ∈ (Finset.univ : Finset (Fin n)).powersetCard s,
          (1 / 2 : ENNReal) ^ s.choose 2 := by
      apply Finset.sum_congr rfl
      intro S hS
      rw [AkR,
        (Finset.mem_powersetCard.mp hS).2]
    _ = (n.choose s : ENNReal) *
        (1 / 2 : ENNReal) ^ s.choose 2 := by
      simp [Finset.sum_const, Finset.card_powersetCard, nsmul_eq_mul]
theorem AE6 (n s : ℕ) :
    jg n s = ENNReal.ofReal (mu n s) := by
  rw [AeS]
  unfold mu
  rw [ENNReal.ofReal_mul (Nat.cast_nonneg _),
    ENNReal.ofReal_inv_of_pos (by positivity),
    ENNReal.ofReal_pow (by positivity)]
  rw [ENNReal.inv_pow]
  simp [div_eq_mul_inv]
@[simp] theorem AeR {n : ℕ}
    (G : LabeledGraph n) (S : Finset (Fin n)) :
    0 < qz G S ↔
      G.IsIndepSet (S : Set (Fin n)) := by
  classical
  by_cases h : G.IsIndepSet (S : Set (Fin n)) <;>
    simp [qz, h]
theorem AE4 {n s : ℕ}
    (G : LabeledGraph n) :
    0 < UK G s ↔
      ∃ S : Finset (Fin n), S.card = s ∧
        G.IsIndepSet (S : Set (Fin n)) := by
  classical
  unfold UK
  rw [Finset.sum_pos_iff]
  simp [Finset.mem_powersetCard, AeR]
theorem AE5 {n s : ℕ}
    (G : LabeledGraph n) :
    0 < UK G s ↔ s ≤ G.indepNum := by
  constructor
  · rw [AE4]
    rintro ⟨S, hcard, hS⟩
    simpa [hcard] using hS.card_le_indepNum
  · intro hs
    obtain ⟨T, hT⟩ := G.exists_isNIndepSet_indepNum
    obtain ⟨S, hST, hcard⟩ := Finset.exists_subset_card_eq (s := T) (n := s)
      (by simpa [hT.card_eq] using hs)
    rw [AE4]
    refine ⟨S, hcard, ?_⟩
    exact Set.Pairwise.mono (by simpa using hST) hT.isIndepSet
def Od (n s : ℕ) : Set (LabeledGraph n) :=
  {G | s < G.indepNum}
def Y5 (n s : ℕ) : Set (LabeledGraph n) :=
  {G | 0 < UK G s}
theorem AeQ (n s : ℕ) :
    Od n s =
      Y5 n (s + 1) := by
  ext G
  simp only [Od,
    Y5, Set.mem_setOf_eq,
    AE5]
  omega
theorem Avl (n s : ℕ) :
    MeasurableSet (Y5 n s) :=
  Set.toFinite (Y5 n s) |>.measurableSet
theorem Avj (n s : ℕ) :
    MeasurableSet (Od n s) :=
  Set.toFinite (Od n s) |>.measurableSet
theorem AGI (n s : ℕ) :
    randomGraphMeasure n (Y5 n s) ≤
      jg n s := by
  classical
  let T := (Finset.univ : Finset (LabeledGraph n)).filter
    (fun G ↦ 0 < UK G s)
  calc
    randomGraphMeasure n (Y5 n s) =
        randomGraphMeasure n (T : Set (LabeledGraph n)) := by
      congr 1
      ext G
      simp [T, Y5]
    _ = ∑ G ∈ T, randomGraphMeasure n {G} := by
      rw [MeasureTheory.sum_measure_singleton]
    _ = ∑ G : LabeledGraph n,
        if 0 < UK G s
        then randomGraphMeasure n {G} else 0 := by
      simp only [T, Finset.sum_filter]
    _ ≤ ∑ G : LabeledGraph n,
        (UK G s : ENNReal) *
          randomGraphMeasure n {G} := by
      apply Finset.sum_le_sum
      intro G _
      by_cases h : 0 < UK G s
      · rw [if_pos h]
        have hone : (1 : ENNReal) ≤
            (UK G s : ENNReal) := by
          exact_mod_cast (Nat.succ_le_iff.mpr h)
        calc
          randomGraphMeasure n {G} =
              1 * randomGraphMeasure n {G} := (one_mul _).symm
          _ ≤ (UK G s : ENNReal) *
              randomGraphMeasure n {G} := mul_le_mul_left hone _
      · simp [h]
    _ = jg n s := rfl
theorem A7W (n s : ℕ) :
    randomGraphMeasure n (Od n s) ≤
      ENNReal.ofReal (mu n (s + 1)) := by
  rw [AeQ]
  exact (AGI n (s + 1)).trans_eq
    (AE6 n (s + 1))
theorem AkQ (n s : ℕ) :
    randomGraphMeasure n (Od n s) ≤
      ENNReal.ofReal (mu n s) := by
  calc
    randomGraphMeasure n (Od n s) ≤
        randomGraphMeasure n (Y5 n s) := by
      apply measure_mono
      intro G hG
      rw [Y5, Set.mem_setOf_eq,
        AE5]
      exact Nat.le_of_lt hG
    _ ≤ jg n s :=
      AGI n s
    _ = ENNReal.ofReal (mu n s) :=
      AE6 n s
theorem Aww (n s : ℕ) :
    (randomGraphMeasure n (Od n s)).toReal ≤
      mu n s := by
  have h := ENNReal.toReal_mono ENNReal.ofReal_ne_top
    (AkQ n s)
  simpa [ENNReal.toReal_ofReal (ZT n s)] using h
end Erdos625
