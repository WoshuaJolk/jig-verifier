section M199
namespace Erdos625
open scoped BigOperators ENNReal
noncomputable section
set_option autoImplicit false
def ZP
    {A B : Type*}
    [Fintype A] [Fintype B] [DecidableEq A] [DecidableEq B]
    (demand : A → B → Nat) : Nat :=
  ∏ e : ↥(Bn demand),
    (demand e.1.1 e.1.2).factorial
def jt
    {A B : Type*}
    [Fintype A] [Fintype B] [DecidableEq A] [DecidableEq B]
    (demand : A → B → Nat) (row : A → Nat) (col : B → Nat) : Nat :=
  ∏ e : ↥(Bn demand),
    (row e.1.1).descFactorial (demand e.1.1 e.1.2) *
      (col e.1.2).descFactorial (demand e.1.1 e.1.2)
theorem AKZ
    {A B : Type*}
    [Fintype A] [Fintype B] [DecidableEq A] [DecidableEq B]
    (demand : A → B → Nat) (row : A → Nat) (col : B → Nat) :
    Fintype.card (Rz demand row col) *
        ZP demand =
      jt demand row col := by
  classical
  rw [Fintype.card_pi]
  unfold ZP
    jt
  rw [← Finset.prod_mul_distrib]
  apply Finset.prod_congr rfl
  intro e _he
  exact A1e
    (row e.1.1) (col e.1.2) (demand e.1.1 e.1.2)
theorem Afa
    {A B : Type*}
    [Fintype A] [Fintype B] [DecidableEq A] [DecidableEq B]
    (demand : A → B → Nat) :
    ZP demand ≠ 0 := by
  unfold ZP
  exact Finset.prod_ne_zero_iff.mpr fun _ _ => Nat.factorial_ne_zero _
theorem AOT
    {A B : Type*}
    [Fintype A] [Fintype B] [DecidableEq A] [DecidableEq B]
    (demand : A → B → Nat) (row : A → Nat) (col : B → Nat) :
    (Fintype.card (Rz demand row col) : ENNReal) =
      (jt demand row col : ENNReal) /
        (ZP demand : ENNReal) := by
  apply (ENNReal.eq_div_iff
    (Nat.cast_ne_zero.mpr
      (Afa demand))
    (ENNReal.natCast_ne_top _)).2
  simpa only [Nat.cast_mul, mul_comm] using
    congrArg (fun x : Nat => (x : ENNReal))
      (AKZ demand row col)
def r7
    {A B : Type*}
    [Fintype A] [Fintype B] [DecidableEq A] [DecidableEq B]
    (demand : A → B → Nat) (row : A → Nat) (col : B → Nat)
    (uq : ENNReal) : ENNReal :=
  ((jt demand row col : Nat) : ENNReal) /
      ((ZP demand : Nat) : ENNReal) *
    uq
theorem AnV
    {A B : Type*}
    [Fintype A] [Fintype B] [DecidableEq A] [DecidableEq B]
    (demand : A → B → Nat) (row : A → Nat) (col : B → Nat)
    (uq : ENNReal) :
    (∑ _ : Rz demand row col, uq) =
      r7 demand row col uq := by
  rw [Finset.sum_const, Finset.card_univ, nsmul_eq_mul]
  rw [AOT]
  rfl
theorem Ajd
