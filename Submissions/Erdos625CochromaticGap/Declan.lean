noncomputable section
theorem AKv
    {X Y B : Type*} [Fintype X] [Fintype Y]
    [DecidableEq X] [DecidableEq Y] [DecidableEq B]
    (used : Finset X) (Z7 : X → B) (b : B)
    (A0c : {x : X // x ∉ used} ≃ Y)
    (A0f : Y → B)
    (UJ : ∀ x, A0f (A0c x) = Z7 x.1) :
    (Finset.univ.filter (fun x => Z7 x = b)).card =
      (used.filter (fun x => Z7 x = b)).card +
        (Finset.univ.filter (fun y => A0f y = b)).card := by
  classical
  let ALy :
      {x : X // x ∉ used ∧ Z7 x = b} ≃
        {y : Y // A0f y = b} :=
    { toFun := fun x => ⟨A0c ⟨x.1, x.2.1⟩, by
        rw [UJ]
        exact x.2.2⟩
      invFun := fun y =>
        let x := A0c.symm y.1
        ⟨x.1, x.2, by
          rw [← UJ x, A0c.apply_symm_apply]
          exact y.2⟩
      left_inv := fun x => by
        apply Subtype.ext
        simp
      right_inv := fun y => by
        apply Subtype.ext
        simp }
  have AcW :
      (Finset.univ.filter (fun y => A0f y = b)).card =
        (Finset.univ.filter
          (fun x => x ∉ used ∧ Z7 x = b)).card := by
    rw [← Fintype.card_subtype, ← Fintype.card_subtype]
    exact Fintype.card_congr ALy.symm
  let Xc := Finset.univ.filter (fun x => Z7 x = b)
  have hused :
      Xc.filter (fun x => x ∈ used) =
        used.filter (fun x => Z7 x = b) := by
    ext x
    simp [Xc, and_comm]
  have Adw :
      Xc.filter (fun x => ¬ x ∈ used) =
        Finset.univ.filter (fun x => x ∉ used ∧ Z7 x = b) := by
    ext x
    simp [Xc, and_comm]
  have qI :=
    Finset.card_filter_add_card_filter_not (s := Xc)
      (fun x => x ∈ used)
  rw [hused, Adw] at qI
  rw [AcW]
  exact qI.symm
def A7X
    {A B : Type*} [Fintype A] [Fintype B]
    [DecidableEq A] [DecidableEq B]
    {demand : A → B → ℕ} {row : A → ℕ} {col : B → ℕ}
    (witness : BW demand row col) (a : A) :
    {i : Fin (row a) // i ∉ MW witness a} ≃
      Fin (D5 witness a) :=
  Fintype.equivFinOfCardEq (A9A witness a)
theorem Aky
    {A B : Type*} [Fintype A] [Fintype B]
    [DecidableEq A] [DecidableEq B]
    {demand : A → B → ℕ} {row : A → ℕ} {col : B → ℕ}
    (witness : BW demand row col) (a : A)
    (i : {i : Fin (row a) //
      i ∉ MW witness a}) :
    YO witness
        ⟨⟨a, i.1⟩, by
          simpa [MW] using i.2⟩ =
      ⟨a, A7X witness a i⟩ := by
  rfl
theorem Al4
    {A B : Type*} [Fintype A] [Fintype B]
    [DecidableEq A] [DecidableEq B]
    {demand : A → B → ℕ} {row : A → ℕ} {col : B → ℕ}
    (witness : BW demand row col)
    (extension : {matching : BZ row col //
      H7 matching witness})
    (x : Vv witness) :
    ((WA witness extension)
      (YO witness x)).1 =
        (extension.1 x.1).1 := by
  calc
    ((WA witness extension)
        (YO witness x)).1 =
        (kL witness
          ((wQ witness extension)
            ((YO witness).symm
              (YO witness x)))).1 := rfl
    _ = (kL witness
          ((wQ witness extension)
            x)).1 := by rw [Equiv.symm_apply_apply]
    _ = (((wQ witness extension)
          x).1).1 := Akw _ _
    _ = (extension.1 x.1).1 := by
      rfl
theorem Aps
    {A B : Type*} [Fintype A] [Fintype B]
    [DecidableEq A] [DecidableEq B]
    {demand : A → B → ℕ} {row : A → ℕ} {col : B → ℕ}
    (witness : BW demand row col)
    (extension : {matching : BZ row col //
      H7 matching witness})
    (a : A) (b : B) :
    (MW witness a).filter
        (fun i => (extension.1 ⟨a, i⟩).1 = b) =
      (witness.1 a).1 b := by
  classical
  ext i
  constructor
  · intro hi
    obtain ⟨Kt, htarget⟩ := Finset.mem_filter.mp hi
    have Ob :
        (⟨a, i⟩ : Cj row) ∈ Ue witness := by
      simpa [MW] using Kt
    obtain ⟨atom, _, hatom⟩ := Finset.mem_image.mp Ob
    obtain ⟨a', b', stub⟩ := atom
    have ha : a' = a := (Sigma.mk.inj_iff.mp hatom).1
    subst a'
    have hstub : (stub : Fin (row a)) = i :=
      eq_of_heq (Sigma.mk.inj_iff.mp hatom).2
    have A4o := congrArg Sigma.fst (extension.2 ⟨a, b', stub⟩)
    change (extension.1 ⟨a, (stub : Fin (row a))⟩).1 = b' at A4o
    have hb : b' = b := by
      rw [hstub] at A4o
      exact A4o.symm.trans htarget
    subst b'
    simpa [hstub] using stub.2
  · intro hi
    let atom : RJ witness := ⟨a, b, ⟨i, hi⟩⟩
    have Ob :
        (⟨a, i⟩ : Cj row) ∈ Ue witness := by
      apply Finset.mem_image.mpr
      exact ⟨atom, Finset.mem_univ atom, rfl⟩
    have Kt : i ∈ MW witness a := by
      simp [MW, Ob]
    have htarget := congrArg Sigma.fst (extension.2 atom)
    change (extension.1 ⟨a, i⟩).1 = b at htarget
    exact Finset.mem_filter.mpr ⟨Kt, htarget⟩
theorem j8
    {A B : Type*} [Fintype A] [Fintype B]
    [DecidableEq A] [DecidableEq B]
    {demand : A → B → ℕ} {row : A → ℕ} {col : B → ℕ}
    (witness : BW demand row col)
    (extension : {matching : BZ row col //
      H7 matching witness})
    (a : A) (b : B) :
    BX extension.1 a b =
      demand a b +
        BX
          (WA witness extension)
          a b := by
  let residual :=
    WA witness extension
  have UJ : ∀ x :
      {i : Fin (row a) // i ∉ MW witness a},
      (residual ⟨a, A7X witness a x⟩).1 =
        (extension.1 ⟨a, x.1⟩).1 := by
    intro x
    let unused : Vv witness :=
      ⟨⟨a, x.1⟩, by
        simpa [MW] using x.2⟩
    have Nz := Al4 witness extension unused
    rw [Aky witness a x] at Nz
    exact Nz
  have hsplit := AKv
    (MW witness a)
    (fun i => (extension.1 ⟨a, i⟩).1) b
    (A7X witness a)
    (fun i => (residual ⟨a, i⟩).1) UJ
  rw [Aps witness extension a b,
    (witness.1 a).2.1 b] at hsplit
  exact hsplit
end
