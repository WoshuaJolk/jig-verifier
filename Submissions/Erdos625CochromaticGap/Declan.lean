  induction ell generalizing v with
  | zero =>
      simp [Tv]
  | succ ell ih =>
      rcases code with ⟨u, tail⟩
      rw [A8K, ih]
      simp only [Tv]
      rw [Fin.prod_univ_succ]
      simp only [vertex, Fin.castSucc_zero, Fin.castSucc_succ,
        Fin.cases_zero, Fin.cases_succ, Apy]
