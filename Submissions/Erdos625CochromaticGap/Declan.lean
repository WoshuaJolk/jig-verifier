theorem AAL
    (C : ℝ) (hC : 0 ≤ C) :
    ∀ᶠ n : ℕ in atTop,
      ∀ (U m₀ : ℕ),
        0 < m₀ →
        (n : ℝ) / Real.log (n : ℝ) ^ 6 ≤ (m₀ : ℝ) →
