    have he : ex = ey := Subtype.ext heval
    subst ey
    have hpl : px.1 = py.1 := by
      apply Sigma.ext (x := px.1) (y := py.1) rfl
      apply heq_of_eq
      apply Fin.ext
      simpa only [NW] using
        congrArg (fun z => z.2.val) hxy
