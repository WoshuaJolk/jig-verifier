section M375
open MeasureTheory
namespace Erdos625
theorem A0B
    (n : ℕ) (F : LabeledGraph n → ℝ) :
    ∫ G, F G ∂(randomGraphMeasure n) = Rq F := by
  rw [← AEX n]
  rw [MeasureTheory.integral_map
    (A6e n).aemeasurable
    (measurable_of_finite F).aestronglyMeasurable]
  rfl
theorem Awp
    {n : ℕ} (F : LabeledGraph n → ℝ) :
    Rq F = ∫ G, F G ∂(randomGraphMeasure n) :=
