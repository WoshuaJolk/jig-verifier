      (QS P).symm.toEmbedding).map
        (Function.Embedding.subtype _)) at he
    rw [Finset.mem_map] at he
    obtain ⟨cell, hcell, rfl⟩ := he
    exact cell.2
  · intro e he
    change e ∈ ((E.1.map
      (QS P).symm.toEmbedding).map
        (Function.Embedding.subtype _)) at he
    rw [Finset.mem_map] at he
    obtain ⟨cell, hcell, rfl⟩ := he
    exact cell.2
  · intro F
    apply Subtype.ext
    exact AoE P F.1 F.2.2
  · intro E
    apply Subtype.ext
    exact AoD P E.1
theorem AgW
