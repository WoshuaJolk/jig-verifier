@[simp] theorem AvY
    {b n : Nat} (k : AG b)
    (x : FN n k) (σ : x.1.1.parts → Bool) :
    (Sz k ⟨x, σ⟩).1 =
      JN x := rfl
@[simp] theorem AvZ
    {b n : Nat} (k : AG b)
    (x : FN n k) (σ : x.1.1.parts → Bool)
