noncomputable section
theorem A7p {alpha : ℕ} (C9 : 0 < alpha) :
    StrictMono (LW alpha) := by
  have hb : 2 ≤ alpha + 1 := by omega
  intro lambda mu Ep
  have hdual := (kV hb)
