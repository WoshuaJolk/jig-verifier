section M005
namespace Erdos625
open MeasureTheory
open scoped BigOperators ENNReal
universe u
private theorem AHR {I M : Type*} [DecidableEq I]
    [AddCommMonoid M] (s : Finset I) (f : I → Multiset M) :
    (∑ i ∈ s, f i).sum = ∑ i ∈ s, (f i).sum := by
  change Multiset.sumAddMonoidHom (∑ i ∈ s, f i) =
    ∑ i ∈ s, Multiset.sumAddMonoidHom (f i)
  exact map_sum Multiset.sumAddMonoidHom f s
private theorem AEW {I A B : Type*} [DecidableEq I]
    (s : Finset I) (g : A → B) (f : I → Multiset A) :
    Multiset.map g (∑ i ∈ s, f i) =
      ∑ i ∈ s, Multiset.map g (f i) := by
  change (Multiset.mapAddMonoidHom g) (∑ i ∈ s, f i) =
    ∑ i ∈ s, (Multiset.mapAddMonoidHom g) (f i)
  exact map_sum (Multiset.mapAddMonoidHom g) f s
abbrev AG (b : ℕ) := Fin b → ℕ
namespace AG
def sizes {b : ℕ} (k : AG b) : Multiset ℕ :=
  ∑ i : Fin b, Multiset.replicate (k i) (i.1 + 1)
def D8 {b : ℕ} (k : AG b) : ℕ :=
  (sizes k).card
def DK {b : ℕ} (k : AG b) : ℕ :=
  (sizes k).sum
def Eo {b : ℕ} (k : AG b) : ℕ :=
  ((sizes k).map fun s ↦ s.choose 2).sum
theorem A6z {b : ℕ} (k : AG b) :
    D8 k = ∑ i : Fin b, k i := by
  simp [D8, sizes]
theorem A18 {b : ℕ} (k : AG b) :
    DK k = ∑ i : Fin b, (i.1 + 1) * k i := by
  unfold DK sizes
  rw [AHR]
  simp [Multiset.sum_replicate, mul_comm]
theorem AAu {b : ℕ} (k : AG b) :
    Eo k = ∑ i : Fin b, k i * (i.1 + 1).choose 2 := by
  unfold Eo sizes
  rw [AEW, AHR]
  simp [Multiset.map_replicate, Multiset.sum_replicate]
def Ow {b : ℕ} (k : AG b) : ℕ :=
  (sizes k).bell
theorem A7E {b : ℕ} (k : AG b) :
    ((sizes k).map Nat.factorial).prod =
      ∏ i : Fin b, (Nat.factorial (i.1 + 1)) ^ k i := by
  unfold sizes
  rw [AEW, Multiset.prod_sum]
  simp [Multiset.map_replicate, Multiset.prod_replicate]
theorem A1u {b : ℕ} (k : AG b) (i : Fin b) :
    (sizes k).count (i.1 + 1) = k i := by
  unfold sizes
  rw [Multiset.count_sum']
  simp only [Multiset.count_replicate, Nat.add_left_inj]
  have hval (x : Fin b) : x.1 = i.1 ↔ x = i := by
    constructor
    · exact Fin.ext
    · intro h
      exact congrArg Fin.val h
  simp_rw [hval]
  exact Fintype.sum_ite_eq' i k
def support {b : ℕ} (k : AG b) : Finset (Fin b) :=
  Finset.univ.filter fun i ↦ k i ≠ 0
theorem Ap7 {b : ℕ} (k : AG b) :
    (sizes k).toFinset =
      (support k).image fun i ↦ i.1 + 1 := by
  classical
  ext s
  simp [sizes, support, Multiset.mem_replicate, eq_comm]
theorem A7D {b : ℕ} (k : AG b) :
    (∏ s ∈ (sizes k).toFinset.erase 0,
        Nat.factorial ((sizes k).count s)) =
      ∏ i : Fin b, Nat.factorial (k i) := by
  classical
  have hinj : Function.Injective (fun i : Fin b ↦ i.1 + 1) := by
    intro i j h
    apply Fin.ext
    exact Nat.add_right_cancel h
  have hzero : 0 ∉ (support k).image (fun i ↦ i.1 + 1) := by
    simp
  rw [Ap7, Finset.erase_eq_of_notMem hzero,
    Finset.prod_image hinj.injOn]
  simp_rw [A1u]
  apply Finset.prod_subset (Finset.subset_univ _)
  intro i _ hi
  have hki : k i = 0 := by
    simpa [support] using hi
  simp [hki]
theorem AOd {b : ℕ}
    (k : AG b) :
    Ow k *
        ((sizes k).map Nat.factorial).prod *
        (∏ s ∈ (sizes k).toFinset.erase 0,
          Nat.factorial ((sizes k).count s)) =
      Nat.factorial (DK k) := by
  simpa [Ow, DK] using
    Multiset.bell_mul_eq (sizes k)
theorem A28 {b : ℕ}
    (k : AG b) :
    Ow k *
        (∏ i : Fin b, (Nat.factorial (i.1 + 1)) ^ k i) *
        (∏ i : Fin b, Nat.factorial (k i)) =
      Nat.factorial (DK k) := by
  rw [← A7E, ← A7D]
  exact AOd k
theorem AOc {b : ℕ}
    (k : AG b) :
    Ow k =
      Nat.factorial (DK k) /
        (((sizes k).map Nat.factorial).prod *
          ∏ s ∈ (sizes k).toFinset.erase 0,
            Nat.factorial ((sizes k).count s)) := by
  simpa [Ow, DK] using
    Multiset.bell_eq (sizes k)
theorem AOb {b : ℕ}
    (k : AG b) :
    Ow k =
      Nat.factorial (DK k) /
        ((∏ i : Fin b, (Nat.factorial (i.1 + 1)) ^ k i) *
          ∏ i : Fin b, Nat.factorial (k i)) := by
  rw [AOc,
    A7E, A7D]
end AG
abbrev GD (n : ℕ) :=
  Finpartition (Finset.univ : Finset (Fin n))
def Jh {n : ℕ} (P : GD n) : Multiset ℕ :=
  P.parts.1.map Finset.card
@[simp] theorem AKd {n : ℕ} (P : GD n) :
    (Jh P).card = P.parts.card := by
  simp [Jh]
theorem Anj {n : ℕ} (P : GD n) :
    (Jh P).sum = n := by
  simpa [Jh] using P.sum_card_parts
def BT {b : ℕ} (n : ℕ) (k : AG b) :=
  {P : GD n //
    Jh P = AG.sizes k}
instance AvE {b n : ℕ} (k : AG b) :
    Fintype (BT n k) :=
  Subtype.fintype _
theorem BT.vertexMass_eq {b n : ℕ}
    {k : AG b} (P : BT n k) :
    AG.DK k = n := by
  rw [← Anj P.1, P.2]
  rfl
theorem BT.card_parts_eq {b n : ℕ}
    {k : AG b} (P : BT n k) :
    P.1.parts.card = AG.D8 k := by
  rw [← AKd P.1, P.2]
  rfl
theorem Aw2 {b n : ℕ}
    {k : AG b}
    (h : AG.DK k ≠ n) :
    ¬ Nonempty (BT n k) := by
  rintro ⟨P⟩
  exact h P.vertexMass_eq
def Gq {n : ℕ} (P : GD n) :
    LabeledGraph n :=
  P.parts.sup completeOn
theorem w5 {V : Type u}
    {A B : Finset V} (h : Disjoint A B) :
    Disjoint (completeOn A) (completeOn B) := by
  rw [SimpleGraph.disjoint_left]
  intro x y hA hB
  rw [completeOn, SimpleGraph.map_adj] at hA hB
  obtain ⟨xA, yA, -, rfl, -⟩ := hA
  obtain ⟨xB, yB, -, hx, -⟩ := hB
  apply Finset.disjoint_left.mp h xA.property
  have hx' : (xB : V) = (xA : V) := hx
  exact hx' ▸ xB.property
theorem AEq {V : Type u} [Fintype V]
    {I : Type*} [DecidableEq I] (s : Finset I) (f : I → SimpleGraph V)
    (h : (s : Set I).PairwiseDisjoint f) :
    (s.sup f).edgeSet.ncard = ∑ i ∈ s, (f i).edgeSet.ncard := by
  classical
  induction s using Finset.induction_on with
  | empty => simp
  | @insert a s ha ih =>
      have hs : (s : Set I).PairwiseDisjoint f := by
        intro i hi j hj hij
        exact h (Finset.mem_insert_of_mem hi)
          (Finset.mem_insert_of_mem hj) hij
      have hdis : Disjoint (f a) (s.sup f) := by
        apply Finset.disjoint_sup_right.2
        intro i hi
        have hai : a ≠ i := fun hai ↦ ha (hai ▸ hi)
        exact h (Finset.mem_insert_self a s)
          (Finset.mem_insert_of_mem hi) hai
      have hedge : Disjoint (f a).edgeSet (s.sup f).edgeSet :=
        SimpleGraph.disjoint_edgeSet.mpr hdis
      rw [Finset.sup_insert, SimpleGraph.edgeSet_sup,
        Set.ncard_union_eq hedge, Finset.sum_insert ha, ih hs]
theorem AhT {n : ℕ}
    (P : GD n) :
    (P.parts : Set (Finset (Fin n))).PairwiseDisjoint completeOn := by
  intro A hA B hB hAB
  exact w5 (P.disjoint hA hB hAB)
theorem r9 {n : ℕ}
    (P : GD n) :
    (Gq P).edgeSet.ncard =
      ∑ B ∈ P.parts, B.card.choose 2 := by
  rw [Gq,
    AEq P.parts completeOn
      (AhT P)]
  apply Finset.sum_congr rfl
  intro B _
  exact A6n B
theorem BT.r9 {b n : ℕ}
    {k : AG b} (P : BT n k) :
    (Gq P.1).edgeSet.ncard =
      AG.Eo k := by
  rw [Erdos625.r9]
  rw [show (∑ B ∈ P.1.parts, B.card.choose 2) =
      ((Jh P.1).map fun s ↦ s.choose 2).sum by
    simp [Jh], P.2]
  rfl
def KX {n : ℕ} (P : GD n) :
    Set (LabeledGraph n) :=
  {G | ∀ B ∈ P.parts, G.IsIndepSet (B : Set (Fin n))}
theorem Avn {n : ℕ}
    (P : GD n) :
    MeasurableSet (KX P) :=
  Set.toFinite (KX P) |>.measurableSet
theorem Ag2 {n : ℕ}
    (P : GD n) (G : LabeledGraph n) :
    G ∈ KX P ↔ G ≤ (Gq P)ᶜ := by
  rw [KX, Set.mem_setOf_eq,
    Gq, le_compl_iff_disjoint_right,
    Finset.disjoint_sup_right]
  constructor
  · intro h B hB
    exact (ZM G B).mp (h B hB)
  · intro h B hB
    exact (ZM G B).mpr (h hB)
theorem AEp {n : ℕ} (H : LabeledGraph n) :
    Hᶜ.edgeSet.ncard = n.choose 2 - H.edgeSet.ncard := by
  rw [← top_sdiff, SimpleGraph.edgeSet_sdiff, SimpleGraph.edgeSet_top,
    Set.ncard_sdiff' H.edgeSet_subset_compl_diagSet,
    Sym2.ncard_diagSet_compl]
  simp
theorem AkT {n : ℕ} (H : LabeledGraph n) :
    randomGraphMeasure n {G | G ≤ Hᶜ} =
      (1 / 2 : ENNReal) ^ H.edgeSet.ncard := by
  classical
  let T := (Finset.univ : Finset (LabeledGraph n)).filter fun G ↦ G ≤ Hᶜ
  have hcard : T.card = 2 ^ (n.choose 2 - H.edgeSet.ncard) := by
    calc
      T.card = Fintype.card {G : LabeledGraph n // G ≤ Hᶜ} := by
        simpa [T] using
          (Fintype.card_subtype (fun G : LabeledGraph n ↦ G ≤ Hᶜ)).symm
      _ = Nat.card {G : LabeledGraph n // G ≤ Hᶜ} := by
        rw [Nat.card_eq_fintype_card]
      _ = 2 ^ (n.choose 2 - H.edgeSet.ncard) := by
        rw [A1Y, AEp]
  have hE : H.edgeSet.ncard ≤ n.choose 2 := by
    calc
      H.edgeSet.ncard ≤
          (Sym2.diagSetᶜ : Set (Sym2 (Fin n))).ncard :=
        Set.ncard_le_ncard H.edgeSet_subset_compl_diagSet
          (Set.toFinite (Sym2.diagSetᶜ : Set (Sym2 (Fin n))))
      _ = n.choose 2 := by simpa using Sym2.ncard_diagSet_compl (Fin n)
  calc
    randomGraphMeasure n {G | G ≤ Hᶜ} =
        randomGraphMeasure n (T : Set (LabeledGraph n)) := by
      congr 1
      ext G
      simp [T]
    _ = ∑ G ∈ T, randomGraphMeasure n {G} := by
      rw [MeasureTheory.sum_measure_singleton]
    _ = ∑ _G ∈ T, (1 / 2 : ENNReal) ^ n.choose 2 := by
      simp_rw [Wt]
    _ = (2 : ENNReal) ^ (n.choose 2 - H.edgeSet.ncard) *
        (1 / 2 : ENNReal) ^ n.choose 2 := by
      simp [Finset.sum_const, hcard, nsmul_eq_mul]
    _ = (1 / 2 : ENNReal) ^ H.edgeSet.ncard := by
      conv_lhs =>
        rhs
        rw [show n.choose 2 =
          (n.choose 2 - H.edgeSet.ncard) + H.edgeSet.ncard by
            exact (Nat.sub_add_cancel hE).symm, pow_add]
      rw [← mul_assoc, ← mul_pow]
      rw [div_eq_mul_inv, one_mul,
        ENNReal.mul_inv_cancel (by norm_num) (by norm_num), one_pow, one_mul]
theorem AGK {b n : ℕ}
    {k : AG b} (P : BT n k) :
    randomGraphMeasure n (KX P.1) =
      (1 / 2 : ENNReal) ^ AG.Eo k := by
  rw [show KX P.1 =
      {G | G ≤ (Gq P.1)ᶜ} by
    ext G
    exact Ag2 P.1 G,
    AkT,
    P.r9]
noncomputable def gY {b n : ℕ}
    (G : LabeledGraph n) {k : AG b}
    (P : BT n k) : ℕ := by
  classical
  exact if G ∈ KX P.1 then 1 else 0
noncomputable def rO {b n : ℕ}
    (G : LabeledGraph n) (k : AG b) : ℕ := by
  classical
  exact ∑ P : BT n k, gY G P
noncomputable def JT {b : ℕ}
    (n : ℕ) (k : AG b) : ENNReal :=
  ∑ G : LabeledGraph n,
    (rO G k : ENNReal) * randomGraphMeasure n {G}
theorem Anr {b n : ℕ}
    {k : AG b} (P : BT n k) :
    (∑ G : LabeledGraph n,
      (gY G P : ENNReal) *
        randomGraphMeasure n {G}) =
      randomGraphMeasure n (KX P.1) := by
  classical
  let T := (Finset.univ : Finset (LabeledGraph n)).filter
    fun G ↦ G ∈ KX P.1
  calc
    _ = ∑ G : LabeledGraph n,
        if G ∈ KX P.1
        then randomGraphMeasure n {G} else 0 := by
      apply Finset.sum_congr rfl
      intro G _
      by_cases h : G ∈ KX P.1 <;>
        simp [gY, h]
    _ = ∑ G ∈ T, randomGraphMeasure n {G} := by
      simp only [T, Finset.sum_filter]
    _ = randomGraphMeasure n (T : Set (LabeledGraph n)) := by
      rw [MeasureTheory.sum_measure_singleton]
    _ = randomGraphMeasure n (KX P.1) := by
      congr 1
      ext G
      simp [T]
theorem kA {b : ℕ}
    (n : ℕ) (k : AG b) :
    JT n k =
      (Nat.card (BT n k) : ENNReal) *
        (1 / 2 : ENNReal) ^ AG.Eo k := by
  classical
  unfold JT rO
  simp_rw [Nat.cast_sum, Finset.sum_mul]
  rw [Finset.sum_comm]
  simp_rw [Anr,
    AGK]
  simp [Finset.sum_const, nsmul_eq_mul, Nat.card_eq_fintype_card]
def Zq {b : ℕ}
    (n : ℕ) (k : AG b) : Prop :=
  Nat.card (BT n k) =
    AG.Ow k
theorem rP
    {b : ℕ} (n : ℕ) (k : AG b)
    (h : Zq n k) :
    JT n k =
      (AG.Ow k : ENNReal) *
        (1 / 2 : ENNReal) ^ AG.Eo k := by
  rw [kA, h]
theorem Aj6
    {b : ℕ} (n : ℕ) (k : AG b)
    (h : Zq n k) :
    JT n k =
      ((Nat.factorial (AG.DK k) /
          ((∏ i : Fin b, (Nat.factorial (i.1 + 1)) ^ k i) *
            ∏ i : Fin b, Nat.factorial (k i)) : ℕ) : ENNReal) *
        (1 / 2 : ENNReal) ^ AG.Eo k := by
  rw [rP n k h,
    AG.AOb]
theorem Aj7
    {b : ℕ} (n : ℕ) (k : AG b)
    (hmass : AG.DK k = n)
    (h : Zq n k) :
    JT n k =
      ((Nat.factorial n /
          ((∏ i : Fin b, (Nat.factorial (i.1 + 1)) ^ k i) *
            ∏ i : Fin b, Nat.factorial (k i)) : ℕ) : ENNReal) *
        (1 / 2 : ENNReal) ^ AG.Eo k := by
  rw [Aj6
    n k h, hmass]
theorem AwM
    {b : ℕ} (n : ℕ) (k : AG b)
    (h : AG.DK k ≠ n) :
    JT n k = 0 := by
  rw [kA]
  have hne : IsEmpty (BT n k) :=
    ⟨fun P ↦ h P.vertexMass_eq⟩
  letI : IsEmpty (BT n k) := hne
  simp
end Erdos625
end M005

section M006
namespace Erdos625
open scoped BigOperators
noncomputable section
abbrev Dm (m : Multiset ℕ) :=
  Σ s : m.toFinset, Fin (m.count (s : ℕ)) × Fin s.1
theorem A1d (m : Multiset ℕ) :
    Fintype.card (Dm m) = m.sum := by
  rw [Fintype.card_sigma]
  simp only [Fintype.card_prod, Fintype.card_fin]
  change (∑ s ∈ (Finset.univ : Finset m.toFinset),
    m.count (s : ℕ) * (s : ℕ)) = m.sum
  rw [show (Finset.univ : Finset m.toFinset) = m.toFinset.attach by
    ext s
    simp]
  rw [Finset.sum_attach
    (s := m.toFinset) (f := fun s : ℕ ↦ m.count s * s)]
  simpa [nsmul_eq_mul, mul_comm] using
    (Finset.sum_multiset_count m).symm
theorem A8M {b : ℕ} (k : AG b) :
    0 ∉ AG.sizes k := by
  intro h
  simp only [AG.sizes, Multiset.mem_sum] at h
  obtain ⟨i, _hi, hzero⟩ := h
  have heq : 0 = i.1 + 1 := Multiset.eq_of_mem_replicate hzero
  omega
abbrev HW {b n : ℕ} {k : AG b}
    (P : BT n k) (s : ℕ) :=
  {B : P.1.parts // B.1.card = s}
theorem A9E {n : ℕ}
    (P : GD n) (s : ℕ) :
    Fintype.card {B : P.parts // B.1.card = s} =
      (Jh P).count s := by
  classical
  calc
    Fintype.card {B : P.parts // B.1.card = s} =
        (P.parts.filter fun B ↦ B.card = s).card := by
      rw [Fintype.card_of_subtype
        (Finset.univ.filter fun B : P.parts ↦ B.1.card = s) (by simp)]
      change (P.parts.attach.filter fun B ↦ B.1.card = s).card = _
      simpa only [Finset.card_map, Finset.card_attach] using congrArg Finset.card
        (Finset.filter_attach (fun B : Finset (Fin n) ↦ B.card = s) P.parts)
    _ = (Jh P).count s := by
      rw [Jh, Multiset.count_map]
      change
        (P.parts.1.filter fun B ↦ B.card = s).card =
          (P.parts.1.filter fun B ↦ s = B.card).card
      congr 2
      funext B
      exact propext eq_comm
theorem A98 {b n : ℕ} {k : AG b}
    (P : BT n k) (s : ℕ) :
    Fintype.card (HW P s) =
      (AG.sizes k).count s := by
  classical
  calc
    Fintype.card (HW P s) =
        (P.1.parts.filter fun B ↦ B.card = s).card := by
      rw [Fintype.card_of_subtype
        (Finset.univ.filter fun B : P.1.parts ↦ B.1.card = s) (by simp)]
      change (P.1.parts.attach.filter fun B ↦ B.1.card = s).card = _
      simpa only [Finset.card_map, Finset.card_attach] using congrArg Finset.card
        (Finset.filter_attach (fun B : Finset (Fin n) ↦ B.card = s) P.1.parts)
    _ = (Jh P.1).count s := by
      rw [Jh, Multiset.count_map]
      change
        (P.1.parts.1.filter fun B ↦ B.card = s).card =
          (P.1.parts.1.filter fun B ↦ s = B.card).card
      congr 2
      funext B
      exact propext eq_comm
    _ = (AG.sizes k).count s := by rw [P.2]
abbrev LG {b n : ℕ} {k : AG b}
    (P : BT n k) :=
  (∀ s : (AG.sizes k).toFinset,
      HW P s.1 ≃
        Fin ((AG.sizes k).count (s : ℕ))) ×
    (∀ B : P.1.parts, B.1 ≃ Fin B.1.card)
theorem AKj {b n : ℕ} {k : AG b}
    (P : BT n k) :
    Fintype.card (LG P) =
      ((AG.sizes k).map Nat.factorial).prod *
        ∏ s ∈ (AG.sizes k).toFinset,
          Nat.factorial ((AG.sizes k).count s) := by
  classical
  let m := AG.sizes k
  have Aaj :
      (∏ s : m.toFinset,
          Fintype.card
            (HW P s.1 ≃ Fin (m.count (s : ℕ)))) =
        ∏ s ∈ m.toFinset, Nat.factorial (m.count s) := by
    have hcard (s : m.toFinset) :
        Fintype.card
            (HW P s.1 ≃ Fin (m.count (s : ℕ))) =
          Nat.factorial (m.count (s : ℕ)) := by
      have C7 :
          Fintype.card (HW P s.1) =
            m.count (s : ℕ) := by
        simpa only [m] using A98 P s.1
      let e : HW P s.1 ≃ Fin (m.count (s : ℕ)) :=
        Fintype.equivOfCardEq (C7.trans (Fintype.card_fin _).symm)
      calc
        Fintype.card
            (HW P s.1 ≃ Fin (m.count (s : ℕ))) =
            Nat.factorial (Fintype.card (HW P s.1)) :=
          Fintype.card_equiv e
        _ = Nat.factorial (m.count (s : ℕ)) := by rw [C7]
    simp_rw [hcard]
    rw [show (Finset.univ : Finset m.toFinset) = m.toFinset.attach by
      ext s
      simp]
    rw [Finset.prod_attach
      (s := m.toFinset) (f := fun s : ℕ ↦ Nat.factorial (m.count s))]
  have A5k :
      (∏ B : P.1.parts,
          Fintype.card (B.1 ≃ Fin B.1.card)) =
        (m.map Nat.factorial).prod := by
    have hcard (B : P.1.parts) :
        Fintype.card (B.1 ≃ Fin B.1.card) =
          Nat.factorial B.1.card := by
      simpa only [Fintype.card_coe] using
        (Fintype.card_equiv B.1.equivFin)
    simp_rw [hcard]
    rw [show (Finset.univ : Finset P.1.parts) = P.1.parts.attach by
      ext B
      simp]
    rw [Finset.prod_attach
      (s := P.1.parts) (f := fun B ↦ Nat.factorial B.card)]
    rw [← Finset.prod_map_val]
    calc
      (P.1.parts.1.map (fun B ↦ Nat.factorial B.card)).prod =
          ((P.1.parts.1.map Finset.card).map Nat.factorial).prod := by
        rw [Multiset.map_map]
        rfl
      _ = (m.map Nat.factorial).prod := by
        rw [show P.1.parts.1.map Finset.card = Jh P.1 from rfl,
          P.2]
  change
    Fintype.card
      ((∀ s : m.toFinset,
          HW P s.1 ≃ Fin (m.count (s : ℕ))) ×
        (∀ B : P.1.parts, B.1 ≃ Fin B.1.card)) = _
  rw [Fintype.card_prod, Fintype.card_pi, Fintype.card_pi,
    Aaj, A5k]
  simp only [m]
  rw [mul_comm]
def G8 {b n : ℕ} {k : AG b}
    (P : BT n k) (v : Fin n) : P.1.parts :=
  ⟨P.1.part v, P.1.part_mem.mpr (Finset.mem_univ v)⟩
@[simp] theorem Awf {b n : ℕ} {k : AG b}
    (P : BT n k) (v : Fin n) :
    (G8 P v).1 = P.1.part v := rfl
theorem Y7 {b n : ℕ} {k : AG b}
    (P : BT n k) (v : Fin n) :
    v ∈ (G8 P v).1 :=
  P.1.mem_part (Finset.mem_univ v)
theorem kH {b n : ℕ} {k : AG b}
    (P : BT n k) (v : Fin n) (B : P.1.parts)
    (hv : v ∈ B.1) : G8 P v = B := by
  apply Subtype.ext
  exact P.1.part_eq_of_mem B.2 hv
def Kh {b n : ℕ} {k : AG b}
    (P : BT n k) (B : P.1.parts) :
    (AG.sizes k).toFinset := by
  refine ⟨B.1.card, ?_⟩
  apply Multiset.mem_toFinset.mpr
  have hmem : B.1.card ∈ Jh P.1 :=
    Multiset.mem_map.mpr ⟨B.1, B.2, rfl⟩
  simpa only [P.2] using hmem
@[simp] theorem Ajq {b n : ℕ} {k : AG b}
    (P : BT n k) (B : P.1.parts) :
    (Kh P B : ℕ) = B.1.card := rfl
def vk {b n : ℕ} {k : AG b}
    (P : BT n k) (d : LG P) :
    Fin n → Dm (AG.sizes k) := fun v ↦ by
  let B := G8 P v
  let s := Kh P B
  let Bs : HW P s.1 := ⟨B, rfl⟩
  exact ⟨s, d.1 s Bs, d.2 B ⟨v, Y7 P v⟩⟩
def A9d {b n : ℕ} {k : AG b}
    (P : BT n k) (d : LG P) :
    Dm (AG.sizes k) → Fin n := fun y ↦ by
  let s := y.1
  let Bs : HW P s.1 := (d.1 s).symm y.2.1
  let B : P.1.parts := Bs.1
  let x : Fin B.1.card := Fin.cast Bs.2.symm y.2.2
  exact ((d.2 B).symm x).1
theorem A9e {b n : ℕ} {k : AG b}
    (P : BT n k) (d : LG P) :
    Function.LeftInverse (A9d P d)
      (vk P d) := by
  intro v
  let B := G8 P v
  let s := Kh P B
  let Bs : HW P s.1 := ⟨B, rfl⟩
  have hBs : (d.1 s).symm (d.1 s Bs) = Bs :=
    Equiv.symm_apply_apply (d.1 s) Bs
  change
    ((d.2 ((d.1 s).symm (d.1 s Bs)).1).symm
      (Fin.cast ((d.1 s).symm (d.1 s Bs)).2.symm
        (d.2 B ⟨v, Y7 P v⟩))).1 = v
  rw [hBs]
  exact congrArg Subtype.val (Equiv.symm_apply_apply (d.2 B)
    ⟨v, Y7 P v⟩)
def Lk {b n : ℕ} {k : AG b}
    (P : BT n k) (d : LG P) :
    Fin n ≃ Dm (AG.sizes k) where
  toFun := vk P d
  invFun := A9d P d
  left_inv := A9e P d
  right_inv :=
    (A9e P d).rightInverse_of_card_le (by
      rw [Fintype.card_fin, A1d]
      change AG.DK k ≤ n
      rw [P.vertexMass_eq])
abbrev G9 (m : Multiset ℕ) :=
  Σ s : m.toFinset, Fin (m.count (s : ℕ))
noncomputable def kQ
    (m : Multiset ℕ) (s : ℕ) (hs : s ∈ m) :
    {q : G9 m // (q.1 : ℕ) = s} ≃ Fin (m.count s) := by
  classical
  let t : m.toFinset := ⟨s, Multiset.mem_toFinset.mpr hs⟩
  let pin :
      {q : G9 m // (q.1 : ℕ) = s} ≃
        {q : G9 m // q.1 = t} := by
    apply (Equiv.refl (G9 m)).subtypeEquiv
    intro q
    constructor
    · intro h
      apply Subtype.ext
      exact h
    · intro h
      simpa [t] using congrArg (fun u : m.toFinset ↦ (u : ℕ)) h
  exact pin.trans (Equiv.sigmaSubtype t)
theorem A1c (m : Multiset ℕ) (s : ℕ) :
    Fintype.card {q : G9 m // (q.1 : ℕ) = s} =
      m.count s := by
  classical
  by_cases hs : s ∈ m
  · simpa only [Fintype.card_fin] using
      Fintype.card_congr (kQ m s hs)
  · have hcount : m.count s = 0 := Multiset.count_eq_zero.mpr hs
    rw [hcount]
    apply Fintype.card_eq_zero_iff.mpr
    exact ⟨fun q ↦ hs <|
      q.2 ▸ Multiset.mem_toFinset.mp q.1.1.2⟩
abbrev A1G (m : Multiset ℕ) :=
  Σ s : m.toFinset, Σ _j : Fin (m.count (s : ℕ)), Fin s.1
def Am2 (m : Multiset ℕ) :
    Dm m ≃ A1G m where
  toFun y := ⟨y.1, ⟨y.2.1, y.2.2⟩⟩
  invFun y := ⟨y.1, y.2.1, y.2.2⟩
  left_inv y := by rcases y with ⟨s, j, x⟩; rfl
  right_inv y := by rcases y with ⟨s, j, x⟩; rfl
def A0i {m : Multiset ℕ} :
    Dm m → G9 m := fun y ↦ ⟨y.1, y.2.1⟩
theorem A7C {b : ℕ} {k : AG b} {s : ℕ}
    (hs : s ∈ AG.sizes k) : 0 < s := by
  exact Nat.pos_of_ne_zero fun hs0 ↦
    A8M k (hs0 ▸ hs)
def AGj {b : ℕ} (k : AG b)
    (q : G9 (AG.sizes k)) :
    Dm (AG.sizes k) := by
  have hqmem : (q.1 : ℕ) ∈ AG.sizes k :=
    Multiset.mem_toFinset.mp q.1.2
  exact ⟨q.1, q.2, ⟨0, A7C hqmem⟩⟩
@[simp] theorem AxP {b : ℕ}
    (k : AG b)
    (q : G9 (AG.sizes k)) :
    A0i (AGj k q) = q := by
  rfl
def Rw {b n : ℕ} {k : AG b}
    (e : Fin n ≃ Dm (AG.sizes k)) :
    Fin n → G9 (AG.sizes k) :=
  A0i ∘ e
def Pd {b n : ℕ} {k : AG b}
    (e : Fin n ≃ Dm (AG.sizes k))
    (q : G9 (AG.sizes k)) : Fin n :=
  e.symm (AGj k q)
@[simp] theorem AH1 {b n : ℕ}
    {k : AG b}
    (e : Fin n ≃ Dm (AG.sizes k))
    (q : G9 (AG.sizes k)) :
    Rw e (Pd e q) = q := by
  simp [Rw, Pd]
def A7o {b n : ℕ} {k : AG b}
    (e : Fin n ≃ Dm (AG.sizes k)) : Setoid (Fin n) :=
  Setoid.ker (Rw e)
noncomputable def F8 {b n : ℕ} {k : AG b}
    (e : Fin n ≃ Dm (AG.sizes k)) : GD n := by
  classical
  exact Finpartition.ofSetoid (A7o e)
theorem r8 {b n : ℕ}
    {k : AG b}
    (e : Fin n ≃ Dm (AG.sizes k)) (v w : Fin n) :
    w ∈ (F8 e).part v ↔
      Rw e v = Rw e w := by
  classical
  change w ∈ (Finpartition.ofSetoid (A7o e)).part v ↔
    (A7o e) v w
  exact Finpartition.mem_part_ofSetoid_iff_rel
noncomputable def QO {b n : ℕ} {k : AG b}
    (e : Fin n ≃ Dm (AG.sizes k))
    (q : G9 (AG.sizes k)) :
    (F8 e).parts := by
  classical
  exact ⟨(F8 e).part (Pd e q),
    (F8 e).part_mem.mpr
      (Finset.mem_univ (Pd e q))⟩
noncomputable def A0h {b n : ℕ}
    {k : AG b}
    (e : Fin n ≃ Dm (AG.sizes k)) :
    G9 (AG.sizes k) ≃
