section M117
namespace Erdos625
open scoped BigOperators ENNReal
noncomputable section
set_option autoImplicit false
theorem AOZ
    (rho : ENNReal) (hrho : rho ≤ 1) (e : Nat) (he : 1 ≤ e) :
    rho ^ e ≤ rho := by
  obtain ⟨k, rfl⟩ := Nat.exists_eq_add_of_le he
  have hk : rho ^ k ≤ 1 := pow_le_one₀ bot_le hrho
  rw [pow_add, pow_one]
  exact (mul_le_mul_right hk rho).trans_eq (mul_one rho)
theorem Anb
    {Cell DN : Type*}
    [Fintype Cell] [Fintype DN] [DecidableEq DN]
    (allowed : Cell → Finset DN)
    (weight : Cell → DN → ENNReal)
    (U : Nat) (rho : ENNReal)
    (hcard : ∀ c, (allowed c).card ≤ U)
    (R4 : ∀ c e, e ∈ allowed c → weight c e ≤ rho) :
    (∑ choice : KD Cell DN allowed,
      JO allowed weight choice) ≤
        (1 + (U : ENNReal) * rho) ^ Fintype.card Cell := by
  rw [iO]
  calc
    (∏ c, (1 + ∑ e ∈ allowed c, weight c e)) ≤
        ∏ _c : Cell, (1 + (U : ENNReal) * rho) := by
      apply Finset.prod_le_prod'
      intro c _
      apply add_le_add_right
      calc
        (∑ e ∈ allowed c, weight c e) ≤
            ∑ _e ∈ allowed c, rho := by
          exact Finset.sum_le_sum fun e he => R4 c e he
        _ = ((allowed c).card : ENNReal) * rho := by
          simp
        _ ≤ (U : ENNReal) * rho := by
          have hcard' : ((allowed c).card : ENNReal) ≤ (U : ENNReal) := by
            exact_mod_cast hcard c
          simpa [mul_comm] using (mul_le_mul_right hcard' rho)
    _ = (1 + (U : ENNReal) * rho) ^ Fintype.card Cell := by
      simp
theorem AHT
    {Cell DN : Type*}
    [Fintype Cell] [Fintype DN] [DecidableEq DN]
    (allowed : Cell → Finset DN)
    (weight : Cell → DN → ENNReal)
    (exponent : DN → Nat)
    (U : Nat) (rho : ENNReal)
    (hrho : rho ≤ 1)
    (hcard : ∀ c, (allowed c).card ≤ U)
    (K4 : ∀ c e, e ∈ allowed c → 1 ≤ exponent e)
    (R4 : ∀ c e, e ∈ allowed c → weight c e ≤ rho ^ exponent e) :
    (∑ choice : KD Cell DN allowed,
      JO allowed weight choice) ≤
        (1 + (U : ENNReal) * rho) ^ Fintype.card Cell := by
  apply Anb
    allowed weight U rho hcard
  intro c e he
  exact (R4 c e he).trans
    (AOZ rho hrho (exponent e) (K4 c e he))
end
end Erdos625
end M117

section M118
namespace Erdos625
