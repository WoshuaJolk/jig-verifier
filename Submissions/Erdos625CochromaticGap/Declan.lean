      change
        (∑ code : Σ u : V, FH V ell u w,
            K v code.1 * code.2.weight K) =
          ∑ u, K v u * Fe K ell u w
      rw [Fintype.sum_sigma]
      apply Finset.sum_congr rfl
      intro u hu
      change
        (∑ tail : FH V ell u w, K v u * tail.weight K) =
          K v u * Fe K ell u w
