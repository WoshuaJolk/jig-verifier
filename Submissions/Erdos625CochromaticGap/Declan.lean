          ((2 : Real) ^ (s.choose 2))⁻¹ := mul_le_mul_of_nonneg_right main hc
    _ = (n.choose s : Real) * ((2 : Real) ^ (s.choose 2))⁻¹ *
          ((v : Real) / (n : Real)) ^ s := by ring
