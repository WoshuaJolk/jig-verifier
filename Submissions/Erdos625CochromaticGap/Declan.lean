    {A B : Type*} [DecidableEq A] [DecidableEq B]
    (M : Finset (A × B)) :
    (Kw M).card = 2 * M.card := by
  simp [Kw, Nat.mul_comm]
def J6
    {A B : Type*} : ((A × B) × Bool) → A ⊕ B
  | ((a, _), true) => Sum.inl a
  | ((_, b), false) => Sum.inr b
theorem AhP
    {A B : Type*} [Fintype A] [Fintype B]
    [DecidableEq A] [DecidableEq B]
    (M : Finset (A × B)) (hM : DZ M)
    (S : A ⊕ B → A ⊕ B → ℝ≥0∞) (b : ℝ≥0∞)
    (hS : ∀ v, ∑ w, S v w ≤ b) (L : ℕ) :
