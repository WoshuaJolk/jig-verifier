  Aku code.chain hcut.AFC
theorem AJY
    {A B : Type*} [Fintype A] [Fintype B]
    [DecidableEq A] [DecidableEq B]
    {C M : Finset (A × B)} {code : Jt A B}
    (hM : DZ M)
    (hcut : QX C M code) :
    code.W0 ≤ Fintype.card (A ⊕ B) := by
  rw [hcut.A1T]
