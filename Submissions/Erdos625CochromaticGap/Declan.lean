section M160
namespace Erdos625
open scoped BigOperators ENNReal
noncomputable section
def Tv {V : Type*} [Fintype V]
    (K : V → V → ℝ≥0∞) {ell : ℕ}
    (vertex : Fin (ell + 1) → V) : ℝ≥0∞ :=
  ∏ i : Fin ell, K (vertex i.castSucc) (vertex i.succ)
def wL {V : Type*}
    (K : V → V → ℝ≥0∞) : V → List V → ℝ≥0∞
  | _, [] => 1
  | v, w :: tail => K v w * wL K w tail
theorem Ark
    {V : Type*} [Fintype V] [DecidableEq V]
    (K : V → V → ℝ≥0∞) :
    (∀ (ell : ℕ) (vertex : Fin (ell + 1) → V),
      Tv K vertex ≤
        Fe K ell (vertex 0) (vertex (Fin.last ell))) ∧
    (∀ (L ell : ℕ), 0 < ell → ell ≤ L →
      ∀ vertex : Fin (ell + 1) → V,
        Tv K vertex ≤
          JK K L (vertex 0) (vertex (Fin.last ell))) ∧
    (∀ (v : V) (tail : List V),
      wL K v tail ≤
        Ek K tail.length v) := by
  have hPath : ∀ (ell : ℕ) (vertex : Fin (ell + 1) → V),
      Tv K vertex ≤
        Fe K ell (vertex 0) (vertex (Fin.last ell)) := by
    intro ell vertex
    induction' ell with ell ih
    · simp +decide [Tv, Fe]
    · have hsplit : Tv K vertex =
          K (vertex 0) (vertex 1) *
            Tv K (fun i : Fin (ell + 1) => vertex i.succ) := by
        simpa [Tv, Fin.castSucc_succ] using
          (Fin.prod_univ_succ
            (fun i : Fin (ell + 1) =>
              K (vertex i.castSucc) (vertex i.succ)))
      rw [hsplit]
      refine (mul_le_mul_right
        (ih (fun i : Fin (ell + 1) => vertex i.succ))
        (K (vertex 0) (vertex 1))).trans ?_
      simpa [Fe, Fin.succ_last] using
        (Finset.single_le_sum
          (s := Finset.univ)
          (f := fun u : V =>
            K (vertex 0) u *
              Fe K ell u (vertex (Fin.last (ell + 1))))
          (fun u _ => bot_le) (Finset.mem_univ (vertex 1)))
  have oF : ∀ (L ell : ℕ), 0 < ell → ell ≤ L →
      ∀ vertex : Fin (ell + 1) → V,
        Tv K vertex ≤
          JK K L (vertex 0) (vertex (Fin.last ell)) := by
    intro L ell hpos hle vertex
    refine (hPath ell vertex).trans ?_
    unfold JK
    have hmem : ell - 1 ∈ Finset.range L :=
      Finset.mem_range.mpr
        (show ell - 1 < L from
          lt_of_lt_of_le (Nat.pred_lt hpos.ne') hle)
    have A6I :
        Fe K ((ell - 1) + 1)
            (vertex 0) (vertex (Fin.last ell)) ≤
          ∑ j ∈ Finset.range L,
            Fe K (j + 1)
              (vertex 0) (vertex (Fin.last ell)) :=
      Finset.single_le_sum
        (s := Finset.range L)
        (f := fun j => Fe K (j + 1)
          (vertex 0) (vertex (Fin.last ell)))
        (fun j _ => bot_le) hmem
    simpa only [Nat.sub_add_cancel hpos] using A6I
  have ASR : ∀ (v : V) (tail : List V),
      wL K v tail ≤
        Ek K tail.length v := by
    intro v tail
    induction tail generalizing v with
    | nil => rfl
    | cons w tail ih =>
        simp only [wL, List.length_cons,
          Ek]
        exact (mul_le_mul_right (ih w) (K v w)).trans
          (Finset.single_le_sum
            (s := Finset.univ)
            (f := fun u : V => K v u * Ek K tail.length u)
            (fun u _ => bot_le) (Finset.mem_univ w))
  exact ⟨hPath, oF, ASR⟩
end
