      (u + d).choose 2 = u.choose 2 + d * u + d.choose 2 := by
    induction d with
    | zero => simp
    | succ d ih =>
        rw [Nat.add_succ, Nat.choose_succ_succ]
        simp only [Nat.choose_one_right]
        rw [ih]
        have hd : (d + 1).choose 2 = d + d.choose 2 := by
          rw [Nat.choose_succ_succ]
          simp
