section M127
namespace Erdos625
noncomputable section
abbrev j3 (A B : Type*) :=
  (A → Bool) × (B → Bool)
def UL (A B : Type*) :
    j3 A B ≃ (A ⊕ B → Bool) where
  toFun sigma := Sum.elim sigma.1 sigma.2
  invFun tau := (fun a ↦ tau (Sum.inl a), fun b ↦ tau (Sum.inr b))
  left_inv sigma := by
    rcases sigma with ⟨sigmaA, sigmaB⟩
    rfl
  right_inv tau := by
    funext x
    cases x <;> rfl
def RG
    {A B : Type*} (r : A → B → ℕ) :=
  {sigma : j3 A B //
    ∀ a b, 2 ≤ r a b → sigma.1 a = sigma.2 b}
def VQ {A B : Type*} (r : A → B → ℕ) :
    SimpleGraph (A ⊕ B) :=
  CX fun a b ↦ 2 ≤ r a b
theorem A6x
    {A B : Type*} (r : A → B → ℕ) :
    VQ r = F3 r := rfl
theorem A0N
    {A B : Type*} (r : A → B → ℕ)
    (sigma : j3 A B) :
    (∀ a b, 2 ≤ r a b → sigma.1 a = sigma.2 b) ↔
      ∀ u v, (VQ r).Adj u v →
        UL A B sigma u =
          UL A B sigma v := by
  constructor
  · intro h u v huv
    cases u with
    | inl a =>
        cases v with
        | inl a' =>
            simp [VQ, CX,
              SimpleGraph.fromRel_adj] at huv
        | inr b =>
            exact h a b (by
              simpa [VQ, CX,
                SimpleGraph.fromRel_adj] using huv)
    | inr b =>
        cases v with
        | inl a =>
            exact (h a b (by
              simpa [VQ, CX,
                SimpleGraph.fromRel_adj] using huv)).symm
        | inr b' =>
            simp [VQ, CX,
              SimpleGraph.fromRel_adj] at huv
  · intro h a b hab
    exact h (Sum.inl a) (Sum.inr b) (by
      simpa [VQ, CX,
        SimpleGraph.fromRel_adj] using hab)
def ALx
    {A B : Type*}
    [Fintype A] [Fintype B] [DecidableEq A] [DecidableEq B]
    (r : A → B → ℕ) :
    RG r ≃
      Vr r where
  toFun sigma := ⟨UL A B sigma.1, by
    have hpair :=
      (A0N r sigma.1).mp sigma.2
    intro u v huv
    exact hpair u v (by
      simpa only [A6x] using huv)⟩
  invFun tau :=
    ⟨(UL A B).symm tau.1,
      (A0N r
        ((UL A B).symm tau.1)).mpr (by
          intro u v huv
          have htau := tau.2 u v (by
            simpa only [A6x]
              using huv)
          simpa only [Equiv.apply_symm_apply] using htau)⟩
  left_inv sigma := by
    apply Subtype.ext
    exact (UL A B).symm_apply_apply sigma.1
  right_inv tau := by
    apply Subtype.ext
    exact (UL A B).apply_symm_apply tau.1
theorem AgX
    {A B : Type*}
    [Fintype A] [Fintype B] [DecidableEq A] [DecidableEq B]
    (r : A → B → ℕ) :
    Nat.card (RG r) =
      Nat.card (Vr r) := by
  exact Nat.card_congr (ALx r)
theorem Avt
    {A B : Type*}
    [Fintype A] [Fintype B] [DecidableEq A] [DecidableEq B]
    (r : A → B → ℕ) :
    Nat.card (RG r) =
      2 ^ Nat.card (F3 r).ConnectedComponent := by
  classical
  let e : RG r ≃
      Zp (VQ r) := {
    toFun := fun sigma ↦
      ⟨UL A B sigma.1,
        (A0N r sigma.1).mp sigma.2⟩
    invFun := fun tau ↦
      ⟨(UL A B).symm tau.1,
        (A0N r
          ((UL A B).symm tau.1)).mpr (by
            simpa only [Equiv.apply_symm_apply] using tau.2)⟩
    left_inv := by
      intro sigma
      apply Subtype.ext
      exact (UL A B).symm_apply_apply sigma.1
    right_inv := by
      intro tau
      apply Subtype.ext
      exact (UL A B).apply_symm_apply tau.1 }
  calc
    Nat.card (RG r) =
        Nat.card (Zp (VQ r)) :=
      Nat.card_congr e
    _ = 2 ^ Nat.card (VQ r).ConnectedComponent := by
      simpa only [Nat.card_eq_fintype_card] using
        A6m
          (VQ r)
    _ = 2 ^ Nat.card (F3 r).ConnectedComponent := by
      rw [A6x]
end
end Erdos625
