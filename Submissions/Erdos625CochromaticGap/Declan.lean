    (KW L q).1 ≃ {v : Fin n // L.1 v = q} := by
  classical
  apply (Equiv.refl (Fin n)).subtypeEquiv
  intro v
  change v ∈ (Gp L).part (LV L q) ↔ _
  rw [Wf,
    Wm]
  exact eq_comm
theorem vP
    {b n : ℕ} {k : AG b}
    (L : Ac n k) (q : Bl k) :
    (KW L q).1.card = AO k q := by
  calc
    (KW L q).1.card =
        Fintype.card {v : Fin n // L.1 v = q} := by
      simpa only [Fintype.card_coe] using
        Fintype.card_congr (AhL L q)
    _ = EH L.1 q := W5 L.1 q
    _ = AO k q := L.2 q
noncomputable def Rk
    {b n : ℕ} {k : AG b}
    (L : Ac n k) :
    Bl k ≃ (Gp L).parts := by
  classical
  apply Equiv.ofBijective (KW L)
  constructor
  · intro q r hqr
    have hmem : LV L q ∈
        (Gp L).part (LV L r) := by
      change LV L q ∈ (KW L r).1
      rw [← hqr]
      exact (Gp L).mem_part (Finset.mem_univ _)
    have Ad8 :=
      (Wf L
        (LV L r) (LV L q)).mp hmem
    simpa [Wm] using Ad8.symm
  · intro B
    obtain ⟨v, hv⟩ := (Gp L).nonempty_of_mem_parts B.2
    let q := L.1 v
    refine ⟨q, Subtype.ext ?_⟩
    change (Gp L).part (LV L q) = B.1
    have hrep : LV L q ∈
        (Gp L).part v :=
      (Wf L v
        (LV L q)).mpr (by
          simp [q, Wm])
    calc
      (Gp L).part (LV L q) =
          (Gp L).part v :=
        ((Gp L).mem_part_iff_part_eq_part
          (Finset.mem_univ _) (Finset.mem_univ _)).mp hrep
      _ = B.1 := (Gp L).part_eq_of_mem B.2 hv
@[simp] theorem AF8
    {b n : ℕ} {k : AG b}
    (L : Ac n k) (q : Bl k) :
    Rk L q = KW L q := rfl
noncomputable def A7i
    {b n : ℕ} {k : AG b}
    (L : Ac n k) (s : ℕ) :
    {q : Bl k // (q.1 : ℕ) = s} ≃
      {B : (Gp L).parts // B.1.card = s} := by
  classical
  apply (Rk L).subtypeEquiv
  intro q
  change (q.1 : ℕ) = s ↔ (KW L q).1.card = s
  rw [vP]
  rfl
theorem AMI
    {b n : ℕ} {k : AG b}
    (L : Ac n k) (s : ℕ) :
    (Jh (Gp L)).count s =
      (AG.sizes k).count s := by
  classical
  calc
    (Jh (Gp L)).count s =
        Fintype.card {B : (Gp L).parts // B.1.card = s} :=
      (A9E (Gp L) s).symm
    _ = Fintype.card {q : Bl k // (q.1 : ℕ) = s} :=
      (Fintype.card_congr
        (A7i L s)).symm
    _ = (AG.sizes k).count s :=
      A1c (AG.sizes k) s
noncomputable def Mv
    {b n : ℕ} {k : AG b}
    (L : Ac n k) : BT n k := by
  refine ⟨Gp L, ?_⟩
  apply Multiset.ext.mpr
  intro s
  exact AMI L s
theorem AFF
    {b n : ℕ} {k : AG b}
    (x : FN n k) (v : Fin n) :
    (Gp (JN x)).part v =
      x.1.1.part v := by
  classical
  ext w
  rw [Wf,
    AEe]
  change
    LQ x (G8 x.1 v) =
      LQ x (G8 x.1 w) ↔
      G8 x.1 w = G8 x.1 v
  constructor
  · intro h
    exact ((LQ x).injective h).symm
  · intro h
    exact congrArg (LQ x) h.symm
theorem AhK
    {b n : ℕ} {k : AG b}
    (x : FN n k) :
    Gp (JN x) = x.1.1 := by
  classical
  apply Finpartition.ext
  apply Finset.ext
  intro B
  constructor
  · intro hB
    obtain ⟨v, hv⟩ :=
      (Gp (JN x)).nonempty_of_mem_parts hB
    have hpart :
        (Gp (JN x)).part v = B :=
      (Gp (JN x)).part_eq_of_mem hB hv
    have hBP : B = x.1.1.part v :=
      hpart.symm.trans
        (AFF x v)
    rw [hBP]
    exact x.1.1.part_mem.mpr (Finset.mem_univ v)
  · intro hB
    obtain ⟨v, hv⟩ := x.1.1.nonempty_of_mem_parts hB
    have hpart : x.1.1.part v = B := x.1.1.part_eq_of_mem hB hv
    have hBK : B =
        (Gp (JN x)).part v :=
      hpart.symm.trans
        (AFF x v).symm
    rw [hBK]
    exact (Gp (JN x)).part_mem.mpr
      (Finset.mem_univ v)
theorem A0M
    {b n : ℕ} {k : AG b}
    (x : FN n k) :
    Mv (JN x) = x.1 := by
  apply Subtype.ext
  exact AhK x
noncomputable def A6w
    {b n : ℕ} {k : AG b}
    (L : Ac n k) :
    Om (Mv L) := fun s =>
  (A7i L s.1).symm.trans
    (kQ (AG.sizes k) s.1
      (Multiset.mem_toFinset.mp s.2))
theorem AhM
    {b n : ℕ} {k : AG b}
    (L : Ac n k) (q : Bl k) :
    A6w L q.1
      ⟨KW L q, by simpa [AO] using vP L q⟩ = q.2 := by
  let F := A7i L (q.1 : ℕ)
  let Bq : {B : (Gp L).parts // B.1.card = (q.1 : ℕ)} :=
    ⟨KW L q, by simpa [AO] using vP L q⟩
  have hF : F ⟨q, rfl⟩ = Bq := by
    apply Subtype.ext
    rfl
  have hFinv : F.symm Bq = ⟨q, rfl⟩ := by
    rw [← hF]
    exact F.symm_apply_apply ⟨q, rfl⟩
  change
    (kQ (AG.sizes k) (q.1 : ℕ)
      (Multiset.mem_toFinset.mp q.1.2)) (F.symm Bq) = q.2
  rw [hFinv]
  rcases q with ⟨s, j⟩
  rfl
noncomputable def g9
    {b n : ℕ} {k : AG b}
    (L : Ac n k) : FN n k :=
  ⟨Mv L, A6w L⟩
theorem A6W
    {b n : ℕ} {k : AG b}
    (P : BT n k) (d : Om P)
    (s : (AG.sizes k).toFinset)
    (j : Fin ((AG.sizes k).count (s : ℕ)))
    (B : P.1.parts) (hs : Kh P B = s)
    (UC : d s
      (⟨B, congrArg Subtype.val hs⟩ : HW P s.1) = j) :
    LQ ⟨P, d⟩ B = ⟨s, j⟩ := by
  change
    (Sigma.mk (Kh P B)
      (d (Kh P B)
        (⟨B, rfl⟩ : HW P (Kh P B).1)) :
      Bl k) = ⟨s, j⟩
  cases hs
  simpa using UC
theorem Aep
    {b n : ℕ} {k : AG b}
    (L : Ac n k) (q : Bl k) :
    LQ (g9 L)
      (KW L q) = q := by
  rcases q with ⟨s, j⟩
  let B := KW L ⟨s, j⟩
  have hs : Kh (Mv L) B = s := by
    apply Subtype.ext
    change B.1.card = (s : ℕ)
    change (KW L ⟨s, j⟩).1.card = (s : ℕ)
    simpa [AO] using vP L ⟨s, j⟩
  have UC := AhM L ⟨s, j⟩
  apply A6W
    (Mv L) (A6w L) s j B hs
  simpa only [B] using UC
theorem Aes
    {b n : ℕ} {k : AG b}
    (L : Ac n k) (v : Fin n) :
    R5 (g9 L) v = L.1 v := by
  let q := L.1 v
  have hmem : v ∈ (KW L q).1 := by
    change v ∈ (Gp L).part (LV L q)
    rw [Wf]
    exact Wm L q
  have hpart : G8 (Mv L) v =
      KW L q :=
    kH (Mv L) v
      (KW L q) hmem
  change LQ (g9 L)
    (G8 (Mv L) v) = L.1 v
  rw [hpart]
  simpa only [q] using
    Aep L q
theorem AEF
    {b n : ℕ} {k : AG b}
    (L : Ac n k) :
    JN (g9 L) = L := by
  apply Subtype.ext
  funext v
  exact Aes L v
theorem Aer
    {b n : ℕ} {k : AG b} :
    Function.Injective
      (JN (n := n) (k := k)) := by
  intro x y hxy
  rcases x with ⟨P, d⟩
  rcases y with ⟨Q, e⟩
  have hP : P = Q := by
    calc
      P = Mv (JN ⟨P, d⟩) :=
        (A0M ⟨P, d⟩).symm
      _ = Mv (JN ⟨Q, e⟩) :=
        congrArg Mv hxy
      _ = Q := A0M ⟨Q, e⟩
  cases hP
  have hfun : R5 ⟨P, d⟩ = R5 ⟨P, e⟩ := by
    exact congrArg Subtype.val hxy
  have hde : d = e := by
    funext s
    apply Equiv.ext
    intro Bs
    obtain ⟨v, hv⟩ := P.1.nonempty_of_mem_parts Bs.1.2
    have hpart : G8 P v = Bs.1 :=
      kH P v Bs.1 hv
    have hs : Kh P Bs.1 = s := by
      apply Subtype.ext
      change Bs.1.1.card = (s : ℕ)
      exact Bs.2
    have hEd : LQ ⟨P, d⟩ Bs.1 = ⟨s, d s Bs⟩ := by
      apply A6W P d s (d s Bs) Bs.1 hs
      have hBs :
          (⟨Bs.1, congrArg Subtype.val hs⟩ : HW P s.1) = Bs := by
        apply Subtype.ext
        rfl
      rw [hBs]
    have hEe : LQ ⟨P, e⟩ Bs.1 = ⟨s, e s Bs⟩ := by
      apply A6W P e s (e s Bs) Bs.1 hs
      have hBs :
          (⟨Bs.1, congrArg Subtype.val hs⟩ : HW P s.1) = Bs := by
        apply Subtype.ext
        rfl
      rw [hBs]
    have hmap := congrFun hfun v
    change LQ ⟨P, d⟩ (G8 P v) =
      LQ ⟨P, e⟩ (G8 P v) at hmap
    rw [hpart, hEd, hEe] at hmap
    apply Fin.ext
    exact congrArg (fun z : Bl k => (z.2 : ℕ)) hmap
  cases hde
  rfl
theorem AhN
    {b n : ℕ} {k : AG b}
    (x : FN n k) :
    g9 (JN x) = x := by
  apply Aer
  rw [AEF]
noncomputable def r5
    {b n : ℕ} (k : AG b) :
    FN n k ≃ Ac n k where
  toFun := JN
  invFun := g9
  left_inv := AhN
  right_inv := AEF
@[simp] theorem AvU
    {b n : ℕ} (k : AG b) (x : FN n k) :
    r5 k x =
      JN x := rfl
@[simp] theorem AvV
    {b n : ℕ} (k : AG b) (L : Ac n k) :
    (r5 k).symm L =
      g9 L := rfl
def g8
    {b n : ℕ} {k : AG b}
    (G : LabeledGraph n) (L : Ac n k)
    (τ : Bl k → Bool) : Prop :=
  ∀ q : Bl k,
    match τ q with
    | false => G.IsIndepSet ((KW L q).1 : Set (Fin n))
    | true => G.IsClique ((KW L q).1 : Set (Fin n))
theorem AF9
    {b n : ℕ} {k : AG b}
    (x : FN n k) (q : Bl k) :
    (KW (JN x) q).1 =
      (Ri x q).1 := by
  ext v
  change
    v ∈ (Gp (JN x)).part
      (LV (JN x) q) ↔
      v ∈ (Ri x q).1
  rw [Wf]
  constructor
  · intro h
    have hrep : R5 x
        (LV (JN x) q) = q :=
      Wm (JN x) q
    exact (A0D x v q).mp (hrep.symm.trans h).symm
  · intro h
    have hv : R5 x v = q :=
      (A0D x v q).mpr h
    have hrep : R5 x
        (LV (JN x) q) = q :=
      Wm (JN x) q
    exact hrep.trans hv.symm
def fq
    {b n : ℕ} {k : AG b}
    (x : FN n k) (σ : x.1.1.parts → Bool) :
    Bl k → Bool :=
  fun q => σ (Ri x q)
def rF
    {b n : ℕ} {k : AG b}
    (L : Ac n k) (τ : Bl k → Bool) :
    (Mv L).1.parts → Bool :=
  fun B => τ ((Rk L).symm B)
theorem Ajz
    {b n : ℕ} {k : AG b}
    (G : LabeledGraph n) (x : FN n k)
    (σ : x.1.1.parts → Bool) :
    QK G x.1 σ ↔
      g8 G (JN x)
        (fq x σ) := by
  constructor
  · intro h q
    unfold QK at h
    have hq := h (Ri x q)
    have hpart := AF9 x q
    cases hsign : σ (Ri x q) with
    | false => simpa [fq, hsign, hpart] using hq
    | true => simpa [fq, hsign, hpart] using hq
  · intro h B
    unfold g8 at h
    let q := LQ x B
    have hB : Ri x q = B := by
      dsimp [q, Ri]
      exact (LQ x).symm_apply_apply B
    have hq := h q
    have hpart := AF9 x q
    cases hsign : σ B with
    | false => simpa [fq, hsign, hB, hpart] using hq
    | true => simpa [fq, hsign, hB, hpart] using hq
theorem Awk
    {b n : ℕ} {k : AG b}
    (G : LabeledGraph n) (L : Ac n k)
    (τ : Bl k → Bool) :
    QK G (Mv L)
      (rF L τ) ↔ g8 G L τ := by
  constructor
  · intro h q
    unfold QK at h
    have hq := h (KW L q)
    have hinv : (Rk L).symm (KW L q) = q := by
      change (Rk L).symm
        (Rk L q) = q
      exact (Rk L).symm_apply_apply q
    cases hsign : τ q with
    | false => simpa [rF, hsign, hinv] using hq
    | true => simpa [rF, hsign, hinv] using hq
  · intro h B
    unfold g8 at h
    let q := (Rk L).symm B
    have hB : KW L q = B := by
      change Rk L q = B
      exact (Rk L).apply_symm_apply B
    have hq := h q
    cases hsign : τ q with
    | false => simpa [rF, q, hsign, hB] using hq
    | true => simpa [rF, q, hsign, hB] using hq
theorem AvX
    {b n : ℕ} {k : AG b}
    (x : FN n k) (q : Bl k) (v : Fin n) :
    R5 x v = q ↔ v ∈ (Ri x q).1 :=
  A0D x v q
theorem AhA
    {b n : ℕ} {k : AG b}
    (L M : Ac n k)
    (q r : Bl k) :
    J5 L.1 M.1 q r =
      BT.overlapCellCount
        (Mv L) (Mv M)
        (KW L q) (KW M r) := by
  unfold J5 BT.overlapCellCount TK
  congr 1
  ext v
  simp only [Finset.mem_filter, Finset.mem_univ, true_and, Finset.mem_inter]
  constructor
  · rintro ⟨hvq, hvr⟩
    constructor
    · change v ∈ (Gp L).part (LV L q)
      exact (Wf L
        (LV L q) v).mpr (by
          simpa [Wm] using hvq.symm)
    · change v ∈ (Gp M).part (LV M r)
      exact (Wf M
        (LV M r) v).mpr (by
          simpa [Wm] using hvr.symm)
  · rintro ⟨hvq, hvr⟩
    constructor
    · have h := (Wf L
        (LV L q) v).mp hvq
      simpa [Wm] using h.symm
    · have h := (Wf M
        (LV M r) v).mp hvr
      simpa [Wm] using h.symm
end
end Erdos625
end M123

section M124
namespace Erdos625
open MeasureTheory
open scoped BigOperators ENNReal
noncomputable section
noncomputable def bC {α : Type*}
    (A : Set α) (x : α) : ℕ := by
  classical
  exact if x ∈ A then 1 else 0
noncomputable def AAo {α : Type*} [Fintype α]
    [MeasurableSpace α] (μ : Measure α) (X : α → ℕ) : ENNReal :=
  ∑ x : α, (X x : ENNReal) ^ 2 * μ {x}
theorem AnD
    {α : Type*} [Fintype α] [MeasurableSpace α]
    [MeasurableSingletonClass α]
    (μ : Measure α) (A B : Set α) :
    (∑ x : α,
      (bC A x : ENNReal) *
        (bC B x : ENNReal) * μ {x}) =
      μ (A ∩ B) := by
  classical
  let T := (Finset.univ : Finset α).filter fun x => x ∈ A ∩ B
  calc
    (∑ x : α,
      (bC A x : ENNReal) *
        (bC B x : ENNReal) * μ {x}) =
        ∑ x : α, if x ∈ A ∩ B then μ {x} else 0 := by
          apply Finset.sum_congr rfl
          intro x hx
          by_cases hA : x ∈ A <;> by_cases hB : x ∈ B <;>
            simp [bC, hA, hB]
    _ = ∑ x ∈ T, μ {x} := by
          simp only [T, Finset.sum_filter]
    _ = μ (T : Set α) := by
          rw [MeasureTheory.sum_measure_singleton]
    _ = μ (A ∩ B) := by
          congr 1
          ext x
          simp [T]
def sW {b n : ℕ} {k : AG b}
    (P Q : BT n k)
    (σ : P.1.parts → Bool) (τ : Q.1.parts → Bool) :
    Set (LabeledGraph n) :=
  TP P σ ∩ TP Q τ
theorem AmZ
    {b n : ℕ} {k : AG b}
    (G : LabeledGraph n) (P : BT n k)
    (σ : P.1.parts → Bool) :
    NA G P σ =
      bC (TP P σ) G := by
  classical
  simp [NA, bC,
    TP]
theorem Ao1
    {b n : ℕ} {k : AG b}
    (P Q : BT n k)
    (σ : P.1.parts → Bool) (τ : Q.1.parts → Bool) :
    (∑ G : LabeledGraph n,
      (NA G P σ : ENNReal) *
        (NA G Q τ : ENNReal) *
          randomGraphMeasure n {G}) =
      randomGraphMeasure n (sW P Q σ τ) := by
  rw [sW]
  simp_rw [AmZ]
  exact AnD
    (randomGraphMeasure n) _ _
theorem AmG
    {b n : ℕ} (G : LabeledGraph n) (k : AG b) :
    (PZ G k : ENNReal) ^ 2 =
      ∑ w : OQ n k, ∑ w' : OQ n k,
        (NA G w.1 w.2 : ENNReal) *
          (NA G w'.1 w'.2 : ENNReal) := by
  classical
  have hcount :
      (PZ G k : ENNReal) =
        ∑ w : OQ n k,
          (NA G w.1 w.2 : ENNReal) := by
    calc
      (PZ G k : ENNReal) =
          ∑ P : BT n k, ∑ σ : P.1.parts → Bool,
            (NA G P σ : ENNReal) := by
              rw [AGp]
              simp only [Nat.cast_sum]
      _ = ∑ w : OQ n k,
          (NA G w.1 w.2 : ENNReal) := by
              rw [Fintype.sum_sigma]
  rw [hcount, pow_two, Finset.sum_mul_sum]
noncomputable def J8 {b : ℕ}
    (n : ℕ) (k : AG b) : ENNReal :=
  AAo (randomGraphMeasure n) fun G => PZ G k
theorem AmX
    {b : ℕ} (n : ℕ) (k : AG b) :
    J8 n k =
      ∑ w : OQ n k, ∑ w' : OQ n k,
        randomGraphMeasure n
          (sW w.1 w'.1 w.2 w'.2) := by
  classical
  unfold J8 AAo
  simp_rw [AmG]
  calc
    (∑ G : LabeledGraph n,
      (∑ w : OQ n k, ∑ w' : OQ n k,
        (NA G w.1 w.2 : ENNReal) *
          (NA G w'.1 w'.2 : ENNReal)) *
        randomGraphMeasure n {G}) =
      ∑ G : LabeledGraph n,
        ∑ w : OQ n k, ∑ w' : OQ n k,
          (NA G w.1 w.2 : ENNReal) *
            (NA G w'.1 w'.2 : ENNReal) *
              randomGraphMeasure n {G} := by
        simp_rw [Finset.sum_mul]
    _ = ∑ w : OQ n k, ∑ w' : OQ n k,
        ∑ G : LabeledGraph n,
          (NA G w.1 w.2 : ENNReal) *
            (NA G w'.1 w'.2 : ENNReal) *
              randomGraphMeasure n {G} := by
        rw [Finset.sum_comm]
        apply Finset.sum_congr rfl
        intro w hw
        rw [Finset.sum_comm]
    _ = ∑ w : OQ n k, ∑ w' : OQ n k,
        randomGraphMeasure n
          (sW w.1 w'.1 w.2 w'.2) := by
        apply Finset.sum_congr rfl
        intro w hw
        apply Finset.sum_congr rfl
        intro w' hw'
        rw [Ao1]
end
end Erdos625
end M124

section M125
namespace Erdos625
open MeasureTheory ProbabilityTheory
noncomputable section
private theorem Aio
    {Ω : Type*} [Fintype Ω] [MeasurableSpace Ω]
    [MeasurableSingletonClass Ω] [Nonempty Ω]
    (μ : Measure Ω) [IsProbabilityMeasure μ]
    (hμ : ∀ x y : Ω, μ {x} = μ {y}) :
    μ = uniformOn Set.univ := by
  classical
  apply Measure.ext_of_singleton
  intro x
  have hsumμ : ∑ y : Ω, μ {y} = 1 := by
    calc
      ∑ y : Ω, μ {y} = μ (Finset.univ : Finset Ω) := by
        simp
      _ = 1 := by simp
  have hsumU : ∑ y : Ω, uniformOn (Set.univ : Set Ω) {y} = 1 := by
    calc
      ∑ y : Ω, uniformOn (Set.univ : Set Ω) {y} =
          uniformOn (Set.univ : Set Ω) (Finset.univ : Finset Ω) := by
        simp
      _ = 1 := by simp
  have hμcard : (Fintype.card Ω : ENNReal) * μ {x} = 1 := by
    calc
      (Fintype.card Ω : ENNReal) * μ {x} = ∑ _y : Ω, μ {x} := by
        simp
      _ = ∑ y : Ω, μ {y} := by
        apply Finset.sum_congr rfl
        intro y _
        exact (hμ y x).symm
      _ = 1 := hsumμ
  have hUcard :
      (Fintype.card Ω : ENNReal) * uniformOn (Set.univ : Set Ω) {x} = 1 := by
    have hU : ∀ y : Ω,
        uniformOn (Set.univ : Set Ω) {y} =
          uniformOn (Set.univ : Set Ω) {x} := by
      intro y
      simp [uniformOn_univ]
    calc
