theorem ADI
    (m h : Nat) (hhalf : 2 * h < m) :
    h * ((3 * m - 1) / 4) ≤ h * m - h * (h + 1) / 2 := by
  by_cases hh : h = 0
  · simp [hh]
  let penalty := h * (h + 1) / 2
  have hh_m : h + 1 ≤ m := by omega
  have Aby : penalty ≤ h * (h + 1) := by
    dsimp only [penalty]
    exact Nat.div_le_self _ _
  have A5p : penalty ≤ h * m :=
    Aby.trans (Nat.mul_le_mul_left h hh_m)
  have hsub : (h * m - penalty) + penalty = h * m :=
    Nat.sub_add_cancel A5p
  have hstep : 2 * (h + 1) ≤ m + 1 := by omega
  have AdF : 2 * (h * (h + 1)) ≤ h * (m + 1) := by
    simpa [mul_assoc, mul_comm, mul_left_comm] using
      Nat.mul_le_mul_left h hstep
  have Abw : penalty * 2 ≤ h * (h + 1) := by
    dsimp only [penalty]
    exact Nat.div_mul_le_self _ _
  have Abx : 4 * penalty ≤ 2 * (h * (h + 1)) := by
    have hmul := Nat.mul_le_mul_left 2 Abw
    omega
  have Abv : 4 * penalty ≤ h * (m + 1) :=
    Abx.trans AdF
  have h3m : 1 ≤ 3 * m := by omega
  have ARn : (3 * m - 1) + 1 = 3 * m :=
    Nat.sub_add_cancel h3m
  have hmain : h * (3 * m - 1) ≤ 4 * (h * m - penalty) := by
    nlinarith [hsub, Abv, ARn]
  have AcK := Nat.div_mul_le_self (3 * m - 1) 4
  have AcL :
      4 * (h * ((3 * m - 1) / 4)) ≤ h * (3 * m - 1) := by
    have hmul := Nat.mul_le_mul_left h AcK
    simpa [mul_assoc, mul_comm, mul_left_comm] using hmul
  have hfour := AcL.trans hmain
  dsimp only [penalty] at hfour ⊢
  omega
