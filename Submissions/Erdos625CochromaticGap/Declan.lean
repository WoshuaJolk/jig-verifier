          C * (u : ℝ) / Real.log (n : ℝ) +
            (n : ℝ) ^ (1 / 3 : ℝ) := by
  refine ⟨14 * Real.log 4 + 2, by positivity, ?_⟩
  filter_upwards
      [AkC,
        AfF,
        Filter.eventually_gt_atTop 1] with n hcount hlogCube hn u _hu
  have VA : 0 < Real.log (n : ℝ) := by
    exact Real.log_pos (by exact_mod_cast hn)
  by_cases DH : u < Ip n
