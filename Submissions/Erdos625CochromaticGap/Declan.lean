section M047
namespace Erdos625
open scoped BigOperators
set_option autoImplicit false
abbrev Ej (alpha : Nat) (A8 : 5 < alpha)
    (k : AG (alpha + 1)) (L : Bh) :=
  {S : Bm
      (fun i : Fin 4 => Bz alpha A8 k i)
      (fun j : Fin 4 => Bz alpha A8 k j) //
    S.typeTable = L.toFun}
theorem AKQ
    (alpha : Nat) (A8 : 5 < alpha)
    (k : AG (alpha + 1)) (L : Bh) :
    Fintype.card (Ej alpha A8 k L) *
        KQ L =
      P8 alpha A8 k L *
        Oy alpha A8 k L := by
  simpa [Ej, KQ,
    P8, Oy,
    M7, E3,
    El] using
    (A9D
      L.toFun
      (fun i : Fin 4 => Bz alpha A8 k i)
      (fun j : Fin 4 => Bz alpha A8 k j))
end Erdos625
