          Real.log (((m + 1 : ℕ) + 1 : ℕ) : ℝ) := by
      apply Real.log_le_log
      · exact_mod_cast hm
      · exact_mod_cast (Nat.le_succ (m + 1))
    have yF : 0 ≤ Real.log ((m + 1 : ℕ) : ℝ) := by
      exact Real.log_nonneg (by exact_mod_cast hm)
    have AUr : Real.log (2 * Real.pi) ≤ 7 := by
      have hpos : 0 < 2 * Real.pi := by positivity
      have hlog := Real.log_le_sub_one_of_pos hpos
      have hpi := Real.pi_lt_four
      linarith
    have hInv : 1 / (12 * ((m + 1 : ℕ) : ℝ)) ≤ 1 / 12 := by
      have Att : (1 : ℝ) ≤ (m + 1 : ℕ) := by exact_mod_cast hm
      rw [div_le_div_iff_of_pos_left (by norm_num : (0 : ℝ) < 1)
        (by positivity : (0 : ℝ) < 12 * (m + 1 : ℕ))
        (by norm_num : (0 : ℝ) < 12)]
      nlinarith
    rw [jA hm]
    simp only [CH, JY] at hR ⊢
    linarith
theorem AIc (m : ℕ) :
    |Real.log (m.factorial : ℝ) - Dr m| ≤
      CH m := by
  rw [abs_of_nonneg (sub_nonneg.mpr (b9 m))]
  linarith [g3 m]
noncomputable def Ve {b : ℕ} (k : Fin b → ℕ) : ℝ :=
  ∑ i, Real.log ((k i).factorial : ℝ)
noncomputable def TJ {b : ℕ} (k : Fin b → ℕ) : ℝ :=
  ∑ i, Dr (k i)
noncomputable def rV {b : ℕ} (k : Fin b → ℕ) : ℝ :=
  ∑ i, CH (k i)
theorem AG2 {b : ℕ}
    (k : Fin b → ℕ) :
    TJ k ≤ Ve k := by
  classical
  simp only [TJ, Ve]
  exact Finset.sum_le_sum fun i _ ↦ b9 (k i)
theorem Ajj {b : ℕ}
    (k : Fin b → ℕ) :
    Ve k ≤
      TJ k + rV k := by
  classical
  simp only [Ve, TJ,
    rV, ← Finset.sum_add_distrib]
  exact Finset.sum_le_sum fun i _ ↦
    g3 (k i)
theorem AqQ {b n : ℕ}
    (k : Fin b → ℕ) (hk : ∀ i, k i ≤ n) :
    |Ve k - TJ k| ≤
      (b : ℝ) * (Real.log ((n + 1 : ℕ) : ℝ) + 4) := by
  classical
  have d9 :
      0 ≤ Ve k - TJ k :=
    sub_nonneg.mpr (AG2 k)
  rw [abs_of_nonneg d9]
  have AXE :
      Ve k - TJ k ≤
        rV k := by
    linarith [Ajj k]
  calc
    Ve k - TJ k ≤
        rV k := AXE
    _ ≤ ∑ _i : Fin b, (Real.log ((n + 1 : ℕ) : ℝ) + 4) := by
      simp only [rV]
      apply Finset.sum_le_sum
      intro i _hi
      have hcast : (((k i + 1 : ℕ) : ℝ)) ≤ ((n + 1 : ℕ) : ℝ) := by
        exact_mod_cast Nat.succ_le_succ (hk i)
      have hlog := Real.log_le_log (by positivity) hcast
      simp only [CH]
      linarith
    _ = (b : ℝ) * (Real.log ((n + 1 : ℕ) : ℝ) + 4) := by
      simp only [Finset.sum_const, Finset.card_univ, Fintype.card_fin,
        nsmul_eq_mul]
@[simp] theorem Awa (k : Fin 0 → ℕ) :
    Ve k = 0 := by
  simp [Ve]
@[simp] theorem AwY (k : Fin 0 → ℕ) :
    TJ k = 0 := by
  simp [TJ]
end Erdos625
end M022

section M023
namespace Erdos625
open scoped BigOperators
noncomputable section
def YM {b : ℕ}
    (n : ℕ) (k : AG b) : ℝ :=
  Dr n -
    ∑ i : Fin b,
      (k i : ℝ) * Real.log (Nat.factorial (i.1 + 1) : ℝ) -
    TJ k -
    (AG.Eo k : ℝ) * Real.log 2
theorem AG4 {b : ℕ}
    (n : ℕ) (k : AG b) :
    QI n k ≤
      YM n k + CH n := by
  have hn := g3 n
  have hk := AG2 k
  simp only [Ve] at hk
  unfold QI YM
  linarith
theorem AfP
    {b : ℕ} (n : ℕ) (k : AG b)
    (hMass : AG.DK k = n) :
    Real.log (JT n k).toReal ≤
      YM n k + CH n := by
  rw [AEQ n k hMass]
  exact AG4 n k
theorem Aj8
    {b : ℕ} (n : ℕ) (k : AG b) (L : ℝ)
    (hMass : AG.DK k = n)
    (hL : YM n k + CH n ≤ L) :
    JT n k ≤ ENNReal.ofReal (Real.exp L) := by
  have hpos : 0 < JT n k :=
    A7G n k hMass
  have htop : JT n k ≠ ⊤ := by
    rw [rP n k
      (kG n k hMass)]
    finiteness
  have hlog :
      Real.log (JT n k).toReal ≤ L :=
    (AfP
      n k hMass).trans hL
  have hreal : (JT n k).toReal ≤ Real.exp L :=
    (Real.log_le_iff_le_exp (ENNReal.toReal_pos hpos.ne' htop)).mp hlog
  apply (ENNReal.toReal_le_toReal htop (by finiteness)).mp
  rw [ENNReal.toReal_ofReal (Real.exp_nonneg L)]
  exact hreal
end
end Erdos625
end M023

section M024
namespace Erdos625
open scoped BigOperators
noncomputable section
def FZ (s : ℕ) : ℝ :=
  Real.log (Nat.factorial s : ℝ) + (s.choose 2 : ℝ) * Real.log 2
def K7 {b : ℕ}
    (n : ℕ) (k : AG b) : ℝ :=
  Dr n -
    ∑ i : Fin b,
      (Dr (k i) +
        (k i : ℝ) * FZ (i.1 + 1))
theorem AAi (m : ℕ) :
    Dr m = (m : ℝ) * Real.log (m : ℝ) - m := by
  rcases m with _ | m
  · simp [Dr]
  · exact jA (Nat.succ_pos m)
def ro {b : ℕ}
    (n : ℕ) (k : AG b) : ℝ :=
  (n : ℝ) * Real.log (n : ℝ) - n +
    (AG.D8 k : ℝ) -
    ∑ i : Fin b,
      (k i : ℝ) *
        (Real.log (k i : ℝ) + FZ (i.1 + 1))
theorem AFq {b : ℕ}
    (n : ℕ) (k : AG b) :
    K7 n k = ro n k := by
  have hsum :
      (∑ i : Fin b,
        (Dr (k i) +
          (k i : ℝ) * FZ (i.1 + 1))) =
        (∑ i : Fin b,
          ((k i : ℝ) * Real.log (k i : ℝ) +
            (k i : ℝ) * FZ (i.1 + 1))) -
          ∑ i : Fin b, (k i : ℝ) := by
    calc
      _ = ∑ i : Fin b,
          (((k i : ℝ) * Real.log (k i : ℝ) +
              (k i : ℝ) * FZ (i.1 + 1)) -
            (k i : ℝ)) := by
        apply Finset.sum_congr rfl
        intro i _
        rw [AAi]
        ring
      _ = _ := by
        simp
  rw [K7, ro,
    AAi,
    AG.A6z, Nat.cast_sum, hsum]
  ring
theorem A7U {b : ℕ}
    (n : ℕ) (k : AG b) :
    YM n k = K7 n k := by
  have hsum :
      (∑ i : Fin b,
        (Dr (k i) +
          (k i : ℝ) * FZ (i.1 + 1))) =
        (∑ i : Fin b, Dr (k i)) +
          (∑ i : Fin b,
            (k i : ℝ) * Real.log (Nat.factorial (i.1 + 1) : ℝ)) +
          (∑ i : Fin b,
            (k i : ℝ) * ((i.1 + 1).choose 2 : ℝ) * Real.log 2) := by
    calc
      _ = ∑ i : Fin b,
          ((Dr (k i) +
              (k i : ℝ) * Real.log (Nat.factorial (i.1 + 1) : ℝ)) +
            (k i : ℝ) * ((i.1 + 1).choose 2 : ℝ) * Real.log 2) := by
        apply Finset.sum_congr rfl
        intro i _
        unfold FZ
        ring
      _ = _ := by rw [Finset.sum_add_distrib, Finset.sum_add_distrib]
  rw [YM, K7,
    AG.AAu, hsum]
  simp only [TJ, Nat.cast_sum, Nat.cast_mul,
    Finset.sum_mul]
  ring
theorem Awb {b : ℕ}
    (n : ℕ) (k : AG b) :
    QI n k ≤
      K7 n k + CH n := by
  rw [← A7U]
  exact AG4 n k
end
end Erdos625
end M024

section M025
namespace Erdos625
open scoped BigOperators
noncomputable section
abbrev EK (b : ℕ) := Fin b → ℝ
namespace EK
def lC {b : ℕ} (x : EK b) : Prop :=
  ∀ i, 0 ≤ x i
def D8 {b : ℕ} (x : EK b) : ℝ :=
  ∑ i : Fin b, x i
def DK {b : ℕ} (x : EK b) : ℝ :=
  ∑ i : Fin b, ((i.1 + 1 : ℕ) : ℝ) * x i
def QY {b : ℕ} (x : EK b)
    (n parts : ℝ) : Prop :=
  lC x ∧ D8 x = parts ∧ DK x = n
theorem QY.nonnegative {b : ℕ} {x : EK b}
    {n parts : ℝ} (h : QY x n parts) : lC x :=
  h.1
theorem QY.partCount_eq {b : ℕ} {x : EK b}
    {n parts : ℝ} (h : QY x n parts) : D8 x = parts :=
  h.2.1
theorem QY.vertexMass_eq {b : ℕ} {x : EK b}
    {n parts : ℝ} (h : QY x n parts) : DK x = n :=
  h.2.2
def ofNat {b : ℕ} (k : AG b) : EK b :=
  fun i ↦ (k i : ℝ)
@[simp] theorem ofNat_apply {b : ℕ} (k : AG b) (i : Fin b) :
    ofNat k i = (k i : ℝ) :=
  rfl
theorem Aeh {b : ℕ} (k : AG b) :
    lC (ofNat k) := by
  intro i
  change (0 : ℝ) ≤ (k i : ℝ)
  exact_mod_cast Nat.zero_le (k i)
@[simp] theorem AFE {b : ℕ} (k : AG b) :
    D8 (ofNat k) = (AG.D8 k : ℝ) := by
  rw [AG.A6z, Nat.cast_sum]
  rfl
@[simp] theorem Apw {b : ℕ} (k : AG b) :
    DK (ofNat k) = (AG.DK k : ℝ) := by
  rw [AG.A18, Nat.cast_sum]
  apply Finset.sum_congr rfl
  intro i _
  simp only [ofNat_apply, Nat.cast_mul, Nat.cast_add,
    Nat.cast_one]
theorem Aed {b n parts : ℕ} (k : AG b)
    (C7 : AG.D8 k = parts)
    (hmass : AG.DK k = n) :
    QY (ofNat k) (n : ℝ) (parts : ℝ) := by
  refine ⟨Aeh k, ?_, ?_⟩
  · simpa only [AFE] using congrArg Nat.cast C7
  · simpa only [Apw] using congrArg Nat.cast hmass
@[simp] theorem AhW (x : EK 0) :
    D8 x = 0 := by
  simp [D8]
@[simp] theorem Apv (x : EK 0) :
    DK x = 0 := by
  simp [DK]
theorem AvP (x : EK 0) :
    QY x 0 0 := by
  refine ⟨?_, AhW x, Apv x⟩
  intro i
  exact Fin.elim0 i
end EK
def Zj (s : ℕ) (x : ℝ) : ℝ :=
  x * (Real.log x + FZ s)
@[simp] theorem Ax3 (s : ℕ) :
    Zj s 0 = 0 := by
  simp [Zj]
def RA {b : ℕ}
    (n : ℝ) (x : EK b) : ℝ :=
  n * Real.log n - n + EK.D8 x -
    ∑ i : Fin b, Zj (i.1 + 1) (x i)
theorem Ajt {b : ℕ}
    (n : ℕ) (k : AG b) :
    RA (n : ℝ) (EK.ofNat k) =
      K7 n k := by
  calc
    RA (n : ℝ) (EK.ofNat k) =
        ro n k := by
      simp only [RA, ro,
        EK.AFE,
        EK.ofNat_apply, Zj]
    _ = K7 n k :=
      (AFq n k).symm
@[simp] theorem Awh (n : ℝ)
    (x : EK 0) :
    RA n x = n * Real.log n - n := by
  simp [RA]
@[simp] theorem Awi
    (x : EK 0) :
    RA 0 x = 0 := by
  simp
end
end Erdos625
end M025

section M026
namespace Erdos625
open scoped BigOperators ENNReal
noncomputable section
def aF (n b : ℕ) : Finset (AG b) := by
  classical
  exact Fintype.piFinset fun _ : Fin b ↦ Finset.range (n + 1)
@[simp] theorem Ag0 {n b : ℕ}
    (k : AG b) :
    k ∈ aF n b ↔ ∀ i, k i ≤ n := by
  classical
  simp [aF]
theorem AG.coordinate_le_vertexMass {b : ℕ}
    (k : AG b) (i : Fin b) :
    k i ≤ AG.DK k := by
  rw [AG.A18]
  have hTerm : k i ≤ (i.1 + 1) * k i := by
    rw [Nat.add_mul, one_mul]
    exact Nat.le_add_left _ _
  exact hTerm.trans
    (Finset.single_le_sum (fun j _ ↦ Nat.zero_le ((j.1 + 1) * k j))
      (Finset.mem_univ i))
theorem Ag1 {n b : ℕ}
    {k : AG b}
    (hmass : AG.DK k = n) :
    k ∈ aF n b := by
  rw [Ag0]
  intro i
  rw [← hmass]
  exact k.coordinate_le_vertexMass i
theorem AKJ (n b : ℕ) :
    (aF n b).card = (n + 1) ^ b := by
  classical
  simp [aF]
def Nm (n b parts : ℕ) :
    Finset (AG b) := by
  classical
  exact (aF n b).filter fun k ↦
    AG.DK k = n ∧
      AG.D8 k = parts
@[simp] theorem A6f {n b parts : ℕ}
    (k : AG b) :
    k ∈ Nm n b parts ↔
      AG.DK k = n ∧
        AG.D8 k = parts := by
  classical
  rw [Nm, Finset.mem_filter]
  constructor
  · exact fun h ↦ h.2
  · intro h
    exact ⟨Ag1 h.1, h⟩
theorem Afz {n b parts : ℕ}
    {k : AG b}
    (hmass : AG.DK k = n)
    (C7 : AG.D8 k = parts) :
    k ∈ Nm n b parts :=
  (A6f k).2 ⟨hmass, C7⟩
theorem AKG (n b parts : ℕ) :
    (Nm n b parts).card ≤ (n + 1) ^ b := by
  classical
  calc
    (Nm n b parts).card ≤
        (aF n b).card := by
      exact Finset.card_filter_le _ _
    _ = (n + 1) ^ b := AKJ n b
def RK {n : ℕ} (G : LabeledGraph n)
    (b parts : ℕ) : ℕ :=
  ∑ k ∈ Nm n b parts, rO G k
def RM (n b parts : ℕ) : ENNReal :=
  ∑ G : LabeledGraph n,
    (RK G b parts : ENNReal) *
      randomGraphMeasure n {G}
theorem AJm (n b parts : ℕ) :
    RM n b parts =
      ∑ k ∈ Nm n b parts,
        JT n k := by
  classical
  unfold RM RK
    JT
  simp_rw [Nat.cast_sum, Finset.sum_mul]
  rw [Finset.sum_comm]
end
end Erdos625
end M026

section M027
namespace Erdos625
open scoped BigOperators ENNReal
noncomputable section
theorem AJo
    (n b parts : ℕ) (C : ENNReal)
    (h : ∀ k ∈ Nm n b parts,
      JT n k ≤ C) :
    RM n b parts ≤
      ((Nm n b parts).card : ENNReal) * C := by
  rw [AJm]
  calc
    (∑ k ∈ Nm n b parts,
        JT n k) ≤
        ∑ _k ∈ Nm n b parts, C := by
      exact Finset.sum_le_sum fun k hk ↦ h k hk
    _ = ((Nm n b parts).card : ENNReal) * C := by
      simp [nsmul_eq_mul]
theorem AJn
    (n b parts : ℕ) (C : ENNReal)
    (h : ∀ k ∈ Nm n b parts,
      JT n k ≤ C) :
    RM n b parts ≤
      (((n + 1) ^ b : ℕ) : ENNReal) * C := by
  refine (AJo n b parts C h).trans ?_
  gcongr
  exact_mod_cast AKG n b parts
end
end Erdos625
end M027

section M028
namespace Erdos625
noncomputable section
theorem A8n
    (n b parts : ℕ) (L : ℝ)
    (hL : ∀ k ∈ Nm n b parts,
      YM n k + CH n ≤ L) :
    RM n b parts ≤
      (((n + 1) ^ b : ℕ) : ENNReal) * ENNReal.ofReal (Real.exp L) := by
  apply AJn
  intro k hk
  have hMass : AG.DK k = n :=
    (A6f k).1 hk |>.1
  exact Aj8
    n k L hMass (hL k hk)
end
end Erdos625
end M028

section M029
namespace Erdos625
noncomputable section
def A8R
    (n b parts : ℕ) (L : ℝ) : Prop :=
  ∀ p ∈ Nm n b parts,
    K7 n p ≤ L
theorem AOQ (n b : ℕ) :
    (((n + 1) ^ b : ℕ) : ENNReal) =
      ENNReal.ofReal (((n : ℝ) + 1) ^ b) := by
  rw [← ENNReal.ofReal_natCast ((n + 1) ^ b)]
  congr 1
  norm_num
theorem A8o
    (n b parts : ℕ) (L : ℝ)
    (hL : A8R n b parts L) :
    RM n b parts ≤
      ENNReal.ofReal (((n : ℝ) + 1) ^ b) *
        ENNReal.ofReal
          (Real.exp (L + CH n)) := by
  have jO :=
    A8n
      n b parts (L + CH n) (by
        intro p hp
        rw [A7U]
        exact add_le_add (hL p hp) (le_refl _))
  rw [AOQ] at jO
  exact jO
def AIU
    {X : Type*} [TopologicalSpace X]
    (n b parts : ℕ) (embed : AG b → X)
    (objective : X → ℝ) (L : ℝ) : Prop :=
  Continuous objective ∧
    (∀ p ∈ Nm n b parts,
      K7 n p ≤ objective (embed p)) ∧
    ∀ x, objective x ≤ L
theorem AqY
    {X : Type*} [TopologicalSpace X]
    (n b parts : ℕ) (embed : AG b → X)
    (objective : X → ℝ) (L : ℝ)
    (hL : AIU
      n b parts embed objective L) :
    RM n b parts ≤
      ENNReal.ofReal (((n : ℝ) + 1) ^ b) *
        ENNReal.ofReal
          (Real.exp (L + CH n)) := by
  apply A8o n b parts L
  intro p hp
  exact (hL.2.1 p hp).trans (hL.2.2 (embed p))
end
end Erdos625
end M029

section M030
namespace Erdos625
open scoped BigOperators
noncomputable section
def D9 {b : ℕ} (i : Fin b) : ℝ :=
  ((i.1 + 1 : ℕ) : ℝ)
def Ro {b : ℕ} (i : Fin b) : ℝ :=
  -FZ (i.1 + 1)
def LX {b : ℕ} (t : ℝ) (i : Fin b) : ℝ :=
  Real.exp (Ro i + t * D9 i)
def GK (b : ℕ) (t : ℝ) : ℝ :=
  ∑ i : Fin b, LX t i
theorem rT {b : ℕ} (t : ℝ) (i : Fin b) :
    0 < LX t i :=
  Real.exp_pos _
theorem kC {b : ℕ} (hb : 0 < b) (t : ℝ) :
    0 < GK b t := by
  let i0 : Fin b := ⟨0, hb⟩
  exact Finset.sum_pos'
    (fun i _ ↦ (rT t i).le)
    ⟨i0, Finset.mem_univ i0, rT t i0⟩
def LY {b : ℕ} (t : ℝ) (i : Fin b) : ℝ :=
  LX t i / GK b t
theorem kF {b : ℕ} (hb : 0 < b)
    (t : ℝ) (i : Fin b) :
    0 < LY t i :=
  div_pos (rT t i) (kC hb t)
theorem AHb {b : ℕ} (hb : 0 < b) (t : ℝ) :
    ∑ i : Fin b, LY t i = 1 := by
  simp only [LY]
  rw [← Finset.sum_div, GK]
  exact div_self (kC hb t).ne'
theorem AfQ {b : ℕ} (hb : 0 < b)
    (t : ℝ) (i : Fin b) :
    Real.log (LY t i) =
      Ro i + t * D9 i -
        Real.log (GK b t) := by
  rw [LY,
    Real.log_div (rT t i).ne'
      (kC hb t).ne',
    LX, Real.log_exp]
theorem Ak2 {x y : ℝ}
    (hx : 0 ≤ x) (hy : 0 < y) :
    -x * Real.log x + x * Real.log y ≤ y - x := by
  rcases eq_or_lt_of_le hx with rfl | hxPos
  · simpa using hy.le
  · have hLog := Real.log_le_sub_one_of_pos (div_pos hy hxPos)
    have Fv := mul_le_mul_of_nonneg_left hLog hx
    rw [Real.log_div hy.ne' hxPos.ne'] at Fv
    field_simp [hxPos.ne'] at Fv
    linarith
def Ws {b : ℕ}
    (parts t : ℝ) (i : Fin b) : ℝ :=
  parts * LY t i
theorem AFx {b : ℕ} (hb : 0 < b)
    {parts : ℝ} (C7 : 0 < parts) (t : ℝ) (i : Fin b) :
    0 < Ws parts t i :=
  mul_pos C7 (kF hb t i)
theorem AHa {b : ℕ} (hb : 0 < b)
    (parts t : ℝ) :
    ∑ i : Fin b, Ws parts t i = parts := by
  change (∑ i : Fin b, parts * LY t i) = parts
  rw [← Finset.mul_sum,
    AHb hb, mul_one]
theorem AER {b : ℕ} (hb : 0 < b)
    {parts : ℝ} (C7 : 0 < parts) (t : ℝ) (i : Fin b) :
    Real.log (Ws parts t i) =
      Real.log parts + Ro i + t * D9 i -
        Real.log (GK b t) := by
  rw [Ws,
    Real.log_mul C7.ne' (kF hb t i).ne',
    AfQ hb]
  ring
theorem Ans {b : ℕ} (hb : 0 < b)
    {parts : ℝ} (C7 : 0 < parts)
    (x : EK b)
    (hx : EK.lC x)
    (hcount : EK.D8 x = parts)
    (t : ℝ) :
    ∑ i : Fin b,
        (-x i * Real.log (x i) +
          x i * Real.log (Ws parts t i)) ≤ 0 := by
  calc
    ∑ i : Fin b,
        (-x i * Real.log (x i) +
          x i * Real.log (Ws parts t i)) ≤
        ∑ i : Fin b, (Ws parts t i - x i) := by
      apply Finset.sum_le_sum
      intro i _
      exact Ak2
        (hx i) (AFx hb C7 t i)
    _ = 0 := by
      rw [Finset.sum_sub_distrib, AHa hb,
        ← EK.D8, hcount, sub_self]
def Gz (b : ℕ) (n parts t : ℝ) : ℝ :=
  n * Real.log n - n + parts - parts * Real.log parts +
    parts * Real.log (GK b t) - t * n
theorem A7R {b : ℕ} (hb : 0 < b)
    {n parts : ℝ} (C7 : 0 < parts)
    (x : EK b)
    (hx : EK.QY x n parts)
    (t : ℝ) :
    RA n x ≤ Gz b n parts t := by
  have oM := Ans hb C7 x
    hx.nonnegative hx.partCount_eq t
  have ATa :
      (∑ i : Fin b,
        (-x i * Real.log (x i) +
          x i * Real.log (Ws parts t i))) =
        -(∑ i : Fin b, x i * Real.log (x i)) +
          Real.log parts * EK.D8 x +
          (∑ i : Fin b, x i * Ro i) +
          t * EK.DK x -
          Real.log (GK b t) *
            EK.D8 x := by
    calc
      _ = ∑ i : Fin b,
          (-(x i * Real.log (x i)) +
            (Real.log parts * x i + x i * Ro i +
              t * (D9 i * x i) -
                Real.log (GK b t) * x i)) := by
        apply Finset.sum_congr rfl
        intro i _
        rw [AER hb C7]
        ring
      _ = _ := by
        simp only [Finset.sum_add_distrib, Finset.sum_sub_distrib,
          Finset.sum_neg_distrib, Finset.mul_sum,
          EK.D8,
          EK.DK,
          D9]
        ring
  rw [ATa, hx.partCount_eq, hx.vertexMass_eq] at oM
  simp only [Ro, mul_neg, Finset.sum_neg_distrib] at oM
  rw [RA, Gz, hx.partCount_eq]
  simp only [Zj]
  have hCost :
      (∑ i : Fin b,
        x i * (Real.log (x i) + FZ (i.1 + 1))) =
        (∑ i : Fin b, x i * Real.log (x i)) +
          ∑ i : Fin b, x i * FZ (i.1 + 1) := by
    simp only [mul_add, Finset.sum_add_distrib]
  rw [hCost]
  linarith
theorem AjR
    {n b parts : ℕ} (hb : 0 < b) (C7 : 0 < parts)
    (p : AG b) (hp : p ∈ Nm n b parts)
    (t : ℝ) :
    K7 n p ≤
      Gz b (n : ℝ) (parts : ℝ) t := by
  have ABw := (A6f p).1 hp
  have A3J := EK.Aed p
    ABw.2 ABw.1
  rw [← Ajt n p]
  exact A7R hb
    (by exact_mod_cast C7) _ A3J t
theorem AjW
    {n b parts : ℕ} (hb : 0 < b) (C7 : 0 < parts) (t : ℝ) :
    A8R n b parts
      (Gz b (n : ℝ) (parts : ℝ) t) := by
  intro p hp
  exact AjR hb C7 p hp t
theorem AJp
    {n b parts : ℕ} (hb : 0 < b) (C7 : 0 < parts) (t : ℝ) :
    RM n b parts ≤
      ENNReal.ofReal (((n : ℝ) + 1) ^ b) *
        ENNReal.ofReal
          (Real.exp
            (Gz b (n : ℝ) (parts : ℝ) t +
              CH n)) :=
  A8o n b parts
    (Gz b (n : ℝ) (parts : ℝ) t)
    (AjW
      hb C7 t)
end
end Erdos625
end M030

section M031
namespace Erdos625
open scoped BigOperators
noncomputable section
def gX (b : ℕ) (t : ℝ) : ℝ :=
  ∑ i : Fin b, D9 i * LX t i
def kD (b : ℕ) (t : ℝ) : ℝ :=
  ∑ i : Fin b, D9 i ^ 2 * LX t i
def Db (b : ℕ) (t : ℝ) : ℝ :=
  gX b t / GK b t
def Vd (b : ℕ) (t : ℝ) : ℝ :=
  ∑ i : Fin b,
    LY t i * (D9 i - Db b t) ^ 2
theorem A7M (b : ℕ) (t : ℝ) :
    Db b t =
      ∑ i : Fin b, LY t i * D9 i := by
  rw [Db, gX]
  simp only [LY]
  rw [Finset.sum_div]
  apply Finset.sum_congr rfl
  intro i _
  ring
theorem Ano (b : ℕ) (t : ℝ) :
    (∑ i : Fin b, LY t i * D9 i ^ 2) =
      kD b t / GK b t := by
  rw [kD]
  simp only [LY]
  rw [Finset.sum_div]
  apply Finset.sum_congr rfl
  intro i _
  ring
theorem ACw {b : ℕ}
    (t : ℝ) (i : Fin b) :
    HasDerivAt (fun u ↦ LX u i)
      (D9 i * LX t i) t := by
  simpa only [LX, Function.const_apply, Pi.add_apply,
    id_eq, zero_add, one_mul, mul_one, mul_comm] using
    ((hasDerivAt_const t (Ro i)).add
      ((hasDerivAt_id t).mul_const (D9 i))).exp
theorem ACu (b : ℕ) (t : ℝ) :
    HasDerivAt (GK b) (gX b t) t := by
  change HasDerivAt
    (fun u ↦ ∑ i : Fin b, LX u i)
    (∑ i : Fin b, D9 i * LX t i) t
  exact HasDerivAt.fun_sum fun i _ ↦
    ACw t i
theorem AYe (b : ℕ) (t : ℝ) :
    HasDerivAt (gX b)
      (kD b t) t := by
  change HasDerivAt
    (fun u ↦ ∑ i : Fin b,
      D9 i * LX u i)
    (∑ i : Fin b,
      D9 i ^ 2 * LX t i) t
  apply HasDerivAt.fun_sum
  intro i _
  simpa only [pow_two, mul_assoc] using
    (ACw t i).const_mul (D9 i)
theorem A4k {b : ℕ} (hb : 0 < b)
    (t : ℝ) :
    HasDerivAt (fun u ↦ Real.log (GK b u))
      (Db b t) t := by
  simpa only [Db] using
    (ACu b t).log
      (kC hb t).ne'
theorem Ar6 {b : ℕ} (hb : 0 < b)
    (t : ℝ) :
    deriv (fun u ↦ Real.log (GK b u)) t =
      Db b t :=
  (A4k hb t).deriv
theorem AYf {b : ℕ} (hb : 0 < b)
    (n parts t : ℝ) :
    HasDerivAt (Gz b n parts)
      (parts * Db b t - n) t := by
  unfold Gz
  apply HasDerivAt.sub
  · have h :=
      (hasDerivAt_const t
        (n * Real.log n - n + parts - parts * Real.log parts)).add
        ((A4k hb t).const_mul parts)
    exact (h.congr_deriv (zero_add _)).congr_of_eventuallyEq
      (Filter.Eventually.of_forall fun _ ↦ rfl)
  · have h := (hasDerivAt_id t).mul_const n
    exact (h.congr_deriv (one_mul n)).congr_of_eventuallyEq
      (Filter.Eventually.of_forall fun _ ↦ rfl)
theorem AMw {b : ℕ} (hb : 0 < b)
    (n parts t : ℝ) :
    deriv (Gz b n parts) t =
      parts * Db b t - n :=
  (AYf hb n parts t).deriv
theorem AjX {b : ℕ} (hb : 0 < b) (t : ℝ) :
    Vd b t =
      kD b t / GK b t -
        Db b t ^ 2 := by
  calc
    Vd b t = ∑ i : Fin b,
        (LY t i * D9 i ^ 2 -
          2 * Db b t *
            (LY t i * D9 i) +
          Db b t ^ 2 * LY t i) := by
      apply Finset.sum_congr rfl
      intro i _
      ring
    _ = (∑ i : Fin b,
          LY t i * D9 i ^ 2) -
        2 * Db b t *
          (∑ i : Fin b, LY t i * D9 i) +
        Db b t ^ 2 *
          (∑ i : Fin b, LY t i) := by
      simp only [Finset.sum_add_distrib, Finset.sum_sub_distrib,
        Finset.mul_sum]
    _ = kD b t / GK b t -
        Db b t ^ 2 := by
      rw [Ano,
        ← A7M,
        AHb hb]
      ring
theorem zC {b : ℕ} (hb : 0 < b) (t : ℝ) :
    HasDerivAt (Db b) (Vd b t) t := by
  have dH :=
    (AYe b t).div
      (ACu b t)
      (kC hb t).ne'
  have ARw :
      Vd b t =
        (kD b t * GK b t -
          gX b t * gX b t) /
            GK b t ^ 2 := by
    rw [AjX hb, Db]
    field_simp [(kC hb t).ne']
  rw [ARw]
  exact dH
theorem AMu {b : ℕ} (hb : 0 < b) (t : ℝ) :
    deriv (Db b) t = Vd b t :=
  (zC hb t).deriv
theorem A7O {b : ℕ} (hb : 2 ≤ b) (t : ℝ) :
    0 < Vd b t := by
  have hbPos : 0 < b := lt_of_lt_of_le Nat.zero_lt_two hb
  have yI : 1 < b := lt_of_lt_of_le Nat.one_lt_two hb
  let i0 : Fin b := ⟨0, hbPos⟩
  let i1 : Fin b := ⟨1, yI⟩
  have AWe : D9 i0 = 1 := by
    norm_num [D9, i0]
  have AWf : D9 i1 = 2 := by
    norm_num [D9, i1]
  have AWg : D9 i0 ≠ D9 i1 := by
    rw [AWe, AWf]
    norm_num
  rw [Vd]
  apply Finset.sum_pos'
  · intro i _
    exact mul_nonneg (kF hbPos t i).le (sq_nonneg _)
  · by_cases h0 : D9 i0 = Db b t
    · have h1 : D9 i1 ≠ Db b t := by
        intro h1
        exact AWg (h0.trans h1.symm)
      refine ⟨i1, Finset.mem_univ i1,
        mul_pos (kF hbPos t i1) ?_⟩
      exact sq_pos_of_ne_zero (sub_ne_zero.mpr h1)
    · refine ⟨i0, Finset.mem_univ i0,
        mul_pos (kF hbPos t i0) ?_⟩
      exact sq_pos_of_ne_zero (sub_ne_zero.mpr h0)
theorem AYd {b : ℕ} (hb : 0 < b)
    (n parts t : ℝ) :
    HasDerivAt (fun u ↦ parts * Db b u - n)
      (parts * Vd b t) t :=
  ((zC hb t).const_mul parts).sub_const n
theorem AMt {b : ℕ} (hb : 0 < b)
    (n parts t : ℝ) :
    deriv (fun u ↦ parts * Db b u - n) t =
      parts * Vd b t :=
  (AYd hb n parts t).deriv
theorem Amt {b : ℕ} (hb : 2 ≤ b)
    (n parts : ℝ) (C7 : 0 < parts) :
    StrictMono (fun t ↦ parts * Db b t - n) := by
  have hbPos : 0 < b := lt_of_lt_of_le Nat.zero_lt_two hb
  apply strictMono_of_deriv_pos
  intro t
  rw [AMt hbPos]
  exact mul_pos C7 (A7O hb t)
theorem Axb {b : ℕ} (hb : 2 ≤ b)
    (n parts : ℝ) (C7 : 0 < parts) :
    StrictMono (fun t ↦ deriv (Gz b n parts) t) := by
  have hbPos : 0 < b := lt_of_lt_of_le Nat.zero_lt_two hb
  simpa only [AMw hbPos] using
    Amt hb n parts C7
end
end Erdos625
end M031

section M032
namespace Erdos625
open scoped BigOperators
noncomputable section
def Kz {b : ℕ} (parts t : ℝ) : EK b :=
  fun i ↦ Ws parts t i
@[simp] theorem AjS {b : ℕ}
    (parts t : ℝ) (i : Fin b) :
    Kz parts t i = Ws parts t i :=
  rfl
theorem AjU {b : ℕ} (hb : 0 < b)
    {parts : ℝ} (C7 : 0 ≤ parts) (t : ℝ) :
    EK.lC
      (Kz (b := b) parts t) := by
  intro i
  exact mul_nonneg C7 (kF hb t i).le
theorem AwW {b : ℕ} (hb : 0 < b)
    {parts : ℝ} (C7 : 0 < parts) (t : ℝ) (i : Fin b) :
    0 < Kz parts t i :=
  AFx hb C7 t i
theorem AFu {b : ℕ} (hb : 0 < b)
    (parts t : ℝ) :
    EK.D8
        (Kz (b := b) parts t) = parts := by
  exact AHa hb parts t
theorem AFv {b : ℕ} (parts t : ℝ) :
    EK.DK
        (Kz (b := b) parts t) =
      parts * Db b t := by
  calc
    EK.DK
        (Kz (b := b) parts t) =
        ∑ i : Fin b,
          D9 i * (parts * LY t i) := by
      rfl
    _ = parts *
        (∑ i : Fin b, LY t i * D9 i) := by
      rw [Finset.mul_sum]
      apply Finset.sum_congr rfl
      intro i _
      ring
    _ = parts * Db b t := by
      rw [← A7M]
theorem AjT {b : ℕ} (hb : 0 < b)
    {n parts t : ℝ} (C7 : 0 < parts)
    (hmass : parts * Db b t = n) :
    EK.QY
      (Kz (b := b) parts t) n parts := by
  refine ⟨AjU hb C7.le t,
    AFu hb parts t, ?_⟩
  rw [AFv]
  exact hmass
theorem Akj {b : ℕ} (hb : 0 < b)
    {parts : ℝ} (C7 : 0 < parts) (t : ℝ) (i : Fin b) :
    Zj (i.1 + 1)
        (Kz parts t i) =
      Kz parts t i *
        (Real.log parts + t * D9 i -
          Real.log (GK b t)) := by
  rw [Zj, AjS,
    AER hb C7]
  simp only [Ro]
  ring
theorem A7S
    {b : ℕ} (hb : 0 < b) {n parts t : ℝ} (C7 : 0 < parts)
    (hmass : parts * Db b t = n) :
    RA n (Kz (b := b) parts t) =
      Gz b n parts t := by
  have hCost :
      (∑ i : Fin b,
        Zj (i.1 + 1)
          (Kz parts t i)) =
        Real.log parts *
            EK.D8
              (Kz (b := b) parts t) +
          t * EK.DK
              (Kz (b := b) parts t) -
          Real.log (GK b t) *
            EK.D8
              (Kz (b := b) parts t) := by
    calc
      _ = ∑ i : Fin b,
          Kz parts t i *
            (Real.log parts + t * D9 i -
              Real.log (GK b t)) := by
        apply Finset.sum_congr rfl
        intro i _
        exact Akj hb C7 t i
      _ = _ := by
        calc
          _ = ∑ i : Fin b,
              (Real.log parts * Kz parts t i +
                t * (D9 i * Kz parts t i) -
                Real.log (GK b t) *
                  Kz parts t i) := by
            apply Finset.sum_congr rfl
            intro i _
            ring
          _ = (∑ i : Fin b,
                Real.log parts * Kz parts t i) +
              (∑ i : Fin b,
                t * (D9 i * Kz parts t i)) -
              ∑ i : Fin b,
                Real.log (GK b t) *
                  Kz parts t i := by
            rw [Finset.sum_sub_distrib, Finset.sum_add_distrib]
          _ = _ := by
            rw [← Finset.mul_sum, ← Finset.mul_sum, ← Finset.mul_sum]
            rfl
  rw [RA, Gz, hCost,
    AFu hb,
    AFv, hmass]
  ring
theorem AwX
    {b : ℕ} (hb : 0 < b) {n parts t : ℝ} (C7 : 0 < parts)
    (hmean : Db b t = n / parts) :
    Gz b n parts t =
      RA n (Kz (b := b) parts t) := by
  symm
  apply A7S
    hb C7
  rw [hmean]
  field_simp [C7.ne']
theorem Awj
    {b : ℕ} (hb : 0 < b) {n parts t : ℝ} (C7 : 0 < parts)
    (hmass : parts * Db b t = n)
    (x : EK b)
    (hx : EK.QY x n parts) :
    RA n x ≤
      RA n (Kz (b := b) parts t) := by
  rw [A7S
    hb C7 hmass]
  exact A7R hb C7 x hx t
theorem AjV
    {b : ℕ} (hb : 0 < b) {n parts t : ℝ} (C7 : 0 < parts)
    (hmass : parts * Db b t = n) :
    IsGreatest
      (RA n ''
        {x : EK b |
          EK.QY x n parts})
      (Gz b n parts t) := by
  refine ⟨?_, ?_⟩
  · refine ⟨Kz (b := b) parts t,
      AjT hb C7 hmass, ?_⟩
    exact A7S
      hb C7 hmass
  · rintro y ⟨x, hx, rfl⟩
    exact A7R hb C7 x hx t
end
end Erdos625
end M032

section M033
namespace Erdos625
open scoped BigOperators
noncomputable section
def Ds (alpha : ℕ) (i : Fin (alpha + 1)) : ℝ :=
  (alpha : ℝ) - D9 i
def Ij (alpha : ℕ) : ℝ :=
  -FZ alpha
def Dt (alpha : ℕ) : ℝ :=
  q * (alpha : ℝ) - q / 2 + Real.log (alpha : ℝ)
def R9 (alpha : ℕ)
    (i : Fin (alpha + 1)) : ℝ :=
  Ro i - Ij alpha -
    Dt alpha * Ds alpha i
theorem A7F (alpha : ℕ)
    (i : Fin (alpha + 1)) :
    D9 i + Ds alpha i = (alpha : ℝ) := by
  simp [Ds]
theorem AFy (alpha : ℕ)
    (i : Fin (alpha + 1)) :
    Ro i =
      Ij alpha +
        Dt alpha * Ds alpha i +
          R9 alpha i := by
  unfold R9
  ring
def Fz (alpha : ℕ) (lambda : ℝ)
    (i : Fin (alpha + 1)) : ℝ :=
  Real.exp
    (R9 alpha i +
      lambda * Ds alpha i)
def Fh (alpha : ℕ) (lambda : ℝ) : ℝ :=
  ∑ i : Fin (alpha + 1), Fz alpha lambda i
theorem YI (alpha : ℕ) (lambda : ℝ)
    (i : Fin (alpha + 1)) :
    0 < Fz alpha lambda i :=
  Real.exp_pos _
theorem UQ (alpha : ℕ) (lambda : ℝ) :
    0 < Fh alpha lambda := by
  let i0 : Fin (alpha + 1) := ⟨0, Nat.succ_pos alpha⟩
  exact Finset.sum_pos'
    (fun i _ ↦ (YI alpha lambda i).le)
    ⟨i0, Finset.mem_univ i0,
      YI alpha lambda i0⟩
def Oe (alpha : ℕ) (lambda : ℝ)
    (i : Fin (alpha + 1)) : ℝ :=
  Fz alpha lambda i /
    Fh alpha lambda
theorem AjP (alpha : ℕ) (lambda : ℝ)
    (i : Fin (alpha + 1)) :
    0 < Oe alpha lambda i :=
  div_pos (YI alpha lambda i)
    (UQ alpha lambda)
theorem A7u (alpha : ℕ) (lambda : ℝ) :
    ∑ i : Fin (alpha + 1), Oe alpha lambda i = 1 := by
  simp only [Oe]
  rw [← Finset.sum_div, Fh]
  exact div_self (UQ alpha lambda).ne'
def LW (alpha : ℕ) (lambda : ℝ) : ℝ :=
  ∑ i : Fin (alpha + 1),
    Oe alpha lambda i * Ds alpha i
theorem AG0
    (alpha : ℕ) (lambda : ℝ) (i : Fin (alpha + 1)) :
    LX
        (Dt alpha - lambda) i =
      Real.exp
          (Ij alpha +
            (Dt alpha - lambda) * (alpha : ℝ)) *
        Fz alpha lambda i := by
  rw [LX, Fz, ← Real.exp_add]
  rw [AFy]
  congr 1
  unfold Ds D9
  ring
theorem AFw
    (alpha : ℕ) (lambda : ℝ) :
    GK (alpha + 1)
        (Dt alpha - lambda) =
      Real.exp
          (Ij alpha +
            (Dt alpha - lambda) * (alpha : ℝ)) *
        Fh alpha lambda := by
  rw [GK, Fh, Finset.mul_sum]
  apply Finset.sum_congr rfl
  intro i _
  exact AG0 alpha lambda i
theorem A6Z
    (alpha : ℕ) (lambda : ℝ) :
    Real.log
        (GK (alpha + 1)
          (Dt alpha - lambda)) =
      Ij alpha +
        (Dt alpha - lambda) * (alpha : ℝ) +
          Real.log (Fh alpha lambda) := by
  rw [AFw,
    Real.log_mul (Real.exp_ne_zero _)
      (UQ alpha lambda).ne',
    Real.log_exp]
theorem AjY
    (alpha : ℕ) (lambda : ℝ) (i : Fin (alpha + 1)) :
    LY (Dt alpha - lambda) i =
      Oe alpha lambda i := by
  rw [LY, Oe,
    AG0,
    AFw]
  field_simp [Real.exp_ne_zero _,
    (UQ alpha lambda).ne']
theorem A0X
    (alpha : ℕ) (lambda : ℝ) :
    Db (alpha + 1)
        (Dt alpha - lambda) =
      (alpha : ℝ) - LW alpha lambda := by
  rw [A7M]
  calc
    (∑ i : Fin (alpha + 1),
        LY (Dt alpha - lambda) i *
          D9 i) =
        ∑ i : Fin (alpha + 1),
          Oe alpha lambda i *
            ((alpha : ℝ) - Ds alpha i) := by
      apply Finset.sum_congr rfl
      intro i _
      rw [AjY]
      have hSize := A7F alpha i
      congr 1
      linarith
    _ = (alpha : ℝ) *
          (∑ i : Fin (alpha + 1),
            Oe alpha lambda i) -
        ∑ i : Fin (alpha + 1),
          Oe alpha lambda i *
            Ds alpha i := by
      calc
        _ = ∑ i : Fin (alpha + 1),
              ((alpha : ℝ) * Oe alpha lambda i -
                Oe alpha lambda i *
                  Ds alpha i) := by
            apply Finset.sum_congr rfl
            intro i _
            ring
        _ = (∑ i : Fin (alpha + 1),
                (alpha : ℝ) * Oe alpha lambda i) -
              ∑ i : Fin (alpha + 1),
                Oe alpha lambda i *
                  Ds alpha i := by
            rw [Finset.sum_sub_distrib]
        _ = _ := by rw [Finset.mul_sum]
    _ = (alpha : ℝ) - LW alpha lambda := by
      rw [A7u]
      unfold LW
      ring
def Eh (alpha : ℕ) (n parts : ℝ) : ℝ :=
  (alpha : ℝ) - n / parts
theorem AwU
    (alpha : ℕ) {n parts lambda : ℝ} :
    Db (alpha + 1)
        (Dt alpha - lambda) = n / parts ↔
      LW alpha lambda =
        Eh alpha n parts := by
  rw [A0X]
  unfold Eh
  constructor <;> intro h <;> linarith
theorem AG1
    (alpha : ℕ) {n parts : ℝ} (C7 : parts ≠ 0) (lambda : ℝ) :
    Gz (alpha + 1) n parts
        (Dt alpha - lambda) =
      n * Real.log n - n + parts - parts * Real.log parts +
        parts *
          (Ij alpha +
            Dt alpha *
              Eh alpha n parts +
            Real.log (Fh alpha lambda) -
            lambda * Eh alpha n parts) := by
  unfold Gz Eh
  rw [A6Z]
  field_simp [C7]
  ring
end
end Erdos625
end M033

section M034
namespace Erdos625
noncomputable section
theorem TI (alpha : ℕ) :
    Ds alpha (Fin.last alpha) = -1 := by
  simp [Ds, D9]
theorem AFn (alpha : ℕ) (C9 : 0 < alpha) :
    R9 alpha (Fin.last alpha) =
      -q / 2 + Real.log ((alpha : ℝ) / ((alpha : ℝ) + 1)) := by
  have ACo : (0 : ℝ) < alpha := by exact_mod_cast C9
  have AYT : (alpha.factorial : ℝ) ≠ 0 := by positivity
  have A4h : (0 : ℝ) < (alpha : ℝ) + 1 := by positivity
  have Oa :
      Real.log (((alpha + 1).factorial : ℕ) : ℝ) =
        Real.log ((alpha : ℝ) + 1) +
          Real.log ((alpha.factorial : ℕ) : ℝ) := by
    rw [Nat.factorial_succ, Nat.cast_mul, Real.log_mul]
    · norm_num [Nat.cast_add]
    · exact_mod_cast (Nat.succ_ne_zero alpha)
    · exact AYT
  have hchoose : (((alpha + 1).choose 2 : ℕ) : ℝ) =
      (alpha.choose 2 : ℝ) + alpha := by
    exact_mod_cast A1i alpha
  rw [R9, Ro,
    Ij, Dt,
    FZ, TI]
  simp only [Fin.val_last]
  rw [Oa, hchoose,
    Real.log_div ACo.ne' A4h.ne']
  unfold FZ q
  ring
theorem A7L (alpha : ℕ) (i : Fin (alpha + 1))
    (hsize : i.1 + 1 ≤ alpha) :
    Ds alpha i = ((alpha - (i.1 + 1) : ℕ) : ℝ) := by
  unfold Ds D9
  rw [Nat.cast_sub hsize]
theorem A0V
    (alpha : ℕ) (i : Fin (alpha + 1)) (hsize : i.1 + 1 ≤ alpha) :
    R9 alpha i =
      Real.log
          ((alpha.descFactorial (alpha - (i.1 + 1)) : ℕ) : ℝ) -
        ((alpha - (i.1 + 1) : ℕ) : ℝ) * Real.log (alpha : ℝ) -
        q / 2 * (((alpha - (i.1 + 1) : ℕ) : ℝ) ^ 2) := by
  let s : ℕ := i.1 + 1
  let d : ℕ := alpha - s
  have hsPos : 0 < s := by simp [s]
  have hdle : d ≤ alpha := by simp [d]
  have hsub : alpha - d = s := by
    dsimp [d]
    omega
  have q6 : s.factorial * alpha.descFactorial d = alpha.factorial := by
    simpa only [hsub] using (Nat.factorial_mul_descFactorial hdle)
  have Aco : (s.factorial : ℝ) ≠ 0 := by positivity
  have hdesc : (alpha.descFactorial d : ℝ) ≠ 0 := by
    exact_mod_cast (Nat.ne_of_gt ((Nat.descFactorial_pos).2 hdle))
  have Aa1 :
      Real.log (alpha.factorial : ℝ) - Real.log (s.factorial : ℝ) =
        Real.log (alpha.descFactorial d : ℝ) := by
    have hcast := congrArg (fun m : ℕ ↦ (m : ℝ)) q6
    norm_num only [Nat.cast_mul] at hcast
    calc
      Real.log (alpha.factorial : ℝ) - Real.log (s.factorial : ℝ) =
          Real.log ((s.factorial : ℝ) * (alpha.descFactorial d : ℝ)) -
            Real.log (s.factorial : ℝ) := by rw [hcast]
      _ = Real.log (alpha.descFactorial d : ℝ) := by
        rw [Real.log_mul Aco hdesc]
        ring
  have AZY : (d : ℝ) = (alpha : ℝ) - (s : ℝ) := by
    dsimp [d]
    exact Nat.cast_sub hsize
  have hchoose :
      (alpha.choose 2 : ℝ) - (s.choose 2 : ℝ) =
        (d : ℝ) * (alpha : ℝ) - ((d : ℝ) ^ 2 + d) / 2 := by
    rw [Nat.cast_choose_two, Nat.cast_choose_two, AZY]
    ring
  have J4 : Ds alpha i = (d : ℝ) := by
    simpa only [s, d] using A7L alpha i hsize
  change
    -FZ s - -FZ alpha -
        Dt alpha * Ds alpha i = _
  rw [J4]
  unfold FZ Dt
  change
    -(Real.log (s.factorial : ℝ) + (s.choose 2 : ℝ) * Real.log 2) -
          -(Real.log (alpha.factorial : ℝ) +
            (alpha.choose 2 : ℝ) * Real.log 2) -
        (q * (alpha : ℝ) - q / 2 + Real.log (alpha : ℝ)) * (d : ℝ) =
      Real.log (alpha.descFactorial d : ℝ) -
        (d : ℝ) * Real.log (alpha : ℝ) - q / 2 * (d : ℝ) ^ 2
  unfold q
  linear_combination Aa1 + Real.log 2 * hchoose
theorem AEL (alpha d : ℕ) (hd : d ≤ alpha)
    (C9 : 0 < alpha) :
    Real.log (alpha.descFactorial d : ℝ) ≤
      (d : ℝ) * Real.log (alpha : ℝ) := by
  have AZh : (0 : ℝ) < alpha.descFactorial d := by
    exact_mod_cast ((Nat.descFactorial_pos).2 hd)
  have Au5 : (0 : ℝ) < (alpha : ℝ) ^ d := by positivity
  have AZ9 : (alpha.descFactorial d : ℝ) ≤ (alpha : ℝ) ^ d := by
    exact_mod_cast (Nat.descFactorial_le_pow alpha d)
  have hlog := Real.log_le_log AZh AZ9
  rwa [Real.log_pow] at hlog
theorem AjI
    (alpha : ℕ) (C9 : 0 < alpha) (i : Fin (alpha + 1))
    (hsize : i.1 + 1 ≤ alpha) :
    R9 alpha i ≤
      -q / 2 * (Ds alpha i) ^ 2 := by
  let d : ℕ := alpha - (i.1 + 1)
  have hdle : d ≤ alpha := by simp [d]
  have hlog := AEL alpha d hdle C9
  rw [A0V alpha i hsize,
    A7L alpha i hsize]
  dsimp [d] at hlog
  linarith
theorem A7I
    (alpha : ℕ) (C9 : 0 < alpha) (i : Fin (alpha + 1)) :
    R9 alpha i ≤
      -q / 2 * (Ds alpha i) ^ 2 := by
  by_cases hsize : i.1 + 1 ≤ alpha
  · exact AjI
      alpha C9 i hsize
  · have hiVal : i.1 = alpha := by
      have hiLt := i.2
      omega
    have hi : i = Fin.last alpha := by
      apply Fin.ext
      simpa only [Fin.val_last] using hiVal
    rw [hi, AFn alpha C9,
      TI]
    have ACo : (0 : ℝ) < alpha := by exact_mod_cast C9
    have A4h : (0 : ℝ) < (alpha : ℝ) + 1 := by positivity
    have qM :
        (0 : ℝ) ≤ (alpha : ℝ) / ((alpha : ℝ) + 1) := by positivity
    have AcQ :
        (alpha : ℝ) / ((alpha : ℝ) + 1) ≤ 1 := by
      exact (div_le_one A4h).2 (by linarith)
    have hlog :
        Real.log ((alpha : ℝ) / ((alpha : ℝ) + 1)) ≤ 0 :=
      Real.log_nonpos qM AcQ
    norm_num
    linarith
end
end Erdos625
end M034

section M035
open Filter
open scoped Topology
namespace Erdos625
theorem AHs (d : ℕ) :
    Tendsto
      (fun a : ℕ ↦
        Real.log (a.descFactorial d : ℝ) -
          (d : ℝ) * Real.log (a : ℝ))
      atTop (𝓝 0) := by
  have AXy :
      ∀ a ≥ d,
        Real.log (Nat.descFactorial a d) =
          ∑ i ∈ Finset.range d, Real.log (a - i) := by
    intro a ha
    rw [← Real.log_prod] <;>
      norm_cast <;>
      simp +decide [Nat.descFactorial_eq_prod_range]
    · exact congr_arg Real.log <|
        Finset.prod_congr rfl fun x hx => by
          rw [Nat.cast_sub (by linarith [Finset.mem_range.mp hx])]
    · grind
  have AXv :
      ∀ a ≥ d + 1,
        ∑ i ∈ Finset.range d, (Real.log (a - i) - Real.log a) =
          ∑ i ∈ Finset.range d, Real.log (1 - i / (a : ℝ)) := by
    intro a ha
    refine Finset.sum_congr rfl fun i hi => ?_
    rw [one_sub_div (by
      norm_cast
      linarith [Finset.mem_range.mp hi])]
    rw [Real.log_div] <;>
      norm_num <;>
      linarith [Finset.mem_range.mp hi,
        show (a : ℝ) ≥ i + 1 by
          norm_cast
          linarith [Finset.mem_range.mp hi]]
  have AY0 :
      Tendsto
        (fun a : ℕ => ∑ i ∈ Finset.range d, Real.log (1 - i / (a : ℝ)))
        atTop (nhds 0) := by
    exact le_trans
      (tendsto_finsetSum _ fun i _ =>
        Tendsto.log
          (tendsto_const_nhds.sub <|
            tendsto_const_nhds.div_atTop tendsto_natCast_atTop_atTop)
          (by norm_num))
      (by norm_num)
  exact AY0.congr' (by
    filter_upwards [eventually_ge_atTop (d + 1)] with a ha
    rw [← AXv a ha, Finset.sum_sub_distrib,
      AXy a (by linarith)]
    simp +decide)
end Erdos625
end M035

section M036
open Filter Finset
open scoped Topology
namespace Erdos625.ProfileEntropyS4
noncomputable section
def support (i : Fin 4) : ℝ := (i.val : ℝ) + 2
@[simp] theorem support_zero : support 0 = 2 := by norm_num [support]
@[simp] theorem support_one : support 1 = 3 := by norm_num [support]
@[simp] theorem tL : support 2 = 4 := by norm_num [support]
@[simp] theorem tK : support 3 = 5 := by norm_num [support]
def unnormalized (h : Fin 4 → ℝ) (t : ℝ) (i : Fin 4) : ℝ :=
  Real.exp (h i + t * support i)
def partition (h : Fin 4 → ℝ) (t : ℝ) : ℝ :=
  ∑ i : Fin 4, unnormalized h t i
def weight (h : Fin 4 → ℝ) (t : ℝ) (i : Fin 4) : ℝ :=
  unnormalized h t i / partition h t
def Qe (h : Fin 4 → ℝ) (t : ℝ) : ℝ :=
  ∑ i : Fin 4, support i * unnormalized h t i
def kP (h : Fin 4 → ℝ) (t : ℝ) : ℝ :=
  ∑ i : Fin 4, support i ^ 2 * unnormalized h t i
def mean (h : Fin 4 → ℝ) (t : ℝ) : ℝ :=
  Qe h t / partition h t
def variance (h : Fin 4 → ℝ) (t : ℝ) : ℝ :=
  ∑ i : Fin 4, weight h t i * (support i - mean h t) ^ 2
theorem l7 (h : Fin 4 → ℝ) (t : ℝ) (i : Fin 4) :
    0 < unnormalized h t i := by
  exact Real.exp_pos _
theorem QF (h : Fin 4 → ℝ) (t : ℝ) : 0 < partition h t := by
  rw [partition, Fin.sum_univ_four]
  exact add_pos (add_pos (add_pos (l7 h t 0) (l7 h t 1))
    (l7 h t 2)) (l7 h t 3)
theorem weight_pos (h : Fin 4 → ℝ) (t : ℝ) (i : Fin 4) :
    0 < weight h t i := by
  exact div_pos (l7 h t i) (QF h t)
theorem A0x (h : Fin 4 → ℝ) (t : ℝ) :
    ∑ i : Fin 4, weight h t i = 1 := by
  simp only [weight]
  rw [← Finset.sum_div, partition]
  exact div_self (ne_of_gt (QF h t))
theorem A0F (h : Fin 4 → ℝ) (t : ℝ) :
    mean h t = ∑ i : Fin 4, weight h t i * support i := by
  rw [mean, Qe]
  simp only [weight]
  rw [Finset.sum_div]
  apply Finset.sum_congr rfl
  intro i hi
  ring
theorem AI4 (h : Fin 4 → ℝ) (t : ℝ) : 2 < mean h t := by
  rw [A0F, Fin.sum_univ_four]
  have hs := A0x h t
  rw [Fin.sum_univ_four] at hs
  have h0 := weight_pos h t 0
  have h1 := weight_pos h t 1
  have h2 := weight_pos h t 2
  have h3 := weight_pos h t 3
  simp only [support_zero, support_one, tL, tK]
  nlinarith
theorem Afs (h : Fin 4 → ℝ) (t : ℝ) : mean h t < 5 := by
  rw [A0F, Fin.sum_univ_four]
  have hs := A0x h t
  rw [Fin.sum_univ_four] at hs
  have h0 := weight_pos h t 0
  have h1 := weight_pos h t 1
  have h2 := weight_pos h t 2
  have h3 := weight_pos h t 3
  simp only [support_zero, support_one, tL, tK]
  nlinarith
theorem AEb (h : Fin 4 → ℝ) (t : ℝ) : mean h t ∈ Set.Ioo 2 5 :=
  ⟨AI4 h t, Afs h t⟩
theorem ACy (h : Fin 4 → ℝ) (t : ℝ) (i : Fin 4) :
    HasDerivAt (fun x ↦ unnormalized h x i)
      (support i * unnormalized h t i) t := by
  simpa only [unnormalized, Function.const_apply, Pi.add_apply, id_eq, zero_add, one_mul,
    mul_comm] using
    ((hasDerivAt_const t (h i)).add ((hasDerivAt_id t).mul_const (support i))).exp
theorem ACs (h : Fin 4 → ℝ) (t : ℝ) :
    HasDerivAt (partition h) (Qe h t) t := by
  change HasDerivAt (fun x ↦ ∑ i : Fin 4, unnormalized h x i)
    (∑ i : Fin 4, support i * unnormalized h t i) t
  exact HasDerivAt.fun_sum fun i _ ↦ ACy h t i
theorem AYY (h : Fin 4 → ℝ) (t : ℝ) :
    HasDerivAt (Qe h) (kP h t) t := by
  change HasDerivAt (fun x ↦ ∑ i : Fin 4, support i * unnormalized h x i)
    (∑ i : Fin 4, support i ^ 2 * unnormalized h t i) t
  apply HasDerivAt.fun_sum
  intro i hi
  simpa only [pow_two, mul_assoc] using
    (ACy h t i).const_mul (support i)
theorem Ao9 (h : Fin 4 → ℝ) (t : ℝ) :
    ∑ i : Fin 4, weight h t i * support i ^ 2 = kP h t / partition h t := by
  rw [kP]
  simp only [weight]
  rw [Finset.sum_div]
  apply Finset.sum_congr rfl
  intro i hi
  ring
theorem Apt (h : Fin 4 → ℝ) (t : ℝ) :
    variance h t = kP h t / partition h t - mean h t ^ 2 := by
  calc
    variance h t = ∑ i : Fin 4,
        (weight h t i * support i ^ 2 -
          2 * mean h t * (weight h t i * support i) +
          mean h t ^ 2 * weight h t i) := by
      apply Finset.sum_congr rfl
      intro i hi
      ring
    _ = (∑ i : Fin 4, weight h t i * support i ^ 2) -
          2 * mean h t * (∑ i : Fin 4, weight h t i * support i) +
          mean h t ^ 2 * (∑ i : Fin 4, weight h t i) := by
      simp only [Finset.sum_add_distrib, Finset.sum_sub_distrib, Finset.mul_sum]
    _ = kP h t / partition h t - mean h t ^ 2 := by
      rw [Ao9, ← A0F, A0x]
      ring
theorem A4l (h : Fin 4 → ℝ) (t : ℝ) :
    HasDerivAt (mean h) (variance h t) t := by
  have hd := (AYY h t).div (ACs h t)
    (ne_of_gt (QF h t))
  have halg : variance h t =
      (kP h t * partition h t -
        Qe h t * Qe h t) / partition h t ^ 2 := by
    rw [Apt, mean]
    field_simp [ne_of_gt (QF h t)]
  rw [halg]
  exact hd
theorem AMy (h : Fin 4 → ℝ) (t : ℝ) :
    DifferentiableAt ℝ (mean h) t :=
  (A4l h t).differentiableAt
theorem AN0 (h : Fin 4 → ℝ) : Differentiable ℝ (mean h) :=
  fun t ↦ AMy h t
theorem AMG (h : Fin 4 → ℝ) : Continuous (mean h) :=
  (AN0 h).continuous
theorem AMs (h : Fin 4 → ℝ) (t : ℝ) :
    deriv (mean h) t = variance h t :=
  (A4l h t).deriv
theorem AIE (h : Fin 4 → ℝ) (t : ℝ) : 0 < variance h t := by
  rw [variance, Fin.sum_univ_four]
  have hmean : 2 < mean h t := AI4 h t
  have hsq0 : 0 < (support 0 - mean h t) ^ 2 := by
    apply sq_pos_of_ne_zero
    simp only [support_zero]
    linarith
  have AuL : 0 < weight h t 0 * (support 0 - mean h t) ^ 2 :=
    mul_pos (weight_pos h t 0) hsq0
  have AuM : 0 ≤ weight h t 1 * (support 1 - mean h t) ^ 2 :=
    mul_nonneg (weight_pos h t 1).le (sq_nonneg _)
  have AuN : 0 ≤ weight h t 2 * (support 2 - mean h t) ^ 2 :=
    mul_nonneg (weight_pos h t 2).le (sq_nonneg _)
  have AuO : 0 ≤ weight h t 3 * (support 3 - mean h t) ^ 2 :=
    mul_nonneg (weight_pos h t 3).le (sq_nonneg _)
  positivity
theorem Vi (h : Fin 4 → ℝ) : StrictMono (mean h) := by
  apply strictMono_of_deriv_pos
  intro t
  rw [AMs]
  exact AIE h t
theorem kq (a c : ℝ) (hc : 0 < c) :
    Tendsto (fun t : ℝ ↦ Real.exp (a - c * t)) atTop (𝓝 0) := by
  apply Real.tendsto_exp_atBot.comp
  have hlin : Tendsto (fun t : ℝ ↦ (-c) * t + a) atTop atBot :=
    tendsto_atBot_add_const_right atTop a
      (tendsto_id.const_mul_atTop_of_neg (neg_lt_zero.mpr hc))
  convert hlin using 1
  ring_nf
theorem ko (a c : ℝ) (hc : 0 < c) :
    Tendsto (fun t : ℝ ↦ Real.exp (a + c * t)) atBot (𝓝 0) := by
  apply Real.tendsto_exp_atBot.comp
  have hlin : Tendsto (fun t : ℝ ↦ c * t + a) atBot atBot :=
    tendsto_atBot_add_const_right atBot a (tendsto_id.const_mul_atBot hc)
  convert hlin using 1
  ring_nf
def tO (h : Fin 4 → ℝ) (t : ℝ) : ℝ :=
  Real.exp ((h 0 - h 3) - 3 * t) +
    Real.exp ((h 1 - h 3) - 2 * t) +
    Real.exp ((h 2 - h 3) - t) + 1
def tP (h : Fin 4 → ℝ) (t : ℝ) : ℝ :=
  2 * Real.exp ((h 0 - h 3) - 3 * t) +
    3 * Real.exp ((h 1 - h 3) - 2 * t) +
    4 * Real.exp ((h 2 - h 3) - t) + 5
theorem Afr (h : Fin 4 → ℝ) (t : ℝ) :
    mean h t = tP h t / tO h t := by
  have hA : Real.exp (h 3 + t * 5) ≠ 0 := Real.exp_ne_zero _
  have h0 : Real.exp (h 0 + t * 2) =
      Real.exp (h 3 + t * 5) * Real.exp ((h 0 - h 3) - 3 * t) := by
    rw [← Real.exp_add]
    congr 1
    ring
  have h1 : Real.exp (h 1 + t * 3) =
      Real.exp (h 3 + t * 5) * Real.exp ((h 1 - h 3) - 2 * t) := by
    rw [← Real.exp_add]
    congr 1
    ring
  have h2 : Real.exp (h 2 + t * 4) =
      Real.exp (h 3 + t * 5) * Real.exp ((h 2 - h 3) - t) := by
    rw [← Real.exp_add]
    congr 1
    ring
  rw [mean, Qe, partition, Fin.sum_univ_four, Fin.sum_univ_four]
  simp only [unnormalized, support_zero, support_one, tL, tK]
  rw [h0, h1, h2]
  unfold tP tO
  field_simp [hA]
theorem Aoy (h : Fin 4 → ℝ) :
    Tendsto (tO h) atTop (𝓝 1) := by
  change Tendsto (fun t : ℝ ↦
    Real.exp ((h 0 - h 3) - 3 * t) +
      Real.exp ((h 1 - h 3) - 2 * t) +
      Real.exp ((h 2 - h 3) - t) + 1) atTop (𝓝 1)
  have h0 := kq (h 0 - h 3) 3 (by norm_num)
  have h1 := kq (h 1 - h 3) 2 (by norm_num)
  have h2 := kq (h 2 - h 3) 1 (by norm_num)
  simpa only [tO, one_mul, add_zero, zero_add] using
    (((h0.add h1).add h2).add tendsto_const_nhds)
theorem Aoz (h : Fin 4 → ℝ) :
    Tendsto (tP h) atTop (𝓝 5) := by
  change Tendsto (fun t : ℝ ↦
    2 * Real.exp ((h 0 - h 3) - 3 * t) +
      3 * Real.exp ((h 1 - h 3) - 2 * t) +
      4 * Real.exp ((h 2 - h 3) - t) + 5) atTop (𝓝 5)
  have h0 := kq (h 0 - h 3) 3 (by norm_num)
  have h1 := kq (h 1 - h 3) 2 (by norm_num)
  have h2 := kq (h 2 - h 3) 1 (by norm_num)
  simpa only [tP, one_mul, mul_zero, add_zero, zero_add] using
    ((((h0.const_mul 2).add (h1.const_mul 3)).add (h2.const_mul 4)).add
      tendsto_const_nhds)
theorem Aoa (h : Fin 4 → ℝ) :
    Tendsto (mean h) atTop (𝓝 5) := by
  rw [show mean h = tP h / tO h from by
    ext t
    exact Afr h t]
  simpa only [div_one] using
    (Aoz h).div (Aoy h)
      (by norm_num : (1 : ℝ) ≠ 0)
def lG (h : Fin 4 → ℝ) (t : ℝ) : ℝ :=
  1 + Real.exp ((h 1 - h 0) + t) +
    Real.exp ((h 2 - h 0) + 2 * t) +
    Real.exp ((h 3 - h 0) + 3 * t)
def lH (h : Fin 4 → ℝ) (t : ℝ) : ℝ :=
  2 + 3 * Real.exp ((h 1 - h 0) + t) +
    4 * Real.exp ((h 2 - h 0) + 2 * t) +
    5 * Real.exp ((h 3 - h 0) + 3 * t)
theorem Afq (h : Fin 4 → ℝ) (t : ℝ) :
    mean h t = lH h t / lG h t := by
  have hA : Real.exp (h 0 + t * 2) ≠ 0 := Real.exp_ne_zero _
  have h1 : Real.exp (h 1 + t * 3) =
      Real.exp (h 0 + t * 2) * Real.exp ((h 1 - h 0) + t) := by
    rw [← Real.exp_add]
    congr 1
    ring
  have h2 : Real.exp (h 2 + t * 4) =
      Real.exp (h 0 + t * 2) * Real.exp ((h 2 - h 0) + 2 * t) := by
    rw [← Real.exp_add]
    congr 1
    ring
  have h3 : Real.exp (h 3 + t * 5) =
      Real.exp (h 0 + t * 2) * Real.exp ((h 3 - h 0) + 3 * t) := by
    rw [← Real.exp_add]
    congr 1
    ring
  rw [mean, Qe, partition, Fin.sum_univ_four, Fin.sum_univ_four]
  simp only [unnormalized, support_zero, support_one, tL, tK]
  rw [h1, h2, h3]
  unfold lH lG
  field_simp [hA]
theorem AoL (h : Fin 4 → ℝ) :
    Tendsto (lG h) atBot (𝓝 1) := by
  change Tendsto (fun t : ℝ ↦
    1 + Real.exp ((h 1 - h 0) + t) +
      Real.exp ((h 2 - h 0) + 2 * t) +
      Real.exp ((h 3 - h 0) + 3 * t)) atBot (𝓝 1)
  have h1 := ko (h 1 - h 0) 1 (by norm_num)
  have h2 := ko (h 2 - h 0) 2 (by norm_num)
  have h3 := ko (h 3 - h 0) 3 (by norm_num)
  simpa only [lG, one_mul, add_zero, zero_add] using
    (((tendsto_const_nhds.add h1).add h2).add h3)
theorem AoN (h : Fin 4 → ℝ) :
    Tendsto (lH h) atBot (𝓝 2) := by
  change Tendsto (fun t : ℝ ↦
    2 + 3 * Real.exp ((h 1 - h 0) + t) +
      4 * Real.exp ((h 2 - h 0) + 2 * t) +
      5 * Real.exp ((h 3 - h 0) + 3 * t)) atBot (𝓝 2)
  have h1 := ko (h 1 - h 0) 1 (by norm_num)
  have h2 := ko (h 2 - h 0) 2 (by norm_num)
  have h3 := ko (h 3 - h 0) 3 (by norm_num)
  simpa only [lH, one_mul, mul_zero, add_zero, zero_add] using
    (((tendsto_const_nhds.add (h1.const_mul 3)).add (h2.const_mul 4)).add
      (h3.const_mul 5))
theorem AoZ (h : Fin 4 → ℝ) :
    Tendsto (mean h) atBot (𝓝 2) := by
  rw [show mean h = lH h / lG h from by
    ext t
    exact Afq h t]
  simpa only [div_one] using
    (AoN h).div (AoL h)
      (by norm_num : (1 : ℝ) ≠ 0)
theorem APx (h : Fin 4 → ℝ) {T : ℝ}
    (hT : T ∈ Set.Ioo 2 5) : ∃ t : ℝ, mean h t = T := by
  have AYI : ∀ᶠ t : ℝ in atBot, mean h t < T :=
    (AoZ h).eventually (Iio_mem_nhds hT.1)
  have AYn : ∀ᶠ t : ℝ in atTop, T < mean h t :=
    (Aoa h).eventually (Ioi_mem_nhds hT.2)
  obtain ⟨a, ha⟩ := AYI.exists
  obtain ⟨b, hb⟩ := AYn.exists
  exact Set.mem_range.mp <|
    mem_range_of_exists_le_of_exists_ge (AMG h) ⟨a, ha.le⟩ ⟨b, hb.le⟩
theorem AEa (h : Fin 4 → ℝ) : Function.Injective (mean h) :=
  (Vi h).injective
theorem AAQ (h : Fin 4 → ℝ) {T : ℝ}
    (hT : T ∈ Set.Ioo 2 5) : ∃! t : ℝ, mean h t = T := by
  obtain ⟨t, ht⟩ := APx h hT
  refine ⟨t, ht, ?_⟩
  intro u hu
  exact AEa h (hu.trans ht.symm)
end
end Erdos625.ProfileEntropyS4
end M036

section M037
open Finset
namespace Erdos625.ProfileEntropyS4
noncomputable section
noncomputable def tilt (h : Fin 4 → ℝ) (T : ℝ) : ℝ :=
  if hT : T ∈ Set.Ioo (2 : ℝ) 5 then
    Classical.choose (AAQ h hT).exists
  else 0
theorem Mr (h : Fin 4 → ℝ) {T : ℝ}
    (hT : T ∈ Set.Ioo (2 : ℝ) 5) :
    mean h (tilt h T) = T := by
  rw [tilt, dif_pos hT]
  exact Classical.choose_spec (AAQ h hT).exists
theorem A2A (h : Fin 4 → ℝ) {T t : ℝ}
    (hT : T ∈ Set.Ioo (2 : ℝ) 5) (ht : mean h t = T) :
    t = tilt h T := by
  exact AEa h (ht.trans (Mr h hT).symm)
theorem Avf (h : Fin 4 → ℝ) {T t : ℝ}
    (hT : T ∈ Set.Ioo (2 : ℝ) 5) :
    mean h t = T ↔ t = tilt h T := by
  constructor
  · exact A2A h hT
  · rintro rfl
    exact Mr h hT
noncomputable def optimizer (h : Fin 4 → ℝ) (T : ℝ) (i : Fin 4) : ℝ :=
  weight h (tilt h T) i
theorem ZV (h : Fin 4 → ℝ) (T : ℝ) (i : Fin 4) :
    0 < optimizer h T i :=
  weight_pos h (tilt h T) i
theorem TA (h : Fin 4 → ℝ) (T : ℝ) (i : Fin 4) :
    0 ≤ optimizer h T i :=
  (ZV h T i).le
theorem RB (h : Fin 4 → ℝ) (T : ℝ) :
    ∑ i : Fin 4, optimizer h T i = 1 :=
  A0x h (tilt h T)
theorem X0 (h : Fin 4 → ℝ) {T : ℝ}
    (hT : T ∈ Set.Ioo (2 : ℝ) 5) :
    ∑ i : Fin 4, optimizer h T i * support i = T := by
  change ∑ i : Fin 4, weight h (tilt h T) i * support i = T
  rw [← A0F]
  exact Mr h hT
def QY (p : Fin 4 → ℝ) (T : ℝ) : Prop :=
  (∀ i, 0 ≤ p i) ∧
    (∑ i : Fin 4, p i = 1) ∧
      (∑ i : Fin 4, p i * support i = T)
theorem Ah7 (h : Fin 4 → ℝ) {T : ℝ}
    (hT : T ∈ Set.Ioo (2 : ℝ) 5) :
    QY (optimizer h T) T :=
  ⟨TA h T, RB h T,
    X0 h hT⟩
theorem ZU {x y : ℝ}
    (hx : 0 ≤ x) (hy : 0 < y) :
    -x * Real.log x + x * Real.log y ≤ y - x := by
  rcases eq_or_lt_of_le hx with rfl | hxPos
  · simpa using hy.le
  · have hLog := Real.log_le_sub_one_of_pos (div_pos hy hxPos)
    have Fv := mul_le_mul_of_nonneg_left hLog hx
    rw [Real.log_div hy.ne' hxPos.ne'] at Fv
    field_simp [hxPos.ne'] at Fv
    linarith
theorem AfU (h : Fin 4 → ℝ) (t : ℝ) (i : Fin 4) :
    Real.log (weight h t i) =
      h i + t * support i - Real.log (partition h t) := by
  rw [weight, Real.log_div (l7 h t i).ne'
    (QF h t).ne', unnormalized, Real.log_exp]
theorem A7t
    (p q' : Fin 4 → ℝ)
    (hp : ∀ i, 0 ≤ p i) (hq : ∀ i, 0 < q' i)
    (hpSum : ∑ i : Fin 4, p i = 1)
    (hqSum : ∑ i : Fin 4, q' i = 1) :
    ∑ i : Fin 4,
      (-p i * Real.log (p i) + p i * Real.log (q' i)) ≤ 0 := by
  calc
    ∑ i : Fin 4,
        (-p i * Real.log (p i) + p i * Real.log (q' i)) ≤
        ∑ i : Fin 4, (q' i - p i) := by
      apply Finset.sum_le_sum
      intro i _hi
      exact ZU (hp i) (hq i)
    _ = 0 := by
      rw [Finset.sum_sub_distrib, hqSum, hpSum, sub_self]
theorem A7s (h p : Fin 4 → ℝ) (t T : ℝ)
    (hpSum : ∑ i : Fin 4, p i = 1)
    (O1 : ∑ i : Fin 4, p i * support i = T) :
    ∑ i : Fin 4, p i * Real.log (weight h t i) =
      (∑ i : Fin 4, p i * h i) + t * T - Real.log (partition h t) := by
  calc
    ∑ i : Fin 4, p i * Real.log (weight h t i) =
        ∑ i : Fin 4,
          (p i * h i + t * (p i * support i) -
            Real.log (partition h t) * p i) := by
      apply Finset.sum_congr rfl
      intro i _hi
      rw [AfU]
      ring
    _ = (∑ i : Fin 4, p i * h i) +
          t * (∑ i : Fin 4, p i * support i) -
            Real.log (partition h t) * (∑ i : Fin 4, p i) := by
      simp only [Finset.sum_sub_distrib, Finset.sum_add_distrib,
        Finset.mul_sum]
    _ = (∑ i : Fin 4, p i * h i) + t * T -
          Real.log (partition h t) := by
      rw [O1, hpSum, mul_one]
theorem w9
    (h p : Fin 4 → ℝ) {T : ℝ}
    (hT : T ∈ Set.Ioo (2 : ℝ) 5)
    (hp : ∀ i, 0 ≤ p i)
    (hpSum : ∑ i : Fin 4, p i = 1)
    (O1 : ∑ i : Fin 4, p i * support i = T) :
    -(∑ i : Fin 4, p i * Real.log (p i)) +
        ∑ i : Fin 4, p i * h i ≤
      Real.log (partition h (tilt h T)) - tilt h T * T := by
  have AVW := Ah7 h hT
  have oM := A7t
    p (optimizer h T) hp (ZV h T) hpSum AVW.2.1
  simp only [optimizer] at oM
  have AWw :
      (∑ i : Fin 4,
          (-p i * Real.log (p i) +
            p i * Real.log (weight h (tilt h T) i))) =
        -(∑ i : Fin 4, p i * Real.log (p i)) +
          ∑ i : Fin 4, p i * Real.log (weight h (tilt h T) i) := by
    rw [Finset.sum_add_distrib]
    congr 1
    rw [← Finset.sum_neg_distrib]
    apply Finset.sum_congr rfl
    intro i _hi
    ring
  rw [AWw] at oM
  have ACJ := A7s h p (tilt h T) T hpSum O1
  linarith
theorem g7
    (h : Fin 4 → ℝ) {T : ℝ}
    (hT : T ∈ Set.Ioo (2 : ℝ) 5) :
    -(∑ i : Fin 4, optimizer h T i * Real.log (optimizer h T i)) +
        ∑ i : Fin 4, optimizer h T i * h i =
      Real.log (partition h (tilt h T)) - tilt h T * T := by
  have ACJ := A7s h (optimizer h T)
    (tilt h T) T (RB h T) (X0 h hT)
  simp only [optimizer] at ACJ ⊢
  linarith
end
end Erdos625.ProfileEntropyS4
end M037

section M038
open Finset Filter
namespace Erdos625.ProfileEntropyS4
noncomputable section
noncomputable def D7 (h : Fin 4 → ℝ) (T : ℝ) : ℝ :=
  Real.log (partition h (tilt h T)) - tilt h T * T
theorem AHQ
    (p h g : Fin 4 → ℝ) {ε : ℝ}
    (hp : ∀ i, 0 ≤ p i)
    (hpSum : ∑ i : Fin 4, p i = 1)
    (U9 : ∀ i, h i - g i ≤ ε) :
    (∑ i : Fin 4, p i * h i) - ∑ i : Fin 4, p i * g i ≤ ε := by
  calc
    (∑ i : Fin 4, p i * h i) - ∑ i : Fin 4, p i * g i =
        ∑ i : Fin 4, p i * (h i - g i) := by
      rw [← Finset.sum_sub_distrib]
      apply Finset.sum_congr rfl
      intro i _hi
      ring
    _ ≤ ∑ i : Fin 4, p i * ε := by
      apply Finset.sum_le_sum
      intro i _hi
      exact mul_le_mul_of_nonneg_left (U9 i) (hp i)
    _ = ε := by
      rw [← Finset.sum_mul, hpSum, one_mul]
theorem A8W
    (h g : Fin 4 → ℝ) {T ε : ℝ}
    (hT : T ∈ Set.Ioo (2 : ℝ) 5)
    (hε : 0 ≤ ε)
    (Xt : ∀ i, |h i - g i| ≤ ε) :
    |D7 h T - D7 g T| ≤ ε := by
  have hhEq :=
    g7 h hT
  have hgLe := w9
    g (optimizer h T) hT (TA h T) (RB h T)
      (X0 h hT)
  have ggEq :=
    g7 g hT
  have ghLe := w9
    h (optimizer g T) hT (TA g T) (RB g T)
      (X0 g hT)
  have hhg :
      D7 h T - D7 g T ≤
        (∑ i : Fin 4, optimizer h T i * h i) -
          ∑ i : Fin 4, optimizer h T i * g i := by
    simp only [D7]
    linarith
  have hgh :
      D7 g T - D7 h T ≤
        (∑ i : Fin 4, optimizer g T i * g i) -
          ∑ i : Fin 4, optimizer g T i * h i := by
    simp only [D7]
    linarith
  have AaV :
      (∑ i : Fin 4, optimizer h T i * h i) -
          ∑ i : Fin 4, optimizer h T i * g i ≤ ε :=
    AHQ (optimizer h T) h g
      (TA h T) (RB h T)
      (fun i ↦ (le_abs_self (h i - g i)).trans (Xt i))
  have Ate :
      (∑ i : Fin 4, optimizer g T i * g i) -
          ∑ i : Fin 4, optimizer g T i * h i ≤ ε :=
    AHQ (optimizer g T) g h
      (TA g T) (RB g T)
      (fun i ↦ (le_abs_self (g i - h i)).trans (by
        simpa [abs_sub_comm] using Xt i))
  have hbound : |D7 h T - D7 g T| ≤ ε := by
    rw [abs_le]
    constructor
    · linarith
    · exact hhg.trans AaV
  calc
    |D7 h T - D7 g T| ≤ |ε| := by
      simpa [abs_of_nonneg hε] using hbound
    _ = ε := abs_of_nonneg hε
theorem AyH
    (h : ℕ → Fin 4 → ℝ) (g : Fin 4 → ℝ) {T : ℝ}
    (hT : T ∈ Set.Ioo (2 : ℝ) 5)
    (huniform : ∀ ε > 0, ∃ N : ℕ, ∀ n ≥ N, ∀ i, |h n i - g i| < ε) :
    Tendsto (fun n ↦ D7 (h n) T) atTop
      (nhds (D7 g T)) := by
  rw [Metric.tendsto_atTop]
  intro ε hε
  obtain ⟨N, hN⟩ := huniform (ε / 2) (half_pos hε)
  refine ⟨N, fun n hn ↦ ?_⟩
  rw [Real.dist_eq]
  exact lt_of_le_of_lt
    (A8W (h n) g hT
      (half_pos hε).le (fun i ↦ (hN n hn i).le))
    (half_lt_self hε)
end
end Erdos625.ProfileEntropyS4
end M038

section M039
namespace Erdos625.ProfileEntropyS4
noncomputable section
theorem APV
    (h : ℕ → Fin 4 → ℝ) (g : Fin 4 → ℝ) (K : Set ℝ)
    (hK : K ⊆ Set.Ioo (2 : ℝ) 5)
    (huniform : ∀ ε > 0, ∃ N : ℕ, ∀ n ≥ N, ∀ i, |h n i - g i| < ε) :
    ∀ ε > 0, ∃ N : ℕ, ∀ n ≥ N, ∀ T ∈ K,
      |D7 (h n) T - D7 g T| < ε := by
  intro ε hε
  obtain ⟨N, hN⟩ := huniform (ε / 2) (half_pos hε)
  refine ⟨N, fun n hn T hTK ↦ ?_⟩
  exact lt_of_le_of_lt
    (A8W (h n) g (hK hTK)
      (half_pos hε).le (fun i ↦ (hN n hn i).le))
    (half_lt_self hε)
theorem APZ
    (h : ℕ → Fin 4 → ℝ) (g : Fin 4 → ℝ)
    (huniform : ∀ ε > 0, ∃ N : ℕ, ∀ n ≥ N, ∀ i, |h n i - g i| < ε) :
    ∀ ε > 0, ∃ N : ℕ, ∀ n ≥ N, ∀ T ∈ Set.Ioo (2 : ℝ) 5,
      |D7 (h n) T - D7 g T| < ε :=
  APV h g
    (Set.Ioo (2 : ℝ) 5) (fun _ hT ↦ hT) huniform
end
end Erdos625.ProfileEntropyS4
end M039

section M040
open Filter
open scoped Topology
namespace Erdos625
noncomputable section
def Ao (i : Fin 4) : Nat := i.1 + 2
def C5 (alpha : Nat) (i : Fin 4) : Real :=
  Real.log (alpha.descFactorial (Ao i) : Real) -
    (Ao i : Real) * Real.log (alpha : Real) -
      q / 2 * (Ao i : Real) ^ 2
def Ak (i : Fin 4) : Real :=
  -(q / 2) * ProfileEntropyS4.support i ^ 2
@[simp] theorem AB1 : Ao 0 = 2 := by
  rfl
@[simp] theorem AAy : Ao 1 = 3 := by
  rfl
@[simp] theorem AB0 : Ao 2 = 4 := by
  rfl
@[simp] theorem AAz : Ao 3 = 5 := by
  rfl
@[simp] theorem mC (i : Fin 4) :
    (Ao i : Real) = ProfileEntropyS4.support i := by
  simp [Ao, ProfileEntropyS4.support]
theorem AjK
    (alpha : Nat) (i : Fin 4) (h : Ao i < alpha) :
    R9 alpha
        (Fin.rev ((⟨Ao i, h⟩ : Fin alpha).succ)) =
      C5 alpha i := by
  have hsize :
      (Fin.rev ((⟨Ao i, h⟩ : Fin alpha).succ)).1 + 1 ≤ alpha := by
    rw [Fin.val_rev, Fin.val_succ]
    omega
  have hsub :
      alpha -
          ((Fin.rev ((⟨Ao i, h⟩ : Fin alpha).succ)).1 + 1) =
        Ao i := by
    rw [Fin.val_rev, Fin.val_succ]
    change
      alpha - (alpha + 1 - (Ao i + 1 + 1) + 1) =
        Ao i
    omega
  rw [A0V alpha _ hsize, hsub]
  rfl
theorem A0z (i : Fin 4) :
    Tendsto
      (fun alpha : Nat => C5 alpha i)
      atTop
      (nhds (Ak i)) := by
  have hcorr := AHs (Ao i)
  have PS := hcorr.sub_const
    (q / 2 * (Ao i : Real) ^ 2)
  simpa [C5, Ak,
    mC] using PS
theorem A2J :
    ∀ epsilon > 0, ∃ N : Nat, ∀ alpha ≥ N, ∀ i : Fin 4,
      |C5 alpha i - Ak i| < epsilon := by
  intro epsilon hepsilon
  obtain ⟨N0, hN0⟩ :=
    (Metric.tendsto_atTop.mp (A0z (0 : Fin 4)))
      epsilon hepsilon
  obtain ⟨N1, hN1⟩ :=
    (Metric.tendsto_atTop.mp (A0z (1 : Fin 4)))
      epsilon hepsilon
  obtain ⟨N2, hN2⟩ :=
    (Metric.tendsto_atTop.mp (A0z (2 : Fin 4)))
      epsilon hepsilon
  obtain ⟨N3, hN3⟩ :=
    (Metric.tendsto_atTop.mp (A0z (3 : Fin 4)))
      epsilon hepsilon
  refine ⟨max (max N0 N1) (max N2 N3), fun alpha C9 i ↦ ?_⟩
  fin_cases i
  · simpa [Real.dist_eq] using hN0 alpha (by omega)
  · simpa [Real.dist_eq] using hN1 alpha (by omega)
  · simpa [Real.dist_eq] using hN2 alpha (by omega)
  · simpa [Real.dist_eq] using hN3 alpha (by omega)
theorem wC :
    ∀ epsilon > 0, ∃ N : Nat, ∀ alpha ≥ N,
      ∀ T ∈ Set.Ioo (2 : Real) 5,
        |ProfileEntropyS4.D7 (C5 alpha) T -
          ProfileEntropyS4.D7 Ak T| < epsilon := by
  exact
    ProfileEntropyS4.APZ
      C5 Ak A2J
end
end Erdos625
end M040

section M041
open Filter Finset
namespace Erdos625.ProfileEntropyS4
noncomputable section
theorem A8B
    {A : Type*} {l : Filter A}
    (h : A → Fin 4 → ℝ) (g : Fin 4 → ℝ)
    (t : A → ℝ) (t₀ : ℝ)
    (O4 : ∀ i, Tendsto (fun a ↦ h a i) l (nhds (g i)))
    (ht : Tendsto t l (nhds t₀)) (i : Fin 4) :
    Tendsto (fun a ↦ unnormalized (h a) (t a) i) l
      (nhds (unnormalized g t₀ i)) := by
  apply Real.continuous_exp.continuousAt.tendsto.comp
  exact (O4 i).add (ht.mul_const (support i))
theorem A10
    {A : Type*} {l : Filter A}
    (h : A → Fin 4 → ℝ) (g : Fin 4 → ℝ)
    (t : A → ℝ) (t₀ : ℝ)
    (O4 : ∀ i, Tendsto (fun a ↦ h a i) l (nhds (g i)))
    (ht : Tendsto t l (nhds t₀)) :
    Tendsto (fun a ↦ partition (h a) (t a)) l
      (nhds (partition g t₀)) := by
  simp only [partition]
  simpa using tendsto_finsetSum Finset.univ
    (fun i _hi ↦
      A8B h g t t₀ O4 ht i)
theorem AoW
    {A : Type*} {l : Filter A}
    (h : A → Fin 4 → ℝ) (g : Fin 4 → ℝ)
    (t : A → ℝ) (t₀ : ℝ)
    (O4 : ∀ i, Tendsto (fun a ↦ h a i) l (nhds (g i)))
    (ht : Tendsto t l (nhds t₀)) :
    Tendsto (fun a ↦ Qe (h a) (t a)) l
      (nhds (Qe g t₀)) := by
  simp only [Qe]
  simpa using tendsto_finsetSum Finset.univ
    (fun i _hi ↦
      (A8B
        h g t t₀ O4 ht i).const_mul (support i))
theorem Aob
    {A : Type*} {l : Filter A}
    (h : A → Fin 4 → ℝ) (g : Fin 4 → ℝ)
    (t : A → ℝ) (t₀ : ℝ)
    (O4 : ∀ i, Tendsto (fun a ↦ h a i) l (nhds (g i)))
    (ht : Tendsto t l (nhds t₀)) :
    Tendsto (fun a ↦ mean (h a) (t a)) l (nhds (mean g t₀)) := by
  exact (AoW
      h g t t₀ O4 ht).div
    (A10 h g t t₀ O4 ht)
    (ne_of_gt (QF g t₀))
theorem AHw
    {A : Type*} {l : Filter A}
    (h : A → Fin 4 → ℝ) (g : Fin 4 → ℝ) (t : ℝ)
    (O4 : ∀ i, Tendsto (fun a ↦ h a i) l (nhds (g i))) :
    Tendsto (fun a ↦ mean (h a) t) l (nhds (mean g t)) := by
  simpa using Aob h g
    (fun _ ↦ t) t O4 tendsto_const_nhds
theorem Ap3
    {A : Type*} {l : Filter A}
    (h : A → Fin 4 → ℝ) (g : Fin 4 → ℝ)
    (t : A → ℝ) (t₀ : ℝ)
    (O4 : ∀ i, Tendsto (fun a ↦ h a i) l (nhds (g i)))
    (ht : Tendsto t l (nhds t₀)) (i : Fin 4) :
    Tendsto (fun a ↦ weight (h a) (t a) i) l
      (nhds (weight g t₀ i)) := by
  exact (A8B
      h g t t₀ O4 ht i).div
    (A10 h g t t₀ O4 ht)
    (ne_of_gt (QF g t₀))
theorem l6
    {A : Type*} {l : Filter A}
    (h : A → Fin 4 → ℝ) (g : Fin 4 → ℝ)
    (T' : A → ℝ) {T : ℝ}
    (O4 : ∀ i, Tendsto (fun a ↦ h a i) l (nhds (g i)))
    (hT' : Tendsto T' l (nhds T))
    (hT : T ∈ Set.Ioo (2 : ℝ) 5) :
    Tendsto (fun a ↦ tilt (h a) (T' a)) l (nhds (tilt g T)) := by
  rw [tendsto_order]
  constructor
  · intro lower Qw
    have A3m : mean g lower < T := by
      calc
        mean g lower < mean g (tilt g T) := Vi g Qw
        _ = T := Mr g hT
    have Xh : ∀ᶠ a in l, mean (h a) lower < T' a :=
      (AHw h g lower O4).eventually_lt
        hT' A3m
    have d6 : ∀ᶠ a in l, T' a ∈ Set.Ioo (2 : ℝ) 5 :=
      hT' (isOpen_Ioo.mem_nhds hT)
    filter_upwards [Xh, d6] with a ha hTa
    have A4N := Mr (h a) hTa
    rw [← A4N] at ha
    exact (Vi (h a)).lt_iff_lt.mp ha
  · intro upper Qz
    have A3n : T < mean g upper := by
      calc
        T = mean g (tilt g T) := (Mr g hT).symm
        _ < mean g upper := Vi g Qz
    have Xh : ∀ᶠ a in l, T' a < mean (h a) upper :=
      hT'.eventually_lt
        (AHw h g upper O4) A3n
    have d6 : ∀ᶠ a in l, T' a ∈ Set.Ioo (2 : ℝ) 5 :=
      hT' (isOpen_Ioo.mem_nhds hT)
    filter_upwards [Xh, d6] with a ha hTa
    have A4N := Mr (h a) hTa
    rw [← A4N] at ha
    exact (Vi (h a)).lt_iff_lt.mp ha
theorem A84
    {A : Type*} {l : Filter A}
    (h : A → Fin 4 → ℝ) (g : Fin 4 → ℝ)
    (T' : A → ℝ) {T : ℝ}
    (O4 : ∀ i, Tendsto (fun a ↦ h a i) l (nhds (g i)))
