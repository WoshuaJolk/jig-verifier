    (matching : Jv L k ell) (i : I) (j : J) :
    Fintype.card ((matching.FJ i).1 j : Finset (Fin (k i))) =
      L i j := by
  simpa using (matching.FJ i).2.1 j
theorem AKw
    {I J : Type*}
    [Fintype I] [Fintype J] [DecidableEq I] [DecidableEq J]
    {L : I -> J -> Nat} {k : I -> Nat} {ell : J -> Nat}
    (matching : Jv L k ell) (i : I) (j : J) :
    Fintype.card ((matching.Ov j).1 i : Finset (Fin (ell j))) =
