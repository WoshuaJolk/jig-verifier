    (UZ P Q σ τ).edgeSet.ncard +
        (UR P Q σ τ).edgeSet.ncard =
      2 * AG.Eo k -
        K6 (fun A B => P.overlapCellCount Q A B) := by
  have h := AmT P Q σ τ OZ
  omega
theorem AkY
    {b n : ℕ} {k : AG b}
    (P Q : BT n k)
    (σ : P.1.parts → Bool) (τ : Q.1.parts → Bool)
    (OZ : ∀ A B,
      2 ≤ P.overlapCellCount Q A B → σ A = τ B) :
    randomGraphMeasure n (iF P Q σ τ) =
      (1 / 2 : ENNReal) ^
        (2 * AG.Eo k -
          K6 (fun A B => P.overlapCellCount Q A B)) := by
  rw [AGu,
    AkX _ _
      ((A7m P Q σ τ).mpr
        OZ),
    AmS P Q σ τ OZ]
noncomputable def iG
    {b : ℕ} (n : ℕ) {k : AG b}
    (P Q : BT n k) : ENNReal :=
  ∑ σ : P.1.parts → Bool, ∑ τ : Q.1.parts → Bool,
    randomGraphMeasure n (iF P Q σ τ)
theorem AmP
    {b n : ℕ} {k : AG b}
    (P Q : BT n k) :
    iG n P Q =
      (Nat.card (RG
        (fun A B => P.overlapCellCount Q A B)) : ENNReal) *
      (1 / 2 : ENNReal) ^
        (2 * AG.Eo k -
          K6
            (fun A B => P.overlapCellCount Q A B)) := by
  classical
  let r := fun A B => P.overlapCellCount Q A B
  let p : ENNReal := (1 / 2 : ENNReal) ^
    (2 * AG.Eo k - K6 r)
  have hterm (σ : P.1.parts → Bool) (τ : Q.1.parts → Bool) :
      randomGraphMeasure n (iF P Q σ τ) =
        if (∀ A B, 2 ≤ r A B → σ A = τ B) then p else 0 := by
    by_cases OZ : ∀ A B, 2 ≤ r A B → σ A = τ B
    · rw [if_pos OZ]
      simpa [r, p] using
        AkY
          P Q σ τ OZ
    · rw [if_neg OZ,
        AmO P Q σ τ OZ]
      simp
  unfold iG
  simp_rw [hterm]
  rw [← Fintype.sum_prod_type']
  change (∑ s : j3 P.1.parts Q.1.parts,
      if (∀ A B, 2 ≤ r A B → s.1 A = s.2 B) then p else 0) =
    (Nat.card (RG r) : ENNReal) * p
  let T := (Finset.univ : Finset
    (j3 P.1.parts Q.1.parts)).filter
      fun s => ∀ A B, 2 ≤ r A B → s.1 A = s.2 B
  let e : {s // s ∈ T} ≃ RG r := {
    toFun := fun s => ⟨s.1, by simpa [T] using s.2⟩
    invFun := fun s => ⟨s.1, by simpa [T] using s.2⟩
    left_inv := fun s => by apply Subtype.ext; rfl
    right_inv := fun s => by apply Subtype.ext; rfl }
  have dM : T.card = Nat.card (RG r) := by
    calc
      T.card = Nat.card {s // s ∈ T} := by
        rw [Nat.card_eq_fintype_card]
        simp
      _ = Nat.card (RG r) := Nat.card_congr e
  calc
    _ = ∑ _s ∈ T, p := by
      simpa only [T] using
        (Finset.sum_filter
          (fun s : j3 P.1.parts Q.1.parts =>
            ∀ A B, 2 ≤ r A B → s.1 A = s.2 B)
          (fun _s => p)).symm
    _ = (T.card : ENNReal) * p := by simp [nsmul_eq_mul]
    _ = (Nat.card (RG r) : ENNReal) * p := by
      rw [dM]
private theorem AYR
    (a w : ℕ) (hw : w ≤ a) :
    (1 / 2 : ENNReal) ^ (a - w) * (2 : ENNReal) ^ a =
      (2 : ENNReal) ^ w := by
  conv_lhs =>
    rhs
    rw [show a = (a - w) + w by omega, pow_add]
  rw [← mul_assoc, ← mul_pow]
  rw [div_eq_mul_inv, one_mul,
    ENNReal.inv_mul_cancel (by norm_num) (by norm_num), one_pow, one_mul]
theorem AmQ
    {b n : ℕ} {k : AG b}
    (P Q : BT n k) :
    iG n P Q *
        (2 : ENNReal) ^ (2 * AG.Eo k) =
      (2 : ENNReal) ^ (2 * AG.D8 k) *
        (DM
          (fun A B => P.overlapCellCount Q A B) : ENNReal) := by
  classical
  let r := fun A B => P.overlapCellCount Q A B
  let W := K6 r
  let Bk := AG.Eo k
  let K := AG.D8 k
  have hW : W ≤ 2 * Bk := by
    have h := A6o P Q
    rw [← AFD P Q] at h
    change (Gq P.1 ⊔
      Gq Q.1).edgeSet.ncard + W = 2 * Bk at h
    omega
  have hPc : Fintype.card P.1.parts = K := by
    simpa [K] using P.card_parts_eq
  have hQc : Fintype.card Q.1.parts = K := by
    simpa [K] using Q.card_parts_eq
  have AVX :
      Nat.card (RG r) =
        Nat.card (Vr r) :=
    AgX r
  have hNat :
      Nat.card (RG r) * 2 ^ W =
        2 ^ (2 * K) * DM r := by
    rw [AVX]
    have hlocal := AGo r
    simpa [W, K, hPc, hQc, two_mul] using hlocal
  have hCast := congrArg (fun x : ℕ => (x : ENNReal)) hNat
  norm_num only [Nat.cast_mul, Nat.cast_pow, Nat.cast_ofNat] at hCast
  rw [AmP]
  change ((Nat.card (RG r) : ENNReal) *
      (1 / 2 : ENNReal) ^ (2 * Bk - W)) *
      (2 : ENNReal) ^ (2 * Bk) =
    (2 : ENNReal) ^ (2 * K) * (DM r : ENNReal)
  rw [mul_assoc, AYR (2 * Bk) W hW]
  exact hCast
end
end Erdos625
