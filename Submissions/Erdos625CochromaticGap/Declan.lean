    b - ∫ omega, X omega ∂mu ≤ Real.sqrt (2 * (v : ℝ) * Lambda) := by
  apply AGN A4Y A4X hBound
    (show 0 < (v : ℝ) by exact_mod_cast hv) GU hSeed
  intro t ht
  exact AWs.measure_ge_le ht
