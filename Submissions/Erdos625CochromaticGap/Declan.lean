    (a, b) ∈ Md alpha A8 k
        (Jy alpha A8 k L AN D) ↔
      ∃ e : ↥D.1.1.edges,
        a = Bc alpha A8 k AN e.1.1 ∧
        b = Bc alpha A8 k AN e.1.2 := by
