            ((4 * (Real.log (n : ℝ) / Real.log 2)) ^ 3 *
              (Real.log (n : ℝ) ^ 6 / (n : ℝ))) := by
          exact mul_le_mul_of_nonneg_left
            (mul_le_mul AXN hinv (by positivity) (by positivity)) hC
        _ = C * (4 * (Real.log (n : ℝ) / Real.log 2)) ^ 3 *
              Real.log (n : ℝ) ^ 6 / (n : ℝ) := by ring
