    {A B : Type*} [Fintype A] [Fintype B]
    [DecidableEq A] [DecidableEq B]
    {C M : Finset (A × B)} {code : Jt A B}
    (hcut : QX C M code) :
    (Fj code.chain).length = (C \ M).card := by
  calc
    (Fj code.chain).length =
        ((Fj code.chain).filterMap
          DS).length :=
      hcut.Al3.symm
    _ = (((Fj code.chain).filterMap
          DS).toFinset).card :=
      (List.toFinset_card_of_nodup hcut.A7Y).symm
    _ = (Yq code.chain).card := rfl
    _ = (C \ M).card := congrArg Finset.card hcut.A0Z
theorem AlL
    {A B : Type*} [Fintype A] [Fintype B]
    [DecidableEq A] [DecidableEq B]
    {C M : Finset (A × B)} {code : Jt A B}
    (hcut : QX C M code) (q : A → B → ℝ≥0∞) :
    O6 (EW q)
        (Fj code.chain) =
      (C \ M).prod (fun cell => q cell.1 cell.2) := by
