section M131
namespace Erdos625
open SimpleGraph
open scoped BigOperators
noncomputable section
def N8 {A B A' B' : Type*}
    (eA : A ≃ A') (eB : B ≃ B') (r : A → B → Nat) : A' → B' → Nat :=
  fun a' b' => r (eA.symm a') (eB.symm b')
noncomputable def AmD
    {A B A' B' : Type*} [Fintype A] [Fintype B] [Fintype A'] [Fintype B']
    (eA : A ≃ A') (eB : B ≃ B') (r : A → B → Nat) :
    F3 r ≃g
      F3 (N8 eA eB r) where
  toEquiv := Equiv.sumCongr eA eB
  map_rel_iff' := by
    intro u v
    rcases u with a | b <;> rcases v with a' | b' <;>
      simp [F3, CX, N8]
theorem AMb
    {A B A' B' : Type*} [Fintype A] [Fintype B] [Fintype A'] [Fintype B']
    (eA : A ≃ A') (eB : B ≃ B') (r : A → B → Nat) :
    IQ (F3 r) =
      IQ (F3 (N8 eA eB r)) := by
  classical
  letI : DecidableEq (A ⊕ B) := Classical.decEq _
  letI : DecidableEq (A' ⊕ B') := Classical.decEq _
  let φ := AmD eA eB r
  have hEdge : (F3 r).edgeFinset.card =
      (F3 (N8 eA eB r)).edgeFinset.card := by
    calc
      (F3 r).edgeFinset.card =
          Fintype.card (F3 r).edgeSet :=
        SimpleGraph.edgeFinset_card
      _ = Fintype.card
          (F3 (N8 eA eB r)).edgeSet :=
        Fintype.card_congr φ.mapEdgeSet
      _ = (F3 (N8 eA eB r)).edgeFinset.card :=
        SimpleGraph.edgeFinset_card.symm
  have hComp : Fintype.card (F3 r).ConnectedComponent =
      Fintype.card
        (F3 (N8 eA eB r)).ConnectedComponent :=
    Fintype.card_congr φ.connectedComponentEquiv
  have hVert : Fintype.card (A ⊕ B) = Fintype.card (A' ⊕ B') :=
    φ.card_eq
  unfold IQ
  calc
    (F3 r).edgeFinset.card +
          Fintype.card (F3 r).ConnectedComponent -
        Fintype.card (A ⊕ B) =
      (F3 (N8 eA eB r)).edgeFinset.card +
          Fintype.card (F3 r).ConnectedComponent -
        Fintype.card (A ⊕ B) := by rw [hEdge]
    _ = (F3 (N8 eA eB r)).edgeFinset.card +
          Fintype.card
            (F3 (N8 eA eB r)).ConnectedComponent -
        Fintype.card (A ⊕ B) := by rw [hComp]
    _ = (F3 (N8 eA eB r)).edgeFinset.card +
          Fintype.card
            (F3 (N8 eA eB r)).ConnectedComponent -
        Fintype.card (A' ⊕ B') := by rw [hVert]
theorem AmC
    {A B A' B' : Type*} [Fintype A] [Fintype B] [Fintype A'] [Fintype B']
    (eA : A ≃ A') (eB : B ≃ B') (r : A → B → Nat) :
    DM r =
      DM (N8 eA eB r) := by
  have hprod :
      (∏ a, ∏ b, C8 (r a b)) =
        ∏ a', ∏ b', C8
          (N8 eA eB r a' b') := by
    calc
      (∏ a, ∏ b, C8 (r a b)) =
          ∏ x : A × B, C8 (r x.1 x.2) :=
        (Fintype.prod_prod_type' fun a : A => fun b : B =>
          C8 (r a b)).symm
      _ = ∏ x' : A' × B', C8
          (N8 eA eB r x'.1 x'.2) := by
        apply Fintype.prod_equiv (eA.prodCongr eB)
        intro x
        simp [N8]
      _ = ∏ a', ∏ b', C8
          (N8 eA eB r a' b') :=
        Fintype.prod_prod_type'
          (fun a' : A' => fun b' : B' =>
            C8 (N8 eA eB r a' b'))
  unfold DM
  rw [hprod, AMb eA eB r]
end
