    {C M : Finset (A × B)} {code : Jt A B}
    (hcut : QX C M code) :
    Tj code.chain = C := by
  rw [AMf,
    hcut.A0Z, hcut.A14]
  ext edge
  simp
  tauto
theorem AyN
    {A B : Type*} [Fintype A] [Fintype B]
    [DecidableEq A] [DecidableEq B]
    {C M : Finset (A × B)} {code : Jt A B}
    (hcut : QX C M code) :
    (GO code.chain).length = (C ∩ M).card := by
  rw [Jt.A8E, hcut.A1T]
theorem AyL
    {A B : Type*} [Fintype A] [Fintype B]
    [DecidableEq A] [DecidableEq B]
    {C M : Finset (A × B)} {code : Jt A B}
    (hcut : QX C M code) :
    ((GO code.chain).filterMap
      DS).length = (C ∩ M).card := by
  calc
    ((GO code.chain).filterMap
        DS).length =
        (((GO code.chain).filterMap
          DS).toFinset).card :=
      (List.toFinset_card_of_nodup hcut.AI3).symm
    _ = (XO code.chain).card := rfl
    _ = (C ∩ M).card := congrArg Finset.card hcut.A14
