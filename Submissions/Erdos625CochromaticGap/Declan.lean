    have hrep : Pd e q ∈
        (F8 e).part v :=
      (r8 e v
        (Pd e q)).mpr (by simp [q])
    calc
      (F8 e).part (Pd e q) =
          (F8 e).part v :=
        ((F8 e).mem_part_iff_part_eq_part
          (Finset.mem_univ _) (Finset.mem_univ _)).mp hrep
      _ = B.1 := (F8 e).part_eq_of_mem B.2 hv
@[simp] theorem A7h {b n : ℕ}
    {k : AG b}
