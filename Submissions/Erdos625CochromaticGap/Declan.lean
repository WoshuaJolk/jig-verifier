        s(Sum.inl e.1.1, Sum.inr e.1.2) =
          s(Sum.inl f.1.1, Sum.inr f.1.2) := congrArg Subtype.val hef
    have hp : e.1.1 = f.1.1 ∧ e.1.2 = f.1.2 := by
      simpa [Sym2.eq_iff] using hsym
    exact Prod.ext hp.1 hp.2
