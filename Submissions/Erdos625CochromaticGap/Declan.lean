    Real.tendsto_log_atTop.comp (tendsto_natCast_atTop_atTop (R := ℝ))
theorem GZ : Tendsto AY atTop atTop := by
  change Tendsto (fun n : ℕ ↦ Real.log (AH n)) atTop atTop
  simpa only [Function.comp_def] using
    Real.tendsto_log_atTop.comp CQ
theorem r6 :
    (fun n : ℕ ↦ AH n) =o[atTop] (fun n : ℕ ↦ (n : ℝ)) := by
  simpa only [AH, Function.comp_def, id_eq] using
    Real.isLittleO_log_id_atTop.comp_tendsto
