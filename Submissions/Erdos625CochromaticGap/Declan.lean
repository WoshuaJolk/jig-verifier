    (table : EO n row BU) :
    vG row BU table =
      ((∏ a, (EH row a).factorial) *
          ∏ b, (BU b).factorial : ℕ) /
        (((n.factorial *
          ∏ a, ∏ b, (table.Cd a b).factorial : ℕ) : ℚ)) := by
  exact AJh row BU table
theorem AqX
    {A B : Type*} [Fintype A] [Fintype B]
    [DecidableEq A] [DecidableEq B]
    {n : ℕ} {row : Fin n → A} {BU : B → ℕ}
    (table : EO n row BU) :
    A1W table =
      ((∏ a, ∏ b, C8 (table.Cd a b)) *
        2 ^ IQ (F3 table.Cd) : ℕ) := by
  rfl
theorem Axe
    {A B : Type*} [Fintype A] [Fintype B]
    [DecidableEq A] [DecidableEq B]
    {n : ℕ} (row : Fin n → A) (BU : B → ℕ)
    (hne : Fintype.card (FL (V := Fin n) BU) ≠ 0) :
    (∑ table : EO n row BU,
      vG row BU table) = 1 := by
  unfold vG
  rw [← Finset.sum_div]
  rw [← Nat.cast_sum]
  rw [← AKP]
  exact div_self (Nat.cast_ne_zero.mpr hne)
theorem AxX
    {A B : Type*} [Fintype A] [Fintype B]
    [DecidableEq A] [DecidableEq B]
    {n : ℕ} (row : Fin n → A) (BU : B → ℕ) :
    AGw row BU =
      ∑ table : EO n row BU,
        (((∏ a, (EH row a).factorial) *
              ∏ b, (BU b).factorial : ℕ) /
            (((n.factorial *
              ∏ a, ∏ b, (table.Cd a b).factorial : ℕ) : ℚ))) *
          (DM table.Cd : ℚ) := by
  unfold AGw A1W
