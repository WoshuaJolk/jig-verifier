  rw [SimpleGraph.edgeSet_sup]
  exact Set.ncard_union_eq (SimpleGraph.disjoint_edgeSet.mpr hdis)
theorem Agg {n : ℕ}
    (Hpresent E0 : LabeledGraph n)
    (hdis : Disjoint Hpresent E0) :
    (Mt Hpresent E0).ncard =
      2 ^ (n.choose 2 -
        (Hpresent.edgeSet.ncard + E0.edgeSet.ncard)) := by
  change Nat.card {G : LabeledGraph n //
    G ∈ Mt Hpresent E0} = _
