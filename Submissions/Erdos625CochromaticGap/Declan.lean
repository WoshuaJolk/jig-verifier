      ((Nq u (GW n) + Ip n : ℕ) : ℝ) ≤
          14 * Real.log 4 * (u : ℝ) / Real.log n +
            (Ip n : ℝ) + 1 :=
        by simpa only [Nat.cast_add] using hcount u
      _ ≤ 14 * Real.log 4 * (u : ℝ) / Real.log n +
            ((n : ℝ) ^ (1 / 3 : ℝ) + 1) + 1 := by
        linarith
      _ = 14 * Real.log 4 * (u : ℝ) / Real.log n +
            (n : ℝ) ^ (1 / 3 : ℝ) + 2 := by ring
      _ ≤ 14 * Real.log 4 * (u : ℝ) / Real.log n +
            (n : ℝ) ^ (1 / 3 : ℝ) +
              (2 * (u : ℝ) / Real.log n) := by
        gcongr
      _ = (14 * Real.log 4 + 2) * (u : ℝ) / Real.log n +
            (n : ℝ) ^ (1 / 3 : ℝ) := by ring
