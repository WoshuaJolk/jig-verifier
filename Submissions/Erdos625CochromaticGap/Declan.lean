    (exceptional : ℝ) (p : ℕ → ℝ) (N : ℕ) : ℝ :=
  exceptional + ∑ d ∈ range N, p d
def KO
    (exceptional : ℝ) (p : ℕ → ℝ) (N : ℕ) : ℝ :=
  -exceptional + ∑ d ∈ range N, (d : ℝ) * p d
def Py
    (a tilt : ℝ) (N : ℕ) : ℝ :=
  D6 a tilt / Bd a tilt +
    ∑ d ∈ range N,
      B8 a tilt d / Bd a tilt
theorem AoV
    {a tilt : ℝ} (ha : 0 < a) :
    Tendsto (Py a tilt) atTop (nhds 1) := by
  have hsum : Tendsto
      (fun N ↦ ∑ d ∈ range N, B8 a tilt d)
      atTop (nhds (∑' d : ℕ, B8 a tilt d)) :=
    (Vk ha).hasSum.tendsto_sum_nat
  have hdiv := hsum.div_const (Bd a tilt)
  have hadd : Tendsto
      (fun N ↦ D6 a tilt /
          Bd a tilt +
        (∑ d ∈ range N, B8 a tilt d) /
          Bd a tilt)
      atTop (nhds (D6 a tilt /
          Bd a tilt +
        (∑' d : ℕ, B8 a tilt d) /
          Bd a tilt)) :=
    tendsto_const_nhds.add hdiv
  have hfun : Py a tilt =
      fun N ↦ D6 a tilt /
          Bd a tilt +
        (∑ d ∈ range N, B8 a tilt d) /
          Bd a tilt := by
    funext N
    unfold Py
    rw [Finset.sum_div]
  have A5Y : D6 a tilt /
          Bd a tilt +
        (∑' d : ℕ, B8 a tilt d) /
          Bd a tilt = 1 := by
    rw [← add_div, ← Bd]
    exact div_self (XS ha)
  rw [hfun, ← A5Y]
  exact hadd
theorem AQM
    {a target tilt L7 exceptional : ℝ} {p : ℕ → ℝ}
    (ha : 0 < a)
    (UA : 0 ≤ exceptional)
    (hp : ∀ d, 0 ≤ p d)
    (hfinite : 0 ≤ exceptional → (∀ d, 0 ≤ p d) → ∀ N,
      KM a exceptional p N ≤
        Py a tilt N -
          Fd exceptional p N +
          Real.log (Bd a tilt) *
            Fd exceptional p N -
          tilt * KO exceptional p N)
    (hmass : Tendsto (Fd exceptional p)
      atTop (nhds 1))
    (Se : Tendsto (KO exceptional p)
      atTop (nhds target))
    (Qv : Tendsto (KM a exceptional p)
      atTop (nhds L7)) :
    L7 ≤
      Real.log (Bd a tilt) - tilt * target := by
  have href := AoV
    (a := a) (tilt := tilt) ha
  have Aaz : Tendsto
      (fun N ↦ Real.log (Bd a tilt) *
        Fd exceptional p N)
      atTop (nhds (Real.log (Bd a tilt) * 1)) :=
    tendsto_const_nhds.mul hmass
  have Adl : Tendsto
      (fun N ↦ tilt * KO exceptional p N)
      atTop (nhds (tilt * target)) :=
    tendsto_const_nhds.mul Se
  have hrhs : Tendsto
      (fun N ↦ Py a tilt N -
        Fd exceptional p N +
        Real.log (Bd a tilt) *
          Fd exceptional p N -
        tilt * KO exceptional p N)
      atTop (nhds (Real.log (Bd a tilt) -
        tilt * target)) := by
    simpa only [sub_self, zero_add, mul_one] using
      ((href.sub hmass).add Aaz).sub Adl
  exact le_of_tendsto_of_tendsto' Qv hrhs (hfinite UA hp)
theorem wP
    {target tilt L7 exceptional : ℝ} {p : ℕ → ℝ}
    (UA : 0 ≤ exceptional)
    (hp : ∀ d, 0 ≤ p d)
    (hfinite : 0 ≤ exceptional → (∀ d, 0 ≤ p d) → ∀ N,
      KM q exceptional p N ≤
        Py q tilt N -
          Fd exceptional p N +
          Real.log (Bd q tilt) *
            Fd exceptional p N -
          tilt * KO exceptional p N)
    (hmass : Tendsto (Fd exceptional p)
      atTop (nhds 1))
    (Se : Tendsto (KO exceptional p)
      atTop (nhds target))
    (Qv : Tendsto (KM q exceptional p)
      atTop (nhds L7)) :
    L7 ≤ RQ target tilt := by
  exact AQM q_pos UA hp
    hfinite hmass Se Qv
theorem AxY
    {target tilt L7 exceptional : ℝ} {p : ℕ → ℝ}
    (ZJ : ProfileEntropyS4.mean Ak tilt = target)
    (UA : 0 ≤ exceptional)
    (hp : ∀ d, 0 ≤ p d)
    (hfinite : 0 ≤ exceptional → (∀ d, 0 ≤ p d) → ∀ N,
      KM q exceptional p N ≤
        Py q tilt N -
          Fd exceptional p N +
