    rw [UZ, UR,
      disjoint_sup_left, disjoint_sup_right, disjoint_sup_right]
    exact ⟨⟨AGr P σ,
      AGn P Q σ τ OZ⟩,
      (Am4 P Q σ τ OZ).symm,
      AGr Q τ⟩
theorem AGu
    {b n : ℕ} {k : AG b}
    (P Q : BT n k)
    (σ : P.1.parts → Bool) (τ : Q.1.parts → Bool) :
    iF P Q σ τ =
      Mt
        (UZ P Q σ τ)
        (UR P Q σ τ) := by
  rw [iF,
    AGv P σ,
    AGv Q τ]
  ext G
  simp only [Set.mem_inter_iff, Mt, Set.mem_setOf_eq,
    UZ, UR,
    sup_le_iff, compl_sup]
  constructor
  · rintro ⟨⟨hp, ha⟩, hq, hb⟩
    exact ⟨⟨hp, hq⟩, le_inf ha hb⟩
  · rintro ⟨⟨hp, hq⟩, hab⟩
    exact ⟨⟨hp, hab.trans inf_le_left⟩, hq, hab.trans inf_le_right⟩
theorem AmO
    {b n : ℕ} {k : AG b}
    (P Q : BT n k)
    (σ : P.1.parts → Bool) (τ : Q.1.parts → Bool)
    (Aab : ¬ ∀ A B,
      2 ≤ P.overlapCellCount Q A B → σ A = τ B) :
    iF P Q σ τ = ∅ := by
  rw [AGu]
  ext G
  simp only [Set.mem_empty_iff_false, iff_false]
  intro hG
  have AaK : Disjoint
      (UZ P Q σ τ)
      (UR P Q σ τ) := by
    rw [Mt, Set.mem_setOf_eq] at hG
    exact (le_compl_iff_disjoint_right.mp hG.2).mono_left hG.1
