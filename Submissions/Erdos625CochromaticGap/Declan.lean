  apply ENNReal.mul_pos
  · exact ENNReal.pow_ne_zero (by norm_num) _
  · exact mul_ne_zero (Nat.cast_ne_zero.mpr hcard)
      (ENNReal.pow_ne_zero (by norm_num) _)
theorem AmI
    {b n : ℕ} {k : AG b}
    (row₀ : Ac n k) :
    DY n k ≠ 0 :=
  (AmJ row₀).ne'
theorem A0l
    {b n : ℕ} {k : AG b}
    (row₀ : Ac n k) :
    DY n k ^ 2 ≠ 0 :=
  ENNReal.pow_ne_zero
    (AmI row₀) 2
theorem A0k
    {b : ℕ} (n : ℕ) (k : AG b) :
    DY n k ^ 2 ≠ ∞ :=
  ENNReal.pow_ne_top (AGq n k)
theorem AxV
    {b n : ℕ} {k : AG b}
    (row₀ : Ac n k) :
    DY n k ^ 2 /
        DY n k ^ 2 = 1 :=
  ENNReal.div_self
    (A0l row₀)
    (A0k n k)
theorem ArD
    {b n : ℕ} {k : AG b}
    (row₀ : Ac n k) (x : ENNReal) :
