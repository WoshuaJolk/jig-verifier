private lemma ANB (alpha : Nat) (A8 : 5 < alpha) (r : Fin 4 → ℕ) :
    bU alpha A8 r
      = ((KI alpha A8 r : ℕ) : ENNReal) := by
  unfold bU KI Lm Ec
