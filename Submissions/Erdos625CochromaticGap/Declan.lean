  have hCard := Fintype.card_le_of_embedding (Yc witness)
  rw [lN witness, XK row] at hCard
  exact (Nat.not_le_of_gt h) hCard
theorem Aem
    {A B : Type*}
    [Fintype A] [Fintype B] [DecidableEq A] [DecidableEq B]
    (demand : A → B → ℕ) (row : A → ℕ) (col : B → ℕ)
