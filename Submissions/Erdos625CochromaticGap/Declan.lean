namespace Submissions.Erdos625CochromaticGap.Declan

open Filter MeasureTheory

/-- A partition into at most k clique-or-independent parts, allowing empty fibers. -/
def CoColorable {n : ℕ} (G : SimpleGraph (Fin n)) (k : ℕ) : Prop :=
  ∃ color : Fin n → Fin k, ∀ c : Fin k,
    G.IsClique {v | color v = c} ∨ G.IsIndepSet {v | color v = c}

noncomputable def halfProbability : unitInterval :=
  ⟨(1 : ℝ) / 2, by constructor <;> norm_num⟩

/-- A co-coloring saves at least C parts relative to an optimal proper coloring. -/
def gapEvent (C n : ℕ) : Set (SimpleGraph (Fin n)) :=
  {G | ∃ k : ℕ, CoColorable G k ∧ k + C ≤ ENat.toNat G.chromaticNumber}

/-- The original full-sequence divergence question, in probability. -/
abbrev statement : Prop :=
  ∀ C : ℕ, Tendsto
    (fun n : ℕ => SimpleGraph.binomialRandom (Fin n) halfProbability (gapEvent C n))
    atTop (nhds (1 : ENNReal))

theorem coColorable_iff_source {n : ℕ} (G : SimpleGraph (Fin n)) (k : ℕ) :
    CoColorable G k ↔ Erdos625.CoColorable G k := by
  classical
  constructor
  · rintro ⟨color, hHom⟩
    refine ⟨{ color := color
              kind := fun c => if G.IsClique {v : Fin n | color v = c} then
                .clique else .independent
              valid := ?_ }⟩
    intro c
    split_ifs with hc
    · exact hc
    · exact (hHom c).resolve_left hc
  · rintro ⟨C⟩
    refine ⟨C.color, ?_⟩
    intro c
    cases hkind : C.kind c with
    | independent =>
        right
        simpa [hkind] using C.valid c
    | clique =>
        left
        simpa [hkind] using C.valid c

theorem structural_gap_of_numeric {n M : ℕ} (G : SimpleGraph (Fin n))
    (h : (M : ℝ) ≤ (Erdos625.chromaticNumberNat G : ℝ) -
      (Erdos625.cochromaticNumber G : ℝ)) : G ∈ gapEvent M n := by
  refine ⟨Erdos625.cochromaticNumber G, ?_, ?_⟩
  · exact (coColorable_iff_source G _).mpr
      (Erdos625.coColorable_cochromaticNumber G)
  · change Erdos625.cochromaticNumber G + M ≤ Erdos625.chromaticNumberNat G
    have h' : (Erdos625.cochromaticNumber G : ℝ) + (M : ℝ) ≤
        (Erdos625.chromaticNumberNat G : ℝ) := by linarith
    exact_mod_cast h'

theorem of_source (hSource : Erdos625.Erdos625Statement) : statement := by
  have hScale : Tendsto Erdos625.gapScale atTop atTop := by
    have hExp : Tendsto (fun u : ℝ => Real.exp u / u ^ 3) atTop atTop :=
      Real.tendsto_exp_div_pow_atTop 3
    have hBase := hExp.comp
      (Real.tendsto_log_atTop.comp
        (tendsto_natCast_atTop_atTop :
          Tendsto (fun n : ℕ => (n : ℝ)) atTop atTop))
    have hBase' : Tendsto (fun n : ℕ => (n : ℝ) / (Real.log (n : ℝ)) ^ 3)
        atTop atTop := by
      apply hBase.congr'
      filter_upwards [eventually_gt_atTop (0 : ℕ)] with n hn
      simp only [Function.comp_apply]
      rw [Real.exp_log (Nat.cast_pos.mpr hn)]
    exact (hBase'.const_mul_atTop Erdos625.gapConstant_pos).congr
      (fun n => by simp only [Erdos625.gapScale, mul_div_assoc])
  intro M
  change Tendsto (fun n : ℕ => Erdos625.randomGraphMeasure n
    (gapEvent M n)) atTop (nhds 1)
  change Tendsto (fun n : ℕ => Erdos625.randomGraphMeasure n
    (Erdos625.gapEvent n)) atTop (nhds 1) at hSource
  refine tendsto_of_tendsto_of_tendsto_of_le_of_le'
    hSource tendsto_const_nhds ?_ ?_
  · filter_upwards [hScale.eventually_ge_atTop (M : ℝ)] with n hScaleN
    apply measure_mono
    intro G hG
    apply structural_gap_of_numeric
    exact hScaleN.trans hG
  · exact Filter.Eventually.of_forall fun n =>
      (measure_mono (Set.subset_univ _)).trans (by simp)

