    (hm : 0 < Finset.univ.sum row) :
    (F5 row col B9).toOuterMeasure
        (O9 demand row col) ≤
      Finset.univ.prod (fun a ↦ Finset.univ.prod (fun b ↦
        Ck row col (Finset.univ.sum row) a b ^
            demand a b /
          ((demand a b).factorial : ℝ≥0∞))) := by
  by_cases WQ : E4 demand ≤ Finset.univ.sum row
  · exact Aen
      demand row col B9 hm WQ
  · have hempty : O9 demand row col = ∅ :=
      Set.eq_empty_of_forall_notMem
        (Agz demand row col
          (Nat.lt_of_not_ge WQ))
    rw [hempty, MeasureTheory.measure_empty]
    exact bot_le
