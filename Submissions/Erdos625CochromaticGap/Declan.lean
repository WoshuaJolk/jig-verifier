private lemma ANr (x y : ENNReal) : 2 * (x * y) ≤ x ^ 2 + y ^ 2 := by
  rcases le_total x y with h | h
  · obtain ⟨t, rfl⟩ := le_iff_exists_add.mp h
    have hx : x ^ 2 + (x + t) ^ 2 = 2 * (x * (x + t)) + t ^ 2 := by ring
    rw [hx]
