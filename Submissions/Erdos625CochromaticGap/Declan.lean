    ∑ ell ∈ (Cw k).filter
        (fun ell => BJ u ell ≤ CY),
      D4 n u k ell ≤ Real.exp (∑ i, xi i) := by
  exact
    (Ani
      n CY u k xi hxi eO hmu).trans
      (AFj k xi hxi)
theorem Axx
    (n : Nat) (u k : I -> Nat) (xi : I -> Real)
    (Sd : ∀ ell, Da k ell ->
      D4 n u k ell ≤
        Jg xi ell) :
    ∑ ell ∈ Cw k, D4 n u k ell ≤
