  have hqL : 160 ≤ q * AH n := by
    rw [div_le_iff₀ q_pos] at A3T
    linarith
  nlinarith [sq_nonneg (AH n)]
theorem APK :
    ∀ᶠ n : ℕ in atTop,
      QJ n (Ky n : ℝ) ≤
        -(q / 16) * (AH n) ^ 3 := by
  let C : ℝ := IL + 1
  have hC : 0 ≤ C := by
    dsimp [C]
    linarith [iW]
  have Uz := Tm C hC
  have hDeriv :=
    AAM C hC
  filter_upwards
    [AAG,
      m5,
      Kq,
      Dp,
      CQ.eventually_gt_atTop 0,
      Uz, hDeriv,
      APG] with
      n hGeom hRoot ZE ME Dx nJ A3A hBox
  let r : ℝ := OL n
  let L : ℝ := AH n
  let a : ℝ := Ky n
  have jS : r ∈ Icc
      (Az n - C * AY n * Bj n)
      (Az n + C * AY n * Bj n) := by
    have z9 : 0 < AY n * Bj n :=
      hGeom.2.2.2.2
    dsimp [C, r]
    constructor
    · nlinarith [hRoot.1.1.1]
    · nlinarith [hRoot.1.1.2]
  have hAMem : a ∈ Icc
      (Az n - C * AY n * Bj n)
      (Az n + C * AY n * Bj n) := by
    simpa [a, C] using hGeom.2.2.1
  have hAR : a ≤ r := by
    have hDisp : L ≤ r - a := by
      simpa [L, r, a] using hGeom.2.2.2.1
    linarith [hDisp, Dx]
  have nW : Icc a r ⊆ Icc
      (Az n - C * AY n * Bj n)
      (Az n + C * AY n * Bj n) := by
    intro x hx
    exact ⟨hAMem.1.trans hx.1, hx.2.trans jS.2⟩
  have hb : 2 ≤ A9 n + 1 := by omega
  have hKey : ∀ x ∈ Icc a r,
      HasDerivAt (FK n)
        (Real.log (GK (A9 n + 1)
            (FI (A9 n + 1) ((n : ℝ) / x))) -
          Real.log x) x := by
    intro x hx
    obtain ⟨hxPos, Iz⟩ := nJ x (nW hx)
    rw [Bw, mem_Ioo] at Iz
    have hcast : (((A9 n + 1 : ℕ)) : ℝ) =
        (A9 n : ℝ) + 1 := by push_cast; ring
    have AX5 : (n : ℝ) / x ∈
        Ioo (1 : ℝ) (((A9 n + 1 : ℕ)) : ℝ) := by
      rw [mem_Ioo, hcast]
      have hSix : (6 : ℝ) ≤ A9 n := by exact_mod_cast ZE
      exact ⟨by linarith [Iz.2], by linarith [Iz.1]⟩
    exact zD hb hxPos AX5
  have hCont : ContinuousOn (FK n) (Icc a r) := by
    intro x hx
    exact (hKey x hx).continuousAt.continuousWithinAt
  have hDiff : DifferentiableOn ℝ (FK n) (Ioo a r) := by
    intro x hx
    exact (hKey x (Ioo_subset_Icc_self hx)).differentiableAt.differentiableWithinAt
  have JM : ∀ x ∈ Ioo a r,
      q / 8 * (A9 n : ℝ) ^ 2 ≤
        deriv (FK n) x := by
    intro x hx
    exact A3A x (nW (Ioo_subset_Icc_self hx))
  have ACc : FK n r = 0 := by
    simpa [r] using hRoot.1.2
  have nV := A9l
    hAR hCont hDiff JM
  have A4I : 0 ≤ q / 8 * (A9 n : ℝ) ^ 2 :=
    mul_nonneg (div_nonneg q_pos.le (by norm_num)) (sq_nonneg _)
  have hDisp : L ≤ r - a := by
    simpa [L, r, a] using hGeom.2.2.2.1
  have AW0 : FK n a ≤
      -(q / 8 * (A9 n : ℝ) ^ 2) * L := by
    nlinarith [mul_le_mul_of_nonneg_left hDisp A4I]
  have ACT : L ^ 2 ≤ (A9 n : ℝ) ^ 2 := by
    exact pow_le_pow_left₀ Dx.le ME.1 2
  have AW1 : FK n a ≤
      -(q / 8) * L ^ 3 := by
    have Fv : q / 8 * (L ^ 2 * L) ≤
        q / 8 * ((A9 n : ℝ) ^ 2 * L) :=
      mul_le_mul_of_nonneg_left
        (mul_le_mul_of_nonneg_right ACT Dx.le)
        (div_nonneg q_pos.le (by norm_num))
    calc
      FK n a ≤
          -(q / 8 * (A9 n : ℝ) ^ 2) * L := AW0
      _ = -(q / 8 * ((A9 n : ℝ) ^ 2 * L)) := by ring
