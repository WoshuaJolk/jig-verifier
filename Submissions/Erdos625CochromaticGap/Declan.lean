      _ = Module.finrank (ZMod 2)
            (LinearMap.range (Matrix.transpose A).mulVecLin) +
          Module.finrank (ZMod 2)
            (LinearMap.ker (Matrix.transpose A).mulVecLin) := rfl
      _ = Module.finrank (ZMod 2) (V → ZMod 2) :=
        LinearMap.finrank_range_add_finrank_ker
          (Matrix.transpose A).mulVecLin
      _ = Fintype.card V := by simp
  have hRank : A.rank ≤ Nat.card G.edgeSet := by
    simpa only [Nat.card_eq_fintype_card] using A.rank_le_card_width
  omega
theorem AGo
    {A B : Type*}
    [Fintype A] [Fintype B] [DecidableEq A] [DecidableEq B]
    (r : A → B → ℕ) :
    Nat.card (Vr r) *
        2 ^ K6 r =
      2 ^ (Fintype.card A + Fintype.card B) *
        DM r := by
  classical
  let G := F3 r
  let E := Nat.card G.edgeSet
  let C := Fintype.card G.ConnectedComponent
  let V := Fintype.card A + Fintype.card B
  let W := K6 r
  have A4F :
      Nat.card (Vr r) = 2 ^ C := by
    simpa [Vr, G, C] using
      A6m G
  have AW9 :
      (∏ a, ∏ b, C8 (r a b)) = 2 ^ (W - E) := by
    simpa [G, E, W] using Air r
  have hEW : E ≤ W := by
    change Nat.card (F3 r).edgeSet ≤
      K6 r
    rw [A7k r]
    calc
      (Finset.univ.filter fun e : A × B => 2 ≤ r e.1 e.2).card =
          ∑ e : A × B, if 2 ≤ r e.1 e.2 then 1 else 0 := by simp
      _ ≤ ∑ e : A × B, (r e.1 e.2).choose 2 :=
        Finset.sum_le_sum fun e _ => A6T (r e.1 e.2)
      _ = K6 r := by
        simpa [K6] using
          (Fintype.sum_prod_type'
            (fun a : A => fun b : B => (r a b).choose 2))
  have hVE : V ≤ E + C := by
    simpa [G, E, C, V] using A9F G
  have AT2 : IQ G = E + C - V := by
    let M := SJ G
    have z7 :
        M.rank + Fintype.card G.ConnectedComponent = Fintype.card (A ⊕ B) := by
      calc
        M.rank + Fintype.card G.ConnectedComponent =
            (Matrix.transpose M).rank + Module.finrank (ZMod 2)
              (LinearMap.ker (Matrix.transpose M).mulVecLin) := by
          rw [Matrix.rank_transpose,
            A2Z G]
        _ = Module.finrank (ZMod 2)
              (LinearMap.range (Matrix.transpose M).mulVecLin) +
            Module.finrank (ZMod 2)
              (LinearMap.ker (Matrix.transpose M).mulVecLin) := rfl
        _ = Module.finrank (ZMod 2) ((A ⊕ B) → ZMod 2) :=
          LinearMap.finrank_range_add_finrank_ker
            (Matrix.transpose M).mulVecLin
        _ = Fintype.card (A ⊕ B) := by simp
    have A3v :
        M.rank + Module.finrank (ZMod 2) (LinearMap.ker M.mulVecLin) =
          Fintype.card G.edgeSet := by
      calc
        M.rank + Module.finrank (ZMod 2) (LinearMap.ker M.mulVecLin) =
            Module.finrank (ZMod 2) (LinearMap.range M.mulVecLin) +
              Module.finrank (ZMod 2) (LinearMap.ker M.mulVecLin) := rfl
        _ = Module.finrank (ZMod 2) (G.edgeSet → ZMod 2) :=
          LinearMap.finrank_range_add_finrank_ker M.mulVecLin
        _ = Fintype.card G.edgeSet := by simp
    have A3D :
        Module.finrank (ZMod 2) (Z8 G) = E + C - V := by
      change Module.finrank (ZMod 2) (LinearMap.ker M.mulVecLin) = _
      simp only [E, C, V, G, Nat.card_eq_fintype_card,
        Fintype.card_sum] at z7 A3v ⊢
      omega
    exact (AAr G).symm.trans A3D
  have jN :
      C + W = V + ((W - E) + (E + C - V)) := by
    omega
  rw [A4F]
  unfold DM
  rw [AW9]
  change 2 ^ C * 2 ^ W = 2 ^ V * (2 ^ (W - E) * 2 ^ IQ G)
  rw [AT2]
  simp only [← pow_add]
  exact congrArg (fun x : ℕ => 2 ^ x) jN
theorem AmE
    {A B : Type*}
    [Fintype A] [Fintype B] [DecidableEq A] [DecidableEq B]
    (r : A → B → ℕ) :
    Fintype.card A + Fintype.card B ≤
      K6 r +
        Nat.card (F3 r).ConnectedComponent := by
  classical
  let G := F3 r
  let E := Nat.card G.edgeSet
  have AXX :
      Fintype.card A + Fintype.card B ≤
        E + Nat.card G.ConnectedComponent := by
    simpa only [G, E, Nat.card_eq_fintype_card, Fintype.card_sum] using
      A9F G
  have RY : E ≤ K6 r := by
    change Nat.card (F3 r).edgeSet ≤
      K6 r
    rw [A7k r]
    calc
      (Finset.univ.filter fun e : A × B => 2 ≤ r e.1 e.2).card =
          ∑ e : A × B, if 2 ≤ r e.1 e.2 then 1 else 0 := by simp
      _ ≤ ∑ e : A × B, (r e.1 e.2).choose 2 :=
        Finset.sum_le_sum fun e _ => A6T (r e.1 e.2)
      _ = K6 r := by
        simpa [K6] using
          (Fintype.sum_prod_type'
            (fun a : A => fun b : B => (r a b).choose 2))
  simpa [G] using AXX.trans
    (Nat.add_le_add_right RY
      (Nat.card G.ConnectedComponent))
theorem AxU
    {A B : Type*}
    [Fintype A] [Fintype B] [DecidableEq A] [DecidableEq B]
    (r : A → B → ℕ) :
    ((Nat.card (Vr r) : ℚ) *
          (2 : ℚ) ^ K6 r) /
        (2 : ℚ) ^ (Fintype.card A + Fintype.card B) =
      (DM r : ℚ) := by
  have e6 := AGo r
  have hcast := congrArg (fun x : ℕ => (x : ℚ)) e6
  norm_num only [Nat.cast_mul, Nat.cast_pow] at hcast
  apply (div_eq_iff (pow_ne_zero _ (by norm_num : (2 : ℚ) ≠ 0))).2
  simpa [mul_assoc, mul_comm, mul_left_comm] using hcast
theorem AxT
    {A B : Type*}
    [Fintype A] [Fintype B] [DecidableEq A] [DecidableEq B]
    (r : A → B → ℕ) :
    ((Nat.card (Vr r) : ℚ) *
          (2 : ℚ) ^ K6 r) /
        (2 : ℚ) ^ (Fintype.card A + Fintype.card B) =
      (2 : ℚ) ^
        (K6 r +
          Nat.card (F3 r).ConnectedComponent -
            (Fintype.card A + Fintype.card B)) := by
  classical
  let C := Nat.card
    (F3 r).ConnectedComponent
  let W := K6 r
  let V := Fintype.card A + Fintype.card B
  have A4F :
      Nat.card (Vr r) = 2 ^ C := by
    simpa only [Vr, C,
      ← Nat.card_eq_fintype_card] using
      A6m
        (F3 r)
  have AVL : V ≤ W + C := by
    simpa [V, W, C] using AmE r
  have oR : W + C - V + V = W + C := Nat.sub_add_cancel AVL
  rw [A4F]
  norm_num only [Nat.cast_pow, Nat.cast_ofNat]
  change ((2 : ℚ) ^ C * 2 ^ W) / 2 ^ V = 2 ^ (W + C - V)
  calc
    ((2 : ℚ) ^ C * 2 ^ W) / 2 ^ V = 2 ^ (W + C) / 2 ^ V := by
      rw [← pow_add, Nat.add_comm C W]
    _ = (2 ^ (W + C - V) * 2 ^ V) / 2 ^ V := by
      congr 1
      rw [← pow_add, oR]
    _ = 2 ^ (W + C - V) :=
      mul_div_cancel_right₀ _
        (pow_ne_zero _ (by norm_num : (2 : ℚ) ≠ 0))
end
end Erdos625
end M104

section M105
namespace Erdos625
open scoped BigOperators
noncomputable section
structure EO
    {A B : Type*} [Fintype A] [Fintype B]
    [DecidableEq A] [DecidableEq B]
    (n : ℕ) (row : Fin n → A) (BU : B → ℕ) where
  entries : A → B → Fin (n + 1)
  Zk : ∀ a, ∑ b, (entries a b).1 = EH row a
  BU : ∀ b, ∑ a, (entries a b).1 = BU b
namespace EO
def Cd
    {A B : Type*} [Fintype A] [Fintype B]
    [DecidableEq A] [DecidableEq B]
    {n : ℕ} {row : Fin n → A} {BU : B → ℕ}
    (table : EO n row BU) : A → B → ℕ :=
  fun a b => (table.entries a b).1
@[simp] theorem AoF
    {A B : Type*} [Fintype A] [Fintype B]
    [DecidableEq A] [DecidableEq B]
    {n : ℕ} {row : Fin n → A} {BU : B → ℕ}
    (table : EO n row BU) (a : A) (b : B) :
    table.Cd a b = (table.entries a b).1 :=
  rfl
@[ext] theorem ext
    {A B : Type*} [Fintype A] [Fintype B]
    [DecidableEq A] [DecidableEq B]
    {n : ℕ} {row : Fin n → A} {BU : B → ℕ}
    {table table' : EO n row BU}
    (h : table.entries = table'.entries) :
    table = table' := by
  cases table
  cases table'
  cases h
  rfl
end EO
noncomputable instance Aum
    {A B : Type*} [Fintype A] [Fintype B]
    [DecidableEq A] [DecidableEq B]
    (n : ℕ) (row : Fin n → A) (BU : B → ℕ) :
    Fintype (EO n row BU) :=
  Fintype.ofInjective
    (fun table : EO n row BU => table.entries)
    (by
      intro table table' h
      exact EO.ext h)
theorem AhB
    {A B : Type*} [Fintype A] [Fintype B]
    [DecidableEq A] [DecidableEq B]
    {n : ℕ} (row : Fin n → A) (column : Fin n → B) (a : A) (b : B) :
    J5 row column a b ≤ n := by
  unfold J5
  calc
    (Finset.univ.filter fun v : Fin n => row v = a ∧ column v = b).card ≤
        Finset.univ.card :=
      Finset.card_filter_le _ _
    _ = n := by simp
def W3
    {A B : Type*} [Fintype A] [Fintype B]
    [DecidableEq A] [DecidableEq B]
    {n : ℕ} (row : Fin n → A) (BU : B → ℕ)
    (column : FL (V := Fin n) BU) :
    EO n row BU where
  entries := fun a b =>
    ⟨J5 row column.1 a b,
      Nat.lt_succ_iff.mpr (AhB row column.1 a b)⟩
  Zk := by
    intro a
    simpa only using AHV row column.1 a
  BU := by
    intro b
    calc
      ∑ a, J5 row column.1 a b =
          EH column.1 b :=
        AHU row column.1 b
      _ = BU b := column.2 b
abbrev EO.event
    {A B : Type*} [Fintype A] [Fintype B]
    [DecidableEq A] [DecidableEq B]
    {n : ℕ} (row : Fin n → A) (BU : B → ℕ)
    (table : EO n row BU) :=
  Yf row table.Cd BU
def AQn
    {A B : Type*} [Fintype A] [Fintype B]
    [DecidableEq A] [DecidableEq B]
    {n : ℕ} (row : Fin n → A) (BU : B → ℕ)
    (table : EO n row BU) :
    {column : FL (V := Fin n) BU //
      W3 row BU column = table} ≃
      table.event row BU where
  toFun column :=
    ⟨column.1, fun a b => by
      have hentry := congrArg
        (fun t : EO n row BU => t.Cd a b)
        column.2
      simpa [W3,
        EO.Cd] using hentry⟩
  invFun event :=
    ⟨event.1, by
      apply EO.ext
      funext a b
      apply Fin.ext
      exact event.2 a b⟩
  left_inv := by
    intro column
    apply Subtype.ext
    rfl
  right_inv := by
    intro event
    apply Subtype.ext
    rfl
def AAs
    {A B : Type*} [Fintype A] [Fintype B]
    [DecidableEq A] [DecidableEq B]
    {n : ℕ} (row : Fin n → A) (BU : B → ℕ) :
    FL (V := Fin n) BU ≃
      Σ table : EO n row BU,
        table.event row BU :=
  (Equiv.sigmaFiberEquiv
    (W3 row BU)).symm.trans
    (Equiv.sigmaCongrRight
      (fun table => AQn row BU table))
theorem As4
    {A B : Type*} [Fintype A] [Fintype B]
    [DecidableEq A] [DecidableEq B]
    {n : ℕ} (row : Fin n → A) (BU : B → ℕ)
    (column : FL (V := Fin n) BU) :
    ∃! table : EO n row BU,
      ∀ a b,
        J5 row column.1 a b = table.Cd a b := by
  refine ⟨W3 row BU column, ?_, ?_⟩
  · intro a b
    rfl
  · intro table htable
    apply EO.ext
    funext a b
    apply Fin.ext
    have h :
        ((W3 row BU column).entries a b).1 =
          (table.entries a b).1 := by
      calc
        ((W3 row BU column).entries a b).1 =
            J5 row column.1 a b := rfl
        _ = table.Cd a b := htable a b
        _ = (table.entries a b).1 := rfl
    exact h.symm
theorem As3
    {A B : Type*} [Fintype A] [Fintype B]
    [DecidableEq A] [DecidableEq B]
    {n : ℕ} (row : Fin n → A) (BU : B → ℕ)
    {table table' : EO n row BU}
    (hne : table ≠ table') :
    ¬ ∃ column : FL (V := Fin n) BU,
      (∀ a b, J5 row column.1 a b = table.Cd a b) ∧
      (∀ a b, J5 row column.1 a b = table'.Cd a b) := by
  rintro ⟨column, htable, htable'⟩
  apply hne
  apply EO.ext
  funext a b
  apply Fin.ext
  calc
    (table.entries a b).1 = table.Cd a b := rfl
    _ = J5 row column.1 a b := (htable a b).symm
    _ = table'.Cd a b := htable' a b
    _ = (table'.entries a b).1 := rfl
theorem AKP
    {A B : Type*} [Fintype A] [Fintype B]
    [DecidableEq A] [DecidableEq B]
    {n : ℕ} (row : Fin n → A) (BU : B → ℕ) :
    Fintype.card (FL (V := Fin n) BU) =
      ∑ table : EO n row BU,
        Fintype.card (table.event row BU) := by
  calc
    Fintype.card (FL (V := Fin n) BU) =
        Fintype.card
          (Σ table : EO n row BU,
            table.event row BU) :=
      Fintype.card_congr (AAs row BU)
    _ = ∑ table : EO n row BU,
        Fintype.card (table.event row BU) :=
      Fintype.card_sigma
theorem AJh
    {A B : Type*} [Fintype A] [Fintype B]
    [DecidableEq A] [DecidableEq B]
    {n : ℕ} (row : Fin n → A) (BU : B → ℕ)
    (table : EO n row BU) :
    (Fintype.card (table.event row BU) : ℚ) /
          Fintype.card (FL (V := Fin n) BU) =
      ((∏ a, (EH row a).factorial) *
          ∏ b, (BU b).factorial : ℕ) /
        (((n.factorial *
          ∏ a, ∏ b, (table.Cd a b).factorial : ℕ) : ℚ)) := by
  simpa using
    (AQo row table.Cd BU
      table.Zk table.BU)
end
end Erdos625
end M105

section M106
namespace Erdos625
open scoped BigOperators
noncomputable section
structure Eb {b : ℕ} (n : ℕ) (k : AG b) where
  entries : Bl k → Bl k → Fin (n + 1)
  Zk : ∀ a, ∑ b, (entries a b).1 = AO k a
  BU : ∀ b, ∑ a, (entries a b).1 = AO k b
namespace Eb
def Cd {b n : ℕ} {k : AG b}
    (table : Eb n k) :
    Bl k → Bl k → ℕ :=
  fun a b => (table.entries a b).1
@[simp] theorem AoF {b n : ℕ} {k : AG b}
    (table : Eb n k) (a b : Bl k) :
    table.Cd a b = (table.entries a b).1 :=
  rfl
@[ext] theorem ext {b n : ℕ} {k : AG b}
    {table table' : Eb n k}
    (h : table.entries = table'.entries) : table = table' := by
  cases table
  cases table'
  cases h
  rfl
theorem AHn {b n : ℕ} {k : AG b}
    (table : Eb n k) (a : Bl k) :
    ∑ b, table.Cd a b = AO k a :=
  table.Zk a
theorem AyC {b n : ℕ} {k : AG b}
    (table : Eb n k) (b : Bl k) :
    ∑ a, table.Cd a b = AO k b :=
  table.BU b
end Eb
noncomputable instance AvD {b : ℕ}
    (n : ℕ) (k : AG b) : Fintype (Eb n k) :=
  Fintype.ofInjective
    (fun table : Eb n k => table.entries)
    (by
      intro table table' h
      exact Eb.ext h)
theorem A96 {b : ℕ} (k : AG b) :
    Fintype.card (Bl k) = AG.D8 k := by
  change Fintype.card (G9 (AG.sizes k)) =
    (AG.sizes k).card
  rw [Fintype.card_sigma]
  simp only [Fintype.card_fin]
  rw [show
      (Finset.univ : Finset (AG.sizes k).toFinset) =
        (AG.sizes k).toFinset.attach by
    ext s
    simp]
  simpa only using
    (Finset.sum_attach (AG.sizes k).toFinset
      (fun s => (AG.sizes k).count s)).trans
      (Multiset.toFinset_sum_count_eq _)
def AG5 {b n : ℕ} {k : AG b}
    (row₀ : Ac n k) :
    Eb n k → EO n row₀.1
      (AO k)
  | table =>
      { entries := table.entries
        Zk := by
          intro a
          calc
            ∑ b, (table.entries a b).1 = AO k a :=
              table.Zk a
            _ = EH row₀.1 a := (row₀.2 a).symm
        BU := table.BU }
def XI {b n : ℕ} {k : AG b}
    (row₀ : Ac n k) :
    EO n row₀.1 (AO k) →
      Eb n k
  | table =>
      { entries := table.entries
        Zk := by
          intro a
          calc
            ∑ b, (table.entries a b).1 = EH row₀.1 a :=
              table.Zk a
            _ = AO k a := row₀.2 a
        BU := table.BU }
def Vf {b n : ℕ} {k : AG b}
    (row₀ : Ac n k) :
    Eb n k ≃
      EO n row₀.1 (AO k) where
  toFun := AG5 row₀
  invFun := XI row₀
  left_inv := by
    intro table
    apply Eb.ext
    rfl
  right_inv := by
    intro table
    apply EO.ext
    rfl
@[simp] theorem Awc {b n : ℕ}
    {k : AG b} (row₀ : Ac n k)
    (table : Eb n k) (a b : Bl k) :
    (AG5 row₀ table).Cd a b =
      table.Cd a b :=
  rfl
@[simp] theorem AqZ {b n : ℕ}
    {k : AG b} (row₀ : Ac n k)
    (table : EO n row₀.1 (AO k))
    (a b : Bl k) :
    (XI row₀ table).Cd a b =
      table.Cd a b :=
  rfl
theorem Aqp {b n : ℕ}
    {k : AG b} (row₀ : Ac n k) :
    Fintype.card (Eb n k) =
      Fintype.card (EO n row₀.1 (AO k)) :=
  Fintype.card_congr (Vf row₀)
def G7 {b n : ℕ} {k : AG b}
    (row column : Ac n k) : Eb n k :=
  XI row
    (W3 row.1 (AO k) column)
@[simp] theorem Ajo {b n : ℕ}
    {k : AG b} (row column : Ac n k)
    (a b : Bl k) :
    (G7 row column).Cd a b =
      J5 row.1 column.1 a b :=
  rfl
def Ajn {b n : ℕ} {k : AG b}
    (row : Ac n k) : Eb n k :=
  G7 row row
theorem Awd
    {b n : ℕ} {k : AG b}
    (row : Ac n k) : Nonempty (Eb n k) :=
  ⟨Ajn row⟩
theorem Awe {b n : ℕ} {k : AG b}
    (row₀ : Ac n k) (table : Eb n k) :
    Nonempty
        (Yf row₀.1 table.Cd (AO k)) ↔
      Nonempty
        ((Vf row₀ table).event row₀.1
          (AO k)) := by
  constructor <;> intro h
  · rcases h with ⟨column, IT⟩
    exact ⟨column, IT⟩
  · rcases h with ⟨column, IT⟩
    exact ⟨column, IT⟩
end
