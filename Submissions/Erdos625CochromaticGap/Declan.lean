section M078
namespace Erdos625
def Bn
    {A B : Type*} [Fintype A] [Fintype B]
    [DecidableEq A] [DecidableEq B]
    (demand : A → B → ℕ) : Finset (A × B) :=
  Finset.univ.filter (fun e ↦ demand e.1 e.2 ≠ 0)
theorem A8x
    {A B : Type*}
    [Fintype A] [Fintype B] [DecidableEq A] [DecidableEq B]
    {demand : A → B → ℕ} {row : A → ℕ} {col : B → ℕ}
    (witness : BW demand row col) (U : ℕ) :
    Dw witness U =
      S5 (Bn demand) (U / 2)
        (D5 witness) (Dd witness) := by
  ext residual
  constructor
  · intro h
    refine ⟨?_, ?_⟩
    · intro a b
      exact (h a b).1
    · intro e he
      exact (h e.1 e.2).2 (by
        simpa only [Bn, Finset.mem_filter, Finset.mem_univ,
          true_and] using he)
  · rintro ⟨hcap, hreturn⟩ a b
    refine ⟨hcap a b, ?_⟩
    intro K4
    exact hreturn (a, b) (by
      simp only [Bn, Finset.mem_filter, Finset.mem_univ,
        true_and]
      exact K4)
theorem Avp
    {A B : Type*}
    [Fintype A] [Fintype B] [DecidableEq A] [DecidableEq B]
    {demand : A → B → ℕ} {row : A → ℕ} {col : B → ℕ}
    (witness : BW demand row col) (U : ℕ)
    (hhigh : ∀ a b, demand a b ≠ 0 → U / 2 < demand a b)
    (extension : Lz witness) :
    extension ∈ U3 witness U ↔
      LI witness extension ∈
        S5 (Bn demand) (U / 2)
          (D5 witness) (Dd witness) := by
  rw [A0G witness U hhigh extension,
    A8x witness U]
