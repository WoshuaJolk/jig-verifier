    calc s.factorial * (v.choose s * n ^ s) = s.factorial * v.choose s * n ^ s := by ring
      _ ≤ s.factorial * n.choose s * v ^ s := h
      _ = s.factorial * (n.choose s * v ^ s) := by ring
  exact Nat.le_of_mul_le_mul_left h' (Nat.factorial_pos s)
theorem AgN
    {n v s : Nat}
    (hn : 0 < n)
    (hsv : s ≤ v)
