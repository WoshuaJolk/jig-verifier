          ((d : ℝ) - R) * B8 a lambda d) ≤
        ∑' d : ℕ,
          ((d : ℝ) - R) * B8 a lambda d := by
    apply Ad1.sum_le_tsum
    intro d hd
    have hkd : k + 1 ≤ d := by
      simpa [Finset.mem_range, not_lt] using hd
    have hcoef : 0 ≤ (d : ℝ) - R := by
      have : R < (d : ℝ) := lt_of_lt_of_le hk (by exact_mod_cast (show k ≤ d by omega))
