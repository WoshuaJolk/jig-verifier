theorem AAH :
    ∀ᶠ n : ℕ in atTop,
      0 < Ky n ∧ Ky n ≤ n :=
  AAG.mono
    (fun _ hn ↦ ⟨hn.1, hn.2.1⟩)
private theorem APG :
    ∀ᶠ n : ℕ in atTop,
      (((A9 n + 1 : ℕ) : ℝ) * Real.log ((n : ℝ) + 1)) ≤
        q / 16 * (AH n) ^ 3 := by
  have A3c : ∀ᶠ n : ℕ in atTop, 160 / q ≤ AH n :=
    CQ.eventually_ge_atTop (160 / q)
  have AUh : ∀ᶠ n : ℕ in atTop, 1 ≤ AH n :=
    CQ.eventually_ge_atTop 1
  filter_upwards
    [Dp,
      eventually_ge_atTop (2 : ℕ), A3c, AUh] with
      n ME hn A3T hOne
  have hnPos : (0 : ℝ) < n := by positivity
  have hnNe : (n : ℝ) ≠ 0 := hnPos.ne'
  have AWu : (n : ℝ) + 1 ≤ 2 * (n : ℝ) := by
    exact_mod_cast (show n + 1 ≤ 2 * n by omega)
  have AUn : Real.log ((n : ℝ) + 1) ≤ 2 * AH n := by
    have hlog := Real.log_le_log (by positivity) AWu
    rw [Real.log_mul (by norm_num : (2 : ℝ) ≠ 0) hnNe] at hlog
    have hqLe : q ≤ AH n := by
      exact Real.log_le_log (by norm_num) (by exact_mod_cast hn)
    calc
      Real.log ((n : ℝ) + 1) ≤ Real.log 2 + Real.log (n : ℝ) := hlog
      _ ≤ 2 * AH n := by
        simpa [q, AH, two_mul] using
          add_le_add_right hqLe (AH n)
  have AVe : (((A9 n + 1 : ℕ) : ℝ)) ≤ 5 * AH n := by
    push_cast
    linarith [ME.2]
  have yF : 0 ≤ AH n := hOne.trans' (by norm_num)
  have hBox : (((A9 n + 1 : ℕ) : ℝ) *
      Real.log ((n : ℝ) + 1)) ≤ 10 * (AH n) ^ 2 := by
    calc
      (((A9 n + 1 : ℕ) : ℝ) * Real.log ((n : ℝ) + 1)) ≤
          (5 * AH n) * (2 * AH n) :=
        mul_le_mul AVe AUn
          (Real.log_nonneg (by exact_mod_cast (show 1 ≤ n + 1 by omega)))
          (mul_nonneg (by norm_num) yF)
