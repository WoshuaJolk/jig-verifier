section M128
namespace Erdos625
open MeasureTheory SimpleGraph
open scoped BigOperators ENNReal symmDiff
noncomputable section
def Nj {b n : ℕ} {k : AG b}
    (P : BT n k) (σ : P.1.parts → Bool) : LabeledGraph n :=
  P.1.parts.attach.sup fun B => if σ B then ⊥ else completeOn B.1
theorem AGr
    {b n : ℕ} {k : AG b}
    (P : BT n k) (σ : P.1.parts → Bool) :
    Disjoint (Gt P σ) (Nj P σ) := by
  classical
  unfold Gt Nj
  rw [Finset.disjoint_sup_left]
  intro A hA
  rw [Finset.disjoint_sup_right]
  intro B hB
  by_cases hAB : A = B
  · subst B
    cases hsign : σ A <;> simp
  · by_cases ABh : σ A
    · rw [if_pos ABh]
      by_cases ABl : σ B
      · simp [ABl]
      · rw [if_neg ABl]
        exact w5
          (P.1.disjoint A.2 B.2 (by simpa using hAB))
    · simp [ABh]
theorem AGs
    {b n : ℕ} {k : AG b}
    (P : BT n k) (σ : P.1.parts → Bool) :
    Gt P σ ⊔ Nj P σ =
      Gq P.1 := by
  classical
  apply le_antisymm
  · apply sup_le
    · exact AmM P σ
    · unfold Nj Gq
      rw [Finset.sup_le_iff]
      intro B hB
      cases hsign : σ B with
      | false =>
          simp only [Bool.false_eq]
          exact Finset.le_sup
            (f := fun C : Finset (Fin n) => completeOn C) B.2
      | true => simp
  · unfold Gq
    rw [Finset.sup_le_iff]
    intro B hB
    let B' : P.1.parts := ⟨B, hB⟩
    cases hsign : σ B' with
    | false =>
        apply le_sup_of_le_right
        unfold Nj
        refine Finset.le_sup_of_le (Finset.mem_attach P.1.parts B') ?_
        simp [hsign, B']
    | true =>
        apply le_sup_of_le_left
        exact lU
          P σ B' hsign
theorem A9N
    {b n : ℕ} {k : AG b}
    (P : BT n k) (σ : P.1.parts → Bool)
    (B : P.1.parts) (hB : σ B = false) :
    completeOn B.1 ≤ Nj P σ := by
  classical
  unfold Nj
  refine Finset.le_sup_of_le (Finset.mem_attach P.1.parts B) ?_
  simp [hB]
private theorem vX {V : Type*} [DecidableEq V]
    (S : Finset V) (v w : V) :
    (completeOn S).Adj v w ↔ v ≠ w ∧ v ∈ S ∧ w ∈ S := by
  rw [completeOn, SimpleGraph.map_adj]
  constructor
  · rintro ⟨v', w', hvw', rfl, rfl⟩
    exact ⟨by simpa using hvw', v'.2, w'.2⟩
  · rintro ⟨hvw, hv, hw⟩
    exact ⟨⟨v, hv⟩, ⟨w, hw⟩, by simpa using hvw, rfl, rfl⟩
private theorem AN3
    {V : Type*} [DecidableEq V] (A B : Finset V)
    (hcard : (A ∩ B).card < 2) :
    Disjoint (completeOn A) (completeOn B) := by
  rw [SimpleGraph.disjoint_left]
  intro v w hA hB
  obtain ⟨hvw, hvA, hwA⟩ := (vX A v w).mp hA
  obtain ⟨_, hvB, hwB⟩ := (vX B v w).mp hB
  have hsubset : ({v, w} : Finset V) ⊆ A ∩ B := by
    intro x hx
    rw [Finset.mem_insert, Finset.mem_singleton] at hx
    rcases hx with rfl | rfl
    · exact Finset.mem_inter.mpr ⟨hvA, hvB⟩
    · exact Finset.mem_inter.mpr ⟨hwA, hwB⟩
  have htwo : 2 ≤ (A ∩ B).card := by
    rw [← Finset.card_pair hvw]
    exact Finset.card_le_card hsubset
  omega
private theorem AF2
    {V : Type*} [DecidableEq V] (A B : Finset V)
    (hcard : 2 ≤ (A ∩ B).card) :
    ¬ Disjoint (completeOn A) (completeOn B) := by
  intro hdis
  obtain ⟨v, hv, w, hw, hvw⟩ :=
    Finset.one_lt_card.mp (by omega : 1 < (A ∩ B).card)
  have hA : (completeOn A).Adj v w :=
    (vX A v w).mpr
      ⟨hvw, (Finset.mem_inter.mp hv).1, (Finset.mem_inter.mp hw).1⟩
  have hB : (completeOn B).Adj v w :=
    (vX B v w).mpr
      ⟨hvw, (Finset.mem_inter.mp hv).2, (Finset.mem_inter.mp hw).2⟩
  exact (SimpleGraph.disjoint_left.mp hdis v w hA) hB
theorem AGv
    {b n : ℕ} {k : AG b}
    (P : BT n k) (σ : P.1.parts → Bool) :
    TP P σ =
      Mt
        (Gt P σ) (Nj P σ) := by
  ext G
  rw [TP, Set.mem_setOf_eq,
    Mt, Set.mem_setOf_eq]
  constructor
  · intro hvalid
    constructor
    · unfold Gt
      rw [Finset.sup_le_iff]
      intro B hB
      cases hsign : σ B with
      | false => simp
      | true =>
          simp only [↓reduceIte]
          exact (A6V G B.1).mp
            (by simpa [hsign] using hvalid B)
    · apply le_compl_iff_disjoint_right.mpr
      unfold Nj
      rw [Finset.disjoint_sup_right]
      intro B hB
      cases hsign : σ B with
      | false =>
          simp only [Bool.false_eq]
          exact (ZM G B.1).mp
            (by simpa [hsign] using hvalid B)
      | true => simp
  · rintro ⟨hpresent, habsent⟩ B
    cases hsign : σ B with
    | false =>
        have hdis : Disjoint G (Nj P σ) :=
          le_compl_iff_disjoint_right.mp habsent
        have hpart : Disjoint G (completeOn B.1) := by
          apply hdis.mono_right
          unfold Nj
          refine Finset.le_sup_of_le
            (Finset.mem_attach P.1.parts B) ?_
          simp [hsign]
        simpa [hsign] using
          (ZM G B.1).mpr hpart
    | true =>
        have hpart : completeOn B.1 ≤ Gt P σ :=
          lU P σ B hsign
        simpa [hsign] using
          (A6V G B.1).mpr (hpart.trans hpresent)
def iF {b n : ℕ} {k : AG b}
    (P Q : BT n k)
    (σ : P.1.parts → Bool) (τ : Q.1.parts → Bool) :
    Set (LabeledGraph n) :=
  TP P σ ∩ TP Q τ
def UZ {b n : ℕ} {k : AG b}
    (P Q : BT n k)
    (σ : P.1.parts → Bool) (τ : Q.1.parts → Bool) :
    LabeledGraph n :=
  Gt P σ ⊔ Gt Q τ
def UR {b n : ℕ} {k : AG b}
    (P Q : BT n k)
    (σ : P.1.parts → Bool) (τ : Q.1.parts → Bool) :
    LabeledGraph n :=
  Nj P σ ⊔ Nj Q τ
private theorem AGn
    {b n : ℕ} {k : AG b}
    (P Q : BT n k)
    (σ : P.1.parts → Bool) (τ : Q.1.parts → Bool)
    (OZ : ∀ A B, 2 ≤ P.overlapCellCount Q A B → σ A = τ B) :
    Disjoint (Gt P σ)
      (Nj Q τ) := by
  classical
  unfold Gt Nj
  rw [Finset.disjoint_sup_left]
  intro A hA
  rw [Finset.disjoint_sup_right]
  intro B hB
  cases hσ : σ A with
  | false => simp
  | true =>
      cases hτ : τ B with
      | true => simp
      | false =>
          change Disjoint (completeOn A.1) (completeOn B.1)
          apply AN3
          have hn : ¬ 2 ≤ P.overlapCellCount Q A B := by
            intro htwo
            have := OZ A B htwo
            simp [hσ, hτ] at this
          have hn' : ¬ 2 ≤ (A.1 ∩ B.1).card := by
            simpa [BT.overlapCellCount,
              TK] using hn
          omega
private theorem Am4
    {b n : ℕ} {k : AG b}
    (P Q : BT n k)
    (σ : P.1.parts → Bool) (τ : Q.1.parts → Bool)
    (OZ : ∀ A B, 2 ≤ P.overlapCellCount Q A B → σ A = τ B) :
    Disjoint (Nj P σ)
      (Gt Q τ) := by
  apply Disjoint.symm
  apply AGn Q P τ σ
  intro B A htwo
  have htwo' : 2 ≤ P.overlapCellCount Q A B := by
    simpa [BT.overlapCellCount, TK,
      Finset.inter_comm] using htwo
  exact (OZ A B htwo').symm
theorem A7m
    {b n : ℕ} {k : AG b}
    (P Q : BT n k)
    (σ : P.1.parts → Bool) (τ : Q.1.parts → Bool) :
    Disjoint (UZ P Q σ τ)
        (UR P Q σ τ) ↔
      ∀ A B, 2 ≤ P.overlapCellCount Q A B → σ A = τ B := by
  constructor
  · intro hdis A B htwo
    cases hσ : σ A with
    | false =>
        cases hτ : τ B with
        | false => rfl
        | true =>
            exfalso
            apply AF2 B.1 A.1
              (by simpa [BT.overlapCellCount,
                TK, Finset.inter_comm] using htwo)
            apply hdis.mono
            · apply le_sup_of_le_right
              exact lU
                Q τ B hτ
            · apply le_sup_of_le_left
              exact A9N
                P σ A hσ
    | true =>
        cases hτ : τ B with
        | true => rfl
        | false =>
            exfalso
            apply AF2 A.1 B.1
              (by simpa [BT.overlapCellCount,
                TK] using htwo)
            apply hdis.mono
            · apply le_sup_of_le_left
              exact lU
                P σ A hσ
            · apply le_sup_of_le_right
              exact A9N
                Q τ B hτ
