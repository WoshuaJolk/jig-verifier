    rcases edge with ⟨edge, hedge⟩
    induction edge using Sym2.inductionOn with
    | _ u v =>
      rcases u with (a | b) <;> rcases v with (a' | b')
      · simp [CX, SimpleGraph.fromRel_adj] at hedge
      · refine ⟨⟨(a, b'), ?_⟩, ?_⟩
        · simpa [CX, SimpleGraph.fromRel_adj] using hedge
        · rfl
      · refine ⟨⟨(a', b), ?_⟩, ?_⟩
        · simpa [CX, SimpleGraph.fromRel_adj] using hedge
        · apply Subtype.ext
          exact Sym2.eq_swap
      · simp [CX, SimpleGraph.fromRel_adj] at hedge
