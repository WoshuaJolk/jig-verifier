  obtain ⟨dart, hdart, rfl⟩ := List.mem_map.mp hedge
  rcases dart with ⟨⟨u, x⟩, hadj⟩
  rcases u with a | b <;> rcases x with a' | b' <;>
    simp [Gd, DS] at hadj ⊢
