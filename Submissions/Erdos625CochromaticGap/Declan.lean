        (∫⁻ ω, I ω ^ (2 : ℝ) ∂mu) ^ (1 / (2 : ℝ)) *
          (∫⁻ ω, Z ω ^ (2 : ℝ) ∂mu) ^ (1 / (2 : ℝ)) := by
