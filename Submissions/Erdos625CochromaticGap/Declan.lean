theorem AOU
    {m x : ℕ} (hm : 0 < m) (hx : x ≤ m) :
    ((m : ℝ≥0∞) / C6) ^ x ≤
      (m.descFactorial x : ℝ≥0∞) := by
  have h := ENNReal.ofReal_le_ofReal
    (Akm hm hx)
