theorem Arh
    {target : ℝ} (hT : target ∈ Set.Ioo (2 : ℝ) 5) :
    ∃ exceptional p,
      AIN target
        (ProfileEntropyS4.D7 Ak target)
        exceptional p := by
  let w : Fin 4 → ℝ := ProfileEntropyS4.optimizer Ak target
  let p : ℕ → ℝ := fun d ↦
    if d = 2 then w 0 else if d = 3 then w 1 else
    if d = 4 then w 2 else if d = 5 then w 3 else 0
  refine ⟨0, p, ?_⟩
  have hw0 : ∀ i, 0 ≤ w i := ProfileEntropyS4.TA _ _
  have hwsum : ∑ i : Fin 4, w i = 1 :=
    ProfileEntropyS4.RB _ _
  have Ae8 : ∑ i : Fin 4, w i * ProfileEntropyS4.support i = target :=
    ProfileEntropyS4.X0 _ hT
  have Ae9 :
      -(∑ i : Fin 4, w i * Real.log (w i)) +
          ∑ i : Fin 4, w i * Ak i =
        ProfileEntropyS4.D7 Ak target := by
    exact ProfileEntropyS4.g7
      Ak hT
