  by_cases h7 : q = 7
  · subst q
    exact P14QuquartGridUPB.canonical 7 (by decide) ho rho_bounds.1 rho_bounds.2 triple_norm_ne
  · have h9 : 9 ≤ q := by obtain ⟨k, hk⟩ := ho; omega
    exact P14QuquartGridUPB.canonical_ge_nine q h9 ho

end P14QuquartSevenUPB
