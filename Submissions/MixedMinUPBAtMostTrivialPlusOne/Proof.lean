/-! The actual general frame and the literal bipartite canonical result
at order-two resonance with odd m at least five. -/

noncomputable section
open Matrix Submodule
open scoped BigOperators
namespace P14ResonantBipartite
open Polynomial P14FourierSpectralWeights P14FourierWeightWindow
open P14GeneralPhysicalFrame P14GeneralFrameSpanning P14UnitaryDefectGram
open P14GeneralFrameCrossSupport P14ComplexLocalCover P14GeneralFrameLocalFactor

theorem data {q m : ℕ} (hm : 5 ≤ m) (hq : m+1 < q) (hodd : Odd m) (hres : q=2*(m-1)) :
    ∃ (e : ℝ) (P : ℂ[X]), 0 < e ∧ P.natDegree ≤ m-1 ∧
      (∀ k : Fin (m+1), Complex.normSq (1+(e:ℂ)*P.eval (sample q m k))=1) ∧
      (∀ k : Fin q, m < k.val → Complex.normSq (spectral q e P k) < 1) ∧
      ∀ f : Fin m → Fin q ⊕ Fin q, Function.Injective f →
        LinearIndependent ℂ (fun i => P14TwoLayerSelectionRows.model e
          (fun k : Fin (m+1) => P.eval (sample q m k)) (P14CubicGridBranch.node q) (f i)) := by
  apply P14ResonantSpectralSelections.exists_parameter hm hq hodd hres
    (P14CubicGridBranch.node q) (P14CubicGridBranch.node_injective (by omega))
  intro i
  exact pow_ne_zero _ ((fourierRoot_isPrimitiveRoot q (by omega)).ne_zero (by omega))

theorem spanning_frame {q m : ℕ} (hm : 5 ≤ m) (hq : m+1 < q) (hodd : Odd m) (hres : q=2*(m-1)) :
    ∃ (e : ℝ) (P : ℂ[X]), 0 < e ∧ P.natDegree ≤ m-1 ∧
      (∀ k : Fin (m+1), Complex.normSq (1+(e:ℂ)*P.eval (sample q m k))=1) ∧
      (∀ k : Fin q, m < k.val → Complex.normSq (spectral q e P k) < 1) ∧
      ∀ S : Finset (Fin q ⊕ Fin q), S.card=2*q-m →
        span ℂ (Set.range (fun i : S => fun k => matrix q m e P k i.val))=⊤ := by
  obtain ⟨e,P,he,hP,hr,hd,ht⟩ := data hm hq hodd hres
  exact ⟨e,P,he,hP,hr,hd,every_plus_one (by omega) e P hd ht⟩

theorem factor {q m : ℕ} (hm : 5 ≤ m) (hq : m+1 < q) (hodd : Odd m) (hres : q=2*(m-1)) :
    HasLocalFactor (Fin q ⊕ Fin q) (2*q-m-1) (2*q-m-1) (Prescribed m) := by
  obtain ⟨e,P,_,hP,hr,hd,hs⟩ := spanning_frame hm hq hodd hres
  let E := coordinateEquiv (show m+1 ≤ q by omega)
  let C : ((Fin q ⊕ tail q m) → ℂ) ≃ₗ[ℂ] (Fin (2*q-m-1) → ℂ) :=
    LinearEquiv.piCongrLeft' ℂ (fun _ : Fin q ⊕ tail q m => ℂ) E
  let A := matrix q m e P
  refine ⟨fun i => C (fun k => A k i),?_,?_,?_⟩
  · intro i hi
    exact columns_nonzero (by omega) hr hd i (C.map_eq_zero_iff.mp hi)
  · intro S hS
    have hc : S.card=2*q-m := by omega
    have hh := congrArg (Submodule.map C.toLinearMap) (hs S hc)
    simpa [Submodule.map_span,←Set.range_comp,Function.comp_def,
      Submodule.map_top,LinearMap.range_eq_top.mpr C.surjective,A] using hh
  · intro i j hij
    have hp : pair A i j=0 := by
      cases i with
      | inl i =>
        cases j with
        | inl j => exact (base_orthonormal (by omega) e P i j).trans (if_neg hij)
        | inr j => exact cross_zero (by omega) (by omega) e P hP i j hij
      | inr i =>
        cases j with
        | inl j =>
          rw [pair_reverse]
          change star (pair (matrix q m e P) (Sum.inl j) (Sum.inr i))=0
          rw [cross_zero (by omega) (by omega) e P hP j i hij,star_zero]
        | inr j => exact (spectral_orthonormal (by omega) hr hd i j).trans (if_neg hij)
    change (∑ k,star (A (E.symm k) i)*A (E.symm k) j)=0
    exact (E.symm.sum_comp (fun k => star (A k i)*A k j)).trans hp

theorem canonical {q m : ℕ} (hm : 5 ≤ m) (hq : m+1 < q)
    (hodd : Odd m) (hres : q=2*(m-1)) :
    P14CanonicalUPBTransport.Conclusion 2 (P14BipartiteFrameCover.dimensions q m) :=
  P14BipartiteFrameCover.canonical_of_factor hq (factor hm hq hodd hres)

end P14ResonantBipartite

end
