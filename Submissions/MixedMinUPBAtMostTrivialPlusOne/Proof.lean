/-! Exhaustive finite allocation of six complement matchings among any
at least two positive ordinary deficits. Each witness is a checked partition
into the already audited allowed blocks; no vector existence is assumed. -/

namespace P14TenRowQutritAllocation
open P14TenRowMatchingBlocks
open scoped BigOperators

def Allocation {n : ℕ} (R : Fin n → ℕ) : Prop :=
  ∃ S : Fin n → Finset (Fin 6), (∀ j, (S j).card = R j) ∧
    (∀ j, S j ∈ allowed) ∧ (∀ k : Fin 6, ∃ j, k ∈ S j)

set_option maxHeartbeats 1000000 in
theorem allocation {n : ℕ} (R : Fin n → ℕ) (hn : 2 ≤ n)
    (hpos : ∀ j, 1 ≤ R j) (hsum : (∑ j, R j) = 6) : Allocation R := by
  have hn6 : n ≤ 6 := by
    calc
      n = ∑ _j : Fin n, (1 : ℕ) := by simp
      _ ≤ ∑ j, R j := Finset.sum_le_sum (fun j _ => hpos j)
      _ = 6 := hsum
  have hncase : n = 2 ∨ n = 3 ∨ n = 4 ∨ n = 5 ∨ n = 6 := by omega
  rcases hncase with rfl | rfl | rfl | rfl | rfl
  · have h0 := hpos (0 : Fin 2)
    have h1 := hpos (1 : Fin 2)
    have hs : R 0 + (R 1) = 6 := by simpa [Fin.sum_univ_succ] using hsum
    have hc : R 0 = 1 ∨ R 0 = 2 ∨ R 0 = 3 ∨ R 0 = 4 ∨ R 0 = 5 := by omega
    rcases hc with e0 | e0 | e0 | e0 | e0
    · have e1 : R 1 = 5 := by omega
      have hR : R = ![1, 5] := by
        funext j
        fin_cases j <;> assumption
      rw [hR]
      exact ⟨![{4}, {0, 1, 2, 3, 5}], by decide, by decide, by decide⟩
    · have e1 : R 1 = 4 := by omega
      have hR : R = ![2, 4] := by
        funext j
        fin_cases j <;> assumption
      rw [hR]
      exact ⟨![{2, 4}, {0, 1, 3, 5}], by decide, by decide, by decide⟩
    · have e1 : R 1 = 3 := by omega
      have hR : R = ![3, 3] := by
        funext j
        fin_cases j <;> assumption
      rw [hR]
      exact ⟨![{0, 1, 2}, {3, 4, 5}], by decide, by decide, by decide⟩
    · have e1 : R 1 = 2 := by omega
      have hR : R = ![4, 2] := by
        funext j
        fin_cases j <;> assumption
      rw [hR]
      exact ⟨![{0, 1, 3, 5}, {2, 4}], by decide, by decide, by decide⟩
    · have e1 : R 1 = 1 := by omega
      have hR : R = ![5, 1] := by
        funext j
        fin_cases j <;> assumption
      rw [hR]
      exact ⟨![{0, 1, 2, 3, 5}, {4}], by decide, by decide, by decide⟩
  · have h0 := hpos (0 : Fin 3)
    have h1 := hpos (1 : Fin 3)
    have h2 := hpos (2 : Fin 3)
    have hs : R 0 + (R 1 + (R 2)) = 6 := by simpa [Fin.sum_univ_succ] using hsum
    have hc : R 0 = 1 ∨ R 0 = 2 ∨ R 0 = 3 ∨ R 0 = 4 := by omega
    rcases hc with e0 | e0 | e0 | e0
    · have hc : R 1 = 1 ∨ R 1 = 2 ∨ R 1 = 3 ∨ R 1 = 4 := by omega
      rcases hc with e1 | e1 | e1 | e1
      · have e2 : R 2 = 4 := by omega
        have hR : R = ![1, 1, 4] := by
          funext j
          fin_cases j <;> assumption
        rw [hR]
        exact ⟨![{3}, {4}, {0, 1, 2, 5}], by decide, by decide, by decide⟩
      · have e2 : R 2 = 3 := by omega
        have hR : R = ![1, 2, 3] := by
          funext j
          fin_cases j <;> assumption
        rw [hR]
        exact ⟨![{4}, {3, 5}, {0, 1, 2}], by decide, by decide, by decide⟩
      · have e2 : R 2 = 2 := by omega
        have hR : R = ![1, 3, 2] := by
          funext j
          fin_cases j <;> assumption
        rw [hR]
        exact ⟨![{4}, {0, 1, 2}, {3, 5}], by decide, by decide, by decide⟩
      · have e2 : R 2 = 1 := by omega
        have hR : R = ![1, 4, 1] := by
          funext j
          fin_cases j <;> assumption
        rw [hR]
        exact ⟨![{3}, {0, 1, 2, 5}, {4}], by decide, by decide, by decide⟩
    · have hc : R 1 = 1 ∨ R 1 = 2 ∨ R 1 = 3 := by omega
      rcases hc with e1 | e1 | e1
      · have e2 : R 2 = 3 := by omega
