/-! Convert the actual Fourier frame to the literal local-factor interface
in dimension 2q-4, with its exact within-layer and cross orthogonality. -/

noncomputable section
open Submodule
open scoped BigOperators
namespace P14QuadraticFrameLocalFactor
open P14QuadraticPhysicalFrame P14QuadraticFrameSpanning P14UnitaryDefectGram
open P14QuadraticFrameCrossSupport P14ComplexLocalCover

def tailEquiv {q : ℕ} (hq : 4 ≤ q) : tail q ≃ Fin (q - 4) where
  toFun k := ⟨k.val.val - 4, by
    have hk := k.val.isLt
    have hl : 4 ≤ k.val.val := (Finset.mem_filter.mp k.property).2
    omega⟩
  invFun k := ⟨⟨k.val + 4, by have hk := k.isLt; omega⟩, by
    simp only [tail, Finset.mem_filter, Finset.mem_univ, true_and]
    omega⟩
  left_inv k := by
    apply Subtype.ext
    apply Fin.ext
    have hl : 4 ≤ k.val.val := (Finset.mem_filter.mp k.property).2
    dsimp
    omega
  right_inv k := by
    apply Fin.ext
    dsimp
    omega

def coordinateEquiv {q : ℕ} (hq : 4 ≤ q) :
    (Fin q ⊕ tail q) ≃ Fin (2 * q - 4) :=
  ((Equiv.sumCongr (Equiv.refl (Fin q)) (tailEquiv hq)).trans finSumFinEquiv).trans
    (finCongr (by omega))

def Prescribed {q : ℕ} : (Fin q ⊕ Fin q) → (Fin q ⊕ Fin q) → Prop
  | Sum.inl i, Sum.inl j => i ≠ j
  | Sum.inr i, Sum.inr j => i ≠ j
  | Sum.inl i, Sum.inr j => 3 ≤ (i - j).val
  | Sum.inr i, Sum.inl j => 3 ≤ (j - i).val

theorem pair_reverse {δ α : Type*} [Fintype δ] (A : Matrix δ α ℂ) (x y : α) :
    pair A y x = star (pair A x y) := by
  simp [pair, star_sum, star_mul, mul_comm]

theorem exists_factor {q : ℕ} (hq : 7 ≤ q) :
    HasLocalFactor (Fin q ⊕ Fin q) (2 * q - 4) (2 * q - 4) Prescribed := by
  obtain ⟨e, b, he, hn, hs⟩ := exists_spanning_frame hq
  let E := coordinateEquiv (show 4 ≤ q by omega)
  let C : ((Fin q ⊕ tail q) → ℂ) ≃ₗ[ℂ] (Fin (2 * q - 4) → ℂ) :=
    LinearEquiv.piCongrLeft' ℂ (fun _ : Fin q ⊕ tail q => ℂ) E
  let A := P14QuadraticPhysicalFrame.matrix q e b
  refine ⟨fun i => C (fun k => A k i), ?_, ?_, ?_⟩
  · intro i hi
    exact P14QuadraticPhysicalFrame.columns_nonzero (by omega) he.le hn i
      (C.map_eq_zero_iff.mp hi)
  · intro S hS
    have hc : S.card = 2 * q - 3 := by omega
    have hm := congrArg (Submodule.map C.toLinearMap) (hs S hc)
    simpa [Submodule.map_span, ← Set.range_comp, Function.comp_def,
      Submodule.map_top, LinearMap.range_eq_top.mpr C.surjective, A] using hm
  · intro i j hij
    have hp : pair A i j = 0 := by
      cases i with
      | inl i =>
        cases j with
        | inl j =>
          exact (base_orthonormal (by omega) e b i j).trans (if_neg hij)
        | inr j => exact cross_zero (by omega) e b i j hij
      | inr i =>
        cases j with
        | inl j =>
          rw [pair_reverse]
          change star (pair (P14QuadraticPhysicalFrame.matrix q e b) (Sum.inl j) (Sum.inr i)) = 0
          rw [cross_zero (by omega) e b j i hij, star_zero]
        | inr j =>
          exact (spectral_orthonormal (by omega) he.le hn i j).trans (if_neg hij)
    change (∑ k, star (A (E.symm k) i) * A (E.symm k) j) = 0
    exact (E.symm.sum_comp (fun k => star (A k i) * A k j)).trans hp

end P14QuadraticFrameLocalFactor
end
