    exact Finset.sum_congr rfl (fun i hi => (hparts i hi).1)
  have hX : X ≤ L := min_le_left _ _
  have hparity := P14OddLayerAllocation.parity_capacity S r
  have hcross : (∑ i ∈ S, t i) ≤ C := by
    by_cases hLK : L ≤ K
    · have he : X = L := min_eq_left hLK
      omega
    · have he : X = K := min_eq_right (by omega)
      dsimp only [K] at he
      omega
  have hNB : L - X ≤ C - (∑ i ∈ S, t i) := by
    by_cases hLK : L ≤ K
    · have he : X = L := min_eq_left hLK
      omega
    · have he : X = K := min_eq_right (by omega)
      dsimp only [K] at he
      omega
  refine ⟨x, t, L - X, C - (∑ i ∈ S, t i), hparts, ?_, ?_, hNB, ?_⟩ <;> omega

theorem room_bounds {ι : Type*} (S : Finset ι) (r : ι → ℕ)
    (q m k : ℕ) (hq : 7 ≤ q) (ho : Odd q)
    (hr : ∀ i ∈ S, 2 ≤ r i)
    (htotal : (∑ i ∈ S, r i) + m + k = 2 * q - 6)
    (hroom : 2 * k ≤ q + 3 ∨ ∃ i ∈ S, k + 2 ≤ r i) :
    k < q ∧ (q - 5) / 2 + (∑ i ∈ S, r i % 2) ≤
      (q - 1 - k) + (∑ i ∈ S, r i / 2) := by
  classical
  obtain ⟨a, ha⟩ := ho
  rcases hroom with hcap | ⟨i, hi, hri⟩
  · have heps : (∑ i ∈ S, r i % 2) ≤ ∑ i ∈ S, r i / 2 := by
      apply Finset.sum_le_sum
      intro i hi
      have h := hr i hi
      omega
    constructor <;> omega
  · have hsum : r i ≤ ∑ j ∈ S, r j :=
      Finset.single_le_sum (fun j _ => Nat.zero_le (r j)) hi
    have hK := Finset.sum_erase_add S (fun j => r j / 2) hi
    have hE := Finset.sum_erase_add S (fun j => r j % 2) hi
    have hrest : (∑ j ∈ S.erase i, r j % 2) ≤ ∑ j ∈ S.erase i, r j / 2 := by
      apply Finset.sum_le_sum
      intro j hj
      have h := hr j (Finset.mem_of_mem_erase hj)
      omega
    constructor <;> omega

theorem construct {ι : Type*} (S : Finset ι) (r : ι → ℕ)
    (q m k : ℕ) (hq : 7 ≤ q) (ho : Odd q) (hk : 5 ≤ k)
    (hr : ∀ i ∈ S, 2 ≤ r i)
    (htotal : (∑ i ∈ S, r i) + m + k = 2 * q - 6)
    (hroom : 2 * k ≤ q + 3 ∨ ∃ i ∈ S, k + 2 ≤ r i) :
    ∃ x t : ι → ℕ, ∃ N B : ℕ,
      (∀ i ∈ S, 2 * x i + t i = r i ∧ (2 * x i ≠ t i ∨ r i = 4)) ∧
      (∑ i ∈ S, x i) + N = (q - 5) / 2 ∧
      (∑ i ∈ S, t i) + B + k = q - 1 ∧
      N ≤ B ∧ 3 * N + (B - N) = m := by
  classical
  let L := (q - 5) / 2
  have hL : 2 * L + 5 = q := by
    obtain ⟨a, ha⟩ := ho
    dsimp only [L]
    omega
  obtain ⟨hkq, hcapacity⟩ := room_bounds S r q m k hq ho hr htotal hroom
  clear hroom
  by_cases hseed : S.Nonempty → ∃ i ∈ S, r i / 2 ≤ L + 1
  · obtain ⟨x, t, N, B, hp, hN, hB, hNB, hm⟩ :=
      allocate_with_prisms_of_seed S r L (q - 1 - k) m
        hr hseed (by omega) hcapacity
    exact ⟨x, t, N, B, hp, hN, by omega, hNB, hm⟩
  · have hS : S.Nonempty := by
      by_contra hn
      exact hseed (fun h => False.elim (hn h))
    obtain ⟨i, hi⟩ := hS
    have hlarge : ∀ j ∈ S, L + 1 < r j / 2 := by
      intro j hj
      by_contra hn
      exact hseed (fun _ => ⟨j, hj, by omega⟩)
    have hsum := Finset.sum_erase_add S r hi
    have hli := hlarge i hi
    have hs : S = {i} := by
      ext j
      constructor
      · intro hj
        apply Finset.mem_singleton.mpr
        by_contra hji
        have hlj := hlarge j hj
        have hj' : j ∈ S.erase i := Finset.mem_erase.mpr ⟨hji, hj⟩
        have hle : r j ≤ ∑ a ∈ S.erase i, r a :=
          Finset.single_le_sum (fun a _ => Nat.zero_le (r a)) hj'
        omega
      · intro hj
        simpa only [Finset.mem_singleton.mp hj] using hi
    have htotal' : r i + m + k = 4 * L + 4 := by
      rw [hs, Finset.sum_singleton] at htotal
      omega
    refine ⟨fun _ => L, fun _ => r i - 2 * L, 0, m, ?_, ?_, ?_, by omega, by omega⟩
    · intro j hj
      have hji : j = i := Finset.mem_singleton.mp (hs ▸ hj)
      rw [hji]
      dsimp only
      exact ⟨by omega, Or.inl (by omega)⟩
    · simp [hs, L]
    · simp only [hs, Finset.sum_singleton]
      omega

end P14PartnerCapacityAllocation

end
end

section

/-! Exact ququart partner allocation: one extra cross offset belongs to the exceptional factor.
The sole extra case is a singleton balanced initial block, retained
explicitly for the proved cyclic construction. -/

noncomputable section
namespace P14QuquartPartnerAllocation
open P14PartnerCapacityAllocation
open scoped BigOperators

theorem room_bounds {ι : Type*} (S : Finset ι) (r : ι → ℕ)
    (q m k : ℕ) (hq : 7 ≤ q) (ho : Odd q)
    (hr : ∀ i ∈ S, 2 ≤ r i)
    (htotal : (∑ i ∈ S, r i) + m + k = 2 * q - 7)
    (hroom : 2 * k ≤ q + 1 ∨ ∃ i ∈ S, k + 2 ≤ r i) :
    k + 2 ≤ q ∧ (q - 5) / 2 + (∑ i ∈ S, r i % 2) ≤
      (q - 2 - k) + (∑ i ∈ S, r i / 2) := by
  classical
  obtain ⟨a, ha⟩ := ho
  rcases hroom with hcap | ⟨i, hi, hri⟩
  · have heps : (∑ i ∈ S, r i % 2) ≤ ∑ i ∈ S, r i / 2 := by
      apply Finset.sum_le_sum
      intro i hi
      have h := hr i hi
      omega
    constructor <;> omega
  · have hsum : r i ≤ ∑ j ∈ S, r j :=
      Finset.single_le_sum (fun j _ => Nat.zero_le (r j)) hi
    have hK := Finset.sum_erase_add S (fun j => r j / 2) hi
    have hE := Finset.sum_erase_add S (fun j => r j % 2) hi
    have hrest : (∑ j ∈ S.erase i, r j % 2) ≤ ∑ j ∈ S.erase i, r j / 2 := by
      apply Finset.sum_le_sum
      intro j hj
      have h := hr j (Finset.mem_of_mem_erase hj)
      omega
    constructor <;> omega


theorem construct {ι : Type*} (S : Finset ι) (r : ι → ℕ)
    (q m k : ℕ) (hq : 7 ≤ q) (ho : Odd q)
    (hr : ∀ i ∈ S, 2 ≤ r i)
    (htotal : (∑ i ∈ S, r i) + m + k = 2 * q - 7)
    (hroom : 2 * k ≤ q + 1 ∨ ∃ i ∈ S, k + 2 ≤ r i) :
    (∃ x t : ι → ℕ, ∃ N B : ℕ,
      (∀ i ∈ S, 2 * x i + t i = r i ∧ (2 * x i ≠ t i ∨ r i = 4)) ∧
      (∑ i ∈ S, x i) + N = (q - 5) / 2 ∧
      (∑ i ∈ S, t i) + B + (k + 1) = q - 1 ∧
      N ≤ B ∧ 3 * N + (B - N) = m) ∨
      (∃ i, S = {i} ∧ r i = 4 * ((q - 5) / 2) ∧ m + k = 3) := by
  classical
  let L := (q - 5) / 2
  have hL : 2 * L + 5 = q := by
    obtain ⟨a, ha⟩ := ho
    dsimp only [L]
    omega
  obtain ⟨hkq, hcapacity⟩ := room_bounds S r q m k hq ho hr htotal hroom
  clear hroom
  by_cases hseed : S.Nonempty → ∃ i ∈ S, r i / 2 ≤ L + 1
  · left
    obtain ⟨x, t, N, B, hp, hN, hB, hNB, hm⟩ :=
      allocate_with_prisms_of_seed S r L (q - 2 - k) m
        hr hseed (by omega) hcapacity
    exact ⟨x, t, N, B, hp, hN, by omega, hNB, hm⟩
  · have hS : S.Nonempty := by
      by_contra hn
      exact hseed (fun h => False.elim (hn h))
    obtain ⟨i, hi⟩ := hS
    have hlarge : ∀ j ∈ S, L + 1 < r j / 2 := by
      intro j hj
      by_contra hn
      exact hseed (fun _ => ⟨j, hj, by omega⟩)
    have hsum := Finset.sum_erase_add S r hi
    have hli := hlarge i hi
    have hs : S = {i} := by
      ext j
      constructor
      · intro hj
        apply Finset.mem_singleton.mpr
        by_contra hji
        have hlj := hlarge j hj
        have hj' : j ∈ S.erase i := Finset.mem_erase.mpr ⟨hji, hj⟩
        have hle : r j ≤ ∑ a ∈ S.erase i, r a :=
          Finset.single_le_sum (fun a _ => Nat.zero_le (r a)) hj'
        omega
      · intro hj
        simpa only [Finset.mem_singleton.mp hj] using hi
    have htotal' : r i + m + k = 4 * L + 3 := by
      rw [hs, Finset.sum_singleton] at htotal
      omega
    by_cases heq : r i = 4 * L
    · exact Or.inr ⟨i, hs, heq, by omega⟩
    left
    refine ⟨fun _ => L, fun _ => r i - 2 * L, 0, m, ?_, ?_, ?_, by omega, by omega⟩
    · intro j hj
      have hji : j = i := Finset.mem_singleton.mp (hs ▸ hj)
      rw [hji]
      dsimp only
      exact ⟨by omega, Or.inl (by omega)⟩
    · simp [hs, L]
    · simp only [hs, Finset.sum_singleton]
      omega


end P14QuquartPartnerAllocation


end
end

section

/-! A partner of dimension k+3 absorbs the mismatched endpoint cycles
and k consecutive cross matchings. Unequal within and cross degrees
give the exact biclique bound. -/

noncomputable section
namespace P14LargePartnerAbsorb
open P14OddLayerLabels P14LayerBlockBiclique P14TwoLayerBiclique
open P14BicliqueComplementConnection
variable {q : ℕ} [NeZero q]

def H (q k i j : ℕ) : Prop :=
  P14DoubleConeAbsorb.H q i j ∨ CrossEdge (Side q) (label q) 1 k i j

theorem absorb_within {i j : ℕ} (h : P14DoubleConeAbsorb.H q i j) :
    Within (Side q) i j := by
  rcases h with ⟨hi, hj, _⟩ | ⟨hi, hj, _⟩
  · exact Or.inl ⟨hi, hj⟩
  · exact Or.inr ⟨hi, hj⟩

theorem symmetric (k : ℕ) {i j : ℕ} (h : H q k i j) : H q k j i := by
  rcases h with h | h
  · exact Or.inl (P14DoubleConeAbsorb.symmetric h)
  · exact Or.inr (cross_symmetric (Side q) (label q) 1 k h)

theorem irreflexive (hq : 7 ≤ q) (ho : Odd q) (k i : ℕ) : ¬ H q k i i := by
  rintro (h | h)
  · exact P14DoubleConeAbsorb.irreflexive hq ho i h
  · rcases h with ⟨hi, hn, _⟩ | ⟨hn, hi, _⟩ <;> exact hn hi

theorem bound (hq : 7 ≤ q) (ho : Odd q) (k : ℕ) (hk : k ≠ 2) (hkq : k < q) :
    BicliqueBound (H q k) (Finset.range (2 * q)) (k + 3) := by
  have h : BicliqueBound (H q k) (Finset.range (2 * q)) (2 + k + 1) := by
    apply P14TwoLayerBiclique.combine _ (Side q) _ 2 k (by omega)
    · intro A hAS B hBS hA hB hdis hedge
      apply P14DoubleConeAbsorb.bound hq ho A hAS B hBS hA hB hdis
      intro i hi j hj
      have h := hedge i hi j hj
      rcases h.1 with ha | hc
      · exact ha
      · exact False.elim (within_not_across h.2 (cross_across hc))
    · intro A hAS B hBS hA hB hdis hedge
      apply cross_bound (Side q) (Finset.range (2 * q)) (label q)
        labels_injective 1 k hkq A hAS B hBS hA hB hdis
      intro i hi j hj
      have h := hedge i hi j hj
      rcases h.1 with ha | hc
      · exact False.elim (within_not_across (absorb_within ha) h.2)
      · exact hc
  convert h using 1 <;> omega

theorem prescribed_split (hq : 7 ≤ q) (ho : Odd q) (k : ℕ) (u v : Fin q ⊕ Fin q)
    (h : P14FivePrescribedPairings.Prescribed hq u v) :
    P14DoubleConeSplit.E hq u v ∨ H q k (encode u) (encode v) := by
  rcases P14DoubleConeSplit.prescribed_split hq ho u v h with he | ha
  · exact Or.inl he
  · exact Or.inr (Or.inl ha)

end P14LargePartnerAbsorb

end
end

section

/-! Every distinct physical row pair is covered after cutting the available
layer steps and cross offsets into an ordinary prefix and an explicit
remainder. Both layer orientations and both cross orientations are checked. -/

noncomputable section
namespace P14FiveComplementSplit
open P14OddLayerLabels P14FivePrescribedPairings P14PrismRemainderCover
open P14OddCyclicAnnulus
variable {q : ℕ} [NeZero q]

theorem step_split {X N : ℕ} (a : Fin N → Fin q)
    (ha : ∀ i, (a i).val = X + 1 + i.val) (z : Fin q)
    (hz : 1 ≤ z.val) (hzN : z.val ≤ X + N) (i j : Fin q)
    (he : j = i + z ∨ i = j + z) :
    cast j - cast i ∈ annulus 1 X ∨ ∃ k, j = i + a k ∨ i = j + a k := by
  by_cases hzX : z.val ≤ X
  · left
    apply (mem_iff 1 X _).mpr
    refine ⟨z.val, hz, by omega, ?_⟩
    rcases he with h | h
    · left
      rw [h, cast_add, add_sub_cancel_left]
      rfl
    · right
      rw [h, cast_add]
      change cast j - (cast j + (z.val : ZMod q)) = -(z.val : ZMod q)
      abel
  · let k : Fin N := ⟨z.val - X - 1, by omega⟩
    have hk : a k = z := by
      apply Fin.ext
      rw [ha]
      dsimp [k]
      omega
    exact Or.inr ⟨k, by rwa [hk]⟩

theorem cross_split {T B : ℕ} (b : Fin B → Fin q)
    (hB : T + B = q - 1) (hb : ∀ j, (b j).val = T + 1 + j.val)
    (i j : Fin q) (hne : i ≠ j) :
    cast j - cast i ∈ P14CyclicArc.arc 1 T ∨ ∃ k, j = i + b k := by
  let d := j - i
  have hd : d ≠ 0 := sub_ne_zero.mpr hne.symm
  have hdp : 0 < d.val := Nat.pos_of_ne_zero (Fin.val_ne_zero_iff.mpr hd)
  have hdq := d.isLt
  by_cases hdT : d.val ≤ T
  · left
    apply Finset.mem_image.mpr
    refine ⟨d.val - 1, Finset.mem_range.mpr (by omega), ?_⟩
    change (1 : ZMod q) + ((d.val - 1 : ℕ) : ZMod q) = cast j - cast i
    rw [← cast_sub]
    change (1 : ZMod q) + ((d.val - 1 : ℕ) : ZMod q) = (d.val : ZMod q)
    have he : 1 + (d.val - 1) = d.val := by omega
    simpa only [Nat.cast_add, Nat.cast_one] using congrArg (fun n : ℕ => (n : ZMod q)) he
  · let k : Fin B := ⟨d.val - T - 1, by omega⟩
    have hk : b k = d := by
      apply Fin.ext
      rw [hb]
      dsimp [k]
      omega
    exact Or.inr ⟨k, by rw [hk]; dsimp [d]; rw [add_sub_cancel]⟩

theorem cover {X T N B : ℕ} (hq : 7 ≤ q) (ho : Odd q)
    (a : Fin N → Fin q) (b : Fin B → Fin q)
    (hN : X + N = (q - 5) / 2) (hB : T + B = q - 1)
    (ha : ∀ i, (a i).val = X + 1 + i.val)
    (hb : ∀ j, (b j).val = T + 1 + j.val)
    (u v : Fin q ⊕ Fin q) (hne : u ≠ v) :
    Prescribed hq u v ∨
      P14OddLayerBlockBiclique.Edge (Side q) (label q) 1 X 1 T (encode u) (encode v) ∨
      (∃ i, Inside (a i) u v) ∨ (∃ j, Cross (b j) u v) := by
  have internal (i j : Fin q) (hne : i ≠ j) :
      LayerAdj hq i j ∨ cast j - cast i ∈ annulus 1 X ∨
        ∃ k, j = i + a k ∨ i = j + a k := by
    rcases P14FiveComplementCover.internal_cover hq ho i j hne with h | ⟨k, hk⟩
    · exact Or.inl h
    · right
      apply step_split a ha (P14FiveComplementCover.smallStep hq k) (by dsimp [P14FiveComplementCover.smallStep]; omega) ?_ i j hk
      have hki := k.isLt
      dsimp only [P14FiveComplementCover.smallCount] at hki
      change k.val + 1 ≤ X + N
      omega
  cases u with
  | inl i =>
    cases v with
    | inl j =>
      rcases internal i j (fun h => hne (congrArg Sum.inl h)) with h | h | ⟨k, hk⟩
      · exact Or.inl h
      · exact Or.inr (Or.inl (Or.inl ((within_inl 1 X i j).mpr h)))
      · exact Or.inr (Or.inr (Or.inl ⟨k, hk⟩))
    | inr j =>
      by_cases hij : i = j
      · exact Or.inl hij
      · rcases cross_split b hB hb i j hij with h | ⟨k, hk⟩
        · exact Or.inr (Or.inl (Or.inr ((cross_inl_inr 1 T i j).mpr h)))
        · exact Or.inr (Or.inr (Or.inr ⟨k, hk⟩))
  | inr i =>
    cases v with
    | inl j =>
      by_cases hij : i = j
      · exact Or.inl hij
      · rcases cross_split b hB hb j i (Ne.symm hij) with h | ⟨k, hk⟩
        · exact Or.inr (Or.inl (Or.inr ((cross_inr_inl 1 T i j).mpr h)))
        · exact Or.inr (Or.inr (Or.inr ⟨k, hk⟩))
    | inr j =>
      rcases internal i j (fun h => hne (congrArg Sum.inr h)) with h | h | ⟨k, hk⟩
      · exact Or.inl h
      · exact Or.inr (Or.inl (Or.inl ((within_inr 1 X i j).mpr h)))
      · exact Or.inr (Or.inr (Or.inl ⟨k, hk⟩))

end P14FiveComplementSplit

end
end

section

/-! Split the reserved k cross offsets from the ordinary blocks. All row
labels, endpoint cycles and explicit matching remainder remain unchanged. -/

noncomputable section
namespace P14LargePartnerComplementSplit
open P14OddLayerLabels P14LayerBlockBiclique P14PrismRemainderCover
variable {q : ℕ} [NeZero q]

theorem arc_split {k T : ℕ} {z : ZMod q}
    (h : z ∈ P14CyclicArc.arc 1 (k + T)) :
    z ∈ P14CyclicArc.arc 1 k ∨ z ∈ P14CyclicArc.arc ((k + 1 : ℕ) : ZMod q) T := by
  obtain ⟨t, ht, rfl⟩ := Finset.mem_image.mp h
  have ht' := Finset.mem_range.mp ht
  by_cases htk : t < k
  · exact Or.inl (Finset.mem_image.mpr ⟨t, Finset.mem_range.mpr htk, rfl⟩)
  · right
    refine Finset.mem_image.mpr ⟨t - k, Finset.mem_range.mpr (by omega), ?_⟩
    have he : t = (t - k) + k := by omega
    have hecast := congrArg (fun n : ℕ => (n : ZMod q)) he
    push_cast at hecast
    rw [Nat.cast_add, Nat.cast_one, hecast]
    ring

theorem cross_split {k T i j : ℕ} (h : CrossEdge (Side q) (label q) 1 (k + T) i j) :
    CrossEdge (Side q) (label q) 1 k i j ∨
      CrossEdge (Side q) (label q) ((k + 1 : ℕ) : ZMod q) T i j := by
  rcases h with ⟨hi, hj, hm⟩ | ⟨hi, hj, hm⟩
  · rcases arc_split hm with ha | hb
    · exact Or.inl (Or.inl ⟨hi, hj, ha⟩)
    · exact Or.inr (Or.inl ⟨hi, hj, hb⟩)
  · rcases arc_split hm with ha | hb
    · exact Or.inl (Or.inr ⟨hi, hj, ha⟩)
    · exact Or.inr (Or.inr ⟨hi, hj, hb⟩)

theorem cover {k X T N B : ℕ} (hq : 7 ≤ q) (ho : Odd q)
    (a : Fin N → Fin q) (b : Fin B → Fin q)
    (hN : X + N = (q - 5) / 2) (hB : T + B + k = q - 1)
    (ha : ∀ i, (a i).val = X + 1 + i.val)
    (hb : ∀ j, (b j).val = T + (k + 1) + j.val)
    (u v : Fin q ⊕ Fin q) (hne : u ≠ v) :
    P14DoubleConeSplit.E hq u v ∨ P14LargePartnerAbsorb.H q k (encode u) (encode v) ∨
      P14OddLayerBlockBiclique.Edge (Side q) (label q) 1 X ((k + 1 : ℕ) : ZMod q) T (encode u) (encode v) ∨
      (∃ i, Inside (a i) u v) ∨ (∃ j, Cross (b j) u v) := by
  have hb' : ∀ j, (b j).val = (k + T) + 1 + j.val := by
    intro j
    rw [hb]
    omega
  rcases P14FiveComplementSplit.cover hq ho a b hN (by omega) ha hb' u v hne with
    he | hord | hin | hcross
  · rcases P14LargePartnerAbsorb.prescribed_split hq ho k u v he with he | ha
    · exact Or.inl he
    · exact Or.inr (Or.inl ha)
  · rcases hord with hw | hc
    · exact Or.inr (Or.inr (Or.inl (Or.inl hw)))
    · rcases cross_split hc with hc | hc
      · exact Or.inr (Or.inl (Or.inr hc))
      · exact Or.inr (Or.inr (Or.inl (Or.inr hc)))
  · exact Or.inr (Or.inr (Or.inr (Or.inl hin)))
  · exact Or.inr (Or.inr (Or.inr (Or.inr hcross)))

end P14LargePartnerComplementSplit

end
end

section

/-! A partner of dimension k+3 absorbs the mismatched endpoint cycles
and k consecutive cross matchings starting at offset two. Unequal within and cross degrees
give the exact biclique bound. -/

noncomputable section
namespace P14QuquartPartnerAbsorb
open P14OddLayerLabels P14LayerBlockBiclique P14TwoLayerBiclique
open P14BicliqueComplementConnection
variable {q : ℕ} [NeZero q]

def H (q k i j : ℕ) : Prop :=
  P14DoubleConeAbsorb.H q i j ∨ CrossEdge (Side q) (label q) 2 k i j

theorem absorb_within {i j : ℕ} (h : P14DoubleConeAbsorb.H q i j) :
    Within (Side q) i j := by
  rcases h with ⟨hi, hj, _⟩ | ⟨hi, hj, _⟩
  · exact Or.inl ⟨hi, hj⟩
  · exact Or.inr ⟨hi, hj⟩

theorem symmetric (k : ℕ) {i j : ℕ} (h : H q k i j) : H q k j i := by
  rcases h with h | h
  · exact Or.inl (P14DoubleConeAbsorb.symmetric h)
  · exact Or.inr (cross_symmetric (Side q) (label q) 2 k h)

theorem irreflexive (hq : 7 ≤ q) (ho : Odd q) (k i : ℕ) : ¬ H q k i i := by
  rintro (h | h)
  · exact P14DoubleConeAbsorb.irreflexive hq ho i h
  · rcases h with ⟨hi, hn, _⟩ | ⟨hn, hi, _⟩ <;> exact hn hi

theorem bound (hq : 7 ≤ q) (ho : Odd q) (k : ℕ) (hk : k ≠ 2) (hkq : k < q) :
    BicliqueBound (H q k) (Finset.range (2 * q)) (k + 3) := by
  have h : BicliqueBound (H q k) (Finset.range (2 * q)) (2 + k + 1) := by
    apply P14TwoLayerBiclique.combine _ (Side q) _ 2 k (by omega)
    · intro A hAS B hBS hA hB hdis hedge
      apply P14DoubleConeAbsorb.bound hq ho A hAS B hBS hA hB hdis
      intro i hi j hj
      have h := hedge i hi j hj
      rcases h.1 with ha | hc
      · exact ha
      · exact False.elim (within_not_across h.2 (cross_across hc))
    · intro A hAS B hBS hA hB hdis hedge
      apply cross_bound (Side q) (Finset.range (2 * q)) (label q)
        labels_injective 2 k hkq A hAS B hBS hA hB hdis
      intro i hi j hj
      have h := hedge i hi j hj
      rcases h.1 with ha | hc
      · exact False.elim (within_not_across (absorb_within ha) h.2)
      · exact hc
  convert h using 1 <;> omega


theorem old_exceptional (hq : 7 ≤ q) (u v : Fin q ⊕ Fin q)
    (he : P14DoubleConeSplit.E hq u v) : P14QuquartGraphCover.E hq u v := by
  cases u <;> cases v
  · exact he
  · exact Or.inl he
  · exact Or.inl he
  · exact he

theorem cross_one (hq : 7 ≤ q) (u v : Fin q ⊕ Fin q)
    (he : CrossEdge (Side q) (label q) 1 1 (encode u) (encode v)) :
    P14QuquartGraphCover.E hq u v := by
  have hcast : P14OddLayerLabels.cast (1 : Fin q) = (1 : ZMod q) := by
    unfold P14OddLayerLabels.cast
    rw [Fin.val_one', Nat.mod_eq_of_lt (by omega), Nat.cast_one]
  have step (i j : Fin q) (h : P14OddLayerLabels.cast j - P14OddLayerLabels.cast i ∈ P14CyclicArc.arc 1 1) :
      j = i + 1 := by
    have hh : P14OddLayerLabels.cast j - P14OddLayerLabels.cast i = 1 := by
      simpa [P14CyclicArc.arc] using h
    apply cast_injective
    rw [cast_add, hcast]
    exact (sub_eq_iff_eq_add.mp hh).trans (add_comm _ _)
  cases u with
  | inl i =>
    cases v with
    | inl j => simp only [CrossEdge, side_inl, not_true_eq_false, false_and, and_false, or_self] at he
    | inr j =>
      exact Or.inr (step i j ((cross_inl_inr 1 1 i j).mp he))
  | inr i =>
    cases v with
    | inl j =>
      exact Or.inr (step j i ((cross_inr_inl 1 1 i j).mp he))
    | inr j => simp only [CrossEdge, side_inr, false_and, and_false, or_self] at he

theorem split (hq : 7 ≤ q) (k : ℕ) (u v : Fin q ⊕ Fin q)
    (he : P14LargePartnerAbsorb.H q (k + 1) (encode u) (encode v)) :
    P14QuquartGraphCover.E hq u v ∨ H q k (encode u) (encode v) := by
  rcases he with hw | hc
  · exact Or.inr (Or.inl hw)
  · have hc' : CrossEdge (Side q) (label q) 1 (1 + k) (encode u) (encode v) := by
      simpa only [Nat.add_comm] using hc
    rcases P14LargePartnerComplementSplit.cross_split hc' with h1 | hk
    · exact Or.inl (cross_one hq u v h1)
    · exact Or.inr (Or.inr (by simpa using hk))

end P14QuquartPartnerAbsorb

end
end

