def Adj (i j : Fin 10) : Prop :=
  (i, j) ∈ ({(0, 2), (0, 3), (0, 5), (0, 6), (1, 3), (1, 4), (1, 6), (1, 7), (2, 4), (2, 7), (2, 8), (3, 8), (3, 9), (4, 5), (4, 9), (5, 6), (5, 9), (6, 7), (7, 8), (8, 9)} : Finset (Fin 10 × Fin 10)) ∨
  (j, i) ∈ ({(0, 2), (0, 3), (0, 5), (0, 6), (1, 3), (1, 4), (1, 6), (1, 7), (2, 4), (2, 7), (2, 8), (3, 8), (3, 9), (4, 5), (4, 9), (5, 6), (5, 9), (6, 7), (7, 8), (8, 9)} : Finset (Fin 10 × Fin 10))

instance : DecidableRel Adj := by intro i j; unfold Adj; infer_instance

theorem row_ne_zero (i : Fin 10) : row i ≠ 0 := by
  have hc : mul (rowsC i 0) (nonzeroWitness i) = constant 1 := by
    fin_cases i <;> decide
  have he := congrArg eval hc
  rw [eval_mul, eval_constant] at he
  intro hz
  have hi : eval (rowsC i 0) = 0 := congrFun hz 0
  simp only [hi, zero_mul, Int.cast_one] at he
  exact zero_ne_one he

set_option maxHeartbeats 1000000 in
theorem orthogonal (i j : Fin 10) (h : Adj i j) :
    (∑ k, star (row i k) * row j k) = 0 := by
  have hc : ∀ a b : Fin 10, Adj a b →
      dot4 (fun k => conjugate (rowsC a k)) (rowsC b) = constant 0 := by
    intro a b
    fin_cases a <;> fin_cases b <;> decide
  have he := congrArg eval (hc i j h)
  simpa only [eval_dot4, eval_conjugate, eval_constant, Int.cast_zero, row] using he

set_option maxRecDepth 8192 in
set_option maxHeartbeats 2000000 in
theorem certificates_checked : ∀ i, Check rowsC (chosen i) (inverses i) (scale i) := by
  intro i
  fin_cases i <;> decide

set_option maxRecDepth 8192 in
set_option maxHeartbeats 2000000 in
theorem coverage_checked : ((List.finRange 10).sublistsLen 5).all (Covers chosen) = true := by
  decide

theorem killing_bound (a : Fin 4 → ℂ) (ha : a ≠ 0) (S : Finset (Fin 10))
    (hS : ∀ i ∈ S, (∑ j, star (row i j) * a j) = 0) : S.card ≤ 4 := by
  exact P14FifthRootFiniteCertificate.killing_bound rowsC chosen inverses scale
    certificates_checked coverage_checked a ha S hS

end P14TenRowQuquart

end

section

/-! A degree-four graph with pair common-neighbor bound three and triple
common-neighbor bound two has no biclique on more than five vertices. -/

noncomputable section
namespace P14DegreeTripleBiclique
open P14BicliqueComplementConnection

theorem bound_five (H : ℕ → ℕ → Prop) [DecidableRel H] (S : Finset ℕ)
    (hsym : ∀ {i j}, H i j → H j i)
    (hdegree : ∀ i ∈ S, (S.filter (H i)).card ≤ 4)
    (hpair : ∀ i ∈ S, ∀ j ∈ S, i ≠ j →
      (S.filter (fun k => H i k ∧ H j k)).card ≤ 3)
    (htriple : ∀ i ∈ S, ∀ j ∈ S, ∀ k ∈ S, i ≠ j → i ≠ k → j ≠ k →
      (S.filter (fun t => H i t ∧ H j t ∧ H k t)).card ≤ 2) :
    BicliqueBound H S 5 := by
  classical
  intro A hAS B hBS hA hB _ hedge
  obtain ⟨a, ha⟩ := hA
  obtain ⟨b, hb⟩ := hB
  have hAc : A.card ≤ 4 := by
    apply (Finset.card_le_card ?_).trans (hdegree b (hBS hb))
    intro i hi
    exact Finset.mem_filter.mpr ⟨hAS hi, hsym (hedge i hi b hb)⟩
  have hBc : B.card ≤ 4 := by
    apply (Finset.card_le_card ?_).trans (hdegree a (hAS ha))
    intro j hj
    exact Finset.mem_filter.mpr ⟨hBS hj, hedge a ha j hj⟩
  by_cases hA1 : A.card ≤ 1
  · omega
  by_cases hB1 : B.card ≤ 1
  · omega
  obtain ⟨i, hi, j, hj, hij⟩ := Finset.one_lt_card.mp (show 1 < A.card by omega)
  have hBc' : B.card ≤ 3 := by
    apply (Finset.card_le_card ?_).trans (hpair i (hAS hi) j (hAS hj) hij)
    intro k hk
    exact Finset.mem_filter.mpr ⟨hBS hk, hedge i hi k hk, hedge j hj k hk⟩
  obtain ⟨i, hi, j, hj, hij⟩ := Finset.one_lt_card.mp (show 1 < B.card by omega)
  have hAc' : A.card ≤ 3 := by
    apply (Finset.card_le_card ?_).trans (hpair i (hBS hi) j (hBS hj) hij)
    intro k hk
    exact Finset.mem_filter.mpr ⟨hAS hk, hsym (hedge k hk i hi), hsym (hedge k hk j hj)⟩
  by_cases hA2 : A.card ≤ 2
  · omega
  obtain ⟨i, hi, j, hj, k, hk, hij, hik, hjk⟩ :=
    Finset.two_lt_card.mp (show 2 < A.card by omega)
  have hBc'' : B.card ≤ 2 := by
    apply (Finset.card_le_card ?_).trans
      (htriple i (hAS hi) j (hAS hj) k (hAS hk) hij hik hjk)
    intro t ht
    exact Finset.mem_filter.mpr ⟨hBS ht, hedge i hi t ht, hedge j hj t ht, hedge k hk t ht⟩
  omega

end P14DegreeTripleBiclique

end
end

