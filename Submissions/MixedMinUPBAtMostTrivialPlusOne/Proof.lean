/-! Every all-but-four selection of actual cubic physical frame columns
spans. The proof cancels the four omitted coefficients with the five
explicit null columns and the proved independence of their restrictions. -/

noncomputable section
open Matrix Submodule
open scoped BigOperators
namespace P14CubicFrameSpanning
open P14CubicPhysicalFrame P14CubicGridBranch P14CubicAllFour
open P14CubicKernelRows P14CubicSpectralCorrection P14FourierSpectralWeights

def GoodFour (q : ℕ) (e : ℝ) (b : Coeff) : Prop :=
  ∀ f : Fin 4 → Fin q ⊕ Fin q, Function.Injective f →
    LinearIndependent ℂ (fun i => model e b (fourierRoot q) (node q) (f i))

theorem supported_preimage {q : ℕ} (hq : 5 ≤ q) {e : ℝ} (he : 0 < e) (b : Coeff)
    (ht : GoodFour q e b) (S : Finset (Fin q ⊕ Fin q)) (hS : S.card = 2*q-4)
    (v : Fin q ⊕ tail q → ℂ) :
    ∃ a : Fin q ⊕ Fin q → ℂ,
      P14CubicPhysicalFrame.matrix q e b *ᵥ a = v ∧ ∀ i, i ∉ S → a i=0 := by
  have hc : Sᶜ.card=4 := by
    simp only [Finset.card_compl, Fintype.card_sum, Fintype.card_fin, hS]
    omega
  let f : Fin 4 ≃ ↥(Sᶜ) := (Finset.equivFinOfCardEq hc).symm
  let r : Fin 4 → Fin q ⊕ Fin q := fun j => (f j).val
  have hr : Function.Injective r := Subtype.val_injective.comp f.injective
  apply P14RectangularKernelCorrection.supported_preimage
    (P14CubicPhysicalFrame.matrix q e b) (nullMatrix q hq e b)
    (null_columns hq e b) S r ?_ (null_independent hq e b ht r hr)
    (P14CubicPhysicalFrame.surjective (by omega) he b) v
  intro i hi
  refine ⟨f.symm ⟨i, Finset.mem_compl.mpr hi⟩,?_⟩
  exact congrArg Subtype.val (f.apply_symm_apply ⟨i, Finset.mem_compl.mpr hi⟩)

theorem every_plus_one {q : ℕ} (hq : 5 ≤ q) {e : ℝ} (he : 0 < e) (b : Coeff)
    (ht : GoodFour q e b) (S : Finset (Fin q ⊕ Fin q)) (hS : S.card=2*q-4) :
    span ℂ (Set.range (fun i : S => fun k => P14CubicPhysicalFrame.matrix q e b k i.val)) = ⊤ := by
  apply top_unique
  intro v _
  obtain ⟨a,ha,hz⟩ := supported_preimage hq he b ht S hS v
  have hv : P14CubicPhysicalFrame.matrix q e b *ᵥ a =
      ∑ i, a i • (fun k => P14CubicPhysicalFrame.matrix q e b k i) := by
    ext k
    simp [Matrix.mulVec,dotProduct,Finset.sum_apply,Pi.smul_apply,smul_eq_mul,mul_comm]
  rw [←ha,hv]
  apply Submodule.sum_mem
  intro i _
  by_cases hi : i ∈ S
  · apply Submodule.smul_mem
    exact subset_span ⟨⟨i,hi⟩,rfl⟩
  · rw [hz i hi,zero_smul]
    exact Submodule.zero_mem _

theorem exists_spanning_frame {q : ℕ} (hq : 7 ≤ q) :
    ∃ e : ℝ, ∃ b : Coeff, 0 < e ∧
      (∀ k : Fin q, Complex.normSq (spectral q e b k.val) =
        1-e*P14ConsecutiveFiveGridSigns.grid q k.val) ∧
      (∀ S : Finset (Fin q ⊕ Fin q), S.card=2*q-4 →
        span ℂ (Set.range (fun i : S => fun k => P14CubicPhysicalFrame.matrix q e b k i.val)) = ⊤) := by
  obtain ⟨e,b,he,hn,_,_,ht⟩ := exists_all_four hq
  exact ⟨e,b,he,hn,every_plus_one (by omega) he b ht⟩

end P14CubicFrameSpanning

end
end

