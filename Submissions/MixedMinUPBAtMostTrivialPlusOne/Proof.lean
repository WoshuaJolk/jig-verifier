def mate : Fin 5 → Fin 10 → Fin 10 := ![
  ![7, 2, 1, 4, 3, 8, 9, 0, 5, 6],
  ![1, 0, 5, 6, 8, 2, 3, 9, 4, 7],
  ![4, 5, 9, 7, 0, 1, 8, 3, 6, 2],
  ![8, 9, 3, 2, 6, 7, 4, 5, 0, 1],
  ![9, 8, 6, 5, 7, 3, 2, 4, 1, 0]]

theorem mate_involution : ∀ k i, mate k (mate k i) = i := by decide
theorem mate_ne : ∀ k i, mate k i ≠ i := by decide

def neighbors (S : Finset (Fin 5)) (i : ℕ) : Finset ℕ :=
  if hi : i < 10 then S.image (fun k => (mate k ⟨i, hi⟩).val) else ∅
def H (S : Finset (Fin 5)) (i j : ℕ) : Prop := j ∈ neighbors S i
instance (S : Finset (Fin 5)) : DecidableRel (H S) := by
  intro i j
  unfold H
  infer_instance

theorem neighbor_lt {S : Finset (Fin 5)} {i j : ℕ} (h : H S i j) : j < 10 := by
  unfold H neighbors at h
  split_ifs at h with hi
  · obtain ⟨k, _, hk⟩ := Finset.mem_image.mp h
    rw [← hk]
    exact (mate k ⟨i, hi⟩).isLt
  · simp at h

theorem symmetric (S : Finset (Fin 5)) {i j : ℕ} (h : H S i j) : H S j i := by
  have hj := neighbor_lt h
  by_cases hi : i < 10
  · obtain ⟨k, hk, he⟩ := Finset.mem_image.mp (show j ∈ S.image
        (fun k => (mate k ⟨i, hi⟩).val) by simpa [H, neighbors, hi] using h)
    have he' : mate k ⟨i, hi⟩ = ⟨j, hj⟩ := Fin.ext he
    have hb : mate k ⟨j, hj⟩ = ⟨i, hi⟩ := by
      rw [← he']
      exact mate_involution k ⟨i, hi⟩
    simp only [H, neighbors, dif_pos hj]
    exact Finset.mem_image.mpr ⟨k, hk, congrArg Fin.val hb⟩
  · simp [H, neighbors, hi] at h

theorem irreflexive (S : Finset (Fin 5)) (i : ℕ) : ¬ H S i i := by
  intro h
  have hi := neighbor_lt h
  obtain ⟨k, _, he⟩ := Finset.mem_image.mp (show i ∈ S.image
      (fun k => (mate k ⟨i, hi⟩).val) by simpa [H, neighbors, hi] using h)
  exact mate_ne k ⟨i, hi⟩ (Fin.ext he)

def Good (S : Finset (Fin 5)) : Prop :=
  ∀ i j : Fin 10, i ≠ j →
    (neighbors S i.val ∩ neighbors S j.val).card ≤ (S.card + 1) / 2

theorem bound (S : Finset (Fin 5)) (hgood : Good S) :
    BicliqueBound (H S) (Finset.range 10) (S.card + 1) := by
  have hf (i : ℕ) : ((Finset.range 10).filter (H S i)) = neighbors S i := by
    ext j
    simp only [Finset.mem_filter, Finset.mem_range, H]
    exact ⟨fun h => h.2, fun h => ⟨neighbor_lt h, h⟩⟩
  apply P14DegreeCodegreeBiclique.bound (H S) (Finset.range 10) S.card
    ((S.card + 1) / 2) (symmetric S)
  · intro i hi
    rw [hf, neighbors, dif_pos (Finset.mem_range.mp hi)]
    exact Finset.card_image_le
  · intro i hi j hj hij
    have he : (Finset.range 10).filter (fun k => H S i k ∧ H S j k) =
        neighbors S i ∩ neighbors S j := by
      ext k
      constructor
      · intro h
        exact Finset.mem_inter.mpr (Finset.mem_filter.mp h).2
      · intro h
        have hk := Finset.mem_inter.mp h
        exact Finset.mem_filter.mpr ⟨Finset.mem_range.mpr (neighbor_lt hk.1), hk⟩
    rw [he]
    exact hgood ⟨i, Finset.mem_range.mp hi⟩ ⟨j, Finset.mem_range.mp hj⟩
      (fun he => hij (congrArg Fin.val he))
  · omega

set_option maxHeartbeats 1000000 in
theorem large_bound : BicliqueBound (H {0, 1, 2, 3}) (Finset.range 10) 5 := by
  have hd : ∀ i : Fin 10, ((Finset.range 10).filter (H {0, 1, 2, 3} i.val)).card ≤ 4 := by decide
  have hp : ∀ i j : Fin 10, i ≠ j →
      ((Finset.range 10).filter (fun t => H {0, 1, 2, 3} i.val t ∧ H {0, 1, 2, 3} j.val t)).card ≤ 3 := by decide
  have ht : ∀ i j k : Fin 10, i ≠ j → i ≠ k → j ≠ k →
      ((Finset.range 10).filter (fun t => H {0, 1, 2, 3} i.val t ∧
        H {0, 1, 2, 3} j.val t ∧ H {0, 1, 2, 3} k.val t)).card ≤ 2 := by decide
  apply P14DegreeTripleBiclique.bound_five (H {0, 1, 2, 3}) (Finset.range 10)
    (symmetric {0, 1, 2, 3})
  · intro i hi
    exact hd ⟨i, Finset.mem_range.mp hi⟩
  · intro i hi j hj hij
    exact hp ⟨i, Finset.mem_range.mp hi⟩ ⟨j, Finset.mem_range.mp hj⟩
      (fun h => hij (congrArg Fin.val h))
  · intro i hi j hj k hk hij hik hjk
    exact ht ⟨i, Finset.mem_range.mp hi⟩ ⟨j, Finset.mem_range.mp hj⟩
      ⟨k, Finset.mem_range.mp hk⟩
      (fun h => hij (congrArg Fin.val h))
      (fun h => hik (congrArg Fin.val h))
      (fun h => hjk (congrArg Fin.val h))

def allowed : Finset (Finset (Fin 5)) :=
  {{0}, {1}, {2}, {3}, {4}, {0, 1, 2}, {0, 1, 2, 3}}

set_option maxHeartbeats 1000000 in
theorem allowed_bound (S : Finset (Fin 5)) (hS : S ∈ allowed) :
    BicliqueBound (H S) (Finset.range 10) (S.card + 1) := by
  simp only [allowed, Finset.mem_insert, Finset.mem_singleton] at hS
  rcases hS with rfl | rfl | rfl | rfl | rfl | rfl | rfl
  · apply bound; unfold Good; decide
  · apply bound; unfold Good; decide
  · apply bound; unfold Good; decide
  · apply bound; unfold Good; decide
  · apply bound; unfold Good; decide
  · apply bound; unfold Good; decide
  · convert large_bound using 1 <;> decide

theorem pair_cover : ∀ i j : Fin 10, i ≠ j →
    P14TenRowQuquart.Adj i j ∨ ∃ k : Fin 5, mate k i = j := by
  unfold P14TenRowQuquart.Adj
  decide

end P14TenRowQuquartBlocks

end
end

section

/-! Actual ten-row complex UPBs from the exact ququart factor and checked
matching blocks. The finite block cover is supplied explicitly for each
dimension pattern below; no local-vector existence is assumed. -/

noncomputable section
namespace P14TenRowQuquartUPB
open P14TenRowQuquartBlocks P14CanonicalUPBTransport
open scoped BigOperators

def dimensions {n : ℕ} (S : Fin n → Finset (Fin 5)) : Fin (n + 1) → ℕ :=
  Fin.cases 4 (fun j => (S j).card + 1)
def caps {n : ℕ} (S : Fin n → Finset (Fin 5)) : Fin (n + 1) → ℕ :=
  Fin.cases 4 (fun j => (S j).card)

theorem canonical {n : ℕ} (S : Fin n → Finset (Fin 5))
    (hallowed : ∀ j, S j ∈ allowed) (hcover : ∀ k : Fin 5, ∃ j, k ∈ S j)
    (hsum : (∑ j, (S j).card) = 5) : Conclusion (n + 1) (dimensions S) := by
  classical
  have hx : ∀ j : Fin n, ∃ x : Fin 10 → Fin ((S j).card + 1) → ℂ,
      (∀ i, x i ≠ 0) ∧
      (∀ i i' : Fin 10, H (S j) i.val i'.val → (∑ r, star (x i r) * x i' r) = 0) ∧
      (∀ A : Finset (Fin 10), A.card = (S j).card + 1 →
        Submodule.span ℂ (Set.range (fun i : A => x i)) = ⊤) := by
    intro j
    exact P14GenericExceptionalUPB.complex_rows (H (S j)) (symmetric (S j))
      (irreflexive (S j)) ((S j).card + 1) 10 (by omega)
      (allowed_bound (S j) (hallowed j))
  choose x hnz horth hspan using hx
  let v : Fin 10 → (j : Fin (n + 1)) → Fin (dimensions S j) → ℂ :=
    fun i => Fin.cases (P14TenRowQuquart.row i) (fun j => x j i)
  refine ⟨10, ?_, v, ?_, ?_, ?_⟩
  · simp [dimensions, Fin.sum_univ_succ, hsum]
  · intro i j
    refine Fin.cases ?_ (fun j => ?_) j
    · exact P14TenRowQuquart.row_ne_zero i
    · exact hnz j i
  · intro i i' hne
    rcases pair_cover i i' hne with he | ⟨k, hk⟩
    · exact ⟨0, P14TenRowQuquart.orthogonal i i' he⟩
    · obtain ⟨j, hj⟩ := hcover k
      refine ⟨j.succ, horth j i i' ?_⟩
      simp only [H, neighbors, dif_pos i.isLt]
      exact Finset.mem_image.mpr ⟨k, hj, congrArg Fin.val hk⟩
  · apply P14ComplexKillingBudget.survivor (dimensions S) (caps S) v
    · simp [caps, Fin.sum_univ_succ, hsum]
    · intro j
      refine Fin.cases ?_ (fun j => ?_) j
      · intro a ha A hA
        exact P14TenRowQuquart.killing_bound a ha A hA
      · intro a ha A hA
        exact P14ComplexKillingBudget.of_spanning (x j) (hspan j) a ha A hA

theorem five_qubits : Conclusion 6 ![4, 2, 2, 2, 2, 2] := by
  let S : Fin 5 → Finset (Fin 5) := ![{0}, {1}, {2}, {3}, {4}]
  have hc := canonical S (by intro j; fin_cases j <;> decide) (by decide) (by decide)
  have hd : dimensions S = ![4, 2, 2, 2, 2, 2] := by
    funext j
    fin_cases j <;> decide
  rwa [hd] at hc

theorem ququart_two_qubits : Conclusion 4 ![4, 4, 2, 2] := by
  let S : Fin 3 → Finset (Fin 5) := ![{0, 1, 2}, {3}, {4}]
  have hc := canonical S (by intro j; fin_cases j <;> decide) (by decide) (by decide)
  have hd : dimensions S = ![4, 4, 2, 2] := by
    funext j
    fin_cases j <;> decide
  rwa [hd] at hc

theorem five_qubit : Conclusion 3 ![4, 5, 2] := by
  let S : Fin 2 → Finset (Fin 5) := ![{0, 1, 2, 3}, {4}]
  have hc := canonical S (by intro j; fin_cases j <;> decide) (by decide) (by decide)
  have hd : dimensions S = ![4, 5, 2] := by
    funext j
    fin_cases j <;> decide
  rwa [hd] at hc

end P14TenRowQuquartUPB

end
end

section

/-! Ten actual qutrit vectors, indexed by all edges of K5. The existing
centered-simplex isometry is used once for all rows. A nonzero complex test
annihilates at most three rows. -/

noncomputable section
namespace P14TenRowQutrit
open scoped BigOperators

def left : Fin 10 → Option (Fin 4) :=
  ![none, none, none, none, some 0, some 0, some 0, some 1, some 1, some 2]
def right : Fin 10 → Option (Fin 4) :=
  ![some 0, some 1, some 2, some 3, some 1, some 2, some 3, some 2, some 3, some 3]
def row (i : Fin 10) : Fin 3 → ℂ := P14CenteredSimplexEdges.edge 3 (left i) (right i)
def DisjointEnds (i j : Fin 10) : Prop :=
  left i ≠ left j ∧ left i ≠ right j ∧ right i ≠ left j ∧ right i ≠ right j

theorem row_ne_zero (i : Fin 10) : row i ≠ 0 := by
  apply P14CenteredSimplexEdges.edge_ne_zero (by omega)
  fin_cases i <;> decide

theorem disjoint_pair (i j : Fin 10) (h : DisjointEnds i j) :
    (∑ r, star (row i r) * row j r) = 0 :=
  P14CenteredSimplexEdges.edge_pair_eq_zero _ _ _ _ h.1 h.2.1 h.2.2.1 h.2.2.2

private theorem equal_edge_bound (f : Option (Fin 4) → ℂ)
    (hroot : f none = 0) (hsum : (∑ i, f (some i)) = 0) (hf : f ≠ 0) :
    ((Finset.univ : Finset (Fin 10)).filter (fun i => f (left i) = f (right i))).card ≤ 3 := by
  classical
  have hthree (c : ℂ) : ¬ (∀ i : Fin 4, f (some i) = 0 ∨ f (some i) = c) := by
    intro hc
    have hz := P14ThetaZeroSumPotential.zero_of_two_values (fun i : Fin 4 => f (some i)) c hc hsum
    apply hf
    funext i
    cases i with
    | none => exact hroot
    | some i => exact congrFun hz i
  have h0 := hthree (f (some 0))
  have h1 := hthree (f (some 1))
  have h2 := hthree (f (some 2))
  have h3 := hthree (f (some 3))
  clear hthree hsum hf
  simp only [Fin.forall_fin_succ, Fin.forall_fin_zero, and_true] at h0 h1 h2 h3
  rw [Finset.card_eq_sum_ones, Finset.sum_filter]
  simp only [Fin.sum_univ_succ, Fin.sum_univ_zero, add_zero, left, right,
    Matrix.cons_val_zero, Matrix.cons_val_succ, hroot]
  grind (splits := 16)

theorem killing_bound (a : Fin 3 → ℂ) (ha : a ≠ 0)
    (S : Finset (Fin 10))
    (hS : ∀ i ∈ S, (∑ r, star (row i r) * a r) = 0) : S.card ≤ 3 := by
  classical
  obtain ⟨f, hroot, hsum, hnz, hpair⟩ := P14CenteredSimplexEdges.exists_potential a
  have hsub : S ⊆ (Finset.univ : Finset (Fin 10)).filter
      (fun i => f (left i) = f (right i)) := by
    intro i hi
    refine Finset.mem_filter.mpr ⟨Finset.mem_univ i, ?_⟩
    apply sub_eq_zero.mp
    rw [← hpair]
    exact hS i hi
  exact (Finset.card_le_card hsub).trans (equal_edge_bound f hroot hsum (hnz ha))

end P14TenRowQutrit

end
end

