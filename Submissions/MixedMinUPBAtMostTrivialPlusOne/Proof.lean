section

/-! Close the entire multipartite branch of the corrected canonical
question. Any remaining admissible failure is bipartite with both
dimensions at least three. No bipartite existence is assumed here. -/

noncomputable section
open scoped BigOperators
namespace P14GeneralMultipartiteCanonical
open P14CanonicalUPBTransport

theorem multipartite {p : ℕ} (d : Fin p → ℕ) (hp : 3 ≤ p)
    (hd : ∀ j, 2 ≤ d j) (hnq : ¬ (∀ j, d j=2)) : Conclusion p d := by
  classical
  by_contra hnot
  obtain ⟨hp6,a,ha,hrest,hdom,hmod,hlo⟩ :=
    P14CubicFiveCanonical.residual_six d hp hd hnq hnot
  have hsum := P14HighDimensionSingleCanonical.single_sum d a hrest
  let S := ∑ j, (d j-1)
  let q := (S+2)/2
  let m := p-1
  have hm : 3 ≤ m := by dsimp [m]; omega
  have hk : m+1=p := by dsimp [m]; omega
  have hq : m+1 < q := by dsimp [q,S,m]; omega
  have ho : Odd q := by
    refine ⟨S/4,?_⟩
    dsimp [q,S]
    omega
  have hdim0 : d a=2*q-m-1 := by dsimp [q,S,m]; omega
  letI : NeZero p := ⟨by omega⟩
  let E : Fin p ≃ Fin p := Equiv.swap 0 a
  have he0 : E 0=a := Equiv.swap_apply_left _ _
  let G : Fin (m+1) ≃ Fin p := (finCongr hk).trans E
  have hdim : ∀ j, P14GeneralManyQubitUPB.dimensions q m j=d (G j) := by
    intro j
    refine Fin.cases ?_ (fun j => ?_) j
    · have h0 : (finCongr hk) 0=(0 : Fin p) := Fin.ext rfl
      simpa only [P14GeneralManyQubitUPB.dimensions,Fin.cons_zero,G,
        Equiv.trans_apply,h0,he0] using hdim0.symm
    · have hne : G j.succ ≠ a := by
        intro he
        have hh : (finCongr hk) j.succ=(0 : Fin p) := E.injective (he.trans he0.symm)
        have hv := congrArg Fin.val hh
        change j.val+1=0 at hv
        omega
      simpa only [P14GeneralManyQubitUPB.dimensions,Fin.cons_succ,hrest _ hne]
  apply hnot
  apply P14CanonicalUPBTransport.of_dimensions (P14GeneralManyQubitUPB.dimensions q m) d G.symm
  · intro j
    simpa only [Equiv.apply_symm_apply] using (hdim (G.symm j)).symm
  · exact P14GeneralManyQubitUPB.canonical hm hq ho

theorem residual_bipartite {p : ℕ} (d : Fin p → ℕ) (hd : Admissible p d)
    (hnot : ¬ Conclusion p d) : p=2 ∧ ∀ j, 3 ≤ d j := by
  have hp : p=2 := by
    by_contra h
    exact hnot (multipartite d (by have := hd.1; omega) hd.2.1 hd.2.2.2)
  refine ⟨hp,?_⟩
  intro j
  have hlo := hd.2.1 j
  have hne : d j ≠ 2 := fun h => hd.2.2.1 ⟨hp,j,h⟩
  omega

end P14GeneralMultipartiteCanonical
end
