section

/-! One genuine spectral path simultaneously satisfies the norm and
actual row-rank conditions for any finite family of nonempty collision
patterns, with the required unweighted overlap representatives. -/

noncomputable section
open Filter
open scoped Topology
namespace P14CommonSpectralDeformation
open Polynomial P14FourierWeightWindow P14FourierSpectralWeights

theorem common {T : Type*} [Fintype T] {q m : ℕ} (hm : 3 ≤ m) (hq : m+1 < q)
    (hodd : Odd q) (a b : T → ℕ) (hb : ∀ t, 1 ≤ b t) (hcount : ∀ t, a t+b t=m)
    (X : ∀ t, Fin (a t) → ℂ) (Y : ∀ t, Fin (b t) → ℂ) (flag : ∀ t, Fin (a t) → Bool)
    (hX : ∀ t, Function.Injective (X t)) (hY : ∀ t, Function.Injective (Y t))
    (hYn : ∀ t j, Y t j ≠ 0) (hsub : ∀ t j, ∃ i, X t i=Y t j ∧ flag t i=false) :
    ∃ R : ℝ → ℂ[X], (∀ e, (R e).natDegree ≤ m-1) ∧
      (∀ z : ℂ, ContinuousAt (fun e => (R e).eval z) 0) ∧
      ∀ᶠ (e : ℝ) in 𝓝 0, 0 < e →
        (∀ k : Fin (m+1), Complex.normSq (1+(e:ℂ)*(R e).eval (sample q m k))=1) ∧
        (∀ k : Fin q, m < k.val → Complex.normSq (1+(e:ℂ)*(R e).eval (fourierRoot q^k.val)) < 1) ∧
        ∀ t, LinearIndependent ℂ (P14CollisionRowDeformation.actual e
          (fun k : Fin (m+1) => (R e).eval (sample q m k)) (X t) (Y t) (flag t)) := by
  obtain ⟨B,R,_,_,hR,hdegree,hlim,hLI,hnorm⟩ := P14CommonFourierSpectralPath.common
    hm hq hodd a b hb hcount X Y hX hY hYn (fun t j => by
      obtain ⟨i,hi,_⟩ := hsub t j
      exact ⟨i,hi⟩)
  have hrank : ∀ᶠ (e : ℝ) in 𝓝 0, ∀ t, e ≠ 0 →
      LinearIndependent ℂ (P14CollisionRowDeformation.actual e
        (fun k : Fin (m+1) => (R e).eval (sample q m k)) (X t) (Y t) (flag t)) := by
    apply Filter.eventually_all.mpr
    intro t
    exact P14CollisionRowDeformation.eventually_actual
      (fun e k => (R e).eval (sample q m k)) (fun k => B.eval (sample q m k))
      (fun k => hlim (sample q m k)) (X t) (Y t) (flag t) (hsub t) (hLI t)
  refine ⟨R,hdegree,?_,?_⟩
  · intro z
    change Tendsto (fun e => (R e).eval z) (𝓝 0) (𝓝 ((R 0).eval z))
    rw [hR]
    exact hlim z
  · filter_upwards [hnorm,hrank] with e he hr
    intro hepos
    exact ⟨(he hepos).1,(he hepos).2,fun t => hr t (ne_of_gt hepos)⟩

end P14CommonSpectralDeformation
end
