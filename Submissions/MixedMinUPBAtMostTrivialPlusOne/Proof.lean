section

/-! An explicit two-layer frame in frequency coordinates, its null vectors,
and a constructive right inverse. No kernel completeness is assumed. -/

noncomputable section
open Matrix
open scoped BigOperators
namespace P14UnitaryDefectFrame

variable {ι κ : Type*} [Fintype ι] [DecidableEq ι]

def frame (F : Matrix ι ι ℂ) (L : ι → ℂ) (s : Finset ι) (d : s → ℂ) :
    Matrix (ι ⊕ s) (ι ⊕ ι) ℂ
  | Sum.inl i, Sum.inl j => F i j
  | Sum.inl i, Sum.inr j => L i * F i j
  | Sum.inr i, Sum.inl _ => 0
  | Sum.inr i, Sum.inr j => d i * F i.val j

def kernel (F : Matrix ι ι ℂ) (L : ι → ℂ) (h : κ → ι) : Matrix (ι ⊕ ι) κ ℂ
  | Sum.inl i, k => -(Fᴴ i (h k) * L (h k))
  | Sum.inr i, k => Fᴴ i (h k)

theorem mulVec_inl (F : Matrix ι ι ℂ) (L : ι → ℂ) (s : Finset ι)
    (d : s → ℂ) (a : ι ⊕ ι → ℂ) (i : ι) :
    (frame F L s d *ᵥ a) (Sum.inl i) =
      (F *ᵥ (fun j => a (Sum.inl j))) i + L i * (F *ᵥ (fun j => a (Sum.inr j))) i := by
  simp [Matrix.mulVec, dotProduct, Fintype.sum_sum_type, frame, Finset.mul_sum, mul_assoc]

theorem mulVec_inr (F : Matrix ι ι ℂ) (L : ι → ℂ) (s : Finset ι)
    (d : s → ℂ) (a : ι ⊕ ι → ℂ) (i : s) :
    (frame F L s d *ᵥ a) (Sum.inr i) =
      d i * (F *ᵥ (fun j => a (Sum.inr j))) i.val := by
  simp [Matrix.mulVec, dotProduct, Fintype.sum_sum_type, frame, Finset.mul_sum, mul_assoc]

theorem dual_cancel (F : Matrix ι ι ℂ) (hF : F ∈ Matrix.unitaryGroup ι ℂ)
    (x : ι → ℂ) : F *ᵥ (Fᴴ *ᵥ x) = x := by
  rw [Matrix.mulVec_mulVec]
  have hf : F * Fᴴ = 1 := by
    simpa only [Matrix.star_eq_conjTranspose] using Matrix.mem_unitaryGroup_iff.mp hF
  rw [hf, Matrix.one_mulVec]

theorem kernel_null (F : Matrix ι ι ℂ) (hF : F ∈ Matrix.unitaryGroup ι ℂ)
    (L : ι → ℂ) (s : Finset ι) (d : s → ℂ) (h : κ → ι)
    (hh : ∀ k, h k ∉ s) (k : κ) :
    frame F L s d *ᵥ (fun i => kernel F L h i k) = 0 := by
  have hf : F * Fᴴ = 1 := by
    simpa only [Matrix.star_eq_conjTranspose] using Matrix.mem_unitaryGroup_iff.mp hF
  have hc (i : ι) : (∑ j, F i j * Fᴴ j (h k)) = if i = h k then 1 else 0 := by
    simpa only [Matrix.mul_apply, Matrix.one_apply] using congrArg (fun M => M i (h k)) hf
  ext i
  cases i with
  | inl i =>
    rw [mulVec_inl]
    change (∑ j, F i j * -(Fᴴ j (h k) * L (h k))) +
      L i * (∑ j, F i j * Fᴴ j (h k)) = 0
    have he : (∑ j, F i j * -(Fᴴ j (h k) * L (h k))) =
        -(∑ j, F i j * Fᴴ j (h k)) * L (h k) := by
      simp only [mul_neg, ← mul_assoc, Finset.sum_neg_distrib, Finset.sum_mul, neg_mul]
    rw [he, hc]
    split_ifs with hi <;> simp [hi]
  | inr i =>
    rw [mulVec_inr]
    change d i * (∑ j, F i.val j * Fᴴ j (h k)) = 0
    have hi : i.val ≠ h k := fun he => hh k (he ▸ i.property)
    rw [hc, if_neg hi, mul_zero]

theorem surjective (F : Matrix ι ι ℂ) (hF : F ∈ Matrix.unitaryGroup ι ℂ)
    (L : ι → ℂ) (s : Finset ι) (d : s → ℂ) (hd : ∀ i, d i ≠ 0) :
    Function.Surjective (fun a => frame F L s d *ᵥ a) := by
  intro v
  let y : ι → ℂ := fun i => if hi : i ∈ s then v (Sum.inr ⟨i, hi⟩) / d ⟨i, hi⟩ else 0
  let x : ι → ℂ := fun i => v (Sum.inl i) - L i * y i
  refine ⟨Sum.elim (Fᴴ *ᵥ x) (Fᴴ *ᵥ y), ?_⟩
  change frame F L s d *ᵥ Sum.elim (Fᴴ *ᵥ x) (Fᴴ *ᵥ y) = v
  ext i
  cases i with
  | inl i =>
    rw [mulVec_inl]
    change (F *ᵥ (Fᴴ *ᵥ x)) i + L i * (F *ᵥ (Fᴴ *ᵥ y)) i = _
    rw [dual_cancel F hF, dual_cancel F hF]
    simp [x]
  | inr i =>
    rw [mulVec_inr]
    change d i * (F *ᵥ (Fᴴ *ᵥ y)) i.val = _
    rw [dual_cancel F hF]
    simp only [y, dif_pos i.property]
    field_simp [hd i]

end P14UnitaryDefectFrame
end
end

section

/-! Exact Hermitian Gram identities for the explicit defect frame. -/

noncomputable section
open Matrix
open scoped BigOperators
namespace P14UnitaryDefectGram
open P14UnitaryDefectFrame

variable {ι : Type*} [Fintype ι] [DecidableEq ι]

def defectWeight (s : Finset ι) (d : s → ℂ) (i : ι) : ℂ :=
  if hi : i ∈ s then star (d ⟨i, hi⟩) * d ⟨i, hi⟩ else 0

def pair {δ α : Type*} [Fintype δ] (A : Matrix δ α ℂ) (i j : α) : ℂ :=
  ∑ k, star (A k i) * A k j

theorem base_gram (F : Matrix ι ι ℂ) (hF : F ∈ Matrix.unitaryGroup ι ℂ)
    (L : ι → ℂ) (s : Finset ι) (d : s → ℂ) (i j : ι) :
    pair (frame F L s d) (Sum.inl i) (Sum.inl j) = if i = j then 1 else 0 := by
  have hf := congrArg (fun M : Matrix ι ι ℂ => M i j)
    (Matrix.mem_unitaryGroup_iff'.mp hF)
  simpa [pair, Fintype.sum_sum_type, frame, Matrix.mul_apply,
    Matrix.star_eq_conjTranspose, Matrix.conjTranspose_apply, Matrix.one_apply] using hf

theorem spectral_gram (F : Matrix ι ι ℂ) (hF : F ∈ Matrix.unitaryGroup ι ℂ)
    (L : ι → ℂ) (s : Finset ι) (d : s → ℂ)
    (hw : ∀ k, star (L k) * L k + defectWeight s d k = 1) (i j : ι) :
    pair (frame F L s d) (Sum.inr i) (Sum.inr j) = if i = j then 1 else 0 := by
  have hs (f : s → ℂ) : (∑ k : s, f k) = ∑ k, if hk : k ∈ s then f ⟨k, hk⟩ else 0 := by
    rw [Finset.sum_coe_sort_eq_attach, Finset.sum_attach_eq_sum_dite]
  have hf : (∑ k, star (F k i) * F k j) = if i = j then 1 else 0 := by
    simpa only [Matrix.mul_apply, Matrix.star_eq_conjTranspose,
      Matrix.conjTranspose_apply, Matrix.one_apply] using
      congrArg (fun M : Matrix ι ι ℂ => M i j) (Matrix.mem_unitaryGroup_iff'.mp hF)
  calc
    _ = (∑ k, star (L k * F k i) * (L k * F k j)) +
        ∑ k : s, star (d k * F k.val i) * (d k * F k.val j) := by
      simp only [pair, Fintype.sum_sum_type, frame]
    _ = ∑ k, (star (L k) * L k + defectWeight s d k) *
        (star (F k i) * F k j) := by
      rw [hs, ← Finset.sum_add_distrib]
      apply Finset.sum_congr rfl
      intro k _
      by_cases hk : k ∈ s <;> simp only [defectWeight, hk, dite_true, dite_false, star_mul] <;> ring
    _ = ∑ k, star (F k i) * F k j := by simp only [hw, one_mul]
    _ = _ := hf

theorem cross_gram (F : Matrix ι ι ℂ) (L : ι → ℂ) (s : Finset ι)
    (d : s → ℂ) (i j : ι) :
    pair (frame F L s d) (Sum.inl i) (Sum.inr j) =
      ∑ k, star (F k i) * L k * F k j := by
  simp [pair, Fintype.sum_sum_type, frame, mul_assoc]

theorem columns_nonzero (F : Matrix ι ι ℂ) (hF : F ∈ Matrix.unitaryGroup ι ℂ)
    (L : ι → ℂ) (s : Finset ι) (d : s → ℂ)
    (hw : ∀ k, star (L k) * L k + defectWeight s d k = 1) (j : ι ⊕ ι) :
    (fun k => frame F L s d k j) ≠ 0 := by
  have hj : pair (frame F L s d) j j = 1 := by
    cases j with
    | inl j => simpa using base_gram F hF L s d j j
    | inr j => simpa using spectral_gram F hF L s d hw j j
  intro hz
  have he (k) := congrFun hz k
  simp only [Pi.zero_apply] at he
  simp [pair, he] at hj

end P14UnitaryDefectGram
end
end

section

/-!
A weighted block of consecutive Fourier columns factors into two diagonal
matrices and a Vandermonde matrix. Primitive-root powers separate distinct
row labels at any nonzero order. The column offset is unrestricted, and
the empty block is allowed.
-/

noncomputable section

namespace P14FourierConsecutiveBlock

open Matrix
open scoped BigOperators

variable {K : Type*} [CommRing K] {n m : ℕ}

def consecutiveBlock (ζ ρ : K) (d : ℕ) (rows : Fin m → Fin n) (w : Fin m → K) :
    Matrix (Fin m) (Fin m) K :=
  fun i j => ρ * ζ ^ ((rows i).val * (d + j.val)) * w j

theorem consecutiveBlock_factorization
    (ζ ρ : K) (d : ℕ) (rows : Fin m → Fin n) (w : Fin m → K) :
    consecutiveBlock ζ ρ d rows w =
      Matrix.diagonal (fun i => ρ * ζ ^ ((rows i).val * d)) *
        Matrix.vandermonde (fun i => ζ ^ (rows i).val) * Matrix.diagonal w := by
  ext i j
  simp only [consecutiveBlock, Matrix.mul_diagonal, Matrix.diagonal_mul,
    Matrix.vandermonde_apply, Nat.mul_add, pow_add, pow_mul, mul_assoc]

theorem consecutiveBlock_det_ne_zero [IsDomain K]
    (ζ ρ : K) (d : ℕ) (rows : Fin m → Fin n) (w : Fin m → K)
    (hn : n ≠ 0) (hζ : IsPrimitiveRoot ζ n) (hρ : ρ ≠ 0)
    (hrows : Function.Injective rows) (hw : ∀ j, w j ≠ 0) :
    (consecutiveBlock ζ ρ d rows w).det ≠ 0 := by
  have hnodes : Function.Injective (fun i : Fin m => ζ ^ (rows i).val) := by
    intro i j hij
    apply hrows
    apply Fin.val_injective
    exact hζ.pow_inj (rows i).isLt (rows j).isLt hij
  have hV : (Matrix.vandermonde (fun i : Fin m => ζ ^ (rows i).val)).det ≠ 0 :=
    Matrix.det_vandermonde_ne_zero_iff.mpr hnodes
  have hL : (∏ i : Fin m, ρ * ζ ^ ((rows i).val * d)) ≠ 0 :=
    Finset.prod_ne_zero_iff.mpr (fun i _ => mul_ne_zero hρ (pow_ne_zero _ (hζ.ne_zero hn)))
  have hR : (∏ j : Fin m, w j) ≠ 0 :=
    Finset.prod_ne_zero_iff.mpr (fun j _ => hw j)
  rw [consecutiveBlock_factorization, Matrix.det_mul, Matrix.det_mul,
    Matrix.det_diagonal, Matrix.det_diagonal]
  exact mul_ne_zero (mul_ne_zero hL hV) hR


end P14FourierConsecutiveBlock
end
end

section

/-!
Actual signed and spectral-product-weighted Fourier coefficient matrices.
Their fixed complementary blocks use consecutive frequencies. The spectral
weights and normalization are explicit; no block determinant is assumed.
-/

noncomputable section

namespace P14FourierMatchingBlocks

open Matrix P14FourierSpectralWeights P14FourierConsecutiveBlock

def retainedFrequency {r s : ℕ} (d : ℕ) : Fin r ⊕ Fin s → ℕ :=
  Sum.elim (fun a => d + a.val) (fun b => d + r + b.val)

theorem retainedFrequency_bounds {n r s d : ℕ} (hdim : d + r + s = n)
    (j : Fin r ⊕ Fin s) :
    d ≤ retainedFrequency d j ∧ retainedFrequency d j < n := by
  cases j with
  | inl a =>
      have ha := a.isLt
      change d ≤ d + a.val ∧ d + a.val < n
      omega
  | inr b =>
      have hb := b.isLt
      change d ≤ d + r + b.val ∧ d + r + b.val < n
      omega

def aCoefficients {n r s : ℕ} (ζ ρ : ℂ) (d : ℕ) (rows : Fin r → Fin n) :
    Matrix (Fin r) (Fin r ⊕ Fin s) ℂ :=
  fun i j => ρ * ζ ^ ((rows i).val * retainedFrequency d j) *
    (-1 : ℂ) ^ retainedFrequency d j

def bCoefficients {n r s : ℕ} (ζ ρ : ℂ) (d : ℕ) (rows : Fin s → Fin n) :
    Matrix (Fin s) (Fin r ⊕ Fin s) ℂ :=
  fun i j => ρ * ζ ^ ((rows i).val * retainedFrequency d j) *
    star (spectralWeight ζ d (retainedFrequency d j))

theorem aCoefficients_left {n r s : ℕ} (ζ ρ : ℂ) (d : ℕ)
    (rows : Fin r → Fin n) :
    (aCoefficients (s := s) ζ ρ d rows).submatrix id Sum.inl =
      consecutiveBlock ζ ρ d rows (fun j => (-1 : ℂ) ^ (d + j.val)) := by
  rfl

theorem bCoefficients_right {n r s : ℕ} (ζ ρ : ℂ) (d : ℕ)
    (rows : Fin s → Fin n) :
    (bCoefficients (r := r) ζ ρ d rows).submatrix id Sum.inr =
      consecutiveBlock ζ ρ (d + r) rows
        (fun j => star (spectralWeight ζ d (d + r + j.val))) := by
  rfl

theorem complementary_blocks_ne_zero {n r s d : ℕ} {ζ ρ : ℂ}
    (hn : n ≠ 0) (hζ : IsPrimitiveRoot ζ n) (hρ : ρ ≠ 0)
    (hdim : d + r + s = n)
    (I : Fin r → Fin n) (hI : Function.Injective I)
    (T : Fin s → Fin n) (hT : Function.Injective T) :
    ((aCoefficients (s := s) ζ ρ d I).submatrix id Sum.inl).det ≠ 0 ∧
      ((bCoefficients (r := r) ζ ρ d T).submatrix id Sum.inr).det ≠ 0 := by
  rw [aCoefficients_left, bCoefficients_right]
  constructor
  · apply consecutiveBlock_det_ne_zero ζ ρ d I _ hn hζ hρ hI
    intro j
    exact pow_ne_zero _ (neg_ne_zero.mpr (one_ne_zero : (1 : ℂ) ≠ 0))
  · apply consecutiveBlock_det_ne_zero ζ ρ (d + r) T _ hn hζ hρ hT
    intro j
    have hbounds := retainedFrequency_bounds hdim (Sum.inr j : Fin r ⊕ Fin s)
    exact star_spectralWeight_ne_zero hζ hbounds.1 hbounds.2

theorem fourier_complementary_blocks_ne_zero {n r s d : ℕ}
    (hn : 0 < n) (hdim : d + r + s = n)
    (I : Fin r → Fin n) (hI : Function.Injective I)
    (T : Fin s → Fin n) (hT : Function.Injective T) :
    ((aCoefficients (s := s) (fourierRoot n) (fourierNormalization n) d I).submatrix
      id Sum.inl).det ≠ 0 ∧
      ((bCoefficients (r := r) (fourierRoot n) (fourierNormalization n) d T).submatrix
        id Sum.inr).det ≠ 0 := by
  exact complementary_blocks_ne_zero (Nat.ne_of_gt hn)
    (fourierRoot_isPrimitiveRoot n hn) (fourierNormalization_ne_zero n hn) hdim I hI T hT


end P14FourierMatchingBlocks
end
end

section

/-! Reindex the actual retained frequencies so that `none` and another
coordinate have even frequency, with two distinct odd-frequency coordinates.
The offset `d` is arbitrary. These are sign-indexing statements only. -/

noncomputable section

namespace P14FourierParityCoordinates

open P14FourierMatchingBlocks

theorem neg_one_pow_ite_mod (q : ℕ) :
    (-1 : ℝ) ^ q = if q % 2 = 0 then 1 else -1 := by
  rw [neg_one_pow_eq_pow_mod_two]
  by_cases hq : q % 2 = 0
  · rw [if_pos hq, hq, pow_zero]
  · have hq1 : q % 2 = 1 := by omega
    rw [if_neg hq, hq1, pow_one]

theorem retainedFrequency_eq_add_index {r s : ℕ} (d : ℕ)
    (j : Fin r ⊕ Fin s) :
    retainedFrequency d j = d + (finSumFinEquiv j : Fin (r + s)).val := by
  cases j with
  | inl i => rfl
  | inr i =>
      change d + r + i.val = d + (r + i.val)
      exact Nat.add_assoc d r i.val

private theorem exists_parity_witnesses {r s : ℕ} (d : ℕ) (hk : 4 ≤ r + s) :
    ∃ a b u v : Fin r ⊕ Fin s, a ≠ b ∧ u ≠ v ∧
      retainedFrequency d a % 2 = 0 ∧ retainedFrequency d b % 2 = 0 ∧
      ¬ retainedFrequency d u % 2 = 0 ∧ ¬ retainedFrequency d v % 2 = 0 := by
  let E : (Fin r ⊕ Fin s) ≃ Fin (r + s) := finSumFinEquiv
  let i0 : Fin (r + s) := ⟨0, by omega⟩
  let i1 : Fin (r + s) := ⟨1, by omega⟩
  let i2 : Fin (r + s) := ⟨2, by omega⟩
  let i3 : Fin (r + s) := ⟨3, by omega⟩
  have hfreq (i : Fin (r + s)) : retainedFrequency d (E.symm i) = d + i.val := by
    rw [retainedFrequency_eq_add_index]
    change d + (E (E.symm i)).val = d + i.val
    rw [E.apply_symm_apply]
  have h02 : E.symm i0 ≠ E.symm i2 := by
    intro h
    have hv := congrArg Fin.val (E.symm.injective h)
    change (0 : ℕ) = 2 at hv
    omega
  have h13 : E.symm i1 ≠ E.symm i3 := by
    intro h
    have hv := congrArg Fin.val (E.symm.injective h)
    change (1 : ℕ) = 3 at hv
    omega
  by_cases hd : d % 2 = 0
  · refine ⟨E.symm i0, E.symm i2, E.symm i1, E.symm i3, h02, h13,
      ?_, ?_, ?_, ?_⟩
    all_goals
      rw [hfreq]
      dsimp [i0, i1, i2, i3]
      omega
  · refine ⟨E.symm i1, E.symm i3, E.symm i0, E.symm i2, h13, h02,
      ?_, ?_, ?_, ?_⟩
    all_goals
      rw [hfreq]
      dsimp [i0, i1, i2, i3]
      omega

theorem exists_parity_coordinates_of_equiv {r s : ℕ} {σ : Type*}
    (d : ℕ) (hk : 4 ≤ r + s) (e0 : (Fin r ⊕ Fin s) ≃ Option σ) :
    ∃ (e : (Fin r ⊕ Fin s) ≃ Option σ) (b : σ),
      retainedFrequency d (e.symm none) % 2 = 0 ∧
      retainedFrequency d (e.symm (some b)) % 2 = 0 ∧
      ∃ u v : {o : Option σ // ¬ retainedFrequency d (e.symm o) % 2 = 0}, u ≠ v := by
  classical
  obtain ⟨a, a', u', v', haa, huv, ha, ha', hu, hv⟩ := exists_parity_witnesses d hk
  let e : (Fin r ⊕ Fin s) ≃ Option σ := (Equiv.swap a (e0.symm none)).trans e0
  have hea : e a = none := by
    change e0 (Equiv.swap a (e0.symm none) a) = none
    rw [Equiv.swap_apply_left, e0.apply_symm_apply]
  have hea' : e a' ≠ none := by
    intro h
    exact haa (e.injective (hea.trans h.symm))
  obtain ⟨b, hb⟩ : ∃ b : σ, e a' = some b := by
    cases h : e a' with
    | none => exact (hea' (by simp only [h])).elim
    | some b => exact ⟨b, by simp only [h]⟩
  have hnone : e.symm none = a := by rw [← hea, e.symm_apply_apply]
  have hsome : e.symm (some b) = a' := by rw [← hb, e.symm_apply_apply]
  let u : {o : Option σ // ¬ retainedFrequency d (e.symm o) % 2 = 0} :=
    ⟨e u', by simpa only [Equiv.symm_apply_apply] using hu⟩
  let v : {o : Option σ // ¬ retainedFrequency d (e.symm o) % 2 = 0} :=
    ⟨e v', by simpa only [Equiv.symm_apply_apply] using hv⟩
  refine ⟨e, b, ?_, ?_, u, v, ?_⟩
  · simpa only [hnone] using ha
  · simpa only [hsome] using ha'
  · intro h
    exact huv (e.injective (congrArg Subtype.val h))

theorem exists_parity_coordinates {r s : ℕ} {σ : Type*} [Fintype σ]
    (d : ℕ) (hcard : 4 ≤ Fintype.card σ) (hdim : r + s = Fintype.card σ + 1) :
    ∃ (e : (Fin r ⊕ Fin s) ≃ Option σ) (b : σ),
      retainedFrequency d (e.symm none) % 2 = 0 ∧
      retainedFrequency d (e.symm (some b)) % 2 = 0 ∧
      ∃ u v : {o : Option σ // ¬ retainedFrequency d (e.symm o) % 2 = 0}, u ≠ v := by
  have hEq : Fintype.card (Fin r ⊕ Fin s) = Fintype.card (Option σ) := by
    simpa only [Fintype.card_sum, Fintype.card_fin, Fintype.card_option] using hdim
  exact exists_parity_coordinates_of_equiv d (by omega) (Fintype.equivOfCardEq hEq)


end P14FourierParityCoordinates
end
end

section

/-! A mixed determinant is nonzero when its two complementary fixed
blocks have nonzero determinants. The witness sets left variables to one
and right variables to zero; it asserts no positive-parameter condition. -/

noncomputable section
namespace P14FourierMixedDeterminant

open Matrix MvPolynomial

variable {α β R : Type*} [CommRing R]
variable [Fintype α] [DecidableEq α] [Fintype β] [DecidableEq β]

def mixedMatrix (A : Matrix α (α ⊕ β) R) (B : Matrix β (α ⊕ β) R) :
    Matrix (α ⊕ β) (α ⊕ β) (MvPolynomial (α ⊕ β) R) :=
  fun i j => Sum.elim (fun a => C (A a j) * X j) (fun b => C (B b j)) i

def mixedPolynomial (A : Matrix α (α ⊕ β) R) (B : Matrix β (α ⊕ β) R) :
    MvPolynomial (α ⊕ β) R :=
  (mixedMatrix A B).det

def leftPoint : α ⊕ β → R :=
  Sum.elim (fun _ => 1) (fun _ => 0)

theorem eval_mixedMatrix (A : Matrix α (α ⊕ β) R) (B : Matrix β (α ⊕ β) R) :
    (eval (leftPoint (α := α) (β := β) (R := R))).mapMatrix (mixedMatrix A B) =
      Matrix.fromBlocks (A.submatrix id Sum.inl) 0
        (B.submatrix id Sum.inl) (B.submatrix id Sum.inr) := by
  ext i j
  cases i <;> cases j <;>
    simp [mixedMatrix, leftPoint, Matrix.map_apply, Matrix.submatrix]

theorem eval_mixedPolynomial (A : Matrix α (α ⊕ β) R) (B : Matrix β (α ⊕ β) R) :
    eval (leftPoint (α := α) (β := β) (R := R)) (mixedPolynomial A B) =
      (A.submatrix id Sum.inl).det * (B.submatrix id Sum.inr).det := by
  unfold mixedPolynomial
  rw [RingHom.map_det, eval_mixedMatrix, Matrix.det_fromBlocks_zero₁₂]

theorem mixedPolynomial_ne_zero [NoZeroDivisors R]
    (A : Matrix α (α ⊕ β) R) (B : Matrix β (α ⊕ β) R)
    (hA : (A.submatrix id Sum.inl).det ≠ 0)
    (hB : (B.submatrix id Sum.inr).det ≠ 0) :
    mixedPolynomial A B ≠ 0 := by
  intro h
  apply mul_ne_zero hA hB
  rw [← eval_mixedPolynomial A B, h, map_zero]

end P14FourierMixedDeterminant
end
end

section

/-!
The actual mixed determinant is homogeneous in the number of A-rows and
has degree at most one in each column variable. These statements allow
the zero polynomial and require no nonvanishing or domain hypothesis.
-/

noncomputable section

namespace P14FourierMixedPolynomialDegrees

open Matrix MvPolynomial P14FourierMixedDeterminant
open scoped BigOperators

variable {α β R : Type*} [CommRing R]
variable [Fintype α] [DecidableEq α] [Fintype β] [DecidableEq β]

theorem mixedPolynomial_isHomogeneous
    (A : Matrix α (α ⊕ β) R) (B : Matrix β (α ⊕ β) R) :
    (mixedPolynomial A B).IsHomogeneous (Fintype.card α) := by
  classical
  let w : α ⊕ β → ℕ := Sum.elim (fun _ => 1) (fun _ => 0)
  have hentry (r i : α ⊕ β) :
      (mixedMatrix A B r i).IsHomogeneous (w r) := by
    cases r with
    | inl a => exact isHomogeneous_C_mul_X (A a i) i
    | inr b => exact isHomogeneous_C (α ⊕ β) (B b i)
  unfold mixedPolynomial
  rw [Matrix.det_apply']
  apply IsHomogeneous.sum
  intro π _
  have hcount : (∑ i, w (π i)) = Fintype.card α := by
    rw [Equiv.sum_comp π w]
    simp [w]
  have hprod := IsHomogeneous.prod Finset.univ
    (fun i => mixedMatrix A B (π i) i) (fun i => w (π i))
    (fun i _ => hentry (π i) i)
  rw [hcount] at hprod
  simpa only [map_intCast] using
    hprod.C_mul ((Equiv.Perm.sign π : ℤ) : R)

theorem mixedPolynomial_degreeOf_le_one
    (A : Matrix α (α ⊕ β) R) (B : Matrix β (α ⊕ β) R)
    (j : α ⊕ β) :
    degreeOf j (mixedPolynomial A B) ≤ 1 := by
  classical
  have hentry (r i : α ⊕ β) :
      degreeOf j (mixedMatrix A B r i) ≤ if i = j then 1 else 0 := by
    cases r with
    | inl a =>
        change degreeOf j (C (A a i) * X i) ≤ _
        by_cases h : i = j
        · subst i
          simpa [degreeOf_C] using
            degreeOf_mul_X_self j (C (A a j))
        · simpa only [if_neg h,
            degreeOf_mul_X_of_ne _ (Ne.symm h), degreeOf_C] using
            (Nat.le_refl 0)
    | inr b =>
        change degreeOf j (C (B b i)) ≤ _
        exact (degreeOf_C (B b i) j).le.trans (Nat.zero_le _)
  have hprod (π : Equiv.Perm (α ⊕ β)) :
      degreeOf j (∏ i, mixedMatrix A B (π i) i) ≤ 1 := by
    calc
      _ ≤ ∑ i, degreeOf j (mixedMatrix A B (π i) i) :=
        degreeOf_prod_le j Finset.univ _
      _ ≤ ∑ i : α ⊕ β, if i = j then 1 else 0 :=
        Finset.sum_le_sum fun i _ => hentry (π i) i
      _ = 1 :=
        Finset.sum_ite_eq_of_mem' Finset.univ j
          (fun _ => 1) (Finset.mem_univ j)
  have hcast (n : ℤ) (p : MvPolynomial (α ⊕ β) R) :
      degreeOf j ((n : MvPolynomial (α ⊕ β) R) * p) ≤ degreeOf j p := by
    simpa only [map_intCast] using degreeOf_C_mul_le p j (n : R)
  unfold mixedPolynomial
  rw [Matrix.det_apply']
  refine (degreeOf_sum_le j Finset.univ _).trans ?_
  apply Finset.sup_le
  intro π _
  exact (hcast (Equiv.Perm.sign π : ℤ) _).trans (hprod π)


end P14FourierMixedPolynomialDegrees
end
end

section

/-!
The actual polynomial obtained by eliminating one coordinate from the
full-support matching moment equations. This file establishes its homogeneous
degree. Nonzeroness, coordinate restrictions, and irreducibility are separate.
-/

noncomputable section

namespace P14MatchingRestrictionPolynomial

open MvPolynomial
open scoped BigOperators

variable {σ R : Type*} [DecidableEq σ] [CommRing R]

def variableSum (s : Finset σ) : MvPolynomial σ R := ∑ i ∈ s, X i

def variableProduct (s : Finset σ) : MvPolynomial σ R := ∏ i ∈ s, X i

def reciprocalNumerator (s : Finset σ) (c : σ → R) : MvPolynomial σ R :=
  ∑ i ∈ s, C (c i) * variableProduct (s.erase i)

def eliminated (s : Finset σ) (c₀ : R) (c : σ → R) : MvPolynomial σ R :=
  C c₀ * variableProduct s - variableSum s * reciprocalNumerator s c

theorem variableSum_isHomogeneous (s : Finset σ) :
    (variableSum s : MvPolynomial σ R).IsHomogeneous 1 := by
  exact IsHomogeneous.sum s (fun i => X i) 1 (fun i _ => isHomogeneous_X R i)

theorem variableProduct_isHomogeneous (s : Finset σ) :
    (variableProduct s : MvPolynomial σ R).IsHomogeneous s.card := by
  simpa only [variableProduct, Finset.sum_const, smul_eq_mul, mul_one] using
    IsHomogeneous.prod s (fun i => (X i : MvPolynomial σ R)) (fun _ => 1)
      (fun i _ => isHomogeneous_X R i)

theorem reciprocalNumerator_isHomogeneous (s : Finset σ) (c : σ → R) :
    (reciprocalNumerator s c).IsHomogeneous (s.card - 1) := by
  apply IsHomogeneous.sum
  intro i hi
  have h := (variableProduct_isHomogeneous (R := R) (s.erase i)).C_mul (c i)
  simpa only [Finset.card_erase_of_mem hi] using h

theorem eliminated_isHomogeneous (s : Finset σ) (hs : s.Nonempty)
    (c₀ : R) (c : σ → R) :
    (eliminated s c₀ c).IsHomogeneous s.card := by
  apply IsHomogeneous.sub ((variableProduct_isHomogeneous s).C_mul c₀)
  have h := (variableSum_isHomogeneous (R := R) s).mul
    (reciprocalNumerator_isHomogeneous s c)
  have hcard : 1 + (s.card - 1) = s.card := by
    have := Finset.card_pos.mpr hs
    omega
  simpa only [hcard] using h


end P14MatchingRestrictionPolynomial
end
end

section

/-!
Source-only draft: distinct coordinate variables, together with a sum supported
on at least two distinct coordinates, are pairwise nonassociated. The final
statement uses the polynomial ring on the coordinates remaining after two
erasures. No primality or nonassociation hypothesis is assumed.
-/

noncomputable section

namespace P14MvPolynomialCoordinateNonassociated

open scoped BigOperators

variable {σ R : Type*} [CommSemiring R] [Nontrivial R]

/-- The coefficient of a coordinate in a finite coordinate sum. -/
theorem coeff_coordinate_sum [DecidableEq σ] (s : Finset σ) (j : σ) :
    MvPolynomial.coeff (Finsupp.single j 1)
      (∑ a ∈ s, (MvPolynomial.X a : MvPolynomial σ R)) =
        if j ∈ s then 1 else 0 := by
  classical
  simp [MvPolynomial.coeff_sum]

/-- Every multiple of `X i` has zero coefficient at the different coordinate
monomial `X j`. -/
theorem coeff_X_mul_at_other (i j : σ) (hij : i ≠ j)
    (q : MvPolynomial σ R) :
    MvPolynomial.coeff (Finsupp.single j 1) (MvPolynomial.X i * q) = 0 := by
  classical
  rw [MvPolynomial.coeff_X_mul']
  have hnot : i ∉ (Finsupp.single j 1 : σ →₀ ℕ).support :=
    Finsupp.notMem_support_iff.mpr (Finsupp.single_eq_of_ne hij)
  rw [if_neg hnot]

/-- Distinct coordinate identities give nonassociated coordinate variables. -/
theorem not_associated_X_X (i j : σ) (hij : i ≠ j) :
    ¬ Associated (MvPolynomial.X i : MvPolynomial σ R) (MvPolynomial.X j) := by
  intro h
  obtain ⟨q, hq⟩ := h.dvd
  have h10 : (1 : R) = 0 := by
    calc
      1 = MvPolynomial.coeff (Finsupp.single j 1)
          (MvPolynomial.X j : MvPolynomial σ R) :=
        (MvPolynomial.coeff_X_same j).symm
      _ = MvPolynomial.coeff (Finsupp.single j 1) (MvPolynomial.X i * q) :=
        congrArg (MvPolynomial.coeff (Finsupp.single j 1)) hq
      _ = 0 := coeff_X_mul_at_other i j hij q
  exact one_ne_zero h10

/-- A single other coordinate in the support already separates the sum from
`X i`; no assumption that `i` itself belongs to the support is needed. -/
theorem not_associated_X_sum_of_mem_ne (s : Finset σ) (i j : σ)
    (hj : j ∈ s) (hji : j ≠ i) :
    ¬ Associated (MvPolynomial.X i : MvPolynomial σ R)
      (∑ a ∈ s, MvPolynomial.X a) := by
  classical
  intro h
  obtain ⟨q, hq⟩ := h.dvd
  have h10 : (1 : R) = 0 := by
    calc
      1 = MvPolynomial.coeff (Finsupp.single j 1)
          (∑ a ∈ s, (MvPolynomial.X a : MvPolynomial σ R)) := by
        rw [coeff_coordinate_sum, if_pos hj]
      _ = MvPolynomial.coeff (Finsupp.single j 1) (MvPolynomial.X i * q) :=
        congrArg (MvPolynomial.coeff (Finsupp.single j 1)) hq
      _ = 0 := coeff_X_mul_at_other i j hji.symm q
  exact one_ne_zero h10

/-- A coordinate sum with at least two support coordinates is nonassociated
to every coordinate variable in the ambient polynomial ring. -/
theorem not_associated_X_sum (s : Finset σ) (hs : 2 ≤ s.card) (i : σ) :
    ¬ Associated (MvPolynomial.X i : MvPolynomial σ R)
      (∑ a ∈ s, MvPolynomial.X a) := by
  obtain ⟨j, hj, hji⟩ := Finset.exists_mem_ne (s := s) hs i
  exact not_associated_X_sum_of_mem_ne s i j hj hji

theorem not_associated_sum_X (s : Finset σ) (hs : 2 ≤ s.card) (i : σ) :
    ¬ Associated (∑ a ∈ s, (MvPolynomial.X a : MvPolynomial σ R))
      (MvPolynomial.X i) := by
  intro h
  exact not_associated_X_sum s hs i h.symm

/-- Index the sum by `none` and the coordinate variables by `some i`. -/
def coordinateFamily (s : Finset σ) : Option σ → MvPolynomial σ R
  | none => ∑ a ∈ s, MvPolynomial.X a
  | some i => MvPolynomial.X i

/-- This supplies pairwise nonassociation to prime-product subset uniqueness
for any two finite subsets of the indexed coordinate family. -/
theorem coordinateFamily_not_associated (s : Finset σ) (hs : 2 ≤ s.card)
    (a b : Option σ) (hab : a ≠ b) :
    ¬ Associated (coordinateFamily (R := R) s a) (coordinateFamily s b) := by
  cases a with
  | none =>
      cases b with
      | none => exact (hab rfl).elim
      | some j => exact not_associated_sum_X s hs j
  | some i =>
      cases b with
      | none => exact not_associated_X_sum s hs i
      | some j =>
          exact not_associated_X_X i j (fun hij => hab (congrArg Option.some hij))

/-- Caller-ready double-coordinate restriction ambient ring. Its variables
are exactly the surviving coordinates. The cardinality hypothesis is stated
on that actual support, so no implicit counting or reindexing fact is used. -/
theorem doubleRestrictionFamily_not_associated [DecidableEq σ]
    (s : Finset σ) (i j : σ) (hs : 2 ≤ ((s.erase i).erase j).card)
    (a b : Option {x : σ // x ∈ (s.erase i).erase j}) (hab : a ≠ b) :
    ¬ Associated
      (coordinateFamily (R := R) (Finset.univ : Finset {x : σ // x ∈ (s.erase i).erase j}) a)
      (coordinateFamily (R := R) (Finset.univ : Finset {x : σ // x ∈ (s.erase i).erase j}) b) := by
  classical
  apply coordinateFamily_not_associated
  · simpa only [Finset.card_univ, Fintype.card_coe] using hs
  · exact hab


end P14MvPolynomialCoordinateNonassociated
end
end

section

/-!
A sum of distinct coordinate variables has coefficient one at every supported
coordinate. Its individual degree is therefore one there. On the full finite
coordinate ring this supplies the all-variable hypotheses for multiaffine
nondivisibility, with no unused ambient variables hidden outside the support.
-/

namespace P14FullCoordinateSumDegrees

open MvPolynomial P14MatchingRestrictionPolynomial
open P14MvPolynomialCoordinateNonassociated

variable {σ R : Type*} [DecidableEq σ] [CommRing R] [Nontrivial R]

theorem variableSum_ne_zero_of_mem (s : Finset σ) (i : σ) (hi : i ∈ s) :
    (variableSum s : MvPolynomial σ R) ≠ 0 := by
  have hCoeff : coeff (Finsupp.single i 1) (variableSum s : MvPolynomial σ R) = 1 := by
    simpa only [variableSum, if_pos hi] using coeff_coordinate_sum (R := R) s i
  intro hzero
  rw [hzero, coeff_zero] at hCoeff
  exact zero_ne_one hCoeff

theorem variableSum_totalDegree (s : Finset σ) (hs : s.Nonempty) :
    (variableSum s : MvPolynomial σ R).totalDegree = 1 := by
  obtain ⟨i, hi⟩ := hs
  exact (variableSum_isHomogeneous s).totalDegree (variableSum_ne_zero_of_mem s i hi)

theorem variableSum_degreeOf_of_mem (s : Finset σ) (i : σ) (hi : i ∈ s) :
    degreeOf i (variableSum s : MvPolynomial σ R) = 1 := by
  have hCoeff : coeff (Finsupp.single i 1) (variableSum s : MvPolynomial σ R) = 1 := by
    simpa only [variableSum, if_pos hi] using coeff_coordinate_sum (R := R) s i
  have hSupport : Finsupp.single i 1 ∈ (variableSum s : MvPolynomial σ R).support :=
    mem_support_iff.mpr (by rw [hCoeff]; exact one_ne_zero)
  have hLower : 1 ≤ degreeOf i (variableSum s : MvPolynomial σ R) := by
    simpa only [Finsupp.single_eq_same] using monomial_le_degreeOf i hSupport
  have hUpper := degreeOf_le_totalDegree (variableSum s : MvPolynomial σ R) i
  rw [variableSum_totalDegree s ⟨i, hi⟩] at hUpper
  exact le_antisymm hUpper hLower

/-- The full finite ring is essential: every ambient variable occurs in the sum. -/
theorem fullCoordinateSum_degree_data [Fintype σ] [Nonempty σ] :
    (variableSum (Finset.univ : Finset σ) : MvPolynomial σ R) ≠ 0 ∧
      (variableSum (Finset.univ : Finset σ) : MvPolynomial σ R).totalDegree = 1 ∧
        ∀ i : σ, degreeOf i (variableSum (Finset.univ : Finset σ) : MvPolynomial σ R) = 1 := by
  obtain ⟨i⟩ := ‹Nonempty σ›
  refine ⟨variableSum_ne_zero_of_mem Finset.univ i (Finset.mem_univ i),
    variableSum_totalDegree Finset.univ ⟨i, Finset.mem_univ i⟩, ?_⟩
  intro j
  exact variableSum_degreeOf_of_mem Finset.univ j (Finset.mem_univ j)


end P14FullCoordinateSumDegrees
end

section

/-!
Eliminate the distinguished coordinate from the full finite coordinate sum.
The kernel is exactly the principal ideal of that sum, expressed here as
divisibility. The coefficient ring may have zero divisors or be the zero ring.
-/

noncomputable section

namespace P14MatchingLinearElimination

open MvPolynomial P14MatchingRestrictionPolynomial
open scoped BigOperators

variable {σ K : Type*} [Fintype σ] [DecidableEq σ] [CommRing K]

/-- Substitute minus the full retained-coordinate sum for `none`, leaving
every retained coordinate unchanged. -/
def linearElimination : MvPolynomial (Option σ) K →ₐ[K] MvPolynomial σ K :=
  MvPolynomial.aeval
    (fun o => Option.elim o (-(variableSum (Finset.univ : Finset σ))) X)

@[simp]
theorem linearElimination_X_none :
    linearElimination (X none : MvPolynomial (Option σ) K) =
      -(variableSum (Finset.univ : Finset σ)) := by
  simp only [linearElimination, aeval_X, Option.elim_none]

@[simp]
theorem linearElimination_X_some (i : σ) :
    linearElimination (X (some i) : MvPolynomial (Option σ) K) = X i := by
  simp only [linearElimination, aeval_X, Option.elim_some]

private theorem optionEquivLeft_variableSum :
    optionEquivLeft K σ (variableSum (Finset.univ : Finset (Option σ))) =
      Polynomial.X - Polynomial.C (-(variableSum (Finset.univ : Finset σ))) := by
  simp only [variableSum, univ_option, Finset.sum_insertNone, map_add, map_sum,
    optionEquivLeft_X_none, optionEquivLeft_X_some, map_neg, sub_neg_eq_add]

private theorem linearElimination_eq_eval (P : MvPolynomial (Option σ) K) :
    linearElimination P =
      Polynomial.eval (-(variableSum (Finset.univ : Finset σ)))
        (optionEquivLeft K σ P) := by
  let ev : Polynomial (MvPolynomial σ K) →ₐ[K] MvPolynomial σ K :=
    Polynomial.aevalTower (AlgHom.id K (MvPolynomial σ K))
      (-(variableSum (Finset.univ : Finset σ)))
  have hmap : linearElimination = ev.comp (optionEquivLeft K σ).toAlgHom := by
    apply MvPolynomial.algHom_ext
    intro i
    cases i <;> simp [linearElimination, ev]
  calc
    linearElimination P = ev (optionEquivLeft K σ P) := DFunLike.congr_fun hmap P
    _ = Polynomial.eval (-(variableSum (Finset.univ : Finset σ)))
        (optionEquivLeft K σ P) := rfl

/-- The actual substitution kills exactly the multiples of the full sum.
No primality, domain, nonzero-polynomial, or desired-kernel premise is used. -/
theorem linearElimination_eq_zero_iff (P : MvPolynomial (Option σ) K) :
    linearElimination P = 0 ↔
      variableSum (Finset.univ : Finset (Option σ)) ∣ P := by
  rw [linearElimination_eq_eval]
  change Polynomial.IsRoot (optionEquivLeft K σ P)
    (-(variableSum (Finset.univ : Finset σ))) ↔ _
  constructor
  · intro h
    have hdiv := Polynomial.dvd_iff_isRoot.mpr h
    rw [← optionEquivLeft_variableSum] at hdiv
    obtain ⟨Q, hQ⟩ := hdiv
    refine ⟨(optionEquivLeft K σ).symm Q, ?_⟩
    apply (optionEquivLeft K σ).injective
    simpa only [map_mul, AlgEquiv.apply_symm_apply] using hQ
  · intro h
    have hdiv := map_dvd (optionEquivLeft K σ) h
    rw [optionEquivLeft_variableSum] at hdiv
    exact Polynomial.dvd_iff_isRoot.mp hdiv

/-- Linear homogeneous substitution preserves the homogeneous degree,
including when the resulting polynomial is zero. -/
theorem linearElimination_isHomogeneous {P : MvPolynomial (Option σ) K} {r : ℕ}
    (hP : P.IsHomogeneous r) : (linearElimination P).IsHomogeneous r := by
  have hg : ∀ i : Option σ,
      (Option.elim i (-(variableSum (Finset.univ : Finset σ))) X :
        MvPolynomial σ K).IsHomogeneous 1 := by
    intro i
    cases i with
    | none => exact (variableSum_isHomogeneous (Finset.univ : Finset σ)).neg
    | some i => exact isHomogeneous_X K i
  simpa only [linearElimination, one_mul] using hP.aeval _ hg


end P14MatchingLinearElimination
end
end

