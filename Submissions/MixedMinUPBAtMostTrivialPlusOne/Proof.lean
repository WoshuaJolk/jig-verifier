/-! Full assembly from the explicit grid obstruction, and its unconditional
q=9 instance. The final theorem covers every odd q>=9. -/
noncomputable section
namespace P14QuquartGridUPB
open Submodule P14QuquartGridMinors P14QuquartRootGrid P14ComplexLocalCover
open P14FivePrescribedPairings (rootNode rootNode_injective)
open P14QuquartLargeOrder (rho)
open P14QuquartExceptionalUPB (dimensions caps sum_caps sum_dimensions_sub_one)

theorem exists_normalized_spanning (q : ℕ) (hq : 7 ≤ q)
    (hl : (9 : ℝ) / 5 < rho q) (hu : rho q < 2) (hgap : TripleGap q)
    (xi : ℂ) (hxi : ‖xi‖ = 1) :
    ∃ a : ℝ, ∃ z : ℂ, P14QuquartParameterBranch.Admissible (rho q) a z ∧
      (∀ i, P14QuquartFiveSpanning.rows (rho q) xi a z (rootNode q) i ≠ 0) ∧
      (∀ S : Finset (Fin q ⊕ Fin q), S.card = 5 →
        span ℂ (Set.range (fun s : S =>
          P14QuquartFiveSpanning.rows (rho q) xi a z (rootNode q) s.val)) = ⊤) := by
  obtain ⟨a, z, had, h31, h23⟩ := exists_mixed_minors q hq hl hu hgap xi hxi
  have hr : 0 < rho q := by linarith
  have hxi0 : xi ≠ 0 := by intro he; simp [he] at hxi
  exact ⟨a, z, had,
    P14QuquartFiveSpanning.rows_ne_zero (rho q) hr xi hxi0 a z had (rootNode q),
    P14QuquartFiveSpanning.every_five (rho q) hr xi hxi0 a z had (rootNode q)
      (rootNode_injective (by omega)) h31 h23⟩

theorem exists_physical_spanning (q : ℕ) (hq : 7 ≤ q)
    (hl : (9 : ℝ) / 5 < rho q) (hu : rho q < 2) (hgap : TripleGap q)
    (xi : ℂ) (hxi : ‖xi‖ = 1) :
    ∃ a : ℝ, ∃ z : ℂ, P14QuquartParameterBranch.Admissible (rho q) a z ∧
      (∀ i, P14QuquartPhysicalRows.rows (rho q) xi a z (rootNode q) i ≠ 0) ∧
      (∀ S : Finset (Fin q ⊕ Fin q), S.card = 5 →
        span ℂ (Set.range (fun s : S =>
          P14QuquartPhysicalRows.rows (rho q) xi a z (rootNode q) s.val)) = ⊤) := by
  obtain ⟨a, z, had, hnz, hspan⟩ := exists_normalized_spanning q hq hl hu hgap xi hxi
  have hpos := P14QuquartPhysicalRows.weights_pos (rho q) a z had
  refine ⟨a, z, had, ?_, ?_⟩
  · intro i
    rw [P14QuquartPhysicalRows.physical_eq (rho q) xi a z had]
    apply smul_ne_zero (P14QuquartPhysicalRows.factor_ne_zero (rho q) a z had i)
    intro he
    apply hnz i
    apply P14QuquartPhysicalRows.diagonal_injective (rho q) a hpos
    simpa only [map_zero] using he
  · intro S hS
    simp_rw [P14QuquartPhysicalRows.physical_eq (rho q) xi a z had]
    rw [P14QuquartPhysicalRows.span_scaled _ _
      (fun s : S => P14QuquartPhysicalRows.factor_ne_zero (rho q) a z had s.val)]
    exact P14QuquartPhysicalRows.span_diagonal (rho q) a hpos _ (hspan S hS)

theorem exists_local_factor {q : ℕ} [NeZero q] (hq : 7 ≤ q) (ho : Odd q)
    (hl : (9 : ℝ) / 5 < rho q) (hu : rho q < 2) (hgap : TripleGap q) :
    HasLocalFactor (Fin q ⊕ Fin q) 4 4 (P14QuquartGraphCover.E hq) := by
  obtain ⟨a, z, had, hnz, hspan⟩ :=
    exists_physical_spanning q hq hl hu hgap (phase q) (phase_norm q)
  refine ⟨fixedFamily q a z, hnz, ?_, ?_⟩
  · intro S hS
    exact hspan S hS
  · intro i j hij
    exact prescribed_pairing hq ho a z had i j hij

theorem canonical (q : ℕ) (hq : 7 ≤ q) (ho : Odd q)
    (hl : (9 : ℝ) / 5 < rho q) (hu : rho q < 2) (hgap : TripleGap q) :
    ∃ m : ℕ, m ≤ 2 + ∑ j, (dimensions q j - 1) ∧
      ∃ v : Fin m → (j : Fin ((2 * q - 5) + 1)) → Fin (dimensions q j) → ℂ,
        (∀ i j, v i j ≠ 0) ∧
        (∀ i i', i ≠ i' →
          ∃ j, (∑ r, star (v i j r) * v i' j r) = 0) ∧
        (∀ a : (j : Fin ((2 * q - 5) + 1)) → Fin (dimensions q j) → ℂ,
          (∀ j, a j ≠ 0) → ∃ i, ∀ j, (∑ r, star (v i j r) * a j r) ≠ 0) := by
  classical
  letI : NeZero q := ⟨by omega⟩
  obtain ⟨F, hF, hfix, hcover⟩ := P14QuquartGraphCover.construct hq ho
  let R : Fin ((2 * q - 5) + 1) → (Fin q ⊕ Fin q) →
      (Fin q ⊕ Fin q) → Prop :=
    Fin.cons (P14QuquartGraphCover.E hq) (fun c i j => F c i = j)
  have hlocal : ∀ j, HasLocalFactor (Fin q ⊕ Fin q)
      (dimensions q j) (caps q j) (R j) := by
    intro j
    refine Fin.cases ?_ (fun c => ?_) j
    · exact exists_local_factor hq ho hl hu hgap
    · exact P14MatchingLocalFactor.on_finite (F c) (hF c) (hfix c)
  have hcomplete : ∀ i i' : Fin q ⊕ Fin q, i ≠ i' → ∃ j, R j i i' := by
    intro i i' hii'
    rcases hcover i i' hii' with h | ⟨c, hc⟩
    · exact ⟨0, h⟩
    · exact ⟨c.succ, hc⟩
  have hcard : Fintype.card (Fin q ⊕ Fin q) = 2 * q := by simp [two_mul]
  have hbudget : (∑ j, caps q j) < Fintype.card (Fin q ⊕ Fin q) := by
    rw [sum_caps, hcard]
    omega
  have hbound : Fintype.card (Fin q ⊕ Fin q) ≤
      2 + ∑ j, (dimensions q j - 1) := by
    rw [hcard, sum_dimensions_sub_one]
    omega
  exact P14ComplexLocalCover.canonical (dimensions q) (caps q) R
    hlocal hcomplete hbudget hbound

theorem canonical_ge_nine (q : ℕ) (hq : 9 ≤ q) (ho : Odd q) :
    ∃ m : ℕ, m ≤ 2 + ∑ j, (dimensions q j - 1) ∧
      ∃ v : Fin m → (j : Fin ((2 * q - 5) + 1)) → Fin (dimensions q j) → ℂ,
        (∀ i j, v i j ≠ 0) ∧
        (∀ i i', i ≠ i' →
          ∃ j, (∑ r, star (v i j r) * v i' j r) = 0) ∧
        (∀ a : (j : Fin ((2 * q - 5) + 1)) → Fin (dimensions q j) → ℂ,
          (∀ j, a j ≠ 0) → ∃ i, ∀ j, (∑ r, star (v i j r) * a j r) ≠ 0) := by
  by_cases h9 : q = 9
  · subst q
    exact canonical 9 (by decide) ho P14QuquartNineBounds.rho_nine_bounds.1
      P14QuquartNineBounds.rho_nine_bounds.2 P14QuquartNineBounds.triple_norm_ne
  · have h11 : 11 ≤ q := by obtain ⟨k, hk⟩ := ho; omega
    exact P14QuquartExceptionalUPB.canonical h11 ho

end P14QuquartGridUPB

