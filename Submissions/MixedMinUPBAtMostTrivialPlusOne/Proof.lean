section

/-! Complete prescribed-five graph cover for every ordinary deficit at least two; the existing balanced-five block handles equality. -/

noncomputable section
namespace P14FiveFlexibleGraphCover
open P14OddLayerLabels P14FivePrescribedPairings P14BicliqueComplementConnection
open P14CyclicOffsetIntervalCover P14FiveMixedGraphCover
open scoped BigOperators

theorem construct {q p m : ℕ} [NeZero q] (hq : 7 ≤ q) (ho : Odd q)
    (r : Fin p → ℕ) (hr : ∀ i, 2 ≤ r i)
    (htotal : (∑ i, r i) + m = 2 * q - 6) :
    ∃ H : Fin p → ℕ → ℕ → Prop,
      ∃ F : Fin m → (Fin q ⊕ Fin q) → (Fin q ⊕ Fin q),
      (∀ i, (∀ {u v}, H i u v → H i v u) ∧ (∀ u, ¬ H i u u) ∧
        BicliqueBound (H i) (Finset.range (2 * q)) (r i + 1)) ∧
      (∀ c, Function.Involutive (F c)) ∧ (∀ c u, F c u ≠ u) ∧
      (∀ u v, u ≠ v → Prescribed hq u v ∨
        (∃ i, H i (encode u) (encode v)) ∨ (∃ c, F c u = v)) := by
  classical
  obtain ⟨x, t, N, B, a, b, F, hpart, hN, hB, _, ha, hb, hF, hFne, hFC⟩ :=
    P14FiveFlexibleRemainder.construct hq ho r hr htotal
  let K := fun i => P14OddLayerBlockBiclique.Edge (Side q) (label q)
    (1 + prefixSum (lengths x) i) (lengths x i)
    (1 + (prefixSum (lengths t) i : ZMod q)) (lengths t i)
  have hK : ∀ i, i < p →
      (∀ {u v}, K i u v → K i v u) ∧ (∀ u, ¬ K i u u) ∧
      BicliqueBound (K i) (Finset.range (2 * q))
        (2 * lengths x i + lengths t i + 1) := by
    intro i hi
    have hend := P14CyclicArcPartition.prefix_end (lengths x) hi
    rw [prefix_lengths] at hend
    have hxi : lengths x i = x ⟨i, hi⟩ := by simp [lengths, hi]
    have hti : lengths t i = t ⟨i, hi⟩ := by simp [lengths, hi]
    have hp := hpart ⟨i, hi⟩
    have htmax : t ⟨i, hi⟩ ≤ ∑ j, t j :=
      Finset.single_le_sum (fun j _ => Nat.zero_le (t j)) (Finset.mem_univ _)
    have hstart : 1 ≤ 1 + prefixSum (lengths x) i := by omega
    have hlimit : 2 * (1 + prefixSum (lengths x) i + lengths x i) ≤ q + 1 := by omega
    have htq : lengths t i < q := by omega
    refine ⟨P14OddLayerBlockBiclique.edge_symmetric (Side q) (label q) _ _ _ _,
      P14OddLayerBlockBiclique.edge_irreflexive (Side q) (label q) _ _ _ _ hstart hlimit, ?_⟩
    by_cases hne : 2 * lengths x i ≠ lengths t i
    · exact P14OddLayerBlockBiclique.bound (Side q) (Finset.range (2 * q))
        (label q) labels_injective ho _ _ _ _ hstart hlimit htq hne
    · have hx1 : lengths x i = 1 := by omega
      have ht2 : lengths t i = 2 := by omega
      have hbal : 2 * (1 + prefixSum (lengths x) i) + 2 ≤ q := by omega
      simpa only [K, hx1, ht2] using
        P14BalancedFiveBlock.bound (Side q) (Finset.range (2 * q)) (label q)
          labels_injective ho (1 + prefixSum (lengths x) i)
          (1 + (prefixSum (lengths t) i : ZMod q)) hstart hbal
  have hKC (u v : ℕ) :
      P14OddLayerBlockBiclique.Edge (Side q) (label q) 1 (∑ i, x i) 1 (∑ i, t i) u v ↔
        ∃ i, i < p ∧ K i u v := by
    simpa only [prefix_lengths] using P14OddAnnulusBlocks.edge_cover
      (Side q) (label q) (lengths x) (lengths t) p 1 1 u v
  refine ⟨fun i => K i.val, F, ?_, hF, hFne, ?_⟩
  · intro i
    have hk := hK i.val i.isLt
    refine ⟨hk.1, hk.2.1, ?_⟩
    have hbound := hk.2.2
    rw [lengths_fin, lengths_fin, (hpart i).1] at hbound
    exact hbound
  · intro u v huv
    rcases P14FiveComplementSplit.cover hq ho a b hN hB ha hb u v huv with
      he | hord | hinside | hcross
    · exact Or.inl he
    · obtain ⟨i, hi, hedge⟩ := (hKC (encode u) (encode v)).mp hord
      exact Or.inr (Or.inl ⟨⟨i, hi⟩, hedge⟩)
    · exact Or.inr (Or.inr ((hFC u v).mp (Or.inl hinside)))
    · exact Or.inr (Or.inr ((hFC u v).mp (Or.inr hcross)))

end P14FiveFlexibleGraphCover

end
end

section

/-! Every five distinct nodes in either actual layer span dimension five.
Only nonzero weights and monomial multipliers are needed; this does not
assert mixed five-row general position or choose a common parameter. -/

noncomputable section
namespace P14FivePureLayerSpanning

open Matrix Submodule P14FiveMonomialFamily
open scoped BigOperators

theorem u_kernel (a b : ℝ) (ha : a ≠ 0) (hb : b ≠ 0)
    (z : Fin 5 → ℂ) (hz : Function.Injective z)
    (w : Fin 5 → ℂ) (hw : ∀ j, dotProduct (u a b (z j)) w = 0) : w = 0 := by
  have haC : (a : ℂ) ≠ 0 := Complex.ofReal_ne_zero.mpr ha
  have hbC : (b : ℂ) ≠ 0 := Complex.ofReal_ne_zero.mpr hb
  have hcoef : (![w 0, (a : ℂ) * w 1, (b : ℂ) * w 2,
      (a : ℂ) * w 3, w 4] : Fin 5 → ℂ) = 0 := by
    apply Matrix.eq_zero_of_forall_index_sum_pow_mul_eq_zero (f := z) hz
    intro j
    calc
      _ = dotProduct (u a b (z j)) w := by
        simp [u, dotProduct, Fin.sum_univ_succ]
        <;> ring
      _ = 0 := hw j
  have h0 : w 0 = 0 := by simpa using congrFun hcoef (0 : Fin 5)
  have h1p : (a : ℂ) * w 1 = 0 := by simpa using congrFun hcoef (1 : Fin 5)
  have h2p : (b : ℂ) * w 2 = 0 := by simpa using congrFun hcoef (2 : Fin 5)
  have h3p : (a : ℂ) * w 3 = 0 := by simpa using congrFun hcoef (3 : Fin 5)
  have h4 : w 4 = 0 := by simpa using congrFun hcoef (4 : Fin 5)
  have h1 : w 1 = 0 := (mul_eq_zero.mp h1p).resolve_left haC
  have h2 : w 2 = 0 := (mul_eq_zero.mp h2p).resolve_left hbC
  have h3 : w 3 = 0 := (mul_eq_zero.mp h3p).resolve_left haC
  funext i
  fin_cases i <;> assumption

theorem v_kernel (a b : ℝ) (c t : ℂ)
    (ha : a ≠ 0) (hb : b ≠ 0) (hc : c ≠ 0) (ht : t ≠ 0)
    (z : Fin 5 → ℂ) (hz : Function.Injective z)
    (w : Fin 5 → ℂ) (hw : ∀ j, dotProduct (v a b c t (z j)) w = 0) : w = 0 := by
  have haC : (a : ℂ) ≠ 0 := Complex.ofReal_ne_zero.mpr ha
  have hbC : (b : ℂ) ≠ 0 := Complex.ofReal_ne_zero.mpr hb
  have hcoef : (![c * w 2, -(a : ℂ) * w 3, (star c * (b : ℂ)) * w 4,
      (t * (a : ℂ)) * w 0, -t * w 1] : Fin 5 → ℂ) = 0 := by
    apply Matrix.eq_zero_of_forall_index_sum_pow_mul_eq_zero (f := z) hz
    intro j
    calc
      _ = dotProduct (v a b c t (z j)) w := by
        simp [v, dotProduct, Fin.sum_univ_succ]
        <;> ring
      _ = 0 := hw j
  have h2p : c * w 2 = 0 := by simpa using congrFun hcoef (0 : Fin 5)
  have h3p : -(a : ℂ) * w 3 = 0 := by simpa using congrFun hcoef (1 : Fin 5)
  have h4p : (star c * (b : ℂ)) * w 4 = 0 := by
    simpa using congrFun hcoef (2 : Fin 5)
  have h0p : (t * (a : ℂ)) * w 0 = 0 := by simpa using congrFun hcoef (3 : Fin 5)
  have h1p : -t * w 1 = 0 := by simpa using congrFun hcoef (4 : Fin 5)
  have h0 : w 0 = 0 := (mul_eq_zero.mp h0p).resolve_left (mul_ne_zero ht haC)
  have h1 : w 1 = 0 := (mul_eq_zero.mp h1p).resolve_left (neg_ne_zero.mpr ht)
  have h2 : w 2 = 0 := (mul_eq_zero.mp h2p).resolve_left hc
  have h3 : w 3 = 0 := (mul_eq_zero.mp h3p).resolve_left (neg_ne_zero.mpr haC)
  have h4 : w 4 = 0 := (mul_eq_zero.mp h4p).resolve_left
    (mul_ne_zero (star_ne_zero.mpr hc) hbC)
  funext i
  fin_cases i <;> assumption

theorem u_det_ne_zero (a b : ℝ) (ha : a ≠ 0) (hb : b ≠ 0)
    (z : Fin 5 → ℂ) (hz : Function.Injective z) :
    Matrix.det (fun i => u a b (z i)) ≠ 0 := by
  intro hdet
  obtain ⟨w, hw, hker⟩ := Matrix.exists_mulVec_eq_zero_iff.mpr hdet
  exact hw (u_kernel a b ha hb z hz w (fun i => congrFun hker i))

theorem v_det_ne_zero (a b : ℝ) (c t : ℂ)
    (ha : a ≠ 0) (hb : b ≠ 0) (hc : c ≠ 0) (ht : t ≠ 0)
    (z : Fin 5 → ℂ) (hz : Function.Injective z) :
    Matrix.det (fun i => v a b c t (z i)) ≠ 0 := by
  intro hdet
  obtain ⟨w, hw, hker⟩ := Matrix.exists_mulVec_eq_zero_iff.mpr hdet
  exact hw (v_kernel a b c t ha hb hc ht z hz w (fun i => congrFun hker i))

theorem u_span (a b : ℝ) (ha : a ≠ 0) (hb : b ≠ 0)
    (z : Fin 5 → ℂ) (hz : Function.Injective z) :
    span ℂ (Set.range (fun i => u a b (z i))) = ⊤ :=
  (Matrix.linearIndependent_rows_of_det_ne_zero (u_det_ne_zero a b ha hb z hz)).span_eq_top_of_card_eq_finrank (by simp)

theorem v_span (a b : ℝ) (c t : ℂ)
    (ha : a ≠ 0) (hb : b ≠ 0) (hc : c ≠ 0) (ht : t ≠ 0)
    (z : Fin 5 → ℂ) (hz : Function.Injective z) :
    span ℂ (Set.range (fun i => v a b c t (z i))) = ⊤ :=
  (Matrix.linearIndependent_rows_of_det_ne_zero (v_det_ne_zero a b c t ha hb hc ht z hz)).span_eq_top_of_card_eq_finrank (by simp)

end P14FivePureLayerSpanning

end
end

section

/-! Minimal mixed blocks for the actual dimension-five monomial family.
At parameter zero, two U rows and three V rows are independent. At the
reversed-parameter zero, three U rows and two leading V rows are independent.
Only separate node injectivity is needed; overlap between the layers is allowed.
No common parameter choice, physical pairing or graph conclusion is asserted. -/

noncomputable section
namespace P14FiveBlockSpecializations

open Matrix Submodule P14FiveMonomialFamily
open scoped BigOperators

/-- The leading coefficient of the actual V row as a polynomial in t. -/
def vInfinity (a : ℝ) (z : ℂ) : Fin 5 → ℂ :=
  ![(a : ℂ) * z ^ 3, -(z ^ 4), 0, 0, 0]

/-- Two U nodes and three V nodes at t=0 have no nonzero right annihilator.
The nodes may be zero, and nodes from different layers may coincide. -/
theorem zero_specialization_kernel (a b : ℝ) (c : ℂ)
    (ha : a ≠ 0) (hb : b ≠ 0) (hc : c ≠ 0)
    (x : Fin 2 → ℂ) (y : Fin 3 → ℂ)
    (hx : Function.Injective x) (hy : Function.Injective y)
    (w : Fin 5 → ℂ)
    (hU : ∀ i, dotProduct (u a b (x i)) w = 0)
    (hV : ∀ i, dotProduct (v a b c 0 (y i)) w = 0) : w = 0 := by
  have haC : (a : ℂ) ≠ 0 := Complex.ofReal_ne_zero.mpr ha
  have hbC : (b : ℂ) ≠ 0 := Complex.ofReal_ne_zero.mpr hb
  have htail : (![c * w 2, -(a : ℂ) * w 3,
      (star c * (b : ℂ)) * w 4] : Fin 3 → ℂ) = 0 := by
    apply Matrix.eq_zero_of_forall_index_sum_pow_mul_eq_zero (f := y) hy
    intro i
    calc
      _ = dotProduct (v a b c 0 (y i)) w := by
        simp [v, dotProduct, Fin.sum_univ_succ]
        <;> ring
      _ = 0 := hV i
  have h2p : c * w 2 = 0 := by simpa using congrFun htail (0 : Fin 3)
  have h3p : -(a : ℂ) * w 3 = 0 := by simpa using congrFun htail (1 : Fin 3)
  have h4p : (star c * (b : ℂ)) * w 4 = 0 := by
    simpa using congrFun htail (2 : Fin 3)
  have h2 : w 2 = 0 := (mul_eq_zero.mp h2p).resolve_left hc
  have h3 : w 3 = 0 := (mul_eq_zero.mp h3p).resolve_left (neg_ne_zero.mpr haC)
  have h4 : w 4 = 0 := (mul_eq_zero.mp h4p).resolve_left
    (mul_ne_zero (star_ne_zero.mpr hc) hbC)
  have hhead : (![w 0, (a : ℂ) * w 1] : Fin 2 → ℂ) = 0 := by
    apply Matrix.eq_zero_of_forall_index_sum_pow_mul_eq_zero (f := x) hx
    intro i
    calc
      _ = dotProduct (u a b (x i)) w := by
        simp [u, dotProduct, Fin.sum_univ_succ, h2, h3, h4]
        <;> ring
      _ = 0 := hU i
  have h0 : w 0 = 0 := by simpa using congrFun hhead (0 : Fin 2)
  have h1p : (a : ℂ) * w 1 = 0 := by simpa using congrFun hhead (1 : Fin 2)
  have h1 : w 1 = 0 := (mul_eq_zero.mp h1p).resolve_left haC
  funext i
  fin_cases i <;> assumption

/-- Three U nodes and two leading V nodes have no nonzero annihilator.
Nonzero nodes allow cancellation of the displayed powers z^2 and z^3. -/
theorem infinity_specialization_kernel (a b : ℝ)
    (ha : a ≠ 0) (hb : b ≠ 0)
    (x : Fin 3 → ℂ) (y : Fin 2 → ℂ)
    (hx : Function.Injective x) (hy : Function.Injective y)
    (hx0 : ∀ i, x i ≠ 0) (hy0 : ∀ i, y i ≠ 0)
    (w : Fin 5 → ℂ)
    (hU : ∀ i, dotProduct (u a b (x i)) w = 0)
    (hV : ∀ i, dotProduct (vInfinity a (y i)) w = 0) : w = 0 := by
  have haC : (a : ℂ) ≠ 0 := Complex.ofReal_ne_zero.mpr ha
  have hbC : (b : ℂ) ≠ 0 := Complex.ofReal_ne_zero.mpr hb
  have hhead : (![(a : ℂ) * w 0, -(w 1)] : Fin 2 → ℂ) = 0 := by
    apply Matrix.eq_zero_of_forall_index_sum_pow_mul_eq_zero (f := y) hy
    intro i
    have hm : y i ^ 3 * (∑ j : Fin 2,
        y i ^ j.val * (![(a : ℂ) * w 0, -(w 1)] : Fin 2 → ℂ) j) = 0 := by
      calc
        _ = dotProduct (vInfinity a (y i)) w := by
          simp [vInfinity, dotProduct, Fin.sum_univ_succ]
          <;> ring
        _ = 0 := hV i
    exact (mul_eq_zero.mp hm).resolve_left (pow_ne_zero _ (hy0 i))
  have h0p : (a : ℂ) * w 0 = 0 := by simpa using congrFun hhead (0 : Fin 2)
  have h1p : -(w 1) = 0 := by simpa using congrFun hhead (1 : Fin 2)
  have h0 : w 0 = 0 := (mul_eq_zero.mp h0p).resolve_left haC
  have h1 : w 1 = 0 := neg_eq_zero.mp h1p
  have htail : (![(b : ℂ) * w 2, (a : ℂ) * w 3, w 4] : Fin 3 → ℂ) = 0 := by
    apply Matrix.eq_zero_of_forall_index_sum_pow_mul_eq_zero (f := x) hx
    intro i
    have hm : x i ^ 2 * (∑ j : Fin 3,
        x i ^ j.val * (![(b : ℂ) * w 2, (a : ℂ) * w 3, w 4] : Fin 3 → ℂ) j) = 0 := by
      calc
        _ = dotProduct (u a b (x i)) w := by
          simp [u, dotProduct, Fin.sum_univ_succ, h0, h1]
          <;> ring
        _ = 0 := hU i
    exact (mul_eq_zero.mp hm).resolve_left (pow_ne_zero _ (hx0 i))
  have h2p : (b : ℂ) * w 2 = 0 := by simpa using congrFun htail (0 : Fin 3)
  have h3p : (a : ℂ) * w 3 = 0 := by simpa using congrFun htail (1 : Fin 3)
  have h4 : w 4 = 0 := by simpa using congrFun htail (2 : Fin 3)
  have h2 : w 2 = 0 := (mul_eq_zero.mp h2p).resolve_left hbC
  have h3 : w 3 = 0 := (mul_eq_zero.mp h3p).resolve_left haC
  funext i
  fin_cases i <;> assumption

/-- Canonical row enumeration of the two-plus-three zero specialization. -/
def zeroRows (a b : ℝ) (c : ℂ) (x : Fin 2 → ℂ) (y : Fin 3 → ℂ) :
    Matrix (Fin 5) (Fin 5) ℂ :=
  fun i => Sum.elim (fun j => u a b (x j)) (fun j => v a b c 0 (y j))
    ((finSumFinEquiv : Fin 2 ⊕ Fin 3 ≃ Fin 5).symm i)

/-- Canonical row enumeration of the three-plus-two infinity specialization. -/
def infinityRows (a b : ℝ) (x : Fin 3 → ℂ) (y : Fin 2 → ℂ) :
    Matrix (Fin 5) (Fin 5) ℂ :=
  fun i => Sum.elim (fun j => u a b (x j)) (fun j => vInfinity a (y j))
    ((finSumFinEquiv : Fin 3 ⊕ Fin 2 ≃ Fin 5).symm i)

theorem zero_specialization_det_ne_zero (a b : ℝ) (c : ℂ)
    (ha : a ≠ 0) (hb : b ≠ 0) (hc : c ≠ 0)
    (x : Fin 2 → ℂ) (y : Fin 3 → ℂ)
    (hx : Function.Injective x) (hy : Function.Injective y) :
    (zeroRows a b c x y).det ≠ 0 := by
  intro hdet
  obtain ⟨w, hw, hker⟩ := Matrix.exists_mulVec_eq_zero_iff.mpr hdet
  apply hw
  apply zero_specialization_kernel a b c ha hb hc x y hx hy w
  · intro i
    have hi := congrFun hker
      ((finSumFinEquiv : Fin 2 ⊕ Fin 3 ≃ Fin 5) (Sum.inl i))
    simpa [zeroRows, Matrix.mulVec] using hi
  · intro i
    have hi := congrFun hker
      ((finSumFinEquiv : Fin 2 ⊕ Fin 3 ≃ Fin 5) (Sum.inr i))
    simpa [zeroRows, Matrix.mulVec] using hi

theorem infinity_specialization_det_ne_zero (a b : ℝ)
    (ha : a ≠ 0) (hb : b ≠ 0)
    (x : Fin 3 → ℂ) (y : Fin 2 → ℂ)
    (hx : Function.Injective x) (hy : Function.Injective y)
    (hx0 : ∀ i, x i ≠ 0) (hy0 : ∀ i, y i ≠ 0) :
    (infinityRows a b x y).det ≠ 0 := by
  intro hdet
  obtain ⟨w, hw, hker⟩ := Matrix.exists_mulVec_eq_zero_iff.mpr hdet
  apply hw
  apply infinity_specialization_kernel a b ha hb x y hx hy hx0 hy0 w
  · intro i
    have hi := congrFun hker
      ((finSumFinEquiv : Fin 3 ⊕ Fin 2 ≃ Fin 5) (Sum.inl i))
    simpa [infinityRows, Matrix.mulVec] using hi
  · intro i
    have hi := congrFun hker
      ((finSumFinEquiv : Fin 3 ⊕ Fin 2 ≃ Fin 5) (Sum.inr i))
    simpa [infinityRows, Matrix.mulVec] using hi

theorem zero_specialization_span (a b : ℝ) (c : ℂ)
    (ha : a ≠ 0) (hb : b ≠ 0) (hc : c ≠ 0)
    (x : Fin 2 → ℂ) (y : Fin 3 → ℂ)
    (hx : Function.Injective x) (hy : Function.Injective y) :
    span ℂ (Set.range (zeroRows a b c x y)) = ⊤ :=
  (Matrix.linearIndependent_rows_of_det_ne_zero
    (zero_specialization_det_ne_zero a b c ha hb hc x y hx hy)).span_eq_top_of_card_eq_finrank
      (by simp)

theorem infinity_specialization_span (a b : ℝ)
    (ha : a ≠ 0) (hb : b ≠ 0)
    (x : Fin 3 → ℂ) (y : Fin 2 → ℂ)
    (hx : Function.Injective x) (hy : Function.Injective y)
    (hx0 : ∀ i, x i ≠ 0) (hy0 : ∀ i, y i ≠ 0) :
    span ℂ (Set.range (infinityRows a b x y)) = ⊤ :=
  (Matrix.linearIndependent_rows_of_det_ne_zero
    (infinity_specialization_det_ne_zero a b ha hb x y hx hy hx0 hy0)).span_eq_top_of_card_eq_finrank
      (by simp)

end P14FiveBlockSpecializations

end
end

section

/-! Polynomial rows and a finite-parameter witness for the actual three-U,
two-V block. The reversed polynomial row is s*v(1/s) away from zero and
specializes to the leading V row at zero. This establishes individual
nonidentity only; it makes no simultaneous-six-selection or graph claim. -/

noncomputable section
namespace P14FivePolynomialRows

open Matrix Polynomial Submodule P14FiveMonomialFamily
  P14FiveBlockSpecializations P14PolynomialSpanAvoidance
open scoped BigOperators

/-- Literal U/V rows, with one fixed sum-to-Fin enumeration. -/
def mixedRows {r s : ℕ} (a b : ℝ) (c t : ℂ)
    (x : Fin r → ℂ) (y : Fin s → ℂ) : Matrix (Fin (r + s)) (Fin 5) ℂ :=
  fun i => Sum.elim (fun j => u a b (x j)) (fun j => v a b c t (y j))
    ((finSumFinEquiv : Fin r ⊕ Fin s ≃ Fin (r + s)).symm i)

/-- Polynomial coordinates of the actual affine V row. -/
def polynomialV (a b : ℝ) (c z : ℂ) : Fin 5 → Polynomial ℂ :=
  ![C ((a : ℂ) * z ^ 3) * X, C (-(z ^ 4)) * X, C c,
    C (-((a : ℂ) * z)), C (star c * ((b : ℂ) * z ^ 2))]

theorem eval_polynomialV (a b : ℝ) (c t z : ℂ) :
    (fun j => (polynomialV a b c z j).eval t) = v a b c t z := by
  funext j
  fin_cases j <;> simp [polynomialV, v] <;> ring

/-- Actual polynomial U/V row family, with exactly the mixedRows enumeration. -/
def polynomialRows {r s : ℕ} (a b : ℝ) (c : ℂ)
    (x : Fin r → ℂ) (y : Fin s → ℂ) :
    Matrix (Fin (r + s)) (Fin 5) (Polynomial ℂ) :=
  fun i j => Sum.elim (fun q => C (u a b (x q) j))
    (fun q => polynomialV a b c (y q) j)
    ((finSumFinEquiv : Fin r ⊕ Fin s ≃ Fin (r + s)).symm i)

theorem eval_polynomialRows {r s : ℕ} (a b : ℝ) (c t : ℂ)
    (x : Fin r → ℂ) (y : Fin s → ℂ) :
    (fun i j => (polynomialRows a b c x y i j).eval t) =
      mixedRows a b c t x y := by
  apply Matrix.ext
  intro i j
  obtain ⟨q, rfl⟩ := (finSumFinEquiv : Fin r ⊕ Fin s ≃ Fin (r + s)).surjective i
  cases q with
  | inl q => simp [polynomialRows, mixedRows]
  | inr q =>
      simpa [polynomialRows, mixedRows] using congrFun (eval_polynomialV a b c t (y q)) j

/-- Reversal of the affine V row; no inverse occurs in this polynomial. -/
def reverseV (a b : ℝ) (c z : ℂ) : Fin 5 → Polynomial ℂ :=
  ![C ((a : ℂ) * z ^ 3), C (-(z ^ 4)), C c * X,
    C (-((a : ℂ) * z)) * X, C (star c * ((b : ℂ) * z ^ 2)) * X]

theorem eval_reverseV_zero (a b : ℝ) (c z : ℂ) :
    (fun j => (reverseV a b c z j).eval 0) = vInfinity a z := by
  funext j
  fin_cases j <;> simp [reverseV, vInfinity]

theorem eval_reverseV_of_ne_zero (a b : ℝ) (c s z : ℂ) (hs : s ≠ 0) :
    (fun j => (reverseV a b c z j).eval s) =
      (fun j => s * v a b c s⁻¹ z j) := by
  funext j
  fin_cases j <;> simp [reverseV, v, hs, ← mul_assoc] <;> ring

/-- Reversed three-plus-two matrix, with U rows unchanged. -/
def reverseRows (a b : ℝ) (c : ℂ) (x : Fin 3 → ℂ) (y : Fin 2 → ℂ) :
    Matrix (Fin 5) (Fin 5) (Polynomial ℂ) :=
  fun i j => Sum.elim (fun q => C (u a b (x q) j))
    (fun q => reverseV a b c (y q) j)
    ((finSumFinEquiv : Fin 3 ⊕ Fin 2 ≃ Fin 5).symm i)

theorem eval_reverseRows_zero (a b : ℝ) (c : ℂ)
    (x : Fin 3 → ℂ) (y : Fin 2 → ℂ) :
    (fun i j => (reverseRows a b c x y i j).eval 0) =
      infinityRows a b x y := by
  apply Matrix.ext
  intro i j
  obtain ⟨q, rfl⟩ := (finSumFinEquiv : Fin 3 ⊕ Fin 2 ≃ Fin 5).surjective i
  cases q with
  | inl q => simp [reverseRows, infinityRows]
  | inr q =>
      simpa [reverseRows, infinityRows] using congrFun (eval_reverseV_zero a b c (y q)) j

/-- A genuine finite, nonzero parameter makes each three-plus-two block
nonsingular. The parameter may depend on this selected block. -/
theorem exists_three_two_det_ne_zero (a b : ℝ) (c : ℂ)
    (ha : a ≠ 0) (hb : b ≠ 0)
    (x : Fin 3 → ℂ) (y : Fin 2 → ℂ)
    (hx : Function.Injective x) (hy : Function.Injective y)
    (hx0 : ∀ i, x i ≠ 0) (hy0 : ∀ i, y i ≠ 0) :
    ∃ t : ℂ, t ≠ 0 ∧ (mixedRows a b c t x y).det ≠ 0 := by
  let P : Polynomial ℂ := (reverseRows a b c x y).det
  have heval (s : ℂ) : P.eval s =
      Matrix.det (fun i j => (reverseRows a b c x y i j).eval s) := by
    change (Polynomial.evalRingHom s) (reverseRows a b c x y).det = _
    exact (Polynomial.evalRingHom s).map_det (reverseRows a b c x y)
  have hP0 : P.eval 0 ≠ 0 := by
    rw [heval, eval_reverseRows_zero]
    exact infinity_specialization_det_ne_zero a b ha hb x y hx hy hx0 hy0
  have hP : P ≠ 0 := by
    intro hzero
    exact hP0 (by rw [hzero, Polynomial.eval_zero])
  obtain ⟨s, hsunit, hsgood⟩ :=
    exists_unit_nonzero (fun _ : Unit => P) (fun _ => hP)
  have hs : s ≠ 0 := by
    intro hzero
    simp [hzero] at hsunit
  have hdet : Matrix.det (fun i j => (reverseRows a b c x y i j).eval s) ≠ 0 := by
    simpa only [heval] using hsgood ()
  refine ⟨s⁻¹, inv_ne_zero hs, ?_⟩
  intro hbad
  obtain ⟨w, hw, hker⟩ := Matrix.exists_mulVec_eq_zero_iff.mpr hbad
  apply hw
  apply Matrix.eq_zero_of_mulVec_eq_zero hdet
  funext i
  obtain ⟨q, rfl⟩ := (finSumFinEquiv : Fin 3 ⊕ Fin 2 ≃ Fin 5).surjective i
  cases q with
  | inl q =>
      have hi := congrFun hker
        ((finSumFinEquiv : Fin 3 ⊕ Fin 2 ≃ Fin 5) (Sum.inl q))
      simpa [Matrix.mulVec, reverseRows, mixedRows] using hi
  | inr q =>
      have hi : dotProduct (v a b c s⁻¹ (y q)) w = 0 := by
        simpa [Matrix.mulVec, mixedRows] using congrFun hker
          ((finSumFinEquiv : Fin 3 ⊕ Fin 2 ≃ Fin 5) (Sum.inr q))
      have hrev : dotProduct (fun j => (reverseV a b c (y q) j).eval s) w = 0 := by
        rw [eval_reverseV_of_ne_zero a b c s (y q) hs]
        calc
          _ = s * dotProduct (v a b c s⁻¹ (y q)) w := by
            simp only [dotProduct, Finset.mul_sum, mul_assoc]
          _ = 0 := by rw [hi, mul_zero]
      simpa [Matrix.mulVec, reverseRows] using hrev

theorem exists_three_two_span (a b : ℝ) (c : ℂ)
    (ha : a ≠ 0) (hb : b ≠ 0)
    (x : Fin 3 → ℂ) (y : Fin 2 → ℂ)
    (hx : Function.Injective x) (hy : Function.Injective y)
    (hx0 : ∀ i, x i ≠ 0) (hy0 : ∀ i, y i ≠ 0) :
    ∃ t : ℂ, t ≠ 0 ∧ span ℂ (Set.range (mixedRows a b c t x y)) = ⊤ := by
  obtain ⟨t, ht, hdet⟩ := exists_three_two_det_ne_zero a b c ha hb x y hx hy hx0 hy0
  refine ⟨t, ht, ?_⟩
  exact (Matrix.linearIndependent_rows_of_det_ne_zero hdet).span_eq_top_of_card_eq_finrank
    (by simp)

/-- The two-plus-three actual block already has the finite witness t=0. -/
theorem exists_two_three_det_ne_zero (a b : ℝ) (c : ℂ)
    (ha : a ≠ 0) (hb : b ≠ 0) (hc : c ≠ 0)
    (x : Fin 2 → ℂ) (y : Fin 3 → ℂ)
    (hx : Function.Injective x) (hy : Function.Injective y) :
    ∃ t : ℂ, (mixedRows a b c t x y).det ≠ 0 := by
  exact ⟨0, zero_specialization_det_ne_zero a b c ha hb hc x y hx hy⟩

end P14FivePolynomialRows

end
end

section

/-! One unit-modulus parameter makes every six-label selection of the actual
U/V family span dimension five. Individual witnesses come from the checked
pure and mixed five-row blocks. Node labels may occur in both layers; only
injectivity within the common node map and nonzero nodes are assumed.
There is no spanning or simultaneous-parameter premise in the final theorem. -/

noncomputable section
namespace P14FiveSixSelections

open Submodule Polynomial P14FiveFamilies P14FiveMonomialFamily
  P14FivePolynomialRows P14FivePureLayerSpanning P14FiveBlockSpecializations
  P14PolynomialSpanAvoidance

/-- The literal polynomial coordinates of the shared U/V labeling. -/
def polynomialFamily {ι : Type*} (a b : ℝ) (c : ℂ) (z : ι → ℂ) :
    (ι ⊕ ι) → Fin 5 → Polynomial ℂ :=
  Sum.elim (fun i j => C (u a b (z i) j)) (fun i => polynomialV a b c (z i))

theorem eval_polynomialFamily {ι : Type*} (a b : ℝ) (c t : ℂ) (z : ι → ℂ) :
    (fun x j => (polynomialFamily a b c z x j).eval t) = family a b c t z := by
  funext x
  cases x with
  | inl i =>
      funext j
      simp [polynomialFamily, family]
  | inr i => exact eval_polynomialV a b c t (z i)

/-- Coordinate-first convention required by PolynomialSpanAvoidance.
Its column index is the exact selected physical-label subtype. -/
def selectionPolynomial {q : ℕ} (a b : ℝ) (c : ℂ) (z : Fin q → ℂ)
    (S : Finset (Fin q ⊕ Fin q)) : Fin 5 → S → Polynomial ℂ :=
  fun j x => polynomialFamily a b c z x.val j

theorem columnsAt_selectionPolynomial {q : ℕ} (a b : ℝ) (c t : ℂ)
    (z : Fin q → ℂ) (S : Finset (Fin q ⊕ Fin q)) :
    columnsAt (selectionPolynomial a b c z S) t =
      (fun x : S => family a b c t z x.val) := by
  funext x j
  change (polynomialFamily a b c z x.val j).eval t = family a b c t z x.val j
  exact congrFun (congrFun (eval_polynomialFamily a b c t z) x.val) j

private theorem choose_nodes {ι : Type*} [DecidableEq ι]
    (T : Finset ι) (k : ℕ) (hk : k ≤ T.card) :
    ∃ f : Fin k → ι, Function.Injective f ∧ ∀ i, f i ∈ T := by
  classical
  obtain ⟨A, hAT, hA⟩ := Finset.exists_subset_card_eq hk
  let e : Fin k ≃ A := (Finset.equivFinOfCardEq hA).symm
  refine ⟨fun i => (e i).val, Subtype.val_injective.comp e.injective, ?_⟩
  intro i
  exact hAT (e i).property

private theorem selection_span_of_range {ι κ : Type*}
    (f : ι → Fin 5 → ℂ) (S : Finset ι) (g : κ → Fin 5 → ℂ)
    (hspan : span ℂ (Set.range g) = ⊤)
    (hmem : ∀ i, ∃ x ∈ S, g i = f x) :
    span ℂ (Set.range (fun x : S => f x.val)) = ⊤ := by
  apply top_unique
  rw [← hspan]
  apply span_mono
  rintro _ ⟨i, rfl⟩
  obtain ⟨x, hx, hxeq⟩ := hmem i
  exact ⟨⟨x, hx⟩, hxeq.symm⟩

private theorem selection_span_of_mixed {q r s : ℕ}
    (a b : ℝ) (c t : ℂ) (z : Fin q → ℂ) (S : Finset (Fin q ⊕ Fin q))
    (x : Fin r → Fin q) (y : Fin s → Fin q)
    (hx : ∀ i, x i ∈ S.toLeft) (hy : ∀ i, y i ∈ S.toRight)
    (hspan : span ℂ (Set.range (mixedRows a b c t (z ∘ x) (z ∘ y))) = ⊤) :
    span ℂ (Set.range (fun v : S => family a b c t z v.val)) = ⊤ := by
  apply selection_span_of_range (family a b c t z) S
    (mixedRows a b c t (z ∘ x) (z ∘ y)) hspan
  intro i
  obtain ⟨v, rfl⟩ :=
    (finSumFinEquiv : Fin r ⊕ Fin s ≃ Fin (r + s)).surjective i
  cases v with
  | inl i =>
      refine ⟨Sum.inl (x i), Finset.mem_toLeft.mp (hx i), ?_⟩
      simp [mixedRows, family]
  | inr i =>
      refine ⟨Sum.inr (y i), Finset.mem_toRight.mp (hy i), ?_⟩
      simp [mixedRows, family]

/-- Every exact six-label selection has an actual finite spanning parameter.
The witness may depend on the selection; it need not have unit modulus. -/
theorem exists_six_span {q : ℕ} (a b : ℝ) (c : ℂ)
    (ha : a ≠ 0) (hb : b ≠ 0) (hc : c ≠ 0)
    (z : Fin q → ℂ) (hz : Function.Injective z) (hz0 : ∀ i, z i ≠ 0)
    (S : Finset (Fin q ⊕ Fin q)) (hS : S.card = 6) :
    ∃ t : ℂ, span ℂ (Set.range (fun x : S => family a b c t z x.val)) = ⊤ := by
  classical
  have hcard : S.toLeft.card + S.toRight.card = 6 :=
    (Finset.card_toLeft_add_card_toRight (u := S)).trans hS
  by_cases hU : 5 ≤ S.toLeft.card
  · obtain ⟨x, hx, hxS⟩ := choose_nodes S.toLeft 5 hU
    refine ⟨1, selection_span_of_range (family a b c 1 z) S
      (fun i => u a b (z (x i))) (u_span a b ha hb (z ∘ x) (hz.comp hx)) ?_⟩
    intro i
    exact ⟨Sum.inl (x i), Finset.mem_toLeft.mp (hxS i), rfl⟩
  by_cases hV : 5 ≤ S.toRight.card
  · obtain ⟨y, hy, hyS⟩ := choose_nodes S.toRight 5 hV
    refine ⟨1, selection_span_of_range (family a b c 1 z) S
      (fun i => v a b c 1 (z (y i)))
      (v_span a b c 1 ha hb hc one_ne_zero (z ∘ y) (hz.comp hy)) ?_⟩
    intro i
    exact ⟨Sum.inr (y i), Finset.mem_toRight.mp (hyS i), rfl⟩
  by_cases hU3 : S.toLeft.card ≤ 3
  · have htwo : 2 ≤ S.toLeft.card := by omega
    have hthree : 3 ≤ S.toRight.card := by omega
    obtain ⟨x, hx, hxS⟩ := choose_nodes S.toLeft 2 htwo
    obtain ⟨y, hy, hyS⟩ := choose_nodes S.toRight 3 hthree
    have hspan : span ℂ (Set.range (mixedRows a b c 0 (z ∘ x) (z ∘ y))) = ⊤ :=
      zero_specialization_span a b c ha hb hc (z ∘ x) (z ∘ y) (hz.comp hx) (hz.comp hy)
    exact ⟨0, selection_span_of_mixed a b c 0 z S x y hxS hyS hspan⟩
  · have hthree : 3 ≤ S.toLeft.card := by omega
    have htwo : 2 ≤ S.toRight.card := by omega
    obtain ⟨x, hx, hxS⟩ := choose_nodes S.toLeft 3 hthree
    obtain ⟨y, hy, hyS⟩ := choose_nodes S.toRight 2 htwo
    obtain ⟨t, _, hspan⟩ := exists_three_two_span a b c ha hb (z ∘ x) (z ∘ y)
      (hz.comp hx) (hz.comp hy) (fun i => hz0 (x i)) (fun i => hz0 (y i))
    exact ⟨t, selection_span_of_mixed a b c t z S x y hxS hyS hspan⟩

/-- ONE unit-modulus parameter works for EVERY six-label selection of the
same actual U/V family. All individual nonidentity premises are discharged. -/
theorem exists_unit_six_span {q : ℕ} (a b : ℝ) (c : ℂ)
    (ha : a ≠ 0) (hb : b ≠ 0) (hc : c ≠ 0)
    (z : Fin q → ℂ) (hz : Function.Injective z) (hz0 : ∀ i, z i ≠ 0) :
    ∃ t : ℂ, ‖t‖ = 1 ∧ ∀ S : Finset (Fin q ⊕ Fin q), S.card = 6 →
      span ℂ (Set.range (fun x : S => family a b c t z x.val)) = ⊤ := by
  classical
  let T := {S : Finset (Fin q ⊕ Fin q) // S.card = 6}
  let P : (S : T) → Fin 5 → S.val → Polynomial ℂ :=
    fun S => selectionPolynomial a b c z S.val
  have hwitness : ∀ S : T, ∃ t : ℂ,
      span ℂ (Set.range (columnsAt (P S) t)) = ⊤ := by
    intro S
    obtain ⟨t, ht⟩ := exists_six_span a b c ha hb hc z hz hz0 S.val S.property
    refine ⟨t, ?_⟩
    simpa only [P, columnsAt_selectionPolynomial] using ht
  obtain ⟨t, ht, hgood⟩ := exists_unit_span P hwitness
  refine ⟨t, ht, ?_⟩
  intro S hS
  have h := hgood ⟨S, hS⟩
  simpa only [P, columnsAt_selectionPolynomial] using h

end P14FiveSixSelections

end
end

section

/-! The exceptional dimension-five factor and its actual qubit complement.
One unit parameter supplies every six-row span and all prescribed pairings
of the same factor. The full ordered-pair cover has no residual premise. -/

noncomputable section
namespace P14FiveExceptionalUPB

open P14ComplexLocalCover P14FivePositiveWeights P14FivePrescribedPairings
open scoped BigOperators

/-- A single actual five-dimensional family realizes its prescribed graph
and spans on every six-label selection. -/
theorem exists_local_factor {q : ℕ} (hq : 7 ≤ q) (ho : Odd q) :
    HasLocalFactor (Fin q ⊕ Fin q) 5 5 (Prescribed hq) := by
  have hw := weights_and_phase hq
  have hc : unitPhase q ≠ 0 := by
    intro hc
    have hu := hw.2.2.1
    simp [hc] at hu
  have hn : 0 < q := by omega
  obtain ⟨t, ht, hspan⟩ := P14FiveSixSelections.exists_unit_six_span
    (weightA q) (weightB q) (unitPhase q) (ne_of_gt hw.1)
    (ne_of_gt hw.2.1) hc (rootNode q) (rootNode_injective hn)
    (rootNode_ne_zero hn)
  refine ⟨fixedFamily q t, fixedFamily_nonzero hq t, ?_, ?_⟩
  · intro S hS
    exact hspan S hS
  · intro i j hij
    exact prescribed_pairing_of_norm hq ho t ht i j hij

/-- Dimension five, followed by exactly `2*q-6` qubit factors. -/
def dimensions (q : ℕ) : Fin ((2 * q - 6) + 1) → ℕ :=
  Fin.cons 5 (fun _ : Fin (2 * q - 6) => 2)

def caps (q : ℕ) : Fin ((2 * q - 6) + 1) → ℕ :=
  Fin.cons 5 (fun _ : Fin (2 * q - 6) => 1)

theorem sum_caps (q : ℕ) : (∑ j, caps q j) = 5 + (2 * q - 6) := by
  simp [caps, Fin.sum_univ_succ]

theorem sum_dimensions_sub_one (q : ℕ) :
    (∑ j, (dimensions q j - 1)) = 4 + (2 * q - 6) := by
  simp [dimensions, Fin.sum_univ_succ]

theorem ceiling {q : ℕ} (hq : 7 ≤ q) :
    2 + ∑ j, (dimensions q j - 1) = 2 * q := by
  rw [sum_dimensions_sub_one]
  omega

/-- Literal canonical complex-coordinate conclusion for the exceptional
tuple. Local test vectors are arbitrary nonzero complex vectors. -/
theorem canonical {q : ℕ} (hq : 7 ≤ q) (ho : Odd q) :
    ∃ m : ℕ, m ≤ 2 + ∑ j, (dimensions q j - 1) ∧
      ∃ v : Fin m → (j : Fin ((2 * q - 6) + 1)) → Fin (dimensions q j) → ℂ,
        (∀ i j, v i j ≠ 0) ∧
        (∀ i i', i ≠ i' →
          ∃ j, (∑ r, star (v i j r) * v i' j r) = 0) ∧
        (∀ a : (j : Fin ((2 * q - 6) + 1)) → Fin (dimensions q j) → ℂ,
          (∀ j, a j ≠ 0) → ∃ i, ∀ j, (∑ r, star (v i j r) * a j r) ≠ 0) := by
  classical
  obtain ⟨F, hF, hfix, hcover⟩ :=
    P14FiveComplementCover.exists_complement_matchings hq ho
  let R : Fin ((2 * q - 6) + 1) → (Fin q ⊕ Fin q) →
      (Fin q ⊕ Fin q) → Prop :=
    Fin.cons (Prescribed hq) (fun c i j => F c i = j)
  have hlocal : ∀ j, HasLocalFactor (Fin q ⊕ Fin q)
      (dimensions q j) (caps q j) (R j) := by
    intro j
    refine Fin.cases ?_ (fun c => ?_) j
    · exact exists_local_factor hq ho
    · exact P14MatchingLocalFactor.on_finite (F c) (hF c) (hfix c)
  have hcomplete : ∀ i i' : Fin q ⊕ Fin q, i ≠ i' → ∃ j, R j i i' := by
    intro i i' hii'
    rcases hcover i i' hii' with h | ⟨c, hc⟩
    · exact ⟨0, h⟩
    · exact ⟨c.succ, hc⟩
  have hcard : Fintype.card (Fin q ⊕ Fin q) = 2 * q := by simp [two_mul]
  have hbudget : (∑ j, caps q j) < Fintype.card (Fin q ⊕ Fin q) := by
    rw [sum_caps, hcard]
    omega
  have hbound : Fintype.card (Fin q ⊕ Fin q) ≤
      2 + ∑ j, (dimensions q j - 1) := by
    rw [hcard, ceiling hq]
  exact P14ComplexLocalCover.canonical (dimensions q) (caps q) R
    hlocal hcomplete hbudget hbound

end P14FiveExceptionalUPB

end
end

section

/-! Actual canonical complex UPB with a dimension-five factor and arbitrary other non-qubit dimensions at least three, plus qubits. -/

noncomputable section
namespace P14FiveFlexibleUPB
open P14ComplexLocalCover P14FivePrescribedPairings P14OddLayerLabels
open scoped BigOperators

def dimensions {p : ℕ} (r : Fin p → ℕ) (m : ℕ) : Fin (p + m + 1) → ℕ :=
  Fin.cons 5 (Fin.append (fun i => r i + 1) (fun _ : Fin m => 2))

def caps {p : ℕ} (r : Fin p → ℕ) (m : ℕ) : Fin (p + m + 1) → ℕ :=
  Fin.cons 5 (Fin.append r (fun _ : Fin m => 1))

theorem sum_caps {p : ℕ} (r : Fin p → ℕ) (m : ℕ) :
    (∑ j, caps r m j) = 5 + (∑ i, r i) + m := by
  simp [caps, Fin.sum_univ_succ, Fin.sum_univ_add, Nat.add_assoc]

theorem sum_deficits {p : ℕ} (r : Fin p → ℕ) (m : ℕ) :
    (∑ j, (dimensions r m j - 1)) = 4 + (∑ i, r i) + m := by
  simp [dimensions, Fin.sum_univ_succ, Fin.sum_univ_add, Nat.add_assoc]

theorem canonical {q p m : ℕ} [NeZero q] (hq : 7 ≤ q) (ho : Odd q)
    (r : Fin p → ℕ) (hr : ∀ i, 2 ≤ r i)
    (htotal : (∑ i, r i) + m = 2 * q - 6) :
    P14CanonicalUPBTransport.Conclusion (p + m + 1) (dimensions r m) := by
  classical
  obtain ⟨H, F, hH, hF, hFne, hcover⟩ :=
    P14FiveFlexibleGraphCover.construct hq ho r hr htotal
  let R : Fin (p + m + 1) → (Fin q ⊕ Fin q) → (Fin q ⊕ Fin q) → Prop :=
    Fin.cons (Prescribed hq) (Fin.append
      (fun i u v => H i (encode u) (encode v)) (fun c u v => F c u = v))
  have hord : ∀ i, HasLocalFactor (Fin q ⊕ Fin q) (r i + 1) (r i)
      (fun u v => H i (encode u) (encode v)) := by
    intro i
    obtain ⟨x, hnz, hpair, hspan⟩ :=
      P14GenericExceptionalUPB.complex_rows (H i) (hH i).1 (hH i).2.1
        (r i + 1) (2 * q) (by omega) (hH i).2.2
    have hx : HasLocalFactor (Fin (2 * q)) (r i + 1) (r i)
        (fun u v => H i u.val v.val) := ⟨x, hnz, hspan, hpair⟩
    exact reindex (rowEquiv q) hx
  have hlocal : ∀ j, HasLocalFactor (Fin q ⊕ Fin q)
      (dimensions r m j) (caps r m j) (R j) := by
    intro j
    refine Fin.cases ?_ (fun c => ?_) j
    · exact P14FiveExceptionalUPB.exists_local_factor hq ho
    · refine Fin.addCases (fun i => ?_) (fun c => ?_) c
      · simpa only [dimensions, caps, R, Fin.cons_succ, Fin.append_left] using hord i
      · simpa only [dimensions, caps, R, Fin.cons_succ, Fin.append_right] using
          P14MatchingLocalFactor.on_finite (F c) (hF c) (hFne c)
  have hcomplete : ∀ u v : Fin q ⊕ Fin q, u ≠ v → ∃ j, R j u v := by
    intro u v huv
    rcases hcover u v huv with he | ⟨i, hi⟩ | ⟨c, hc⟩
    · exact ⟨0, he⟩
    · refine ⟨(Fin.castAdd m i).succ, ?_⟩
      simpa only [R, Fin.cons_succ, Fin.append_left] using hi
    · refine ⟨(Fin.natAdd p c).succ, ?_⟩
      simpa only [R, Fin.cons_succ, Fin.append_right] using hc
  have hcard : Fintype.card (Fin q ⊕ Fin q) = 2 * q := by simp [two_mul]
  have hbudget : (∑ j, caps r m j) < Fintype.card (Fin q ⊕ Fin q) := by
    rw [sum_caps, hcard]
    omega
  have hbound : Fintype.card (Fin q ⊕ Fin q) ≤
      2 + ∑ j, (dimensions r m j - 1) := by
    rw [sum_deficits, hcard]
    omega
  exact P14ComplexLocalCover.canonical (dimensions r m) (caps r m) R
    hlocal hcomplete hbudget hbound

/-- Factor order is arbitrary, provided its displayed dimensions agree. -/
theorem of_dimensions {q p m n : ℕ} [NeZero q] (hq : 7 ≤ q) (ho : Odd q)
    (r : Fin p → ℕ) (hr : ∀ i, 2 ≤ r i)
    (htotal : (∑ i, r i) + m = 2 * q - 6)
    (d : Fin n → ℕ) (e : Fin n ≃ Fin (p + m + 1))
    (he : ∀ j, d j = dimensions r m (e j)) :
    P14CanonicalUPBTransport.Conclusion n d :=
  P14CanonicalUPBTransport.of_dimensions (dimensions r m) d e he
    (canonical hq ho r hr htotal)

end P14FiveFlexibleUPB

end
end

section

/-! Include the balanced dimension-five partner by a checked factor swap
of the existing flexible dimension-five UPB. The final theorem has no
exceptional partner-size exclusion. -/

noncomputable section
namespace P14UnifiedPartnerUPB
open P14LargePartnerUPB P14CanonicalUPBTransport
open scoped BigOperators

theorem swap_heads {n : ℕ} (a b : ℕ) (d : Fin n → ℕ)
    (h : Conclusion (n + 2) (Fin.cons b (Fin.cons a d))) :
    Conclusion (n + 2) (Fin.cons a (Fin.cons b d)) := by
  have hr := reindex (Fin.cons b (Fin.cons a d)) (Equiv.swap 0 1) h
  have he : (fun j : Fin (n + 2) => (Fin.cons b (Fin.cons a d) : Fin (n + 2) → ℕ) (Equiv.swap 0 1 j)) =
      Fin.cons a (Fin.cons b d) := by
    funext j
    refine Fin.cases ?_ (fun j => ?_) j
    · simp
    · refine Fin.cases ?_ (fun i => ?_) j
      · simp
      · rw [Equiv.swap_apply_of_ne_of_ne (Fin.succ_ne_zero _)
          (Fin.succ_succ_ne_one _)]
        rfl
  rwa [he] at hr

theorem five {q p m : ℕ} [NeZero q] (hq : 7 ≤ q) (ho : Odd q)
    (r : Fin p → ℕ) (hr : ∀ i, 2 ≤ r i)
    (htotal : (∑ i, r i) + m + 2 = 2 * q - 6) :
    Conclusion (p + m + 2) (dimensions r m 2) := by
  let s : Fin (p + 1) → ℕ := Fin.cons 2 r
  have hs : ∀ i, 2 ≤ s i := by
    intro i
    exact Fin.cases (by rfl) hr i
  have ht : (∑ i, s i) + m = 2 * q - 6 := by
    simp only [s, Fin.sum_univ_succ, Fin.cons_zero, Fin.cons_succ]
    omega
  have h := P14FiveFlexibleUPB.canonical hq ho s hs ht
  let D : Fin (p + m + 2) → ℕ :=
    Fin.cons 5 (Fin.cons 3 (Fin.append (fun i => r i + 1) (fun _ : Fin m => 2)))
  let e : Fin (p + m + 2) ≃ Fin ((p + 1) + m + 1) := finCongr (by omega)
  have hd : ∀ j, D j = P14FiveFlexibleUPB.dimensions s m (e j) := by
    intro j
    refine Fin.cases ?_ (fun j => ?_) j
    · rfl
    · change (Fin.cons 3 (Fin.append (fun i => r i + 1) (fun _ : Fin m => 2)) : Fin (p + m + 1) → ℕ) j =
        Fin.append (fun i => s i + 1) (fun _ : Fin m => 2)
          (Fin.cast (by omega) j)
      have he : (fun i => s i + 1) = Fin.cons 3 (fun i => r i + 1) := by
        funext i
        exact Fin.cases rfl (fun _ => rfl) i
      rw [he, Fin.append_cons]
      rfl
  have hD : Conclusion (p + m + 2) D :=
    P14CanonicalUPBTransport.of_dimensions _ D e hd h
  exact swap_heads 3 5 _ hD

theorem canonical {q p m k : ℕ} [NeZero q] (hq : 7 ≤ q) (ho : Odd q)
    (r : Fin p → ℕ) (hr : ∀ i, 2 ≤ r i)
    (htotal : (∑ i, r i) + m + k = 2 * q - 6)
    (hroom : 2 * k ≤ q + 3 ∨ ∃ i, k + 2 ≤ r i) :
    Conclusion (p + m + 2) (dimensions r m k) := by
  by_cases hk : k = 2
  · subst k
    exact five hq ho r hr htotal
  · exact P14AllPartnerUPB.canonical hq ho hk r hr htotal hroom

theorem of_dimensions {q p m n k : ℕ} [NeZero q] (hq : 7 ≤ q) (ho : Odd q)
    (r : Fin p → ℕ) (hr : ∀ i, 2 ≤ r i)
    (htotal : (∑ i, r i) + m + k = 2 * q - 6)
    (hroom : 2 * k ≤ q + 3 ∨ ∃ i, k + 2 ≤ r i)
    (d : Fin n → ℕ) (e : Fin n ≃ Fin (p + m + 2))
    (he : ∀ j, d j = dimensions r m k (e j)) : Conclusion n d :=
  P14CanonicalUPBTransport.of_dimensions (dimensions r m k) d e he
    (canonical hq ho r hr htotal hroom)

end P14UnifiedPartnerUPB

end
end

section

/-! Literal canonical complex UPBs from the complete ququart partner
cover. The exceptional factor spans on every five rows for every odd
q>=7; all other factors use the proved biclique or matching construction. -/
noncomputable section
namespace P14QuquartPartnerUPB
open P14ComplexLocalCover P14OddLayerLabels P14CanonicalUPBTransport
open scoped BigOperators

def dimensions {p : ℕ} (r : Fin p → ℕ) (m k : ℕ) : Fin (p + m + 2) → ℕ :=
  Fin.cons 4 (Fin.cons (k + 3) (Fin.append (fun i => r i + 1) (fun _ : Fin m => 2)))

def caps {p : ℕ} (r : Fin p → ℕ) (m k : ℕ) : Fin (p + m + 2) → ℕ :=
  Fin.cons 4 (Fin.cons (k + 2) (Fin.append r (fun _ : Fin m => 1)))

theorem sum_caps {p : ℕ} (r : Fin p → ℕ) (m k : ℕ) :
    (∑ j, caps r m k j) = (k + 6) + (∑ i, r i) + m := by
  simp [caps, Fin.sum_univ_succ, Fin.sum_univ_add, ← Nat.add_assoc] <;> omega

theorem sum_deficits {p : ℕ} (r : Fin p → ℕ) (m k : ℕ) :
    (∑ j, (dimensions r m k j - 1)) = (k + 5) + (∑ i, r i) + m := by
  simp [dimensions, Fin.sum_univ_succ, Fin.sum_univ_add, ← Nat.add_assoc] <;> omega


theorem exceptional {q : ℕ} [NeZero q] (hq : 7 ≤ q) (ho : Odd q) :
    HasLocalFactor (Fin q ⊕ Fin q) 4 4 (P14QuquartGraphCover.E hq) := by
  by_cases h7 : q = 7
  · subst q
    exact P14QuquartGridUPB.exists_local_factor hq ho
      P14QuquartSevenTrig.rho_bounds.1 P14QuquartSevenTrig.rho_bounds.2
      P14QuquartSevenUPB.triple_norm_ne
  · by_cases h9 : q = 9
    · subst q
      exact P14QuquartGridUPB.exists_local_factor hq ho
        P14QuquartNineBounds.rho_nine_bounds.1 P14QuquartNineBounds.rho_nine_bounds.2
        P14QuquartNineBounds.triple_norm_ne
    · have h11 : 11 ≤ q := by obtain ⟨a, ha⟩ := ho; omega
      exact P14QuquartExceptionalUPB.exists_local_factor h11 ho

theorem canonical_nonfive {q p m k : ℕ} [NeZero q] (hq : 7 ≤ q) (ho : Odd q)
    (hk : k ≠ 2)
    (r : Fin p → ℕ) (hr : ∀ i, 2 ≤ r i)
    (htotal : (∑ i, r i) + m + k = 2 * q - 7)
    (hroom : 2 * k ≤ q + 1 ∨ ∃ i, k + 2 ≤ r i) :
    Conclusion (p + m + 2) (dimensions r m k) := by
  classical
  have hkq := (P14QuquartPartnerAllocation.room_bounds Finset.univ r q m k hq ho
    (fun i _ => hr i) htotal (by
      rcases hroom with h | ⟨i, hi⟩
      · exact Or.inl h
      · exact Or.inr ⟨i, Finset.mem_univ i, hi⟩)).1
  obtain ⟨H, F, hH, hF, hFne, hcover⟩ :=
    P14QuquartPartnerGraphCover.construct hq ho r hr htotal hroom
  let R : Fin (p + m + 2) → (Fin q ⊕ Fin q) → (Fin q ⊕ Fin q) → Prop :=
    Fin.cons (P14QuquartGraphCover.E hq)
      (Fin.cons (fun u v => P14QuquartPartnerAbsorb.H q k (encode u) (encode v))
        (Fin.append (fun i u v => H i (encode u) (encode v)) (fun c u v => F c u = v)))
  have habs : HasLocalFactor (Fin q ⊕ Fin q) (k + 3) (k + 2) (R 1) := by
    obtain ⟨x, hnz, hpair, hspan⟩ := P14GenericExceptionalUPB.complex_rows
      (P14QuquartPartnerAbsorb.H q k) (P14QuquartPartnerAbsorb.symmetric k)
      (P14QuquartPartnerAbsorb.irreflexive hq ho k) (k + 3) (2 * q) (by omega)
      (P14QuquartPartnerAbsorb.bound hq ho k hk (by omega))
    have hx : HasLocalFactor (Fin (2 * q)) (k + 3) (k + 2)
        (fun u v => P14QuquartPartnerAbsorb.H q k u.val v.val) := ⟨x, hnz, hspan, hpair⟩
    exact P14ComplexLocalCover.reindex (rowEquiv q) hx
  have hord : ∀ i, HasLocalFactor (Fin q ⊕ Fin q) (r i + 1) (r i)
      (fun u v => H i (encode u) (encode v)) := by
    intro i
    obtain ⟨x, hnz, hpair, hspan⟩ := P14GenericExceptionalUPB.complex_rows
      (H i) (hH i).1 (hH i).2.1 (r i + 1) (2 * q) (by omega) (hH i).2.2
    have hx : HasLocalFactor (Fin (2 * q)) (r i + 1) (r i)
        (fun u v => H i u.val v.val) := ⟨x, hnz, hspan, hpair⟩
    exact P14ComplexLocalCover.reindex (rowEquiv q) hx
  have hlocal : ∀ j, HasLocalFactor (Fin q ⊕ Fin q)
      (dimensions r m k j) (caps r m k j) (R j) := by
    intro j
    refine Fin.cases (exceptional hq ho) (fun j => ?_) j
    refine Fin.cases habs (fun j => ?_) j
    refine Fin.addCases (fun i => ?_) (fun c => ?_) j
    · simpa only [dimensions, caps, R, Fin.cons_succ, Fin.append_left] using hord i
    · simpa only [dimensions, caps, R, Fin.cons_succ, Fin.append_right] using
        P14MatchingLocalFactor.on_finite (F c) (hF c) (hFne c)
  have hcomplete : ∀ u v, u ≠ v → ∃ j, R j u v := by
    intro u v huv
    rcases hcover u v huv with he | ha | ⟨i, hi⟩ | ⟨c, hc⟩
    · exact ⟨0, he⟩
    · exact ⟨1, ha⟩
    · exact ⟨(Fin.castAdd m i).succ.succ,
        by simpa only [R, Fin.cons_succ, Fin.append_left] using hi⟩
    · exact ⟨(Fin.natAdd p c).succ.succ,
        by simpa only [R, Fin.cons_succ, Fin.append_right] using hc⟩
  have hcard : Fintype.card (Fin q ⊕ Fin q) = 2 * q := by simp [two_mul]
  apply P14ComplexLocalCover.canonical (dimensions r m k) (caps r m k) R hlocal hcomplete
  · rw [sum_caps, hcard]
    omega
  · rw [sum_deficits, hcard]
    omega

theorem five {q p m : ℕ} [NeZero q] (hq : 7 ≤ q) (ho : Odd q)
    (r : Fin p → ℕ) (hr : ∀ i, 2 ≤ r i)
    (htotal : (∑ i, r i) + m + 2 = 2 * q - 7) :
    Conclusion (p + m + 2) (dimensions r m 2) := by
  let s : Fin (p + 1) → ℕ := Fin.cons 3 r
  have hs : ∀ i, 2 ≤ s i := by
    intro i
    exact Fin.cases (by change 2 ≤ 3; omega) hr i
  have ht : (∑ i, s i) + m = 2 * q - 6 := by
    simp only [s, Fin.sum_univ_succ, Fin.cons_zero, Fin.cons_succ]
    omega
  have h := P14FiveFlexibleUPB.canonical hq ho s hs ht
  let D : Fin (p + m + 2) → ℕ :=
    Fin.cons 5 (Fin.cons 4 (Fin.append (fun i => r i + 1) (fun _ : Fin m => 2)))
  let e : Fin (p + m + 2) ≃ Fin ((p + 1) + m + 1) := finCongr (by omega)
  have hd : ∀ j, D j = P14FiveFlexibleUPB.dimensions s m (e j) := by
    intro j
    refine Fin.cases ?_ (fun j => ?_) j
    · rfl
    · change (Fin.cons 4 (Fin.append (fun i => r i + 1) (fun _ : Fin m => 2)) : Fin (p + m + 1) → ℕ) j =
        Fin.append (fun i => s i + 1) (fun _ : Fin m => 2)
          (Fin.cast (by omega) j)
      have he : (fun i => s i + 1) = Fin.cons 4 (fun i => r i + 1) := by
        funext i
        exact Fin.cases rfl (fun _ => rfl) i
      rw [he, Fin.append_cons]
      rfl
  have hD : Conclusion (p + m + 2) D :=
    P14CanonicalUPBTransport.of_dimensions _ D e hd h
  exact P14UnifiedPartnerUPB.swap_heads 4 5 _ hD


theorem canonical {q p m k : ℕ} [NeZero q] (hq : 7 ≤ q) (ho : Odd q)
    (r : Fin p → ℕ) (hr : ∀ i, 2 ≤ r i)
    (htotal : (∑ i, r i) + m + k = 2 * q - 7)
    (hroom : 2 * k ≤ q + 1 ∨ ∃ i, k + 2 ≤ r i) :
    Conclusion (p + m + 2) (dimensions r m k) := by
  by_cases hk : k = 2
  · subst k
    exact five hq ho r hr htotal
  · exact canonical_nonfive hq ho hk r hr htotal hroom

theorem of_dimensions {q p m n k : ℕ} [NeZero q] (hq : 7 ≤ q) (ho : Odd q)
    (r : Fin p → ℕ) (hr : ∀ i, 2 ≤ r i)
    (htotal : (∑ i, r i) + m + k = 2 * q - 7)
    (hroom : 2 * k ≤ q + 1 ∨ ∃ i, k + 2 ≤ r i)
    (d : Fin n → ℕ) (e : Fin n ≃ Fin (p + m + 2))
    (he : ∀ j, d j = dimensions r m k (e j)) : Conclusion n d :=
  P14CanonicalUPBTransport.of_dimensions (dimensions r m k) d e he
    (canonical hq ho r hr htotal hroom)

end P14QuquartPartnerUPB
end
end

section

/-! Actual canonical UPBs for a ququart, a dominant partner and at least
two qubits. All local vectors, nonzero conditions, orthogonality, spanning
and the canonical size bound are discharged by checked constructions. -/
noncomputable section
namespace P14QuquartDenseUPB
open P14ComplexLocalCover P14OddLayerLabels P14CanonicalUPBTransport
open scoped BigOperators

def dimensions (D m : ℕ) : Fin (m + 2) → ℕ :=
  Fin.cons 4 (Fin.cons D (fun _ : Fin m => 2))

def caps (D m : ℕ) : Fin (m + 2) → ℕ :=
  Fin.cons 4 (Fin.cons (D - 1) (fun _ : Fin m => 1))

theorem sum_caps (D m : ℕ) : (∑ j, caps D m j) = 4 + (D - 1) + m := by
  simp [caps, Fin.sum_univ_succ, Nat.add_assoc]

theorem sum_deficits (D m : ℕ) :
    (∑ j, (dimensions D m j - 1)) = 3 + (D - 1) + m := by
  simp [dimensions, Fin.sum_univ_succ, Nat.add_assoc]

theorem canonical {q D m : ℕ} [NeZero q] (hq : 7 ≤ q) (ho : Odd q)
    (hqD : q ≤ D) (hm : 2 ≤ m) (htotal : D + m = 2 * q - 4) :
    Conclusion (m + 2) (dimensions D m) := by
  classical
  let t := D + 2 - q
  have hcount : t + m + 2 = q := by dsimp [t]; omega
  have ht : t < q - 3 := by omega
  have hD : q - 3 + t + 1 ≤ D := by dsimp [t]; omega
  obtain ⟨F, hF, hFne, hcover⟩ := P14QuquartDenseCover.cover hq hcount
  let R : Fin (m + 2) → (Fin q ⊕ Fin q) → (Fin q ⊕ Fin q) → Prop :=
    Fin.cons (P14QuquartGraphCover.E hq)
      (Fin.cons (fun u v => P14QuquartDenseCover.H hq t (encode u) (encode v))
        (fun c u v => F c u = v))
  have hpartner : HasLocalFactor (Fin q ⊕ Fin q) D (D - 1) (R 1) := by
    obtain ⟨x, hnz, hpair, hspan⟩ := P14GenericExceptionalUPB.complex_rows
      (P14QuquartDenseCover.H hq t) (P14QuquartDenseCover.symmetric hq t)
      (P14QuquartDenseCover.irreflexive hq t) D (2 * q) (by omega)
      (P14QuquartDenseCover.bound hq ho t D ht hD hqD)
    have hspan' : ∀ S : Finset (Fin (2 * q)), S.card = (D - 1) + 1 →
        Submodule.span ℂ (Set.range (fun i : S => x i)) = ⊤ := by
      intro S hs
      exact hspan S (by omega)
    have hx : HasLocalFactor (Fin (2 * q)) D (D - 1)
        (fun u v => P14QuquartDenseCover.H hq t u.val v.val) := ⟨x, hnz, hspan', hpair⟩
    exact P14ComplexLocalCover.reindex (rowEquiv q) hx
  have hlocal : ∀ j, HasLocalFactor (Fin q ⊕ Fin q)
      (dimensions D m j) (caps D m j) (R j) := by
    intro j
    refine Fin.cases (P14QuquartPartnerUPB.exceptional hq ho) (fun j => ?_) j
    refine Fin.cases hpartner (fun c => ?_) j
    simpa only [dimensions, caps, R, Fin.cons_succ] using
      P14MatchingLocalFactor.on_finite (F c) (hF c) (hFne c)
  have hcomplete : ∀ u v, u ≠ v → ∃ j, R j u v := by
    intro u v huv
    rcases hcover u v huv with he | hp | ⟨c, hc⟩
    · exact ⟨0, he⟩
    · exact ⟨1, hp⟩
    · exact ⟨c.succ.succ, hc⟩
  have hcard : Fintype.card (Fin q ⊕ Fin q) = 2 * q := by simp [two_mul]
  apply P14ComplexLocalCover.canonical (dimensions D m) (caps D m) R hlocal hcomplete
  · rw [sum_caps, hcard]
    omega
  · rw [sum_deficits, hcard]
    omega

theorem of_dimensions {q D m p : ℕ} [NeZero q] (hq : 7 ≤ q) (ho : Odd q)
    (hqD : q ≤ D) (hm : 2 ≤ m) (htotal : D + m = 2 * q - 4)
    (d : Fin p → ℕ) (e : Fin p ≃ Fin (m + 2))
    (he : ∀ j, d j = dimensions D m (e j)) : Conclusion p d :=
  P14CanonicalUPBTransport.of_dimensions (dimensions D m) d e he
    (canonical hq ho hqD hm htotal)

theorem four_eight_two_two : Conclusion 4 (dimensions 8 2) :=
  canonical (q := 7) (by omega) (by decide) (by omega) (by omega) (by omega)

end P14QuquartDenseUPB
end
end

section

/-! Exactly 2q-4 actual perfect matchings cover the complement needed by
the double-cone qutrit. Aligned prisms, one mismatched Petersen block and
the remaining cross offsets use one common set of row labels. -/

noncomputable section
namespace P14QutritOnlyCover
open P14FiveComplementCover P14FivePrescribedPairings P14CyclicStepPrisms
variable {q : ℕ} [NeZero q]

def mismatchOffset (hq : 7 ≤ q) : Fin q :=
  ⟨smallCount q + 1, by dsimp [smallCount]; omega⟩
def finalOffset (hq : 7 ≤ q) (i : Fin (q - 2 - smallCount q)) : Fin q :=
  ⟨smallCount q + 2 + i.val, by have hi := i.isLt; dsimp [smallCount] at *; omega⟩

theorem construct (hq : 7 ≤ q) (ho : Odd q) :
    ∃ F : Fin (2 * q - 4) → (Fin q ⊕ Fin q) → (Fin q ⊕ Fin q),
      (∀ c, Function.Involutive (F c)) ∧ (∀ c x, F c x ≠ x) ∧
      (∀ x y, x ≠ y → P14DoubleConeSplit.E hq x y ∨ ∃ c, F c x = y) := by
  classical
  have hs (i : Fin (smallCount q)) :
      ∃ F : Fin 3 → (Fin q ⊕ Fin q) → (Fin q ⊕ Fin q),
        (∀ c, Function.Involutive (F c)) ∧ (∀ c x, F c x ≠ x) ∧
        (∀ x y, stepPrismAdj (smallStep hq i) x y ↔ ∃ c, F c x = y) := by
    apply P14CyclicStepPrisms.exists_matchings (by omega) ho (smallStep hq i)
    intro h
    have hv := congrArg Fin.val h
    change i.val + 1 = 0 at hv
    omega
  choose G hG hGne hGC using hs
  obtain ⟨M, hM, hMne, hMC⟩ :=
    P14MismatchedStepMatchings.exists_matchings hq ho (mismatchOffset hq)
  have hA : P14MismatchedStepMatchings.A hq = halfIndex hq :=
    Fin.ext (P14DoubleConeSplit.half_val hq ho).symm
  have hB : P14MismatchedStepMatchings.B hq = predHalfIndex hq :=
    Fin.ext (P14DoubleConeSplit.pred_val hq ho).symm
  let C := (Fin (smallCount q) × Fin 3) ⊕ (Fin 3 ⊕ Fin (q - 2 - smallCount q))
  let all : C → (Fin q ⊕ Fin q) → (Fin q ⊕ Fin q) :=
    Sum.elim (fun p => G p.1 p.2)
      (Sum.elim M (fun c => crossMatching (finalOffset hq c)))
  have hall (c : C) : Function.Involutive (all c) := by
    rcases c with ⟨i,c⟩ | (c | c)
    · exact hG i c
    · exact hM c
    · exact crossMatching_involutive _
  have hallne (c : C) (x : Fin q ⊕ Fin q) : all c x ≠ x := by
    rcases c with ⟨i,c⟩ | (c | c)
    · exact hGne i c x
    · exact hMne c x
    · exact crossMatching_ne _ x
  have hmis (x y : Fin q ⊕ Fin q)
      (h : P14MismatchedStepMatchings.Adj hq (mismatchOffset hq) x y) :
      ∃ c : C, all c x = y := by
    obtain ⟨c,hc⟩ := (hMC x y).mp h
    exact ⟨Sum.inr (Sum.inl c), hc⟩
  have hcross (x y : Fin q) (hdiag : x ≠ y) :
      ∃ c : C, all c (Sum.inl x) = Sum.inr y := by
    have hd : y - x ≠ 0 := sub_ne_zero.mpr hdiag.symm
    have hp : 0 < (y - x).val := Nat.pos_of_ne_zero (Fin.val_ne_zero_iff.mpr hd)
    have ht := (y - x).isLt
    by_cases hsmall : (y - x).val ≤ smallCount q
    · let i : Fin (smallCount q) := ⟨(y - x).val - 1, by omega⟩
      have hi : smallStep hq i = y - x := by
        apply Fin.ext
        change (y - x).val - 1 + 1 = (y - x).val
        omega
      have hadj : stepPrismAdj (smallStep hq i) (Sum.inl x) (Sum.inr y) := by
        change y = x + smallStep hq i
        rw [hi, add_sub_cancel]
      obtain ⟨c,hc⟩ := (hGC i _ _).mp hadj
      exact ⟨Sum.inl (i,c), hc⟩
    · by_cases hm : (y - x).val = smallCount q + 1
      · apply hmis
        change y = x + mismatchOffset hq
        have he : mismatchOffset hq = y - x := Fin.ext hm.symm
        rw [he, add_sub_cancel]
      · let i : Fin (q - 2 - smallCount q) :=
          ⟨(y - x).val - smallCount q - 2, by omega⟩
        have hi : finalOffset hq i = y - x := by
          apply Fin.ext
          change smallCount q + 2 + ((y - x).val - smallCount q - 2) = (y - x).val
          omega
        refine ⟨Sum.inr (Sum.inr i), ?_⟩
        change Sum.inr (x + finalOffset hq i) = Sum.inr y
        rw [hi, add_sub_cancel]
  have hcover (x y : Fin q ⊕ Fin q) (hxy : x ≠ y) :
      P14DoubleConeSplit.E hq x y ∨ ∃ c : C, all c x = y := by
    cases x with
    | inl x =>
      cases y with
      | inl y =>
        rcases internal_cover hq ho x y (fun h => hxy (congrArg Sum.inl h)) with h | ⟨i,hi⟩
        · rcases h with h | h | h | h
          · exact Or.inl (Or.inl h)
          · exact Or.inl (Or.inr h)
          · right
            apply hmis
            change y = x + P14MismatchedStepMatchings.B hq ∨
              x = y + P14MismatchedStepMatchings.B hq
            rw [hB]
            exact Or.inl h
          · right
            apply hmis
            change y = x + P14MismatchedStepMatchings.B hq ∨
              x = y + P14MismatchedStepMatchings.B hq
            rw [hB]
            exact Or.inr h
        · obtain ⟨c,hc⟩ := (hGC i (Sum.inl x) (Sum.inl y)).mp hi
          exact Or.inr ⟨Sum.inl (i,c), hc⟩
      | inr y =>
        by_cases hdiag : x = y
        · exact Or.inl hdiag
        · exact Or.inr (hcross x y hdiag)
    | inr x =>
      cases y with
      | inl y =>
        by_cases hdiag : x = y
        · exact Or.inl hdiag
        · obtain ⟨c,hc⟩ := hcross y x (fun h => hdiag h.symm)
          right
          refine ⟨c, ?_⟩
          rw [← hc]
          exact hall c (Sum.inl y)
      | inr y =>
        rcases internal_cover hq ho x y (fun h => hxy (congrArg Sum.inr h)) with h | ⟨i,hi⟩
        · rcases h with h | h | h | h
          · right
            apply hmis
            change y = x + P14MismatchedStepMatchings.A hq ∨
              x = y + P14MismatchedStepMatchings.A hq
            rw [hA]
            exact Or.inl h
          · right
            apply hmis
            change y = x + P14MismatchedStepMatchings.A hq ∨
              x = y + P14MismatchedStepMatchings.A hq
            rw [hA]
            exact Or.inr h
          · exact Or.inl (Or.inl h)
          · exact Or.inl (Or.inr h)
        · obtain ⟨c,hc⟩ := (hGC i (Sum.inr x) (Sum.inr y)).mp hi
          exact Or.inr ⟨Sum.inl (i,c), hc⟩
  have hcard : Fintype.card C = 2 * q - 4 := by
    simp only [C, Fintype.card_sum, Fintype.card_prod, Fintype.card_fin]
    have hr := smallCount_spec hq ho
    omega
  let e : Fin (2 * q - 4) ≃ C := (Fintype.equivFinOfCardEq hcard).symm
  refine ⟨fun c => all (e c), fun c => hall (e c), fun c => hallne (e c), ?_⟩
  intro x y hxy
  rcases hcover x y hxy with he | ⟨c,hc⟩
  · exact Or.inl he
  · exact Or.inr ⟨e.symm c, by simpa only [Equiv.apply_symm_apply] using hc⟩

end P14QutritOnlyCover

end
end

section

/-! Actual complex UPBs for one qutrit and 2q-4 qubits, q odd >=7.
The full pair cover and all local vectors are constructed. -/

noncomputable section
namespace P14QutritOnlyUPB
open P14CanonicalUPBTransport P14ComplexLocalCover
open scoped BigOperators

def dimensions (m : ℕ) : Fin (m + 1) → ℕ := Fin.cons 3 (fun _ : Fin m => 2)
def caps (m : ℕ) : Fin (m + 1) → ℕ := Fin.cons 3 (fun _ : Fin m => 1)

theorem sum_caps (m : ℕ) : (∑ j, caps m j) = 3 + m := by
  simp [caps, Fin.sum_univ_succ]
theorem sum_deficits (m : ℕ) : (∑ j, (dimensions m j - 1)) = 2 + m := by
  simp [dimensions, Fin.sum_univ_succ]

theorem canonical {q : ℕ} [NeZero q] (hq : 7 ≤ q) (ho : Odd q) :
    Conclusion (2 * q - 4 + 1) (dimensions (2 * q - 4)) := by
  classical
  obtain ⟨F, hF, hFne, hcover⟩ := P14QutritOnlyCover.construct hq ho
  have hlocal (c : Fin (2 * q - 4)) :=
    P14MatchingLocalFactor.on_finite (F c) (hF c) (hFne c)
  choose y hynz hyspan hypair using hlocal
  let w : (Fin q ⊕ Fin q) → (j : Fin (2 * q - 4 + 1)) →
      Fin (dimensions (2 * q - 4) j) → ℂ :=
    fun u => Fin.cases (P14DoubleConeQutrit.row q u) (fun c => y c u)
  have hw : ∀ u j, w u j ≠ 0 := by
    intro u j
    refine Fin.cases ?_ (fun c => hynz c u) j
    exact P14DoubleConeQutrit.row_ne_zero hq u
  have hp : ∀ u v : Fin q ⊕ Fin q, u ≠ v →
      ∃ j, (∑ r, star (w u j r) * w v j r) = 0 := by
    intro u v huv
    rcases hcover u v huv with he | ⟨c,hc⟩
    · exact ⟨0, P14DoubleConeSplit.orthogonal hq ho u v he⟩
    · exact ⟨c.succ, hypair c u v hc⟩
  have hcard : Fintype.card (Fin q ⊕ Fin q) = 2 * q := by simp [two_mul]
  have hbudget : (∑ j, caps (2 * q - 4) j) < Fintype.card (Fin q ⊕ Fin q) := by
    rw [sum_caps, hcard]
    omega
  have hkill : ∀ j (a : Fin (dimensions (2 * q - 4) j) → ℂ), a ≠ 0 →
      ∀ S : Finset (Fin q ⊕ Fin q),
        (∀ u ∈ S, (∑ r, star (w u j r) * a r) = 0) → S.card ≤ caps (2 * q - 4) j := by
    intro j
    refine Fin.cases ?_ (fun c => ?_) j
    · intro a ha S hS
      exact P14DoubleConeQutrit.killing_bound hq a ha S hS
    · intro a ha S hS
      exact P14ComplexKillingBudget.of_spanning (y c) (hyspan c) a ha S hS
  let e : Fin (2 * q) ≃ (Fin q ⊕ Fin q) := (Fintype.equivFinOfCardEq hcard).symm
  refine ⟨2 * q, ?_, fun i => w (e i), ?_, ?_, ?_⟩
  · rw [sum_deficits]
    omega
  · intro i j
    exact hw (e i) j
  · intro i j hij
    exact hp (e i) (e j) (e.injective.ne hij)
  · intro a ha
    obtain ⟨u,hu⟩ := P14ComplexKillingBudget.survivor
      (dimensions (2 * q - 4)) (caps (2 * q - 4)) w hbudget hkill a ha
    refine ⟨e.symm u, ?_⟩
    simpa only [Equiv.apply_symm_apply] using hu

end P14QutritOnlyUPB

end
end

section

/-! Assemble an actual single ordinary partner and qubit graph cover
with the fixed qutrit rows, then discharge the dominant-partner region. -/
noncomputable section
namespace P14QutritPartnerRows
open P14ComplexLocalCover P14OddLayerLabels P14CanonicalUPBTransport
open P14BicliqueComplementConnection
open scoped BigOperators

def dimensions (D m : ℕ) : Fin (m + 2) → ℕ :=
  Fin.cons 3 (Fin.cons D (fun _ : Fin m => 2))
def caps (D m : ℕ) : Fin (m + 2) → ℕ :=
  Fin.cons 3 (Fin.cons (D - 1) (fun _ : Fin m => 1))
theorem sum_caps (D m : ℕ) : (∑ j, caps D m j) = 3 + (D - 1) + m := by
  simp [caps, Fin.sum_univ_succ, Nat.add_assoc]
theorem sum_deficits (D m : ℕ) :
    (∑ j, (dimensions D m j - 1)) = 2 + (D - 1) + m := by
  simp [dimensions, Fin.sum_univ_succ, Nat.add_assoc]

theorem from_cover {q D m : ℕ} [NeZero q] (hq : 7 ≤ q) (ho : Odd q)
    (hD : 2 ≤ D) (htotal : D + m = 2 * q - 3)
    (G : ℕ → ℕ → Prop) (hsym : ∀ {i j}, G i j → G j i)
    (hirr : ∀ i, ¬ G i i) (hbound : BicliqueBound G (Finset.range (2 * q)) D)
    (F : Fin m → (Fin q ⊕ Fin q) → (Fin q ⊕ Fin q))
    (hF : ∀ c, Function.Involutive (F c)) (hFne : ∀ c u, F c u ≠ u)
    (hcover : ∀ u v, u ≠ v → P14DoubleConeSplit.E hq u v ∨
      G (encode u) (encode v) ∨ ∃ c, F c u = v) :
    Conclusion (m + 2) (dimensions D m) := by
  classical
  let R : Fin (m + 1) → (Fin q ⊕ Fin q) → (Fin q ⊕ Fin q) → Prop :=
    Fin.cons (fun u v => G (encode u) (encode v)) (fun c u v => F c u = v)
  let d : Fin (m + 1) → ℕ := Fin.cons D (fun _ : Fin m => 2)
  let c : Fin (m + 1) → ℕ := Fin.cons (D - 1) (fun _ : Fin m => 1)
  have hpartner : HasLocalFactor (Fin q ⊕ Fin q) D (D - 1) (R 0) := by
    obtain ⟨x,hnz,hpair,hspan⟩ := P14GenericExceptionalUPB.complex_rows
      G hsym hirr D (2 * q) (by omega) hbound
    have hspan' : ∀ S : Finset (Fin (2 * q)), S.card = (D - 1) + 1 →
        Submodule.span ℂ (Set.range (fun i : S => x i)) = ⊤ := by
      intro S hs
      exact hspan S (by omega)
    have hx : HasLocalFactor (Fin (2 * q)) D (D - 1)
        (fun u v => G u.val v.val) := ⟨x,hnz,hspan',hpair⟩
    exact P14ComplexLocalCover.reindex (rowEquiv q) hx
  have hlocal : ∀ j, HasLocalFactor (Fin q ⊕ Fin q) (d j) (c j) (R j) := by
    intro j
    refine Fin.cases hpartner (fun k => ?_) j
    simpa only [d,c,R,Fin.cons_succ] using
      P14MatchingLocalFactor.on_finite (F k) (hF k) (hFne k)
  choose y hynz hyspan hypair using hlocal
  let w : (Fin q ⊕ Fin q) → (j : Fin (m + 2)) → Fin (dimensions D m j) → ℂ :=
    fun u => Fin.cases (P14DoubleConeQutrit.row q u) (fun j => y j u)
  have hw : ∀ u j, w u j ≠ 0 := by
    intro u j
    refine Fin.cases ?_ (fun j => hynz j u) j
    exact P14DoubleConeQutrit.row_ne_zero hq u
  have hpair : ∀ u v : Fin q ⊕ Fin q, u ≠ v →
      ∃ j, (∑ k, star (w u j k) * w v j k) = 0 := by
    intro u v huv
    rcases hcover u v huv with he | hg | ⟨k,hk⟩
    · exact ⟨0,P14DoubleConeSplit.orthogonal hq ho u v he⟩
    · exact ⟨(0 : Fin (m + 1)).succ,hypair 0 u v hg⟩
    · refine ⟨k.succ.succ,hypair k.succ u v ?_⟩
      simpa only [R,Fin.cons_succ] using hk
  have hcard : Fintype.card (Fin q ⊕ Fin q) = 2 * q := by simp [two_mul]
  have hbudget : (∑ j, caps D m j) < Fintype.card (Fin q ⊕ Fin q) := by
    rw [sum_caps,hcard]
    omega
  have hkill : ∀ j (a : Fin (dimensions D m j) → ℂ), a ≠ 0 →
      ∀ S : Finset (Fin q ⊕ Fin q),
        (∀ u ∈ S, (∑ k, star (w u j k) * a k) = 0) → S.card ≤ caps D m j := by
    intro j
    refine Fin.cases ?_ (fun j => ?_) j
    · intro a ha S hS
      exact P14DoubleConeQutrit.killing_bound hq a ha S hS
    · intro a ha S hS
      exact P14ComplexKillingBudget.of_spanning (y j) (hyspan j) a ha S hS
  let e := (rowEquiv q).symm
  refine ⟨2 * q,?_,fun i => w (e i),?_,?_,?_⟩
  · rw [sum_deficits]
    omega
  · intro i j
    exact hw (e i) j
  · intro i j hij
    exact hpair (e i) (e j) (e.injective.ne hij)
  · intro a ha
    obtain ⟨u,hu⟩ := P14ComplexKillingBudget.survivor (dimensions D m) (caps D m)
      w hbudget hkill a ha
    refine ⟨rowEquiv q u,?_⟩
    simpa only [e,Equiv.symm_apply_apply] using hu

theorem dominant {q D m : ℕ} [NeZero q] (hq : 7 ≤ q) (ho : Odd q)
    (hqD : q ≤ D) (hm : 1 ≤ m) (htotal : D + m = 2 * q - 3) :
    Conclusion (m + 2) (dimensions D m) := by
  let t := D + 2 - q
  have hcount : t + m + 1 = q := by dsimp [t]; omega
  obtain ⟨F,hF,hFne,hcover⟩ := P14QutritDenseCover.cover hq hcount
  apply from_cover hq ho (by omega) htotal (P14QutritDenseCover.H hq t)
    (P14QutritDenseCover.symmetric hq t) (P14QutritDenseCover.irreflexive hq t)
    (P14QutritDenseCover.bound hq ho t D (by omega) (by dsimp [t]; omega) hqD)
    F hF hFne hcover

end P14QutritPartnerRows
end
end

section

/-! Allocation for a non-dominant partner, with three qubits reserved
for the mismatched endpoint cycles. All counts are explicit. -/
namespace P14QutritFreeAllocation
open P14FiveComplementCover

theorem construct {q D m : ℕ} (hq : 9 ≤ q) (ho : Odd q)
    (hD : 3 ≤ D) (hDq : D < q) (htotal : D + m = 2 * q - 3) :
    ∃ x t N B : ℕ, 1 ≤ x ∧ x ≤ smallCount q ∧
      2 * x + t + 1 = D ∧ 2 * x ≠ t ∧ t ≤ q - 2 ∧
      N = smallCount q - x ∧ B = q - 2 - t ∧ N ≤ B ∧
      3 + (3 * N + (B - N)) = m := by
  have hs := smallCount_spec (by omega : 7 ≤ q) ho
  let x := min ((D - 1) / 2) (smallCount q)
  let t := D - 1 - 2 * x
  have hx : x ≤ smallCount q := Nat.min_le_right _ _
  have hxD : x ≤ (D - 1) / 2 := Nat.min_le_left _ _
  have hxp : 1 ≤ x := by dsimp [x]; omega
  have hdt : 2 * x + t + 1 = D := by dsimp [t]; omega
  have hchoice : x = (D - 1) / 2 ∨ x = smallCount q := by
    dsimp [x]
    exact min_choice _ _
  have ht : t ≤ q - 2 := by rcases hchoice with h | h <;> omega
  have hne : 2 * x ≠ t := by rcases hchoice with h | h <;> omega
  have hNB : smallCount q - x ≤ q - 2 - t := by
    rcases hchoice with h | h <;> omega
  refine ⟨x, t, smallCount q - x, q - 2 - t,
    hxp, hx, hdt, hne, ht, rfl, rfl, hNB, ?_⟩
  omega

end P14QutritFreeAllocation
end

section

/-! Cover with a qutrit graph, one ordinary annulus block, and exactly
the remaining number of qubit matchings. The mismatched cycles use three
qubits and offset one; the ordinary block uses offsets starting at two. -/
noncomputable section
namespace P14QutritFreeCover
open P14OddLayerLabels P14FiveComplementCover P14FivePrescribedPairings
open P14BicliqueComplementConnection
variable {q : ℕ} [NeZero q]

def H (q x t : ℕ) [NeZero q] : ℕ → ℕ → Prop :=
  P14OddLayerBlockBiclique.Edge (Side q) (label q) 1 x 2 t

theorem step_mem (hq : 7 ≤ q) (x : ℕ) (i : Fin (smallCount q))
    (hi : i.val < x) (u v : Fin q)
    (h : v = u + smallStep hq i ∨ u = v + smallStep hq i) :
    P14OddLayerLabels.cast v - P14OddLayerLabels.cast u ∈
      P14OddCyclicAnnulus.annulus 1 x := by
  apply (P14OddCyclicAnnulus.mem_iff 1 x _).mpr
  refine ⟨i.val + 1, by omega, by omega, ?_⟩
  have hs : P14OddLayerLabels.cast (smallStep hq i) =
      ((i.val + 1 : ℕ) : ZMod q) := rfl
  rcases h with rfl | rfl
  · left
    rw [cast_add, hs]
    abel
  · right
    rw [cast_add, hs]
    abel

theorem construct {D m : ℕ} (hq : 9 ≤ q) (ho : Odd q)
    (hD : 3 ≤ D) (hDq : D < q) (htotal : D + m = 2 * q - 3) :
    ∃ G : ℕ → ℕ → Prop,
      ∃ F : Fin m → (Fin q ⊕ Fin q) → (Fin q ⊕ Fin q),
      (∀ {u v}, G u v → G v u) ∧ (∀ u, ¬ G u u) ∧
      BicliqueBound G (Finset.range (2 * q)) D ∧
      (∀ c, Function.Involutive (F c)) ∧ (∀ c u, F c u ≠ u) ∧
      (∀ u v, u ≠ v → P14DoubleConeSplit.E (by omega : 7 ≤ q) u v ∨
        G (encode u) (encode v) ∨ ∃ c, F c u = v) := by
  classical
  have hq7 : 7 ≤ q := by omega
  obtain ⟨x,t,N,B,hxp,hx,hdt,hne,ht,hN,hB,hNB,hm⟩ :=
    P14QutritFreeAllocation.construct hq ho hD hDq htotal
  have hs := smallCount_spec hq7 ho
  let a : Fin N → Fin q := fun i => ⟨x + i.val + 1, by have hi := i.isLt; omega⟩
  let b : Fin B → Fin q := fun i => ⟨2 + t + i.val, by have hi := i.isLt; omega⟩
  have ha : ∀ i, a i ≠ 0 := by
    intro i he
    have hv := congrArg Fin.val he
    change x + i.val + 1 = 0 at hv
    omega
  obtain ⟨R,hR,hRne,hRC⟩ := P14PrismRemainderCover.exists_cover (by omega) ho a b ha hNB
  let one : Fin q := ⟨1, by omega⟩
  obtain ⟨M,hM,hMne,hMC⟩ := P14MismatchedStepMatchings.exists_matchings hq7 ho one
  let C := Fin 3 ⊕ Fin (3 * N + (B - N))
  let all : C → (Fin q ⊕ Fin q) → (Fin q ⊕ Fin q) := Sum.elim M R
  have hall (c : C) : Function.Involutive (all c) := by
    rcases c with c | c
    · exact hM c
    · exact hR c
  have hallne (c : C) (u : Fin q ⊕ Fin q) : all c u ≠ u := by
    rcases c with c | c
    · exact hMne c u
    · exact hRne c u
  have hmis (u v : Fin q ⊕ Fin q)
      (h : P14MismatchedStepMatchings.Adj hq7 one u v) :
      ∃ c : C, all c u = v := by
    obtain ⟨c,hc⟩ := (hMC u v).mp h
    exact ⟨Sum.inl c,hc⟩
  have hrem (u v : Fin q ⊕ Fin q)
      (h : (∃ i, P14PrismRemainderCover.Inside (a i) u v) ∨
        ∃ j, P14PrismRemainderCover.Cross (b j) u v) :
      ∃ c : C, all c u = v := by
    obtain ⟨c,hc⟩ := (hRC u v).mp h
    exact ⟨Sum.inr c,hc⟩
  have hsmall (i : Fin (smallCount q)) (hi : ¬ i.val < x) :
      ∃ j : Fin N, a j = smallStep hq7 i := by
    let j : Fin N := ⟨i.val - x, by have h := i.isLt; omega⟩
    refine ⟨j, Fin.ext ?_⟩
    change x + (i.val - x) + 1 = i.val + 1
    omega
  have hA : P14MismatchedStepMatchings.A hq7 = halfIndex hq7 :=
    Fin.ext (P14DoubleConeSplit.half_val hq7 ho).symm
  have hBB : P14MismatchedStepMatchings.B hq7 = predHalfIndex hq7 :=
    Fin.ext (P14DoubleConeSplit.pred_val hq7 ho).symm
  have hcross (u v : Fin q) (hdiag : u ≠ v) :
      H q x t (encode (Sum.inl u)) (encode (Sum.inr v)) ∨
        ∃ c : C, all c (Sum.inl u) = Sum.inr v := by
    have hd : v - u ≠ 0 := sub_ne_zero.mpr hdiag.symm
    have hp : 0 < (v - u).val := Nat.pos_of_ne_zero (Fin.val_ne_zero_iff.mpr hd)
    have hlt := (v - u).isLt
    by_cases heq : (v - u).val = 1
    · right
      apply hmis
      change v = u + one
      have he : one = v - u := Fin.ext heq.symm
      rw [he, add_sub_cancel]
    · by_cases hblock : (v - u).val < 2 + t
      · left
        apply Or.inr
        apply (cross_inl_inr 2 t u v).mpr
        apply Finset.mem_image.mpr
        refine ⟨(v - u).val - 2, Finset.mem_range.mpr (by omega), ?_⟩
        rw [← cast_sub]
        change (2 : ZMod q) + (((v - u).val - 2 : ℕ) : ZMod q) =
          ((v - u).val : ZMod q)
        have hh : 2 + ((v - u).val - 2) = (v - u).val := by omega
        simpa only [Nat.cast_add, Nat.cast_ofNat] using
          congrArg (fun n : ℕ => (n : ZMod q)) hh
      · right
        apply hrem
        right
        let j : Fin B := ⟨(v - u).val - (2 + t), by omega⟩
        refine ⟨j, ?_⟩
        change v = u + b j
        have he : b j = v - u := by
          apply Fin.ext
          change 2 + t + ((v - u).val - (2 + t)) = (v - u).val
          omega
        rw [he, add_sub_cancel]
  have hcover (u v : Fin q ⊕ Fin q) (huv : u ≠ v) :
      P14DoubleConeSplit.E hq7 u v ∨ H q x t (encode u) (encode v) ∨
        ∃ c : C, all c u = v := by
    cases u with
    | inl u =>
      cases v with
      | inl v =>
        rcases internal_cover hq7 ho u v (fun h => huv (congrArg Sum.inl h)) with h | ⟨i,hi⟩
        · rcases h with h | h | h | h
          · exact Or.inl (Or.inl h)
          · exact Or.inl (Or.inr h)
          · apply Or.inr ∘ Or.inr
            apply hmis
            change v = u + P14MismatchedStepMatchings.B hq7 ∨ _
            rw [hBB]
            exact Or.inl h
          · apply Or.inr ∘ Or.inr
            apply hmis
            change v = u + P14MismatchedStepMatchings.B hq7 ∨ _
            rw [hBB]
            exact Or.inr h
        · by_cases hix : i.val < x
          · exact Or.inr (Or.inl (Or.inl ((within_inl 1 x u v).mpr (step_mem hq7 x i hix u v hi))))
          · obtain ⟨j,hj⟩ := hsmall i hix
            exact Or.inr (Or.inr (hrem _ _ (Or.inl ⟨j, by change v = u + a j ∨ u = v + a j; rwa [hj]⟩)))
      | inr v =>
        by_cases hd : u = v
        · exact Or.inl hd
        · exact Or.inr (hcross u v hd)
    | inr u =>
      cases v with
      | inl v =>
        by_cases hd : u = v
        · exact Or.inl hd
        · rcases hcross v u (fun h => hd h.symm) with hb | ⟨c,hc⟩
          · exact Or.inr (Or.inl (P14OddLayerBlockBiclique.edge_symmetric _ _ _ _ _ _ hb))
          · refine Or.inr (Or.inr ⟨c, ?_⟩)
            rw [← hc]
            exact hall c (Sum.inl v)
      | inr v =>
        rcases internal_cover hq7 ho u v (fun h => huv (congrArg Sum.inr h)) with h | ⟨i,hi⟩
        · rcases h with h | h | h | h
          · apply Or.inr ∘ Or.inr
            apply hmis
            change v = u + P14MismatchedStepMatchings.A hq7 ∨ _
            rw [hA]
            exact Or.inl h
          · apply Or.inr ∘ Or.inr
            apply hmis
            change v = u + P14MismatchedStepMatchings.A hq7 ∨ _
            rw [hA]
            exact Or.inr h
          · exact Or.inl (Or.inl h)
          · exact Or.inl (Or.inr h)
        · by_cases hix : i.val < x
          · exact Or.inr (Or.inl (Or.inl ((within_inr 1 x u v).mpr (step_mem hq7 x i hix u v hi))))
          · obtain ⟨j,hj⟩ := hsmall i hix
            exact Or.inr (Or.inr (hrem _ _ (Or.inl ⟨j, by change v = u + a j ∨ u = v + a j; rwa [hj]⟩)))
  have hcard : Fintype.card C = m := by
    simpa only [C, Fintype.card_sum, Fintype.card_fin] using hm
  let e : Fin m ≃ C := (Fintype.equivFinOfCardEq hcard).symm
  refine ⟨H q x t, fun c => all (e c), ?_, ?_, ?_,
    fun c => hall (e c), fun c => hallne (e c), ?_⟩
  · exact P14OddLayerBlockBiclique.edge_symmetric _ _ _ _ _ _
  · exact P14OddLayerBlockBiclique.edge_irreflexive _ _ _ _ _ _ (by omega) (by omega)
  · rw [← hdt]
    exact P14OddLayerBlockBiclique.bound _ _ _ labels_injective ho 1 x 2 t
      (by omega) (by omega) (by omega) hne
  · intro u v huv
    rcases hcover u v huv with he | hg | ⟨c,hc⟩
    · exact Or.inl he
    · exact Or.inr (Or.inl hg)
    · exact Or.inr (Or.inr ⟨e.symm c, by simpa only [Equiv.apply_symm_apply] using hc⟩)

end P14QutritFreeCover
end
end

section

/-! Each distinct pair has one round center. Removing center zero is
exactly the complement of that round, with loops excluded. -/

noncomputable section
namespace P14CyclicRoundCenter
open P14CyclicArc P14CyclicRoundBlock
variable {q : ℕ} [NeZero q]

def center (hn : Odd q) : Option (ZMod q) → Option (ZMod q) → ZMod q
  | none, none => 0
  | none, some y => y
  | some x, none => x
  | some x, some y => half hn (x + y)

theorem edge_iff (hn : Odd q) (a : ZMod q) (l : ℕ) (x y : Option (ZMod q)) :
    Edge a l x y ↔ x ≠ y ∧ center hn x y ∈ arc a l := by
  cases x with
  | none => cases y <;> simp [Edge, center]
  | some x =>
    cases y with
    | none => simp [Edge, center]
    | some y =>
      simp only [Edge, center, ne_eq, Option.some.injEq]
      constructor
      · rintro ⟨hne, t, ht, he⟩
        have hh : half hn (x + y) = t := doubling_injective hn ((half_spec hn (x + y)).trans he)
        exact ⟨hne, hh.symm ▸ ht⟩
      · rintro ⟨hne, hc⟩
        exact ⟨hne, half hn (x + y), hc, (half_spec hn (x + y)).symm⟩

theorem singleton_mem (a z : ZMod q) : z ∈ arc a 1 ↔ z = a := by
  simp [arc]

theorem singleton_unique (a : ZMod q) (x y z : Option (ZMod q))
    (hy : Edge a 1 x y) (hz : Edge a 1 x z) : y = z := by
  have finite_sum (u v : ZMod q) (h : Edge a 1 (some u) (some v)) : u + v = a + a := by
    obtain ⟨_, t, ht, he⟩ := h
    have heq := (singleton_mem a t).mp ht
    rwa [heq] at he
  cases x with
  | none =>
    cases y with
    | none => exact False.elim hy
    | some y =>
      cases z with
      | none => exact False.elim hz
      | some z =>
        exact congrArg some (((singleton_mem a y).mp hy).trans ((singleton_mem a z).mp hz).symm)
  | some x =>
    cases y with
    | none =>
      cases z with
      | none => rfl
      | some z =>
        have hx : x = a := (singleton_mem a x).mp hy
        have he := finite_sum x z hz
        have hza : z = a := by rw [hx] at he; exact add_left_cancel he
        exact False.elim (hz.1 (hx.trans hza.symm))
    | some y =>
      cases z with
      | none =>
        have hx : x = a := (singleton_mem a x).mp hz
        have he := finite_sum x y hy
        have hya : y = a := by rw [hx] at he; exact add_left_cancel he
        exact False.elim (hy.1 (hx.trans hya.symm))
      | some z =>
        exact congrArg some (add_left_cancel ((finite_sum x y hy).trans (finite_sum x z hz).symm))

theorem nonzero_arc (z : ZMod q) : z ∈ arc 1 (q - 1) ↔ z ≠ 0 := by
  constructor
  · intro hz he
    obtain ⟨t, ht, htz⟩ := Finset.mem_image.mp hz
    have ht' := Finset.mem_range.mp ht
    have hcast : ((1 + t : ℕ) : ZMod q) = 0 := by
      rw [Nat.cast_add, Nat.cast_one]
      exact htz.trans he
    have hv := congrArg ZMod.val hcast
    rw [ZMod.val_natCast_of_lt (by omega), ZMod.val_zero] at hv
    omega
  · intro hz
    have hv := ZMod.val_lt z
    have hp : 0 < z.val := by
      by_contra h
      have he : z.val = 0 := by omega
      have hc := ZMod.natCast_zmod_val z
      rw [he, Nat.cast_zero] at hc
      exact hz hc.symm
    refine Finset.mem_image.mpr ⟨z.val - 1, Finset.mem_range.mpr (by omega), ?_⟩
    have hn : 1 + (z.val - 1) = z.val := by omega
    calc
      1 + ((z.val - 1 : ℕ) : ZMod q) = ((1 + (z.val - 1) : ℕ) : ZMod q) := by simp
      _ = z := by rw [hn, ZMod.natCast_zmod_val]

theorem remaining_iff (hn : Odd q) (x y : Option (ZMod q)) :
    Edge 1 (q - 1) x y ↔ x ≠ y ∧ ¬ Edge 0 1 x y := by
  rw [edge_iff hn, edge_iff hn, nonzero_arc, singleton_mem]
  constructor
  · rintro ⟨hne, hc⟩
    exact ⟨hne, fun h => hc h.2⟩
  · rintro ⟨hne, hnot⟩
    exact ⟨hne, fun hc => hnot ⟨hne, hc⟩⟩

end P14CyclicRoundCenter

end
end

section

/-! An explicit relabelling of 2h vertices by infinity and ZMod(2h-1).
It sends each antipodal pair i,i+h to the omitted round with center zero. -/

noncomputable section
namespace P14AntipodalRoundLabels
open P14CyclicArc

def label (h i : ℕ) : Option (ZMod (2 * h - 1)) :=
  if i < h then (if i = 0 then none else some (i : ZMod (2 * h - 1)))
  else some (-((i - h : ℕ) : ZMod (2 * h - 1)))

def antipode (h i : ℕ) : ℕ := if i < h then i + h else i - h

theorem small_cast_injective (h : ℕ) (hh : 1 ≤ h) (i j : ℕ) (hi : i < h) (hj : j < h)
    (he : (i : ZMod (2 * h - 1)) = (j : ZMod (2 * h - 1))) : i = j := by
  have hv := congrArg ZMod.val he
  rwa [ZMod.val_natCast_of_lt (by omega), ZMod.val_natCast_of_lt (by omega)] at hv

theorem positive_ne_negative (h : ℕ) (i j : ℕ) (hp : 0 < i) (hi : i < h) (hj : j < h) :
    (i : ZMod (2 * h - 1)) ≠ -(j : ZMod (2 * h - 1)) := by
  intro he
  have hz : ((i + j : ℕ) : ZMod (2 * h - 1)) = 0 := by
    rw [Nat.cast_add, he, neg_add_cancel]
  have hv := congrArg ZMod.val hz
  rw [ZMod.val_natCast_of_lt (by omega), ZMod.val_zero] at hv
  omega

theorem label_injective (h : ℕ) (hh : 1 ≤ h) (i j : ℕ) (hi : i < 2 * h) (hj : j < 2 * h)
    (he : label h i = label h j) : i = j := by
  by_cases hih : i < h
  · by_cases hjh : j < h
    · simp only [label, if_pos hih, if_pos hjh] at he
      by_cases hi0 : i = 0
      · by_cases hj0 : j = 0
        · exact hi0.trans hj0.symm
        · simp [hi0, hj0] at he
      · by_cases hj0 : j = 0
        · simp [hi0, hj0] at he
        · have hc : (i : ZMod (2 * h - 1)) = (j : ZMod (2 * h - 1)) := by simpa [hi0, hj0] using he
          exact small_cast_injective h hh i j hih hjh hc
    · by_cases hi0 : i = 0
      · simp [label, hih, hjh, hi0] at he
        omega
      · have hc : (i : ZMod (2 * h - 1)) = -((j - h : ℕ) : ZMod (2 * h - 1)) := by
          simpa [label, hih, hjh, hi0] using he
        exact False.elim (positive_ne_negative h i (j - h) (by omega) hih (by omega) hc)
  · by_cases hjh : j < h
    · by_cases hj0 : j = 0
      · simp [label, hih, hjh, hj0] at he
        omega
      · have hc : (j : ZMod (2 * h - 1)) = -((i - h : ℕ) : ZMod (2 * h - 1)) := by
          simpa [label, hih, hjh, hj0] using he.symm
        exact False.elim (positive_ne_negative h j (i - h) (by omega) hjh (by omega) hc)
    · have hc : -((i - h : ℕ) : ZMod (2 * h - 1)) = -((j - h : ℕ) : ZMod (2 * h - 1)) := by
        simpa [label, hih, hjh] using he
      have hd := small_cast_injective h hh (i - h) (j - h) (by omega) (by omega) (neg_injective hc)
      omega

theorem antipode_lt (h : ℕ) (hh : 1 ≤ h) (i : ℕ) (hi : i < 2 * h) : antipode h i < 2 * h := by
  by_cases hih : i < h <;> simp only [antipode, hih, ite_true, ite_false] <;> omega

theorem first_half_edge (h : ℕ) [NeZero (2 * h - 1)] (hh : 1 ≤ h) (i : ℕ) (hi : i < h) :
    P14CyclicRoundBlock.Edge 0 1 (label h i) (label h (i + h)) := by
  have hright : label h (i + h) = some (-(i : ZMod (2 * h - 1))) := by
    simp [label, show ¬ i + h < h by omega]
  rw [hright]
  by_cases hi0 : i = 0
  · subst i
    have hleft : label h 0 = none := by simp [label, show 0 < h by omega]
    rw [hleft]
    simp [P14CyclicRoundBlock.Edge, arc]
  · have hleft : label h i = some (i : ZMod (2 * h - 1)) := by simp [label, hi, hi0]
    rw [hleft]
    refine ⟨positive_ne_negative h i i (by omega) hi hi, 0, ?_, ?_⟩
    · simp [arc]
    · simp

theorem antipodal_edge (h : ℕ) [NeZero (2 * h - 1)] (hh : 1 ≤ h) (i : ℕ) (hi : i < 2 * h) :
    P14CyclicRoundBlock.Edge 0 1 (label h i) (label h (antipode h i)) := by
  by_cases hih : i < h
  · simpa only [antipode, if_pos hih] using first_half_edge h hh i hih
  · have hk : i - h < h := by omega
    have he : (i - h) + h = i := by omega
    have hb := P14CyclicRoundBlock.edge_symmetric 0 1 (first_half_edge h hh (i - h) hk)
    simpa only [antipode, if_neg hih, he] using hb

theorem zero_round_iff (h : ℕ) [NeZero (2 * h - 1)] (hh : 1 ≤ h)
    (i j : ℕ) (hi : i < 2 * h) (hj : j < 2 * h) :
    P14CyclicRoundBlock.Edge 0 1 (label h i) (label h j) ↔ j = antipode h i := by
  constructor
  · intro he
    have heq := P14CyclicRoundCenter.singleton_unique 0 (label h i) (label h j)
      (label h (antipode h i)) he (antipodal_edge h hh i hi)
    exact label_injective h hh j (antipode h i) hj (antipode_lt h hh i hi) heq
  · intro he
    rw [he]
    exact antipodal_edge h hh i hi

theorem remaining_iff (h : ℕ) [NeZero (2 * h - 1)] (hh : 1 ≤ h)
    (i j : ℕ) (hi : i < 2 * h) (hj : j < 2 * h) :
    P14CyclicRoundBlock.Edge 1 (2 * h - 2) (label h i) (label h j) ↔
      i ≠ j ∧ j ≠ antipode h i := by
  have hodd : Odd (2 * h - 1) := ⟨h - 1, by omega⟩
  have hn : 2 * h - 2 = (2 * h - 1) - 1 := by omega
  rw [hn, P14CyclicRoundCenter.remaining_iff hodd, zero_round_iff h hh i j hi hj]
  constructor
  · rintro ⟨hne, hp⟩
    exact ⟨fun he => hne (congrArg (label h) he), hp⟩
  · rintro ⟨hne, hp⟩
    exact ⟨fun he => hne (label_injective h hh i j hi hj he), hp⟩

end P14AntipodalRoundLabels

end
end

section

/-! A complete graph cover by ordinary round-robin blocks. There are 2h rows
and 2h-1 rounds. A local block of R rounds has biclique number at most R+1
when it omits at least two rounds. No exceptional vector family is needed. -/

noncomputable section
namespace P14OrdinaryRoundCover
open P14CyclicArc P14CyclicOffsetIntervalCover P14BicliqueComplementConnection
open scoped BigOperators

def lengths {p : ℕ} (R : Fin p → ℕ) (i : ℕ) : ℕ :=
  if hi : i < p then R ⟨i, hi⟩ else 0

@[simp] theorem lengths_fin {p : ℕ} (R : Fin p → ℕ) (i : Fin p) :
    lengths R i.val = R i := by simp [lengths, i.isLt]

theorem lengths_sum {p : ℕ} (R : Fin p → ℕ) :
    prefixSum (lengths R) p = ∑ i, R i := by
  unfold prefixSum
  rw [← Fin.sum_univ_eq_sum_range]
  apply Finset.sum_congr rfl
  intro i _
  exact lengths_fin R i

theorem full_arc {q : ℕ} [NeZero q] (x : ZMod q) : x ∈ arc 0 q := by
  rw [mem_arc_iff 0 x q le_rfl, sub_zero]
  exact ZMod.val_lt x

theorem exists_cover {h p : ℕ} (hh : 1 ≤ h) (R : Fin p → ℕ)
    (hmax : ∀ j, R j + 2 ≤ 2 * h - 1)
    (htotal : (∑ j, R j) = 2 * h - 1) :
    ∃ H : Fin p → ℕ → ℕ → Prop,
      (∀ j {i i'}, H j i i' → H j i' i) ∧
      (∀ j i, ¬ H j i i) ∧
      (∀ j, BicliqueBound (H j) (Finset.range (2 * h)) (R j + 1)) ∧
      (∀ i i' : Fin (2 * h), i ≠ i' → ∃ j, H j i.val i'.val) := by
  classical
  letI : NeZero (2 * h - 1) := ⟨by omega⟩
  have ho : Odd (2 * h - 1) := ⟨h - 1, by omega⟩
  let f := P14AntipodalRoundLabels.label h
  let a : Fin p → ZMod (2 * h - 1) := fun j => (prefixSum (lengths R) j.val : ZMod (2 * h - 1))
  let H : Fin p → ℕ → ℕ → Prop := fun j i i' =>
    P14CyclicRoundBlock.Edge (a j) (R j) (f i) (f i')
  have hf : P14LayerBlockBiclique.LayerInjective (fun _ => True)
      (Finset.range (2 * h)) f := by
    intro i hi j hj _ he
    exact P14AntipodalRoundLabels.label_injective h hh i j
      (Finset.mem_range.mp hi) (Finset.mem_range.mp hj) he
  refine ⟨H, ?_, ?_, ?_, ?_⟩
  · intro j i i' he
    exact P14CyclicRoundBlock.edge_symmetric (a j) (R j) he
  · intro j i
    exact P14CyclicRoundBlock.edge_irreflexive (a j) (R j) (f i)
  · intro j
    have hb := P14LayerBlockBiclique.within_bound (fun _ => True)
      (Finset.range (2 * h)) f hf ho (a j) (R j) (hmax j)
    intro A hAS B hBS hA hB hd hedge
    exact hb A hAS B hBS hA hB hd (fun i hi i' hi' =>
      ⟨Or.inl ⟨True.intro, True.intro⟩, hedge i hi i' hi'⟩)
  · intro i i' hne
    have hlabels : f i.val ≠ f i'.val := by
      intro he
      exact hne (Fin.ext (P14AntipodalRoundLabels.label_injective h hh
        i.val i'.val i.isLt i'.isLt he))
    let c := P14CyclicRoundCenter.center ho (f i.val) (f i'.val)
    have hc : c ∈ arc 0 (prefixSum (lengths R) p) := by
      rw [lengths_sum, htotal]
      exact full_arc c
    obtain ⟨j, hj, he⟩ := (P14CyclicArcPartition.cover (lengths R) p 0 c).mp hc
    refine ⟨⟨j, hj⟩, (P14CyclicRoundCenter.edge_iff ho _ _ _ _).mpr ⟨hlabels, ?_⟩⟩
    simpa only [zero_add, lengths, dif_pos hj] using he

end P14OrdinaryRoundCover

end
end

section

/-! Real-row assembly into the exact complex-coordinate UPB convention.
This factors the already reviewed conversion in GP62266UPB through arbitrary
finite local dimensions. All graph coverage and spanning inputs stay explicit;
no vector existence or general mixed-dimensional theorem is asserted here.
-/
noncomputable section
namespace P14RealRowsUPB
open Matrix Submodule P14UPBAssembly
open scoped BigOperators

private lemma pair_eq_inner {k : ℕ} (x y : Space k) :
    (∑ r, star (x r) * y r) = inner ℂ x y := by
  simp only [PiLp.inner_apply, RCLike.inner_apply]
  apply Finset.sum_congr rfl
  intro r _
  exact mul_comm _ _

/-- A nonzero real family with spanning thresholds and a strict total killing
budget gives an actual orthogonal unextendible product family over ℂ. -/
theorem coordinates {p m : ℕ} (d c : Fin p → ℕ)
    (x : Fin m → (j : Fin p) → Fin (d j) → ℝ)
    (hnz : ∀ i j, x i j ≠ 0)
    (hspan : ∀ j (S : Finset (Fin m)), S.card = c j + 1 →
      span ℝ (Set.range (fun i : S => x i j)) = ⊤)
    (hcover : ∀ i i', i ≠ i' → ∃ j, dotProduct (x i j) (x i' j) = 0)
    (hbudget : (∑ j, c j) < Fintype.card (Fin m)) :
    ∃ v : Fin m → (j : Fin p) → Fin (d j) → ℂ,
      (∀ i j, v i j ≠ 0) ∧
      (∀ i i', i ≠ i' →
        ∃ j, (∑ r, star (v i j r) * v i' j r) = 0) ∧
      (∀ a : (j : Fin p) → Fin (d j) → ℂ, (∀ j, a j ≠ 0) →
        ∃ i, ∀ j, (∑ r, star (v i j r) * a j r) ≠ 0) := by
  classical
  let C (j : Fin p) : (Fin (d j) → ℂ) ≃ₗ[ℂ] Space (d j) :=
    (WithLp.linearEquiv 2 ℂ (Fin (d j) → ℂ)).symm
  let y : Fin m → (j : Fin p) → Space (d j) :=
    fun i j => C j (P14RealComplex.embed (x i j))
  have hp (i i' : Fin m) (j : Fin p) :
      inner ℂ (y i j) (y i' j) = ((dotProduct (x i j) (x i' j) : ℝ) : ℂ) := by
    simpa [y, C, dotProduct, PiLp.inner_apply, RCLike.inner_apply, mul_comm] using
      P14RealComplex.pair (x i j) (x i' j)
  have hynz (i : Fin m) (j : Fin p) : y i j ≠ 0 := by
    intro hi
    apply hnz i j
    apply P14RealComplex.embed_injective
    have hz := (C j).map_eq_zero_iff.mp hi
    simpa only [map_zero] using hz
  have hys : ∀ j, SpansEvery (fun i => y i j) (c j + 1) := by
    intro j S hS
    have hc := P14RealComplex.spanning (fun i : S => x i j) (hspan j S hS)
    have hm := congrArg (Submodule.map (C j).toLinearMap) hc
    simpa [y, Submodule.map_span, ← Set.range_comp, Function.comp_def,
      Submodule.map_top, LinearMap.range_eq_top.mpr (C j).surjective] using hm
  have hs := survivor_of_spanning d c y hbudget hys
  refine ⟨fun i j => WithLp.ofLp (y i j), ?_, ?_, ?_⟩
  · intro i j hzero
    exact hynz i j ((WithLp.ofLp_eq_zero 2).mp hzero)
  · intro i i' hii'
    obtain ⟨j, hj⟩ := hcover i i' hii'
    refine ⟨j, ?_⟩
    rw [pair_eq_inner, hp, hj, Complex.ofReal_zero]
  · intro a ha
    let aE : (j : Fin p) → Space (d j) := fun j => WithLp.toLp 2 (a j)
    have haE : ∀ j, aE j ≠ 0 := by
      intro j hzero
      exact ha j ((WithLp.toLp_eq_zero 2).mp hzero)
    obtain ⟨i, hi⟩ := hs aE haE
    refine ⟨i, ?_⟩
    intro j
    change (∑ r, star (y i j r) * aE j r) ≠ 0
    rw [pair_eq_inner]
    exact hi j

end P14RealRowsUPB
end
end

section

/-! Assemble actual complex UPB coordinates from an explicit finite graph
cover satisfying the general-position biclique bounds. Graph existence is
an input here; this theorem does not assert covers for arbitrary dimensions. -/

noncomputable section
namespace P14GenericGraphUPB
open P14GenericFiniteRows P14BicliqueComplementConnection
open scoped BigOperators

theorem coordinates {p m : ℕ} (d : Fin p → ℕ)
    (H : Fin p → ℕ → ℕ → Prop)
    (hd : ∀ j, 1 ≤ d j)
    (hs : ∀ j {a b}, H j a b → H j b a)
    (hr : ∀ j a, ¬ H j a a)
    (hbound : ∀ j, BicliqueBound (H j) (Finset.range m) (d j))
    (hcover : ∀ (i i' : Fin m), i ≠ i' → ∃ j, H j i.val i'.val)
    (hbudget : (∑ j, (d j - 1)) < m) :
    ∃ v : Fin m → (j : Fin p) → Fin (d j) → ℂ,
      (∀ i j, v i j ≠ 0) ∧
      (∀ i i', i ≠ i' →
        ∃ j, (∑ r, star (v i j r) * v i' j r) = 0) ∧
      (∀ a : (j : Fin p) → Fin (d j) → ℂ, (∀ j, a j ≠ 0) →
        ∃ i, ∀ j, (∑ r, star (v i j r) * a j r) ≠ 0) := by
  classical
  have hex := fun j => exists_fin_rows (H j) (hs j) (hr j) (d j) m (hd j) (hbound j)
  choose x hnz horth hspan using hex
  apply P14RealRowsUPB.coordinates d (fun j => d j - 1) (fun i j => x j i)
  · exact fun i j => hnz j i
  · intro j A hA
    apply hspan j A
    exact hA.trans (Nat.sub_add_cancel (hd j))
  · intro i i' hne
    obtain ⟨j, hj⟩ := hcover i i' hne
    exact ⟨j, horth j i i' hj⟩
  · simpa using hbudget

end P14GenericGraphUPB

end
end

section

/-! The entire odd-total-deficit case of the corrected root. The graph
cover's omitted-round hypotheses follow from the original dimension
conditions and the exclusion of a bipartite qubit. The construction uses
one plus the total deficit, within the requested two-plus ceiling. -/

noncomputable section
namespace P14OddDeficitCanonicalRegion
open P14CanonicalUPBTransport
open scoped BigOperators

theorem deficit_gap {p : ℕ} (hp : 2 ≤ p) (d : Fin p → ℕ)
    (hd : ∀ j, 2 ≤ d j) (hbi : ¬ (p = 2 ∧ ∃ j, d j = 2)) (j : Fin p) :
    (d j - 1) + 2 ≤ ∑ i, (d i - 1) := by
  classical
  let S := Finset.univ.erase j
  have hcard : S.card = p - 1 := by simp [S]
  have hsum : (∑ i ∈ S, (d i - 1)) + (d j - 1) = ∑ i, (d i - 1) :=
    Finset.sum_erase_add Finset.univ (fun i => d i - 1) (Finset.mem_univ j)
  have hrest : 2 ≤ ∑ i ∈ S, (d i - 1) := by
    by_cases hp3 : 3 ≤ p
    · have hl : S.card ≤ ∑ i ∈ S, (d i - 1) := by
        calc
          S.card = ∑ i ∈ S, (1 : ℕ) := by simp
          _ ≤ ∑ i ∈ S, (d i - 1) := Finset.sum_le_sum (fun i _ => by
            have hi := hd i
            omega)
      omega
    · have hp2 : p = 2 := by omega
      have hi : ∀ i, 2 ≤ d i - 1 := by
        intro i
        have hdi := hd i
        by_contra h
        exact hbi ⟨hp2, i, by omega⟩
      have hl : 2 * S.card ≤ ∑ i ∈ S, (d i - 1) := by
        calc
          2 * S.card = ∑ i ∈ S, (2 : ℕ) := by simp [Nat.mul_comm]
          _ ≤ ∑ i ∈ S, (d i - 1) := Finset.sum_le_sum (fun i _ => hi i)
      omega
  omega

theorem canonical {p : ℕ} (hp : 2 ≤ p) (d : Fin p → ℕ)
    (hd : ∀ j, 2 ≤ d j) (hbi : ¬ (p = 2 ∧ ∃ j, d j = 2))
    (hodd : Odd (∑ j, (d j - 1))) : Conclusion p d := by
  classical
  obtain ⟨r, hr⟩ := hodd
  let h := r + 1
  let R : Fin p → ℕ := fun j => d j - 1
  have hh : 1 ≤ h := by dsimp [h]; omega
  have ht : (∑ j, R j) = 2 * h - 1 := by
    dsimp [R, h]
    omega
  have hm : ∀ j, R j + 2 ≤ 2 * h - 1 := by
    intro j
    rw [← ht]
    exact deficit_gap hp d hd hbi j
  obtain ⟨H, hs, hi, hb, hc⟩ := P14OrdinaryRoundCover.exists_cover hh R hm ht
  have hbound : ∀ j, P14BicliqueComplementConnection.BicliqueBound
      (H j) (Finset.range (2 * h)) (d j) := by
    intro j
    have he : R j + 1 = d j := by
      have hj := hd j
      dsimp [R]
      omega
    simpa only [he] using hb j
  have hv := P14GenericGraphUPB.coordinates d H (fun j => by have hj := hd j; omega)
    hs hi hbound hc (by change (∑ j, R j) < 2 * h; rw [ht]; omega)
  refine ⟨2 * h, ?_, hv⟩
  dsimp [h]
  omega

/-- A bipartite example outside the earlier below-half-order region. -/
theorem three_four : Conclusion 2 ![3, 4] := by
  apply canonical (by omega)
  · intro j
    fin_cases j <;> norm_num
  · rintro ⟨_, j, hj⟩
    fin_cases j <;> norm_num at hj
  · exact ⟨2, by norm_num [Fin.sum_univ_succ]⟩

end P14OddDeficitCanonicalRegion

end
end

section

/-! Explicit qubit rays indexed by a nonnegative integer and a type bit.
The two types are (1,t) and (t,-1). Distinct labels give distinct rays,
so a nonzero complex test can annihilate at most one label, even when
many product rows deliberately reuse that label. -/

noncomputable section
namespace P14QubitRayLabels
open scoped BigOperators

abbrev Label := ℕ × Bool

def ray : Label → Fin 2 → ℂ
  | (t, false) => ![1, (t : ℂ)]
  | (t, true) => ![(t : ℂ), -1]

def pair (x y : Fin 2 → ℂ) : ℂ := ∑ i, star (x i) * y i

theorem ray_ne_zero (l : Label) : ray l ≠ 0 := by
  rcases l with ⟨t, b⟩
  cases b
  · intro h
    have h' := congrFun h 0
    simpa [ray] using h'
  · intro h
    have h' := congrFun h 1
    simpa [ray] using h'

theorem pair_false (t : ℕ) (y : Fin 2 → ℂ) :
    pair (ray (t, false)) y = y 0 + (t : ℂ) * y 1 := by
  simp [pair, ray, Fin.sum_univ_two]

theorem pair_true (t : ℕ) (y : Fin 2 → ℂ) :
    pair (ray (t, true)) y = (t : ℂ) * y 0 - y 1 := by
  simp [pair, ray, Fin.sum_univ_two, sub_eq_add_neg]

theorem opposite_pair (t : ℕ) (b : Bool) :
    pair (ray (t, b)) (ray (t, !b)) = 0 := by
  cases b <;> simp [pair, ray, Fin.sum_univ_two]

private theorem zero_of_coordinates (y : Fin 2 → ℂ)
    (h0 : y 0 = 0) (h1 : y 1 = 0) : y = 0 := by
  funext i
  fin_cases i <;> assumption

private theorem false_false_unique (s t : ℕ) (y : Fin 2 → ℂ) (hy : y ≠ 0)
    (hs : y 0 + (s : ℂ) * y 1 = 0)
    (ht : y 0 + (t : ℂ) * y 1 = 0) : s = t := by
  by_contra hst
  have hstC : (s : ℂ) - (t : ℂ) ≠ 0 := sub_ne_zero.mpr (by exact_mod_cast hst)
  have hmul : ((s : ℂ) - (t : ℂ)) * y 1 = 0 := by linear_combination hs - ht
  have h1 : y 1 = 0 := (mul_eq_zero.mp hmul).resolve_left hstC
  have h0 : y 0 = 0 := by simpa [h1] using hs
  exact hy (zero_of_coordinates y h0 h1)

private theorem true_true_unique (s t : ℕ) (y : Fin 2 → ℂ) (hy : y ≠ 0)
    (hs : (s : ℂ) * y 0 - y 1 = 0)
    (ht : (t : ℂ) * y 0 - y 1 = 0) : s = t := by
  by_contra hst
  have hstC : (s : ℂ) - (t : ℂ) ≠ 0 := sub_ne_zero.mpr (by exact_mod_cast hst)
  have hmul : ((s : ℂ) - (t : ℂ)) * y 0 = 0 := by linear_combination hs - ht
  have h0 : y 0 = 0 := (mul_eq_zero.mp hmul).resolve_left hstC
  have h1 : y 1 = 0 := by simpa [h0] using ht
  exact hy (zero_of_coordinates y h0 h1)

private theorem false_true_impossible (s t : ℕ) (y : Fin 2 → ℂ) (hy : y ≠ 0)
    (hs : y 0 + (s : ℂ) * y 1 = 0)
    (ht : (t : ℂ) * y 0 - y 1 = 0) : False := by
  have hpos : 0 < t * s + 1 := by omega
  have hc : (t : ℂ) * (s : ℂ) + 1 ≠ 0 := by exact_mod_cast (Nat.ne_of_gt hpos)
  have hmul : ((t : ℂ) * (s : ℂ) + 1) * y 1 = 0 := by
    linear_combination (t : ℂ) * hs - ht
  have h1 : y 1 = 0 := (mul_eq_zero.mp hmul).resolve_left hc
  have h0 : y 0 = 0 := by simpa [h1] using hs
  exact hy (zero_of_coordinates y h0 h1)

theorem killed_labels_equal (l l' : Label) (y : Fin 2 → ℂ) (hy : y ≠ 0)
    (hl : pair (ray l) y = 0) (hl' : pair (ray l') y = 0) : l = l' := by
  rcases l with ⟨s, b⟩
  rcases l' with ⟨t, b'⟩
  cases b <;> cases b'
  · have h := false_false_unique s t y hy (by simpa [pair_false] using hl)
      (by simpa [pair_false] using hl')
    exact congrArg (fun n => (n, false)) h
  · exact (false_true_impossible s t y hy (by simpa [pair_false] using hl)
      (by simpa [pair_true] using hl')).elim
  · exact (false_true_impossible t s y hy (by simpa [pair_false] using hl')
      (by simpa [pair_true] using hl)).elim
  · have h := true_true_unique s t y hy (by simpa [pair_true] using hl)
      (by simpa [pair_true] using hl')
    exact congrArg (fun n => (n, true)) h

/-- A class may be chosen even when the test kills no label. The implication
is intentionally one-way, allowing unused labels and repeated product rows. -/
theorem exists_killing_label (y : Fin 2 → ℂ) (hy : y ≠ 0) :
    ∃ l : Label, ∀ l', pair (ray l') y = 0 → l' = l := by
  classical
  by_cases h : ∃ l, pair (ray l) y = 0
  · obtain ⟨l, hl⟩ := h
    exact ⟨l, fun l' hl' => killed_labels_equal l' l y hy hl' hl⟩
  · exact ⟨(0, false), fun l hl => (h ⟨l, hl⟩).elim⟩

end P14QubitRayLabels

end
end

section

/-! The bounded degree allocation for the even half-order construction.
No internal block consumes all N available rounds: a saturated block is
replaced by N-1 rounds and one round in an odd-degree factor. -/

noncomputable section
namespace P14EvenLayerAllocation
open P14UnequalBlockAllocation
open scoped BigOperators

theorem bounded {ι : Type*} (S : Finset ι) (r : ι → ℕ) (N : ℕ)
    (hN : Even N) (h4 : 4 ≤ N)
    (hr : ∀ i ∈ S, 0 < r i) (hu : ∀ i ∈ S, r i ≤ N)
    (ho : ∃ i ∈ S, Odd (r i)) (ht : N ≤ ∑ i ∈ S, r i) :
    ∃ x : ι → ℕ, (∀ i ∈ S, Allowed (r i) (x i) ∧ x i ≤ N - 1) ∧
      (∑ i ∈ S, x i) = N := by
  classical
  obtain ⟨x, hx, hsum⟩ := allocate S r hr ho N ht
  by_cases hgood : ∀ i ∈ S, x i ≤ N - 1
  · exact ⟨x, fun i hi => ⟨hx i hi, hgood i hi⟩, hsum⟩
  · simp only [not_forall, _root_.not_imp] at hgood
    obtain ⟨i, hi, hbad⟩ := hgood
    have hri : r i = N := by
      have hxi := (hx i hi).1
      have hui := hu i hi
      omega
    obtain ⟨j, hj, hoj⟩ := ho
    have hji : j ≠ i := by
      intro heq
      subst j
      rw [hri] at hoj
      obtain ⟨a, ha⟩ := hN
      obtain ⟨b, hb⟩ := hoj
      omega
    let y : ι → ℕ := fun k => (if k = i then N - 1 else 0) + (if k = j then 1 else 0)
    refine ⟨y, ?_, ?_⟩
    · intro k hk
      by_cases hki : k = i
      · subst k
        have hy : y i = N - 1 := by simp [y, Ne.symm hji]
        rw [hy, hri]
        constructor
        · constructor <;> omega
        · exact le_rfl
      · by_cases hkj : k = j
        · subst k
          have hy : y j = 1 := by simp [y, hji]
          rw [hy]
          exact ⟨allowed_of_odd hoj (hr j hj), by omega⟩
        · have hy : y k = 0 := by simp [y, hki, hkj]
          rw [hy]
          have hrk := hr k hk
          constructor
          · constructor <;> omega
          · omega
    · have spike_sum (k : ι) (hk : k ∈ S) (v : ℕ) :
          (∑ u ∈ S, if u = k then v else 0) = v := by
        rw [Finset.sum_eq_single k]
        · simp
        · intro u hu huk
          simp [huk]
        · exact fun h => False.elim (h hk)
      simp only [y, Finset.sum_add_distrib]
      rw [spike_sum i hi, spike_sum j hj]
      omega

theorem split_allocation {ι : Type*} (S : Finset ι) (r : ι → ℕ) (N : ℕ)
    (hN : Even N) (h4 : 4 ≤ N)
    (hr : ∀ i ∈ S, 0 < r i) (hu : ∀ i ∈ S, r i ≤ N)
    (ho : ∃ i ∈ S, Odd (r i)) (ht : N ≤ ∑ i ∈ S, r i) :
    ∃ s t : ι → ℕ,
      (∀ i ∈ S, s i + t i = r i ∧ s i ≠ t i ∧ s i ≤ N - 1) ∧
      (∑ i ∈ S, s i) = N ∧ (∑ i ∈ S, t i) = (∑ i ∈ S, r i) - N := by
  obtain ⟨s, hs, hsum⟩ := bounded S r N hN h4 hr hu ho ht
  have hparts : (∑ i ∈ S, s i) + (∑ i ∈ S, (r i - s i)) = ∑ i ∈ S, r i := by
    rw [← Finset.sum_add_distrib]
    apply Finset.sum_congr rfl
    intro i hi
    have h := (hs i hi).1.1
    omega
  refine ⟨s, fun i => r i - s i, ?_, hsum, ?_⟩
  · intro i hi
    dsimp only
    have h := hs i hi
    exact ⟨by have hle := h.1.1; omega, h.1.2, h.2⟩
  · dsimp only
    omega

theorem even_half_order {ι : Type*} (S : Finset ι) (r : ι → ℕ) (q d : ℕ)
    (hq : Even q) (hq6 : 6 ≤ q)
    (hr : ∀ i ∈ S, 0 < r i) (hu : ∀ i ∈ S, r i ≤ q - 2)
    (ho : ∃ i ∈ S, Odd (r i))
    (ht : (∑ i ∈ S, r i) = (q - 2) + (q - d + 1)) :
    ∃ s t : ι → ℕ,
      (∀ i ∈ S, s i + t i = r i ∧ s i ≠ t i ∧ s i ≤ q - 3) ∧
      (∑ i ∈ S, s i) = q - 2 ∧ (∑ i ∈ S, t i) = q - d + 1 := by
  have hN : Even (q - 2) := by
    obtain ⟨k, hk⟩ := hq
    exact ⟨k - 1, by omega⟩
  obtain ⟨s, t, hst, hs, ht'⟩ := split_allocation S r (q - 2) hN (by omega) hr hu ho (by omega)
  refine ⟨s, t, ?_, hs, ?_⟩
  · intro i hi
    have h := hst i hi
    exact ⟨h.1, h.2.1, by have hb := h.2.2; omega⟩
  · omega

end P14EvenLayerAllocation

end
end

section

/-! The even-half-order partition theorem with actual graph functions,
prescribed local biclique bounds, exact coverage and edge uniqueness.
The checked allocation supplies every block size used by the construction. -/

noncomputable section
namespace P14EvenRoundPartition
open P14LayerBlockBiclique P14BicliqueComplementConnection P14CyclicOffsetIntervalCover
open scoped BigOperators

theorem exists_partition (q d m : ℕ) [NeZero q] [NeZero (q - 1)]
    (hq : Even q) (hq6 : 6 ≤ q) (hd : 2 ≤ d) (hdq : d ≤ q - 2)
    (C : ℕ → Prop) (S : Finset ℕ)
    (f : ℕ → Option (ZMod (q - 1))) (g : ℕ → ZMod q)
    (hf : LayerInjective C S f) (hg : LayerInjective C S g)
    (R : ℕ → ℕ) (hR : ∀ i < m, 0 < R i) (hRu : ∀ i < m, R i ≤ q - 2)
    (ho : ∃ i, i < m ∧ Odd (R i))
    (htotal : (∑ i ∈ Finset.range m, R i) = (q - 2) + (q - d + 1))
    (b : ZMod q) :
    ∃ H : ℕ → ℕ → ℕ → Prop,
      (∀ i < m, (∀ {x y}, H i x y → H i y x) ∧ (∀ x, ¬ H i x x) ∧
        BicliqueBound (H i) S (R i + 1)) ∧
      (∀ x y, Edge C f g (1 : ZMod (q - 1)) b (q - 2) (q - d + 1) x y ↔
        ∃ i, i < m ∧ H i x y) ∧
      (∀ i < m, ∀ j < m, i ≠ j → ∀ x y, H i x y → H j x y → False) := by
  obtain ⟨s, t, hst, hs, ht⟩ := P14EvenLayerAllocation.even_half_order (Finset.range m) R q d hq hq6
    (fun i hi => hR i (Finset.mem_range.mp hi))
    (fun i hi => hRu i (Finset.mem_range.mp hi))
    (by obtain ⟨i, hi, hoi⟩ := ho; exact ⟨i, Finset.mem_range.mpr hi, hoi⟩) htotal
  change prefixSum s m = q - 2 at hs
  change prefixSum t m = q - d + 1 at ht
  have hodd : Odd (q - 1) := by
    obtain ⟨k, hk⟩ := hq
    exact ⟨k - 1, by omega⟩
  have hsb : ∀ i < m, s i + 2 ≤ q - 1 := by
    intro i hi
    have h := (hst i (Finset.mem_range.mpr hi)).2.2
    omega
  have htb : ∀ i < m, t i < q := by
    intro i hi
    have h := P14CyclicArcPartition.prefix_end t hi
    rw [ht] at h
    omega
  obtain ⟨H, hH, hcover, hdis⟩ := P14LayerBlockPartition.partition C S f g hf hg hodd s t m 1 b
    hsb htb (fun i hi => (hst i (Finset.mem_range.mpr hi)).2.1)
    (by rw [hs]; omega) (by rw [ht]; omega)
  refine ⟨H, ?_, ?_, hdis⟩
  · intro i hi
    have h := hH i hi
    have he := (hst i (Finset.mem_range.mpr hi)).1
    refine ⟨h.1, h.2.1, ?_⟩
    have hb := h.2.2
    rwa [he] at hb
  · rwa [hs, ht] at hcover

end P14EvenRoundPartition

end
end

section

/-! Concrete partition on two layers of 2h vertices. No label injection
or matching alignment is an input: both are proved from explicit labels.
Available edges are the non-antipodal edges within either layer and a
specified consecutive interval of cross-layer shifts. -/

noncomputable section
namespace P14ConcreteEvenPartition
open P14LayerBlockBiclique P14TwoLayerBiclique P14BicliqueComplementConnection
open scoped BigOperators

def index (q i : ℕ) : ℕ := if i < q then i else i - q

def Side (q i : ℕ) : Prop := i < q

def roundLabel (h i : ℕ) : Option (ZMod (2 * h - 1)) :=
  P14AntipodalRoundLabels.label h (index (2 * h) i)

def crossLabel (q i : ℕ) : ZMod q := (index q i : ZMod q)

def Available (h : ℕ) (b : ZMod (2 * h)) (L i j : ℕ) : Prop :=
  (Within (Side (2 * h)) i j ∧ index (2 * h) i ≠ index (2 * h) j ∧
    index (2 * h) j ≠ P14AntipodalRoundLabels.antipode h (index (2 * h) i)) ∨
  CrossEdge (Side (2 * h)) (crossLabel (2 * h)) b L i j

theorem index_lt (q i : ℕ) (hi : i < 2 * q) : index q i < q := by
  by_cases h : i < q <;> simp only [index, h, ite_true, ite_false] <;> omega

theorem index_injective (q i j : ℕ) (hi : i < 2 * q) (hj : j < 2 * q)
    (hc : Side q i ↔ Side q j) (he : index q i = index q j) : i = j := by
  change (i < q ↔ j < q) at hc
  by_cases h : i < q
  · have h' := hc.mp h
    simpa only [index, if_pos h, if_pos h'] using he
  · have h' : ¬ j < q := fun hjq => h (hc.mpr hjq)
    simp only [index, if_neg h, if_neg h'] at he
    omega

theorem labels_injective (h : ℕ) (hh : 1 ≤ h) :
    LayerInjective (Side (2 * h)) (Finset.range (4 * h)) (roundLabel h) ∧
      LayerInjective (Side (2 * h)) (Finset.range (4 * h)) (crossLabel (2 * h)) := by
  constructor
  · intro i hi j hj hc he
    have hi' : i < 2 * (2 * h) := by have hv := Finset.mem_range.mp hi; omega
    have hj' : j < 2 * (2 * h) := by have hv := Finset.mem_range.mp hj; omega
    apply index_injective (2 * h) i j hi' hj' hc
    exact P14AntipodalRoundLabels.label_injective h hh _ _
      (index_lt _ _ hi') (index_lt _ _ hj') he
  · intro i hi j hj hc he
    have hi' : i < 2 * (2 * h) := by have hv := Finset.mem_range.mp hi; omega
    have hj' : j < 2 * (2 * h) := by have hv := Finset.mem_range.mp hj; omega
    apply index_injective (2 * h) i j hi' hj' hc
    have hv := congrArg ZMod.val he
    change ((index (2 * h) i : ZMod (2 * h))).val = ((index (2 * h) j : ZMod (2 * h))).val at hv
    rwa [ZMod.val_natCast_of_lt (index_lt _ _ hi'), ZMod.val_natCast_of_lt (index_lt _ _ hj')] at hv

theorem available_iff (h : ℕ) [NeZero (2 * h)] [NeZero (2 * h - 1)] (hh : 1 ≤ h)
    (b : ZMod (2 * h)) (L i j : ℕ) (hi : i < 4 * h) (hj : j < 4 * h) :
    Edge (Side (2 * h)) (roundLabel h) (crossLabel (2 * h)) 1 b (2 * h - 2) L i j ↔
      Available h b L i j := by
  have hi' := index_lt (2 * h) i (show i < 2 * (2 * h) by omega)
  have hj' := index_lt (2 * h) j (show j < 2 * (2 * h) by omega)
  change ((Within (Side (2 * h)) i j ∧
    P14CyclicRoundBlock.Edge 1 (2 * h - 2)
      (P14AntipodalRoundLabels.label h (index (2 * h) i))
      (P14AntipodalRoundLabels.label h (index (2 * h) j))) ∨ _) ↔ _
  rw [P14AntipodalRoundLabels.remaining_iff h hh _ _ hi' hj']
  rfl

theorem partition (h d m : ℕ) [NeZero (2 * h)] [NeZero (2 * h - 1)]
    (hh : 3 ≤ h) (hd : 2 ≤ d) (hdu : d ≤ 2 * h - 2)
    (R : ℕ → ℕ) (hR : ∀ i < m, 0 < R i) (hRu : ∀ i < m, R i ≤ 2 * h - 2)
    (ho : ∃ i, i < m ∧ Odd (R i))
    (htotal : (∑ i ∈ Finset.range m, R i) = (2 * h - 2) + (2 * h - d + 1))
    (b : ZMod (2 * h)) :
    ∃ H : ℕ → ℕ → ℕ → Prop,
      (∀ i < m, (∀ {x y}, H i x y → H i y x) ∧ (∀ x, ¬ H i x x) ∧
        BicliqueBound (H i) (Finset.range (4 * h)) (R i + 1)) ∧
      (∀ x < 4 * h, ∀ y < 4 * h, Available h b (2 * h - d + 1) x y ↔
        ∃ i, i < m ∧ H i x y) ∧
      (∀ i < m, ∀ j < m, i ≠ j → ∀ x y, H i x y → H j x y → False) := by
  have hlabels := labels_injective h (by omega)
  obtain ⟨H, hH, hcover, hdis⟩ := P14EvenRoundPartition.exists_partition (2 * h) d m
    ⟨h, by omega⟩ (by omega) hd hdu (Side (2 * h)) (Finset.range (4 * h))
    (roundLabel h) (crossLabel (2 * h)) hlabels.1 hlabels.2 R hR hRu ho htotal b
  refine ⟨H, hH, ?_, hdis⟩
  intro x hx y hy
  exact (available_iff h (by omega) b (2 * h - d + 1) x y hx hy).symm.trans (hcover x y)

end P14ConcreteEvenPartition

end
end

section

/-! Explicit exceptional qubit rows for two layers of even order.
Each label occurs at most once per layer, and antipodal within-layer
pairs and equal-index cross-layer pairs are orthogonal. -/

noncomputable section
namespace P14EvenQubitLabels
open P14QubitRayLabels P14ConcreteEvenPartition P14TwoLayerBiclique
open scoped BigOperators

def label (h i : ℕ) : Label :=
  if i < h then (i, false)
  else if i < 2 * h then (i - h, true)
  else if i < 3 * h then (i - 2 * h, true)
  else (i - 3 * h, false)

theorem layer_injective (h i j : ℕ) (hi : i < 4 * h) (hj : j < 4 * h)
    (hc : Side (2 * h) i ↔ Side (2 * h) j)
    (he : label h i = label h j) : i = j := by
  change (i < 2 * h ↔ j < 2 * h) at hc
  unfold label at he
  split_ifs at he <;> simp_all <;> omega

theorem within_opposite (h i j : ℕ) (hi : i < 4 * h) (hj : j < 4 * h)
    (hc : Within (Side (2 * h)) i j)
    (he : index (2 * h) j = P14AntipodalRoundLabels.antipode h (index (2 * h) i)) :
    label h j = ((label h i).1, !(label h i).2) := by
  rcases hc with ⟨hci, hcj⟩ | ⟨hci, hcj⟩
  all_goals
    simp only [Side] at hci hcj
    simp only [index, P14AntipodalRoundLabels.antipode] at he
    unfold label
    split_ifs at * <;> simp_all <;> omega

theorem cross_opposite (h i j : ℕ) (hi : i < 4 * h) (hj : j < 4 * h)
    (hc : Across (Side (2 * h)) i j)
    (he : index (2 * h) j = index (2 * h) i) :
    label h j = ((label h i).1, !(label h i).2) := by
  rcases hc with ⟨hci, hcj⟩ | ⟨hci, hcj⟩
  all_goals
    simp only [Side] at hci hcj
    simp only [index] at he
    unfold label
    split_ifs at * <;> simp_all <;> omega

def row (h : ℕ) (i : Fin (4 * h)) : Fin 2 → ℂ := ray (label h i.val)

theorem row_ne_zero (h : ℕ) (i : Fin (4 * h)) : row h i ≠ 0 := ray_ne_zero _

theorem opposite_orthogonal (h : ℕ) (i j : Fin (4 * h))
    (he : label h j.val = ((label h i.val).1, !(label h i.val).2)) :
    pair (row h i) (row h j) = 0 := by
  unfold row
  rw [he]
  exact opposite_pair _ _

theorem killing_bound (h : ℕ) (y : Fin 2 → ℂ) (hy : y ≠ 0)
    (S : Finset (Fin (4 * h))) (hS : ∀ i ∈ S, pair (row h i) y = 0) :
    S.card ≤ 2 := by
  classical
  have hcap : ∀ b : Bool, (S.filter (fun i => decide (i.val < 2 * h) = b)).card ≤ 1 := by
    intro b
    apply Finset.card_le_one.mpr
    intro i hi j hj
    obtain ⟨hiS, hib⟩ := Finset.mem_filter.mp hi
    obtain ⟨hjS, hjb⟩ := Finset.mem_filter.mp hj
    apply Fin.ext
    apply layer_injective h i.val j.val i.isLt j.isLt
    · exact decide_eq_decide.mp (hib.trans hjb.symm)
    · exact killed_labels_equal _ _ y hy (hS i hiS) (hS j hjS)
  have ht := hcap true
  have hf := hcap false
  simp at ht hf
  have hc := Finset.card_filter_add_card_filter_not (s := S) (fun i => i.val < 2 * h)
  simp only [not_lt] at hc
  omega

end P14EvenQubitLabels


end
end

section

/-! The eight-row exceptional qubit leaves a matching inside its two ray
components and all cross-component pairs. Cross pairs use the existing
four-cycle index and cyclic-interval biclique bound. -/

noncomputable section
namespace P14EightRowCover
open P14BicliqueComplementConnection P14CyclicArc P14LayerBlockBiclique
open scoped BigOperators

def C (i : ℕ) : Prop := i % 2 = 0
def g (i : ℕ) : ZMod 4 := (i / 2 : ℕ)
def M (i j : ℕ) : Prop :=
  i < 8 ∧ j < 8 ∧ i ≠ j ∧ P14EvenQubitLabels.label 2 i = P14EvenQubitLabels.label 2 j

theorem matching_symmetric {i j : ℕ} (h : M i j) : M j i :=
  ⟨h.2.1, h.1, Ne.symm h.2.2.1, h.2.2.2.symm⟩

theorem matching_irreflexive (i : ℕ) : ¬ M i i := fun h => h.2.2.1 rfl

theorem matching_unique {i j k : ℕ} (hj : M i j) (hk : M i k) : j = k := by
  rcases hj with ⟨hi, hj, hij, he⟩
  rcases hk with ⟨_, hk, hik, he'⟩
  unfold P14EvenQubitLabels.label at he he'
  split_ifs at he he' <;> simp_all <;> omega

theorem matching_bound : BicliqueBound M (Finset.range 8) 2 := by
  classical
  intro A _ B _ hA hB _ hedge
  obtain ⟨a, ha⟩ := hA
  obtain ⟨b, hb⟩ := hB
  have hAc : A.card ≤ 1 := Finset.card_le_one.mpr (fun i hi j hj =>
    matching_unique (matching_symmetric (hedge i hi b hb))
      (matching_symmetric (hedge j hj b hb)))
  have hBc : B.card ≤ 1 := Finset.card_le_one.mpr (fun i hi j hj =>
    matching_unique (hedge a ha i hi) (hedge a ha j hj))
  omega

theorem labels_injective : LayerInjective C (Finset.range 8) g := by
  intro i hi j hj hc he
  have hi8 := Finset.mem_range.mp hi
  have hj8 := Finset.mem_range.mp hj
  have hv := congrArg ZMod.val he
  change (((i / 2 : ℕ) : ZMod 4)).val = (((j / 2 : ℕ) : ZMod 4)).val at hv
  rw [ZMod.val_natCast_of_lt (by omega), ZMod.val_natCast_of_lt (by omega)] at hv
  change (i % 2 = 0 ↔ j % 2 = 0) at hc
  omega

theorem cross_bound (a : ZMod 4) (l : ℕ) (hl : l < 4) :
    BicliqueBound (CrossEdge C g a l) (Finset.range 8) (l + 1) :=
  P14LayerBlockBiclique.cross_bound C (Finset.range 8) g labels_injective a l hl

theorem same_component (i j : Fin 8) (hne : i ≠ j) (hc : C i.val ↔ C j.val) :
    M i.val j.val ∨ P14EvenQubitLabels.label 2 j.val =
      ((P14EvenQubitLabels.label 2 i.val).1, !(P14EvenQubitLabels.label 2 i.val).2) := by
  fin_cases i <;> fin_cases j <;> simp_all [C, M, P14EvenQubitLabels.label]

theorem pair_cover (i j : Fin 8) (hne : i ≠ j) :
    M i.val j.val ∨ CrossEdge C g 0 4 i.val j.val ∨
      (∑ r, star (P14EvenQubitLabels.row 2 i r) * P14EvenQubitLabels.row 2 j r) = 0 := by
  by_cases hc : C i.val ↔ C j.val
  · rcases same_component i j hne hc with hm | he
    · exact Or.inl hm
    · exact Or.inr (Or.inr (P14EvenQubitLabels.opposite_orthogonal 2 i j he))
  · have ha : P14TwoLayerBiclique.Across C i.val j.val := by
      unfold P14TwoLayerBiclique.Across
      tauto
    have full (z : ZMod 4) : z ∈ arc 0 4 := by
      rw [mem_arc_iff 0 z 4 le_rfl, sub_zero]
      exact ZMod.val_lt z
    apply Or.inr
    apply Or.inl
    rcases ha with ⟨hi, hj⟩ | ⟨hi, hj⟩
    · exact Or.inl ⟨hi, hj, full _⟩
    · exact Or.inr ⟨hi, hj, full _⟩

end P14EightRowCover

end
end

section

/-! Eight actual product rows for two qubits plus ordinary dimensions R+1,
where the positive cross-block lengths R sum to four and are below four. -/

noncomputable section
namespace P14EightRowUPB
open P14EightRowCover P14LayerBlockBiclique P14CyclicOffsetIntervalCover
open P14CanonicalUPBTransport
open scoped BigOperators

def dimensions {n : ℕ} (R : Fin n → ℕ) : Fin (n + 2) → ℕ :=
  Fin.cases 2 (Fin.cases 2 (fun j => R j + 1))
def caps {n : ℕ} (R : Fin n → ℕ) : Fin (n + 2) → ℕ :=
  Fin.cases 2 (Fin.cases 1 R)
def lengths {n : ℕ} (R : Fin n → ℕ) (i : ℕ) : ℕ :=
  if hi : i < n then R ⟨i, hi⟩ else 0

@[simp] theorem lengths_fin {n : ℕ} (R : Fin n → ℕ) (i : Fin n) :
    lengths R i.val = R i := by simp [lengths, i.isLt]

theorem lengths_sum {n : ℕ} (R : Fin n → ℕ) :
    prefixSum (lengths R) n = ∑ i, R i := by
  unfold prefixSum
  rw [← Fin.sum_univ_eq_sum_range]
  apply Finset.sum_congr rfl
  intro i _
  exact lengths_fin R i

theorem canonical {n : ℕ} (R : Fin n → ℕ) (hmax : ∀ j, R j < 4)
    (htotal : (∑ j, R j) = 4) : Conclusion (n + 2) (dimensions R) := by
  classical
  let a : Fin n → ZMod 4 := fun j => (prefixSum (lengths R) j.val : ZMod 4)
  let H := fun j : Fin n => CrossEdge C g (a j) (R j)
  obtain ⟨w, hwNZ, hwOrth, hwSpan⟩ := P14GenericExceptionalUPB.complex_rows M
    matching_symmetric matching_irreflexive 2 8 (by omega) matching_bound
  have hx : ∀ j : Fin n, ∃ x : Fin 8 → Fin (R j + 1) → ℂ,
      (∀ i, x i ≠ 0) ∧
      (∀ i i' : Fin 8, H j i.val i'.val → (∑ r, star (x i r) * x i' r) = 0) ∧
      (∀ A : Finset (Fin 8), A.card = R j + 1 →
        Submodule.span ℂ (Set.range (fun i : A => x i)) = ⊤) := by
    intro j
    apply P14GenericExceptionalUPB.complex_rows (H j) (cross_symmetric C g (a j) (R j))
      (fun i h => by rcases h with ⟨hi, hni, _⟩ | ⟨hni, hi, _⟩ <;> exact hni hi)
      (R j + 1) 8 (by omega)
    exact P14EightRowCover.cross_bound (a j) (R j) (hmax j)
  choose x hxNZ hxOrth hxSpan using hx
  have hcover : ∀ i i', CrossEdge C g 0 4 i i' → ∃ j : Fin n, H j i i' := by
    intro i i' he
    have ht : prefixSum (lengths R) n = 4 := (lengths_sum R).trans htotal
    have he' : CrossEdge C g 0 (prefixSum (lengths R) n) i i' := by
      simpa only [ht] using he
    obtain ⟨j, hj, he⟩ := (P14LayerBlockPartition.cross_cover C g (lengths R) n 0 i i').mp he'
    refine ⟨⟨j, hj⟩, ?_⟩
    simpa only [zero_add, lengths, dif_pos hj] using he
  let v : Fin 8 → (j : Fin (n + 2)) → Fin (dimensions R j) → ℂ :=
    fun i => Fin.cases (P14EvenQubitLabels.row 2 i) (Fin.cases (w i) (fun j => x j i))
  refine ⟨8, ?_, v, ?_, ?_, ?_⟩
  · simp [dimensions, Fin.sum_univ_succ, htotal]
  · intro i j
    refine Fin.cases ?_ (fun j => Fin.cases ?_ (fun j => ?_) j) j
    · exact P14EvenQubitLabels.row_ne_zero 2 i
    · exact hwNZ i
    · exact hxNZ j i
  · intro i i' hne
    rcases pair_cover i i' hne with hm | hc | he
    · exact ⟨(0 : Fin (n + 1)).succ, hwOrth i i' hm⟩
    · obtain ⟨j, hj⟩ := hcover i.val i'.val hc
      exact ⟨j.succ.succ, hxOrth j i i' hj⟩
    · exact ⟨0, he⟩
  · apply P14ComplexKillingBudget.survivor (dimensions R) (caps R) v
    · simp [caps, Fin.sum_univ_succ, htotal]
    · intro j
      refine Fin.cases ?_ (fun j => Fin.cases ?_ (fun j => ?_) j) j
      · intro y hy S hS
        exact P14EvenQubitLabels.killing_bound 2 y hy S hS
      · intro y hy S hS
        exact P14ComplexKillingBudget.of_spanning w hwSpan y hy S hS
      · intro y hy S hS
        exact P14ComplexKillingBudget.of_spanning (x j) (hxSpan j) y hy S hS

theorem two_qubits_two_qutrits : Conclusion 4 ![2, 2, 3, 3] := by
  have h := canonical ![2, 2] (by intro j; fin_cases j <;> norm_num)
    (by norm_num [Fin.sum_univ_succ])
  have hd : dimensions ![2, 2] = ![2, 2, 3, 3] := by
    funext j
    fin_cases j <;> rfl
  rwa [hd] at h

end P14EightRowUPB

end
end

section

/-! Every eight-row below-half-order tuple with an even factor is recognized
without supplying a factor permutation. Two qubits are forced by parity. -/

noncomputable section
namespace P14EightRowCanonicalRegion
open P14CanonicalUPBTransport
open scoped BigOperators

theorem canonical {p : ℕ} (hp : 2 ≤ p) (d : Fin p → ℕ)
    (hd : ∀ j, 2 ≤ d j) (hmax : ∀ j, d j ≤ 3)
    (hq : ∃ j, d j = 2) (hsum : (∑ j, (d j - 1)) = 6) : Conclusion p d := by
  classical
  cases p with
  | zero => omega
  | succ p =>
    cases p with
    | zero => omega
    | succ n =>
      obtain ⟨t, ht⟩ := hq
      let E : Fin (n + 2) ≃ Fin (n + 2) := Equiv.swap 0 t
      have hzero : d (E 0) = 2 := by simp [E, ht]
      have hE : (∑ j, (d (E j) - 1)) = 6 :=
        (E.sum_comp (fun j => d j - 1)).trans hsum
      have hsecond : ∃ u : Fin (n + 1), d (E u.succ) = 2 := by
        by_contra hu
        push Not at hu
        have hall : ∀ u : Fin (n + 1), d (E u.succ) = 3 := by
          intro u
          have h1 := hd (E u.succ)
          have h2 := hmax (E u.succ)
          have h3 := hu u
          omega
        have he : 1 + 2 * (n + 1) = 6 := by
          simpa [Fin.sum_univ_succ, hzero, hall, Nat.mul_comm] using hE
        omega
      obtain ⟨u, hu⟩ := hsecond
      let G : Fin (n + 2) ≃ Fin (n + 2) := Equiv.swap (0 : Fin (n + 1)).succ u.succ
      have hG0 : G 0 = 0 := Equiv.swap_apply_of_ne_of_ne
        (Ne.symm (Fin.succ_ne_zero _)) (Ne.symm (Fin.succ_ne_zero _))
      have hG1 : G (0 : Fin (n + 1)).succ = u.succ := by simp [G]
      let R : Fin n → ℕ := fun j => d (E (G j.succ.succ)) - 1
      have hm : ∀ j, R j < 4 := by
        intro j
        have hj := hmax (E (G j.succ.succ))
        dsimp [R]
        omega
      have hS : (∑ j, (d (E (G j)) - 1)) = 6 :=
        (G.sum_comp (fun j => d (E j) - 1)).trans hE
      have hR : (∑ j, R j) = 4 := by
        rw [Fin.sum_univ_succ, Fin.sum_univ_succ] at hS
        simp only [hG0, hG1, hzero, hu] at hS
        change 2 - 1 + (2 - 1 + (∑ j, R j)) = 6 at hS
        omega
      have hdim : P14EightRowUPB.dimensions R = fun j => d (E (G j)) := by
        funext j
        refine Fin.cases ?_ (fun j => Fin.cases ?_ (fun j => ?_) j) j
        · simp [P14EightRowUPB.dimensions, hG0, hzero]
        · change 2 = d (E (G (0 : Fin (n + 1)).succ))
          rw [hG1, hu]
        · change d (E (G j.succ.succ)) - 1 + 1 = d (E (G j.succ.succ))
          have hj := hd (E (G j.succ.succ))
          omega
      have hc : Conclusion (n + 2) (fun j => d (E (G j))) := by
        rw [← hdim]
        exact P14EightRowUPB.canonical R hm hR
      have hcE : Conclusion (n + 2) (fun j => d (E j)) := by
        have h := reindex (fun j => d (E (G j))) G hc
        simpa only [G, Equiv.swap_apply_self] using h
      have hf := reindex (fun j => d (E j)) E hcE
      simpa only [E, Equiv.swap_apply_self] using hf

theorem four_qubits_one_qutrit : Conclusion 5 ![2, 2, 2, 2, 3] := by
  apply canonical (by omega)
  · intro j
    fin_cases j <;> norm_num
  · intro j
    fin_cases j <;> norm_num
  · exact ⟨0, rfl⟩
  · norm_num [Fin.sum_univ_succ]

end P14EightRowCanonicalRegion

end
end

section

/-! Every distinct pair is either in the actual ordinary graph union or
orthogonal at the explicit exceptional qubit factor. -/

noncomputable section
namespace P14EvenQubitCover
open P14ConcreteEvenPartition P14TwoLayerBiclique P14LayerBlockBiclique
open P14EvenQubitLabels

theorem cross_labels_ne (h i j : ℕ) (hi : i < 4 * h) (hj : j < 4 * h)
    (hne : index (2 * h) i ≠ index (2 * h) j) :
    crossLabel (2 * h) i ≠ crossLabel (2 * h) j := by
  intro he
  apply hne
  have hv := congrArg ZMod.val he
  change ((index (2 * h) i : ZMod (2 * h))).val =
    ((index (2 * h) j : ZMod (2 * h))).val at hv
  rwa [ZMod.val_natCast_of_lt (index_lt _ _ (show i < 2 * (2 * h) by omega)),
    ZMod.val_natCast_of_lt (index_lt _ _ (show j < 2 * (2 * h) by omega))] at hv

theorem pair_cover (h : ℕ) [NeZero (2 * h)] (i j : Fin (4 * h)) (hne : i ≠ j) :
    Available h 1 (2 * h - 1) i.val j.val ∨
      P14QubitRayLabels.pair (row h i) (row h j) = 0 := by
  classical
  by_cases hc : Side (2 * h) i.val ↔ Side (2 * h) j.val
  · have hw : Within (Side (2 * h)) i.val j.val := by
      unfold Within
      tauto
    have hn : index (2 * h) i.val ≠ index (2 * h) j.val := by
      intro he
      apply hne
      apply Fin.ext
      exact index_injective _ _ _ (by have hi := i.isLt; omega)
        (by have hj := j.isLt; omega) hc he
    by_cases he : index (2 * h) j.val =
        P14AntipodalRoundLabels.antipode h (index (2 * h) i.val)
    · exact Or.inr (opposite_orthogonal h i j (within_opposite h _ _ i.isLt j.isLt hw he))
    · exact Or.inl (Or.inl ⟨hw, hn, he⟩)
  · have ha : Across (Side (2 * h)) i.val j.val := by
      unfold Across
      tauto
    by_cases he : index (2 * h) j.val = index (2 * h) i.val
    · exact Or.inr (opposite_orthogonal h i j (cross_opposite h _ _ i.isLt j.isLt ha he))
    · have hn := cross_labels_ne h j.val i.val j.isLt i.isLt he
      apply Or.inl
      apply Or.inr
      rcases ha with ⟨hi, hj⟩ | ⟨hi, hj⟩
      · exact Or.inl ⟨hi, hj, (P14CyclicRoundCenter.nonzero_arc _).mpr (sub_ne_zero.mpr hn)⟩
      · exact Or.inr ⟨hi, hj, (P14CyclicRoundCenter.nonzero_arc _).mpr (sub_ne_zero.mpr hn.symm)⟩

end P14EvenQubitCover


end
end

section

/-! A complete actual UPB family in the even-half-order region with one
qubit factor. All local vectors, graph blocks, pair coverage and the complex
survivor are constructed. The arithmetic region is explicit. -/

noncomputable section
namespace P14EvenQubitUPB
open P14ConcreteEvenPartition P14EvenQubitLabels P14EvenQubitCover
open P14BicliqueComplementConnection
open scoped BigOperators

def dimensions {n : ℕ} (R : Fin n → ℕ) : Fin (n + 1) → ℕ :=
  Fin.cases 2 (fun j => R j + 1)

def caps {n : ℕ} (R : Fin n → ℕ) : Fin (n + 1) → ℕ :=
  Fin.cases 2 R

def lengths {n : ℕ} (R : Fin n → ℕ) (i : ℕ) : ℕ :=
  if hi : i < n then R ⟨i, hi⟩ else 0

@[simp] theorem lengths_fin {n : ℕ} (R : Fin n → ℕ) (i : Fin n) :
    lengths R i.val = R i := by simp [lengths, i.isLt]

theorem lengths_sum {n : ℕ} (R : Fin n → ℕ) :
    (∑ i ∈ Finset.range n, lengths R i) = ∑ i, R i := by
  rw [← Fin.sum_univ_eq_sum_range]
  apply Finset.sum_congr rfl
  intro i _
  exact lengths_fin R i

theorem odd_entry {h n : ℕ} (hh : 1 ≤ h) (R : Fin n → ℕ)
    (htotal : (∑ i, R i) = 4 * h - 3) : ∃ i, Odd (R i) := by
  classical
  by_contra ho
  push Not at ho
  have he : ∀ i, ∃ k, R i = k + k := fun i => Nat.not_odd_iff_even.mp (ho i)
  choose k hk using he
  have hs : (∑ i, R i) = (∑ i, k i) + ∑ i, k i := by
    simp_rw [hk]
    exact Finset.sum_add_distrib
  omega

theorem ceiling {h n : ℕ} (hh : 1 ≤ h) (R : Fin n → ℕ)
    (htotal : (∑ i, R i) = 4 * h - 3) :
    2 + (∑ j, (dimensions R j - 1)) = 4 * h := by
  simp [dimensions, Fin.sum_univ_succ, htotal]
  omega

theorem exists_upb {h n : ℕ} (hh : 3 ≤ h) (R : Fin n → ℕ)
    (hpos : ∀ i, 0 < R i) (hmax : ∀ i, R i ≤ 2 * h - 2)
    (htotal : (∑ i, R i) = 4 * h - 3) :
    ∃ v : Fin (4 * h) → (j : Fin (n + 1)) → Fin (dimensions R j) → ℂ,
      (∀ i j, v i j ≠ 0) ∧
      (∀ i i', i ≠ i' → ∃ j, (∑ r, star (v i j r) * v i' j r) = 0) ∧
      (∀ a : (j : Fin (n + 1)) → Fin (dimensions R j) → ℂ, (∀ j, a j ≠ 0) →
        ∃ i, ∀ j, (∑ r, star (v i j r) * a j r) ≠ 0) := by
  classical
  letI : NeZero (2 * h) := ⟨by omega⟩
  letI : NeZero (2 * h - 1) := ⟨by omega⟩
  have hlpos : ∀ i < n, 0 < lengths R i := by
    intro i hi
    simpa [lengths, hi] using hpos ⟨i, hi⟩
  have hlmax : ∀ i < n, lengths R i ≤ 2 * h - 2 := by
    intro i hi
    simpa [lengths, hi] using hmax ⟨i, hi⟩
  have hlo : ∃ i, i < n ∧ Odd (lengths R i) := by
    obtain ⟨i, hi⟩ := odd_entry (by omega) R htotal
    exact ⟨i.val, i.isLt, by simpa using hi⟩
  have hlsum : (∑ i ∈ Finset.range n, lengths R i) =
      (2 * h - 2) + (2 * h - 2 + 1) := by
    rw [lengths_sum, htotal]
    omega
  obtain ⟨H, hH, hcover, _⟩ := partition h 2 n hh (by omega) (by omega)
    (lengths R) hlpos hlmax hlo hlsum 1
  have hx : ∀ j : Fin n, ∃ x : Fin (4 * h) → Fin (R j + 1) → ℂ,
      (∀ i, x i ≠ 0) ∧
      (∀ (i i' : Fin (4 * h)), H j.val i.val i'.val →
        (∑ r, star (x i r) * x i' r) = 0) ∧
      (∀ A : Finset (Fin (4 * h)), A.card = R j + 1 →
        Submodule.span ℂ (Set.range (fun i : A => x i)) = ⊤) := by
    intro j
    have hj := hH j.val j.isLt
    apply P14GenericExceptionalUPB.complex_rows (H j.val) hj.1 hj.2.1
      (R j + 1) (4 * h) (by omega)
    simpa using hj.2.2
  choose x hnz horth hspan using hx
  let v : Fin (4 * h) → (j : Fin (n + 1)) → Fin (dimensions R j) → ℂ :=
    fun i => Fin.cases (row h i) (fun j => x j i)
  refine ⟨v, ?_, ?_, ?_⟩
  · intro i j
    refine Fin.cases ?_ (fun j => ?_) j
    · exact row_ne_zero h i
    · exact hnz j i
  · intro i i' hne
    rcases pair_cover h i i' hne with hav | he
    · have hlen : 2 * h - 2 + 1 = 2 * h - 1 := by omega
      rw [← hlen] at hav
      obtain ⟨j, hj, he⟩ := (hcover i.val i.isLt i'.val i'.isLt).mp hav
      exact ⟨(⟨j, hj⟩ : Fin n).succ, horth ⟨j, hj⟩ i i' he⟩
    · exact ⟨0, he⟩
  · apply P14ComplexKillingBudget.survivor (dimensions R) (caps R) v
    · simp [caps, Fin.sum_univ_succ, htotal]
      omega
    · intro j
      refine Fin.cases ?_ (fun j => ?_) j
      · intro a ha S hS
        exact P14EvenQubitLabels.killing_bound h a ha S hS
      · intro a ha S hS
        exact P14ComplexKillingBudget.of_spanning (x j) (hspan j) a ha S hS

theorem canonical {h n : ℕ} (hh : 3 ≤ h) (R : Fin n → ℕ)
    (hpos : ∀ i, 0 < R i) (hmax : ∀ i, R i ≤ 2 * h - 2)
    (htotal : (∑ i, R i) = 4 * h - 3) :
    ∃ m : ℕ, m ≤ 2 + ∑ j, (dimensions R j - 1) ∧
      ∃ v : Fin m → (j : Fin (n + 1)) → Fin (dimensions R j) → ℂ,
        (∀ i j, v i j ≠ 0) ∧
        (∀ i i', i ≠ i' → ∃ j, (∑ r, star (v i j r) * v i' j r) = 0) ∧
        (∀ a : (j : Fin (n + 1)) → Fin (dimensions R j) → ℂ, (∀ j, a j ≠ 0) →
          ∃ i, ∀ j, (∑ r, star (v i j r) * a j r) ≠ 0) :=
  ⟨4 * h, (ceiling (by omega) R htotal).ge, exists_upb hh R hpos hmax htotal⟩

end P14EvenQubitUPB


end
end

section

/-! A factor-order-independent canonical region: at least one qubit,
2 <= d_j <= 2h-1, and total deficit 4h-2, with h>=3. -/

noncomputable section
namespace P14EvenQubitCanonicalRegion
open P14CanonicalUPBTransport
open scoped BigOperators

theorem canonical {p h : ℕ} (d : Fin p → ℕ) (hh : 3 ≤ h)
    (hd : ∀ j, 2 ≤ d j) (hmax : ∀ j, d j ≤ 2 * h - 1)
    (hq : ∃ j, d j = 2) (hsum : (∑ j, (d j - 1)) = 4 * h - 2) :
    Conclusion p d := by
  classical
  cases p with
  | zero =>
    obtain ⟨j, _⟩ := hq
    exact Fin.elim0 j
  | succ n =>
    obtain ⟨t, ht⟩ := hq
    let E : Fin (n + 1) ≃ Fin (n + 1) := Equiv.swap 0 t
    let R : Fin n → ℕ := fun j => d (E j.succ) - 1
    have hp : ∀ j, 0 < R j := by
      intro j
      have hj := hd (E j.succ)
      dsimp [R]
      omega
    have hm : ∀ j, R j ≤ 2 * h - 2 := by
      intro j
      have hj := hmax (E j.succ)
      dsimp [R]
      omega
    have hs : (∑ j, (d (E j) - 1)) = 4 * h - 2 :=
      (E.sum_comp (fun j => d j - 1)).trans hsum
    have hR : (∑ j, R j) = 4 * h - 3 := by
      rw [Fin.sum_univ_succ] at hs
      simp only [E, Equiv.swap_apply_left, ht] at hs
      change 2 - 1 + (∑ j, R j) = 4 * h - 2 at hs
      omega
    have hdim : P14EvenQubitUPB.dimensions R = fun j => d (E j) := by
      funext j
      refine Fin.cases ?_ (fun j => ?_) j
      · simp [P14EvenQubitUPB.dimensions, E, ht]
      · change d (E j.succ) - 1 + 1 = d (E j.succ)
        have hj := hd (E j.succ)
        omega
    have hc : Conclusion (n + 1) (fun j => d (E j)) := by
      rw [← hdim]
      exact P14EvenQubitUPB.canonical hh R hp hm hR
    have hf := reindex (fun j => d (E j)) E hc
    simpa only [E, Equiv.swap_apply_self] using hf

/-- A concrete mixed example with twelve product rows available under the
canonical ceiling, in dimensions 2 x 4 x 4 x 4. -/
theorem qubit_three_ququarts : Conclusion 4 ![2, 4, 4, 4] := by
  apply canonical (h := 3)
  · omega
  · intro j
    fin_cases j <;> norm_num
  · intro j
    fin_cases j <;> norm_num
  · exact ⟨0, rfl⟩
  · norm_num [Fin.sum_univ_succ]

end P14EvenQubitCanonicalRegion


end
end

section

/-! A stable positive root of a degenerating quadratic. Unlike division by
the leading coefficient, this branch is continuous when that coefficient
vanishes and the linear coefficient tends to -1. -/

noncomputable section
namespace P14StableQuadraticBranch
open Filter
open scoped Topology

def root (a b c : ℝ) : ℝ := 2 * c / (-b + Real.sqrt (b ^ 2 - 4 * a * c))

theorem value_at_limit (A : ℝ) : root 0 (-1) A = A := by
  norm_num [root]

theorem positive (a b c : ℝ) (hb : b < 0) (hc : 0 < c) : 0 < root a b c := by
  unfold root
  apply div_pos (by positivity)
  have hs := Real.sqrt_nonneg (b ^ 2 - 4 * a * c)
  linarith

theorem equation (a b c : ℝ) (hdisc : 0 ≤ b ^ 2 - 4 * a * c)
    (hden : -b + Real.sqrt (b ^ 2 - 4 * a * c) ≠ 0) :
    a * root a b c ^ 2 + b * root a b c + c = 0 := by
  have hs := congrArg (fun x : ℝ => c * x) (Real.sq_sqrt hdisc)
  unfold root
  generalize he : Real.sqrt (b ^ 2 - 4 * a * c) = s at *
  field_simp [hden]
  nlinarith

theorem continuous_at {a b c : ℝ → ℝ}
    (ha : ContinuousAt a 0) (hb : ContinuousAt b 0) (hc : ContinuousAt c 0)
    (ha0 : a 0 = 0) (hb0 : b 0 = -1) :
    ContinuousAt (fun e => root (a e) (b e) (c e)) 0 := by
  have hd : ContinuousAt (fun e => b e ^ 2 - 4 * a e * c e) 0 :=
    (hb.pow 2).sub ((continuousAt_const.mul ha).mul hc)
  apply (continuousAt_const.mul hc).div (hb.neg.add hd.sqrt)
  simp [ha0, hb0]

theorem limit {a b c : ℝ → ℝ} {A : ℝ}
    (ha : ContinuousAt a 0) (hb : ContinuousAt b 0) (hc : ContinuousAt c 0)
    (ha0 : a 0 = 0) (hb0 : b 0 = -1) (hc0 : c 0 = A) :
    Tendsto (fun e => root (a e) (b e) (c e)) (𝓝 0) (𝓝 A) := by
  have h := continuous_at ha hb hc ha0 hb0
  simpa only [ContinuousAt, ha0, hb0, hc0, value_at_limit] using h

theorem eventually_positive_equation {a b c : ℝ → ℝ} {A : ℝ}
    (ha : ContinuousAt a 0) (hb : ContinuousAt b 0) (hc : ContinuousAt c 0)
    (ha0 : a 0 = 0) (hb0 : b 0 = -1) (hc0 : c 0 = A) (hA : 0 < A) :
    ∀ᶠ e in 𝓝 0,
      0 < b e ^ 2 - 4 * a e * c e ∧
      0 < -b e + Real.sqrt (b e ^ 2 - 4 * a e * c e) ∧
      0 < root (a e) (b e) (c e) ∧
      a e * root (a e) (b e) (c e) ^ 2 +
        b e * root (a e) (b e) (c e) + c e = 0 := by
  have hd : ContinuousAt (fun e => b e ^ 2 - 4 * a e * c e) 0 :=
    (hb.pow 2).sub ((continuousAt_const.mul ha).mul hc)
  have hb' : ∀ᶠ e in 𝓝 0, b e < 0 := hb.eventually (eventually_lt_nhds (by rw [hb0]; norm_num))
  have hc' : ∀ᶠ e in 𝓝 0, 0 < c e := hc.eventually (eventually_gt_nhds (by rwa [hc0]))
  have hd' : ∀ᶠ e in 𝓝 0, 0 < b e ^ 2 - 4 * a e * c e :=
    hd.eventually (eventually_gt_nhds (by simp [ha0, hb0]))
  filter_upwards [hb', hc', hd'] with e heB heC heD
  have hden : 0 < -b e + Real.sqrt (b e ^ 2 - 4 * a e * c e) := by
    have hs := Real.sqrt_nonneg (b e ^ 2 - 4 * a e * c e)
    linarith
  exact ⟨heD, hden, positive _ _ _ heB heC,
    equation _ _ _ heD.le (ne_of_gt hden)⟩

end P14StableQuadraticBranch


end
end

section

/-! Explicit simultaneous positive solutions of the two scaled balance
equations. The coefficients may vary continuously; no implicit-function
theorem or unspecified solution branch is an input. -/

noncomputable section
namespace P14TwoBalanceBranch
open Filter
open scoped Topology

theorem reciprocal_of_quadratic (s F Q A0 A Z : ℝ)
    (hX : F - s * Z ≠ 0) (hZ : Z ≠ 0)
    (he : (1 - Q) * s * Z ^ 2 +
      (s * (A0 - A) - (1 - Q) * F) * Z + A * F = 0) :
    s * A0 / (F - s * Z) + Q + A / Z - 1 = 0 := by
  field_simp [hX, hZ]
  nlinarith only [he]

theorem exists_branch (s F Q : ℝ → ℝ) (A0 A : ℝ)
    (hs : ContinuousAt s 0) (hF : ContinuousAt F 0) (hQ : ContinuousAt Q 0)
    (hs0 : s 0 = 0) (hF0 : F 0 = 1) (hQ0 : Q 0 = 0) (hA : 0 < A) :
    ∃ X Z : ℝ → ℝ,
      ContinuousAt X 0 ∧ ContinuousAt Z 0 ∧ X 0 = 1 ∧ Z 0 = A ∧
      ∀ᶠ e in 𝓝 0,
        0 < X e ∧ 0 < Z e ∧ X e + s e * Z e = F e ∧
        s e * A0 / X e + Q e + A / Z e - 1 = 0 := by
  let a : ℝ → ℝ := fun e => (1 - Q e) * s e
  let b : ℝ → ℝ := fun e => s e * (A0 - A) - (1 - Q e) * F e
  let c : ℝ → ℝ := fun e => A * F e
  have ha : ContinuousAt a 0 := (continuousAt_const.sub hQ).mul hs
  have hb : ContinuousAt b 0 :=
    (hs.mul continuousAt_const).sub ((continuousAt_const.sub hQ).mul hF)
  have hc : ContinuousAt c 0 := continuousAt_const.mul hF
  have ha0 : a 0 = 0 := by simp [a, hs0]
  have hb0 : b 0 = -1 := by simp [b, hs0, hF0, hQ0]
  have hc0 : c 0 = A := by simp [c, hF0]
  let Z : ℝ → ℝ := fun e => P14StableQuadraticBranch.root (a e) (b e) (c e)
  let X : ℝ → ℝ := fun e => F e - s e * Z e
  have hz : ContinuousAt Z 0 := P14StableQuadraticBranch.continuous_at ha hb hc ha0 hb0
  have hz0 : Z 0 = A := by
    simp only [Z, ha0, hb0, hc0, P14StableQuadraticBranch.value_at_limit]
  have hx : ContinuousAt X 0 := hF.sub (hs.mul hz)
  have hx0 : X 0 = 1 := by simp [X, hs0, hF0]
  refine ⟨X, Z, hx, hz, hx0, hz0, ?_⟩
  have hxp : ∀ᶠ e in 𝓝 0, 0 < X e := hx.eventually (eventually_gt_nhds (by rw [hx0]; norm_num))
  have hze := P14StableQuadraticBranch.eventually_positive_equation ha hb hc ha0 hb0 hc0 hA
  filter_upwards [hxp, hze] with e heX heZ
  refine ⟨heX, heZ.2.2.1, ?_, ?_⟩
  · dsimp [X]
    ring
  · exact reciprocal_of_quadratic (s e) (F e) (Q e) A0 A (Z e)
      (ne_of_gt heX) (ne_of_gt heZ.2.2.1) heZ.2.2.2

end P14TwoBalanceBranch


end
end

section

/-! The explicit power profile for exceptional dimension 2k+4. This supplies
positive weights of orders 0,0,1,...,2k,2k+1,2k+1 satisfying both alternating
balances, with the two variable coefficients continuous and nonzero at zero. -/

noncomputable section
namespace P14EvenWeightProfile
open Filter
open scoped Topology BigOperators

def F (k : ℕ) (AT e : ℝ) : ℝ :=
  1 - (∑ j : Fin (2 * k), (-1 : ℝ) ^ j.val * e ^ (j.val + 1)) + e ^ (2 * k + 1) * AT

def Q (k : ℕ) (A1 : ℝ) (B : Fin (2 * k) → ℝ) (e : ℝ) : ℝ :=
  -e ^ (2 * k + 1) * A1 +
    ∑ j : Fin (2 * k), (-1 : ℝ) ^ j.val * B j * e ^ (2 * k - j.val)

theorem F_continuous (k : ℕ) (AT : ℝ) : Continuous (F k AT) := by
  unfold F
  fun_prop

theorem Q_continuous (k : ℕ) (A1 : ℝ) (B : Fin (2 * k) → ℝ) :
    Continuous (Q k A1 B) := by
  unfold Q
  fun_prop

theorem F_zero (k : ℕ) (AT : ℝ) : F k AT 0 = 1 := by simp [F]

theorem Q_zero (k : ℕ) (A1 : ℝ) (B : Fin (2 * k) → ℝ) : Q k A1 B 0 = 0 := by
  have hp : ∀ j : Fin (2 * k), 2 * k - j.val ≠ 0 := by
    intro j
    have hj := j.isLt
    omega
  simp [Q, hp]

theorem power_quotient (e A : ℝ) (he : e ≠ 0) (m n : ℕ) (hn : n ≤ m) :
    e ^ m * (A / e ^ n) = A * e ^ (m - n) := by
  have hp : e ^ m = e ^ n * e ^ (m - n) := by
    rw [← pow_add, Nat.add_sub_of_le hn]
  rw [hp]
  field_simp

theorem reciprocal_balance (k : ℕ) (A0 A1 A AT X Z e : ℝ) (B : Fin (2 * k) → ℝ)
    (he : e ≠ 0) (hX : X ≠ 0) (hZ : Z ≠ 0) (hAT : AT ≠ 0)
    (hb : e ^ (2 * k + 1) * A0 / X + Q k A1 B e + A / Z - 1 = 0) :
    A0 / X - A1 +
      (∑ j : Fin (2 * k), (-1 : ℝ) ^ j.val * B j / e ^ (j.val + 1)) +
      A / (e ^ (2 * k + 1) * Z) - AT / (e ^ (2 * k + 1) * AT) = 0 := by
  have hs : e ^ (2 * k + 1) ≠ 0 := pow_ne_zero _ he
  have hm : e ^ (2 * k + 1) *
      (∑ j : Fin (2 * k), (-1 : ℝ) ^ j.val * B j / e ^ (j.val + 1)) =
      ∑ j : Fin (2 * k), (-1 : ℝ) ^ j.val * B j * e ^ (2 * k - j.val) := by
    rw [Finset.mul_sum]
    apply Finset.sum_congr rfl
    intro j _
    have hj := j.isLt
    have hn : j.val + 1 ≤ 2 * k + 1 := by omega
    simpa only [show 2 * k + 1 - (j.val + 1) = 2 * k - j.val by omega] using
      power_quotient e ((-1 : ℝ) ^ j.val * B j) he (2 * k + 1) (j.val + 1) hn
  apply (mul_eq_zero.mp (show e ^ (2 * k + 1) * _ = 0 from ?_)).resolve_left hs
  rw [mul_sub, mul_add, mul_add, mul_sub, hm]
  have hfirst : e ^ (2 * k + 1) * (A0 / X) = e ^ (2 * k + 1) * A0 / X := by ring
  have hlast : e ^ (2 * k + 1) * (A / (e ^ (2 * k + 1) * Z)) = A / Z := by
    field_simp
  have htail : e ^ (2 * k + 1) * (AT / (e ^ (2 * k + 1) * AT)) = 1 := by
    field_simp
  rw [hfirst, hlast, htail]
  dsimp [Q] at hb
  linarith only [hb]

theorem exists_profile (k : ℕ) (A0 A1 A AT : ℝ) (B : Fin (2 * k) → ℝ)
    (hA : 0 < A) (hAT : 0 < AT) :
    ∃ X Z : ℝ → ℝ,
      ContinuousAt X 0 ∧ ContinuousAt Z 0 ∧ X 0 = 1 ∧ Z 0 = A ∧
      ∀ᶠ e in 𝓝[>] (0 : ℝ),
        0 < X e ∧ 0 < Z e ∧
        (∀ j : Fin (2 * k), 0 < e ^ (j.val + 1)) ∧
        0 < e ^ (2 * k + 1) * Z e ∧ 0 < e ^ (2 * k + 1) * AT ∧
        X e - 1 + (∑ j : Fin (2 * k), (-1 : ℝ) ^ j.val * e ^ (j.val + 1)) +
          e ^ (2 * k + 1) * Z e - e ^ (2 * k + 1) * AT = 0 ∧
        A0 / X e - A1 +
          (∑ j : Fin (2 * k), (-1 : ℝ) ^ j.val * B j / e ^ (j.val + 1)) +
          A / (e ^ (2 * k + 1) * Z e) - AT / (e ^ (2 * k + 1) * AT) = 0 := by
  obtain ⟨X, Z, hx, hz, hx0, hz0, hb⟩ := P14TwoBalanceBranch.exists_branch
    (fun e => e ^ (2 * k + 1)) (F k AT) (Q k A1 B) A0 A
    (by fun_prop) (F_continuous k AT).continuousAt (Q_continuous k A1 B).continuousAt
    (by simp) (F_zero k AT) (Q_zero k A1 B) hA
  refine ⟨X, Z, hx, hz, hx0, hz0, ?_⟩
  have hp : ∀ᶠ e in 𝓝[>] (0 : ℝ), 0 < e := self_mem_nhdsWithin
  filter_upwards [hb.filter_mono nhdsWithin_le_nhds, hp] with e he hepos
  refine ⟨he.1, he.2.1, (fun j => pow_pos hepos _),
    mul_pos (pow_pos hepos _) he.2.1, mul_pos (pow_pos hepos _) hAT, ?_, ?_⟩
  · have heq := he.2.2.1
    dsimp [F] at heq
    linarith only [heq]
  · exact reciprocal_balance k A0 A1 A AT (X e) (Z e) e B (ne_of_gt hepos)
      (ne_of_gt he.1) (ne_of_gt he.2.1) (ne_of_gt hAT) he.2.2.2

end P14EvenWeightProfile


end
end

section

/-! The actual indexed positive weight family and both alternating sums,
with the coordinate order fixed for subsequent Fourier constructions. -/

noncomputable section
namespace P14EvenIndexedWeights
open Filter
open scoped Topology BigOperators

@[simp] private theorem cases_one {n : ℕ} (a : ℝ) (f : Fin (n + 1) → ℝ) :
    Fin.cases a f (1 : Fin (n + 2)) = f 0 := rfl

def pack (k : ℕ) (a0 a1 : ℝ) (middle : Fin (2 * k) → ℝ) (a2 a3 : ℝ) :
    Fin (2 * k + 4) → ℝ :=
  Fin.cases a0 (Fin.cases a1 (Fin.addCases middle (Fin.cases a2 (fun _ : Fin 1 => a3))))

theorem alternating_pack (k : ℕ) (a0 a1 : ℝ) (middle : Fin (2 * k) → ℝ) (a2 a3 : ℝ) :
    (∑ i, (-1 : ℝ) ^ i.val * pack k a0 a1 middle a2 a3 i) =
      a0 - a1 + (∑ j, (-1 : ℝ) ^ j.val * middle j) + a2 - a3 := by
  unfold pack
  rw [Fin.sum_univ_succ, Fin.sum_univ_succ, Fin.sum_univ_add]
  simp [Fin.sum_univ_succ, pow_add, pow_mul]
  ring

theorem alternating_div_pack (k : ℕ) (a0 a1 : ℝ) (A : Fin (2 * k) → ℝ) (a2 a3 : ℝ)
    (b0 b1 : ℝ) (B : Fin (2 * k) → ℝ) (b2 b3 : ℝ) :
    (∑ i, (-1 : ℝ) ^ i.val * pack k a0 a1 A a2 a3 i / pack k b0 b1 B b2 b3 i) =
      a0 / b0 - a1 / b1 + (∑ j, (-1 : ℝ) ^ j.val * A j / B j) + a2 / b2 - a3 / b3 := by
  unfold pack
  rw [Fin.sum_univ_succ, Fin.sum_univ_succ, Fin.sum_univ_add]
  simp [Fin.sum_univ_succ, pow_add, pow_mul]
  ring

theorem pack_positive (k : ℕ) (a0 a1 : ℝ) (middle : Fin (2 * k) → ℝ) (a2 a3 : ℝ)
    (h0 : 0 < a0) (h1 : 0 < a1) (hm : ∀ j, 0 < middle j) (h2 : 0 < a2) (h3 : 0 < a3) :
    ∀ i, 0 < pack k a0 a1 middle a2 a3 i := by
  intro i
  refine Fin.cases h0 (fun j => ?_) i
  refine Fin.cases h1 (fun j => ?_) j
  refine Fin.addCases (fun j => ?_) (fun j => ?_) j
  · simpa [pack] using hm j
  · fin_cases j
    · simpa [pack] using h2
    · simpa [pack] using h3

def weights (k : ℕ) (X Z : ℝ → ℝ) (AT e : ℝ) : Fin (2 * k + 4) → ℝ :=
  pack k (X e) 1 (fun j => e ^ (j.val + 1)) (e ^ (2 * k + 1) * Z e) (e ^ (2 * k + 1) * AT)

theorem exists_weights (k : ℕ) (A0 A1 A AT : ℝ) (B : Fin (2 * k) → ℝ)
    (hA : 0 < A) (hAT : 0 < AT) :
    ∃ X Z : ℝ → ℝ,
      ContinuousAt X 0 ∧ ContinuousAt Z 0 ∧ X 0 = 1 ∧ Z 0 = A ∧
      ∀ᶠ e in 𝓝[>] (0 : ℝ),
        (∀ i, 0 < weights k X Z AT e i) ∧
        (∑ i, (-1 : ℝ) ^ i.val * weights k X Z AT e i) = 0 ∧
        (∑ i, (-1 : ℝ) ^ i.val * pack k A0 A1 B A AT i / weights k X Z AT e i) = 0 := by
  obtain ⟨X, Z, hx, hz, hx0, hz0, hp⟩ :=
    P14EvenWeightProfile.exists_profile k A0 A1 A AT B hA hAT
  refine ⟨X, Z, hx, hz, hx0, hz0, ?_⟩
  filter_upwards [hp] with e he
  refine ⟨pack_positive k _ _ _ _ _ he.1 (by norm_num) he.2.2.1
    he.2.2.2.1 he.2.2.2.2.1, ?_, ?_⟩
  · unfold weights
    rw [alternating_pack]
    exact he.2.2.2.2.2.1
  · unfold weights
    rw [alternating_div_pack]
    simpa only [div_one] using he.2.2.2.2.2.2

end P14EvenIndexedWeights


end
end

section

/-! Exact factorization and exponent gap for the previously constructed
indexed weights. These are properties of the same X,Z weight family. -/

noncomputable section
namespace P14EvenWeightOrders
open P14EvenIndexedWeights
open scoped Topology

def order (k i : ℕ) : ℕ := min (i - 1) (2 * k + 1)

def coefficient (k : ℕ) (X Z : ℝ → ℝ) (AT e : ℝ) : Fin (2 * k + 4) → ℝ :=
  pack k (X e) 1 (fun _ => 1) (Z e) AT

theorem cut_left (k r i : ℕ) (hr : 2 ≤ r) (hi : i < r) :
    order k i ≤ r - 2 := by
  unfold order
  omega

theorem cut_right (k r i : ℕ) (hr : 2 ≤ r) (hru : r ≤ 2 * k + 2) (hi : r ≤ i) :
    r - 2 < order k i := by
  unfold order
  omega

theorem factorization (k : ℕ) (X Z : ℝ → ℝ) (AT e : ℝ) (i : Fin (2 * k + 4)) :
    weights k X Z AT e i = coefficient k X Z AT e i * e ^ order k i.val := by
  refine Fin.cases ?_ (fun j => ?_) i
  · simp [weights, coefficient, pack, order]
  · refine Fin.cases ?_ (fun j => ?_) j
    · simp [weights, coefficient, pack, order]
    · refine Fin.addCases (fun j => ?_) (fun j => ?_) j
      · have ho : order k (j.val + 1 + 1) = j.val + 1 := by
          unfold order
          have hj := j.isLt
          omega
        simp [weights, coefficient, pack, ho]
      · have h0 : order k (2 * k + 1 + 1) = 2 * k + 1 := by unfold order; omega
        have h1 : order k (2 * k + 1 + 1 + 1) = 2 * k + 1 := by unfold order; omega
        fin_cases j <;> simp [weights, coefficient, pack, h0, h1] <;> ring

theorem coefficient_continuous (k : ℕ) (X Z : ℝ → ℝ) (AT : ℝ)
    (hx : ContinuousAt X 0) (hz : ContinuousAt Z 0) :
    ∀ i, ContinuousAt (fun e => coefficient k X Z AT e i) 0 := by
  intro i
  refine Fin.cases hx (fun j => ?_) i
  refine Fin.cases continuousAt_const (fun j => ?_) j
  refine Fin.addCases (fun j => ?_) (fun j => ?_) j
  · simpa [coefficient, pack] using (continuousAt_const : ContinuousAt (fun _ : ℝ => (1 : ℝ)) 0)
  · fin_cases j
    · simpa [coefficient, pack] using hz
    · simpa [coefficient, pack] using (continuousAt_const : ContinuousAt (fun _ : ℝ => AT) 0)

theorem coefficient_ne_zero (k : ℕ) (X Z : ℝ → ℝ) (A AT : ℝ)
    (hx : X 0 = 1) (hz : Z 0 = A) (hA : 0 < A) (hAT : 0 < AT) :
    ∀ i, coefficient k X Z AT 0 i ≠ 0 := by
  intro i
  apply ne_of_gt
  apply pack_positive k (X 0) 1 (fun _ => 1) (Z 0) AT
  · rw [hx]
    norm_num
  · norm_num
  · intro j
    norm_num
  · rwa [hz]
  · exact hAT

end P14EvenWeightOrders


end
end

section

/-! Mixed Fourier determinants for the same explicit exceptional weights,
after the physical coordinate-row scaling has removed the square roots. -/

noncomputable section
namespace P14EvenFourierTransformed
open Matrix Filter P14EvenIndexedWeights P14EvenWeightOrders
open scoped Topology BigOperators

def coordinate {k r s : ℕ} (h : r + s = 2 * k + 4) (j : Fin r ⊕ Fin s) : Fin (2 * k + 4) :=
  Fin.cast h (finSumFinEquiv j)

@[simp] theorem coordinate_left_val {k r s : ℕ} (h : r + s = 2 * k + 4) (j : Fin r) :
    (coordinate h (.inl j)).val = j.val := by simp [coordinate]

@[simp] theorem coordinate_right_val {k r s : ℕ} (h : r + s = 2 * k + 4) (j : Fin s) :
    (coordinate h (.inr j)).val = r + j.val := by simp [coordinate]

def transformed {k r s q : ℕ} (h : r + s = 2 * k + 4)
    (X Z : ℝ → ℝ) (AT : ℝ) (ζ : ℂ) (p : Fin (2 * k + 4) → ℂ)
    (U : Fin r → Fin q) (V : Fin s → Fin q) (e : ℝ) :
    Matrix (Fin r ⊕ Fin s) (Fin r ⊕ Fin s) ℂ :=
  fun i j => Sum.elim
    (fun a => ζ ^ ((U a).val * (coordinate h j).val) *
      (weights k X Z AT e (coordinate h j) : ℂ) / p (coordinate h j))
    (fun b => ζ ^ ((V b).val * (coordinate h j).val)) i

theorem eventually_det_ne_zero {k r s q : ℕ} (h : r + s = 2 * k + 4)
    (hr : 2 ≤ r) (hru : r ≤ 2 * k + 2)
    (X Z : ℝ → ℝ) (A AT : ℝ) (hx : ContinuousAt X 0) (hz : ContinuousAt Z 0)
    (hx0 : X 0 = 1) (hz0 : Z 0 = A) (hA : 0 < A) (hAT : 0 < AT)
    (ζ : ℂ) (hq : q ≠ 0) (hζ : IsPrimitiveRoot ζ q)
    (p : Fin (2 * k + 4) → ℂ) (hp : ∀ j, p j ≠ 0)
    (U : Fin r → Fin q) (V : Fin s → Fin q)
    (hU : Function.Injective U) (hV : Function.Injective V) :
    ∀ᶠ e in 𝓝[>] (0 : ℝ), (transformed h X Z AT ζ p U V e).det ≠ 0 := by
  let AA : Matrix (Fin r) (Fin r ⊕ Fin s) ℂ :=
    fun i j => ζ ^ ((U i).val * (coordinate h j).val)
  let BB : Matrix (Fin s) (Fin r ⊕ Fin s) ℂ :=
    fun i j => ζ ^ ((V i).val * (coordinate h j).val)
  let CC : (Fin r ⊕ Fin s) → ℝ → ℂ := fun j e =>
    (coefficient k X Z AT e (coordinate h j) : ℂ) / p (coordinate h j)
  let w : (Fin r ⊕ Fin s) → ℕ := fun j => order k (coordinate h j).val
  have hl : ∀ j, w (.inl j) ≤ r - 2 := by
    intro j
    simpa [w] using cut_left k r j.val hr j.isLt
  have hu : ∀ j, r - 2 < w (.inr j) := by
    intro j
    simpa [w] using cut_right k r (r + j.val) hr hru (by omega)
  have hc : ∀ j, ContinuousAt (CC j) 0 := by
    intro j
    exact (Complex.continuous_ofReal.continuousAt.comp
      (coefficient_continuous k X Z AT hx hz (coordinate h j))).div continuousAt_const (hp _)
  have hc0 : ∀ j, CC (.inl j) 0 ≠ 0 := by
    intro j
    apply div_ne_zero
    · exact_mod_cast coefficient_ne_zero k X Z A AT hx0 hz0 hA hAT (coordinate h (.inl j))
    · exact hp _
  have ha : (AA.submatrix id Sum.inl).det ≠ 0 := by
    have he : AA.submatrix id Sum.inl =
        P14FourierConsecutiveBlock.consecutiveBlock ζ 1 0 U (fun _ => 1) := by
      ext i j
      simp [AA, Matrix.submatrix, P14FourierConsecutiveBlock.consecutiveBlock]
    rw [he]
    exact P14FourierConsecutiveBlock.consecutiveBlock_det_ne_zero ζ 1 0 U (fun _ => 1)
      hq hζ one_ne_zero hU (fun _ => one_ne_zero)
  have hb : (BB.submatrix id Sum.inr).det ≠ 0 := by
    have he : BB.submatrix id Sum.inr =
        P14FourierConsecutiveBlock.consecutiveBlock ζ 1 r V (fun _ => 1) := by
      ext i j
      simp [BB, Matrix.submatrix, P14FourierConsecutiveBlock.consecutiveBlock]
    rw [he]
    exact P14FourierConsecutiveBlock.consecutiveBlock_det_ne_zero ζ 1 r V (fun _ => 1)
      hq hζ one_ne_zero hV (fun _ => one_ne_zero)
  have hd := P14ContinuousWeightedBlock.eventually_det_ne_zero AA BB CC w (r - 2) hl hu hc hc0 ha hb
  filter_upwards [hd] with e he
  have hm : P14ContinuousWeightedBlock.weighted AA BB CC w e = transformed h X Z AT ζ p U V e := by
    ext i j
    rcases i with a | b
    · change (ζ ^ ((U a).val * (coordinate h j).val) *
          ((coefficient k X Z AT e (coordinate h j) : ℂ) / p (coordinate h j))) *
          (e : ℂ) ^ order k (coordinate h j).val =
        ζ ^ ((U a).val * (coordinate h j).val) *
          (weights k X Z AT e (coordinate h j) : ℂ) / p (coordinate h j)
      rw [factorization]
      push_cast
      ring
    · rfl
  rwa [hm] at he

end P14EvenFourierTransformed


end
end

section

/-! Actual square-root Fourier coordinates, with pure and mixed determinants.
The coordinate scaling is an equality for the same indexed weight family. -/

noncomputable section
namespace P14EvenFourierPhysical
open Matrix Filter P14EvenIndexedWeights P14EvenFourierTransformed
open scoped Topology BigOperators

def uRow {d q : ℕ} (ζ : ℂ) (weight : Fin d → ℝ) (i : Fin q) (j : Fin d) : ℂ :=
  (Real.sqrt (weight j) : ℂ) * ζ ^ (i.val * j.val)

def vRow {d q : ℕ} (ζ : ℂ) (weight : Fin d → ℝ) (p : Fin d → ℂ)
    (i : Fin q) (j : Fin d) : ℂ :=
  p j / (Real.sqrt (weight j) : ℂ) * ζ ^ (i.val * j.val)

def mixed {k r s q : ℕ} (h : r + s = 2 * k + 4)
    (ζ : ℂ) (weight : Fin (2 * k + 4) → ℝ) (p : Fin (2 * k + 4) → ℂ)
    (U : Fin r → Fin q) (V : Fin s → Fin q) :
    Matrix (Fin r ⊕ Fin s) (Fin r ⊕ Fin s) ℂ :=
  fun i j => Sum.elim (fun a => uRow ζ weight (U a) (coordinate h j))
    (fun b => vRow ζ weight p (V b) (coordinate h j)) i

theorem scaling {k r s q : ℕ} (h : r + s = 2 * k + 4)
    (X Z : ℝ → ℝ) (AT e : ℝ) (ζ : ℂ) (p : Fin (2 * k + 4) → ℂ)
    (U : Fin r → Fin q) (V : Fin s → Fin q)
    (hweight : ∀ j, 0 < weights k X Z AT e j) (hp : ∀ j, p j ≠ 0) :
    mixed h ζ (weights k X Z AT e) p U V *
        Matrix.diagonal (fun j => (Real.sqrt (weights k X Z AT e (coordinate h j)) : ℂ) /
          p (coordinate h j)) =
      transformed h X Z AT ζ p U V e := by
  ext i j
  rw [Matrix.mul_diagonal]
  have hs : (Real.sqrt (weights k X Z AT e (coordinate h j)) : ℂ) ≠ 0 := by
    exact_mod_cast (Real.sqrt_ne_zero'.mpr (hweight (coordinate h j)))
  have hsq : (Real.sqrt (weights k X Z AT e (coordinate h j)) : ℂ) ^ 2 =
      (weights k X Z AT e (coordinate h j) : ℂ) := by
    exact_mod_cast Real.sq_sqrt (hweight (coordinate h j)).le
  rcases i with a | b
  · change ((Real.sqrt (weights k X Z AT e (coordinate h j)) : ℂ) *
        ζ ^ ((U a).val * (coordinate h j).val)) *
        ((Real.sqrt (weights k X Z AT e (coordinate h j)) : ℂ) / p (coordinate h j)) =
      ζ ^ ((U a).val * (coordinate h j).val) *
        (weights k X Z AT e (coordinate h j) : ℂ) / p (coordinate h j)
    rw [← hsq]
    ring
  · change (p (coordinate h j) / (Real.sqrt (weights k X Z AT e (coordinate h j)) : ℂ) *
        ζ ^ ((V b).val * (coordinate h j).val)) *
        ((Real.sqrt (weights k X Z AT e (coordinate h j)) : ℂ) / p (coordinate h j)) =
      ζ ^ ((V b).val * (coordinate h j).val)
    field_simp [hs, hp (coordinate h j)]

theorem u_det_ne_zero {d q : ℕ} (ζ : ℂ) (hq : q ≠ 0) (hζ : IsPrimitiveRoot ζ q)
    (weight : Fin d → ℝ) (hweight : ∀ j, 0 < weight j) (U : Fin d → Fin q)
    (hU : Function.Injective U) : (Matrix.of (fun i j => uRow ζ weight (U i) j)).det ≠ 0 := by
  have he : Matrix.of (fun i j => uRow ζ weight (U i) j) =
      P14FourierConsecutiveBlock.consecutiveBlock ζ 1 0 U (fun j => (Real.sqrt (weight j) : ℂ)) := by
    ext i j
    simp [uRow, P14FourierConsecutiveBlock.consecutiveBlock, mul_comm]
  rw [he]
  apply P14FourierConsecutiveBlock.consecutiveBlock_det_ne_zero ζ 1 0 U _ hq hζ one_ne_zero hU
  intro j
  exact_mod_cast Real.sqrt_ne_zero'.mpr (hweight j)

theorem v_det_ne_zero {d q : ℕ} (ζ : ℂ) (hq : q ≠ 0) (hζ : IsPrimitiveRoot ζ q)
    (weight : Fin d → ℝ) (hweight : ∀ j, 0 < weight j) (p : Fin d → ℂ) (hp : ∀ j, p j ≠ 0)
    (V : Fin d → Fin q) (hV : Function.Injective V) :
    (Matrix.of (fun i j => vRow ζ weight p (V i) j)).det ≠ 0 := by
  have he : Matrix.of (fun i j => vRow ζ weight p (V i) j) =
      P14FourierConsecutiveBlock.consecutiveBlock ζ 1 0 V
        (fun j => p j / (Real.sqrt (weight j) : ℂ)) := by
    ext i j
    simp [vRow, P14FourierConsecutiveBlock.consecutiveBlock, mul_comm]
  rw [he]
  apply P14FourierConsecutiveBlock.consecutiveBlock_det_ne_zero ζ 1 0 V _ hq hζ one_ne_zero hV
  intro j
  apply div_ne_zero (hp j)
  exact_mod_cast Real.sqrt_ne_zero'.mpr (hweight j)

theorem eventually_mixed_det_ne_zero {k r s q : ℕ} (h : r + s = 2 * k + 4)
    (hr : 2 ≤ r) (hru : r ≤ 2 * k + 2)
    (X Z : ℝ → ℝ) (A AT : ℝ) (hx : ContinuousAt X 0) (hz : ContinuousAt Z 0)
    (hx0 : X 0 = 1) (hz0 : Z 0 = A) (hA : 0 < A) (hAT : 0 < AT)
    (hpos : ∀ᶠ e in 𝓝[>] (0 : ℝ), ∀ j, 0 < weights k X Z AT e j)
    (ζ : ℂ) (hq : q ≠ 0) (hζ : IsPrimitiveRoot ζ q)
    (p : Fin (2 * k + 4) → ℂ) (hp : ∀ j, p j ≠ 0)
    (U : Fin r → Fin q) (V : Fin s → Fin q)
    (hU : Function.Injective U) (hV : Function.Injective V) :
    ∀ᶠ e in 𝓝[>] (0 : ℝ), (mixed h ζ (weights k X Z AT e) p U V).det ≠ 0 := by
  have hd := P14EvenFourierTransformed.eventually_det_ne_zero h hr hru X Z A AT
    hx hz hx0 hz0 hA hAT ζ hq hζ p hp U V hU hV
  filter_upwards [hd, hpos] with e he hweight
  intro hzero
  apply he
  rw [← scaling h X Z AT e ζ p U V hweight hp, Matrix.det_mul, hzero, zero_mul]

end P14EvenFourierPhysical

end
end

section

/-! A single positive weight vector satisfies both balance equations and all
pure and permitted mixed determinants, for arbitrary nonzero physical coefficients. -/

noncomputable section
namespace P14EvenFourierUniform
open Matrix Filter P14EvenIndexedWeights P14EvenFourierPhysical
open scoped Topology BigOperators

theorem pack_eta (k : ℕ) (a : Fin (2 * k + 4) → ℝ) :
    pack k (a 0) (a 1) (fun j => a ((Fin.castAdd 2 j).succ.succ))
      (a ((Fin.natAdd (2 * k) (0 : Fin 2)).succ.succ))
      (a ((Fin.natAdd (2 * k) (1 : Fin 2)).succ.succ)) = a := by
  funext i
  refine Fin.cases rfl (fun j => ?_) i
  refine Fin.cases rfl (fun j => ?_) j
  refine Fin.addCases (fun j => ?_) (fun j => ?_) j
  · simp [pack]
  · fin_cases j <;> simp [pack]

def MixedMinors {k q : ℕ} (ζ : ℂ) (p : Fin (2 * k + 4) → ℂ)
    (weight : Fin (2 * k + 4) → ℝ) : Prop :=
  ∀ (r : Fin (2 * k + 4 + 1)) (U : Fin r.val → Fin q)
    (V : Fin (2 * k + 4 - r.val) → Fin q),
    2 ≤ r.val → r.val ≤ 2 * k + 2 →
    Function.Injective U → Function.Injective V →
    (mixed (by have hr := r.isLt; omega) ζ weight p U V).det ≠ 0

theorem eventually_all_mixed {k q : ℕ}
    (X Z : ℝ → ℝ) (A AT : ℝ) (hx : ContinuousAt X 0) (hz : ContinuousAt Z 0)
    (hx0 : X 0 = 1) (hz0 : Z 0 = A) (hA : 0 < A) (hAT : 0 < AT)
    (hpos : ∀ᶠ e in 𝓝[>] (0 : ℝ), ∀ j, 0 < weights k X Z AT e j)
    (ζ : ℂ) (hq : q ≠ 0) (hζ : IsPrimitiveRoot ζ q)
    (p : Fin (2 * k + 4) → ℂ) (hp : ∀ j, p j ≠ 0) :
    ∀ᶠ e in 𝓝[>] (0 : ℝ), MixedMinors (q := q) ζ p (weights k X Z AT e) := by
  classical
  unfold MixedMinors
  apply Filter.eventually_all.mpr
  intro r
  apply Filter.eventually_all.mpr
  intro U
  apply Filter.eventually_all.mpr
  intro V
  by_cases hh : 2 ≤ r.val ∧ r.val ≤ 2 * k + 2 ∧
      Function.Injective U ∧ Function.Injective V
  · have hd := eventually_mixed_det_ne_zero
      (k := k) (r := r.val) (s := 2 * k + 4 - r.val) (by have hr := r.isLt; omega) hh.1 hh.2.1 X Z A AT
      hx hz hx0 hz0 hA hAT hpos ζ hq hζ p hp U V hh.2.2.1 hh.2.2.2
    exact hd.mono (fun _ h _ _ _ _ => h)
  · exact Filter.Eventually.of_forall
      (fun _ h1 h2 h3 h4 => False.elim (hh ⟨h1, h2, h3, h4⟩))

theorem exists_balanced_minors (k : ℕ) (ζ : ℂ) {q : ℕ}
    (hq : q ≠ 0) (hζ : IsPrimitiveRoot ζ q)
    (p : Fin (2 * k + 4) → ℂ) (hp : ∀ j, p j ≠ 0) :
    ∃ weight : Fin (2 * k + 4) → ℝ,
      (∀ j, 0 < weight j) ∧
      (∑ j, (-1 : ℝ) ^ j.val * weight j) = 0 ∧
      (∑ j, (-1 : ℝ) ^ j.val * Complex.normSq (p j) / weight j) = 0 ∧
      MixedMinors (q := q) ζ p weight ∧
      (∀ U : Fin (2 * k + 4) → Fin q, Function.Injective U →
        (Matrix.of (fun i j => uRow ζ weight (U i) j)).det ≠ 0) ∧
      (∀ V : Fin (2 * k + 4) → Fin q, Function.Injective V →
        (Matrix.of (fun i j => vRow ζ weight p (V i) j)).det ≠ 0) := by
  let a : Fin (2 * k + 4) → ℝ := fun j => Complex.normSq (p j)
  let iA : Fin (2 * k + 4) := (Fin.natAdd (2 * k) (0 : Fin 2)).succ.succ
  let iT : Fin (2 * k + 4) := (Fin.natAdd (2 * k) (1 : Fin 2)).succ.succ
  have hA : 0 < a iA := Complex.normSq_pos.mpr (hp iA)
  have hAT : 0 < a iT := Complex.normSq_pos.mpr (hp iT)
  obtain ⟨X, Z, hx, hz, hx0, hz0, hb⟩ :=
    exists_weights k (a 0) (a 1) (a iA) (a iT)
      (fun j => a ((Fin.castAdd 2 j).succ.succ)) hA hAT
  have hpos := hb.mono (fun _ he => he.1)
  have hm := eventually_all_mixed X Z (a iA) (a iT) hx hz hx0 hz0 hA hAT
    hpos ζ hq hζ p hp
  obtain ⟨e, he, hme⟩ := (hb.and hm).exists
  refine ⟨weights k X Z (a iT) e, he.1, he.2.1, ?_, hme, ?_, ?_⟩
  · have ha := pack_eta k a
    change pack k (a 0) (a 1) (fun j => a ((Fin.castAdd 2 j).succ.succ))
      (a iA) (a iT) = a at ha
    simpa only [ha] using he.2.2
  · intro U hU
    exact u_det_ne_zero ζ hq hζ _ he.1 U hU
  · intro V hV
    exact v_det_ne_zero ζ hq hζ _ he.1 p hp V hV

end P14EvenFourierUniform

end
end

section

/-! The actual balanced two-layer Fourier family spans in every d+1 rows.
All pure and mixed spanning premises are discharged by its same-weight minors. -/

noncomputable section
namespace P14EvenFourierSpanning
open Submodule Matrix P14EvenFourierPhysical P14EvenFourierUniform
open scoped BigOperators

def rows {d q : ℕ} (ζ : ℂ) (weight : Fin d → ℝ) (p : Fin d → ℂ) :
    Fin q ⊕ Fin q → Fin d → ℂ :=
  Sum.elim (uRow ζ weight) (vRow ζ weight p)

theorem mixed_spans {k q : ℕ} (ζ : ℂ)
    (weight : Fin (2 * k + 4) → ℝ) (p : Fin (2 * k + 4) → ℂ)
    (hm : MixedMinors (q := q) ζ p weight)
    (r s : ℕ) (hrs : r + s = 2 * k + 4) (hr : 2 ≤ r) (hs : 2 ≤ s)
    (U : Fin r → Fin q) (V : Fin s → Fin q)
    (hU : Function.Injective U) (hV : Function.Injective V) :
    span ℂ (Set.range (fun i : Fin r ⊕ Fin s =>
      Sum.elim (fun a => rows ζ weight p (.inl (U a)))
        (fun b => rows ζ weight p (.inr (V b))) i)) = ⊤ := by
  have hse : s = 2 * k + 4 - r := by omega
  subst s
  have hd := hm ⟨r, by omega⟩ U V hr (by change r ≤ 2 * k + 2; omega) hU hV
  let c : Fin r ⊕ Fin (2 * k + 4 - r) → Fin (2 * k + 4) :=
    P14EvenFourierTransformed.coordinate hrs
  let F : (Fin (2 * k + 4) → ℂ) →ₗ[ℂ]
      ((Fin r ⊕ Fin (2 * k + 4 - r)) → ℂ) := {
    toFun := fun v j => v (c j)
    map_add' := fun _ _ => rfl
    map_smul' := fun _ _ => rfl }
  let f : Fin r ⊕ Fin (2 * k + 4 - r) → Fin (2 * k + 4) → ℂ :=
    Sum.elim (fun a => rows ζ weight p (.inl (U a)))
      (fun b => rows ζ weight p (.inr (V b)))
  have he : (F ∘ f) = (fun i => mixed hrs ζ weight p U V i) := by
    funext i j
    rcases i with a | b <;> rfl
  have hli : LinearIndependent ℂ f := by
    apply LinearIndependent.of_comp F
    rw [he]
    exact Matrix.linearIndependent_rows_of_det_ne_zero hd
  exact hli.span_eq_top_of_card_eq_finrank' (by simpa using hrs)

theorem rows_ne_zero {k q : ℕ} (ζ : ℂ)
    (weight : Fin (2 * k + 4) → ℝ) (hpos : ∀ j, 0 < weight j)
    (p : Fin (2 * k + 4) → ℂ) (hp : ∀ j, p j ≠ 0) :
    ∀ i : Fin q ⊕ Fin q, rows ζ weight p i ≠ 0 := by
  intro i
  have hs : (Real.sqrt (weight 0) : ℂ) ≠ 0 := by
    exact_mod_cast Real.sqrt_ne_zero'.mpr (hpos 0)
  have h0 : rows ζ weight p i 0 ≠ 0 := by
    rcases i with a | b
    · simpa [rows, uRow] using hs
    · simpa [rows, vRow] using div_ne_zero (hp 0) hs
  exact fun h => h0 (congrFun h 0)

theorem every_plus_one {k q : ℕ} (ζ : ℂ)
    (weight : Fin (2 * k + 4) → ℝ) (p : Fin (2 * k + 4) → ℂ)
    (hm : MixedMinors (q := q) ζ p weight)
    (hu : ∀ U : Fin (2 * k + 4) → Fin q, Function.Injective U →
      (Matrix.of (fun i j => uRow ζ weight (U i) j)).det ≠ 0)
    (hv : ∀ V : Fin (2 * k + 4) → Fin q, Function.Injective V →
      (Matrix.of (fun i j => vRow ζ weight p (V i) j)).det ≠ 0)
    (A : Finset (Fin q ⊕ Fin q)) (hA : A.card = 2 * k + 4 + 1) :
    span ℂ (Set.range (fun a : A => rows ζ weight p a.val)) = ⊤ := by
  apply P14TwoLayerSpanExtraction.every_plus_one (K := ℂ) (2 * k + 4)
    (by omega) (rows ζ weight p) ?_ ?_ ?_ A hA
  · intro U hU
    have hi : LinearIndependent ℂ (fun i => rows ζ weight p (.inl (U i))) :=
      Matrix.linearIndependent_rows_of_det_ne_zero (hu U hU)
    exact hi.span_eq_top_of_card_eq_finrank' (by simp)
  · intro V hV
    have hi : LinearIndependent ℂ (fun i => rows ζ weight p (.inr (V i))) :=
      Matrix.linearIndependent_rows_of_det_ne_zero (hv V hV)
    exact hi.span_eq_top_of_card_eq_finrank' (by simp)
  · exact mixed_spans ζ weight p hm

theorem exists_balanced_spanning (k : ℕ) (ζ : ℂ) {q : ℕ}
    (hq : q ≠ 0) (hζ : IsPrimitiveRoot ζ q)
    (p : Fin (2 * k + 4) → ℂ) (hp : ∀ j, p j ≠ 0) :
    ∃ weight : Fin (2 * k + 4) → ℝ,
      (∀ j, 0 < weight j) ∧
      (∑ j, (-1 : ℝ) ^ j.val * weight j) = 0 ∧
      (∑ j, (-1 : ℝ) ^ j.val * Complex.normSq (p j) / weight j) = 0 ∧
      (∀ i : Fin q ⊕ Fin q, rows ζ weight p i ≠ 0) ∧
      (∀ A : Finset (Fin q ⊕ Fin q), A.card = 2 * k + 4 + 1 →
        span ℂ (Set.range (fun a : A => rows ζ weight p a.val)) = ⊤) := by
  obtain ⟨weight, hpos, hbU, hbV, hm, hu, hv⟩ := exists_balanced_minors k ζ hq hζ p hp
  exact ⟨weight, hpos, hbU, hbV, rows_ne_zero ζ weight hpos p hp,
    every_plus_one ζ weight p hm hu hv⟩

end P14EvenFourierSpanning

end
end

section

/-! Exact scalar-row transport to the established spectral Fourier family.
The same positive weights retain spanning and both shifted balance equations. -/

noncomputable section
namespace P14EvenFourierPhysicalTransport
open Submodule P14EvenFourierSpanning P14FourierSpectralWeights
open P14FourierPhysicalFamily P14EvenFourierPhysical
open scoped BigOperators

def coefficients (n d m : ℕ) : Fin m → ℂ :=
  fun j => star (spectralWeight (fourierRoot n) d (d + j.val))

def factor {n : ℕ} (d : ℕ) (i : Fin n ⊕ Fin n) : ℂ :=
  fourierNormalization n * fourierRoot n ^ (Sum.elim Fin.val Fin.val i * d)

theorem factor_ne_zero {n : ℕ} (hn : 0 < n) (d : ℕ) (i : Fin n ⊕ Fin n) :
    factor d i ≠ 0 :=
  mul_ne_zero (fourierNormalization_ne_zero n hn)
    (pow_ne_zero _ ((fourierRoot_isPrimitiveRoot n hn).ne_zero (Nat.ne_of_gt hn)))

theorem physical_eq {n m : ℕ} (d : ℕ) (H : Fin m → ℝ) (i : Fin n ⊕ Fin n) :
    physicalFamily d H i =
      factor d i • rows (fourierRoot n) H (coefficients n d m) i := by
  funext j
  rcases i with a | b <;>
    simp only [physicalFamily, factor, rows, uRow, vRow, coefficients, Sum.elim_inl,
      Sum.elim_inr, Pi.smul_apply, smul_eq_mul, Nat.mul_add, pow_add] <;> ring

theorem span_scaled {ι : Type*} {M : Type*} [AddCommGroup M] [Module ℂ M]
    (x : ι → M) (c : ι → ℂ) (hc : ∀ i, c i ≠ 0) :
    span ℂ (Set.range (fun i => c i • x i)) = span ℂ (Set.range x) := by
  apply le_antisymm
  · apply span_le.mpr
    rintro _ ⟨i, rfl⟩
    exact smul_mem _ _ (subset_span ⟨i, rfl⟩)
  · apply span_le.mpr
    rintro _ ⟨i, rfl⟩
    have h := smul_mem (span ℂ (Set.range (fun i => c i • x i))) (c i)⁻¹
      (subset_span (Set.mem_range_self i))
    change x i ∈ span ℂ (Set.range (fun i => c i • x i))
    simpa only [smul_smul, inv_mul_cancel₀ (hc i), one_smul] using h

theorem exists_physical_spanning (k n d : ℕ) (hn : 0 < n)
    (hdim : d + (2 * k + 4) = n) :
    ∃ H : Fin (2 * k + 4) → ℝ,
      (∀ j, 0 < H j) ∧
      (∑ j, (-1 : ℝ) ^ (d + j.val) * H j) = 0 ∧
      (∑ j, (-1 : ℝ) ^ (d + j.val) *
        Complex.normSq (spectralWeight (fourierRoot n) d (d + j.val)) / H j) = 0 ∧
      (∀ i : Fin n ⊕ Fin n, physicalFamily d H i ≠ 0) ∧
      (∀ A : Finset (Fin n ⊕ Fin n), A.card = 2 * k + 4 + 1 →
        span ℂ (Set.range (fun a : A => physicalFamily (n := n) d H a.val)) = ⊤) := by
  have hp : ∀ j, coefficients n d (2 * k + 4) j ≠ 0 := by
    intro j
    apply star_spectralWeight_ne_zero (fourierRoot_isPrimitiveRoot n hn)
    · omega
    · have hj := j.isLt
      omega
  obtain ⟨H, hpos, hbU, hbV, hnz, hspan⟩ :=
    exists_balanced_spanning k (fourierRoot n) (Nat.ne_of_gt hn)
      (fourierRoot_isPrimitiveRoot n hn) (coefficients n d (2 * k + 4)) hp
  have hbV' : (∑ j, (-1 : ℝ) ^ j.val *
      Complex.normSq (spectralWeight (fourierRoot n) d (d + j.val)) / H j) = 0 := by
    simpa only [coefficients, Complex.star_def, Complex.normSq_conj] using hbV
  refine ⟨H, hpos, ?_, ?_, ?_, ?_⟩
  · calc
      _ = (-1 : ℝ) ^ d * ∑ j, (-1 : ℝ) ^ j.val * H j := by
        rw [Finset.mul_sum]
        apply Finset.sum_congr rfl
        intro j _
        rw [pow_add]
        ring
      _ = 0 := by rw [hbU, mul_zero]
  · calc
      _ = (-1 : ℝ) ^ d * ∑ j, (-1 : ℝ) ^ j.val *
          Complex.normSq (spectralWeight (fourierRoot n) d (d + j.val)) / H j := by
        rw [Finset.mul_sum]
        apply Finset.sum_congr rfl
        intro j _
        rw [pow_add]
        ring
      _ = 0 := by rw [hbV', mul_zero]
  · intro i
    rw [physical_eq]
    exact smul_ne_zero (factor_ne_zero hn d i) (hnz i)
  · intro A hA
    have he : (fun a : A => physicalFamily (n := n) d H a.val) =
        (fun a : A => factor d a.val •
          rows (fourierRoot n) H (coefficients n d (2 * k + 4)) a.val) :=
      funext (fun a => physical_eq d H a.val)
    rw [he, span_scaled
      (fun a : A => rows (fourierRoot n) H (coefficients n d (2 * k + 4)) a.val)
      (fun a : A => factor d a.val) (fun a : A => factor_ne_zero hn d a.val)]
    exact hspan A hA

end P14EvenFourierPhysicalTransport

end
end

section

/-!
The spectral polynomial agrees with the original spectral weight at every
natural frequency for a nonzero base. Vanishing below the retained block
also lets an arbitrary weighted sum extend to the full frequency range.
-/

namespace P14FourierSpectralFrequencySum

open P14FourierSpectralWeights P14FourierSpectralPolynomial
open scoped BigOperators

theorem eval_spectralPolynomial_all (ζ : ℂ) (d q : ℕ) (hζ : ζ ≠ 0) :
    (spectralPolynomial ζ d).eval (ζ ^ q) = spectralWeight ζ d q := by
  by_cases hdq : d ≤ q
  · exact eval_spectralPolynomial ζ d q hdq hζ
  · have hq : q < d := lt_of_not_ge hdq
    rw [spectralWeight_eq_zero_of_lt ζ d q hq]
    unfold spectralPolynomial
    rw [Polynomial.eval_prod]
    apply Finset.prod_eq_zero (Finset.mem_univ (⟨q, hq⟩ : Fin d))
    simp only [Polynomial.eval_sub, Polynomial.eval_one, Polynomial.eval_C_mul,
      Polynomial.eval_X]
    rw [inv_mul_cancel₀ (pow_ne_zero q hζ), sub_self]

theorem sum_retained_star_spectralWeight_eq_sum_all {n k d : ℕ}
    (ζ : ℂ) (hdim : d + k = n) (f : Fin n → ℂ) :
    (∑ j : Fin k,
      f ⟨d + j.val, (Nat.add_lt_add_left j.isLt d).trans_eq hdim⟩ *
        star (spectralWeight ζ d (d + j.val))) =
      ∑ q : Fin n, f q * star (spectralWeight ζ d q.val) := by
  subst n
  have hlow :
      (∑ q : Fin d, f (Fin.castAdd k q) * star (spectralWeight ζ d q.val)) = 0 := by
    apply Finset.sum_eq_zero
    intro q _
    rw [spectralWeight_eq_zero_of_lt ζ d q.val q.isLt, star_zero, mul_zero]
  have hsplit := Fin.sum_univ_add (a := d) (b := k)
    (fun q : Fin (d + k) => f q * star (spectralWeight ζ d q.val))
  change (∑ q : Fin (d + k), f q * star (spectralWeight ζ d q.val)) =
    (∑ q : Fin d, f (Fin.castAdd k q) * star (spectralWeight ζ d q.val)) +
      ∑ j : Fin k, f (Fin.natAdd d j) * star (spectralWeight ζ d (d + j.val)) at hsplit
  rw [hlow, zero_add] at hsplit
  exact hsplit.symm


end P14FourierSpectralFrequencySum
end

section

/-!
The actual physical cross pairing is a full-frequency spectral sum. For a
positive Fourier order, the same sum uses evaluations of the ordinary spectral
polynomial. These identities do not assert support or orthogonality.
-/

namespace P14FourierCrossFrequencySum

open P14SeedInterfaceDim P14FourierPhysicalFamily P14FourierPhysicalPairings
open P14FourierSpectralWeights P14FourierSpectralPolynomial P14FourierSpectralFrequencySum
open scoped BigOperators

theorem cross_pairing_full_frequency {n k : ℕ}
    (d : ℕ) (hdim : d + k = n) (H : Fin k → ℝ)
    (hH : ∀ j, 0 < H j) (a b : Fin n) :
    pair (physicalFamily d H (Sum.inl a)) (physicalFamily d H (Sum.inr b)) =
      scale n * ∑ q : Fin n, phase a b q.val *
        star (spectralWeight (fourierRoot n) d q.val) := by
  rw [cross_pairing d H hH a b]
  exact congrArg (fun z : ℂ => scale n * z)
    (sum_retained_star_spectralWeight_eq_sum_all (fourierRoot n) hdim
      (fun q : Fin n => phase a b q.val))

theorem cross_pairing_full_frequency_polynomial {n k : ℕ}
    (hn : 0 < n) (d : ℕ) (hdim : d + k = n) (H : Fin k → ℝ)
    (hH : ∀ j, 0 < H j) (a b : Fin n) :
    pair (physicalFamily d H (Sum.inl a)) (physicalFamily d H (Sum.inr b)) =
      scale n * ∑ q : Fin n, phase a b q.val *
        star ((spectralPolynomial (fourierRoot n) d).eval ((fourierRoot n) ^ q.val)) := by
  rw [cross_pairing_full_frequency d hdim H hH a b]
  have hroot : fourierRoot n ≠ 0 :=
    (fourierRoot_isPrimitiveRoot n hn).ne_zero (Nat.ne_of_gt hn)
  apply congrArg (fun z : ℂ => scale n * z)
  apply Finset.sum_congr rfl
  intro q _
  rw [eval_spectralPolynomial_all (fourierRoot n) d q.val hroot]


end P14FourierCrossFrequencySum
end

section

/-! Exact cross-half support of the actual positive physical family.
It is independent of the parameter choice beyond strict positivity. -/

namespace P14FourierCrossSupport

open P14FourierPolynomialExtraction P14FourierSpectralCoefficients
open P14FourierSpectralPolynomial P14FourierSpectralWeights
open P14FourierPhysicalPairings P14FourierPhysicalFamily P14SeedInterfaceDim
open P14FourierCrossFrequencySum

theorem cross_pairing_coefficient {n k d : ℕ} (hn : 0 < n)
    (hdim : d + k = n) (hk : 0 < k) (H : Fin k → ℝ)
    (hH : ∀ j, 0 < H j) (a b : Fin n) :
    pair (physicalFamily d H (Sum.inl a)) (physicalFamily d H (Sum.inr b)) =
      scale n * ((n : ℂ) *
        star ((spectralPolynomial (fourierRoot n) d).coeff (b - a).val)) := by
  have hd : d < n := by omega
  rw [cross_pairing_full_frequency_polynomial hn d hdim H hH a b]
  rw [fourier_extract_coefficient hn _
    ((natDegree_spectralPolynomial_le (fourierRoot n) d).trans_lt hd)]

theorem cross_pairing_ne_zero_iff {n k d : ℕ} (hn : 0 < n)
    (hdim : d + k = n) (hk : 0 < k) (H : Fin k → ℝ)
    (hH : ∀ j, 0 < H j) (a b : Fin n) :
    pair (physicalFamily d H (Sum.inl a)) (physicalFamily d H (Sum.inr b)) ≠ 0 ↔
      (b - a).val ≤ d := by
  rw [cross_pairing_coefficient hn hdim hk H hH a b]
  rw [mul_ne_zero_iff_left (scale_ne_zero n hn)]
  rw [mul_ne_zero_iff_left (Nat.cast_ne_zero.mpr (Nat.ne_of_gt hn))]
  rw [star_ne_zero, fourier_spectral_coeff_ne_zero_iff hn (by omega)]

theorem cross_pairing_eq_zero_iff {n k d : ℕ} (hn : 0 < n)
    (hdim : d + k = n) (hk : 0 < k) (H : Fin k → ℝ)
    (hH : ∀ j, 0 < H j) (a b : Fin n) :
    pair (physicalFamily d H (Sum.inl a)) (physicalFamily d H (Sum.inr b)) = 0 ↔
      d < (b - a).val := by
  have h := not_congr (cross_pairing_ne_zero_iff hn hdim hk H hH a b)
  simpa only [not_not, Nat.not_le] using h


end P14FourierCrossSupport
end

section

/-! Half-period row separation gives the exact alternating Fourier phase.
No physical vector family or moment assumption is introduced here. -/

namespace P14FourierOppositePhase

open P14FourierSpectralWeights

theorem primitive_half_pow {ζ : ℂ} {n : ℕ}
    (hn : 0 < n) (he : Even n) (hζ : IsPrimitiveRoot ζ n) :
    ζ ^ (n / 2) = -1 := by
  have hhalf : n / 2 * 2 = n := by
    obtain ⟨m, hm⟩ := he
    omega
  have hpos : n / 2 ≠ 0 := by omega
  have hlt : n / 2 < n := by omega
  have hsq : (ζ ^ (n / 2)) ^ 2 = 1 := by
    rw [← pow_mul, hhalf, hζ.pow_eq_one]
  exact (sq_eq_one_iff.mp hsq).resolve_left
    (hζ.pow_ne_one_of_pos_of_lt hpos hlt)

theorem primitive_opposite_phase {ζ : ℂ} {n : ℕ}
    (hn : 0 < n) (he : Even n) (hζ : IsPrimitiveRoot ζ n)
    (a b : ℕ) (hb : b = (a + n / 2) % n) (q : ℕ) :
    star (ζ ^ (a * q)) * ζ ^ (b * q) = (-1 : ℂ) ^ q := by
  have hunit : star ζ * ζ = 1 := by
    change (starRingEnd ℂ) ζ * ζ = 1
    simpa only [hζ.norm'_eq_one (Nat.ne_of_gt hn), one_pow, Complex.ofReal_one]
      using Complex.conj_mul' ζ
  have hself : star (ζ ^ a) * ζ ^ a = 1 := by
    rw [star_pow, ← mul_pow, hunit, one_pow]
  have hbpow : ζ ^ b = ζ ^ a * (-1) := by
    rw [hb, ← pow_eq_pow_mod (a + n / 2) hζ.pow_eq_one,
      pow_add, primitive_half_pow hn he hζ]
  have hphase : star (ζ ^ a) * ζ ^ b = -1 := by
    rw [hbpow, ← mul_assoc, hself, one_mul]
  calc
    star (ζ ^ (a * q)) * ζ ^ (b * q) = (star (ζ ^ a) * ζ ^ b) ^ q := by
      simp only [pow_mul, star_pow, mul_pow]
    _ = (-1 : ℂ) ^ q := congrArg (fun z : ℂ => z ^ q) hphase

theorem fourierRoot_opposite_phase {n : ℕ}
    (hn : 0 < n) (he : Even n) (a b : Fin n)
    (hb : b.val = (a.val + n / 2) % n) (q : ℕ) :
    star (fourierRoot n ^ (a.val * q)) *
      fourierRoot n ^ (b.val * q) = (-1 : ℂ) ^ q := by
  exact primitive_opposite_phase hn he (fourierRoot_isPrimitiveRoot n hn)
    a.val b.val hb q


end P14FourierOppositePhase
end

section

/-!
Signed real moment expressions and their scalar transport to the full
Option-indexed coordinate space. The coefficient and parameter transports
use the same inverse equivalence. These identities neither construct a
matching point nor assert orthogonality of physical Fourier rows.
-/

noncomputable section

namespace P14FourierSignedMoments

open P14FourierSpectralWeights P14FourierMatchingBlocks
open P14FourierClearedRows P14FourierActualMatchingSurvival
open scoped BigOperators

def firstMoment {r s : ℕ} (d : ℕ) (h : Fin r ⊕ Fin s → ℝ) : ℝ :=
  ∑ j, (-1 : ℝ) ^ retainedFrequency d j * h j

def secondMoment {r s : ℕ} (n d : ℕ) (h : Fin r ⊕ Fin s → ℝ) : ℝ :=
  ∑ j, (-1 : ℝ) ^ retainedFrequency d j *
    Complex.normSq (spectralWeight (fourierRoot n) d (retainedFrequency d j)) / h j

def signProduct {r s : ℕ} (d : ℕ) : ℂ :=
  ∏ j : Fin r ⊕ Fin s, (-1 : ℂ) ^ retainedFrequency d j

def parameterProduct {r s : ℕ} (h : Fin r ⊕ Fin s → ℝ) : ℂ :=
  ∏ j, (h j : ℂ)

def transportedParameter {r s : ℕ} {σ : Type*} (d : ℕ)
    (e : (Fin r ⊕ Fin s) ≃ Option σ) (h : Fin r ⊕ Fin s → ℝ) : Option σ → ℂ :=
  fun o => signedParameter d h (e.symm o)

private theorem ofReal_fintype_sum {ι : Type*} [Fintype ι] (f : ι → ℝ) :
    ((∑ i, f i : ℝ) : ℂ) = ∑ i, (f i : ℂ) :=
  map_sum Complex.ofRealHom f Finset.univ

private theorem ofReal_div_signed (q : ℕ) (a x : ℝ) :
    (a : ℂ) / ((-1 : ℂ) ^ q * (x : ℂ)) =
      (((-1 : ℝ) ^ q * a / x : ℝ) : ℂ) := by
  have hsign : ((-1 : ℂ) ^ q)⁻¹ = (-1 : ℂ) ^ q := by
    rw [← inv_pow, inv_neg_one]
  simp only [Complex.ofReal_div, Complex.ofReal_inv, Complex.ofReal_mul, Complex.ofReal_pow,
    Complex.ofReal_neg, Complex.ofReal_one, div_eq_mul_inv, mul_inv_rev, hsign,
    mul_assoc, mul_comm, mul_left_comm]

theorem sum_transportedParameter {r s : ℕ} {σ : Type*} [Fintype σ]
    (d : ℕ) (e : (Fin r ⊕ Fin s) ≃ Option σ) (h : Fin r ⊕ Fin s → ℝ) :
    (∑ o, transportedParameter d e h o) = (firstMoment d h : ℂ) := by
  calc
    _ = ∑ j, signedParameter d h j :=
      Equiv.sum_comp e.symm (signedParameter d h)
    _ = (firstMoment d h : ℂ) := by
      unfold firstMoment
      rw [ofReal_fintype_sum]
      apply Finset.sum_congr rfl
      intro j _
      simp only [signedParameter, Complex.ofReal_mul, Complex.ofReal_pow,
        Complex.ofReal_neg, Complex.ofReal_one]

theorem prod_transportedParameter {r s : ℕ} {σ : Type*} [Fintype σ]
    (d : ℕ) (e : (Fin r ⊕ Fin s) ≃ Option σ) (h : Fin r ⊕ Fin s → ℝ) :
    (∏ o, transportedParameter d e h o) =
      signProduct (r := r) (s := s) d * parameterProduct h := by
  calc
    _ = ∏ j, signedParameter d h j :=
      Equiv.prod_comp e.symm (signedParameter d h)
    _ = signProduct (r := r) (s := s) d * parameterProduct h := by
      simp only [signedParameter, signProduct, parameterProduct, Finset.prod_mul_distrib]

theorem sum_equationCoefficient_div_transportedParameter
    {r s : ℕ} {σ : Type*} [Fintype σ] (n d : ℕ)
    (e : (Fin r ⊕ Fin s) ≃ Option σ) (h : Fin r ⊕ Fin s → ℝ) :
    (∑ o, equationCoefficient (fourierRoot n) d e o / transportedParameter d e h o) =
      (secondMoment n d h : ℂ) := by
  calc
    _ = ∑ j, (Complex.normSq
          (spectralWeight (fourierRoot n) d (retainedFrequency d j)) : ℂ) /
        signedParameter d h j :=
      Equiv.sum_comp e.symm (fun j =>
        (Complex.normSq
          (spectralWeight (fourierRoot n) d (retainedFrequency d j)) : ℂ) /
            signedParameter d h j)
    _ = (secondMoment n d h : ℂ) := by
      unfold secondMoment
      rw [ofReal_fintype_sum]
      apply Finset.sum_congr rfl
      intro j _
      exact ofReal_div_signed (retainedFrequency d j)
        (Complex.normSq (spectralWeight (fourierRoot n) d (retainedFrequency d j))) (h j)

theorem transportedParameter_ne_zero {r s : ℕ} {σ : Type*}
    (d : ℕ) (e : (Fin r ⊕ Fin s) ≃ Option σ) (h : Fin r ⊕ Fin s → ℝ)
    (hpos : ∀ j, 0 < h j) (o : Option σ) :
    transportedParameter d e h o ≠ 0 := by
  change (-1 : ℂ) ^ retainedFrequency d (e.symm o) * (h (e.symm o) : ℂ) ≠ 0
  apply mul_ne_zero
  · exact pow_ne_zero _ (neg_ne_zero.mpr (one_ne_zero : (1 : ℂ) ≠ 0))
  · exact Complex.ofReal_ne_zero.mpr (ne_of_gt (hpos (e.symm o)))

theorem prod_transportedParameter_ne_zero {r s : ℕ} {σ : Type*} [Fintype σ]
    (d : ℕ) (e : (Fin r ⊕ Fin s) ≃ Option σ) (h : Fin r ⊕ Fin s → ℝ)
    (hpos : ∀ j, 0 < h j) :
    (∏ o, transportedParameter d e h o) ≠ 0 := by
  apply Finset.prod_ne_zero_iff.mpr
  intro o _
  exact transportedParameter_ne_zero d e h hpos o


end P14FourierSignedMoments
end
end

section

/-!
Strict differentiation of the finite real first and reciprocal moment maps.
The weights are arbitrary; only the coordinates of the base point must be nonzero.
This module supplies a derivative, not a rank or local-existence assertion.
-/

noncomputable section

open scoped BigOperators

namespace P14PositiveMomentStrictDerivative

variable {ι : Type*} [Fintype ι]

def firstMoment (ε h : ι → ℝ) : ℝ :=
  ∑ i, ε i * h i

def reciprocalMoment (ε c h : ι → ℝ) : ℝ :=
  ∑ i, ε i * c i / h i

def momentMap (ε c : ι → ℝ) (h : ι → ℝ) : ℝ × ℝ :=
  (firstMoment ε h, reciprocalMoment ε c h)

def momentDerivative (ε c h : ι → ℝ) :
    (ι → ℝ) →L[ℝ] (ℝ × ℝ) :=
  (∑ i, ε i • (ContinuousLinearMap.proj i : (ι → ℝ) →L[ℝ] ℝ)).prod
    (∑ i, (-(ε i * c i / (h i) ^ 2)) •
      (ContinuousLinearMap.proj i : (ι → ℝ) →L[ℝ] ℝ))

theorem momentDerivative_apply (ε c h v : ι → ℝ) :
    momentDerivative ε c h v =
      (∑ i, ε i * v i, ∑ i, -(ε i * c i / (h i) ^ 2) * v i) := by
  simp only [momentDerivative, ContinuousLinearMap.prod_apply, sum_apply,
    smul_apply, ContinuousLinearMap.proj_apply, smul_eq_mul]

theorem hasStrictFDerivAt_firstMoment (ε h : ι → ℝ) :
    HasStrictFDerivAt (firstMoment ε)
      (∑ i, ε i • (ContinuousLinearMap.proj i : (ι → ℝ) →L[ℝ] ℝ)) h := by
  unfold firstMoment
  apply HasStrictFDerivAt.fun_sum
  intro i _
  simpa only [ContinuousLinearMap.proj_apply] using
    ((ContinuousLinearMap.proj i : (ι → ℝ) →L[ℝ] ℝ).hasStrictFDerivAt
      (x := h)).const_mul (ε i)

theorem hasStrictFDerivAt_reciprocalMoment (ε c h : ι → ℝ)
    (hh : ∀ i, h i ≠ 0) :
    HasStrictFDerivAt (reciprocalMoment ε c)
      (∑ i, (-(ε i * c i / (h i) ^ 2)) •
        (ContinuousLinearMap.proj i : (ι → ℝ) →L[ℝ] ℝ)) h := by
  unfold reciprocalMoment
  apply HasStrictFDerivAt.fun_sum
  intro i _
  have hs : HasStrictDerivAt (fun t : ℝ => ε i * c i / t)
      (-(ε i * c i / (h i) ^ 2)) (h i) := by
    simpa only [div_eq_mul_inv, mul_neg] using
      (HasStrictDerivAt.const_mul (ε i * c i) (hasStrictDerivAt_inv (hh i)))
  simpa only [Function.comp_def, ContinuousLinearMap.proj_apply] using
    hs.comp_hasStrictFDerivAt h
      (ContinuousLinearMap.proj i : (ι → ℝ) →L[ℝ] ℝ).hasStrictFDerivAt

theorem hasStrictFDerivAt_momentMap (ε c h : ι → ℝ)
    (hh : ∀ i, h i ≠ 0) :
    HasStrictFDerivAt (momentMap ε c) (momentDerivative ε c h) h := by
  exact (hasStrictFDerivAt_firstMoment ε h).prodMk
    (hasStrictFDerivAt_reciprocalMoment ε c h hh)

end P14PositiveMomentStrictDerivative

end
end

section

/-!
The signed Fourier moments on one common finite coordinate set, together with
their exact transport to any frequency-preserving split. A signed real moment
point recovers positive common parameters without choosing an auxiliary split.
-/

noncomputable section

namespace P14FourierCommonMomentTransport

open P14FourierSpectralWeights P14FourierMatchingBlocks
open scoped BigOperators

def commonFirstMoment {k : ℕ} (d : ℕ) (H : Fin k → ℝ) : ℝ :=
  ∑ i, (-1 : ℝ) ^ (d + i.val) * H i

def commonSecondMoment {k : ℕ} (n d : ℕ) (H : Fin k → ℝ) : ℝ :=
  ∑ i, (-1 : ℝ) ^ (d + i.val) *
    Complex.normSq (spectralWeight (fourierRoot n) d (d + i.val)) / H i

theorem firstMoment_comp {r s k : ℕ} (d : ℕ)
    (κ : (Fin r ⊕ Fin s) ≃ Fin k)
    (hf : ∀ j, retainedFrequency d j = d + (κ j).val) (H : Fin k → ℝ) :
    P14FourierSignedMoments.firstMoment d (H ∘ κ) = commonFirstMoment d H := by
  unfold P14FourierSignedMoments.firstMoment commonFirstMoment
  simp only [Function.comp_apply, hf]
  exact Equiv.sum_comp κ (fun i : Fin k => (-1 : ℝ) ^ (d + i.val) * H i)

theorem secondMoment_comp {r s k : ℕ} (n d : ℕ)
    (κ : (Fin r ⊕ Fin s) ≃ Fin k)
    (hf : ∀ j, retainedFrequency d j = d + (κ j).val) (H : Fin k → ℝ) :
    P14FourierSignedMoments.secondMoment n d (H ∘ κ) =
      commonSecondMoment n d H := by
  unfold P14FourierSignedMoments.secondMoment commonSecondMoment
  simp only [Function.comp_apply, hf]
  exact Equiv.sum_comp κ (fun i : Fin k => (-1 : ℝ) ^ (d + i.val) *
    Complex.normSq (spectralWeight (fourierRoot n) d (d + i.val)) / H i)

theorem exists_positive_common_parameters {k : ℕ} {σ : Type*} [Fintype σ]
    (n d : ℕ) (E : Fin k ≃ Option σ) (z : Option σ → ℝ)
    (hm : P14PositiveMomentStrictDerivative.momentMap (fun _ => 1)
      (fun o => Complex.normSq
        (spectralWeight (fourierRoot n) d (d + (E.symm o).val))) z = (0, 0))
    (hSign : ∀ o, 0 < (-1 : ℝ) ^ (d + (E.symm o).val) * z o) :
    ∃ H : Fin k → ℝ, (∀ i, 0 < H i) ∧
      commonFirstMoment d H = 0 ∧ commonSecondMoment n d H = 0 ∧
      ∀ o, (-1 : ℂ) ^ (d + (E.symm o).val) * (H (E.symm o) : ℂ) = (z o : ℂ) := by
  let H : Fin k → ℝ := fun i => (-1 : ℝ) ^ (d + i.val) * z (E i)
  have hPositive : ∀ i, 0 < H i := by
    intro i
    simpa only [H, Equiv.symm_apply_apply] using hSign (E i)
  have hRecoverReal : ∀ o,
      (-1 : ℝ) ^ (d + (E.symm o).val) * H (E.symm o) = z o := by
    intro o
    simp only [H, Equiv.apply_symm_apply]
    rw [← mul_assoc, ← mul_pow, neg_mul_neg, one_mul, one_pow, one_mul]
  have hRecoverComplex : ∀ o,
      (-1 : ℂ) ^ (d + (E.symm o).val) * (H (E.symm o) : ℂ) = (z o : ℂ) := by
    intro o
    simpa only [Complex.ofReal_mul, Complex.ofReal_pow, Complex.ofReal_neg,
      Complex.ofReal_one] using congrArg (fun x : ℝ => (x : ℂ)) (hRecoverReal o)
  have hSumReal : (∑ o : Option σ, z o) = 0 := by
    simpa only [P14PositiveMomentStrictDerivative.momentMap,
      P14PositiveMomentStrictDerivative.firstMoment, one_mul] using congrArg Prod.fst hm
  have hReciprocalReal :
      (∑ o : Option σ, Complex.normSq
        (spectralWeight (fourierRoot n) d (d + (E.symm o).val)) / z o) = 0 := by
    simpa only [P14PositiveMomentStrictDerivative.momentMap,
      P14PositiveMomentStrictDerivative.reciprocalMoment, one_mul] using congrArg Prod.snd hm
  have hFirst : commonFirstMoment d H = 0 := by
    unfold commonFirstMoment
    rw [← Equiv.sum_comp E.symm (fun i : Fin k => (-1 : ℝ) ^ (d + i.val) * H i)]
    simpa only [hRecoverReal] using hSumReal
  have hCancel (q : ℕ) (a x : ℝ) :
      (-1 : ℝ) ^ q * a / ((-1 : ℝ) ^ q * x) = a / x :=
    mul_div_mul_left a x
      (pow_ne_zero _ (neg_ne_zero.mpr (one_ne_zero : (1 : ℝ) ≠ 0)))
  have hSecond : commonSecondMoment n d H = 0 := by
    unfold commonSecondMoment
    rw [← Equiv.sum_comp E.symm (fun i : Fin k => (-1 : ℝ) ^ (d + i.val) *
      Complex.normSq (spectralWeight (fourierRoot n) d (d + i.val)) / H i)]
    simpa only [H, Equiv.apply_symm_apply, hCancel] using hReciprocalReal
  exact ⟨H, hPositive, hFirst, hSecond, hRecoverComplex⟩


end P14FourierCommonMomentTransport
end
end

section

/-! The actual two common moments give the intended opposite-row pairings. -/

namespace P14FourierOppositeOrthogonality

open P14FourierPhysicalFamily P14FourierPhysicalPairings P14FourierOppositePhase
open P14FourierCommonMomentTransport P14SeedInterfaceDim

theorem a_opposite_pairing {n k : ℕ} (hn : 0 < n) (he : Even n)
    (d : ℕ) (H : Fin k → ℝ) (hH : ∀ j, 0 ≤ H j) (a b : Fin n)
    (hb : b.val = (a.val + n / 2) % n) :
    pair (physicalFamily d H (Sum.inl a)) (physicalFamily d H (Sum.inl b)) =
      scale n * (commonFirstMoment d H : ℂ) := by
  rw [a_pairing d H hH a b]
  congr 1
  simp only [phase, fourierRoot_opposite_phase hn he a b hb, commonFirstMoment,
    Complex.ofReal_sum, Complex.ofReal_mul, Complex.ofReal_pow,
    Complex.ofReal_neg, Complex.ofReal_one]

theorem b_opposite_pairing {n k : ℕ} (hn : 0 < n) (he : Even n)
    (d : ℕ) (H : Fin k → ℝ) (hH : ∀ j, 0 ≤ H j) (a b : Fin n)
    (hb : b.val = (a.val + n / 2) % n) :
    pair (physicalFamily d H (Sum.inr a)) (physicalFamily d H (Sum.inr b)) =
      scale n * (commonSecondMoment n d H : ℂ) := by
  rw [b_pairing d H hH a b]
  congr 1
  simp only [phase, fourierRoot_opposite_phase hn he a b hb, commonSecondMoment,
    Complex.ofReal_sum, Complex.ofReal_div, Complex.ofReal_mul, Complex.ofReal_pow,
    Complex.ofReal_neg, Complex.ofReal_one]

theorem a_opposite_orthogonal {n k : ℕ} (hn : 0 < n) (he : Even n)
    (d : ℕ) (H : Fin k → ℝ) (hH : ∀ j, 0 ≤ H j)
    (hMoment : commonFirstMoment d H = 0) (a b : Fin n)
    (hb : b.val = (a.val + n / 2) % n) :
    pair (physicalFamily d H (Sum.inl a)) (physicalFamily d H (Sum.inl b)) = 0 := by
  rw [a_opposite_pairing hn he d H hH a b hb, hMoment, Complex.ofReal_zero, mul_zero]

theorem b_opposite_orthogonal {n k : ℕ} (hn : 0 < n) (he : Even n)
    (d : ℕ) (H : Fin k → ℝ) (hH : ∀ j, 0 ≤ H j)
    (hMoment : commonSecondMoment n d H = 0) (a b : Fin n)
    (hb : b.val = (a.val + n / 2) % n) :
    pair (physicalFamily d H (Sum.inr a)) (physicalFamily d H (Sum.inr b)) = 0 := by
  rw [b_opposite_pairing hn he d H hH a b hb, hMoment, Complex.ofReal_zero, mul_zero]


end P14FourierOppositeOrthogonality
end

section

/-! Actual complex rows for every even local dimension at least four.
The prescribed antipodal and cross-layer graph is orthogonal in the same
family whose every-(d+1) spanning has now been proved. -/

noncomputable section
namespace P14EvenFourierExceptional
open Submodule P14EvenFourierPhysicalTransport P14FourierPhysicalFamily
open P14FourierCommonMomentTransport P14FourierOppositeOrthogonality
open P14FourierCrossSupport P14FourierOrthogonalityGraph P14SeedInterfaceDim
open scoped BigOperators

theorem exists_rows (k n d : ℕ) (hn : 0 < n) (he : Even n)
    (hdim : d + (2 * k + 4) = n) :
    ∃ x : Fin n ⊕ Fin n → Fin (2 * k + 4) → ℂ,
      (∀ i, x i ≠ 0) ∧
      (∀ i j, (graph hn he d).Adj i j → (∑ a, star (x i a) * x j a) = 0) ∧
      (∀ A : Finset (Fin n ⊕ Fin n), A.card = 2 * k + 4 + 1 →
        span ℂ (Set.range (fun a : A => x a.val)) = ⊤) := by
  obtain ⟨H, hpos, hFirst, hSecond, hnz, hspan⟩ := exists_physical_spanning k n d hn hdim
  have hF : commonFirstMoment d H = 0 := hFirst
  have hS : commonSecondMoment n d H = 0 := hSecond
  refine ⟨physicalFamily d H, hnz, ?_, hspan⟩
  intro i j hij
  change pair (physicalFamily d H i) (physicalFamily d H j) = 0
  rcases i with a | a <;> rcases j with b | b
  · exact a_opposite_orthogonal hn he d H (fun j => (hpos j).le) hF a b
      ((adj_inl_inl hn he d a b).mp hij)
  · exact (cross_pairing_eq_zero_iff hn hdim (by omega) H hpos a b).mpr
      ((adj_inl_inr hn he d a b).mp hij)
  · have hc := (cross_pairing_eq_zero_iff hn hdim (by omega) H hpos b a).mpr
      ((adj_inr_inl hn he d a b).mp hij)
    simpa only [pair, star_sum, star_mul, star_star, star_zero] using congrArg star hc
  · exact b_opposite_orthogonal hn he d H (fun j => (hpos j).le) hS a b
      ((adj_inr_inr hn he d a b).mp hij)

end P14EvenFourierExceptional

end
end

section

/-! The ordinary partition and the Fourier exceptional graph use the same
explicit two-layer labels. Their edges cover every distinct row pair. -/

noncomputable section
namespace P14EvenFourierCover
open P14ConcreteEvenPartition P14TwoLayerBiclique P14LayerBlockBiclique
open P14FourierOrthogonalityGraph P14CyclicArc

def rowIndex (h : ℕ) (i : Fin (4 * h)) : Fin (2 * h) :=
  ⟨index (2 * h) i.val, index_lt _ _ (by have hi := i.isLt; omega)⟩

def label (h : ℕ) (i : Fin (4 * h)) : Fin (2 * h) ⊕ Fin (2 * h) := by
  classical
  exact if Side (2 * h) i.val then .inl (rowIndex h i) else .inr (rowIndex h i)

theorem label_index (h : ℕ) (i : Fin (4 * h)) :
    Sum.elim Fin.val Fin.val (label h i) = index (2 * h) i.val := by
  unfold label
  split_ifs <;> rfl

theorem label_injective (h : ℕ) : Function.Injective (label h) := by
  intro i j he
  have hc : Side (2 * h) i.val ↔ Side (2 * h) j.val := by
    by_cases hi : Side (2 * h) i.val <;> by_cases hj : Side (2 * h) j.val
    · simp [hi, hj]
    · simp [label, hi, hj] at he
    · simp [label, hi, hj] at he
    · simp [hi, hj]
  have hv : index (2 * h) i.val = index (2 * h) j.val := by
    rw [← label_index h i, ← label_index h j, he]
  apply Fin.ext
  exact index_injective _ _ _ (by have hi := i.isLt; omega)
    (by have hj := j.isLt; omega) hc hv

theorem antipode_mod (h a : ℕ) (ha : a < 2 * h) :
    P14AntipodalRoundLabels.antipode h a = (a + (2 * h) / 2) % (2 * h) := by
  have he : (2 * h) / 2 = h := by omega
  rw [he]
  unfold P14AntipodalRoundLabels.antipode
  split_ifs with hl
  · rw [Nat.mod_eq_of_lt (by omega)]
  · rw [Nat.mod_eq_sub_mod (by omega), Nat.mod_eq_of_lt (by omega)]
    omega

open Fin.NatCast in
theorem cast_sub_val {q : ℕ} [NeZero q] (a b : Fin q) :
    (((a.val : ZMod q) - (b.val : ZMod q))).val = (a - b).val := by
  cases q with
  | zero => exact False.elim (NeZero.ne 0 rfl)
  | succ q =>
    change (((Nat.cast a.val : Fin (q + 1)) - (Nat.cast b.val : Fin (q + 1)))).val = (a - b).val
    simp only [Fin.cast_val_eq_self]

theorem outside_arc {q : ℕ} [NeZero q] (d : ℕ) (hd : d < q) (a b : Fin q) :
    (¬ ((a.val : ZMod q) - (b.val : ZMod q)) ∈ arc 0 (d + 1)) ↔ d < (a - b).val := by
  rw [mem_arc_iff 0 _ (d + 1) (by omega), sub_zero, cast_sub_val]
  omega

theorem within_adj (h d : ℕ) (hh : 0 < 2 * h) (i j : Fin (4 * h))
    (hc : Within (Side (2 * h)) i.val j.val)
    (he : index (2 * h) j.val = P14AntipodalRoundLabels.antipode h (index (2 * h) i.val)) :
    (graph hh ⟨h, by omega⟩ d).Adj (label h i) (label h j) := by
  have hv : (rowIndex h j).val = ((rowIndex h i).val + (2 * h) / 2) % (2 * h) :=
    he.trans (antipode_mod h _ (rowIndex h i).isLt)
  rcases hc with ⟨hi, hj⟩ | ⟨hi, hj⟩
  · simp only [label, if_pos hi, if_pos hj]
    exact (adj_inl_inl hh ⟨h, by omega⟩ d _ _).mpr hv
  · simp only [label, if_neg hi, if_neg hj]
    exact (adj_inr_inr hh ⟨h, by omega⟩ d _ _).mpr hv

theorem cross_adj (h d : ℕ) [NeZero (2 * h)] (hh : 0 < 2 * h) (hd : d < 2 * h)
    (i j : Fin (4 * h)) (hc : Across (Side (2 * h)) i.val j.val)
    (hn : ¬ CrossEdge (Side (2 * h)) (crossLabel (2 * h)) 0 (d + 1) i.val j.val) :
    (graph hh ⟨h, by omega⟩ d).Adj (label h i) (label h j) := by
  rcases hc with ⟨hi, hj⟩ | ⟨hi, hj⟩
  · have hnot : ¬ ((rowIndex h j).val : ZMod (2 * h)) -
        ((rowIndex h i).val : ZMod (2 * h)) ∈ arc 0 (d + 1) :=
      fun hm => hn (Or.inl ⟨hi, hj, hm⟩)
    simp only [label, if_pos hi, if_neg hj]
    exact (adj_inl_inr hh ⟨h, by omega⟩ d _ _).mpr
      ((outside_arc d hd (rowIndex h j) (rowIndex h i)).mp hnot)
  · have hnot : ¬ ((rowIndex h i).val : ZMod (2 * h)) -
        ((rowIndex h j).val : ZMod (2 * h)) ∈ arc 0 (d + 1) :=
      fun hm => hn (Or.inr ⟨hi, hj, hm⟩)
    simp only [label, if_neg hi, if_pos hj]
    exact (adj_inr_inl hh ⟨h, by omega⟩ d _ _).mpr
      ((outside_arc d hd (rowIndex h i) (rowIndex h j)).mp hnot)

theorem pair_cover (h d : ℕ) [NeZero (2 * h)] (hh : 0 < 2 * h) (hd : d < 2 * h)
    (i j : Fin (4 * h)) (hne : i ≠ j) :
    Available h 0 (d + 1) i.val j.val ∨
      (graph hh ⟨h, by omega⟩ d).Adj (label h i) (label h j) := by
  classical
  by_cases hav : Available h 0 (d + 1) i.val j.val
  · exact Or.inl hav
  apply Or.inr
  by_cases hc : Side (2 * h) i.val ↔ Side (2 * h) j.val
  · have hw : Within (Side (2 * h)) i.val j.val := by
      unfold Within
      tauto
    have hn : index (2 * h) i.val ≠ index (2 * h) j.val := by
      intro he
      apply hne
      apply Fin.ext
      exact index_injective _ _ _ (by have hi := i.isLt; omega)
        (by have hj := j.isLt; omega) hc he
    have he : index (2 * h) j.val = P14AntipodalRoundLabels.antipode h (index (2 * h) i.val) := by
      by_contra he
      exact hav (Or.inl ⟨hw, hn, he⟩)
    exact within_adj h d hh i j hw he
  · have ha : Across (Side (2 * h)) i.val j.val := by
      unfold Across
      tauto
    exact cross_adj h d hh hd i j ha (fun hcross => hav (Or.inr hcross))

end P14EvenFourierCover

end
end

section

/-! The exceptional Fourier vectors on the ordinary partition's row labels.
Every distinct pair is available to an ordinary factor or orthogonal here;
every (D+1)-element row set spans the actual D-dimensional complex space. -/

noncomputable section
namespace P14EvenExceptionalRows
open P14EvenFourierCover P14ConcreteEvenPartition
open Submodule
open scoped BigOperators

theorem exists_rows (h k : ℕ) (hdu : 2 * k + 4 ≤ 2 * h) :
    ∃ e : Fin (4 * h) → Fin (2 * k + 4) → ℂ,
      (∀ i, e i ≠ 0) ∧
      (∀ i j, i ≠ j →
        Available h 0 (2 * h - (2 * k + 4) + 1) i.val j.val ∨
          (∑ a, star (e i a) * e j a) = 0) ∧
      (∀ A : Finset (Fin (4 * h)), A.card = 2 * k + 4 + 1 →
        span ℂ (Set.range (fun a : A => e a.val)) = ⊤) := by
  classical
  have hh : 0 < 2 * h := by omega
  letI : NeZero (2 * h) := ⟨by omega⟩
  obtain ⟨x, hnz, horth, hspan⟩ :=
    P14EvenFourierExceptional.exists_rows k (2 * h) (2 * h - (2 * k + 4))
      hh ⟨h, by omega⟩ (by omega)
  refine ⟨fun i => x (label h i), fun i => hnz _, ?_, ?_⟩
  · intro i j hne
    rcases pair_cover h (2 * h - (2 * k + 4)) hh (by omega) i j hne with hav | he
    · exact Or.inl hav
    · exact Or.inr (horth _ _ he)
  · intro A hA
    let B := A.image (label h)
    have hB : B.card = 2 * k + 4 + 1 := by
      rw [Finset.card_image_of_injective _ (label_injective h)]
      exact hA
    apply P14TwoLayerSpanExtraction.of_included (fun i => x (label h i)) A
      (fun b : B => x b.val) (hspan B hB)
    intro b
    obtain ⟨a, ha, he⟩ := Finset.mem_image.mp b.property
    exact ⟨⟨a, ha⟩, congrArg x he⟩

end P14EvenExceptionalRows

end
end

section

/-! Actual UPBs with one even exceptional local dimension D>=4.
The remaining local deficits are positive, at most 2h-2, and sum to 4h-D-1.
All rows, orthogonality and the complex survivor are constructed. -/

noncomputable section
namespace P14EvenExceptionalUPB
open P14ConcreteEvenPartition P14BicliqueComplementConnection
open scoped BigOperators

def dimensions {n : ℕ} (k : ℕ) (R : Fin n → ℕ) : Fin (n + 1) → ℕ :=
  Fin.cases (2 * k + 4) (fun j => R j + 1)

def caps {n : ℕ} (k : ℕ) (R : Fin n → ℕ) : Fin (n + 1) → ℕ :=
  Fin.cases (2 * k + 4) R

def lengths {n : ℕ} (R : Fin n → ℕ) (i : ℕ) : ℕ :=
  if hi : i < n then R ⟨i, hi⟩ else 0

@[simp] theorem lengths_fin {n : ℕ} (R : Fin n → ℕ) (i : Fin n) :
    lengths R i.val = R i := by simp [lengths, i.isLt]

theorem lengths_sum {n : ℕ} (R : Fin n → ℕ) :
    (∑ i ∈ Finset.range n, lengths R i) = ∑ i, R i := by
  rw [← Fin.sum_univ_eq_sum_range]
  apply Finset.sum_congr rfl
  intro i _
  exact lengths_fin R i

theorem odd_entry {h k n : ℕ} (hdu : 2 * k + 4 ≤ 2 * h - 2) (R : Fin n → ℕ)
    (htotal : (∑ i, R i) = 4 * h - (2 * k + 4) - 1) : ∃ i, Odd (R i) := by
  classical
  by_contra ho
  push Not at ho
  have he : ∀ i, ∃ t, R i = t + t := fun i => Nat.not_odd_iff_even.mp (ho i)
  choose t ht using he
  have hs : (∑ i, R i) = (∑ i, t i) + ∑ i, t i := by
    simp_rw [ht]
    exact Finset.sum_add_distrib
  omega

theorem ceiling {h k n : ℕ} (hdu : 2 * k + 4 ≤ 2 * h - 2) (R : Fin n → ℕ)
    (htotal : (∑ i, R i) = 4 * h - (2 * k + 4) - 1) :
    2 + (∑ j, (dimensions k R j - 1)) = 4 * h := by
  simp [dimensions, Fin.sum_univ_succ, htotal]
  omega

theorem exists_upb {h k n : ℕ} (hh : 3 ≤ h) (hdu : 2 * k + 4 ≤ 2 * h - 2)
    (R : Fin n → ℕ) (hpos : ∀ i, 0 < R i) (hmax : ∀ i, R i ≤ 2 * h - 2)
    (htotal : (∑ i, R i) = 4 * h - (2 * k + 4) - 1) :
    ∃ v : Fin (4 * h) → (j : Fin (n + 1)) → Fin (dimensions k R j) → ℂ,
      (∀ i j, v i j ≠ 0) ∧
      (∀ i i', i ≠ i' → ∃ j, (∑ r, star (v i j r) * v i' j r) = 0) ∧
      (∀ a : (j : Fin (n + 1)) → Fin (dimensions k R j) → ℂ, (∀ j, a j ≠ 0) →
        ∃ i, ∀ j, (∑ r, star (v i j r) * a j r) ≠ 0) := by
  classical
  letI : NeZero (2 * h) := ⟨by omega⟩
  letI : NeZero (2 * h - 1) := ⟨by omega⟩
  have hlpos : ∀ i < n, 0 < lengths R i := by
    intro i hi
    simpa [lengths, hi] using hpos ⟨i, hi⟩
  have hlmax : ∀ i < n, lengths R i ≤ 2 * h - 2 := by
    intro i hi
    simpa [lengths, hi] using hmax ⟨i, hi⟩
  have hlo : ∃ i, i < n ∧ Odd (lengths R i) := by
    obtain ⟨i, hi⟩ := odd_entry hdu R htotal
    exact ⟨i.val, i.isLt, by simpa using hi⟩
  have hlsum : (∑ i ∈ Finset.range n, lengths R i) =
      (2 * h - 2) + (2 * h - (2 * k + 4) + 1) := by
    rw [lengths_sum, htotal]
    omega
  obtain ⟨H, hH, hcover, _⟩ := partition h (2 * k + 4) n hh (by omega) hdu
    (lengths R) hlpos hlmax hlo hlsum 0
  have hx : ∀ j : Fin n, ∃ x : Fin (4 * h) → Fin (R j + 1) → ℂ,
      (∀ i, x i ≠ 0) ∧
      (∀ (i i' : Fin (4 * h)), H j.val i.val i'.val →
        (∑ r, star (x i r) * x i' r) = 0) ∧
      (∀ A : Finset (Fin (4 * h)), A.card = R j + 1 →
        Submodule.span ℂ (Set.range (fun i : A => x i)) = ⊤) := by
    intro j
    have hj := hH j.val j.isLt
    apply P14GenericExceptionalUPB.complex_rows (H j.val) hj.1 hj.2.1
      (R j + 1) (4 * h) (by omega)
    simpa using hj.2.2
  choose x hnz horth hspan using hx
  obtain ⟨e, heNZ, heCover, heSpan⟩ := P14EvenExceptionalRows.exists_rows h k (by omega)
  let v : Fin (4 * h) → (j : Fin (n + 1)) → Fin (dimensions k R j) → ℂ :=
    fun i => Fin.cases (e i) (fun j => x j i)
  refine ⟨v, ?_, ?_, ?_⟩
  · intro i j
    refine Fin.cases ?_ (fun j => ?_) j
    · exact heNZ i
    · exact hnz j i
  · intro i i' hne
    rcases heCover i i' hne with hav | he
    · obtain ⟨j, hj, he⟩ := (hcover i.val i.isLt i'.val i'.isLt).mp hav
      exact ⟨(⟨j, hj⟩ : Fin n).succ, horth ⟨j, hj⟩ i i' he⟩
    · exact ⟨0, he⟩
  · apply P14ComplexKillingBudget.survivor (dimensions k R) (caps k R) v
    · simp [caps, Fin.sum_univ_succ, htotal]
      omega
    · intro j
      refine Fin.cases ?_ (fun j => ?_) j
      · intro a ha S hS
        exact P14ComplexKillingBudget.of_spanning e heSpan a ha S hS
      · intro a ha S hS
        exact P14ComplexKillingBudget.of_spanning (x j) (hspan j) a ha S hS

theorem canonical {h k n : ℕ} (hh : 3 ≤ h) (hdu : 2 * k + 4 ≤ 2 * h - 2)
    (R : Fin n → ℕ) (hpos : ∀ i, 0 < R i) (hmax : ∀ i, R i ≤ 2 * h - 2)
    (htotal : (∑ i, R i) = 4 * h - (2 * k + 4) - 1) :
    ∃ m : ℕ, m ≤ 2 + ∑ j, (dimensions k R j - 1) ∧
      ∃ v : Fin m → (j : Fin (n + 1)) → Fin (dimensions k R j) → ℂ,
        (∀ i j, v i j ≠ 0) ∧
        (∀ i i', i ≠ i' → ∃ j, (∑ r, star (v i j r) * v i' j r) = 0) ∧
        (∀ a : (j : Fin (n + 1)) → Fin (dimensions k R j) → ℂ, (∀ j, a j ≠ 0) →
          ∃ i, ∀ j, (∑ r, star (v i j r) * a j r) ≠ 0) :=
  ⟨4 * h, (ceiling hdu R htotal).ge, exists_upb hh hdu R hpos hmax htotal⟩

end P14EvenExceptionalUPB

end
end

section

/-! A factor-order-independent canonical region: at least one even local
dimension >=4, all dimensions between 2 and 2h-1, and total deficit 4h-2. -/

noncomputable section
namespace P14EvenExceptionalCanonicalRegion
open P14CanonicalUPBTransport
open scoped BigOperators

theorem canonical {p h : ℕ} (d : Fin p → ℕ) (hh : 3 ≤ h)
    (hd : ∀ j, 2 ≤ d j) (hmax : ∀ j, d j ≤ 2 * h - 1)
    (he : ∃ j, 4 ≤ d j ∧ Even (d j))
    (hsum : (∑ j, (d j - 1)) = 4 * h - 2) : Conclusion p d := by
  classical
  cases p with
  | zero =>
    obtain ⟨j, _⟩ := he
    exact Fin.elim0 j
  | succ n =>
    obtain ⟨t, ht4, htEven⟩ := he
    obtain ⟨a, ha⟩ := htEven
    let k := a - 2
    have ht : d t = 2 * k + 4 := by dsimp [k]; omega
    have hdu : 2 * k + 4 ≤ 2 * h - 2 := by
      have hm := hmax t
      omega
    let E : Fin (n + 1) ≃ Fin (n + 1) := Equiv.swap 0 t
    let R : Fin n → ℕ := fun j => d (E j.succ) - 1
    have hp : ∀ j, 0 < R j := by
      intro j
      have hj := hd (E j.succ)
      dsimp [R]
      omega
    have hm : ∀ j, R j ≤ 2 * h - 2 := by
      intro j
      have hj := hmax (E j.succ)
      dsimp [R]
      omega
    have hs : (∑ j, (d (E j) - 1)) = 4 * h - 2 :=
      (E.sum_comp (fun j => d j - 1)).trans hsum
    have hR : (∑ j, R j) = 4 * h - (2 * k + 4) - 1 := by
      rw [Fin.sum_univ_succ] at hs
      simp only [E, Equiv.swap_apply_left, ht] at hs
      change (2 * k + 4) - 1 + (∑ j, R j) = 4 * h - 2 at hs
      omega
    have hdim : P14EvenExceptionalUPB.dimensions k R = fun j => d (E j) := by
      funext j
      refine Fin.cases ?_ (fun j => ?_) j
      · simp [P14EvenExceptionalUPB.dimensions, E, ht]
      · change d (E j.succ) - 1 + 1 = d (E j.succ)
        have hj := hd (E j.succ)
        omega
    have hc : Conclusion (n + 1) (fun j => d (E j)) := by
      rw [← hdim]
      exact P14EvenExceptionalUPB.canonical hh hdu R hp hm hR
    have hf := reindex (fun j => d (E j)) E hc
    simpa only [E, Equiv.swap_apply_self] using hf

/-- A qubit-free mixed example: 4 x 4 x 5, with canonical ceiling twelve. -/
theorem four_four_five : Conclusion 3 ![4, 4, 5] := by
  apply canonical (h := 3)
  · omega
  · intro j
    fin_cases j <;> norm_num
  · intro j
    fin_cases j <;> norm_num
  · exact ⟨0, by norm_num, ⟨2, rfl⟩⟩
  · norm_num [Fin.sum_univ_succ]

end P14EvenExceptionalCanonicalRegion

end
end

section

/-! Complete below-half-order case when the requested row ceiling is
divisible by four and at least one local dimension is even. The eight-row
boundary and both exceptional-factor choices are now discharged. -/

namespace P14EvenHalfCanonicalRegion
open P14CanonicalUPBTransport
open scoped BigOperators

theorem canonical {p h : ℕ} (hp : 2 ≤ p) (d : Fin p → ℕ) (hh : 2 ≤ h)
    (hd : ∀ j, 2 ≤ d j) (hmax : ∀ j, d j ≤ 2 * h - 1)
    (he : ∃ j, Even (d j)) (hsum : (∑ j, (d j - 1)) = 4 * h - 2) :
    Conclusion p d := by
  classical
  by_cases hh3 : 3 ≤ h
  · by_cases hq : ∃ j, d j = 2
    · exact P14EvenQubitCanonicalRegion.canonical d hh3 hd hmax hq hsum
    · apply P14EvenExceptionalCanonicalRegion.canonical d hh3 hd hmax _ hsum
      obtain ⟨j, hj⟩ := he
      refine ⟨j, ?_, hj⟩
      have hdj := hd j
      have hn : d j ≠ 2 := fun hz => hq ⟨j, hz⟩
      obtain ⟨a, ha⟩ := hj
      omega
  · have hh2 : h = 2 := by omega
    subst h
    apply P14EightRowCanonicalRegion.canonical hp d hd (by simpa using hmax) _ (by simpa using hsum)
    obtain ⟨j, hj⟩ := he
    refine ⟨j, ?_⟩
    have hdj := hd j
    have hmj := hmax j
    obtain ⟨a, ha⟩ := hj
    omega

end P14EvenHalfCanonicalRegion

end

section

/-! An exhaustive obstruction for any unresolved corrected-domain tuple.
This is not a proof of the remaining cases: it records exactly which broad
cases still require a construction after the two checked global branches. -/

namespace P14CanonicalResidualScope
open P14CanonicalUPBTransport
open scoped BigOperators

theorem necessary_conditions {p : ℕ} (hp : 2 ≤ p) (d : Fin p → ℕ)
    (hd : ∀ j, 2 ≤ d j) (hbi : ¬ (p = 2 ∧ ∃ j, d j = 2))
    (hnot : ¬ Conclusion p d) :
    Even (∑ j, (d j - 1)) ∧
      ((∀ j, Odd (d j)) ∨ (2 + ∑ j, (d j - 1)) % 4 = 2 ∨
        ∃ j, (2 + ∑ i, (d i - 1)) / 2 ≤ d j) := by
  classical
  let S := ∑ j, (d j - 1)
  have heS : Even S := Nat.not_odd_iff_even.mp (fun ho =>
    hnot (P14OddDeficitCanonicalRegion.canonical hp d hd hbi ho))
  refine ⟨heS, ?_⟩
  by_cases he : ∃ j, Even (d j)
  · by_cases hm2 : (2 + S) % 4 = 2
    · exact Or.inr (Or.inl hm2)
    · by_cases hlarge : ∃ j, (2 + S) / 2 ≤ d j
      · exact Or.inr (Or.inr hlarge)
      · exfalso
        apply hnot
        let h := (2 + S) / 4
        have hm4 : 2 + S = 4 * h := by
          obtain ⟨k, hk⟩ := heS
          dsimp [h]
          omega
        have hsmall : ∀ j, d j < (2 + S) / 2 := by
          intro j
          by_contra hj
          exact hlarge ⟨j, by omega⟩
        have hmax : ∀ j, d j ≤ 2 * h - 1 := by
          intro j
          have hj := hsmall j
          omega
        have hh : 2 ≤ h := by
          let j : Fin p := ⟨0, by omega⟩
          have h1 := hd j
          have h2 := hmax j
          omega
        exact P14EvenHalfCanonicalRegion.canonical hp d hh hd hmax he (by
          change S = 4 * h - 2
          omega)
  · exact Or.inl (fun j => Nat.not_even_iff_odd.mp (fun hj => he ⟨j, hj⟩))

end P14CanonicalResidualScope

end

section

/-! Consecutive symmetric annuli partition all nonzero differences in an
odd cyclic group. Their checked biclique bounds provide an actual complete
graph cover for arbitrary positive even local deficits. -/

noncomputable section
namespace P14OddAnnulusGraphCover
open P14OddCyclicAnnulus P14BicliqueComplementConnection P14CyclicOffsetIntervalCover
open scoped BigOperators

def lengths {p : ℕ} (L : Fin p → ℕ) (i : ℕ) : ℕ :=
  if hi : i < p then L ⟨i, hi⟩ else 0

@[simp] theorem lengths_fin {p : ℕ} (L : Fin p → ℕ) (i : Fin p) :
    lengths L i.val = L i := by simp [lengths, i.isLt]

theorem lengths_sum {p : ℕ} (L : Fin p → ℕ) :
    prefixSum (lengths L) p = ∑ i, L i := by
  unfold prefixSum
  rw [← Fin.sum_univ_eq_sum_range]
  apply Finset.sum_congr rfl
  intro i _
  exact lengths_fin L i

def graph (q a l : ℕ) (i j : ℕ) : Prop :=
  (j : ZMod q) - (i : ZMod q) ∈ annulus a l

theorem cast_card {q : ℕ} [NeZero q] (A : Finset ℕ) (hA : A ⊆ Finset.range q) :
    (A.image (fun i : ℕ => (i : ZMod q))).card = A.card := by
  apply Finset.card_image_of_injOn
  intro i hi j hj he
  have hiq := Finset.mem_range.mp (hA hi)
  have hjq := Finset.mem_range.mp (hA hj)
  have hv := congrArg ZMod.val he
  simpa only [ZMod.val_natCast_of_lt hiq, ZMod.val_natCast_of_lt hjq] using hv

theorem graph_bound {q : ℕ} [NeZero q] (hq : Odd q) (a l : ℕ)
    (ha : 1 ≤ a) (hl : 1 ≤ l) (hlimit : 2 * (a + l) ≤ q + 1) :
    BicliqueBound (graph q a l) (Finset.range q) (2 * l + 1) := by
  intro A hAS B hBS hA hB _ hedge
  have hp : ∀ x ∈ A.image (fun i : ℕ => (i : ZMod q)),
      ∀ y ∈ B.image (fun i : ℕ => (i : ZMod q)), y - x ∈ annulus a l := by
    intro x hx y hy
    obtain ⟨i, hi, rfl⟩ := Finset.mem_image.mp hx
    obtain ⟨j, hj, rfl⟩ := Finset.mem_image.mp hy
    exact hedge i hi j hj
  have hb := biclique_bound hq a l ha hl hlimit
    (A.image (fun i : ℕ => (i : ZMod q))) (B.image (fun i : ℕ => (i : ZMod q)))
    (hA.image _) (hB.image _) hp
  rwa [cast_card A hAS, cast_card B hBS] at hb

theorem half_representative (k : ℕ) (z : ZMod (2 * k + 1)) (hz : z ≠ 0) :
    ∃ r : ℕ, 1 ≤ r ∧ r ≤ k ∧ (z = (r : ZMod (2 * k + 1)) ∨ z = -(r : ZMod (2 * k + 1))) := by
  letI : NeZero (2 * k + 1) := ⟨by omega⟩
  have hp : 0 < z.val := ZMod.val_pos.mpr hz
  have hq := ZMod.val_lt z
  by_cases hsmall : z.val ≤ k
  · exact ⟨z.val, by omega, hsmall, Or.inl (ZMod.natCast_zmod_val z).symm⟩
  · letI : NeZero z := ⟨hz⟩
    have hn : (-z).val = 2 * k + 1 - z.val := ZMod.val_neg_of_ne_zero z
    refine ⟨(-z).val, by omega, by omega, Or.inr ?_⟩
    rw [ZMod.natCast_zmod_val, neg_neg]

theorem exists_cover {p k : ℕ} (L : Fin p → ℕ) (hL : ∀ j, 1 ≤ L j)
    (htotal : (∑ j, L j) = k) :
    ∃ H : Fin p → ℕ → ℕ → Prop,
      (∀ j {i i'}, H j i i' → H j i' i) ∧
      (∀ j i, ¬ H j i i) ∧
      (∀ j, BicliqueBound (H j) (Finset.range (2 * k + 1)) (2 * L j + 1)) ∧
      (∀ i i' : Fin (2 * k + 1), i ≠ i' → ∃ j, H j i.val i'.val) := by
  classical
  letI : NeZero (2 * k + 1) := ⟨by omega⟩
  let a : Fin p → ℕ := fun j => 1 + prefixSum (lengths L) j.val
  have hend : ∀ j, a j + L j ≤ k + 1 := by
    intro j
    have h := P14CyclicArcPartition.prefix_end (lengths L) j.isLt
    rw [lengths_sum, htotal, lengths_fin] at h
    dsimp [a]
    omega
  let H : Fin p → ℕ → ℕ → Prop := fun j => graph (2 * k + 1) (a j) (L j)
  refine ⟨H, ?_, ?_, ?_, ?_⟩
  · intro j i i' he
    have hn := neg_mem (a j) (L j) he
    change (i : ZMod (2 * k + 1)) - (i' : ZMod (2 * k + 1)) ∈ annulus (a j) (L j)
    simpa only [neg_sub] using hn
  · intro j i he
    have hz := zero_not_mem (q := 2 * k + 1) (a j) (L j)
      (by dsimp [a]; omega) (hL j) (by have hj := hend j; omega)
    exact hz (by simpa only [H, graph, sub_self] using he)
  · intro j
    exact graph_bound ⟨k, by omega⟩ (a j) (L j)
      (by dsimp [a]; omega) (hL j) (by have hj := hend j; omega)
  · intro i i' hne
    let z : ZMod (2 * k + 1) := (i'.val : ZMod (2 * k + 1)) - i.val
    have hz : z ≠ 0 := by
      intro h
      have he := sub_eq_zero.mp h
      have hv := congrArg ZMod.val he
      rw [ZMod.val_natCast_of_lt i'.isLt, ZMod.val_natCast_of_lt i.isLt] at hv
      exact hne (Fin.ext hv.symm)
    obtain ⟨r, hr, hrk, he⟩ := half_representative k z hz
    have hp : r - 1 < prefixSum (lengths L) p := by rw [lengths_sum, htotal]; omega
    obtain ⟨j, t, ht⟩ := exists_prefix_block (lengths L) p (r - 1) hp
    have htl : t.val < L j := by simpa only [lengths_fin] using t.isLt
    refine ⟨j, (mem_iff (a j) (L j) z).mpr ⟨r, ?_, ?_, he⟩⟩
    · dsimp [a]
      omega
    · dsimp [a]
      omega

end P14OddAnnulusGraphCover

end
end

section

/-! The entire all-odd-local-dimension case. The annulus partition gives
actual ordinary orthogonality graphs, and the checked generic construction
produces the literal complex canonical UPB with S+1 rows. -/

noncomputable section
namespace P14AllOddCanonicalRegion
open P14CanonicalUPBTransport
open scoped BigOperators

theorem canonical {p : ℕ} (d : Fin p → ℕ) (hd : ∀ j, 2 ≤ d j)
    (ho : ∀ j, Odd (d j)) : Conclusion p d := by
  classical
  let L : Fin p → ℕ := fun j => (d j - 1) / 2
  let k := ∑ j, L j
  have hD : ∀ j, d j = 2 * L j + 1 := by
    intro j
    obtain ⟨r, hr⟩ := ho j
    dsimp [L]
    omega
  have hL : ∀ j, 1 ≤ L j := by
    intro j
    have h1 := hd j
    have h2 := hD j
    omega
  have hS : (∑ j, (d j - 1)) = 2 * k := by
    calc
      (∑ j, (d j - 1)) = ∑ j, 2 * L j := by
        apply Finset.sum_congr rfl
        intro j _
        rw [hD j]
        omega
      _ = 2 * ∑ j, L j := (Finset.mul_sum _ _ _).symm
      _ = 2 * k := rfl
  obtain ⟨H, hs, hi, hb, hc⟩ := P14OddAnnulusGraphCover.exists_cover L hL (show (∑ j, L j) = k from rfl)
  have hbound : ∀ j, P14BicliqueComplementConnection.BicliqueBound
      (H j) (Finset.range (2 * k + 1)) (d j) := by
    intro j
    rw [hD j]
    exact hb j
  have hv := P14GenericGraphUPB.coordinates d H (fun j => by have h := hd j; omega)
    hs hi hbound hc (by rw [hS]; omega)
  exact ⟨2 * k + 1, by rw [hS]; omega, hv⟩

theorem three_five_seven : Conclusion 3 ![3, 5, 7] :=
  canonical ![3, 5, 7] (by decide) (by decide)

end P14AllOddCanonicalRegion

end
end

section

/-! After all-odd dimensions are discharged, a failure in the corrected
domain requires even total deficit, an even local dimension, and either
odd half-order or a dimension at least as large as the half-order. -/

namespace P14CanonicalResidualEvenCases
open P14CanonicalUPBTransport
open scoped BigOperators

theorem necessary_conditions {p : ℕ} (hp : 2 ≤ p) (d : Fin p → ℕ)
    (hd : ∀ j, 2 ≤ d j) (hbi : ¬ (p = 2 ∧ ∃ j, d j = 2))
    (hnot : ¬ Conclusion p d) :
    Even (∑ j, (d j - 1)) ∧ (∃ j, Even (d j)) ∧
      ((2 + ∑ j, (d j - 1)) % 4 = 2 ∨ ∃ j, (2 + ∑ i, (d i - 1)) / 2 ≤ d j) := by
  classical
  have he : ∃ j, Even (d j) := by
    by_contra hn
    have ho : ∀ j, Odd (d j) := fun j =>
      Nat.not_even_iff_odd.mp (fun hj => hn ⟨j, hj⟩)
    exact hnot (P14AllOddCanonicalRegion.canonical d hd ho)
  obtain ⟨hS, hcases⟩ := P14CanonicalResidualScope.necessary_conditions hp d hd hbi hnot
  refine ⟨hS, he, ?_⟩
  rcases hcases with ho | hr
  · exact False.elim (hnot (P14AllOddCanonicalRegion.canonical d hd ho))
  · exact hr

end P14CanonicalResidualEvenCases

end

section

/-! Bounded unequal splits without an individual degree ceiling.
The exact room condition excludes the obstructing pair (2N-2,1).
One or two rounds can be moved out of a large factor; a third factor
absorbs the second round when the chosen odd factor is a qubit. -/

noncomputable section
namespace P14EvenDominantAllocation
open P14UnequalBlockAllocation
open scoped BigOperators

theorem spike_sum {ι : Type*} [DecidableEq ι] (S : Finset ι)
    (i : ι) (hi : i ∈ S) (a : ℕ) :
    (∑ k ∈ S, if k = i then a else 0) = a := by
  rw [Finset.sum_eq_single i]
  · simp
  · intro k hk hki
    simp [hki]
  · exact fun hn => False.elim (hn hi)

theorem two_spikes {ι : Type*} (S : Finset ι) (r : ι → ℕ) (N : ℕ)
    (hr : ∀ i ∈ S, 0 < r i) (i j : ι) (hi : i ∈ S) (hj : j ∈ S)
    (hji : j ≠ i) (a b : ℕ) (ha : Allowed (r i) a) (hb : Allowed (r j) b)
    (hac : a ≤ N - 1) (hbc : b ≤ N - 1) (hab : a + b = N) :
    ∃ x : ι → ℕ, (∀ k ∈ S, Allowed (r k) (x k) ∧ x k ≤ N - 1) ∧
      (∑ k ∈ S, x k) = N := by
  classical
  let x : ι → ℕ := fun k => (if k = i then a else 0) + (if k = j then b else 0)
  refine ⟨x, ?_, ?_⟩
  · intro k hk
    by_cases hki : k = i
    · subst k
      simpa [x, Ne.symm hji] using And.intro ha hac
    · by_cases hkj : k = j
      · subst k
        simpa [x, hji] using And.intro hb hbc
      · have hx : x k = 0 := by simp [x, hki, hkj]
        rw [hx]
        have hp := hr k hk
        constructor
        · constructor <;> omega
        · omega
  · simp only [x, Finset.sum_add_distrib]
    rw [spike_sum S i hi, spike_sum S j hj]
    exact hab

theorem three_spikes {ι : Type*} (S : Finset ι) (r : ι → ℕ) (N : ℕ)
    (hr : ∀ i ∈ S, 0 < r i) (i j k : ι)
    (hi : i ∈ S) (hj : j ∈ S) (hk : k ∈ S)
    (hji : j ≠ i) (hki : k ≠ i) (hkj : k ≠ j)
    (a b c : ℕ) (ha : Allowed (r i) a) (hb : Allowed (r j) b)
    (hc : Allowed (r k) c) (hac : a ≤ N - 1) (hbc : b ≤ N - 1)
    (hcc : c ≤ N - 1) (habc : a + b + c = N) :
    ∃ x : ι → ℕ, (∀ u ∈ S, Allowed (r u) (x u) ∧ x u ≤ N - 1) ∧
      (∑ u ∈ S, x u) = N := by
  classical
  let x : ι → ℕ := fun u => (if u = i then a else 0) +
    (if u = j then b else 0) + (if u = k then c else 0)
  refine ⟨x, ?_, ?_⟩
  · intro u hu
    by_cases hui : u = i
    · subst u
      simpa [x, Ne.symm hji, Ne.symm hki] using And.intro ha hac
    · by_cases huj : u = j
      · subst u
        simpa [x, hji, Ne.symm hkj] using And.intro hb hbc
      · by_cases huk : u = k
        · subst u
          simpa [x, hki, hkj] using And.intro hc hcc
        · have hx : x u = 0 := by simp [x, hui, huj, huk]
          rw [hx]
          have hp := hr u hu
          constructor
          · constructor <;> omega
          · omega
  · simp only [x, Finset.sum_add_distrib]
    rw [spike_sum S i hi, spike_sum S j hj, spike_sum S k hk]
    exact habc

theorem bounded {ι : Type*} [DecidableEq ι] (S : Finset ι) (r : ι → ℕ) (N : ℕ)
    (hN : Even N) (h4 : 4 ≤ N) (hsize : 2 ≤ S.card)
    (hr : ∀ i ∈ S, 0 < r i) (ho : ∃ i ∈ S, Odd (r i))
    (ht : N ≤ ∑ i ∈ S, r i)
    (hroom : ∀ i ∈ S, r i = 2 * N - 2 → 2 ≤ ∑ j ∈ S.erase i, r j) :
    ∃ x : ι → ℕ, (∀ i ∈ S, Allowed (r i) (x i) ∧ x i ≤ N - 1) ∧
      (∑ i ∈ S, x i) = N := by
  classical
  by_cases hu : ∀ i ∈ S, r i ≤ N
  · exact P14EvenLayerAllocation.bounded S r N hN h4 hr hu ho ht
  · simp only [not_forall, Classical.not_imp] at hu
    obtain ⟨i, hi, hlarge⟩ := hu
    by_cases hoi : Odd (r i)
    · have hnon : (S.erase i).Nonempty := by
        apply Finset.card_pos.mp
        rw [Finset.card_erase_of_mem hi]
        omega
      obtain ⟨j, hj'⟩ := hnon
      have hji := (Finset.mem_erase.mp hj').1
      have hj := Finset.mem_of_mem_erase hj'
      have hrj := hr j hj
      by_cases hj2 : r j = 2
      · apply two_spikes S r N hr i j hi hj hji (N - 2) 2
        · exact allowed_of_odd hoi (by omega)
        · constructor <;> omega
        · omega
        · omega
        · omega
      · apply two_spikes S r N hr i j hi hj hji (N - 1) 1
        · exact allowed_of_odd hoi (by omega)
        · constructor <;> omega
        · omega
        · omega
        · omega
    · obtain ⟨j, hj, hoj⟩ := ho
      have hji : j ≠ i := by intro he; exact hoi (he ▸ hoj)
      have hrj := hr j hj
      by_cases hmid : r i = 2 * N - 2
      · by_cases hj3 : 3 ≤ r j
        · apply two_spikes S r N hr i j hi hj hji (N - 2) 2
          · constructor <;> omega
          · exact allowed_of_odd hoj (by omega)
          · omega
          · omega
          · omega
        · have hj1 : r j = 1 := by obtain ⟨v, hv⟩ := hoj; omega
          have hj' : j ∈ S.erase i := Finset.mem_erase.mpr ⟨hji, hj⟩
          have hsum := Finset.sum_erase_add (S.erase i) r hj'
          have htwo := hroom i hi hmid
          have hnon : ((S.erase i).erase j).Nonempty := by
            by_contra hn
            have he : (S.erase i).erase j = ∅ := Finset.not_nonempty_iff_eq_empty.mp hn
            rw [he, Finset.sum_empty] at hsum
            omega
          obtain ⟨k, hk'⟩ := hnon
          have hkj := (Finset.mem_erase.mp hk').1
          have hki := (Finset.mem_erase.mp (Finset.mem_of_mem_erase hk')).1
          have hk : k ∈ S := Finset.mem_of_mem_erase (Finset.mem_of_mem_erase hk')
          have hrk := hr k hk
          by_cases hk2 : r k = 2
          · apply two_spikes S r N hr i k hi hk hki (N - 2) 2
            · constructor <;> omega
            · constructor <;> omega
            · omega
            · omega
            · omega
          · apply three_spikes S r N hr i j k hi hj hk hji hki hkj (N - 2) 1 1
            · constructor <;> omega
            · exact allowed_of_odd hoj (by omega)
            · constructor <;> omega
            · omega
            · omega
            · omega
            · omega
      · apply two_spikes S r N hr i j hi hj hji (N - 1) 1
        · constructor <;> omega
        · exact allowed_of_odd hoj hrj
        · omega
        · omega
        · omega

theorem split_allocation {ι : Type*} [DecidableEq ι] (S : Finset ι) (r : ι → ℕ) (N : ℕ)
    (hN : Even N) (h4 : 4 ≤ N) (hsize : 2 ≤ S.card)
    (hr : ∀ i ∈ S, 0 < r i) (ho : ∃ i ∈ S, Odd (r i))
    (ht : N ≤ ∑ i ∈ S, r i)
    (hroom : ∀ i ∈ S, r i = 2 * N - 2 → 2 ≤ ∑ j ∈ S.erase i, r j) :
    ∃ s t : ι → ℕ,
      (∀ i ∈ S, s i + t i = r i ∧ s i ≠ t i ∧ s i ≤ N - 1) ∧
      (∑ i ∈ S, s i) = N ∧ (∑ i ∈ S, t i) = (∑ i ∈ S, r i) - N := by
  obtain ⟨s, hs, hsum⟩ := bounded S r N hN h4 hsize hr ho ht hroom
  have hparts : (∑ i ∈ S, s i) + (∑ i ∈ S, (r i - s i)) = ∑ i ∈ S, r i := by
    rw [← Finset.sum_add_distrib]
    apply Finset.sum_congr rfl
    intro i hi
    have h := (hs i hi).1.1
    omega
  refine ⟨s, fun i => r i - s i, ?_, hsum, ?_⟩
  · intro i hi
    dsimp only
    have h := hs i hi
    exact ⟨by have hle := h.1.1; omega, h.1.2, h.2⟩
  · dsimp only
    omega

theorem even_half_order {ι : Type*} (S : Finset ι) (r : ι → ℕ) (q d : ℕ)
    (hq : Even q) (hq6 : 6 ≤ q) (hd : 2 ≤ d) (hdq : d ≤ q - 2)
    (hsize : 2 ≤ S.card) (hr : ∀ i ∈ S, 0 < r i)
    (ho : ∃ i ∈ S, Odd (r i))
    (hsmall : d = 4 → ∀ i ∈ S, 2 ≤ r i)
    (ht : (∑ i ∈ S, r i) = (q - 2) + (q - d + 1)) :
    ∃ s t : ι → ℕ,
      (∀ i ∈ S, s i + t i = r i ∧ s i ≠ t i ∧ s i ≤ q - 3) ∧
      (∑ i ∈ S, s i) = q - 2 ∧ (∑ i ∈ S, t i) = q - d + 1 := by
  classical
  have hN : Even (q - 2) := by
    obtain ⟨k, hk⟩ := hq
    exact ⟨k - 1, by omega⟩
  have hroom : ∀ i ∈ S, r i = 2 * (q - 2) - 2 → 2 ≤ ∑ j ∈ S.erase i, r j := by
    intro i hi he
    have hs := Finset.sum_erase_add S r hi
    have hnon : (S.erase i).Nonempty := by
      apply Finset.card_pos.mp
      rw [Finset.card_erase_of_mem hi]
      omega
    obtain ⟨j, hj⟩ := hnon
    have hle : r j ≤ ∑ k ∈ S.erase i, r k :=
      Finset.single_le_sum (fun k _ => Nat.zero_le (r k)) hj
    have hp := hr j (Finset.mem_of_mem_erase hj)
    by_cases hsum : 2 ≤ ∑ k ∈ S.erase i, r k
    · exact hsum
    · have hd4 : d = 4 := by omega
      have hp2 := hsmall hd4 j (Finset.mem_of_mem_erase hj)
      omega
  obtain ⟨s, t, hst, hs, ht'⟩ := split_allocation S r (q - 2) hN (by omega)
    hsize hr ho (by omega) hroom
  refine ⟨s, t, ?_, hs, ?_⟩
  · intro i hi
    have h := hst i hi
    exact ⟨h.1, h.2.1, by have hb := h.2.2; omega⟩
  · omega

end P14EvenDominantAllocation

end
end

section

/-! Actual even-order graph blocks with no maximum ordinary dimension.
At least two ordinary factors are required, and an exceptional dimension
four uses nonqubit ordinary factors. Every edge and bound is constructed. -/

noncomputable section
namespace P14EvenDominantPartition
open P14LayerBlockBiclique P14BicliqueComplementConnection P14CyclicOffsetIntervalCover
open P14ConcreteEvenPartition
open scoped BigOperators

theorem abstract_partition (q d m : ℕ) [NeZero q] [NeZero (q - 1)]
    (hq : Even q) (hq6 : 6 ≤ q) (hd : 2 ≤ d) (hdq : d ≤ q - 2)
    (C : ℕ → Prop) (S : Finset ℕ)
    (f : ℕ → Option (ZMod (q - 1))) (g : ℕ → ZMod q)
    (hf : LayerInjective C S f) (hg : LayerInjective C S g)
    (R : ℕ → ℕ) (hR : ∀ i < m, 0 < R i) (hm : 2 ≤ m)
    (hsmall : d = 4 → ∀ i < m, 2 ≤ R i)
    (ho : ∃ i, i < m ∧ Odd (R i))
    (htotal : (∑ i ∈ Finset.range m, R i) = (q - 2) + (q - d + 1))
    (b : ZMod q) :
    ∃ H : ℕ → ℕ → ℕ → Prop,
      (∀ i < m, (∀ {x y}, H i x y → H i y x) ∧ (∀ x, ¬ H i x x) ∧
        BicliqueBound (H i) S (R i + 1)) ∧
      (∀ x y, Edge C f g (1 : ZMod (q - 1)) b (q - 2) (q - d + 1) x y ↔
        ∃ i, i < m ∧ H i x y) ∧
      (∀ i < m, ∀ j < m, i ≠ j → ∀ x y, H i x y → H j x y → False) := by
  obtain ⟨s, t, hst, hs, ht⟩ := P14EvenDominantAllocation.even_half_order
    (Finset.range m) R q d hq hq6 hd hdq (by simpa using hm)
    (fun i hi => hR i (Finset.mem_range.mp hi))
    (by obtain ⟨i, hi, hoi⟩ := ho; exact ⟨i, Finset.mem_range.mpr hi, hoi⟩)
    (fun he i hi => hsmall he i (Finset.mem_range.mp hi)) htotal
  change prefixSum s m = q - 2 at hs
  change prefixSum t m = q - d + 1 at ht
  have hodd : Odd (q - 1) := by
    obtain ⟨k, hk⟩ := hq
    exact ⟨k - 1, by omega⟩
  have hsb : ∀ i < m, s i + 2 ≤ q - 1 := by
    intro i hi
    have h := (hst i (Finset.mem_range.mpr hi)).2.2
    omega
  have htb : ∀ i < m, t i < q := by
    intro i hi
    have h := P14CyclicArcPartition.prefix_end t hi
    rw [ht] at h
    omega
  obtain ⟨H, hH, hcover, hdis⟩ := P14LayerBlockPartition.partition C S f g hf hg hodd s t m 1 b
    hsb htb (fun i hi => (hst i (Finset.mem_range.mpr hi)).2.1)
    (by rw [hs]; omega) (by rw [ht]; omega)
  refine ⟨H, ?_, ?_, hdis⟩
  · intro i hi
    have h := hH i hi
    have he := (hst i (Finset.mem_range.mpr hi)).1
    refine ⟨h.1, h.2.1, ?_⟩
    have hb := h.2.2
    rwa [he] at hb
  · rwa [hs, ht] at hcover


theorem concrete (h d m : ℕ) [NeZero (2 * h)] [NeZero (2 * h - 1)]
    (hh : 3 ≤ h) (hd : 2 ≤ d) (hdu : d ≤ 2 * h - 2)
    (R : ℕ → ℕ) (hR : ∀ i < m, 0 < R i) (hm : 2 ≤ m)
    (hsmall : d = 4 → ∀ i < m, 2 ≤ R i)
    (ho : ∃ i, i < m ∧ Odd (R i))
    (htotal : (∑ i ∈ Finset.range m, R i) = (2 * h - 2) + (2 * h - d + 1))
    (b : ZMod (2 * h)) :
    ∃ H : ℕ → ℕ → ℕ → Prop,
      (∀ i < m, (∀ {x y}, H i x y → H i y x) ∧ (∀ x, ¬ H i x x) ∧
        BicliqueBound (H i) (Finset.range (4 * h)) (R i + 1)) ∧
      (∀ x < 4 * h, ∀ y < 4 * h, Available h b (2 * h - d + 1) x y ↔
        ∃ i, i < m ∧ H i x y) ∧
      (∀ i < m, ∀ j < m, i ≠ j → ∀ x y, H i x y → H j x y → False) := by
  have hlabels := labels_injective h (by omega)
  obtain ⟨H, hH, hcover, hdis⟩ := abstract_partition (2 * h) d m
    ⟨h, by omega⟩ (by omega) hd hdu (Side (2 * h)) (Finset.range (4 * h))
    (roundLabel h) (crossLabel (2 * h)) hlabels.1 hlabels.2 R hR hm hsmall ho htotal b
  refine ⟨H, hH, ?_, hdis⟩
  intro x hx y hy
  exact (available_iff h (by omega) b (2 * h - d + 1) x y hx hy).symm.trans (hcover x y)

end P14EvenDominantPartition

end
end

section

/-! Actual complex UPBs with no maximum ordinary dimension.
At least two ordinary factors are required. The exceptional factor and
all ordinary rows, pair coverage and survivor are proved. -/

noncomputable section
namespace P14EvenDominantQubitUPB
open P14ConcreteEvenPartition P14BicliqueComplementConnection
open P14EvenQubitUPB P14EvenQubitLabels P14EvenQubitCover
open scoped BigOperators

theorem exists_upb {h n : ℕ} (hh : 3 ≤ h) (R : Fin n → ℕ)
    (hpos : ∀ i, 0 < R i) (hn : 2 ≤ n)
    (htotal : (∑ i, R i) = 4 * h - 3) :
    ∃ v : Fin (4 * h) → (j : Fin (n + 1)) → Fin (dimensions R j) → ℂ,
      (∀ i j, v i j ≠ 0) ∧
      (∀ i i', i ≠ i' → ∃ j, (∑ r, star (v i j r) * v i' j r) = 0) ∧
      (∀ a : (j : Fin (n + 1)) → Fin (dimensions R j) → ℂ, (∀ j, a j ≠ 0) →
        ∃ i, ∀ j, (∑ r, star (v i j r) * a j r) ≠ 0) := by
  classical
  letI : NeZero (2 * h) := ⟨by omega⟩
  letI : NeZero (2 * h - 1) := ⟨by omega⟩
  have hlpos : ∀ i < n, 0 < lengths R i := by
    intro i hi
    simpa [lengths, hi] using hpos ⟨i, hi⟩
  have hlo : ∃ i, i < n ∧ Odd (lengths R i) := by
    obtain ⟨i, hi⟩ := odd_entry (by omega) R htotal
    exact ⟨i.val, i.isLt, by simpa using hi⟩
  have hlsum : (∑ i ∈ Finset.range n, lengths R i) =
      (2 * h - 2) + (2 * h - 2 + 1) := by
    rw [lengths_sum, htotal]
    omega
  obtain ⟨H, hH, hcover, _⟩ := P14EvenDominantPartition.concrete h 2 n hh (by omega) (by omega)
    (lengths R) hlpos hn (by intro he; omega) hlo hlsum 1
  have hx : ∀ j : Fin n, ∃ x : Fin (4 * h) → Fin (R j + 1) → ℂ,
      (∀ i, x i ≠ 0) ∧
      (∀ (i i' : Fin (4 * h)), H j.val i.val i'.val →
        (∑ r, star (x i r) * x i' r) = 0) ∧
      (∀ A : Finset (Fin (4 * h)), A.card = R j + 1 →
        Submodule.span ℂ (Set.range (fun i : A => x i)) = ⊤) := by
    intro j
    have hj := hH j.val j.isLt
    apply P14GenericExceptionalUPB.complex_rows (H j.val) hj.1 hj.2.1
      (R j + 1) (4 * h) (by omega)
    simpa using hj.2.2
  choose x hnz horth hspan using hx
  let v : Fin (4 * h) → (j : Fin (n + 1)) → Fin (dimensions R j) → ℂ :=
    fun i => Fin.cases (row h i) (fun j => x j i)
  refine ⟨v, ?_, ?_, ?_⟩
  · intro i j
    refine Fin.cases ?_ (fun j => ?_) j
    · exact row_ne_zero h i
    · exact hnz j i
  · intro i i' hne
    rcases pair_cover h i i' hne with hav | he
    · have hlen : 2 * h - 2 + 1 = 2 * h - 1 := by omega
      rw [← hlen] at hav
      obtain ⟨j, hj, he⟩ := (hcover i.val i.isLt i'.val i'.isLt).mp hav
      exact ⟨(⟨j, hj⟩ : Fin n).succ, horth ⟨j, hj⟩ i i' he⟩
    · exact ⟨0, he⟩
  · apply P14ComplexKillingBudget.survivor (dimensions R) (caps R) v
    · simp [caps, Fin.sum_univ_succ, htotal]
      omega
    · intro j
      refine Fin.cases ?_ (fun j => ?_) j
      · intro a ha S hS
        exact P14EvenQubitLabels.killing_bound h a ha S hS
      · intro a ha S hS
        exact P14ComplexKillingBudget.of_spanning (x j) (hspan j) a ha S hS

theorem canonical {h n : ℕ} (hh : 3 ≤ h) (R : Fin n → ℕ)
    (hpos : ∀ i, 0 < R i) (hn : 2 ≤ n)
    (htotal : (∑ i, R i) = 4 * h - 3) :
    ∃ m : ℕ, m ≤ 2 + ∑ j, (dimensions R j - 1) ∧
      ∃ v : Fin m → (j : Fin (n + 1)) → Fin (dimensions R j) → ℂ,
        (∀ i j, v i j ≠ 0) ∧
        (∀ i i', i ≠ i' → ∃ j, (∑ r, star (v i j r) * v i' j r) = 0) ∧
        (∀ a : (j : Fin (n + 1)) → Fin (dimensions R j) → ℂ, (∀ j, a j ≠ 0) →
          ∃ i, ∀ j, (∑ r, star (v i j r) * a j r) ≠ 0) :=
  ⟨4 * h, (ceiling (by omega) R htotal).ge, exists_upb hh R hpos hn htotal⟩

end P14EvenDominantQubitUPB

end
end

section

/-! Actual complex UPBs with no maximum ordinary dimension.
At least two ordinary factors are required. The exceptional factor and
all ordinary rows, pair coverage and survivor are proved. -/

noncomputable section
namespace P14EvenDominantExceptionalUPB
open P14ConcreteEvenPartition P14BicliqueComplementConnection
open P14EvenExceptionalUPB
open scoped BigOperators

theorem exists_upb {h k n : ℕ} (hh : 3 ≤ h) (hdu : 2 * k + 4 ≤ 2 * h - 2)
    (R : Fin n → ℕ) (hpos : ∀ i, 2 ≤ R i) (hn : 2 ≤ n)
    (htotal : (∑ i, R i) = 4 * h - (2 * k + 4) - 1) :
    ∃ v : Fin (4 * h) → (j : Fin (n + 1)) → Fin (dimensions k R j) → ℂ,
      (∀ i j, v i j ≠ 0) ∧
      (∀ i i', i ≠ i' → ∃ j, (∑ r, star (v i j r) * v i' j r) = 0) ∧
      (∀ a : (j : Fin (n + 1)) → Fin (dimensions k R j) → ℂ, (∀ j, a j ≠ 0) →
        ∃ i, ∀ j, (∑ r, star (v i j r) * a j r) ≠ 0) := by
  classical
  letI : NeZero (2 * h) := ⟨by omega⟩
  letI : NeZero (2 * h - 1) := ⟨by omega⟩
  have hlpos : ∀ i < n, 0 < lengths R i := by
    intro i hi
    have hp := hpos ⟨i, hi⟩
    simp only [lengths, dif_pos hi]
    omega
  have hlo : ∃ i, i < n ∧ Odd (lengths R i) := by
    obtain ⟨i, hi⟩ := odd_entry hdu R htotal
    exact ⟨i.val, i.isLt, by simpa using hi⟩
  have hlsum : (∑ i ∈ Finset.range n, lengths R i) =
      (2 * h - 2) + (2 * h - (2 * k + 4) + 1) := by
    rw [lengths_sum, htotal]
    omega
  obtain ⟨H, hH, hcover, _⟩ := P14EvenDominantPartition.concrete h (2 * k + 4) n hh (by omega) hdu
    (lengths R) hlpos hn
      (fun _ i hi => by simpa [lengths, hi] using hpos ⟨i, hi⟩) hlo hlsum 0
  have hx : ∀ j : Fin n, ∃ x : Fin (4 * h) → Fin (R j + 1) → ℂ,
      (∀ i, x i ≠ 0) ∧
      (∀ (i i' : Fin (4 * h)), H j.val i.val i'.val →
        (∑ r, star (x i r) * x i' r) = 0) ∧
      (∀ A : Finset (Fin (4 * h)), A.card = R j + 1 →
        Submodule.span ℂ (Set.range (fun i : A => x i)) = ⊤) := by
    intro j
    have hj := hH j.val j.isLt
    apply P14GenericExceptionalUPB.complex_rows (H j.val) hj.1 hj.2.1
      (R j + 1) (4 * h) (by omega)
    simpa using hj.2.2
  choose x hnz horth hspan using hx
  obtain ⟨e, heNZ, heCover, heSpan⟩ := P14EvenExceptionalRows.exists_rows h k (by omega)
  let v : Fin (4 * h) → (j : Fin (n + 1)) → Fin (dimensions k R j) → ℂ :=
    fun i => Fin.cases (e i) (fun j => x j i)
  refine ⟨v, ?_, ?_, ?_⟩
  · intro i j
    refine Fin.cases ?_ (fun j => ?_) j
    · exact heNZ i
    · exact hnz j i
  · intro i i' hne
    rcases heCover i i' hne with hav | he
    · obtain ⟨j, hj, he⟩ := (hcover i.val i.isLt i'.val i'.isLt).mp hav
      exact ⟨(⟨j, hj⟩ : Fin n).succ, horth ⟨j, hj⟩ i i' he⟩
    · exact ⟨0, he⟩
  · apply P14ComplexKillingBudget.survivor (dimensions k R) (caps k R) v
    · simp [caps, Fin.sum_univ_succ, htotal]
      omega
    · intro j
      refine Fin.cases ?_ (fun j => ?_) j
      · intro a ha S hS
        exact P14ComplexKillingBudget.of_spanning e heSpan a ha S hS
      · intro a ha S hS
        exact P14ComplexKillingBudget.of_spanning (x j) (hspan j) a ha S hS

theorem canonical {h k n : ℕ} (hh : 3 ≤ h) (hdu : 2 * k + 4 ≤ 2 * h - 2)
    (R : Fin n → ℕ) (hpos : ∀ i, 2 ≤ R i) (hn : 2 ≤ n)
    (htotal : (∑ i, R i) = 4 * h - (2 * k + 4) - 1) :
    ∃ m : ℕ, m ≤ 2 + ∑ j, (dimensions k R j - 1) ∧
      ∃ v : Fin m → (j : Fin (n + 1)) → Fin (dimensions k R j) → ℂ,
        (∀ i j, v i j ≠ 0) ∧
        (∀ i i', i ≠ i' → ∃ j, (∑ r, star (v i j r) * v i' j r) = 0) ∧
        (∀ a : (j : Fin (n + 1)) → Fin (dimensions k R j) → ℂ, (∀ j, a j ≠ 0) →
          ∃ i, ∀ j, (∑ r, star (v i j r) * a j r) ≠ 0) :=
  ⟨4 * h, (ceiling hdu R htotal).ge, exists_upb hh hdu R hpos hn htotal⟩

end P14EvenDominantExceptionalUPB

end
end

section

/-! The entire multipartite even-half-order canonical region, including
dominant dimensions. A small even factor exists by parity and the total
deficit. Qubits are selected first; all-odd dimensions use the earlier
stronger construction. No maximum local dimension remains. -/

noncomputable section
namespace P14EvenDominantCanonical
open P14CanonicalUPBTransport
open scoped BigOperators

theorem with_qubit {p h : ℕ} (d : Fin p → ℕ) (hcount : 3 ≤ p) (hh : 3 ≤ h)
    (hd : ∀ j, 2 ≤ d j)
    (hq : ∃ j, d j = 2) (hsum : (∑ j, (d j - 1)) = 4 * h - 2) :
    Conclusion p d := by
  classical
  cases p with
  | zero =>
    obtain ⟨j, _⟩ := hq
    exact Fin.elim0 j
  | succ n =>
    obtain ⟨t, ht⟩ := hq
    let E : Fin (n + 1) ≃ Fin (n + 1) := Equiv.swap 0 t
    let R : Fin n → ℕ := fun j => d (E j.succ) - 1
    have hp : ∀ j, 0 < R j := by
      intro j
      have hj := hd (E j.succ)
      dsimp [R]
      omega
    have hs : (∑ j, (d (E j) - 1)) = 4 * h - 2 :=
      (E.sum_comp (fun j => d j - 1)).trans hsum
    have hR : (∑ j, R j) = 4 * h - 3 := by
      rw [Fin.sum_univ_succ] at hs
      simp only [E, Equiv.swap_apply_left, ht] at hs
      change 2 - 1 + (∑ j, R j) = 4 * h - 2 at hs
      omega
    have hdim : P14EvenQubitUPB.dimensions R = fun j => d (E j) := by
      funext j
      refine Fin.cases ?_ (fun j => ?_) j
      · simp [P14EvenQubitUPB.dimensions, E, ht]
      · change d (E j.succ) - 1 + 1 = d (E j.succ)
        have hj := hd (E j.succ)
        omega
    have hc : Conclusion (n + 1) (fun j => d (E j)) := by
      rw [← hdim]
      exact P14EvenDominantQubitUPB.canonical hh R hp (by omega) hR
    have hf := reindex (fun j => d (E j)) E hc
    simpa only [E, Equiv.swap_apply_self] using hf

theorem with_small_even {p h : ℕ} (d : Fin p → ℕ) (hcount : 3 ≤ p) (hh : 3 ≤ h)
    (hd : ∀ j, 3 ≤ d j)
    (he : ∃ j, 4 ≤ d j ∧ Even (d j) ∧ d j ≤ 2 * h - 2)
    (hsum : (∑ j, (d j - 1)) = 4 * h - 2) : Conclusion p d := by
  classical
  cases p with
  | zero =>
    obtain ⟨j, _⟩ := he
    exact Fin.elim0 j
  | succ n =>
    obtain ⟨t, ht4, htEven, htBound⟩ := he
    obtain ⟨a, ha⟩ := htEven
    let k := a - 2
    have ht : d t = 2 * k + 4 := by dsimp [k]; omega
    have hdu : 2 * k + 4 ≤ 2 * h - 2 := by omega
    let E : Fin (n + 1) ≃ Fin (n + 1) := Equiv.swap 0 t
    let R : Fin n → ℕ := fun j => d (E j.succ) - 1
    have hp : ∀ j, 2 ≤ R j := by
      intro j
      have hj := hd (E j.succ)
      dsimp [R]
      omega
    have hs : (∑ j, (d (E j) - 1)) = 4 * h - 2 :=
      (E.sum_comp (fun j => d j - 1)).trans hsum
    have hR : (∑ j, R j) = 4 * h - (2 * k + 4) - 1 := by
      rw [Fin.sum_univ_succ] at hs
      simp only [E, Equiv.swap_apply_left, ht] at hs
      change (2 * k + 4) - 1 + (∑ j, R j) = 4 * h - 2 at hs
      omega
    have hdim : P14EvenExceptionalUPB.dimensions k R = fun j => d (E j) := by
      funext j
      refine Fin.cases ?_ (fun j => ?_) j
      · simp [P14EvenExceptionalUPB.dimensions, E, ht]
      · change d (E j.succ) - 1 + 1 = d (E j.succ)
        have hj := hd (E j.succ)
        omega
    have hc : Conclusion (n + 1) (fun j => d (E j)) := by
      rw [← hdim]
      exact P14EvenDominantExceptionalUPB.canonical hh hdu R hp (by omega) hR
    have hf := reindex (fun j => d (E j)) E hc
    simpa only [E, Equiv.swap_apply_self] using hf


theorem small_even {p h : ℕ} (d : Fin p → ℕ) (hp : 3 ≤ p) (hh : 3 ≤ h)
    (hd : ∀ j, 2 ≤ d j) (he : ∃ j, Even (d j))
    (hsum : (∑ j, (d j - 1)) = 4 * h - 2) :
    ∃ j, Even (d j) ∧ d j ≤ 2 * h - 2 := by
  classical
  obtain ⟨i, hei⟩ := he
  by_cases hi : d i ≤ 2 * h - 2
  · exact ⟨i, hei, hi⟩
  have hother : ∃ j, j ≠ i ∧ Even (d j) := by
    by_contra hn
    have hev : ∀ j ∈ (Finset.univ : Finset (Fin p)).erase i,
        d j - 1 = 2 * ((d j - 1) / 2) := by
      intro j hj
      have hji := (Finset.mem_erase.mp hj).1
      have ho : Odd (d j) := Nat.not_even_iff_odd.mp (fun he => hn ⟨j, hji, he⟩)
      obtain ⟨a, ha⟩ := ho
      omega
    have hs : (∑ j ∈ (Finset.univ : Finset (Fin p)).erase i, (d j - 1)) =
        2 * ∑ j ∈ (Finset.univ : Finset (Fin p)).erase i, ((d j - 1) / 2) := by
      rw [Finset.mul_sum]
      exact Finset.sum_congr rfl hev
    have ht := Finset.sum_erase_add (Finset.univ : Finset (Fin p))
      (fun j => d j - 1) (Finset.mem_univ i)
    have hdi := hd i
    obtain ⟨a, ha⟩ := hei
    omega
  obtain ⟨j, hji, hej⟩ := hother
  have hj : j ∈ (Finset.univ : Finset (Fin p)).erase i :=
    Finset.mem_erase.mpr ⟨hji, Finset.mem_univ j⟩
  have hnon : (((Finset.univ : Finset (Fin p)).erase i).erase j).Nonempty := by
    apply Finset.card_pos.mp
    rw [Finset.card_erase_of_mem hj, Finset.card_erase_of_mem (Finset.mem_univ i),
      Finset.card_univ, Fintype.card_fin]
    omega
  obtain ⟨k, hk⟩ := hnon
  have hle : d k - 1 ≤
      ∑ u ∈ (((Finset.univ : Finset (Fin p)).erase i).erase j), (d u - 1) :=
    Finset.single_le_sum (fun u _ => Nat.zero_le (d u - 1)) hk
  have hdi := hd i
  have hdj := hd j
  have hdk := hd k
  have hsi := Finset.sum_erase_add (Finset.univ : Finset (Fin p))
    (fun u => d u - 1) (Finset.mem_univ i)
  have hsj := Finset.sum_erase_add ((Finset.univ : Finset (Fin p)).erase i)
    (fun u => d u - 1) hj
  refine ⟨j, hej, ?_⟩
  obtain ⟨a, ha⟩ := hei
  obtain ⟨b, hb⟩ := hej
  omega

theorem multipartite {p h : ℕ} (d : Fin p → ℕ) (hp : 3 ≤ p) (hh : 3 ≤ h)
    (hd : ∀ j, 2 ≤ d j) (hsum : (∑ j, (d j - 1)) = 4 * h - 2) :
    Conclusion p d := by
  classical
  by_cases hq : ∃ j, d j = 2
  · exact with_qubit d hp hh hd hq hsum
  have hd3 : ∀ j, 3 ≤ d j := by
    intro j
    have hj := hd j
    have hn : d j ≠ 2 := fun he => hq ⟨j, he⟩
    omega
  by_cases he : ∃ j, Even (d j)
  · obtain ⟨j, hej, hmaxj⟩ := small_even d hp hh hd he hsum
    have hj4 : 4 ≤ d j := by
      have hj := hd3 j
      obtain ⟨a, ha⟩ := hej
      omega
    exact with_small_even d hp hh hd3 ⟨j, hj4, hej, hmaxj⟩ hsum
  · exact P14AllOddCanonicalRegion.canonical d hd
      (fun j => Nat.not_even_iff_odd.mp (fun hj => he ⟨j, hj⟩))

theorem two_four_seven : Conclusion 3 ![2, 4, 7] := by
  apply multipartite (h := 3)
  · omega
  · omega
  · intro j
    fin_cases j <;> norm_num
  · norm_num [Fin.sum_univ_succ]

theorem four_four_nine : Conclusion 3 ![4, 4, 9] := by
  apply multipartite (h := 4)
  · omega
  · omega
  · intro j
    fin_cases j <;> norm_num
  · norm_num [Fin.sum_univ_succ]

end P14EvenDominantCanonical

end
end

section

/-! Exact remaining necessary conditions after discharging the whole
multipartite even-half-order region above the small eight-row case.
This is a residual-scope theorem, not a proof of the full root. -/

namespace P14CanonicalResidualAfterDominance
open P14CanonicalUPBTransport
open scoped BigOperators

theorem necessary_conditions {p : ℕ} (hp : 2 ≤ p) (d : Fin p → ℕ)
    (hd : ∀ j, 2 ≤ d j) (hbi : ¬ (p = 2 ∧ ∃ j, d j = 2))
    (hnot : ¬ Conclusion p d) :
    Even (∑ j, (d j - 1)) ∧ (∃ j, Even (d j)) ∧
      (p = 2 ∨ (∑ j, (d j - 1)) = 6 ∨ (2 + ∑ j, (d j - 1)) % 4 = 2) := by
  classical
  obtain ⟨hS, he, _⟩ := P14CanonicalResidualEvenCases.necessary_conditions hp d hd hbi hnot
  refine ⟨hS, he, ?_⟩
  by_cases hp2 : p = 2
  · exact Or.inl hp2
  by_cases hs6 : (∑ j, (d j - 1)) = 6
  · exact Or.inr (Or.inl hs6)
  by_cases hmod : (2 + ∑ j, (d j - 1)) % 4 = 2
  · exact Or.inr (Or.inr hmod)
  have hge : p ≤ ∑ j, (d j - 1) := by
    calc
      p = ∑ _j : Fin p, (1 : ℕ) := by simp
      _ ≤ ∑ j, (d j - 1) := Finset.sum_le_sum (fun j _ => by have h := hd j; omega)
  let h := (2 + ∑ j, (d j - 1)) / 4
  have hh : 3 ≤ h := by
    obtain ⟨k, hk⟩ := hS
    dsimp only [h]
    omega
  have hsum : (∑ j, (d j - 1)) = 4 * h - 2 := by
    obtain ⟨k, hk⟩ := hS
    dsimp only [h]
    omega
  exact False.elim (hnot (P14EvenDominantCanonical.multipartite d (by omega) hh hd hsum))

end P14CanonicalResidualAfterDominance

end

section

/-! The eight-row complement splits into a cross two-round block and the
remaining cross two-round block together with the within-component matching.
Their biclique bounds are three and four, respectively. -/

noncomputable section
namespace P14EightRowDominantCover
open P14EightRowCover P14LayerBlockBiclique P14TwoLayerBiclique
open P14BicliqueComplementConnection P14CyclicArc
open scoped BigOperators

def Q (i j : ℕ) : Prop := CrossEdge C g 0 2 i j
def F (i j : ℕ) : Prop := M i j ∨ CrossEdge C g 2 2 i j

theorem matching_within {i j : ℕ} (h : M i j) : Within C i j := by
  rcases h with ⟨hi, hj, hne, he⟩
  have hc : C i ↔ C j := by
    unfold P14EvenQubitLabels.label at he
    unfold C
    split_ifs at he <;> simp_all <;> omega
  by_cases hci : C i
  · exact Or.inl ⟨hci, hc.mp hci⟩
  · exact Or.inr ⟨hci, fun hcj => hci (hc.mpr hcj)⟩

theorem q_symmetric {i j : ℕ} (h : Q i j) : Q j i :=
  cross_symmetric C g 0 2 h

theorem q_irreflexive (i : ℕ) : ¬ Q i i := by
  rintro (⟨hi, hni, _⟩ | ⟨hni, hi, _⟩) <;> exact hni hi

theorem f_symmetric {i j : ℕ} (h : F i j) : F j i := by
  rcases h with hm | hx
  · exact Or.inl (matching_symmetric hm)
  · exact Or.inr (cross_symmetric C g 2 2 hx)

theorem f_irreflexive (i : ℕ) : ¬ F i i := by
  rintro (hm | hx)
  · exact matching_irreflexive i hm
  · rcases hx with ⟨hi, hni, _⟩ | ⟨hni, hi, _⟩ <;> exact hni hi

theorem q_bound : BicliqueBound Q (Finset.range 8) 3 :=
  P14EightRowCover.cross_bound 0 2 (by omega)

theorem f_bound : BicliqueBound F (Finset.range 8) 4 := by
  apply P14TwoLayerBiclique.combine F C (Finset.range 8) 1 2 (by omega)
  · intro A hAS B hBS hA hB hdis hedge
    apply matching_bound A hAS B hBS hA hB hdis
    intro i hi j hj
    rcases hedge i hi j hj with ⟨hm | hx, hw⟩
    · exact hm
    · exact False.elim (within_not_across hw (cross_across hx))
  · intro A hAS B hBS hA hB hdis hedge
    apply P14EightRowCover.cross_bound 2 2 (by omega) A hAS B hBS hA hB hdis
    intro i hi j hj
    rcases hedge i hi j hj with ⟨hm | hx, ha⟩
    · exact False.elim (within_not_across (matching_within hm) ha)
    · exact hx

theorem pair_cover (i j : Fin 8) (hne : i ≠ j) :
    Q i.val j.val ∨ F i.val j.val ∨
      (∑ r, star (P14EvenQubitLabels.row 2 i r) * P14EvenQubitLabels.row 2 j r) = 0 := by
  rcases P14EightRowCover.pair_cover i j hne with hm | hx | he
  · exact Or.inr (Or.inl (Or.inl hm))
  · have split (z : ZMod 4) : z ∈ arc 0 2 ∨ z ∈ arc 2 2 := by
      by_cases hz : z.val < 2
      · exact Or.inl ((mem_arc_iff 0 z 2 (by omega)).mpr (by simpa using hz))
      · apply Or.inr
        rw [mem_arc_iff 2 z 2 (by omega)]
        have hle : (2 : ZMod 4).val ≤ z.val := by change 2 ≤ z.val; omega
        rw [ZMod.val_sub hle]
        have hzlt := ZMod.val_lt z
        change z.val - 2 < 2
        omega
    rcases hx with ⟨hi, hj, _⟩ | ⟨hi, hj, _⟩
    · rcases split (g j.val - g i.val) with hq | hf
      · exact Or.inl (Or.inl ⟨hi, hj, hq⟩)
      · exact Or.inr (Or.inl (Or.inr (Or.inl ⟨hi, hj, hf⟩)))
    · rcases split (g i.val - g j.val) with hq | hf
      · exact Or.inl (Or.inr ⟨hi, hj, hq⟩)
      · exact Or.inr (Or.inl (Or.inr (Or.inr ⟨hi, hj, hf⟩)))
  · exact Or.inr (Or.inr he)

end P14EightRowDominantCover

end
end

section

/-! Eight actual product rows for dimensions (2,3,4). The exceptional
qubit uses the existing explicit rays; both ordinary factors are constructed
from the checked finite graph bounds. -/

noncomputable section
namespace P14EightRowDominantUPB
open P14EightRowDominantCover P14CanonicalUPBTransport
open scoped BigOperators

theorem two_three_four : Conclusion 3 ![2, 3, 4] := by
  classical
  obtain ⟨x, hxNZ, hxOrth, hxSpan⟩ := P14GenericExceptionalUPB.complex_rows Q
    q_symmetric q_irreflexive 3 8 (by omega) q_bound
  obtain ⟨y, hyNZ, hyOrth, hySpan⟩ := P14GenericExceptionalUPB.complex_rows F
    f_symmetric f_irreflexive 4 8 (by omega) f_bound
  let d : Fin 3 → ℕ := ![2, 3, 4]
  let c : Fin 3 → ℕ := ![2, 2, 3]
  let v : Fin 8 → (j : Fin 3) → Fin (d j) → ℂ :=
    fun i => Fin.cases (P14EvenQubitLabels.row 2 i)
      (Fin.cases (x i) (Fin.cases (y i) (fun j => Fin.elim0 j)))
  refine ⟨8, by norm_num [Fin.sum_univ_succ], v, ?_, ?_, ?_⟩
  · intro i j
    fin_cases j
    · exact P14EvenQubitLabels.row_ne_zero 2 i
    · exact hxNZ i
    · exact hyNZ i
  · intro i i' hne
    rcases pair_cover i i' hne with hq | hf | he
    · exact ⟨1, hxOrth i i' hq⟩
    · exact ⟨2, hyOrth i i' hf⟩
    · exact ⟨0, he⟩
  · apply P14ComplexKillingBudget.survivor d c v
    · norm_num [c, Fin.sum_univ_succ]
    · intro j
      fin_cases j
      · intro a ha S hS
        exact P14EvenQubitLabels.killing_bound 2 a ha S hS
      · intro a ha S hS
        exact P14ComplexKillingBudget.of_spanning x hxSpan a ha S hS
      · intro a ha S hS
        exact P14ComplexKillingBudget.of_spanning y hySpan a ha S hS

theorem two_four_three : Conclusion 3 ![2, 4, 3] := by
  have h := reindex (![2, 3, 4] : Fin 3 → ℕ) (Equiv.swap 1 2) two_three_four
  have hd : (fun j => (![2, 3, 4] : Fin 3 → ℕ) (Equiv.swap 1 2 j)) = ![2, 4, 3] := by
    funext j
    fin_cases j <;> simp [Equiv.swap_apply_def]
  rwa [hd] at h

end P14EightRowDominantUPB

end
end

section

/-! Actual complex edge coordinates from the centered simplex. The one
orthonormal coordinate map is shared by all edges and all potential tests.
No graph, selected-span, or product-family existence is assumed here. -/

noncomputable section
namespace P14CenteredSimplexEdges
open Submodule
open scoped BigOperators

private abbrev Ambient (k : ℕ) := EuclideanSpace ℂ (Fin (k + 1))

private def ones (k : ℕ) : Ambient k := WithLp.toLp 2 (fun _ => 1)

private theorem ones_ne_zero (k : ℕ) : ones k ≠ 0 := by
  intro h
  have hi := congrArg (fun x : Ambient k => x 0) h
  simpa [ones] using hi

private abbrev centered (k : ℕ) : Submodule ℂ (Ambient k) := (ℂ ∙ ones k)ᗮ

private def coordinateIso (k : ℕ) :
    centered k ≃ₗᵢ[ℂ] EuclideanSpace ℂ (Fin k) := by
  letI : Fact (Module.finrank ℂ (Ambient k) = k + 1) :=
    ⟨finrank_euclideanSpace_fin⟩
  exact (OrthonormalBasis.fromOrthogonalSpanSingleton
    (𝕜 := ℂ) (E := Ambient k) k (ones_ne_zero k)).repr

private theorem inner_ones (k : ℕ) (w : Ambient k) :
    inner ℂ (ones k) w = ∑ i, w i := by
  simp [ones, PiLp.inner_apply, RCLike.inner_apply]

private theorem centered_sum {k : ℕ} (w : centered k) :
    (∑ i, (w : Ambient k) i) = 0 := by
  have h : inner ℂ (ones k) (w : Ambient k) = 0 :=
    Submodule.mem_orthogonal_singleton_iff_inner_right.mp w.property
  exact (inner_ones k w).symm.trans h

private def mean (k : ℕ) : ℂ := ((k + 1 : ℕ) : ℂ)⁻¹

private theorem cast_size_ne_zero (k : ℕ) : ((k + 1 : ℕ) : ℂ) ≠ 0 :=
  Nat.cast_ne_zero.mpr (Nat.succ_ne_zero k)

private def simplex (k : ℕ) (i : Fin (k + 1)) : centered k :=
  ⟨EuclideanSpace.single i 1 - mean k • ones k, by
    apply Submodule.mem_orthogonal_singleton_iff_inner_right.mpr
    have hnorm : inner ℂ (ones k) (ones k) = ((k + 1 : ℕ) : ℂ) := by
      rw [inner_ones]
      simp [ones]
    rw [inner_sub_right, inner_smul_right, EuclideanSpace.inner_single_right, hnorm]
    simp only [ones, PiLp.toLp_apply, map_one, one_mul]
    change 1 - mean k * ((k + 1 : ℕ) : ℂ) = 0
    rw [mean, inv_mul_cancel₀ (cast_size_ne_zero k), sub_self]⟩

private def vertex (k : ℕ) : Option (Fin (k + 1)) → centered k
  | none => 0
  | some i => simplex k i

private theorem simplex_apply (k : ℕ) (i j : Fin (k + 1)) :
    (simplex k i : Ambient k) j = (if j = i then 1 else 0) - mean k := by
  simp [simplex, ones, PiLp.single_apply]

private def potentialOf {k : ℕ} (w : centered k) : Option (Fin (k + 1)) → ℂ
  | none => 0
  | some i => (w : Ambient k) i

private theorem vertex_inner {k : ℕ} (a : Option (Fin (k + 1)))
    (w : centered k) : inner ℂ (vertex k a) w = potentialOf w a := by
  cases a with
  | none => simp [vertex, potentialOf]
  | some i =>
    change inner ℂ (EuclideanSpace.single i 1 - mean k • ones k)
      (w : Ambient k) = (w : Ambient k) i
    have h : inner ℂ (ones k) (w : Ambient k) = 0 :=
      Submodule.mem_orthogonal_singleton_iff_inner_right.mp w.property
    rw [inner_sub_left, inner_smul_left, EuclideanSpace.inner_single_left, h]
    simp

private theorem diagonal_ne_zero {k : ℕ} (hk : 1 ≤ k) : (1 : ℂ) - mean k ≠ 0 := by
  intro h
  have hm : mean k = 1 := (sub_eq_zero.mp h).symm
  have hs : ((k + 1 : ℕ) : ℂ) * mean k = 1 := by
    exact mul_inv_cancel₀ (cast_size_ne_zero k)
  rw [hm, mul_one] at hs
  have hn : k + 1 = 1 := Nat.cast_injective (by simpa only [Nat.cast_one] using hs)
  have hk0 : k = 0 := Nat.succ.inj hn
  subst k
  exact (Nat.not_succ_le_zero 0) hk

private theorem vertex_ne {k : ℕ} (hk : 1 ≤ k)
    (a b : Option (Fin (k + 1))) (hab : a ≠ b) : vertex k a ≠ vertex k b := by
  intro h
  cases a with
  | none =>
    cases b with
    | none => exact hab rfl
    | some j =>
      apply diagonal_ne_zero hk
      have hi := congrArg (fun w : centered k => (w : Ambient k) j) h
      simpa [vertex, simplex, ones] using hi.symm
  | some i =>
    cases b with
    | none =>
      apply diagonal_ne_zero hk
      have hi := congrArg (fun w : centered k => (w : Ambient k) i) h
      simpa [vertex, simplex, ones] using hi
    | some j =>
      have hij : i ≠ j := fun h => hab (congrArg Option.some h)
      have hi : (1 : ℂ) - mean k = 0 - mean k := by
        simpa [vertex, simplex, ones, PiLp.single_apply, hij] using
          congrArg (fun w : centered k => (w : Ambient k) i) h
      have hz : (1 : ℂ) = 0 := by
        simpa using congrArg (fun z : ℂ => z + mean k) hi
      exact one_ne_zero hz

/-- Coordinates of the oriented edge, using one fixed orthonormal isometry. -/
def edge (k : ℕ) (a b : Option (Fin (k + 1))) : Fin k → ℂ :=
  WithLp.ofLp (coordinateIso k (vertex k a - vertex k b))

private theorem pair_eq_inner {n : ℕ} (x : EuclideanSpace ℂ (Fin n))
    (y : Fin n → ℂ) :
    (∑ r, star (x r) * y r) = inner ℂ x (WithLp.toLp 2 y) := by
  simp only [PiLp.inner_apply, RCLike.inner_apply, PiLp.toLp_apply]
  apply Finset.sum_congr rfl
  intro r _
  exact mul_comm _ _

set_option backward.isDefEq.respectTransparency false in
private theorem edge_pair {k : ℕ} (a b : Option (Fin (k + 1)))
    (y : Fin k → ℂ) :
    (∑ r, star (edge k a b r) * y r) =
      inner ℂ (vertex k a - vertex k b)
        ((coordinateIso k).symm (WithLp.toLp 2 y)) := by
  change (∑ r, star ((coordinateIso k (vertex k a - vertex k b)) r) * y r) = _
  rw [pair_eq_inner]
  letI : InnerProductSpace ℂ (Ambient k) := PiLp.innerProductSpace (fun _ : Fin (k + 1) => ℂ)
  letI : InnerProductSpace ℂ (centered k) := Submodule.innerProductSpace (centered k)
  letI : InnerProductSpace ℂ (EuclideanSpace ℂ (Fin k)) :=
    PiLp.innerProductSpace (fun _ : Fin k => ℂ)
  exact LinearIsometryEquiv.inner_map_eq_flip (𝕜 := ℂ)
    (E := centered k) (E' := EuclideanSpace ℂ (Fin k)) (coordinateIso k) _ _

theorem edge_ne_zero {k : ℕ} (hk : 1 ≤ k)
    (a b : Option (Fin (k + 1))) (hab : a ≠ b) : edge k a b ≠ 0 := by
  intro h
  change WithLp.ofLp (coordinateIso k (vertex k a - vertex k b)) = 0 at h
  have hz := (coordinateIso k).map_eq_zero_iff.mp (by
    apply WithLp.ofLp_injective 2
    exact h)
  exact vertex_ne hk a b hab (sub_eq_zero.mp hz)

/-- Cross-disjoint endpoint sets give orthogonal actual coordinate rows. -/
theorem edge_pair_eq_zero {k : ℕ} (a b c d : Option (Fin (k + 1)))
    (hac : a ≠ c) (had : a ≠ d) (hbc : b ≠ c) (hbd : b ≠ d) :
    (∑ r, star (edge k a b r) * edge k c d r) = 0 := by
  rw [edge_pair]
  change inner ℂ (vertex k a - vertex k b)
    ((coordinateIso k).symm (coordinateIso k (vertex k c - vertex k d))) = 0
  rw [(coordinateIso k).symm_apply_apply, inner_sub_left,
    inner_sub_right, inner_sub_right]
  simp only [vertex_inner]
  cases a <;> cases b <;> cases c <;> cases d <;>
    simp_all [potentialOf, vertex, simplex, ones, PiLp.single_apply] <;> ring

/-- Every complex test has an actual zero-sum potential on the vertices.
The edge pairing is the oriented potential difference, with no regularity
or spanning assumption on the test. -/
theorem exists_potential {k : ℕ} (y : Fin k → ℂ) :
    ∃ f : Option (Fin (k + 1)) → ℂ,
      f none = 0 ∧ (∑ i, f (some i)) = 0 ∧ (y ≠ 0 → f ≠ 0) ∧
      ∀ a b, (∑ r, star (edge k a b r) * y r) = f a - f b := by
  let w : centered k := (coordinateIso k).symm (WithLp.toLp 2 y)
  refine ⟨potentialOf w, rfl, centered_sum w, ?_, ?_⟩
  · intro hy hf
    apply hy
    have hw : w = 0 := by
      apply Subtype.ext
      ext i
      change (w : Ambient k) i = 0
      exact congrFun hf (some i)
    have hmap := congrArg (coordinateIso k) hw
    have hz : WithLp.toLp 2 y = 0 := by
      simpa only [w, LinearIsometryEquiv.apply_symm_apply, map_zero] using hmap
    exact congrArg WithLp.ofLp hz
  · intro a b
    rw [edge_pair, inner_sub_left, vertex_inner, vertex_inner]

end P14CenteredSimplexEdges

end
end

section

/-! Potentials on a theta graph after deletion of one class from each of the
specified short-edge classings. Only finite equality propagation is used.
The two short paths are indexed by Bool; false is the root-side endpoint.
The long path has L edges and L+1 vertices. No geometry or sum constraint is
assumed, and the statement also makes sense for L=0. -/

namespace P14ThetaDeletionPotential

abbrev Edge (L : ℕ) := (Bool × Bool) ⊕ Fin L
abbrev Class (L : ℕ) := Bool ⊕ Fin L

def classA {L : ℕ} : Edge L → Class L
  | .inl (p, e) => .inl (Bool.xor p e)
  | .inr i => .inr i

def classB {L : ℕ} : Edge L → Class L
  | .inl (_, e) => .inl e
  | .inr i => .inr i

def leftValue {C : Type*} {L : ℕ} (s : Bool → C) (g : Fin (L+1) → C) :
    Edge L → C
  | .inl (p, e) => if e then s p else g 0
  | .inr i => g i.castSucc

def rightValue {C : Type*} {L : ℕ} (s : Bool → C) (g : Fin (L+1) → C) :
    Edge L → C
  | .inl (p, e) => if e then g (Fin.last L) else s p
  | .inr i => g i.succ

/-- Propagation through a specified unbroken interval of a finite path. -/
private theorem path_eq {C : Type*} {L : ℕ} (g : Fin (L+1) → C)
    (a b : Fin (L+1)) (hab : a.val ≤ b.val)
    (hstep : ∀ i : Fin L, a.val ≤ i.val → i.val < b.val →
      g i.castSucc = g i.succ) : g a = g b := by
  revert a
  induction b using Fin.induction with
  | zero =>
      intro a hab _
      have ha : a = 0 := Fin.ext (Nat.eq_zero_of_le_zero hab)
      exact congrArg g ha
  | succ b ih =>
      intro a hab hstep
      by_cases h : a = b.succ
      · exact congrArg g h
      have hne : a.val ≠ b.val + 1 := fun he => h (Fin.ext he)
      have hab' : a.val ≤ b.val := by
        change a.val ≤ b.val + 1 at hab
        omega
      have hleft : g a = g b.castSucc :=
        ih a hab' (fun i hi hj => hstep i hi (Nat.lt_succ_of_lt hj))
      exact hleft.trans (hstep b hab' (Nat.lt_succ_self _))

/-- With one cut, every path value equals one of the two endpoint values. -/
private theorem path_one_cut {C : Type*} {L : ℕ} (g : Fin (L+1) → C)
    (cut : Fin L)
    (hstep : ∀ i : Fin L, i ≠ cut → g i.castSucc = g i.succ)
    (i : Fin (L+1)) : g i = g 0 ∨ g i = g (Fin.last L) := by
  by_cases hi : i.val ≤ cut.val
  · left
    exact (path_eq g 0 i (Nat.zero_le _) (fun k _ hki =>
      hstep k (by intro h; subst k; omega))).symm
  · right
    apply path_eq g i (Fin.last L) (by have := i.isLt; change i.val ≤ L; omega)
    intro k hik _
    apply hstep k
    intro h
    subst k
    omega

/-- When the endpoints are zero, two cuts leave only one possible other value. -/
private theorem path_two_cuts {C : Type*} [Zero C] {L : ℕ}
    (g : Fin (L+1) → C) (lo hi : Fin L) (hle : lo.val ≤ hi.val)
    (hzero : g 0 = 0) (hlast : g (Fin.last L) = 0)
    (hstep : ∀ k : Fin L, k ≠ lo → k ≠ hi → g k.castSucc = g k.succ)
    (i : Fin (L+1)) : g i = 0 ∨ g i = g lo.succ := by
  by_cases hlo : i.val ≤ lo.val
  · left
    apply Eq.trans (b := g 0) _ hzero
    symm
    apply path_eq g 0 i (Nat.zero_le _)
    intro k _ hki
    apply hstep k
    · intro h; subst k; omega
    · intro h; subst k; omega
  · by_cases hhi : i.val ≤ hi.val
    · right
      symm
      apply path_eq g lo.succ i (by change lo.val + 1 ≤ i.val; omega)
      intro k hlk hki
      apply hstep k
      · intro h; subst k; change lo.val + 1 ≤ lo.val at hlk; omega
      · intro h; subst k; omega
    · left
      apply Eq.trans (b := g (Fin.last L)) _ hlast
      apply path_eq g i (Fin.last L) (by have := i.isLt; change i.val ≤ L; omega)
      intro k hik _
      apply hstep k
      · intro h; subst k; omega
      · intro h; subst k; omega

/-- The two deletion classes leave at most the root value and one other value.
The class labels, edge orientations and the same s,g are retained literally. -/
theorem two_values {C : Type*} [Zero C] {L : ℕ}
    (s : Bool → C) (g : Fin (L+1) → C)
    (deletedA deletedB : Class L) (hroot : g 0 = 0)
    (hretained : ∀ e : Edge L,
      classA e ≠ deletedA → classB e ≠ deletedB →
      leftValue s g e = rightValue s g e) :
    ∃ c : C, (∀ p, s p = 0 ∨ s p = c) ∧ ∀ i, g i = 0 ∨ g i = c := by
  cases deletedA with
  | inl a =>
      cases deletedB with
      | inl b =>
          have hg (i : Fin (L+1)) : g i = 0 := by
            apply Eq.trans (b := g 0) _ hroot
            symm
            apply path_eq g 0 i (Nat.zero_le _)
            intro k _ _
            exact hretained (.inr k) (by simp [classA]) (by simp [classB])
          let p : Bool := Bool.xor a b
          have ha : Bool.xor p (!b) ≠ a := by
            dsimp [p]
            cases a <;> cases b <;> decide
          have hb : (!b) ≠ b := by cases b <;> decide
          have hp : s p = 0 := by
            have h := hretained (.inl (p, !b))
              (by simpa only [classA, ne_eq, Sum.inl.injEq] using ha)
              (by simpa only [classB, ne_eq, Sum.inl.injEq] using hb)
            cases b with
            | false => simpa [leftValue, rightValue, hg] using h
            | true => simpa [leftValue, rightValue, hg] using h.symm
          refine ⟨s (!p), ?_, fun i => Or.inl (hg i)⟩
          intro q
          by_cases hq : q = p
          · exact Or.inl ((congrArg s hq).trans hp)
          · right
            have hqp : q = !p := Bool.eq_not_iff.mpr hq
            exact congrArg s hqp
      | inr cut =>
          have hlong (k : Fin L) (hk : k ≠ cut) : g k.castSucc = g k.succ :=
            hretained (.inr k) (by simp [classA])
              (by simpa only [classB, ne_eq, Sum.inr.injEq] using hk)
          refine ⟨g (Fin.last L), ?_, ?_⟩
          · intro p
            by_cases hp : Bool.xor p false = a
            · have ha : Bool.xor p true ≠ a := by
                cases p <;> cases a <;> cases hp <;> decide
              right
              exact hretained (.inl (p, true))
                (by simpa only [classA, ne_eq, Sum.inl.injEq] using ha)
                (by simp [classB])
            · left
              have h := hretained (.inl (p, false))
                (by simpa only [classA, ne_eq, Sum.inl.injEq] using hp)
                (by simp [classB])
              exact h.symm.trans hroot
          · intro i
            rcases path_one_cut g cut hlong i with h | h
            · exact Or.inl (h.trans hroot)
            · exact Or.inr h
  | inr cutA =>
      cases deletedB with
      | inl b =>
          have hlong (k : Fin L) (hk : k ≠ cutA) : g k.castSucc = g k.succ :=
            hretained (.inr k)
              (by simpa only [classA, ne_eq, Sum.inr.injEq] using hk)
              (by simp [classB])
          refine ⟨g (Fin.last L), ?_, ?_⟩
          · intro p
            cases b with
            | false =>
                right
                exact hretained (.inl (p, true)) (by simp [classA]) (by simp [classB])
            | true =>
                left
                have h := hretained (.inl (p, false))
                  (by simp [classA]) (by simp [classB])
                exact h.symm.trans hroot
          · intro i
            rcases path_one_cut g cutA hlong i with h | h
            · exact Or.inl (h.trans hroot)
            · exact Or.inr h
      | inr cutB =>
          have hs (p : Bool) : s p = 0 := by
            have h := hretained (.inl (p, false))
              (by simp [classA]) (by simp [classB])
            exact h.symm.trans hroot
          have hlast : g (Fin.last L) = 0 := by
            have h := hretained (.inl (false, true))
              (by simp [classA]) (by simp [classB])
            exact h.symm.trans (hs false)
          have hlong (k : Fin L) (ha : k ≠ cutA) (hb : k ≠ cutB) :
              g k.castSucc = g k.succ :=
            hretained (.inr k)
              (by simpa only [classA, ne_eq, Sum.inr.injEq] using ha)
              (by simpa only [classB, ne_eq, Sum.inr.injEq] using hb)
          rcases Nat.le_total cutA.val cutB.val with h | h
          · exact ⟨g cutA.succ, fun p => Or.inl (hs p),
              path_two_cuts g cutA cutB h hroot hlast hlong⟩
          · exact ⟨g cutB.succ, fun p => Or.inl (hs p),
              path_two_cuts g cutB cutA h hroot hlast (fun k hb ha => hlong k ha hb)⟩

end P14ThetaDeletionPotential

end

section

/-! The zero-sum condition removes the one remaining potential value after
the actual theta class deletions. This is over the complex field, including
tests with non-real coordinates; no positivity of the potential is used. -/

namespace P14ThetaZeroSumPotential
open P14ThetaDeletionPotential
open scoped BigOperators

theorem zero_of_two_values {ι : Type*} [Fintype ι] (f : ι → ℂ) (c : ℂ)
    (hvalues : ∀ i, f i = 0 ∨ f i = c) (hsum : (∑ i, f i) = 0) : f = 0 := by
  classical
  let S : Finset ι := Finset.univ.filter (fun i => f i ≠ 0)
  have hcount : (∑ i, f i) = (S.card : ℂ) * c := by
    calc
      _ = ∑ i ∈ S, c := by
        dsimp only [S]
        rw [Finset.sum_filter]
        apply Finset.sum_congr rfl
        intro i _
        by_cases hi : f i = 0
        · simp [hi]
        · rw [if_pos hi]
          exact (hvalues i).resolve_left hi
      _ = _ := by simp
  funext i
  by_contra hi
  have hi' : f i ≠ 0 := hi
  have hmem : i ∈ S := Finset.mem_filter.mpr ⟨Finset.mem_univ i, hi'⟩
  have hpos : 0 < S.card := Finset.card_pos.mpr ⟨i, hmem⟩
  have hcast : (S.card : ℂ) ≠ 0 := Nat.cast_ne_zero.mpr (Nat.ne_of_gt hpos)
  have hc : c = 0 := (mul_eq_zero.mp (hcount.symm.trans hsum)).resolve_left hcast
  exact hi' (((hvalues i).resolve_left hi').trans hc)

/-- The same s and g that are constant on every retained oriented edge must
vanish if their total coordinate sum is zero. -/
theorem vanish {L : ℕ} (s : Bool → ℂ) (g : Fin (L + 1) → ℂ)
    (deletedA deletedB : Class L) (hroot : g 0 = 0)
    (hsum : (∑ p, s p) + (∑ i, g i) = 0)
    (hretained : ∀ e : Edge L,
      classA e ≠ deletedA → classB e ≠ deletedB →
      leftValue s g e = rightValue s g e) : s = 0 ∧ g = 0 := by
  obtain ⟨c, hs, hg⟩ := two_values s g deletedA deletedB hroot hretained
  let f : Bool ⊕ Fin (L + 1) → ℂ := Sum.elim s g
  have hv : ∀ i, f i = 0 ∨ f i = c := by
    rintro (p | i)
    · exact hs p
    · exact hg i
  have hfSum : (∑ i, f i) = 0 := by
    simpa only [f, Fintype.sum_sum_type, Sum.elim_inl, Sum.elim_inr] using hsum
  have hf := zero_of_two_values f c hv hfSum
  constructor
  · funext p
    exact congrFun hf (Sum.inl p)
  · funext i
    exact congrFun hf (Sum.inr i)

end P14ThetaZeroSumPotential

end

section

/-! The actual centered-simplex edge family on the theta labels. Deleting
one prescribed class from each qubit leaves no nonzero complex annihilator.
The same coordinates and finite path labels are used throughout. -/

noncomputable section
namespace P14ThetaEdgeFamily
open P14ThetaDeletionPotential
open scoped BigOperators

def shortVertex (L : ℕ) : Bool → Option (Fin (L + 2))
  | false => some 0
  | true => some (0 : Fin (L + 1)).succ

def pathVertex (L : ℕ) : Fin (L + 1) → Option (Fin (L + 2)) :=
  Fin.cases none (fun i => some i.succ.succ)

def leftEnd {L : ℕ} : Edge L → Option (Fin (L + 2)) :=
  leftValue (shortVertex L) (pathVertex L)

def rightEnd {L : ℕ} : Edge L → Option (Fin (L + 2)) :=
  rightValue (shortVertex L) (pathVertex L)

def family (L : ℕ) (e : Edge L) : Fin (L + 1) → ℂ :=
  P14CenteredSimplexEdges.edge (L + 1) (leftEnd e) (rightEnd e)

private theorem potential_sum {L : ℕ} (f : Option (Fin (L + 2)) → ℂ)
    (hroot : f none = 0) (hsum : (∑ i, f (some i)) = 0) :
    (∑ p, f (shortVertex L p)) + (∑ i, f (pathVertex L i)) = 0 := by
  rw [Fin.sum_univ_succ, Fin.sum_univ_succ] at hsum
  convert hsum using 1 <;>
    simp [shortVertex, pathVertex, Fintype.sum_bool, Fin.sum_univ_succ, hroot] <;> abel

/-- This is the rank statement for the literal remaining edge set, not a
rank assumption passed to a product-family constructor. -/
theorem annihilator_eq_zero {L : ℕ} (deletedA deletedB : Class L)
    (y : Fin (L + 1) → ℂ)
    (hkilled : ∀ e : Edge L,
      classA e ≠ deletedA → classB e ≠ deletedB →
      (∑ r, star (family L e r) * y r) = 0) : y = 0 := by
  obtain ⟨f, hroot, hsum, hnonzero, hpair⟩ :=
    P14CenteredSimplexEdges.exists_potential y
  let s : Bool → ℂ := fun p => f (shortVertex L p)
  let g : Fin (L + 1) → ℂ := fun i => f (pathVertex L i)
  have hg0 : g 0 = 0 := hroot
  have htotal : (∑ p, s p) + (∑ i, g i) = 0 := potential_sum f hroot hsum
  have hretained : ∀ e : Edge L,
      classA e ≠ deletedA → classB e ≠ deletedB →
      leftValue s g e = rightValue s g e := by
    intro e ha hb
    have h := sub_eq_zero.mp ((hpair (leftEnd e) (rightEnd e)).symm.trans
      (hkilled e ha hb))
    rcases e with ⟨p, b⟩ | i
    · cases b <;> exact h
    · exact h
  obtain ⟨hs, hg⟩ := P14ThetaZeroSumPotential.vanish s g deletedA deletedB
    hg0 htotal hretained
  by_contra hy
  apply hnonzero hy
  have hsome : ∀ i : Fin (L + 2), f (some i) = 0 := by
    intro i
    refine Fin.cases ?_ (fun j => ?_) i
    · exact congrFun hs false
    · refine Fin.cases ?_ (fun k => ?_) j
      · exact congrFun hs true
      · exact congrFun hg k.succ
  funext v
  cases v with
  | none => exact hroot
  | some i => exact hsome i

/-- Every nonzero complex third-factor test survives on an edge outside both
deleted classes. This is the form used by the separate-qubit assembly. -/
theorem exists_survivor {L : ℕ} (deletedA deletedB : Class L)
    (y : Fin (L + 1) → ℂ) (hy : y ≠ 0) :
    ∃ e : Edge L, classA e ≠ deletedA ∧ classB e ≠ deletedB ∧
      (∑ r, star (family L e r) * y r) ≠ 0 := by
  classical
  by_contra h
  apply hy
  apply annihilator_eq_zero deletedA deletedB y
  intro e ha hb
  by_contra hp
  exact h ⟨e, ha, hb, hp⟩

end P14ThetaEdgeFamily

end
end

section

/-! The two literal qubit-ray assignments for the odd-dimensional theta
construction. Repeated short-edge rays are tracked by their deletion class;
each class has its own ray, including both endpoint classes of family B. -/

noncomputable section
namespace P14ThetaQubitLabels
open P14ThetaDeletionPotential P14QubitRayLabels
open scoped BigOperators

def labelA {L : ℕ} : Class L → Label
  | .inl b => (0, b)
  | .inr i => (i.val / 2 + 1, decide (i.val % 2 = 1))

def labelB (h : ℕ) : Class (2 * h) → Label
  | .inl b => (if b then h else 0, false)
  | .inr i => ((i.val + 1) / 2, decide (i.val % 2 = 0 ∨ i.val + 1 = 2 * h))

theorem labelA_injective {L : ℕ} : Function.Injective (@labelA L) := by
  rintro (a | i) (b | j) he
  · exact congrArg Sum.inl (congrArg Prod.snd he)
  · have hn := congrArg Prod.fst he
    simp [labelA] at hn
  · have hn := congrArg Prod.fst he
    simp [labelA] at hn
  · have hn : i.val / 2 + 1 = j.val / 2 + 1 := congrArg Prod.fst he
    have hb : decide (i.val % 2 = 1) = decide (j.val % 2 = 1) :=
      congrArg Prod.snd he
    have hp := decide_eq_decide.mp hb
    have hij : i.val = j.val := by omega
    exact congrArg Sum.inr (Fin.ext hij)

private theorem labelB_short_ne_long {h : ℕ} (hh : 0 < h)
    (b : Bool) (i : Fin (2 * h)) : labelB h (.inl b) ≠ labelB h (.inr i) := by
  intro he
  have hn : (if b then h else 0) = (i.val + 1) / 2 := congrArg Prod.fst he
  have hb : false = decide (i.val % 2 = 0 ∨ i.val + 1 = 2 * h) :=
    congrArg Prod.snd he
  have hp := Bool.of_decide_false hb.symm
  have hi := i.isLt
  cases b <;> dsimp at hn <;> omega

theorem labelB_injective {h : ℕ} (hh : 0 < h) :
    Function.Injective (labelB h) := by
  rintro (a | i) (b | j) he
  · cases a <;> cases b <;> simp_all [labelB]
  · exact (labelB_short_ne_long hh a j he).elim
  · exact (labelB_short_ne_long hh b i he.symm).elim
  · have hn : (i.val + 1) / 2 = (j.val + 1) / 2 := congrArg Prod.fst he
    have hb : decide (i.val % 2 = 0 ∨ i.val + 1 = 2 * h) =
        decide (j.val % 2 = 0 ∨ j.val + 1 = 2 * h) := congrArg Prod.snd he
    have hp := decide_eq_decide.mp hb
    have hi := i.isLt
    have hj := j.isLt
    have hij : i.val = j.val := by omega
    exact congrArg Sum.inr (Fin.ext hij)

/-- Choose an actual class if one is killed, and a harmless default otherwise.
Injectivity refers to classes, not product rows with deliberately reused rays. -/
theorem exists_deleted_class {L : ℕ} (label : Class L → Label)
    (hinj : Function.Injective label) (y : Fin 2 → ℂ) (hy : y ≠ 0) :
    ∃ c : Class L, ∀ c', pair (ray (label c')) y = 0 → c' = c := by
  classical
  by_cases hk : ∃ c, pair (ray (label c)) y = 0
  · obtain ⟨c, hc⟩ := hk
    exact ⟨c, fun c' hc' => hinj (killed_labels_equal _ _ y hy hc' hc)⟩
  · exact ⟨.inl false, fun c hc => (hk ⟨c, hc⟩).elim⟩

def qubitA {L : ℕ} (e : Edge L) : Fin 2 → ℂ := ray (labelA (classA e))

def qubitB (h : ℕ) (e : Edge (2 * h)) : Fin 2 → ℂ := ray (labelB h (classB e))

theorem qubitA_ne_zero {L : ℕ} (e : Edge L) : qubitA e ≠ 0 := ray_ne_zero _

theorem qubitB_ne_zero (h : ℕ) (e : Edge (2 * h)) : qubitB h e ≠ 0 := ray_ne_zero _

/-- The same edge survives all three arbitrary nonzero complex local tests.
The geometric factor is the actual centered-simplex family already checked. -/
theorem exists_product_survivor {h : ℕ} (hh : 0 < h)
    (x y : Fin 2 → ℂ) (z : Fin (2 * h + 1) → ℂ)
    (hx : x ≠ 0) (hy : y ≠ 0) (hz : z ≠ 0) :
    ∃ e : Edge (2 * h), pair (qubitA e) x ≠ 0 ∧ pair (qubitB h e) y ≠ 0 ∧
      (∑ r, star (P14ThetaEdgeFamily.family (2 * h) e r) * z r) ≠ 0 := by
  obtain ⟨a, ha⟩ := exists_deleted_class labelA labelA_injective x hx
  obtain ⟨b, hb⟩ := exists_deleted_class (labelB h) (labelB_injective hh) y hy
  obtain ⟨e, hea, heb, hez⟩ := P14ThetaEdgeFamily.exists_survivor a b z hz
  exact ⟨e, fun he => hea (ha (classA e) he),
    fun he => heb (hb (classB e) he), hez⟩

end P14ThetaQubitLabels

end
end

section

/-! Endpoint checks for the same theta edge vectors. These checks distinguish
the two short interior vertices from every long-path vertex. -/

noncomputable section
namespace P14ThetaIncidenceGeometry
open P14ThetaDeletionPotential P14ThetaEdgeFamily
open scoped BigOperators

theorem short_injective (L : ℕ) : Function.Injective (shortVertex L) := by
  intro p q he
  cases p <;> cases q <;> simp_all [shortVertex, Fin.ext_iff]

theorem path_injective (L : ℕ) : Function.Injective (pathVertex L) := by
  intro i
  refine Fin.cases ?_ (fun i => ?_) i
  · intro j
    refine Fin.cases ?_ (fun j => ?_) j
    · intro _; rfl
    · simp [pathVertex]
  · intro j
    refine Fin.cases ?_ (fun j => ?_) j
    · simp [pathVertex]
    · intro he
      have hij : i = j := by simpa [pathVertex] using he
      exact congrArg Fin.succ hij

theorem short_ne_path {L : ℕ} (p : Bool) (i : Fin (L + 1)) :
    shortVertex L p ≠ pathVertex L i := by
  refine Fin.cases ?_ (fun i => ?_) i
  · cases p <;> simp [shortVertex, pathVertex]
  · cases p <;> simp [shortVertex, pathVertex, Fin.ext_iff]

def DisjointEnds {L : ℕ} (e f : Edge L) : Prop :=
  leftEnd e ≠ leftEnd f ∧ leftEnd e ≠ rightEnd f ∧
    rightEnd e ≠ leftEnd f ∧ rightEnd e ≠ rightEnd f

theorem family_ne_zero {L : ℕ} (e : Edge L) : family L e ≠ 0 := by
  apply P14CenteredSimplexEdges.edge_ne_zero (by omega)
  rcases e with ⟨p, b⟩ | i
  · cases b
    · exact (short_ne_path (L := L) p 0).symm
    · exact short_ne_path p (Fin.last L)
  · intro he
    change pathVertex L i.castSucc = pathVertex L i.succ at he
    have hi := congrArg Fin.val (path_injective L he)
    change i.val = i.val + 1 at hi
    omega

theorem disjoint_pair {L : ℕ} {e f : Edge L} (hd : DisjointEnds e f) :
    (∑ r, star (family L e r) * family L f r) = 0 :=
  P14CenteredSimplexEdges.edge_pair_eq_zero _ _ _ _ hd.1 hd.2.1 hd.2.2.1 hd.2.2.2

theorem short_short_disjoint {L : ℕ} (hL : 0 < L) (p q b c : Bool)
    (hpq : p ≠ q) (hbc : b ≠ c) :
    DisjointEnds (.inl (p, b) : Edge L) (.inl (q, c)) := by
  have hp : shortVertex L p ≠ shortVertex L q := fun he => hpq (short_injective L he)
  have hends : pathVertex L 0 ≠ pathVertex L (Fin.last L) := by
    intro he
    have hv := congrArg Fin.val (path_injective L he)
    change 0 = L at hv
    omega
  cases b <;> cases c <;>
    simp_all [DisjointEnds, leftEnd, rightEnd, leftValue, rightValue,
      short_ne_path, Ne.symm (short_ne_path p 0), Ne.symm (short_ne_path q 0),
      Ne.symm (short_ne_path p (Fin.last L)), Ne.symm (short_ne_path q (Fin.last L)),
      Ne.symm hends]

theorem short_long_disjoint {L : ℕ} (p b : Bool) (i : Fin L)
    (hroot : b = false → i.val ≠ 0) (hlast : b = true → i.val + 1 ≠ L) :
    DisjointEnds (.inl (p, b) : Edge L) (.inr i) := by
  have hpath (a c : Fin (L + 1)) (h : a.val ≠ c.val) :
      pathVertex L a ≠ pathVertex L c := fun he => h (congrArg Fin.val (path_injective L he))
  have hi := i.isLt
  cases b with
  | false =>
      exact ⟨hpath 0 i.castSucc (by simp only [Fin.val_zero, Fin.val_castSucc]; exact (hroot rfl).symm),
        hpath 0 i.succ (by simp), short_ne_path p i.castSucc, short_ne_path p i.succ⟩
  | true =>
      exact ⟨short_ne_path p i.castSucc, short_ne_path p i.succ,
        hpath (Fin.last L) i.castSucc (by simp only [Fin.val_last, Fin.val_castSucc]; omega),
        hpath (Fin.last L) i.succ (by simp only [Fin.val_last, Fin.val_succ]; exact (hlast rfl).symm)⟩

theorem long_long_disjoint {L : ℕ} (i j : Fin L)
    (hij : i ≠ j) (hforward : i.val + 1 ≠ j.val) (hback : j.val + 1 ≠ i.val) :
    DisjointEnds (.inr i : Edge L) (.inr j) := by
  have hneq : i.val ≠ j.val := fun he => hij (Fin.ext he)
  have hpath (a c : Fin (L + 1)) (h : a.val ≠ c.val) :
      pathVertex L a ≠ pathVertex L c := fun he => h (congrArg Fin.val (path_injective L he))
  refine ⟨hpath i.castSucc j.castSucc hneq, hpath i.castSucc j.succ ?_,
    hpath i.succ j.castSucc hforward, hpath i.succ j.succ ?_⟩
  · change i.val ≠ j.val + 1
    exact hback.symm
  · change i.val + 1 ≠ j.val + 1
    omega

end P14ThetaIncidenceGeometry

end
end

section

/-! Orthogonality of the very same product rows used by the survivor theorem.
Adjacent long edges alternate between the two qubit factors; endpoint edges
use qubit B. Cross-disjoint edges use the centered geometric factor. -/

noncomputable section
namespace P14ThetaProductOrthogonality
open P14ThetaDeletionPotential P14ThetaEdgeFamily P14ThetaQubitLabels
open P14ThetaIncidenceGeometry P14QubitRayLabels
open scoped BigOperators

private theorem pair_opposite {l m : Label} (hn : l.1 = m.1) (hb : l.2 ≠ m.2) :
    pair (ray l) (ray m) = 0 := by
  rcases l with ⟨s, a⟩
  rcases m with ⟨t, b⟩
  dsimp at hn hb
  subst t
  cases a <;> cases b <;> simp_all [pair, ray, Fin.sum_univ_two]

private theorem zero_pair_symm {n : ℕ} (u v : Fin n → ℂ)
    (he : (∑ r, star (u r) * v r) = 0) : (∑ r, star (v r) * u r) = 0 := by
  have h := congrArg star he
  simpa [star_sum, star_mul, mul_comm] using h

def Orth {h : ℕ} (e f : Edge (2 * h)) : Prop :=
  pair (qubitA e) (qubitA f) = 0 ∨ pair (qubitB h e) (qubitB h f) = 0 ∨
    (∑ r, star (family (2 * h) e r) * family (2 * h) f r) = 0

theorem Orth.symm {h : ℕ} {e f : Edge (2 * h)} (he : Orth e f) : Orth f e := by
  rcases he with he | he | he
  · exact Or.inl (zero_pair_symm _ _ he)
  · exact Or.inr (Or.inl (zero_pair_symm _ _ he))
  · exact Or.inr (Or.inr (zero_pair_symm _ _ he))

private theorem short_short {h : ℕ} (hh : 0 < h) (p q b c : Bool)
    (hne : (Sum.inl (p, b) : Edge (2 * h)) ≠ .inl (q, c)) :
    Orth (.inl (p, b) : Edge (2 * h)) (.inl (q, c)) := by
  by_cases hx : Bool.xor p b ≠ Bool.xor q c
  · left
    exact pair_opposite rfl hx
  · have hp : p ≠ q := by
      cases p <;> cases q <;> cases b <;> cases c <;> simp_all
    have hb : b ≠ c := by
      cases p <;> cases q <;> cases b <;> cases c <;> simp_all
    exact Or.inr (Or.inr (disjoint_pair (short_short_disjoint (by omega) p q b c hp hb)))

private theorem short_long {h : ℕ} (hh : 0 < h) (p b : Bool) (i : Fin (2 * h)) :
    Orth (.inl (p, b) : Edge (2 * h)) (.inr i) := by
  cases b with
  | false =>
      by_cases hi : i.val = 0
      · right; left
        apply pair_opposite
        · simp [qubitB, classB, labelB, hi]
        · simp [qubitB, classB, labelB, hi]
      · exact Or.inr (Or.inr (disjoint_pair (short_long_disjoint p false i
          (fun _ => hi) (by simp))))
  | true =>
      by_cases hi : i.val + 1 = 2 * h
      · right; left
        apply pair_opposite
        · change h = (i.val + 1) / 2
          omega
        · simp [qubitB, classB, labelB, hi]
      · exact Or.inr (Or.inr (disjoint_pair (short_long_disjoint p true i
          (by simp) (fun _ => hi))))

private theorem long_adjacent {h : ℕ} (i j : Fin (2 * h))
    (hij : i.val + 1 = j.val) : Orth (.inr i : Edge (2 * h)) (.inr j) := by
  by_cases hi : i.val % 2 = 0
  · have hj : j.val % 2 = 1 := by omega
    left
    apply pair_opposite
    · change i.val / 2 + 1 = j.val / 2 + 1
      omega
    · simp [qubitA, classA, labelA, hi, hj]
  · have hi' : i.val % 2 = 1 := by omega
    have hj : j.val % 2 = 0 := by omega
    have hend : i.val + 1 ≠ 2 * h := by have := j.isLt; omega
    right; left
    apply pair_opposite
    · change (i.val + 1) / 2 = (j.val + 1) / 2
      omega
    · simp [qubitB, classB, labelB, hi', hj, hend]

/-- Every pair of distinct rows is orthogonal in an actual local factor. -/
theorem all_pairs {h : ℕ} (hh : 0 < h) (e f : Edge (2 * h)) (hne : e ≠ f) :
    Orth e f := by
  rcases e with ⟨p, b⟩ | i <;> rcases f with ⟨q, c⟩ | j
  · exact short_short hh p q b c hne
  · exact short_long hh p b j
  · exact (short_long hh q c i).symm
  · by_cases hf : i.val + 1 = j.val
    · exact long_adjacent i j hf
    · by_cases hb : j.val + 1 = i.val
      · exact (long_adjacent j i hb).symm
      · exact Or.inr (Or.inr (disjoint_pair (long_long_disjoint i j
          (fun he => hne (congrArg Sum.inr he)) hf hb)))

end P14ThetaProductOrthogonality

end
end

section

/-! Literal finite complex-coordinate UPBs for dimensions (2,2,2h+1), h>0.
The row count 2h+4 equals the canonical trivial-plus-one ceiling. This is a
scoped construction, not a resolution of the unrestricted mixed problem. -/

noncomputable section
namespace P14ThetaOddUPB
open P14ThetaDeletionPotential P14ThetaEdgeFamily P14ThetaQubitLabels
open P14ThetaIncidenceGeometry P14ThetaProductOrthogonality P14QubitRayLabels
open scoped BigOperators

def dimensions (h : ℕ) : Fin 3 → ℕ :=
  Fin.cases 2 (Fin.cases 2 (fun _ => 2 * h + 1))

def row (h : ℕ) (e : Edge (2 * h)) : (j : Fin 3) → Fin (dimensions h j) → ℂ :=
  Fin.cases (qubitA e) (Fin.cases (qubitB h e) (fun _ => family (2 * h) e))

theorem edge_card (h : ℕ) : Fintype.card (Edge (2 * h)) = 2 * h + 4 := by
  simp [Edge, add_comm]

theorem ceiling (h : ℕ) : 2 + (∑ j, (dimensions h j - 1)) = 2 * h + 4 := by
  simp [dimensions, Fin.sum_univ_succ]
  omega

/-- The conclusion has exactly the saved canonical quantifiers: nonzero
local vectors, actual pairwise local orthogonality, and one row surviving
all arbitrary nonzero complex local tests. No real-only replacement is used. -/
theorem canonical {h : ℕ} (hh : 0 < h) :
    ∃ m : ℕ, m ≤ 2 + ∑ j, (dimensions h j - 1) ∧
      ∃ v : Fin m → (j : Fin 3) → Fin (dimensions h j) → ℂ,
        (∀ i j, v i j ≠ 0) ∧
        (∀ i i', i ≠ i' → ∃ j, (∑ r, star (v i j r) * v i' j r) = 0) ∧
        (∀ a : (j : Fin 3) → Fin (dimensions h j) → ℂ, (∀ j, a j ≠ 0) →
          ∃ i, ∀ j, (∑ r, star (v i j r) * a j r) ≠ 0) := by
  let E : Fin (2 * h + 4) ≃ Edge (2 * h) := (Fintype.equivFinOfCardEq (edge_card h)).symm
  refine ⟨2 * h + 4, by rw [ceiling], (fun i => row h (E i)), ?_, ?_, ?_⟩
  · intro i j
    fin_cases j
    · exact qubitA_ne_zero (E i)
    · exact qubitB_ne_zero h (E i)
    · exact family_ne_zero (E i)
  · intro i i' hne
    have he : E i ≠ E i' := fun he => hne (E.injective he)
    rcases all_pairs hh (E i) (E i') he with ha | hb | hc
    · exact ⟨0, ha⟩
    · exact ⟨1, hb⟩
    · exact ⟨2, hc⟩
  · intro a ha
    obtain ⟨e, hx, hy, hz⟩ := exists_product_survivor hh (a 0) (a 1) (a 2)
      (ha 0) (ha 1) (ha 2)
    refine ⟨E.symm e, ?_⟩
    intro j
    fin_cases j
    · change pair (qubitA (E (E.symm e))) (a 0) ≠ 0
      rw [E.apply_symm_apply]
      exact hx
    · change pair (qubitB h (E (E.symm e))) (a 1) ≠ 0
      rw [E.apply_symm_apply]
      exact hy
    · change (∑ r, star (family (2 * h) (E (E.symm e)) r) * a 2 r) ≠ 0
      rw [E.apply_symm_apply]
      exact hz

theorem dimensions_literal (h : ℕ) : dimensions h = ![2, 2, 2 * h + 1] := by
  funext j
  fin_cases j <;> rfl

end P14ThetaOddUPB

end
end

section

/-! Potentials on a finite path plus its closing edge after deletion of at
most two edges. The proof extends the same path values to the already checked
theta lemma; auxiliary short vertices impose no new premise on the cycle. -/

namespace P14CycleDeletionPotential
open scoped BigOperators

abbrev Edge (L : ℕ) := Option (Fin L)

def leftValue {C : Type*} {L : ℕ} (g : Fin (L + 1) → C) : Edge L → C
  | none => g (Fin.last L)
  | some i => g i.castSucc

def rightValue {C : Type*} {L : ℕ} (g : Fin (L + 1) → C) : Edge L → C
  | none => g 0
  | some i => g i.succ

theorem two_values {C : Type*} [Zero C] {L : ℕ}
    (g : Fin (L + 1) → C) (a b : Edge L) (hroot : g 0 = 0)
    (hretained : ∀ e, e ≠ a → e ≠ b → leftValue g e = rightValue g e) :
    ∃ c : C, ∀ i, g i = 0 ∨ g i = c := by
  cases a with
  | none =>
      cases b with
      | none =>
          obtain ⟨c, _, hg⟩ := P14ThetaDeletionPotential.two_values
            (fun _ => g (Fin.last L)) g (.inl false) (.inl false) hroot (by
              rintro (⟨p, e⟩ | i) ha hb
              · cases p <;> cases e <;>
                  simp_all [P14ThetaDeletionPotential.classA, P14ThetaDeletionPotential.classB,
                    P14ThetaDeletionPotential.leftValue, P14ThetaDeletionPotential.rightValue]
              · exact hretained (some i) (by simp) (by simp))
          exact ⟨c, hg⟩
      | some cut =>
          obtain ⟨c, _, hg⟩ := P14ThetaDeletionPotential.two_values
            (fun p => if p then 0 else g (Fin.last L)) g (.inl false) (.inr cut) hroot (by
              rintro (⟨p, e⟩ | i) ha hb
              · cases p <;> cases e <;>
                  simp_all [P14ThetaDeletionPotential.classA, P14ThetaDeletionPotential.classB,
                    P14ThetaDeletionPotential.leftValue, P14ThetaDeletionPotential.rightValue]
              · exact hretained (some i) (by simp)
                  (by simpa [P14ThetaDeletionPotential.classB] using hb))
          exact ⟨c, hg⟩
  | some cutA =>
      cases b with
      | none =>
          obtain ⟨c, _, hg⟩ := P14ThetaDeletionPotential.two_values
            (fun _ => g (Fin.last L)) g (.inr cutA) (.inl false) hroot (by
              rintro (⟨p, e⟩ | i) ha hb
              · cases p <;> cases e <;>
                  simp_all [P14ThetaDeletionPotential.classA, P14ThetaDeletionPotential.classB,
                    P14ThetaDeletionPotential.leftValue, P14ThetaDeletionPotential.rightValue]
              · exact hretained (some i)
                  (by simpa [P14ThetaDeletionPotential.classA] using ha) (by simp))
          exact ⟨c, hg⟩
      | some cutB =>
          have hend : g (Fin.last L) = 0 :=
            (hretained none (by simp) (by simp)).trans hroot
          obtain ⟨c, _, hg⟩ := P14ThetaDeletionPotential.two_values
            (fun _ => 0) g (.inr cutA) (.inr cutB) hroot (by
              rintro (⟨p, e⟩ | i) ha hb
              · cases e <;>
                  simp_all [P14ThetaDeletionPotential.leftValue, P14ThetaDeletionPotential.rightValue]
              · exact hretained (some i)
                  (by simpa [P14ThetaDeletionPotential.classA] using ha)
                  (by simpa [P14ThetaDeletionPotential.classB] using hb))
          exact ⟨c, hg⟩

/-- The actual complex potential vanishes when its total sum is zero. -/
theorem vanish {L : ℕ} (g : Fin (L + 1) → ℂ) (a b : Edge L)
    (hroot : g 0 = 0) (hsum : (∑ i, g i) = 0)
    (hretained : ∀ e, e ≠ a → e ≠ b → leftValue g e = rightValue g e) : g = 0 := by
  obtain ⟨c, hc⟩ := two_values g a b hroot hretained
  exact P14ThetaZeroSumPotential.zero_of_two_values g c hc hsum

end P14CycleDeletionPotential

end

section

/-! Actual centered-simplex edge coordinates on a cycle. Every nonzero
complex test survives outside two deleted edges. Endpoint classification
also supplies the third-factor orthogonality used by the product assembly. -/

noncomputable section
namespace P14CycleEdgeFamily
open P14CycleDeletionPotential
open scoped BigOperators

def vertex (k : ℕ) : Fin (k + 2) → Option (Fin (k + 1)) := Fin.cases none some

def leftEnd {k : ℕ} : Edge (k + 1) → Option (Fin (k + 1)) := leftValue (vertex k)

def rightEnd {k : ℕ} : Edge (k + 1) → Option (Fin (k + 1)) := rightValue (vertex k)

def family (k : ℕ) (e : Edge (k + 1)) : Fin k → ℂ :=
  P14CenteredSimplexEdges.edge k (leftEnd e) (rightEnd e)

theorem vertex_injective (k : ℕ) : Function.Injective (vertex k) := by
  intro i
  refine Fin.cases ?_ (fun i => ?_) i
  · intro j
    refine Fin.cases ?_ (fun j => ?_) j
    · intro _; rfl
    · simp [vertex]
  · intro j
    refine Fin.cases ?_ (fun j => ?_) j
    · simp [vertex]
    · intro he
      have hij : i = j := by simpa [vertex] using he
      exact congrArg Fin.succ hij

theorem family_ne_zero {k : ℕ} (hk : 1 ≤ k) (e : Edge (k + 1)) : family k e ≠ 0 := by
  apply P14CenteredSimplexEdges.edge_ne_zero hk
  intro he
  cases e with
  | none =>
      change vertex k (Fin.last (k + 1)) = vertex k 0 at he
      have hv := congrArg Fin.val (vertex_injective k he)
      change k + 1 = 0 at hv
      omega
  | some i =>
      change vertex k i.castSucc = vertex k i.succ at he
      have hv := congrArg Fin.val (vertex_injective k he)
      change i.val = i.val + 1 at hv
      omega

theorem annihilator_eq_zero {k : ℕ} (a b : Edge (k + 1)) (y : Fin k → ℂ)
    (hkilled : ∀ e, e ≠ a → e ≠ b → (∑ r, star (family k e r) * y r) = 0) : y = 0 := by
  obtain ⟨f, hroot, hsum, hnonzero, hpair⟩ := P14CenteredSimplexEdges.exists_potential y
  let g : Fin (k + 2) → ℂ := fun i => f (vertex k i)
  have hgroot : g 0 = 0 := hroot
  have hgsum : (∑ i, g i) = 0 := by
    simpa [g, vertex, Fin.sum_univ_succ, hroot] using hsum
  have hretained : ∀ e, e ≠ a → e ≠ b → leftValue g e = rightValue g e := by
    intro e ha hb
    have he := sub_eq_zero.mp ((hpair (leftEnd e) (rightEnd e)).symm.trans (hkilled e ha hb))
    cases e <;> exact he
  have hg := P14CycleDeletionPotential.vanish g a b hgroot hgsum hretained
  by_contra hy
  apply hnonzero hy
  funext v
  cases v with
  | none => exact congrFun hg 0
  | some i => exact congrFun hg i.succ

theorem exists_survivor {k : ℕ} (a b : Edge (k + 1)) (y : Fin k → ℂ) (hy : y ≠ 0) :
    ∃ e : Edge (k + 1), e ≠ a ∧ e ≠ b ∧ (∑ r, star (family k e r) * y r) ≠ 0 := by
  classical
  by_contra he
  apply hy
  apply annihilator_eq_zero a b y
  intro e ha hb
  by_contra hp
  exact he ⟨e, ha, hb, hp⟩

def DisjointEnds {k : ℕ} (e f : Edge (k + 1)) : Prop :=
  leftEnd e ≠ leftEnd f ∧ leftEnd e ≠ rightEnd f ∧
    rightEnd e ≠ leftEnd f ∧ rightEnd e ≠ rightEnd f

theorem disjoint_pair {k : ℕ} {e f : Edge (k + 1)} (hd : DisjointEnds e f) :
    (∑ r, star (family k e r) * family k f r) = 0 :=
  P14CenteredSimplexEdges.edge_pair_eq_zero _ _ _ _ hd.1 hd.2.1 hd.2.2.1 hd.2.2.2

theorem closing_path_disjoint {k : ℕ} (i : Fin (k + 1))
    (hroot : i.val ≠ 0) (hlast : i.val + 1 ≠ k + 1) :
    DisjointEnds (none : Edge (k + 1)) (some i) := by
  have hpath (a c : Fin (k + 2)) (h : a.val ≠ c.val) :
      vertex k a ≠ vertex k c := fun he => h (congrArg Fin.val (vertex_injective k he))
  have hi := i.isLt
  refine ⟨hpath (Fin.last (k + 1)) i.castSucc ?_, hpath (Fin.last (k + 1)) i.succ ?_,
    hpath 0 i.castSucc ?_, hpath 0 i.succ ?_⟩
  · change k + 1 ≠ i.val
    omega
  · change k + 1 ≠ i.val + 1
    exact hlast.symm
  · exact hroot.symm
  · simp

theorem path_path_disjoint {k : ℕ} (i j : Fin (k + 1))
    (hij : i ≠ j) (hforward : i.val + 1 ≠ j.val) (hback : j.val + 1 ≠ i.val) :
    DisjointEnds (some i : Edge (k + 1)) (some j) := by
  have hneq : i.val ≠ j.val := fun he => hij (Fin.ext he)
  have hpath (a c : Fin (k + 2)) (h : a.val ≠ c.val) :
      vertex k a ≠ vertex k c := fun he => h (congrArg Fin.val (vertex_injective k he))
  refine ⟨hpath i.castSucc j.castSucc hneq, hpath i.castSucc j.succ ?_,
    hpath i.succ j.castSucc hforward, hpath i.succ j.succ ?_⟩
  · change i.val ≠ j.val + 1
    exact hback.symm
  · change i.val + 1 ≠ j.val + 1
    omega

end P14CycleEdgeFamily

end
end

section

/-! Two injective qubit-ray labelings of the even cycle edges. Each nonzero
complex qubit test kills at most one edge, and the same remaining edge then
survives all three local tests. -/

noncomputable section
namespace P14CycleQubitLabels
open P14CycleDeletionPotential P14QubitRayLabels
open scoped BigOperators

def labelA (h : ℕ) : Edge (2 * h + 1) → Label
  | none => (h, true)
  | some i => (i.val / 2, decide (i.val % 2 = 1))

def labelB {L : ℕ} : Edge L → Label
  | none => (0, false)
  | some i => ((i.val + 1) / 2, decide (i.val % 2 = 0))

private theorem labelA_none_ne_some (h : ℕ) (i : Fin (2 * h + 1)) :
    labelA h none ≠ labelA h (some i) := by
  intro he
  have hn : h = i.val / 2 := congrArg Prod.fst he
  have hb : true = decide (i.val % 2 = 1) := congrArg Prod.snd he
  have hp : i.val % 2 = 1 := of_decide_eq_true hb.symm
  have hi := i.isLt
  omega

theorem labelA_injective (h : ℕ) : Function.Injective (labelA h) := by
  intro e f he
  cases e with
  | none =>
      cases f with
      | none => rfl
      | some i => exact (labelA_none_ne_some h i he).elim
  | some i =>
      cases f with
      | none => exact (labelA_none_ne_some h i he.symm).elim
      | some j =>
          have hn : i.val / 2 = j.val / 2 := congrArg Prod.fst he
          have hb : decide (i.val % 2 = 1) = decide (j.val % 2 = 1) := congrArg Prod.snd he
          have hp := decide_eq_decide.mp hb
          exact congrArg some (Fin.ext (by omega))

private theorem labelB_none_ne_some {L : ℕ} (i : Fin L) :
    labelB (L := L) none ≠ labelB (some i) := by
  intro he
  have hn : 0 = (i.val + 1) / 2 := congrArg Prod.fst he
  have hb : false = decide (i.val % 2 = 0) := congrArg Prod.snd he
  have hp := Bool.of_decide_false hb.symm
  omega

theorem labelB_injective {L : ℕ} : Function.Injective (@labelB L) := by
  intro e f he
  cases e with
  | none =>
      cases f with
      | none => rfl
      | some i => exact (labelB_none_ne_some i he).elim
  | some i =>
      cases f with
      | none => exact (labelB_none_ne_some i he.symm).elim
      | some j =>
          have hn : (i.val + 1) / 2 = (j.val + 1) / 2 := congrArg Prod.fst he
          have hb : decide (i.val % 2 = 0) = decide (j.val % 2 = 0) := congrArg Prod.snd he
          have hp := decide_eq_decide.mp hb
          exact congrArg some (Fin.ext (by omega))

theorem exists_deleted_edge {L : ℕ} (label : Edge L → Label)
    (hinj : Function.Injective label) (y : Fin 2 → ℂ) (hy : y ≠ 0) :
    ∃ e : Edge L, ∀ e', pair (ray (label e')) y = 0 → e' = e := by
  classical
  by_cases hk : ∃ e, pair (ray (label e)) y = 0
  · obtain ⟨e, he⟩ := hk
    exact ⟨e, fun e' he' => hinj (killed_labels_equal _ _ y hy he' he)⟩
  · exact ⟨none, fun e he => (hk ⟨e, he⟩).elim⟩

def qubitA (h : ℕ) (e : Edge (2 * h + 1)) : Fin 2 → ℂ := ray (labelA h e)

def qubitB {L : ℕ} (e : Edge L) : Fin 2 → ℂ := ray (labelB e)

theorem qubitA_ne_zero (h : ℕ) (e : Edge (2 * h + 1)) : qubitA h e ≠ 0 := ray_ne_zero _

theorem qubitB_ne_zero {L : ℕ} (e : Edge L) : qubitB e ≠ 0 := ray_ne_zero _

theorem exists_product_survivor (h : ℕ) (x y : Fin 2 → ℂ) (z : Fin (2 * h) → ℂ)
    (hx : x ≠ 0) (hy : y ≠ 0) (hz : z ≠ 0) :
    ∃ e : Edge (2 * h + 1), pair (qubitA h e) x ≠ 0 ∧ pair (qubitB e) y ≠ 0 ∧
      (∑ r, star (P14CycleEdgeFamily.family (2 * h) e r) * z r) ≠ 0 := by
  obtain ⟨a, ha⟩ := exists_deleted_edge (labelA h) (labelA_injective h) x hx
  obtain ⟨b, hb⟩ := exists_deleted_edge labelB labelB_injective y hy
  obtain ⟨e, hea, heb, hez⟩ := P14CycleEdgeFamily.exists_survivor a b z hz
  exact ⟨e, fun he => hea (ha e he), fun he => heb (hb e he), hez⟩

end P14CycleQubitLabels

end
end

section

/-! The two qubit assignments cover every adjacent pair of cycle edges.
All other distinct pairs are orthogonal in the same actual geometric factor. -/

noncomputable section
namespace P14CycleProductOrthogonality
open P14CycleDeletionPotential P14CycleEdgeFamily P14CycleQubitLabels P14QubitRayLabels
open scoped BigOperators

private theorem pair_opposite {l m : Label} (hn : l.1 = m.1) (hb : l.2 ≠ m.2) :
    pair (ray l) (ray m) = 0 := by
  rcases l with ⟨s, a⟩
  rcases m with ⟨t, b⟩
  dsimp at hn hb
  subst t
  cases a <;> cases b <;> simp_all [pair, ray, Fin.sum_univ_two]

private theorem zero_pair_symm {n : ℕ} (u v : Fin n → ℂ)
    (he : (∑ r, star (u r) * v r) = 0) : (∑ r, star (v r) * u r) = 0 := by
  have h := congrArg star he
  simpa [star_sum, star_mul, mul_comm] using h

def Orth {h : ℕ} (e f : Edge (2 * h + 1)) : Prop :=
  pair (qubitA h e) (qubitA h f) = 0 ∨ pair (qubitB e) (qubitB f) = 0 ∨
    (∑ r, star (family (2 * h) e r) * family (2 * h) f r) = 0

theorem Orth.symm {h : ℕ} {e f : Edge (2 * h + 1)} (he : Orth e f) : Orth f e := by
  rcases he with he | he | he
  · exact Or.inl (zero_pair_symm _ _ he)
  · exact Or.inr (Or.inl (zero_pair_symm _ _ he))
  · exact Or.inr (Or.inr (zero_pair_symm _ _ he))

private theorem closing_path (h : ℕ) (i : Fin (2 * h + 1)) :
    Orth (none : Edge (2 * h + 1)) (some i) := by
  by_cases hroot : i.val = 0
  · right; left
    apply pair_opposite
    · simp [labelB, hroot]
    · simp [labelB, hroot]
  · by_cases hlast : i.val = 2 * h
    · left
      apply pair_opposite
      · change h = i.val / 2
        omega
      · simp [labelA, hlast]
    · exact Or.inr (Or.inr (disjoint_pair (closing_path_disjoint i hroot (by omega))))

private theorem path_adjacent {h : ℕ} (i j : Fin (2 * h + 1))
    (hij : i.val + 1 = j.val) : Orth (some i : Edge (2 * h + 1)) (some j) := by
  by_cases hi : i.val % 2 = 0
  · have hj : j.val % 2 = 1 := by omega
    left
    apply pair_opposite
    · change i.val / 2 = j.val / 2
      omega
    · simp [labelA, hi, hj]
  · have hi' : i.val % 2 = 1 := by omega
    have hj : j.val % 2 = 0 := by omega
    right; left
    apply pair_opposite
    · change (i.val + 1) / 2 = (j.val + 1) / 2
      omega
    · simp [labelB, hi', hj]

theorem all_pairs (h : ℕ) (e f : Edge (2 * h + 1)) (hne : e ≠ f) : Orth e f := by
  cases e with
  | none =>
      cases f with
      | none => exact (hne rfl).elim
      | some i => exact closing_path h i
  | some i =>
      cases f with
      | none => exact (closing_path h i).symm
      | some j =>
          by_cases hf : i.val + 1 = j.val
          · exact path_adjacent i j hf
          · by_cases hb : j.val + 1 = i.val
            · exact (path_adjacent j i hb).symm
            · exact Or.inr (Or.inr (disjoint_pair (path_path_disjoint i j
                (fun he => hne (congrArg some he)) hf hb)))

end P14CycleProductOrthogonality

end
end

section

/-! Literal complex-coordinate UPBs in dimensions (2,2,2h), h>=2. The
2h+2 cycle rows lie one below the original trivial-plus-one ceiling. -/

noncomputable section
namespace P14CycleEvenUPB
open P14CycleDeletionPotential P14CycleEdgeFamily P14CycleQubitLabels
open P14CycleProductOrthogonality P14QubitRayLabels
open scoped BigOperators

def dimensions (h : ℕ) : Fin 3 → ℕ :=
  Fin.cases 2 (Fin.cases 2 (fun _ => 2 * h))

def row (h : ℕ) (e : Edge (2 * h + 1)) : (j : Fin 3) → Fin (dimensions h j) → ℂ :=
  Fin.cases (qubitA h e) (Fin.cases (qubitB e) (fun _ => family (2 * h) e))

theorem edge_card (h : ℕ) : Fintype.card (Edge (2 * h + 1)) = 2 * h + 2 := by
  simp [Edge, add_assoc]

theorem ceiling (h : ℕ) (hh : 0 < h) :
    2 + (∑ j, (dimensions h j - 1)) = 2 * h + 3 := by
  simp [dimensions, Fin.sum_univ_succ]
  omega

theorem canonical {h : ℕ} (hh : 2 ≤ h) :
    ∃ m : ℕ, m ≤ 2 + ∑ j, (dimensions h j - 1) ∧
      ∃ v : Fin m → (j : Fin 3) → Fin (dimensions h j) → ℂ,
        (∀ i j, v i j ≠ 0) ∧
        (∀ i i', i ≠ i' → ∃ j, (∑ r, star (v i j r) * v i' j r) = 0) ∧
        (∀ a : (j : Fin 3) → Fin (dimensions h j) → ℂ, (∀ j, a j ≠ 0) →
          ∃ i, ∀ j, (∑ r, star (v i j r) * a j r) ≠ 0) := by
  let E : Fin (2 * h + 2) ≃ Edge (2 * h + 1) := (Fintype.equivFinOfCardEq (edge_card h)).symm
  refine ⟨2 * h + 2, by rw [ceiling h (by omega)]; omega,
    (fun i => row h (E i)), ?_, ?_, ?_⟩
  · intro i j
    fin_cases j
    · exact qubitA_ne_zero h (E i)
    · exact qubitB_ne_zero (E i)
    · exact family_ne_zero (by omega) (E i)
  · intro i i' hne
    have he : E i ≠ E i' := fun he => hne (E.injective he)
    rcases all_pairs h (E i) (E i') he with ha | hb | hc
    · exact ⟨0, ha⟩
    · exact ⟨1, hb⟩
    · exact ⟨2, hc⟩
  · intro a ha
    obtain ⟨e, hx, hy, hz⟩ := exists_product_survivor h (a 0) (a 1) (a 2)
      (ha 0) (ha 1) (ha 2)
    refine ⟨E.symm e, ?_⟩
    intro j
    fin_cases j
    · change pair (qubitA h (E (E.symm e))) (a 0) ≠ 0
      rw [E.apply_symm_apply]
      exact hx
    · change pair (qubitB (E (E.symm e))) (a 1) ≠ 0
      rw [E.apply_symm_apply]
      exact hy
    · change (∑ r, star (family (2 * h) (E (E.symm e)) r) * a 2 r) ≠ 0
      rw [E.apply_symm_apply]
      exact hz

theorem dimensions_literal (h : ℕ) : dimensions h = ![2, 2, 2 * h] := by
  funext j
  fin_cases j <;> rfl

end P14CycleEvenUPB

end
end

section

/-! Complete (2,2,K), K>=3, specialization of the corrected mixed UPB
conclusion, including arbitrary reordering of its three original factors.
This does not cover the other mixed dimension patterns. -/

namespace P14TwoQubitsUPB
open scoped BigOperators

def Conclusion (d : Fin 3 → ℕ) : Prop :=
  ∃ m : ℕ, m ≤ 2 + ∑ j, (d j - 1) ∧
    ∃ v : Fin m → (j : Fin 3) → Fin (d j) → ℂ,
      (∀ i j, v i j ≠ 0) ∧
      (∀ i i', i ≠ i' → ∃ j, (∑ r, star (v i j r) * v i' j r) = 0) ∧
      (∀ a : (j : Fin 3) → Fin (d j) → ℂ, (∀ j, a j ≠ 0) →
        ∃ i, ∀ j, (∑ r, star (v i j r) * a j r) ≠ 0)

theorem reindex (d : Fin 3 → ℕ) (e : Fin 3 ≃ Fin 3) (hc : Conclusion d) :
    Conclusion (fun j => d (e j)) := by
  obtain ⟨m, hm, v, hv, ho, hs⟩ := hc
  refine ⟨m, ?_, (fun i j => v i (e j)), (fun i j => hv i (e j)), ?_, ?_⟩
  · have hsum : (∑ j, (d (e j) - 1)) = ∑ j, (d j - 1) :=
      e.sum_comp (fun j => d j - 1)
    simpa only [hsum] using hm
  · intro i i' hi
    obtain ⟨j, hj⟩ := ho i i' hi
    obtain ⟨l, rfl⟩ := e.surjective j
    exact ⟨l, hj⟩
  · intro a ha
    let b : (j : Fin 3) → Fin (d j) → ℂ :=
      Equiv.piCongrLeft (fun j => Fin (d j) → ℂ) e a
    have hb : ∀ j, b j ≠ 0 := by
      intro j
      obtain ⟨l, rfl⟩ := e.surjective j
      simpa only [b, Equiv.piCongrLeft_apply_apply] using ha l
    obtain ⟨i, hi⟩ := hs b hb
    refine ⟨i, ?_⟩
    intro j
    simpa only [b, Equiv.piCongrLeft_apply_apply] using hi (e j)

theorem canonical_even {h : ℕ} (hh : 2 ≤ h) : Conclusion ![2, 2, 2 * h] := by
  have hc := P14CycleEvenUPB.canonical hh
  rw [P14CycleEvenUPB.dimensions_literal] at hc
  exact hc

theorem canonical_odd {h : ℕ} (hh : 0 < h) : Conclusion ![2, 2, 2 * h + 1] := by
  have hc := P14ThetaOddUPB.canonical hh
  rw [P14ThetaOddUPB.dimensions_literal] at hc
  exact hc

/-- Every mixed three-factor tuple (2,2,K), with no parity restriction. -/
theorem canonical (K : ℕ) (hK : 3 ≤ K) : Conclusion ![2, 2, K] := by
  obtain ⟨h, he | ho⟩ := Nat.even_or_odd' K
  · subst K
    exact canonical_even (by omega)
  · subst K
    exact canonical_odd (by omega)

/-- Preserve an original ordered tuple through one exact factor equivalence. -/
theorem of_dimensions (K : ℕ) (hK : 3 ≤ K) (D : Fin 3 → ℕ) (e : Fin 3 ≃ Fin 3)
    (hD : ∀ j, D j = (![2, 2, K] : Fin 3 → ℕ) (e j)) : Conclusion D := by
  have hd : D = fun j => (![2, 2, K] : Fin 3 → ℕ) (e j) := funext hD
  rw [hd]
  exact reindex _ e (canonical K hK)

end P14TwoQubitsUPB

end

section

/-! Every multipartite tuple with total dimension deficit six has a UPB
within the literal canonical ceiling eight. The dimensions and their order
are unrestricted; this combines the actual small-case constructions. -/

noncomputable section
namespace P14EightRowFullCanonical
open P14CanonicalUPBTransport
open scoped BigOperators

private theorem rest_bound {n : ℕ} (R : Fin n → ℕ) (k : ℕ)
    (hk : ∀ j, k ≤ R j) (j : Fin n) : k * (n - 1) + R j ≤ ∑ i, R i := by
  classical
  have hrest : k * (n - 1) ≤ ∑ i ∈ (Finset.univ : Finset (Fin n)).erase j, R i := by
    calc
      k * (n - 1) = ∑ _i ∈ (Finset.univ : Finset (Fin n)).erase j, k := by
        simp [Finset.card_erase_of_mem (Finset.mem_univ j), Nat.mul_comm]
      _ ≤ ∑ i ∈ (Finset.univ : Finset (Fin n)).erase j, R i :=
        Finset.sum_le_sum (fun i _ => hk i)
  have he := Finset.sum_erase_add (Finset.univ : Finset (Fin n)) R (Finset.mem_univ j)
  omega

theorem three_with_first_qubit (a b : ℕ) (ha : 2 ≤ a) (hb : 2 ≤ b)
    (hs : a + b = 7) : Conclusion 3 ![2, a, b] := by
  have cases : (a = 2 ∧ b = 5) ∨ (a = 3 ∧ b = 4) ∨
      (a = 4 ∧ b = 3) ∨ (a = 5 ∧ b = 2) := by omega
  rcases cases with ⟨rfl, rfl⟩ | ⟨rfl, rfl⟩ | ⟨rfl, rfl⟩ | ⟨rfl, rfl⟩
  · exact P14TwoQubitsUPB.canonical 5 (by omega)
  · exact P14EightRowDominantUPB.two_three_four
  · exact P14EightRowDominantUPB.two_four_three
  · have h : Conclusion 3 ![2, 2, 5] := P14TwoQubitsUPB.canonical 5 (by omega)
    have hr := reindex (![2, 2, 5] : Fin 3 → ℕ) (Equiv.swap 1 2) h
    have he : (fun j => (![2, 2, 5] : Fin 3 → ℕ) (Equiv.swap 1 2 j)) = ![2, 5, 2] := by
      funext j
      fin_cases j <;> simp [Equiv.swap_apply_def]
    rwa [he] at hr

theorem with_qubit {p : ℕ} (d : Fin p → ℕ) (hp : 3 ≤ p)
    (hd : ∀ j, 2 ≤ d j) (hq : ∃ j, d j = 2)
    (hsum : (∑ j, (d j - 1)) = 6) : Conclusion p d := by
  classical
  cases p with
  | zero => omega
  | succ p =>
    cases p with
    | zero => omega
    | succ n =>
      obtain ⟨t, ht⟩ := hq
      let E : Fin (n + 2) ≃ Fin (n + 2) := Equiv.swap 0 t
      have hzero : d (E 0) = 2 := by simp [E, ht]
      have hE : (∑ j, (d (E j) - 1)) = 6 :=
        (E.sum_comp (fun j => d j - 1)).trans hsum
      by_cases hn : n = 1
      · subst n
        have hs : d (E 1) + d (E 2) = 7 := by
          have h1 := hd (E 1)
          have h2 := hd (E 2)
          norm_num [Fin.sum_univ_succ, hzero] at hE
          omega
        have he : (fun j => d (E j)) = ![2, d (E 1), d (E 2)] := by
          funext j
          fin_cases j <;> simp [hzero]
        have hc : Conclusion 3 (fun j => d (E j)) := by
          rw [he]
          exact three_with_first_qubit _ _ (hd (E 1)) (hd (E 2)) hs
        have hf := reindex (fun j => d (E j)) E hc
        simpa only [E, Equiv.swap_apply_self] using hf
      have hn2 : 2 ≤ n := by omega
      have hsecond : ∃ u : Fin (n + 1), d (E u.succ) = 2 := by
        by_contra hu
        push Not at hu
        have hl : ∀ u : Fin (n + 1), 2 ≤ d (E u.succ) - 1 := by
          intro u
          have h1 := hd (E u.succ)
          have h2 := hu u
          omega
        have hle : 2 * (n + 1) ≤ ∑ u : Fin (n + 1), (d (E u.succ) - 1) := by
          calc
            2 * (n + 1) = ∑ _u : Fin (n + 1), (2 : ℕ) := by simp [Nat.mul_comm]
            _ ≤ ∑ u : Fin (n + 1), (d (E u.succ) - 1) :=
              Finset.sum_le_sum (fun u _ => hl u)
        rw [Fin.sum_univ_succ] at hE
        simp only [hzero] at hE
        omega
      obtain ⟨u, hu⟩ := hsecond
      let G : Fin (n + 2) ≃ Fin (n + 2) := Equiv.swap (0 : Fin (n + 1)).succ u.succ
      have hG0 : G 0 = 0 := Equiv.swap_apply_of_ne_of_ne
        (Ne.symm (Fin.succ_ne_zero _)) (Ne.symm (Fin.succ_ne_zero _))
      have hG1 : G (0 : Fin (n + 1)).succ = u.succ := by simp [G]
      let R : Fin n → ℕ := fun j => d (E (G j.succ.succ)) - 1
      have hRpos : ∀ j, 1 ≤ R j := by
        intro j
        have hj := hd (E (G j.succ.succ))
        dsimp [R]
        omega
      have hS : (∑ j, (d (E (G j)) - 1)) = 6 :=
        (G.sum_comp (fun j => d (E j) - 1)).trans hE
      have hR : (∑ j, R j) = 4 := by
        rw [Fin.sum_univ_succ, Fin.sum_univ_succ] at hS
        simp only [hG0, hG1, hzero, hu] at hS
        change 2 - 1 + (2 - 1 + (∑ j, R j)) = 6 at hS
        omega
      have hm : ∀ j, R j < 4 := by
        intro j
        have hj := rest_bound R 1 hRpos j
        omega
      have hdim : P14EightRowUPB.dimensions R = fun j => d (E (G j)) := by
        funext j
        refine Fin.cases ?_ (fun j => Fin.cases ?_ (fun j => ?_) j) j
        · simp [P14EightRowUPB.dimensions, hG0, hzero]
        · change 2 = d (E (G (0 : Fin (n + 1)).succ))
          rw [hG1, hu]
        · change d (E (G j.succ.succ)) - 1 + 1 = d (E (G j.succ.succ))
          have hj := hd (E (G j.succ.succ))
          omega
      have hc : Conclusion (n + 2) (fun j => d (E (G j))) := by
        rw [← hdim]
        exact P14EightRowUPB.canonical R hm hR
      have hcE : Conclusion (n + 2) (fun j => d (E j)) := by
        have h := reindex (fun j => d (E (G j))) G hc
        simpa only [G, Equiv.swap_apply_self] using h
      have hf := reindex (fun j => d (E j)) E hcE
      simpa only [E, Equiv.swap_apply_self] using hf

theorem multipartite {p : ℕ} (d : Fin p → ℕ) (hp : 3 ≤ p)
    (hd : ∀ j, 2 ≤ d j) (hsum : (∑ j, (d j - 1)) = 6) : Conclusion p d := by
  classical
  by_cases hq : ∃ j, d j = 2
  · exact with_qubit d hp hd hq hsum
  have hd3 : ∀ j, 3 ≤ d j := by
    intro j
    have hj := hd j
    have hn : d j ≠ 2 := fun he => hq ⟨j, he⟩
    omega
  have heq : ∀ j, d j = 3 := by
    intro j
    have hl : ∀ i, 2 ≤ d i - 1 := by intro i; have hi := hd3 i; omega
    have h := rest_bound (fun i => d i - 1) 2 hl j
    have hj := hd3 j
    omega
  exact P14AllOddCanonicalRegion.canonical d hd (fun j => by rw [heq j]; decide)

theorem three_qubits_one_ququart : Conclusion 4 ![2, 2, 2, 4] := by
  apply multipartite
  · omega
  · intro j
    fin_cases j <;> norm_num
  · norm_num [Fin.sum_univ_succ]

end P14EightRowFullCanonical

end
end

section

/-! Discharge the eight-row exception from the previous residual theorem.
Any still-unresolved admissible tuple is bipartite or has canonical ceiling
congruent to two modulo four. This is not the full conjecture. -/

namespace P14CanonicalResidualAfterEight
open P14CanonicalUPBTransport
open scoped BigOperators

theorem necessary_conditions {p : ℕ} (hp : 2 ≤ p) (d : Fin p → ℕ)
    (hd : ∀ j, 2 ≤ d j) (hbi : ¬ (p = 2 ∧ ∃ j, d j = 2))
    (hnot : ¬ Conclusion p d) :
    Even (∑ j, (d j - 1)) ∧ (∃ j, Even (d j)) ∧
      (p = 2 ∨ (2 + ∑ j, (d j - 1)) % 4 = 2) := by
  obtain ⟨hS, he, hr⟩ :=
    P14CanonicalResidualAfterDominance.necessary_conditions hp d hd hbi hnot
  refine ⟨hS, he, ?_⟩
  rcases hr with hp2 | hs6 | hmod
  · exact Or.inl hp2
  · by_cases hp2 : p = 2
    · exact Or.inl hp2
    · exact False.elim (hnot (P14EightRowFullCanonical.multipartite d (by omega) hd hs6))
  · exact Or.inr hmod

theorem divisible_four {p : ℕ} (hp : 3 ≤ p) (d : Fin p → ℕ)
    (hd : ∀ j, 2 ≤ d j) (hfour : (2 + ∑ j, (d j - 1)) % 4 = 0) :
    Conclusion p d := by
  by_contra hnot
  have hbi : ¬ (p = 2 ∧ ∃ j, d j = 2) := by rintro ⟨he, _⟩; omega
  obtain ⟨_, _, hr⟩ := necessary_conditions (by omega) d hd hbi hnot
  rcases hr with hp2 | hmod <;> omega

end P14CanonicalResidualAfterEight

end

section

/-! Integer pairs evaluated in the actual complex numbers using the nonnegative
real square root. The integer multiplication formula is proved compatible
with this evaluation; coefficients introduce no new axioms. -/

namespace P14QuadraticArithmetic
open scoped BigOperators

abbrev Coeff := Fin 2 → ℤ
noncomputable def root (q : ℕ) : ℂ := (Real.sqrt (q : ℝ) : ℂ)

theorem root_sq (q : ℕ) : root q ^ 2 = (q : ℂ) := by
  have h := Real.sq_sqrt (Nat.cast_nonneg q : (0 : ℝ) ≤ q)
  change (Real.sqrt (q : ℝ) : ℂ) ^ 2 = (q : ℂ)
  exact_mod_cast h

theorem star_root (q : ℕ) : star (root q) = root q := by
  simp [root]

noncomputable def eval (q : ℕ) (a : Coeff) : ℂ := a 0 + a 1 * root q
def constant (n : ℤ) : Coeff := ![n, 0]
def mul (q : ℕ) (a b : Coeff) : Coeff :=
  ![a 0 * b 0 + (q : ℤ) * a 1 * b 1, a 0 * b 1 + a 1 * b 0]

theorem eval_constant (q : ℕ) (n : ℤ) : eval q (constant n) = n := by
  simp [eval, constant]

theorem eval_mul (q : ℕ) (a b : Coeff) :
    eval q (mul q a b) = eval q a * eval q b := by
  simp only [eval, mul, Matrix.cons_val_zero, Matrix.cons_val_one]
  push_cast
  linear_combination -((a 1 : ℂ) * b 1) * root_sq q

theorem star_eval (q : ℕ) (a : Coeff) : star (eval q a) = eval q a := by
  simp [eval, star_root]

theorem eval_sum {ι : Type*} [Fintype ι] (q : ℕ) (a : ι → Coeff) :
    eval q (fun j => ∑ i, a i j) = ∑ i, eval q (a i) := by
  simp only [eval, Int.cast_sum, Finset.sum_add_distrib, Finset.sum_mul]

end P14QuadraticArithmetic

end

section

/-! An exact integer coefficient left-inverse certificate excludes a nonzero
complex annihilator. Complete (d+1)-subset coverage converts finitely many
certificates into an exceptional killing cap of d in any dimension. -/

namespace P14QuadraticFiniteCertificate
open P14QuadraticArithmetic
open scoped BigOperators

def dot {d : ℕ} (q : ℕ) (a b : Fin d → Coeff) : Coeff :=
  fun t => ∑ j, (mul q (a j) (b j)) t

theorem eval_dot {d : ℕ} (q : ℕ) (a b : Fin d → Coeff) :
    eval q (dot q a b) = ∑ j, eval q (a j) * eval q (b j) := by
  change eval q (fun t => ∑ j, (mul q (a j) (b j)) t) = _
  rw [eval_sum]
  simp only [eval_mul]

def Check {m d : ℕ} (q : ℕ) (rows : Fin m → Fin d → Coeff) (C : Fin d → Fin m)
    (B : Fin d → Fin d → Coeff) (N : ℤ) : Prop :=
  N ≠ 0 ∧ ∀ k j, dot q (B k) (fun r => rows (C r) j) =
    constant (if k = j then N else 0)

instance {m d : ℕ} (q : ℕ) (rows : Fin m → Fin d → Coeff) (C : Fin d → Fin m)
    (B : Fin d → Fin d → Coeff) (N : ℤ) : Decidable (Check q rows C B N) := by
  unfold Check
  infer_instance

theorem annihilator_zero {m d : ℕ} (q : ℕ) (rows : Fin m → Fin d → Coeff)
    (C : Fin d → Fin m) (B : Fin d → Fin d → Coeff) (N : ℤ)
    (hc : Check q rows C B N) (a : Fin d → ℂ)
    (ha : ∀ r, (∑ j, star (eval q (rows (C r) j)) * a j) = 0) : a = 0 := by
  have hn : (N : ℂ) ≠ 0 := by exact_mod_cast hc.1
  have he (k j : Fin d) :
      (∑ r, eval q (B k r) * star (eval q (rows (C r) j))) =
        if k = j then (N : ℂ) else 0 := by
    have h := congrArg (eval q) (hc.2 k j)
    simpa only [eval_dot, star_eval, eval_constant, Int.cast_ite, Int.cast_zero] using h
  funext k
  have hz : (N : ℂ) * a k = 0 := by
    calc
      (N : ℂ) * a k = ∑ j : Fin d, (if k = j then (N : ℂ) else 0) * a j := by simp
      _ = ∑ j : Fin d, (∑ r, eval q (B k r) * star (eval q (rows (C r) j))) * a j := by
        apply Finset.sum_congr rfl
        intro j _
        rw [he]
      _ = ∑ r : Fin d, eval q (B k r) * (∑ j, star (eval q (rows (C r) j)) * a j) := by
        simp only [Finset.sum_mul, Finset.mul_sum, mul_assoc]
        exact Finset.sum_comm
      _ = 0 := by simp only [ha, mul_zero, Finset.sum_const_zero]
  exact (mul_eq_zero.mp hz).resolve_left hn

def Covers {m n d : ℕ} (C : Fin n → Fin d → Fin m) (s : List (Fin m)) : Bool :=
  (List.finRange n).any (fun i => decide (∀ j, C i j ∈ s))

theorem killing_bound {m n d : ℕ} (q : ℕ) (rows : Fin m → Fin d → Coeff)
    (C : Fin n → Fin d → Fin m) (B : Fin n → Fin d → Fin d → Coeff)
    (N : Fin n → ℤ) (hcheck : ∀ i, Check q rows (C i) (B i) (N i))
    (hcover : ((List.finRange m).sublistsLen (d + 1)).all (Covers C) = true)
    (a : Fin d → ℂ) (ha : a ≠ 0) (S : Finset (Fin m))
    (hS : ∀ i ∈ S, (∑ j, star (eval q (rows i j)) * a j) = 0) : S.card ≤ d := by
  classical
  by_contra hlarge
  obtain ⟨T, hTS, hT⟩ := Finset.exists_subset_card_eq (by omega : d + 1 ≤ S.card)
  let s := (List.finRange m).filter (fun i => decide (i ∈ T))
  have hsub : s.Sublist (List.finRange m) := List.filter_sublist
  have hs : s.toFinset = T := by
    ext i
    simp only [s, List.mem_toFinset, List.mem_filter, List.mem_finRange,
      true_and, decide_eq_true_eq]
  have hlen : s.length = d + 1 := by
    rw [← List.toFinset_card_of_nodup (hsub.nodup (List.nodup_finRange m)), hs, hT]
  have hm : s ∈ (List.finRange m).sublistsLen (d + 1) := List.mem_sublistsLen.mpr ⟨hsub, hlen⟩
  have hc : Covers C s = true := (List.all_eq_true.mp hcover) s hm
  obtain ⟨i, _, hi⟩ := List.any_eq_true.mp hc
  have hij : ∀ j, C i j ∈ T := by
    intro j
    rw [← hs]
    exact List.mem_toFinset.mpr ((of_decide_eq_true hi) j)
  exact ha (annihilator_zero q rows (C i) (B i) (N i) (hcheck i) a
    (fun j => hS (C i j) (hTS (hij j))))

end P14QuadraticFiniteCertificate

end

section

/-! Actual ten-row frame over Q(sqrt(3)). Integer left-inverse products
and complete subset coverage use ordinary kernel decide. -/

namespace P14TenRowQuadraticFive
