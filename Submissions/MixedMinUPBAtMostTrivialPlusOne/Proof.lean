theorem row_ne_zero (i : Fin 10) : row i ≠ 0 := by
  have hc : rowsC i (pivot i) = constant (pivotValue i) := by fin_cases i <;> decide
  have hn : pivotValue i ≠ 0 := by fin_cases i <;> decide
  have he := congrArg (eval 2) hc
  rw [eval_constant] at he
  intro hz
  have hi : eval 2 (rowsC i (pivot i)) = 0 := congrFun hz (pivot i)
  rw [hi] at he
