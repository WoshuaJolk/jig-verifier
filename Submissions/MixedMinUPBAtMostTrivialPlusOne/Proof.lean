section

/-! One real specialization preserves all prescribed three-row determinants.
The finite-product argument is adapted from the existing owned
MultivariateRankAvoidance source. The conclusion keeps actual complex
coordinate rows; nonzero determinant premises must be proved by callers. -/

noncomputable section
namespace P14PolynomialThreeRows

open MvPolynomial Matrix Submodule
open scoped BigOperators

theorem exists_common_nonzero {σ T : Type*} [Fintype T]
    (Q : T → MvPolynomial σ ℝ) (hQ : ∀ t, Q t ≠ 0) :
    ∃ z : σ → ℝ, ∀ t, eval z (Q t) ≠ 0 := by
  classical
  let P : MvPolynomial σ ℝ := ∏ t, Q t
  have hP : P ≠ 0 := Finset.prod_ne_zero_iff.mpr (fun t _ => hQ t)
  have hz : ∃ z : σ → ℝ, eval z P ≠ 0 := by
    by_contra h
    push_neg at h
    apply hP
    apply MvPolynomial.funext
    intro z
    simpa only [map_zero] using h z
  obtain ⟨z, hz⟩ := hz
  have hprod : (∏ t, eval z (Q t)) ≠ 0 := by
    simpa only [P, map_prod] using hz
  exact ⟨z, fun t => Finset.prod_ne_zero_iff.mp hprod t (Finset.mem_univ t)⟩

def complexRow {σ : Type*} (p : Fin 3 → MvPolynomial σ ℝ) (z : σ → ℝ) :
    Fin 3 → ℂ := fun j => (eval z (p j) : ℂ)

theorem complex_det_ne_zero {σ : Type*}
    (p : Matrix (Fin 3) (Fin 3) (MvPolynomial σ ℝ)) (z : σ → ℝ)
    (h : eval z (Matrix.det p) ≠ 0) :
    Matrix.det (fun i => complexRow (p i) z) ≠ 0 := by
  have hr : ((eval z).mapMatrix p).det ≠ 0 := by
    rwa [← (eval z).map_det]
  have hc : (Complex.ofRealHom (((eval z).mapMatrix p).det)) ≠ 0 :=
    Complex.ofReal_ne_zero.mpr hr
  rw [Complex.ofRealHom.map_det] at hc
  exact hc

theorem complex_spanning_of_det (v : Matrix (Fin 3) (Fin 3) ℂ)
    (hv : Matrix.det v ≠ 0) : span ℂ (Set.range v) = ⊤ := by
  change span ℂ (Set.range (Matrix.row v)) = ⊤
  rw [← range_vecMulLinear]
  apply LinearMap.range_eq_top.mpr
  exact Matrix.vecMul_surjective_iff_isUnit.mpr
    ((Matrix.isUnit_iff_isUnit_det v).mpr (isUnit_iff_ne_zero.mpr hv))

theorem exists_complex_three_spanning {σ ι : Type*} [Fintype ι]
    (p : ι → Fin 3 → MvPolynomial σ ℝ)
    (hp : ∀ f : Fin 3 → ι, Function.Injective f →
      Matrix.det (fun i => p (f i)) ≠ 0) :
    ∃ z : σ → ℝ, ∀ S : Finset ι, S.card = 3 →
      span ℂ (Set.range (fun i : (S : Set ι) => complexRow (p i) z)) = ⊤ := by
  classical
  let T := {f : Fin 3 → ι // Function.Injective f}
  obtain ⟨z, hz⟩ := exists_common_nonzero
    (fun f : T => Matrix.det (fun i => p (f.val i))) (fun f => hp f.val f.property)
  refine ⟨z, ?_⟩
  intro S hS
  let e : Fin 3 ≃ (S : Set ι) :=
    (Fintype.equivFinOfCardEq (by simpa using hS)).symm
  let f : Fin 3 → ι := fun i => (e i).val
  have hf : Function.Injective f := by
    intro i j hij
    exact e.injective (Subtype.ext hij)
  have hd := complex_det_ne_zero (fun i => p (f i)) z (hz ⟨f, hf⟩)
  have hs := complex_spanning_of_det (fun i => complexRow (p (f i)) z) hd
  have hr : Set.range (fun i : Fin 3 => complexRow (p (f i)) z) =
      Set.range (fun i : (S : Set ι) => complexRow (p i) z) := by
    ext v
    constructor
    · rintro ⟨i, rfl⟩
      exact ⟨e i, rfl⟩
    · rintro ⟨i, rfl⟩
      obtain ⟨j, rfl⟩ := e.surjective i
      exact ⟨j, rfl⟩
  rwa [hr] at hs


end P14PolynomialThreeRows
end
end

