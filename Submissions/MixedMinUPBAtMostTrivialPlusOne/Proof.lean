section

/-! Translate Fourier nonresonance into the literal dimensions.
Only the even bipartite family (d,3d-8), d at least six, remains.
This is a necessary condition for a hypothetical failure, not a
counterexample or a proof of that remaining family. -/

noncomputable section
open scoped BigOperators
namespace P14BipartiteResonanceReduction
open P14CanonicalUPBTransport

theorem strict_pair (D d : ℕ) (hd : 4 ≤ d) (hlt : d < D)
    (hD : Even D) (he : Even d) (hnr : D+8 ≠ 3*d) :
    Conclusion 2 ![D,d] := by
  let q := (D+d)/2
  let m := d-1
  obtain ⟨a,ha⟩ := hD
  obtain ⟨b,hb⟩ := he
  have hsum : 2*q=D+d := by dsimp [q]; omega
  have hm : 3 ≤ m := by dsimp [m]; omega
  have hq : m+1 < q := by dsimp [q,m]; omega
  have hn : ¬q ∣ (m-1)*2 := by
    intro h
    have hh : (m-1)*2=q := Nat.eq_of_dvd_of_lt_two_mul (by omega) h (by omega)
    apply hnr
    dsimp [m] at hh
    omega
  have hc := P14NonresonantBipartite.canonical hm hq hn
  have hdim : P14BipartiteFrameCover.dimensions q m=(![D,d] : Fin 2 → ℕ) := by
    funext j
    fin_cases j
    · change 2*q-m-1=D
      dsimp [m]
      omega
    · change m+1=d
      dsimp [m]
      omega
  rwa [hdim] at hc

theorem ordered_pair (D d : ℕ) (hd : 4 ≤ d) (hle : d ≤ D)
    (hD : Even D) (he : Even d) (hnr : D+8 ≠ 3*d) :
    Conclusion 2 ![D,d] := by
  by_cases hh : d=D
  · subst D
    have hc := P14BalancedDimensionRecognition.equal_bipartite d hd
    have hv : (fun _ : Fin 2 => d)=(![d,d] : Fin 2 → ℕ) := by funext j; fin_cases j <;> rfl
    rwa [hv] at hc
  · exact strict_pair D d hd (by omega) hD he hnr

theorem residual {p : ℕ} (d : Fin p → ℕ) (hd : Admissible p d)
    (hnot : ¬ Conclusion p d) :
    p=2 ∧ ∃ a b : Fin p, a ≠ b ∧ 6 ≤ d a ∧ Even (d a) ∧ d b+8=3*d a := by
  obtain ⟨hp,hlo⟩ := P14GeneralMultipartiteCanonical.residual_bipartite d hd hnot
  subst p
  obtain ⟨hs,he,_⟩ := P14CanonicalResidualAfterEight.necessary_conditions hd.1 d hd.2.1 hd.2.2.1 hnot
  have heSum : Even (d 0+d 1) := by
    obtain ⟨k,hk⟩ := hs
    simp only [Fin.sum_univ_two] at hk
    have h0 := hlo 0
    have h1 := hlo 1
    exact ⟨k+1,by omega⟩
  have heach : Even (d 0) ∧ Even (d 1) := by
    obtain ⟨j,hj⟩ := he
    fin_cases j
    · exact ⟨hj,(Nat.even_add.mp heSum).mp hj⟩
    · exact ⟨(Nat.even_add.mp heSum).mpr hj,hj⟩
  have h0 : 4 ≤ d 0 := by obtain ⟨k,hk⟩ := heach.1; have := hlo 0; omega
  have h1 : 4 ≤ d 1 := by obtain ⟨k,hk⟩ := heach.2; have := hlo 1; omega
  have hv : d=(![d 0,d 1] : Fin 2 → ℕ) := by funext j; fin_cases j <;> rfl
  have neq : d 0 ≠ d 1 := by
    intro h
    have hc := P14BalancedDimensionRecognition.equal_bipartite (d 0) h0
    have hh : d=(fun _ : Fin 2 => d 0) := by funext j; fin_cases j; rfl; exact h.symm
    apply hnot
    rwa [hh]
  refine ⟨rfl,?_⟩
  by_cases hle : d 1 ≤ d 0
  · have hr : d 0+8=3*d 1 := by
      by_contra hn
      have hc := ordered_pair (d 0) (d 1) h1 hle heach.1 heach.2 hn
      exact hnot (hv ▸ hc)
    refine ⟨1,0,by decide,?_,heach.2,hr⟩
    obtain ⟨k,hk⟩ := heach.2
    omega
  · have hr : d 1+8=3*d 0 := by
      by_contra hn
      have hc := ordered_pair (d 1) (d 0) h0 (by omega) heach.2 heach.1 hn
      apply hnot
      apply P14CanonicalUPBTransport.of_dimensions (![d 1,d 0]) d (Equiv.swap 0 1)
      · intro j
        fin_cases j <;> simp
      · exact hc
    refine ⟨0,1,by decide,?_,heach.1,hr⟩
    obtain ⟨k,hk⟩ := heach.1
    omega

end P14BipartiteResonanceReduction
end
end

section

/-! Close the final even bipartite resonance family and combine it with
the exhaustive corrected-domain reduction. The final theorem states the
literal mixed-dimensional root conclusion, without importing its sorry. -/

noncomputable section
open scoped BigOperators
namespace P14MixedCanonicalFull
open P14CanonicalUPBTransport

theorem resonant_pair (D d : ℕ) (hd : 6 ≤ d) (he : Even d)
    (hres : D+8=3*d) : Conclusion 2 ![D,d] := by
  let q := 2*(d-2)
  let m := d-1
  have hm : 5 ≤ m := by dsimp [m]; omega
  have hq : m+1 < q := by dsimp [m,q]; omega
  have hodd : Odd m := by
    obtain ⟨k,hk⟩ := he
    exact ⟨k-1,by dsimp [m]; omega⟩
  have hr : q=2*(m-1) := by dsimp [q,m]; omega
  have hc := P14ResonantBipartite.canonical hm hq hodd hr
  have hdim : P14BipartiteFrameCover.dimensions q m=(![D,d] : Fin 2 → ℕ) := by
    funext j
    fin_cases j
    · change 2*q-m-1=D
      dsimp [q,m]
      omega
    · change m+1=d
      dsimp [m]
      omega
  rwa [hdim] at hc

theorem full {p : ℕ} (d : Fin p → ℕ) (hd : Admissible p d) :
    Conclusion p d := by
  classical
  by_contra hn
  obtain ⟨hp,a,b,hab,ha,he,hr⟩ := P14BipartiteResonanceReduction.residual d hd hn
  subst p
  fin_cases a <;> fin_cases b
  · exact hab rfl
  · have hc := resonant_pair (d 1) (d 0) ha he hr
    apply hn
    apply P14CanonicalUPBTransport.of_dimensions (![d 1,d 0]) d (Equiv.swap 0 1)
    · intro j
      fin_cases j <;> simp
    · exact hc
  · have hc := resonant_pair (d 0) (d 1) ha he hr
    have hv : d=(![d 0,d 1] : Fin 2 → ℕ) := by
      funext j
      fin_cases j <;> rfl
    apply hn
    rwa [hv]
  · exact hab rfl

theorem canonical :
  ∀ p : ℕ, 2 ≤ p → ∀ d : Fin p → ℕ, (∀ j, 2 ≤ d j) →
    ¬ (p = 2 ∧ ∃ j, d j = 2) →
    ¬ (∀ j, d j = 2) →
    ∃ m : ℕ, m ≤ 2 + ∑ j, (d j - 1) ∧
      ∃ v : Fin m → (j : Fin p) → Fin (d j) → ℂ,
        (∀ i j, v i j ≠ 0) ∧
        (∀ i i', i ≠ i' →
          ∃ j, (∑ r, star (v i j r) * v i' j r) = 0) ∧
        (∀ a : (j : Fin p) → Fin (d j) → ℂ,
          (∀ j, a j ≠ 0) →
          ∃ i, ∀ j, (∑ r, star (v i j r) * a j r) ≠ 0) := by
  intro p hp d hd hnot2 hnotall
  exact full d ⟨hp,hd,hnot2,hnotall⟩

end P14MixedCanonicalFull

end
end

namespace Submissions.MixedMinUPBAtMostTrivialPlusOne.Proof
open scoped BigOperators

theorem proof :
  ∀ p : ℕ, 2 ≤ p → ∀ d : Fin p → ℕ, (∀ j, 2 ≤ d j) →
    ¬ (p = 2 ∧ ∃ j, d j = 2) →
    ¬ (∀ j, d j = 2) →
    ∃ m : ℕ, m ≤ 2 + ∑ j, (d j - 1) ∧
      ∃ v : Fin m → (j : Fin p) → Fin (d j) → ℂ,
        (∀ i j, v i j ≠ 0) ∧
        (∀ i i', i ≠ i' →
          ∃ j, (∑ r, star (v i j r) * v i' j r) = 0) ∧
        (∀ a : (j : Fin p) → Fin (d j) → ℂ,
          (∀ j, a j ≠ 0) →
          ∃ i, ∀ j, (∑ r, star (v i j r) * a j r) ≠ 0) := by
  exact P14MixedCanonicalFull.canonical

end Submissions.MixedMinUPBAtMostTrivialPlusOne.Proof
