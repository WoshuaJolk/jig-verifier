/-! Actual spectral norm identities and every two-layer selection follow
under the precise nonresonance condition, without requiring odd q. -/

noncomputable section
open Filter
open scoped Topology
namespace P14NonresonantSpectralSelections
open Polynomial P14FourierWeightWindow P14FourierSpectralWeights
open P14TwoLayerPartition P14TwoLayerSelectionRows

theorem fourier_path {T : Type*} [Fintype T] {q m : ℕ} (hm : 3 ≤ m) (hq : m+1 < q)
    (hnr : ¬ q ∣ (m-1)*2) (a b : T → ℕ) (hb : ∀ t, 1 ≤ b t) (hcount : ∀ t, a t+b t=m)
    (X : ∀ t, Fin (a t) → ℂ) (Y : ∀ t, Fin (b t) → ℂ)
    (hX : ∀ t, Function.Injective (X t)) (hY : ∀ t, Function.Injective (Y t))
    (hYn : ∀ t j, Y t j ≠ 0) (hsub : ∀ t j, ∃ i, X t i=Y t j) :
    ∃ (B : ℂ[X]) (R : ℝ → ℂ[X]), B.natDegree ≤ m-1 ∧ (B.coeff 0).im=0 ∧
      R 0=B ∧ (∀ e, (R e).natDegree ≤ m-1) ∧
      (∀ z : ℂ, Tendsto (fun e => (R e).eval z) (𝓝 0) (𝓝 (B.eval z))) ∧
      (∀ t, LinearIndependent ℂ (Sum.elim
        (fun i => fun k : Fin (m+1) => X t i^k.val)
        (fun j k => B.eval (sample q m k)*Y t j^k.val))) ∧
      ∀ᶠ (e : ℝ) in 𝓝 (0:ℝ), 0 < e →
        (∀ k : Fin (m+1), Complex.normSq (1+(e:ℂ)*(R e).eval (sample q m k))=1) ∧
        (∀ k : Fin q, m < k.val → Complex.normSq (1+(e:ℂ)*(R e).eval (fourierRoot q^k.val)) < 1) := by
  obtain ⟨B,hB,hconstant,hzero,hnegative,hLI⟩ :=
    P14NonresonantFourierJets.common hm hq hnr a b hb hcount X Y hX hY hYn hsub
  obtain ⟨R,hR,hdegree,hlim,hfactor⟩ := P14GeneralSpectralFactor.exists_path B hB
  refine ⟨B,R,hB,hconstant,hR,hdegree,hlim,hLI,?_⟩
  have hunit (k : ℕ) : Complex.normSq (fourierRoot q^k)=1 := by
    rw [P14QuadraticFourierTarget.root_power,P14QuadraticFourierTarget.phase_normSq]
  filter_upwards [hfactor] with e he
  intro hepos
  constructor
  · intro k
    rw [he (sample q m k) (by exact hunit k.val),hzero k]
    ring
  · intro k hk
    rw [he _ (hunit k.val)]
    have hneg : 2*e*(B.eval (fourierRoot q^k.val)).re < 0 :=
      mul_neg_of_pos_of_neg (mul_pos (by norm_num) hepos) (hnegative k hk)
    linarith

theorem collision_path {T : Type*} [Fintype T] {q m : ℕ} (hm : 3 ≤ m) (hq : m+1 < q)
    (hnr : ¬ q ∣ (m-1)*2) (a b : T → ℕ) (hb : ∀ t, 1 ≤ b t) (hcount : ∀ t, a t+b t=m)
    (X : ∀ t, Fin (a t) → ℂ) (Y : ∀ t, Fin (b t) → ℂ) (flag : ∀ t, Fin (a t) → Bool)
    (hX : ∀ t, Function.Injective (X t)) (hY : ∀ t, Function.Injective (Y t))
    (hYn : ∀ t j, Y t j ≠ 0) (hsub : ∀ t j, ∃ i, X t i=Y t j ∧ flag t i=false) :
    ∃ R : ℝ → ℂ[X], (∀ e, (R e).natDegree ≤ m-1) ∧
      (∀ z : ℂ, ContinuousAt (fun e => (R e).eval z) 0) ∧
      ∀ᶠ (e : ℝ) in 𝓝 0, 0 < e →
        (∀ k : Fin (m+1), Complex.normSq (1+(e:ℂ)*(R e).eval (sample q m k))=1) ∧
        (∀ k : Fin q, m < k.val → Complex.normSq (1+(e:ℂ)*(R e).eval (fourierRoot q^k.val)) < 1) ∧
        ∀ t, LinearIndependent ℂ (P14CollisionRowDeformation.actual e
          (fun k : Fin (m+1) => (R e).eval (sample q m k)) (X t) (Y t) (flag t)) := by
  obtain ⟨B,R,_,_,hR,hdegree,hlim,hLI,hnorm⟩ := fourier_path
    hm hq hnr a b hb hcount X Y hX hY hYn (fun t j => by
      obtain ⟨i,hi,_⟩ := hsub t j
      exact ⟨i,hi⟩)
  have hrank : ∀ᶠ (e : ℝ) in 𝓝 0, ∀ t, e ≠ 0 →
      LinearIndependent ℂ (P14CollisionRowDeformation.actual e
        (fun k : Fin (m+1) => (R e).eval (sample q m k)) (X t) (Y t) (flag t)) := by
    apply Filter.eventually_all.mpr
    intro t
    exact P14CollisionRowDeformation.eventually_actual
      (fun e k => (R e).eval (sample q m k)) (fun k => B.eval (sample q m k))
      (fun k => hlim (sample q m k)) (X t) (Y t) (flag t) (hsub t) (hLI t)
  refine ⟨R,hdegree,?_,?_⟩
  · intro z
    change Tendsto (fun e => (R e).eval z) (𝓝 0) (𝓝 ((R 0).eval z))
    rw [hR]
    exact hlim z
  · filter_upwards [hnorm,hrank] with e he hr
    intro hepos
    exact ⟨(he hepos).1,(he hepos).2,fun t => hr t (ne_of_gt hepos)⟩

theorem path {ι : Type*} [Fintype ι] {q m : ℕ} (hm : 3 ≤ m) (hq : m+1 < q)
    (hnr : ¬ q ∣ (m-1)*2) (Z : ι → ℂ) (hZ : Function.Injective Z) (hZn : ∀ i, Z i ≠ 0) :
    ∃ R : ℝ → ℂ[X], (∀ e, (R e).natDegree ≤ m-1) ∧
      (∀ z : ℂ, ContinuousAt (fun e => (R e).eval z) 0) ∧
      ∀ᶠ (e : ℝ) in 𝓝 0, 0 < e →
        (∀ k : Fin (m+1), Complex.normSq (1+(e:ℂ)*(R e).eval (sample q m k))=1) ∧
        (∀ k : Fin q, m < k.val → Complex.normSq (1+(e:ℂ)*(R e).eval (fourierRoot q^k.val)) < 1) ∧
        ∀ f : Fin m → ι ⊕ ι, Function.Injective f →
          LinearIndependent ℂ (fun i => model e
            (fun k : Fin (m+1) => (R e).eval (sample q m k)) Z (f i)) := by
  classical
  let T := {f : Fin m → ι ⊕ ι // Function.Injective f ∧ ∃ i, Extra f i}
  letI : Fintype T := Fintype.ofFinite _
  have hb (t : T) : 1 ≤ b t.val := by
    obtain ⟨i,hi⟩ := t.property.2
    exact Fintype.card_pos_iff.mpr ⟨⟨i,hi⟩⟩
  obtain ⟨R,hdegree,hcont,hevent⟩ := collision_path hm hq hnr
    (fun t : T => a t.val) (fun t : T => b t.val) hb (fun t => card_split t.val)
    (fun t => baseNode t.val Z) (fun t => overNode t.val Z) (fun t => baseFlag t.val)
    (fun t => (nodes t.val t.property.1 Z hZ).1)
    (fun t => (nodes t.val t.property.1 Z hZ).2)
    (fun t j => hZn _) (fun t j => overlap_representative t.val Z j)
  have hz : ∀ᶠ (e : ℝ) in 𝓝 0, ∀ f : Fin m → ι ⊕ ι,
      Function.Injective f → (¬∃ i, Extra f i) →
      LinearIndependent ℂ (fun i => model e
        (fun k : Fin (m+1) => (R e).eval (sample q m k)) Z (f i)) := by
    apply Filter.eventually_all.mpr
    intro f
    by_cases h : Function.Injective f ∧ ¬∃ i, Extra f i
    · have hn : ∀ i, ¬Extra f i := fun i hi => h.2 ⟨i,hi⟩
      have hp := P14DistinctNodeDeformation.eventually_rows Z f
        (hZ.comp (no_overlap_node_injective f h.1 hn))
        (fun e k => (R e).eval (sample q m k)) (fun k => hcont (sample q m k))
      filter_upwards [hp] with e he
      exact fun _ _ => he
    · exact Filter.Eventually.of_forall (fun _ hf hn => False.elim (h ⟨hf,hn⟩))
  refine ⟨R,hdegree,hcont,?_⟩
  filter_upwards [hevent,hz] with e he hzero
  intro hepos
  obtain ⟨hret,htail,hrank⟩ := he hepos
  refine ⟨hret,htail,?_⟩
  intro f hf
  by_cases hx : ∃ i, Extra f i
  · have hh := hrank (⟨f,hf,hx⟩ : T)
    exact independent f Z e (fun k => (R e).eval (sample q m k)) hh
  · exact hzero f hf hx

theorem exists_parameter {ι : Type*} [Fintype ι] {q m : ℕ} (hm : 3 ≤ m) (hq : m+1 < q)
    (hnr : ¬ q ∣ (m-1)*2) (Z : ι → ℂ) (hZ : Function.Injective Z) (hZn : ∀ i, Z i ≠ 0) :
    ∃ (e : ℝ) (P : ℂ[X]), 0 < e ∧ P.natDegree ≤ m-1 ∧
      (∀ k : Fin (m+1), Complex.normSq (1+(e:ℂ)*P.eval (sample q m k))=1) ∧
      (∀ k : Fin q, m < k.val → Complex.normSq (1+(e:ℂ)*P.eval (fourierRoot q^k.val)) < 1) ∧
      ∀ f : Fin m → ι ⊕ ι, Function.Injective f →
        LinearIndependent ℂ (fun i => model e (fun k : Fin (m+1) => P.eval (sample q m k)) Z (f i)) := by
  obtain ⟨R,hdegree,_,hevent⟩ := path hm hq hnr Z hZ hZn
  have hpos : ∀ᶠ (e : ℝ) in 𝓝[>] 0, 0 < e := self_mem_nhdsWithin
  have hgood := hevent.filter_mono (nhdsWithin_le_nhds : 𝓝[>] (0:ℝ) ≤ 𝓝 0)
  obtain ⟨e,he,hepos⟩ := (hgood.and hpos).exists
  exact ⟨e,R e,hepos,hdegree e,he hepos⟩

end P14NonresonantSpectralSelections
end
end

section

/-! The actual general frame and the literal bipartite canonical result
under the exact nonresonance condition. -/

noncomputable section
open Matrix Submodule
open scoped BigOperators
namespace P14NonresonantBipartite
open Polynomial P14FourierSpectralWeights P14FourierWeightWindow
open P14GeneralPhysicalFrame P14GeneralFrameSpanning P14UnitaryDefectGram
open P14GeneralFrameCrossSupport P14ComplexLocalCover P14GeneralFrameLocalFactor

theorem data {q m : ℕ} (hm : 3 ≤ m) (hq : m+1 < q) (hnr : ¬ q ∣ (m-1)*2) :
    ∃ (e : ℝ) (P : ℂ[X]), 0 < e ∧ P.natDegree ≤ m-1 ∧
      (∀ k : Fin (m+1), Complex.normSq (1+(e:ℂ)*P.eval (sample q m k))=1) ∧
      (∀ k : Fin q, m < k.val → Complex.normSq (spectral q e P k) < 1) ∧
      ∀ f : Fin m → Fin q ⊕ Fin q, Function.Injective f →
        LinearIndependent ℂ (fun i => P14TwoLayerSelectionRows.model e
          (fun k : Fin (m+1) => P.eval (sample q m k)) (P14CubicGridBranch.node q) (f i)) := by
  apply P14NonresonantSpectralSelections.exists_parameter hm hq hnr
    (P14CubicGridBranch.node q) (P14CubicGridBranch.node_injective (by omega))
  intro i
  exact pow_ne_zero _ ((fourierRoot_isPrimitiveRoot q (by omega)).ne_zero (by omega))

theorem spanning_frame {q m : ℕ} (hm : 3 ≤ m) (hq : m+1 < q) (hnr : ¬ q ∣ (m-1)*2) :
    ∃ (e : ℝ) (P : ℂ[X]), 0 < e ∧ P.natDegree ≤ m-1 ∧
      (∀ k : Fin (m+1), Complex.normSq (1+(e:ℂ)*P.eval (sample q m k))=1) ∧
      (∀ k : Fin q, m < k.val → Complex.normSq (spectral q e P k) < 1) ∧
      ∀ S : Finset (Fin q ⊕ Fin q), S.card=2*q-m →
        span ℂ (Set.range (fun i : S => fun k => matrix q m e P k i.val))=⊤ := by
  obtain ⟨e,P,he,hP,hr,hd,ht⟩ := data hm hq hnr
  exact ⟨e,P,he,hP,hr,hd,every_plus_one (by omega) e P hd ht⟩

theorem factor {q m : ℕ} (hm : 3 ≤ m) (hq : m+1 < q) (hnr : ¬ q ∣ (m-1)*2) :
    HasLocalFactor (Fin q ⊕ Fin q) (2*q-m-1) (2*q-m-1) (Prescribed m) := by
  obtain ⟨e,P,_,hP,hr,hd,hs⟩ := spanning_frame hm hq hnr
  let E := coordinateEquiv (show m+1 ≤ q by omega)
  let C : ((Fin q ⊕ tail q m) → ℂ) ≃ₗ[ℂ] (Fin (2*q-m-1) → ℂ) :=
    LinearEquiv.piCongrLeft' ℂ (fun _ : Fin q ⊕ tail q m => ℂ) E
  let A := matrix q m e P
  refine ⟨fun i => C (fun k => A k i),?_,?_,?_⟩
  · intro i hi
    exact columns_nonzero (by omega) hr hd i (C.map_eq_zero_iff.mp hi)
  · intro S hS
    have hc : S.card=2*q-m := by omega
    have hh := congrArg (Submodule.map C.toLinearMap) (hs S hc)
    simpa [Submodule.map_span,←Set.range_comp,Function.comp_def,
      Submodule.map_top,LinearMap.range_eq_top.mpr C.surjective,A] using hh
  · intro i j hij
    have hp : pair A i j=0 := by
      cases i with
      | inl i =>
        cases j with
        | inl j => exact (base_orthonormal (by omega) e P i j).trans (if_neg hij)
        | inr j => exact cross_zero (by omega) (by omega) e P hP i j hij
      | inr i =>
        cases j with
        | inl j =>
          rw [pair_reverse]
          change star (pair (matrix q m e P) (Sum.inl j) (Sum.inr i))=0
          rw [cross_zero (by omega) (by omega) e P hP j i hij,star_zero]
        | inr j => exact (spectral_orthonormal (by omega) hr hd i j).trans (if_neg hij)
    change (∑ k,star (A (E.symm k) i)*A (E.symm k) j)=0
    exact (E.symm.sum_comp (fun k => star (A k i)*A k j)).trans hp

theorem canonical {q m : ℕ} (hm : 3 ≤ m) (hq : m+1 < q)
    (hnr : ¬ q ∣ (m-1)*2) :
    P14CanonicalUPBTransport.Conclusion 2 (P14BipartiteFrameCover.dimensions q m) :=
  P14BipartiteFrameCover.canonical_of_factor hq (factor hm hq hnr)

end P14NonresonantBipartite
end
end

section

/-! Explicit qubit vectors for any perfect matching on `Fin m`.
The integer determinant/elimination argument is adapted from the verified
Jig p14 `MinUPB2244/Circulant.lean` construction, now uniformly in the matching.
-/

namespace P14QubitMatching

noncomputable section

def vectorsZ {m : ℕ} (F : Fin m → Fin m) (i : Fin m) : Fin 2 → ℤ :=
  if i < F i then ![1, (i.val : ℤ) + 1]
  else ![-((F i).val : ℤ) - 1, 1]

def vectors {m : ℕ} (F : Fin m → Fin m) (i : Fin m) :
    EuclideanSpace ℂ (Fin 2) :=
  WithLp.toLp 2 (fun r => (vectorsZ F i r : ℂ))

def det2Z (x y : Fin 2 → ℤ) : ℤ := x 0 * y 1 - x 1 * y 0

lemma nonzero {m : ℕ} (F : Fin m → Fin m) (i : Fin m) : vectors F i ≠ 0 := by
  intro h
  by_cases hi : i < F i
  · have h0 := congrArg (fun v : EuclideanSpace ℂ (Fin 2) => v 0) h
    simp [vectors, vectorsZ, hi] at h0
  · have h1 := congrArg (fun v : EuclideanSpace ℂ (Fin 2) => v 1) h
    simp [vectors, vectorsZ, hi] at h1

lemma matching_dotZ {m : ℕ} (F : Fin m → Fin m)
    (hF : Function.Involutive F) (hfix : ∀ i, F i ≠ i) (i : Fin m) :
    vectorsZ F i 0 * vectorsZ F (F i) 0 +
      vectorsZ F i 1 * vectorsZ F (F i) 1 = 0 := by
  by_cases hi : i < F i
  · have hj : ¬ F i < i := not_lt_of_gt hi
    simp [vectorsZ, hi, hj, hF i]
  · have hj : F i < i := lt_of_le_of_ne (le_of_not_gt hi) (hfix i)
    simp [vectorsZ, hi, hj, hF i]

lemma matching_orthogonal {m : ℕ} (F : Fin m → Fin m)
    (hF : Function.Involutive F) (hfix : ∀ i, F i ≠ i) (i : Fin m) :
    inner ℂ (vectors F i) (vectors F (F i)) = 0 := by
  have h := matching_dotZ F hF hfix i
  have hc : (vectorsZ F i 0 : ℂ) * (vectorsZ F (F i) 0 : ℂ) +
      (vectorsZ F i 1 : ℂ) * (vectorsZ F (F i) 1 : ℂ) = 0 := by
    exact_mod_cast h
  simpa [vectors, PiLp.inner_apply, Fin.sum_univ_two,
    RCLike.inner_apply, star_intCast, mul_comm] using hc

lemma determinant_ne_zero {m : ℕ} (F : Fin m → Fin m)
    (hF : Function.Injective F) {i j : Fin m} (hij : i ≠ j) :
    det2Z (vectorsZ F i) (vectorsZ F j) ≠ 0 := by
  have hv : (i.val : ℤ) ≠ (j.val : ℤ) := by
    intro h
    apply hij
    apply Fin.ext
    exact_mod_cast h
  have hw : ((F i).val : ℤ) ≠ ((F j).val : ℤ) := by
    intro h
    apply hij
    apply hF
    apply Fin.ext
    exact_mod_cast h
  by_cases hi : i < F i <;> by_cases hj : j < F j
  · simp [vectorsZ, det2Z, hi, hj]
    omega
  · have hp : 0 ≤ (i.val : ℤ) * (F j).val := mul_nonneg (by positivity) (by positivity)
    simp only [vectorsZ, hi, hj, if_true, if_false, Matrix.cons_val_zero,
      Matrix.cons_val_one, Matrix.cons_val_fin_one, det2Z]
    nlinarith
  · have hp : 0 ≤ ((F i).val : ℤ) * j.val := mul_nonneg (by positivity) (by positivity)
    simp only [vectorsZ, hi, hj, if_true, if_false, Matrix.cons_val_zero,
      Matrix.cons_val_one, Matrix.cons_val_fin_one, det2Z]
    nlinarith
  · simp [vectorsZ, det2Z, hi, hj]
    omega

lemma determinant_complex_ne_zero {m : ℕ} (F : Fin m → Fin m)
    (hF : Function.Injective F) {i j : Fin m} (hij : i ≠ j) :
    vectors F i 0 * vectors F j 1 - vectors F i 1 * vectors F j 0 ≠ 0 := by
  have h := determinant_ne_zero F hF hij
  change (vectorsZ F i 0 : ℂ) * (vectorsZ F j 1 : ℂ) -
    (vectorsZ F i 1 : ℂ) * (vectorsZ F j 0 : ℂ) ≠ 0
  exact_mod_cast h

lemma pair_independent {m : ℕ} (F : Fin m → Fin m)
    (hF : Function.Injective F) {i j : Fin m} (hij : i ≠ j) :
    LinearIndependent ℂ ![vectors F i, vectors F j] := by
  rw [linearIndependent_fin2]
  refine ⟨nonzero F j, ?_⟩
  intro c hc
  have h0 := congrArg (fun v : EuclideanSpace ℂ (Fin 2) => v 0) hc
  have h1 := congrArg (fun v : EuclideanSpace ℂ (Fin 2) => v 1) hc
  change c * vectors F j 0 = vectors F i 0 at h0
  change c * vectors F j 1 = vectors F i 1 at h1
  apply determinant_complex_ne_zero F hF hij
  rw [← h0, ← h1]
  ring

lemma exact_independent {m : ℕ} (F : Fin m → Fin m)
    (hF : Function.Injective F) (f : Fin 2 → Fin m) (hf : Function.Injective f) :
    LinearIndependent ℂ (fun q => vectors F (f q)) := by
  have h := pair_independent F hF (hf.ne (by decide : (0 : Fin 2) ≠ 1))
  convert h using 1
  ext q
  fin_cases q <;> rfl

/-- The exact finite-set spanning interface used by `P14UPBAssembly.SpansEvery`. -/
lemma spans_every_two {m : ℕ} (F : Fin m → Fin m)
    (hF : Function.Injective F) (S : Finset (Fin m)) (hS : S.card = 2) :
    Submodule.span ℂ (Set.range fun i : (S : Set (Fin m)) => vectors F i.1) = ⊤ := by
  let e : (S : Set (Fin m)) ≃ Fin 2 := Fintype.equivFinOfCardEq (by simpa using hS)
  let f : Fin 2 → Fin m := fun q => (e.symm q).val
  have hf : Function.Injective f := Subtype.val_injective.comp e.symm.injective
  have hli := (exact_independent F hF f hf).comp e e.injective
  have hs : LinearIndependent ℂ (fun i : (S : Set (Fin m)) => vectors F i.1) := by
    simpa [f, Function.comp_def] using hli
  apply hs.span_eq_top_of_card_eq_finrank'
  simpa [finrank_euclideanSpace_fin] using hS

lemma killed_pair_zero {m : ℕ} (F : Fin m → Fin m)
    (hF : Function.Injective F) {i j : Fin m} (hij : i ≠ j)
    {a : EuclideanSpace ℂ (Fin 2)}
    (hi : inner ℂ (vectors F i) a = 0)
    (hj : inner ℂ (vectors F j) a = 0) : a = 0 := by
  have h0 : vectors F i 0 * a 0 + vectors F i 1 * a 1 = 0 := by
    simpa [vectors, PiLp.inner_apply, Fin.sum_univ_two,
      RCLike.inner_apply, star_intCast, mul_comm] using hi
  have h1 : vectors F j 0 * a 0 + vectors F j 1 * a 1 = 0 := by
    simpa [vectors, PiLp.inner_apply, Fin.sum_univ_two,
      RCLike.inner_apply, star_intCast, mul_comm] using hj
  have hd := determinant_complex_ne_zero F hF hij
  ext r
  fin_cases r
  · apply (mul_eq_zero.mp ?_).resolve_left hd
    calc
      (vectors F i 0 * vectors F j 1 - vectors F i 1 * vectors F j 0) * a 0 =
          vectors F j 1 * (vectors F i 0 * a 0 + vectors F i 1 * a 1) -
            vectors F i 1 * (vectors F j 0 * a 0 + vectors F j 1 * a 1) := by ring
      _ = 0 := by rw [h0, h1]; ring
  · apply (mul_eq_zero.mp ?_).resolve_left hd
    calc
      (vectors F i 0 * vectors F j 1 - vectors F i 1 * vectors F j 0) * a 1 =
          vectors F i 0 * (vectors F j 0 * a 0 + vectors F j 1 * a 1) -
            vectors F j 0 * (vectors F i 0 * a 0 + vectors F i 1 * a 1) := by ring
      _ = 0 := by rw [h0, h1]; ring

lemma killing_bound {m : ℕ} (F : Fin m → Fin m)
    (hF : Function.Injective F) {a : EuclideanSpace ℂ (Fin 2)} (ha : a ≠ 0)
    (S : Finset (Fin m)) (hS : ∀ i ∈ S, inner ℂ (vectors F i) a = 0) :
    S.card ≤ 1 := by
  rw [Finset.card_le_one]
  intro i hi j hj
  by_contra hij
  exact ha (killed_pair_zero F hF hij (hS i hi) (hS j hj))

/-- Uniform qubit realization with the properties used in the UPB assembly. -/
theorem realization {m : ℕ} (F : Fin m → Fin m)
    (hF : Function.Involutive F) (hfix : ∀ i, F i ≠ i) :
    ∃ z : Fin m → EuclideanSpace ℂ (Fin 2),
      (∀ i, z i ≠ 0) ∧
      (∀ i, inner ℂ (z i) (z (F i)) = 0) ∧
      (∀ i j, i ≠ j → LinearIndependent ℂ ![z i, z j]) ∧
      (∀ a, a ≠ 0 → ∀ S : Finset (Fin m),
        (∀ i ∈ S, inner ℂ (z i) a = 0) → S.card ≤ 1) := by
  exact ⟨vectors F, nonzero F, matching_orthogonal F hF hfix,
    fun _ _ h => pair_independent F hF.injective h,
    fun _ h S hS => killing_bound F hF.injective h S hS⟩

end

end P14QubitMatching
end

section

/-! The existing exact qubit realization for any fixed-point-free involution,
expressed in the common-coordinate local-factor interface. -/

noncomputable section
namespace P14MatchingLocalFactor
open Submodule P14ComplexLocalCover
open scoped BigOperators

theorem on_fin {m : ℕ} (F : Fin m → Fin m)
    (hF : Function.Involutive F) (hfix : ∀ i, F i ≠ i) :
    HasLocalFactor (Fin m) 2 1 (fun i j => F i = j) := by
  classical
  let C : P14UPBAssembly.Space 2 ≃ₗ[ℂ] (Fin 2 → ℂ) :=
    WithLp.linearEquiv 2 ℂ (Fin 2 → ℂ)
  refine ⟨fun i => C (P14QubitMatching.vectors F i), ?_, ?_, ?_⟩
  · intro i hi
    exact P14QubitMatching.nonzero F i (C.map_eq_zero_iff.mp hi)
  · intro S hS
    have hs := P14QubitMatching.spans_every_two F hF.injective S hS
    have hm := congrArg (Submodule.map C.toLinearMap) hs
    have hm' : span ℂ (Set.range (fun i : ↥(S : Set (Fin m)) =>
        C (P14QubitMatching.vectors F i.val))) = ⊤ := by
      simpa [C, Submodule.map_span, ← Set.range_comp, Function.comp_def,
        Submodule.map_top, LinearMap.range_eq_top.mpr C.surjective] using hm
    have hrange : Set.range (fun i : S => C (P14QubitMatching.vectors F i)) =
        Set.range (fun i : ↥(S : Set (Fin m)) => C (P14QubitMatching.vectors F i.val)) := by
      ext y
      constructor
      · rintro ⟨i, rfl⟩
        exact ⟨⟨i.val, i.property⟩, rfl⟩
      · rintro ⟨i, rfl⟩
        exact ⟨⟨i.val, i.property⟩, rfl⟩
    rw [hrange]
    exact hm'
  · intro i j hij
    subst j
    change (∑ r, star (P14QubitMatching.vectors F i r) *
      P14QubitMatching.vectors F (F i) r) = 0
    calc
      _ = inner ℂ (P14QubitMatching.vectors F i) (P14QubitMatching.vectors F (F i)) := by
        simp only [PiLp.inner_apply, RCLike.inner_apply]
        apply Finset.sum_congr rfl
        intro r _
        exact mul_comm _ _
      _ = 0 := P14QubitMatching.matching_orthogonal F hF hfix i

/-- The same finite row labels may be used for every local matching factor. -/
theorem on_finite {V : Type*} [Fintype V] (F : V → V)
    (hF : Function.Involutive F) (hfix : ∀ i, F i ≠ i) :
    HasLocalFactor V 2 1 (fun i j => F i = j) := by
  classical
  let e : Fin (Fintype.card V) ≃ V := (Fintype.equivFin V).symm
  let f : Fin (Fintype.card V) → Fin (Fintype.card V) :=
    fun i => e.symm (F (e i))
  have hf : Function.Involutive f := by
    intro i
    simp only [f, Equiv.apply_symm_apply, hF (e i), Equiv.symm_apply_apply]
  have hff : ∀ i, f i ≠ i := by
    intro i hi
    apply hfix (e i)
    simpa only [f, Equiv.apply_symm_apply] using congrArg e hi
  obtain ⟨v, hnz, hspan, hpair⟩ := reindex e.symm (on_fin f hf hff)
  refine ⟨v, hnz, hspan, ?_⟩
  intro i j hij
  apply hpair i j
  change e.symm (F (e (e.symm i))) = e.symm j
  rw [Equiv.apply_symm_apply, hij]

end P14MatchingLocalFactor

end
end

section

/-! Three explicit perfect matchings of the prism over an odd cycle.
The two alternating path matchings use one end rung each. The third uses
the two closing cycle edges and every remaining rung. -/

namespace P14OddPrismMatchings

abbrev Vertex (k : ℕ) := Fin (2 * k + 1) ⊕ Fin (2 * k + 1)

def prismAdj {k : ℕ} : Vertex k → Vertex k → Prop
  | .inl a, .inl b => b = a + 1 ∨ a = b + 1
  | .inr a, .inr b => b = a + 1 ∨ a = b + 1
  | .inl a, .inr b => a = b
  | .inr a, .inl b => a = b

private def value0 (k x : ℕ) : ℕ :=
  if x = 2 * k then x else if x % 2 = 0 then x + 1 else x - 1

private def value1 (x : ℕ) : ℕ :=
  if x = 0 then 0 else if x % 2 = 0 then x - 1 else x + 1

private def value2 (k x : ℕ) : ℕ :=
  if x = 0 then 2 * k else if x = 2 * k then 0 else x

private theorem value0_lt (k x : ℕ) (hx : x < 2 * k + 1) :
    value0 k x < 2 * k + 1 := by
  unfold value0
  split_ifs <;> omega

private theorem value1_lt (k x : ℕ) (hx : x < 2 * k + 1) :
    value1 x < 2 * k + 1 := by
  unfold value1
  split_ifs <;> omega

private theorem value2_lt (k x : ℕ) (hx : x < 2 * k + 1) :
    value2 k x < 2 * k + 1 := by
  unfold value2
  split_ifs <;> omega

private theorem value0_involutive (k x : ℕ) (hx : x < 2 * k + 1) :
    value0 k (value0 k x) = x := by
  unfold value0
  split_ifs <;> omega

private theorem value1_involutive (x : ℕ) : value1 (value1 x) = x := by
  by_cases hx0 : x = 0
  · subst x
    simp [value1]
  · by_cases heven : x % 2 = 0
    · have hx2 : 2 ≤ x := by omega
      have hpred0 : x - 1 ≠ 0 := by omega
      have hpredOdd : (x - 1) % 2 ≠ 0 := by omega
      calc
        value1 (value1 x) = value1 (x - 1) :=
          congrArg value1 (by simp [value1, hx0, heven])
        _ = (x - 1) + 1 := by simp [value1, hpred0, hpredOdd]
        _ = x := by omega
    · have hsucc0 : x + 1 ≠ 0 := by omega
      have hsuccEven : (x + 1) % 2 = 0 := by omega
      calc
        value1 (value1 x) = value1 (x + 1) :=
          congrArg value1 (by simp [value1, hx0, heven])
        _ = (x + 1) - 1 := by simp [value1, hsucc0, hsuccEven]
        _ = x := by omega

private theorem value2_involutive (k x : ℕ) : value2 k (value2 k x) = x := by
  unfold value2
  split_ifs <;> omega

private def pair0 (k : ℕ) (a : Fin (2 * k + 1)) : Fin (2 * k + 1) :=
  ⟨value0 k a.val, value0_lt k a.val a.isLt⟩

private def pair1 (k : ℕ) (a : Fin (2 * k + 1)) : Fin (2 * k + 1) :=
  ⟨value1 a.val, value1_lt k a.val a.isLt⟩

private def pair2 (k : ℕ) (a : Fin (2 * k + 1)) : Fin (2 * k + 1) :=
  ⟨value2 k a.val, value2_lt k a.val a.isLt⟩

private def liftPair {α : Type*} (p : α → α) (P : α → Prop) [DecidablePred P] :
    α ⊕ α → α ⊕ α
  | .inl a => if P a then .inr a else .inl (p a)
  | .inr a => if P a then .inl a else .inr (p a)

private theorem liftPair_involutive {α : Type*} (p : α → α) (P : α → Prop)
    [DecidablePred P] (hp : Function.Involutive p)
    (hP : ∀ a, ¬ P a → ¬ P (p a)) : Function.Involutive (liftPair p P) := by
  intro x
  cases x with
  | inl a =>
      by_cases ha : P a
      · simp [liftPair, ha]
      · simp [liftPair, ha, hP a ha, hp a]
  | inr a =>
      by_cases ha : P a
      · simp [liftPair, ha]
      · simp [liftPair, ha, hP a ha, hp a]

private theorem liftPair_ne {α : Type*} (p : α → α) (P : α → Prop)
    [DecidablePred P] (hp : ∀ a, ¬ P a → p a ≠ a) (x : α ⊕ α) :
    liftPair p P x ≠ x := by
  cases x with
  | inl a =>
      by_cases ha : P a
      · simp [liftPair, ha]
      · simpa [liftPair, ha] using hp a ha
  | inr a =>
      by_cases ha : P a
      · simp [liftPair, ha]
      · simpa [liftPair, ha] using hp a ha

/-- Colors zero and one alternate along each layer's path; color two closes
both cycles. Each color uses exactly the rungs left over from its path edges. -/
def matching (k : ℕ) (c : Fin 3) : Vertex k → Vertex k :=
  if c = 0 then liftPair (pair0 k) (fun a => a.val = 2 * k)
  else if c = 1 then liftPair (pair1 k) (fun a => a.val = 0)
  else liftPair (pair2 k) (fun a => a.val ≠ 0 ∧ a.val ≠ 2 * k)

theorem matching_involutive (k : ℕ) (c : Fin 3) :
    Function.Involutive (matching k c) := by
  unfold matching
  split_ifs
  · apply liftPair_involutive
    · intro a
      exact Fin.ext (value0_involutive k a.val a.isLt)
    · intro a ha
      have hlt := a.isLt
      change value0 k a.val ≠ 2 * k
      unfold value0
      split_ifs <;> omega
  · apply liftPair_involutive
    · intro a
      exact Fin.ext (value1_involutive a.val)
    · intro a ha
      change value1 a.val ≠ 0
      unfold value1
      split_ifs <;> omega
  · apply liftPair_involutive
    · intro a
      exact Fin.ext (value2_involutive k a.val)
    · intro a ha
      change ¬ (value2 k a.val ≠ 0 ∧ value2 k a.val ≠ 2 * k)
      unfold value2
      split_ifs <;> omega

theorem matching_fixedPointFree {k : ℕ} (hk : 1 ≤ k) (c : Fin 3)
    (x : Vertex k) : matching k c x ≠ x := by
  unfold matching
  split_ifs
  · apply liftPair_ne
    intro a ha heq
    have hv := congrArg Fin.val heq
    change value0 k a.val = a.val at hv
    unfold value0 at hv
    split_ifs at hv <;> omega
  · apply liftPair_ne
    intro a ha heq
    have hv := congrArg Fin.val heq
    change value1 a.val = a.val at hv
    unfold value1 at hv
    split_ifs at hv <;> omega
  · apply liftPair_ne
    intro a ha heq
    have hv := congrArg Fin.val heq
    change value2 k a.val = a.val at hv
    unfold value2 at hv
    split_ifs at hv <;> omega

private theorem successor_val {k : ℕ} (hk : 1 ≤ k) (a : Fin (2 * k + 1)) :
    (a + 1).val = if a.val = 2 * k then 0 else a.val + 1 := by
  rw [Fin.val_add, Fin.val_one']
  have h1 : 1 % (2 * k + 1) = 1 := Nat.mod_eq_of_lt (by omega)
  rw [h1]
  by_cases ha : a.val = 2 * k
  · simp [ha]
  · rw [Nat.mod_eq_of_lt (by have hlt := a.isLt; omega), if_neg ha]

private theorem cycle_adj_of_values {k : ℕ} (hk : 1 ≤ k)
    (a b : Fin (2 * k + 1))
    (h : b.val = a.val + 1 ∨ a.val = b.val + 1 ∨
      (a.val = 2 * k ∧ b.val = 0) ∨ (a.val = 0 ∧ b.val = 2 * k)) :
    b = a + 1 ∨ a = b + 1 := by
  have ha := a.isLt
  have hb := b.isLt
  rcases h with h | h | h | h
  · left
    apply Fin.ext
    rw [successor_val hk]
    split_ifs <;> omega
  · right
    apply Fin.ext
    rw [successor_val hk]
    split_ifs <;> omega
  · left
    apply Fin.ext
    rw [successor_val hk]
    split_ifs <;> omega
  · right
    apply Fin.ext
    rw [successor_val hk]
    split_ifs <;> omega

private theorem liftPair_adj {k : ℕ} (p : Fin (2 * k + 1) → Fin (2 * k + 1))
    (P : Fin (2 * k + 1) → Prop) [DecidablePred P]
    (hp : ∀ a, ¬ P a → p a = a + 1 ∨ a = p a + 1) (x : Vertex k) :
    prismAdj x (liftPair p P x) := by
  cases x with
  | inl a =>
      by_cases ha : P a
      · simp [liftPair, ha, prismAdj]
      · simpa only [liftPair, if_neg ha, prismAdj] using hp a ha
  | inr a =>
      by_cases ha : P a
      · simp [liftPair, ha, prismAdj]
      · simpa only [liftPair, if_neg ha, prismAdj] using hp a ha

theorem matching_adj {k : ℕ} (hk : 1 ≤ k) (c : Fin 3) (x : Vertex k) :
    prismAdj x (matching k c x) := by
  unfold matching
  split_ifs
  · apply liftPair_adj
    intro a ha
    apply cycle_adj_of_values hk
    change value0 k a.val = a.val + 1 ∨ a.val = value0 k a.val + 1 ∨
      (a.val = 2 * k ∧ value0 k a.val = 0) ∨
      (a.val = 0 ∧ value0 k a.val = 2 * k)
    unfold value0
    split_ifs <;> omega
  · apply liftPair_adj
    intro a ha
    apply cycle_adj_of_values hk
    change value1 a.val = a.val + 1 ∨ a.val = value1 a.val + 1 ∨
      (a.val = 2 * k ∧ value1 a.val = 0) ∨
      (a.val = 0 ∧ value1 a.val = 2 * k)
    unfold value1
    split_ifs <;> omega
  · apply liftPair_adj
    intro a ha
    apply cycle_adj_of_values hk
    change value2 k a.val = a.val + 1 ∨ a.val = value2 k a.val + 1 ∨
      (a.val = 2 * k ∧ value2 k a.val = 0) ∨
      (a.val = 0 ∧ value2 k a.val = 2 * k)
    unfold value2
    split_ifs <;> omega

private theorem forward_cover {k : ℕ} (hk : 1 ≤ k) (a : Fin (2 * k + 1)) :
    ∃ c : Fin 3, matching k c (.inl a) = .inl (a + 1) ∧
      matching k c (.inr a) = .inr (a + 1) := by
  by_cases hlast : a.val = 2 * k
  · have hzero : a.val ≠ 0 := by omega
    have hp : pair2 k a = a + 1 := by
      apply Fin.ext
      change value2 k a.val = (a + 1).val
      rw [successor_val hk]
      simp [value2, hlast, hzero]
    refine ⟨2, ?_⟩
    constructor <;> simp [matching, liftPair, hlast, hzero, hp]
  · by_cases heven : a.val % 2 = 0
    · have hp : pair0 k a = a + 1 := by
        apply Fin.ext
        change value0 k a.val = (a + 1).val
        rw [successor_val hk]
        simp [value0, hlast, heven]
      refine ⟨0, ?_⟩
      constructor <;> simp [matching, liftPair, hlast, hp]
    · have hzero : a.val ≠ 0 := by omega
      have hp : pair1 k a = a + 1 := by
        apply Fin.ext
        change value1 a.val = (a + 1).val
        rw [successor_val hk]
        simp [value1, hlast, hzero, heven]
      refine ⟨1, ?_⟩
      constructor <;> simp [matching, liftPair, hzero, hp]

private theorem rung_cover (k : ℕ) (a : Fin (2 * k + 1)) :
    ∃ c : Fin 3, matching k c (.inl a) = .inr a ∧
      matching k c (.inr a) = .inl a := by
  by_cases hlast : a.val = 2 * k
  · exact ⟨0, by simp [matching, liftPair, hlast]⟩
  · by_cases hzero : a.val = 0
    · exact ⟨1, by simp [matching, liftPair, hzero]⟩
    · exact ⟨2, by simp [matching, liftPair, hlast, hzero]⟩

private theorem reverse_edge (k : ℕ) (c : Fin 3) (x y : Vertex k)
    (h : matching k c x = y) : matching k c y = x := by
  rw [← h]
  exact matching_involutive k c x

/-- Every edge of both aligned cycles and every rung occurs in a color. -/
theorem cover {k : ℕ} (hk : 1 ≤ k) (x y : Vertex k) (hxy : prismAdj x y) :
    ∃ c : Fin 3, matching k c x = y := by
  cases x with
  | inl a =>
      cases y with
      | inl b =>
          rcases hxy with h | h
          · obtain ⟨c, hc, _⟩ := forward_cover hk a
            exact ⟨c, by simpa only [h] using hc⟩
          · obtain ⟨c, hc, _⟩ := forward_cover hk b
            exact ⟨c, reverse_edge k c _ _ (by simpa only [h] using hc)⟩
      | inr b =>
          change a = b at hxy
          subst b
          obtain ⟨c, hc, _⟩ := rung_cover k a
          exact ⟨c, hc⟩
  | inr a =>
      cases y with
      | inl b =>
          change a = b at hxy
          subst b
          obtain ⟨c, _, hc⟩ := rung_cover k a
          exact ⟨c, hc⟩
      | inr b =>
          rcases hxy with h | h
          · obtain ⟨c, _, hc⟩ := forward_cover hk a
            exact ⟨c, by simpa only [h] using hc⟩
          · obtain ⟨c, _, hc⟩ := forward_cover hk b
            exact ⟨c, reverse_edge k c _ _ (by simpa only [h] using hc)⟩

theorem prismAdj_iff_exists_matching {k : ℕ} (hk : 1 ≤ k) (x y : Vertex k) :
    prismAdj x y ↔ ∃ c : Fin 3, matching k c x = y := by
  constructor
  · exact cover hk x y
  · rintro ⟨c, rfl⟩
    exact matching_adj hk c x

end P14OddPrismMatchings

end

section

/-! Three common colors on all components of an odd cyclic step graph.
The components are cosets of the subgroup generated by the actual step.
The second layer is shifted by that step, so ordinary rungs become shifted
cross edges. No coprimality or pre-existing graph transport is assumed. -/

noncomputable section
namespace P14CyclicStepPrisms

/-- Both internal step graphs together with the shifted cross matching. -/
def stepPrismAdj {q : ℕ} [NeZero q] (a : Fin q) :
    (Fin q ⊕ Fin q) → (Fin q ⊕ Fin q) → Prop
  | .inl x, .inl y => y = x + a ∨ x = y + a
  | .inr x, .inr y => y = x + a ∨ x = y + a
  | .inl x, .inr y => y = x + a
  | .inr x, .inl y => x = y + a

private theorem coset_add_bijective {G : Type*} [AddGroup G]
    (H : AddSubgroup G) : Function.Bijective
      (fun p : (G ⧸ H) × H => p.1.out + (p.2 : G)) := by
  constructor
  · rintro ⟨C, x⟩ ⟨D, y⟩ h
    have hCD : C = D := by
      have hm := congrArg (fun z : G => (z : G ⧸ H)) h
      simpa only [QuotientAddGroup.mk_add_of_mem _ x.property,
        QuotientAddGroup.mk_add_of_mem _ y.property,
        QuotientAddGroup.out_eq'] using hm
    subst D
    exact Prod.ext rfl (Subtype.ext (add_left_cancel h))
  · intro x
    let C : G ⧸ H := (x : G ⧸ H)
    have hm : -C.out + x ∈ H :=
      QuotientAddGroup.eq.mp (QuotientAddGroup.out_eq' C)
    refine ⟨(C, ⟨-C.out + x, hm⟩), ?_⟩
    simp

private def cosetEquiv {G : Type*} [AddGroup G] (H : AddSubgroup G) :
    (G ⧸ H) × H ≃ G :=
  Equiv.ofBijective _ (coset_add_bijective H)

private abbrev Component {q : ℕ} [NeZero q] (a : Fin q) :=
  Fin q ⧸ AddSubgroup.zmultiples a

private def labels {q k : ℕ} [NeZero q] (a : Fin q)
    (hL : addOrderOf a = 2 * k + 1) :
    Component a × Fin (2 * k + 1) ≃ Fin q :=
  (Equiv.prodCongr (Equiv.refl (Component a))
    ((finCongr hL).symm.trans
      (finEquivZMultiples (isOfFinAddOrder_of_finite a)))).trans
    (cosetEquiv (AddSubgroup.zmultiples a))

private theorem labels_apply {q k : ℕ} [NeZero q] (a : Fin q)
    (hL : addOrderOf a = 2 * k + 1) (C : Component a)
    (i : Fin (2 * k + 1)) : labels a hL (C, i) = C.out + i.val • a := rfl

private theorem labels_succ {q k : ℕ} [NeZero q] (a : Fin q)
    (hL : addOrderOf a = 2 * k + 1) (hk : 1 ≤ k)
    (C : Component a) (i : Fin (2 * k + 1)) :
    labels a hL (C, i + 1) = labels a hL (C, i) + a := by
  rw [labels_apply, labels_apply, Fin.val_add, Fin.val_one']
  rw [Nat.mod_eq_of_lt (show 1 < 2 * k + 1 by omega)]
  have hm := mod_addOrderOf_nsmul a (i.val + 1)
  rw [hL] at hm
  rw [hm, add_nsmul, one_nsmul, add_assoc]

private theorem labels_step_iff {q k : ℕ} [NeZero q] (a : Fin q)
    (hL : addOrderOf a = 2 * k + 1) (hk : 1 ≤ k)
    (C D : Component a) (i j : Fin (2 * k + 1)) :
    (labels a hL (D, j) = labels a hL (C, i) + a ∨
      labels a hL (C, i) = labels a hL (D, j) + a) ↔
      C = D ∧ (j = i + 1 ∨ i = j + 1) := by
  rw [← labels_succ a hL hk C i, ← labels_succ a hL hk D j]
  simp only [Equiv.apply_eq_iff_eq, Prod.mk.injEq]
  constructor
  · rintro (h | h)
    · exact ⟨h.1.symm, Or.inl h.2⟩
    · exact ⟨h.1, Or.inr h.2⟩
  · rintro ⟨hCD, h | h⟩
    · exact Or.inl ⟨hCD.symm, h⟩
    · exact Or.inr ⟨hCD, h⟩

private def vertexEquiv {q k : ℕ} [NeZero q] (a : Fin q)
    (hL : addOrderOf a = 2 * k + 1) :
    Component a × P14OddPrismMatchings.Vertex k ≃ (Fin q ⊕ Fin q) where
  toFun p := match p.2 with
    | .inl i => .inl (labels a hL (p.1, i))
    | .inr i => .inr (labels a hL (p.1, i) + a)
  invFun x := match x with
    | .inl u => let p := (labels a hL).symm u; (p.1, .inl p.2)
    | .inr v => let p := (labels a hL).symm (v - a); (p.1, .inr p.2)
  left_inv := by
    rintro ⟨C, i | i⟩ <;>
      simp only [add_sub_cancel_right, Equiv.symm_apply_apply]
  right_inv := by
    rintro (u | v)
    · change Sum.inl ((labels a hL) ((labels a hL).symm u)) = Sum.inl u
      rw [Equiv.apply_symm_apply]
    · change Sum.inr ((labels a hL) ((labels a hL).symm (v - a)) + a) = Sum.inr v
      rw [Equiv.apply_symm_apply, sub_add_cancel]

private theorem vertex_adj_iff {q k : ℕ} [NeZero q] (a : Fin q)
    (hL : addOrderOf a = 2 * k + 1) (hk : 1 ≤ k)
    (p r : Component a × P14OddPrismMatchings.Vertex k) :
    stepPrismAdj a (vertexEquiv a hL p) (vertexEquiv a hL r) ↔
      p.1 = r.1 ∧ P14OddPrismMatchings.prismAdj p.2 r.2 := by
  rcases p with ⟨C, i | i⟩ <;> rcases r with ⟨D, j | j⟩
  · exact labels_step_iff a hL hk C D i j
  · change labels a hL (D, j) + a = labels a hL (C, i) + a ↔ C = D ∧ i = j
    constructor
    · intro h
      have hp := (labels a hL).injective (add_right_cancel h)
      exact ⟨(congrArg Prod.fst hp).symm, (congrArg Prod.snd hp).symm⟩
    · rintro ⟨rfl, rfl⟩
      rfl
  · change labels a hL (C, i) + a = labels a hL (D, j) + a ↔ C = D ∧ i = j
    constructor
    · intro h
      have hp := (labels a hL).injective (add_right_cancel h)
      exact ⟨congrArg Prod.fst hp, congrArg Prod.snd hp⟩
    · rintro ⟨rfl, rfl⟩
      rfl
  · change (labels a hL (D, j) + a = (labels a hL (C, i) + a) + a ∨
      labels a hL (C, i) + a = (labels a hL (D, j) + a) + a) ↔
      C = D ∧ (j = i + 1 ∨ i = j + 1)
    constructor
    · rintro (h | h)
      · exact (labels_step_iff a hL hk C D i j).mp (Or.inl (add_right_cancel h))
      · exact (labels_step_iff a hL hk C D i j).mp (Or.inr (add_right_cancel h))
    · intro h
      rcases (labels_step_iff a hL hk C D i j).mpr h with h | h
      · exact Or.inl (congrArg (fun x : Fin q => x + a) h)
      · exact Or.inr (congrArg (fun x : Fin q => x + a) h)

/-- Every nonzero step on an odd cyclic label set gives three global perfect
matchings. The same color acts in every generated-subgroup coset. -/
theorem exists_matchings {q : ℕ} [NeZero q] (hq : 3 ≤ q) (hodd : Odd q)
    (a : Fin q) (ha : a ≠ 0) :
    ∃ F : Fin 3 → (Fin q ⊕ Fin q) → (Fin q ⊕ Fin q),
      (∀ c, Function.Involutive (F c)) ∧
      (∀ c x, F c x ≠ x) ∧
      (∀ x y, stepPrismAdj a x y ↔ ∃ c : Fin 3, F c x = y) := by
  classical
  have hdvd : addOrderOf a ∣ q := by
    simpa only [Fintype.card_fin] using (addOrderOf_dvd_card (x := a))
  obtain ⟨k, hL⟩ := (hodd.of_dvd_nat hdvd).exists_bit1
  have hk : 1 ≤ k := by
    have hne : addOrderOf a ≠ 1 := fun h => ha (AddMonoid.addOrderOf_eq_one_iff.mp h)
    omega
  let E := vertexEquiv a hL
  let T (c : Fin 3) (p : Component a × P14OddPrismMatchings.Vertex k) :=
    (p.1, P14OddPrismMatchings.matching k c p.2)
  let F (c : Fin 3) (x : Fin q ⊕ Fin q) := E (T c (E.symm x))
  refine ⟨F, ?_, ?_, ?_⟩
  · intro c x
    change E (T c (E.symm (E (T c (E.symm x))))) = x
    rw [Equiv.symm_apply_apply]
    have hTT : T c (T c (E.symm x)) = E.symm x := by
      apply Prod.ext
      · rfl
      exact P14OddPrismMatchings.matching_involutive k c (E.symm x).2
    rw [hTT, Equiv.apply_symm_apply]
  · intro c x h
    change E (T c (E.symm x)) = x at h
    have hp := E.injective (h.trans (E.apply_symm_apply x).symm)
    exact P14OddPrismMatchings.matching_fixedPointFree hk c (E.symm x).2
      (congrArg Prod.snd hp)
  · intro x y
    have hAdj : stepPrismAdj a x y ↔ (E.symm x).1 = (E.symm y).1 ∧
        P14OddPrismMatchings.prismAdj (E.symm x).2 (E.symm y).2 := by
      simpa only [E, Equiv.apply_symm_apply] using
        (vertex_adj_iff a hL hk (E.symm x) (E.symm y))
    constructor
    · intro hxy
      obtain ⟨hC, hp⟩ := hAdj.mp hxy
      obtain ⟨c, hc⟩ := P14OddPrismMatchings.cover hk _ _ hp
      refine ⟨c, ?_⟩
      change E (T c (E.symm x)) = y
      calc
        E (T c (E.symm x)) = E (E.symm y) :=
          congrArg E (Prod.ext hC hc)
        _ = y := E.apply_symm_apply y
    · rintro ⟨c, hc⟩
      apply hAdj.mpr
      change E (T c (E.symm x)) = y at hc
      have hp := E.injective (hc.trans (E.apply_symm_apply y).symm)
      have hfst := congrArg Prod.fst hp
      refine ⟨hfst, ?_⟩
      have hs : P14OddPrismMatchings.matching k c (E.symm x).2 = (E.symm y).2 :=
        congrArg Prod.snd hp
      rw [← hs]
      exact P14OddPrismMatchings.matching_adj hk c (E.symm x).2

end P14CyclicStepPrisms

end
end

section

/-! An arbitrary cross offset can accompany any nonzero internal cyclic
step. Translating just the second layer transports the already constructed
three perfect matchings, with no coprimality or factorization assumption. -/

noncomputable section
namespace P14ShiftedStepPrisms
open P14CyclicStepPrisms
variable {q : ℕ} [NeZero q]

def Adj (a b : Fin q) : (Fin q ⊕ Fin q) → (Fin q ⊕ Fin q) → Prop
  | .inl x, .inl y => y = x + a ∨ x = y + a
  | .inr x, .inr y => y = x + a ∨ x = y + a
  | .inl x, .inr y => y = x + b
  | .inr x, .inl y => x = y + b

def shift (c : Fin q) : (Fin q ⊕ Fin q) ≃ (Fin q ⊕ Fin q) where
  toFun := Sum.elim Sum.inl (fun y => Sum.inr (y + c))
  invFun := Sum.elim Sum.inl (fun y => Sum.inr (y - c))
  left_inv := by rintro (x | y) <;> simp
  right_inv := by rintro (x | y) <;> simp

theorem shifted_internal (x y a c : Fin q) :
    y + c = (x + c) + a ↔ y = x + a := by
  constructor
  · intro h
    have he : y + c = (x + a) + c := by
      simpa only [add_assoc, add_comm, add_left_comm] using h
    exact add_right_cancel he
  · intro h
    rw [h]
    abel

theorem shifted_cross (x y a b : Fin q) :
    y + (b - a) = x + b ↔ y = x + a := by
  constructor
  · intro h
    calc
      y = (y + (b - a)) - (b - a) := (add_sub_cancel_right _ _).symm
      _ = (x + b) - (b - a) := by rw [h]
      _ = x + a := by abel
  · intro h
    rw [h]
    abel

theorem adj_transport (a b : Fin q) (x y : Fin q ⊕ Fin q) :
    Adj a b (shift (b - a) x) (shift (b - a) y) ↔ stepPrismAdj a x y := by
  cases x with
  | inl x =>
    cases y with
    | inl y => rfl
    | inr y => exact shifted_cross x y a b
  | inr x =>
    cases y with
    | inl y => exact shifted_cross y x a b
    | inr y =>
      change (y + (b - a) = (x + (b - a)) + a ∨
        x + (b - a) = (y + (b - a)) + a) ↔ _
      rw [shifted_internal, shifted_internal]
      rfl

theorem exists_matchings (hq : 3 ≤ q) (ho : Odd q) (a b : Fin q) (ha : a ≠ 0) :
    ∃ F : Fin 3 → (Fin q ⊕ Fin q) → (Fin q ⊕ Fin q),
      (∀ c, Function.Involutive (F c)) ∧ (∀ c x, F c x ≠ x) ∧
      (∀ x y, Adj a b x y ↔ ∃ c, F c x = y) := by
  obtain ⟨G, hG, hne, hcover⟩ := P14CyclicStepPrisms.exists_matchings hq ho a ha
  let E := shift (b - a)
  let F (c : Fin 3) (x : Fin q ⊕ Fin q) := E (G c (E.symm x))
  refine ⟨F, ?_, ?_, ?_⟩
  · intro c x
    change E (G c (E.symm (E (G c (E.symm x))))) = x
    rw [Equiv.symm_apply_apply, hG c, Equiv.apply_symm_apply]
  · intro c x h
    have he : G c (E.symm x) = E.symm x := E.injective
      (h.trans (E.apply_symm_apply x).symm)
    exact hne c (E.symm x) he
  · intro x y
    have he : Adj a b x y ↔ stepPrismAdj a (E.symm x) (E.symm y) := by
      simpa only [E, Equiv.apply_symm_apply] using
        adj_transport a b (E.symm x) (E.symm y)
    rw [he, hcover]
    constructor
    · rintro ⟨c, hc⟩
      refine ⟨c, ?_⟩
      change E (G c (E.symm x)) = y
      rw [hc, Equiv.apply_symm_apply]
    · rintro ⟨c, hc⟩
      exact ⟨c, E.injective (hc.trans (E.apply_symm_apply y).symm)⟩

end P14ShiftedStepPrisms

end
end

section

/-! A constructive matching cover for any list of common nonzero layer
steps and at least as many cross offsets. One cross offset per step forms
an odd prism; each other offset is itself a perfect matching. -/

noncomputable section
namespace P14PrismRemainderCover
variable {q : ℕ} [NeZero q]

def Inside (a : Fin q) : (Fin q ⊕ Fin q) → (Fin q ⊕ Fin q) → Prop
  | .inl x, .inl y => y = x + a ∨ x = y + a
  | .inr x, .inr y => y = x + a ∨ x = y + a
  | _, _ => False

def Cross (b : Fin q) : (Fin q ⊕ Fin q) → (Fin q ⊕ Fin q) → Prop
  | .inl x, .inr y => y = x + b
  | .inr x, .inl y => x = y + b
  | _, _ => False

def crossMatching (b : Fin q) : (Fin q ⊕ Fin q) → (Fin q ⊕ Fin q) :=
  Sum.elim (fun x => Sum.inr (x + b)) (fun y => Sum.inl (y - b))

theorem cross_involutive (b : Fin q) : Function.Involutive (crossMatching b) := by
  rintro (x | y)
  · change Sum.inl ((x + b) - b) = Sum.inl x
    rw [add_sub_cancel_right]
  · change Sum.inr ((y - b) + b) = Sum.inr y
    rw [sub_add_cancel]

theorem cross_ne (b : Fin q) (x : Fin q ⊕ Fin q) : crossMatching b x ≠ x := by
  cases x with
  | inl x => exact Sum.inr_ne_inl
  | inr x => exact Sum.inl_ne_inr

theorem cross_iff (b : Fin q) (x y : Fin q ⊕ Fin q) :
    Cross b x y ↔ crossMatching b x = y := by
  cases x with
  | inl x =>
    cases y with
    | inl y => simp [Cross, crossMatching]
    | inr y => simp [Cross, crossMatching, eq_comm]
  | inr x =>
    cases y with
    | inl y =>
      change x = y + b ↔ Sum.inl (x - b) = Sum.inl y
      constructor
      · intro h
        rw [h, add_sub_cancel_right]
      · intro h
        have he : x - b = y := Sum.inl.inj h
        calc
          x = (x - b) + b := (sub_add_cancel _ _).symm
          _ = y + b := by rw [he]
    | inr y => simp [Cross, crossMatching]

theorem adj_iff (a b : Fin q) (x y : Fin q ⊕ Fin q) :
    P14ShiftedStepPrisms.Adj a b x y ↔ Inside a x y ∨ Cross b x y := by
  cases x <;> cases y <;> simp [P14ShiftedStepPrisms.Adj, Inside, Cross]

theorem exists_cover {N B : ℕ} (hq : 3 ≤ q) (ho : Odd q)
    (a : Fin N → Fin q) (b : Fin B → Fin q) (ha : ∀ i, a i ≠ 0) (hNB : N ≤ B) :
    ∃ F : Fin (3 * N + (B - N)) → (Fin q ⊕ Fin q) → (Fin q ⊕ Fin q),
      (∀ c, Function.Involutive (F c)) ∧ (∀ c x, F c x ≠ x) ∧
      (∀ x y, ((∃ i, Inside (a i) x y) ∨ (∃ j, Cross (b j) x y)) ↔
        ∃ c, F c x = y) := by
  classical
  let first : Fin N → Fin B := fun i => ⟨i.val, by have h := i.isLt; omega⟩
  let rest : Fin (B - N) → Fin B := fun i => ⟨N + i.val, by have h := i.isLt; omega⟩
  have hg (i : Fin N) := P14ShiftedStepPrisms.exists_matchings hq ho (a i) (b (first i)) (ha i)
  choose G hG hGne hGC using hg
  let Colors := (Fin N × Fin 3) ⊕ Fin (B - N)
  let all : Colors → (Fin q ⊕ Fin q) → (Fin q ⊕ Fin q) :=
    Sum.elim (fun c => G c.1 c.2) (fun j => crossMatching (b (rest j)))
  have hall (c : Colors) : Function.Involutive (all c) := by
    cases c with
    | inl c => exact hG c.1 c.2
    | inr j => exact cross_involutive _
  have hallne (c : Colors) (x : Fin q ⊕ Fin q) : all c x ≠ x := by
    cases c with
    | inl c => exact hGne c.1 c.2 x
    | inr j => exact cross_ne _ x
  have cover (x y : Fin q ⊕ Fin q) :
      ((∃ i, Inside (a i) x y) ∨ (∃ j, Cross (b j) x y)) ↔ ∃ c : Colors, all c x = y := by
    constructor
    · rintro (⟨i, hi⟩ | ⟨j, hj⟩)
      · obtain ⟨c, hc⟩ := (hGC i x y).mp ((adj_iff _ _ x y).mpr (Or.inl hi))
        exact ⟨Sum.inl (i, c), hc⟩
      · by_cases hjN : j.val < N
        · let i : Fin N := ⟨j.val, hjN⟩
          have hfirst : first i = j := Fin.ext rfl
          have hAdj := (adj_iff (a i) (b (first i)) x y).mpr
            (Or.inr (by simpa only [hfirst] using hj))
          obtain ⟨c, hc⟩ := (hGC i x y).mp hAdj
          exact ⟨Sum.inl (i, c), hc⟩
        · let k : Fin (B - N) := ⟨j.val - N, by have h := j.isLt; omega⟩
          have hrest : rest k = j := by apply Fin.ext; dsimp [rest, k]; omega
          refine ⟨Sum.inr k, ?_⟩
          change crossMatching (b (rest k)) x = y
          rw [hrest]
          exact (cross_iff _ x y).mp hj
    · rintro ⟨c, hc⟩
      cases c with
      | inl c =>
        have hadj := (hGC c.1 x y).mpr ⟨c.2, hc⟩
        rcases (adj_iff _ _ x y).mp hadj with hi | hj
        · exact Or.inl ⟨c.1, hi⟩
        · exact Or.inr ⟨first c.1, hj⟩
      | inr j => exact Or.inr ⟨rest j, (cross_iff _ x y).mpr hc⟩
  have hcard : Fintype.card Colors = 3 * N + (B - N) := by
    simp only [Colors, Fintype.card_sum, Fintype.card_prod, Fintype.card_fin]
    omega
  let e : Fin (3 * N + (B - N)) ≃ Colors := (Fintype.equivFinOfCardEq hcard).symm
  refine ⟨fun c => all (e c), fun c => hall (e c), fun c => hallne (e c), ?_⟩
  intro x y
  rw [cover]
  constructor
  · rintro ⟨c, hc⟩
    exact ⟨e.symm c, by simpa only [Equiv.apply_symm_apply] using hc⟩
  · rintro ⟨c, hc⟩
    exact ⟨e c, hc⟩

end P14PrismRemainderCover

end
end

section

/-! Complete UPBs for (2q-m-1,2,...,2), with m qubits, m at least
three and odd q greater than m+1. All factors share one finite row set. -/

noncomputable section
open scoped BigOperators
namespace P14GeneralManyQubitUPB
open P14GeneralFrameLocalFactor P14ComplexLocalCover
open P14PrismRemainderCover P14CanonicalUPBTransport

def matching {q m : ℕ} [NeZero q] (hq : m ≤ q) (c : Fin m) :
    (Fin q ⊕ Fin q) → (Fin q ⊕ Fin q) :=
  crossMatching (-⟨c.val,lt_of_lt_of_le c.isLt hq⟩)

theorem cover {q m : ℕ} [NeZero q] (hq : m ≤ q)
    (x y : Fin q ⊕ Fin q) (hxy : x ≠ y) :
    Prescribed m x y ∨ ∃ c : Fin m, matching hq c x=y := by
  cases x with
  | inl x =>
    cases y with
    | inl y => exact Or.inl (by simpa [Prescribed] using hxy)
    | inr y =>
      by_cases hh : m ≤ (x-y).val
      · exact Or.inl hh
      · let c : Fin m := ⟨(x-y).val,by omega⟩
        have hc : (⟨c.val,lt_of_lt_of_le c.isLt hq⟩ : Fin q)=x-y := Fin.ext rfl
        refine Or.inr ⟨c,?_⟩
        change Sum.inr (x + -⟨c.val,lt_of_lt_of_le c.isLt hq⟩)=Sum.inr y
        rw [hc]
        congr 1
        abel
  | inr x =>
    cases y with
    | inl y =>
      by_cases hh : m ≤ (y-x).val
      · exact Or.inl hh
      · let c : Fin m := ⟨(y-x).val,by omega⟩
        have hc : (⟨c.val,lt_of_lt_of_le c.isLt hq⟩ : Fin q)=y-x := Fin.ext rfl
        refine Or.inr ⟨c,?_⟩
        change Sum.inl (x - -⟨c.val,lt_of_lt_of_le c.isLt hq⟩)=Sum.inl y
        rw [hc]
        congr 1
        abel
    | inr y => exact Or.inl (by simpa [Prescribed] using hxy)

def dimensions (q m : ℕ) : Fin (m+1) → ℕ := Fin.cons (2*q-m-1) (fun _ => 2)
def caps (q m : ℕ) : Fin (m+1) → ℕ := Fin.cons (2*q-m-1) (fun _ => 1)

theorem canonical {q m : ℕ} (hm : 3 ≤ m) (hq : m+1 < q) (hodd : Odd q) :
    Conclusion (m+1) (dimensions q m) := by
  letI : NeZero q := ⟨by omega⟩
  let R : Fin (m+1) → (Fin q ⊕ Fin q) → (Fin q ⊕ Fin q) → Prop :=
    Fin.cons (Prescribed m) (fun c x y => matching (by omega) c x=y)
  have hl : ∀ j, HasLocalFactor (Fin q ⊕ Fin q) (dimensions q m j) (caps q m j) (R j) := by
    intro j
    refine Fin.cases ?_ (fun c => ?_) j
    · exact exists_factor hm hq hodd
    · exact P14MatchingLocalFactor.on_finite _ (cross_involutive _) (cross_ne _)
  have hc : ∀ x y : Fin q ⊕ Fin q, x ≠ y → ∃ j, R j x y := by
    intro x y hxy
    rcases cover (by omega : m ≤ q) x y hxy with h | ⟨c,hh⟩
    · exact ⟨0,h⟩
    · exact ⟨c.succ,hh⟩
  apply P14ComplexLocalCover.canonical (dimensions q m) (caps q m) R hl hc
  · simp only [caps,Fin.sum_univ_succ,Fin.cons_zero,Fin.cons_succ,
      Finset.sum_const,Finset.card_univ,Fintype.card_fin,nsmul_eq_mul,Fintype.card_sum,Nat.cast_id,mul_one]
    omega
  · simp only [dimensions,Fin.sum_univ_succ,Fin.cons_zero,Fin.cons_succ,
      Nat.reduceSub,Finset.sum_const,Finset.card_univ,Fintype.card_fin,
      nsmul_eq_mul,Fintype.card_sum,Nat.cast_id,mul_one]
    omega

end P14GeneralManyQubitUPB
end
end

section

/-! The actual Fourier defect frame and its five explicit null columns.
Every scalar energy and nonzero-weight hypothesis is discharged from the
checked cubic grid data. Full four-row and UPB assembly remain separate. -/

noncomputable section
open Matrix
open scoped BigOperators
namespace P14CubicPhysicalFrame
open P14ConsecutiveFiveGridSigns P14CubicGridBranch
open P14CubicSpectralCorrection P14BalancedSpectralMatrix
open P14UnitaryDefectFrame P14UnitaryDefectGram

def tail (q : ℕ) : Finset (Fin q) := Finset.univ.filter (fun k => 5 ≤ k.val)

def delta (q : ℕ) (e : ℝ) (k : tail q) : ℂ := Real.sqrt (e * grid q k.val.val)

def matrix (q : ℕ) (e : ℝ) (b : Coeff) :
    Matrix (Fin q ⊕ tail q) (Fin q ⊕ Fin q) ℂ :=
  frame (fourierMatrix q) (fun k => spectral q e b k.val) (tail q) (delta q e)

def nullMatrix (q : ℕ) (hq : 5 ≤ q) (e : ℝ) (b : Coeff) :
    Matrix (Fin q ⊕ Fin q) (Fin 5) ℂ :=
  kernel (fourierMatrix q) (fun k => spectral q e b k.val)
    (fun k => ⟨k.val, lt_of_lt_of_le k.isLt hq⟩)

theorem delta_nonzero {q : ℕ} {e : ℝ} (he : 0 < e) (k : tail q) :
    delta q e k ≠ 0 := by
  have hk : 5 ≤ k.val.val := (Finset.mem_filter.mp k.property).2
  have hp := Real.sqrt_pos.mpr (mul_pos he (grid_positive hk k.val.isLt))
  unfold delta
  exact_mod_cast hp.ne'

theorem delta_square {q : ℕ} {e : ℝ} (he : 0 ≤ e) (k : tail q) :
    star (delta q e k) * delta q e k = (e * grid q k.val.val : ℝ) := by
  have hp := mul_nonneg he (grid_nonnegative k.val.isLt)
  simp only [delta, Complex.star_def, Complex.conj_ofReal, ← Complex.ofReal_mul]
  exact congrArg Complex.ofReal (Real.mul_self_sqrt hp)

theorem energy {q : ℕ} {e : ℝ} {b : Coeff} (he : 0 ≤ e)
    (hn : ∀ k : Fin q, Complex.normSq (spectral q e b k.val) = 1 - e * grid q k.val)
    (k : Fin q) :
    star (spectral q e b k.val) * spectral q e b k.val +
      defectWeight (tail q) (delta q e) k = 1 := by
  have hl : star (spectral q e b k.val) * spectral q e b k.val =
      ((1 - e * grid q k.val : ℝ) : ℂ) := by
    change (starRingEnd ℂ) (spectral q e b k.val) * spectral q e b k.val = _
    rw [← Complex.normSq_eq_conj_mul_self, hn k]
  rw [hl]
  by_cases hk : k ∈ tail q
  · simp only [defectWeight, dif_pos hk]
    rw [delta_square he]
    push_cast
    ring
  · have hk4 : k.val < 5 := by
      simp only [tail, Finset.mem_filter, Finset.mem_univ, true_and] at hk
      omega
    rw [zero_first_five q k.val hk4]
    simp [defectWeight, hk]

theorem null_columns {q : ℕ} (hq : 5 ≤ q) (e : ℝ) (b : Coeff) (k : Fin 5) :
    matrix q e b *ᵥ (fun i => nullMatrix q hq e b i k) = 0 := by
  apply kernel_null (fourierMatrix q) (fourierMatrix_unitary q (by omega))
  intro j
  simp only [tail, Finset.mem_filter, Finset.mem_univ, true_and]
  exact Nat.not_le.mpr j.isLt

theorem surjective {q : ℕ} (hq : 0 < q) {e : ℝ} (he : 0 < e) (b : Coeff) :
    Function.Surjective (fun a => matrix q e b *ᵥ a) :=
  P14UnitaryDefectFrame.surjective (fourierMatrix q) (fourierMatrix_unitary q hq)
    _ _ _ (delta_nonzero he)

theorem base_orthonormal {q : ℕ} (hq : 0 < q) (e : ℝ) (b : Coeff) (i j : Fin q) :
    pair (matrix q e b) (Sum.inl i) (Sum.inl j) = if i = j then 1 else 0 :=
  base_gram (fourierMatrix q) (fourierMatrix_unitary q hq) _ _ _ i j

theorem spectral_orthonormal {q : ℕ} (hq : 0 < q) {e : ℝ} {b : Coeff} (he : 0 ≤ e)
    (hn : ∀ k : Fin q, Complex.normSq (spectral q e b k.val) = 1 - e * grid q k.val)
    (i j : Fin q) :
    pair (matrix q e b) (Sum.inr i) (Sum.inr j) = if i = j then 1 else 0 :=
  spectral_gram (fourierMatrix q) (fourierMatrix_unitary q hq) _ _ _ (energy he hn) i j

theorem columns_nonzero {q : ℕ} (hq : 0 < q) {e : ℝ} {b : Coeff} (he : 0 ≤ e)
    (hn : ∀ k : Fin q, Complex.normSq (spectral q e b k.val) = 1 - e * grid q k.val)
    (j : Fin q ⊕ Fin q) : (fun k => matrix q e b k j) ≠ 0 :=
  P14UnitaryDefectGram.columns_nonzero (fourierMatrix q) (fourierMatrix_unitary q hq)
    _ _ _ (energy he hn) j

theorem exists_frame {q : ℕ} (hq : 7 ≤ q) :
    ∃ e : ℝ, ∃ b : Coeff, 0 < e ∧
      (∀ k : Fin q, Complex.normSq (spectral q e b k.val) = 1 - e * grid q k.val) ∧
      Function.Surjective (fun a => matrix q e b *ᵥ a) ∧
      (∀ k : Fin 5, matrix q e b *ᵥ (fun i => nullMatrix q (by omega) e b i k) = 0) ∧
      (∀ i j : Fin q, pair (matrix q e b) (Sum.inl i) (Sum.inl j) = if i = j then 1 else 0) ∧
      (∀ i j : Fin q, pair (matrix q e b) (Sum.inr i) (Sum.inr j) = if i = j then 1 else 0) ∧
      (∀ j : Fin q ⊕ Fin q, (fun k => matrix q e b k j) ≠ 0) := by
  obtain ⟨e, b, he, hn, _⟩ := exists_data hq
  exact ⟨e, b, he, hn, surjective (by omega) he b, null_columns (by omega) e b,
    base_orthonormal (by omega) e b, spectral_orthonormal (by omega) he.le hn,
    columns_nonzero (by omega) he.le hn⟩

end P14CubicPhysicalFrame

end
end

section

/-! Every injective four-label selection from the two actual layers is
independent for the same positive spectral parameter. All16 layer cases
are reduced by explicit checked row permutations. -/

noncomputable section
namespace P14CubicAllFour
open P14CubicSpectralCorrection P14CubicJetIndependence P14CubicWaveRows
open P14CubicOrderedRanks P14CubicWaveReverse P14CubicGridBranch
open P14FourRowPermutations P14FourierSpectralWeights

def model {ι : Type*} (e : ℝ) (coeff : Coeff) (w : ℂ) (X : ι → ℂ) :
    (ι ⊕ ι) → Fin 5 → ℂ
  | Sum.inl i => row (X i)
  | Sum.inr i => wave e coeff w (X i)

theorem all_four {ι : Type*} (e : ℝ) (coeff : Coeff) (w : ℂ) (X : ι → ℂ)
    (hX : Function.Injective X) (hu : UnitValues e coeff w)
    (h31 : ThreeOne e coeff w X) (h22 : TwoTwo e coeff w X)
    (h13 : OneThree e coeff w X) (f : Fin 4 → ι ⊕ ι) (hf : Function.Injective f) :
    LinearIndependent ℂ (fun i => model e coeff w X (f i)) := by
  have hp (i j : Fin 4) (hij : i ≠ j) : f i ≠ f j := fun h => hij (hf h)
  have h10 := hp 1 0 (by decide)
  have h20 := hp 2 0 (by decide)
  have h30 := hp 3 0 (by decide)
  have h21 := hp 2 1 (by decide)
  have h31' := hp 3 1 (by decide)
  have h32 := hp 3 2 (by decide)
  have he : (fun i => model e coeff w X (f i)) =
      ![model e coeff w X (f 0),model e coeff w X (f 1),
        model e coeff w X (f 2),model e coeff w X (f 3)] := by
    funext i
    fin_cases i <;> rfl
  rw [he]
  rcases h0 : f 0 with a | a <;>
    rcases h1 : f 1 with b | b <;>
    rcases h2 : f 2 with c | c <;>
    rcases h3 : f 3 with d | d
  · -- 0000: 0=base, 1=spectral.
    have hn10 : b ≠ a := by
      intro hh
      apply h10
      simp only [h1,h0,hh]
    have hn20 : c ≠ a := by
      intro hh
      apply h20
      simp only [h2,h0,hh]
    have hn21 : c ≠ b := by
      intro hh
      apply h21
      simp only [h2,h1,hh]
    have hn30 : d ≠ a := by
      intro hh
      apply h30
      simp only [h3,h0,hh]
    have hn31 : d ≠ b := by
      intro hh
      apply h31'
      simp only [h3,h1,hh]
    have hn32 : d ≠ c := by
      intro hh
      apply h32
      simp only [h3,h2,hh]
    change LinearIndependent ℂ (![row (X a),row (X b),row (X c),row (X d)])
    have hi := P14CubicMixedNeighborhoods.four_nodes_injective (X a) (X b) (X c) (X d)
      (fun hh => hn10 (hX hh)) (fun hh => hn20 (hX hh)) (fun hh => hn30 (hX hh)) (fun hh => hn21 (hX hh)) (fun hh => hn31 (hX hh)) (fun hh => hn32 (hX hh))
    have h := P14CubicRowOperations.vandermonde_four (![X a,X b,X c,X d]) hi
    convert! h using 1
    funext i
    fin_cases i <;> rfl
  · -- 0001: 0=base, 1=spectral.
    have hn10 : b ≠ a := by
      intro hh
      apply h10
      simp only [h1,h0,hh]
    have hn20 : c ≠ a := by
      intro hh
      apply h20
      simp only [h2,h0,hh]
    have hn21 : c ≠ b := by
      intro hh
      apply h21
      simp only [h2,h1,hh]
    change LinearIndependent ℂ (![row (X a),row (X b),row (X c),wave e coeff w (X d)])
    exact h31 a b c d hn10 hn20 hn21
  · -- 0010: 0=base, 1=spectral.
    have hn10 : b ≠ a := by
      intro hh
      apply h10
      simp only [h1,h0,hh]
    have hn30 : d ≠ a := by
      intro hh
      apply h30
      simp only [h3,h0,hh]
    have hn31 : d ≠ b := by
      intro hh
      apply h31'
      simp only [h3,h1,hh]
    change LinearIndependent ℂ (![row (X a),row (X b),wave e coeff w (X c),row (X d)])
    exact swap23 _ _ _ _ (h31 a b d c hn10 hn30 hn31)
  · -- 0011: 0=base, 1=spectral.
    have hn10 : b ≠ a := by
      intro hh
      apply h10
      simp only [h1,h0,hh]
    have hn32 : d ≠ c := by
      intro hh
      apply h32
      simp only [h3,h2,hh]
    change LinearIndependent ℂ (![row (X a),row (X b),wave e coeff w (X c),wave e coeff w (X d)])
    exact h22 a b c d hn10 hn32
  · -- 0100: 0=base, 1=spectral.
    have hn20 : c ≠ a := by
      intro hh
      apply h20
      simp only [h2,h0,hh]
    have hn30 : d ≠ a := by
      intro hh
      apply h30
      simp only [h3,h0,hh]
    have hn32 : d ≠ c := by
      intro hh
      apply h32
      simp only [h3,h2,hh]
    change LinearIndependent ℂ (![row (X a),wave e coeff w (X b),row (X c),row (X d)])
    exact swap12 _ _ _ _ (swap23 _ _ _ _ (h31 a c d b hn20 hn30 hn32))
  · -- 0101: 0=base, 1=spectral.
    have hn20 : c ≠ a := by
      intro hh
      apply h20
      simp only [h2,h0,hh]
    have hn31 : d ≠ b := by
      intro hh
      apply h31'
      simp only [h3,h1,hh]
    change LinearIndependent ℂ (![row (X a),wave e coeff w (X b),row (X c),wave e coeff w (X d)])
    exact swap12 _ _ _ _ (h22 a c b d hn20 hn31)
  · -- 0110: 0=base, 1=spectral.
    have hn21 : c ≠ b := by
      intro hh
      apply h21
      simp only [h2,h1,hh]
    have hn30 : d ≠ a := by
      intro hh
      apply h30
      simp only [h3,h0,hh]
    change LinearIndependent ℂ (![row (X a),wave e coeff w (X b),wave e coeff w (X c),row (X d)])
    exact swap23 _ _ _ _ (swap12 _ _ _ _ (h22 a d b c hn30 hn21))
  · -- 0111: 0=base, 1=spectral.
    have hn21 : c ≠ b := by
      intro hh
      apply h21
      simp only [h2,h1,hh]
    have hn31 : d ≠ b := by
      intro hh
      apply h31'
      simp only [h3,h1,hh]
    have hn32 : d ≠ c := by
      intro hh
      apply h32
      simp only [h3,h2,hh]
    change LinearIndependent ℂ (![row (X a),wave e coeff w (X b),wave e coeff w (X c),wave e coeff w (X d)])
    exact swap01 _ _ _ _ (swap12 _ _ _ _ (swap23 _ _ _ _ (h13 b c d a hn21 hn31 hn32)))
  · -- 1000: 0=base, 1=spectral.
    have hn21 : c ≠ b := by
      intro hh
      apply h21
      simp only [h2,h1,hh]
    have hn31 : d ≠ b := by
      intro hh
      apply h31'
      simp only [h3,h1,hh]
    have hn32 : d ≠ c := by
      intro hh
      apply h32
      simp only [h3,h2,hh]
    change LinearIndependent ℂ (![wave e coeff w (X a),row (X b),row (X c),row (X d)])
    exact swap01 _ _ _ _ (swap12 _ _ _ _ (swap23 _ _ _ _ (h31 b c d a hn21 hn31 hn32)))
  · -- 1001: 0=base, 1=spectral.
    have hn21 : c ≠ b := by
      intro hh
      apply h21
      simp only [h2,h1,hh]
    have hn30 : d ≠ a := by
      intro hh
      apply h30
      simp only [h3,h0,hh]
    change LinearIndependent ℂ (![wave e coeff w (X a),row (X b),row (X c),wave e coeff w (X d)])
    exact swap01 _ _ _ _ (swap12 _ _ _ _ (h22 b c a d hn21 hn30))
  · -- 1010: 0=base, 1=spectral.
    have hn20 : c ≠ a := by
      intro hh
      apply h20
      simp only [h2,h0,hh]
    have hn31 : d ≠ b := by
      intro hh
      apply h31'
      simp only [h3,h1,hh]
    change LinearIndependent ℂ (![wave e coeff w (X a),row (X b),wave e coeff w (X c),row (X d)])
    exact swap23 _ _ _ _ (swap01 _ _ _ _ (swap12 _ _ _ _ (h22 b d a c hn31 hn20)))
  · -- 1011: 0=base, 1=spectral.
    have hn20 : c ≠ a := by
      intro hh
      apply h20
      simp only [h2,h0,hh]
    have hn30 : d ≠ a := by
      intro hh
      apply h30
      simp only [h3,h0,hh]
    have hn32 : d ≠ c := by
      intro hh
      apply h32
      simp only [h3,h2,hh]
    change LinearIndependent ℂ (![wave e coeff w (X a),row (X b),wave e coeff w (X c),wave e coeff w (X d)])
    exact swap12 _ _ _ _ (swap23 _ _ _ _ (h13 a c d b hn20 hn30 hn32))
  · -- 1100: 0=base, 1=spectral.
    have hn10 : b ≠ a := by
      intro hh
      apply h10
      simp only [h1,h0,hh]
    have hn32 : d ≠ c := by
      intro hh
      apply h32
      simp only [h3,h2,hh]
    change LinearIndependent ℂ (![wave e coeff w (X a),wave e coeff w (X b),row (X c),row (X d)])
    exact swap12 _ _ _ _ (swap23 _ _ _ _ (swap01 _ _ _ _ (swap12 _ _ _ _ (h22 c d a b hn32 hn10))))
  · -- 1101: 0=base, 1=spectral.
    have hn10 : b ≠ a := by
      intro hh
      apply h10
      simp only [h1,h0,hh]
    have hn30 : d ≠ a := by
      intro hh
      apply h30
      simp only [h3,h0,hh]
    have hn31 : d ≠ b := by
      intro hh
      apply h31'
      simp only [h3,h1,hh]
    change LinearIndependent ℂ (![wave e coeff w (X a),wave e coeff w (X b),row (X c),wave e coeff w (X d)])
    exact swap23 _ _ _ _ (h13 a b d c hn10 hn30 hn31)
  · -- 1110: 0=base, 1=spectral.
    have hn10 : b ≠ a := by
      intro hh
      apply h10
      simp only [h1,h0,hh]
    have hn20 : c ≠ a := by
      intro hh
      apply h20
      simp only [h2,h0,hh]
    have hn21 : c ≠ b := by
      intro hh
      apply h21
      simp only [h2,h1,hh]
    change LinearIndependent ℂ (![wave e coeff w (X a),wave e coeff w (X b),wave e coeff w (X c),row (X d)])
    exact h13 a b c d hn10 hn20 hn21
  · -- 1111: 0=base, 1=spectral.
    have hn10 : b ≠ a := by
      intro hh
      apply h10
      simp only [h1,h0,hh]
    have hn20 : c ≠ a := by
      intro hh
      apply h20
      simp only [h2,h0,hh]
    have hn21 : c ≠ b := by
      intro hh
      apply h21
      simp only [h2,h1,hh]
    have hn30 : d ≠ a := by
      intro hh
      apply h30
      simp only [h3,h0,hh]
    have hn31 : d ≠ b := by
      intro hh
      apply h31'
      simp only [h3,h1,hh]
    have hn32 : d ≠ c := by
      intro hh
      apply h32
      simp only [h3,h2,hh]
    change LinearIndependent ℂ (![wave e coeff w (X a),wave e coeff w (X b),wave e coeff w (X c),wave e coeff w (X d)])
    have hi := P14CubicMixedNeighborhoods.four_nodes_injective (X a) (X b) (X c) (X d)
      (fun hh => hn10 (hX hh)) (fun hh => hn20 (hX hh)) (fun hh => hn30 (hX hh)) (fun hh => hn21 (hX hh)) (fun hh => hn31 (hX hh)) (fun hh => hn32 (hX hh))
    have h := pure_spectral e coeff w hu (![X a,X b,X c,X d]) hi
    convert! h using 1
    funext i
    fin_cases i <;> rfl

theorem exists_all_four {q : ℕ} (hq : 7 ≤ q) :
    ∃ e : ℝ, ∃ coeff : Coeff, 0 < e ∧
      (∀ k : Fin q, Complex.normSq (spectral q e coeff k.val)=
        1-e*P14ConsecutiveFiveGridSigns.grid q k.val) ∧
      (∀ k : Fin q, spectral q e coeff k.val ≠ 0) ∧
      UnitValues e coeff (fourierRoot q) ∧
      ∀ f : Fin 4 → Fin q ⊕ Fin q, Function.Injective f →
        LinearIndependent ℂ (fun i => model e coeff (fourierRoot q) (node q) (f i)) := by
  obtain ⟨e,coeff,he,hn,hne,hu,h31,h22,h13⟩ := exists_data hq
  refine ⟨e,coeff,he,hn,hne,hu,?_⟩
  exact fun f hf => all_four e coeff (fourierRoot q) (node q)
    (node_injective (by omega)) hu h31 h22 h13 f hf

end P14CubicAllFour

end
end

