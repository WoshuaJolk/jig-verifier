section

/-! Actual ten-row complex UPBs from the K5 qutrit factor and checked
matching blocks. The finite block cover is supplied explicitly for each
dimension pattern below; no local-vector existence is assumed. -/

noncomputable section
namespace P14TenRowQutritUPB
open P14TenRowMatchingBlocks P14CanonicalUPBTransport
open scoped BigOperators

def dimensions {n : ℕ} (S : Fin n → Finset (Fin 6)) : Fin (n + 1) → ℕ :=
  Fin.cases 3 (fun j => (S j).card + 1)
def caps {n : ℕ} (S : Fin n → Finset (Fin 6)) : Fin (n + 1) → ℕ :=
  Fin.cases 3 (fun j => (S j).card)

theorem canonical {n : ℕ} (S : Fin n → Finset (Fin 6))
    (hallowed : ∀ j, S j ∈ allowed) (hcover : ∀ k : Fin 6, ∃ j, k ∈ S j)
    (hsum : (∑ j, (S j).card) = 6) : Conclusion (n + 1) (dimensions S) := by
  classical
  have hx : ∀ j : Fin n, ∃ x : Fin 10 → Fin ((S j).card + 1) → ℂ,
      (∀ i, x i ≠ 0) ∧
      (∀ i i' : Fin 10, H (S j) i.val i'.val → (∑ r, star (x i r) * x i' r) = 0) ∧
      (∀ A : Finset (Fin 10), A.card = (S j).card + 1 →
        Submodule.span ℂ (Set.range (fun i : A => x i)) = ⊤) := by
    intro j
    exact P14GenericExceptionalUPB.complex_rows (H (S j)) (symmetric (S j))
      (irreflexive (S j)) ((S j).card + 1) 10 (by omega)
      (bound (S j) (allowed_good (S j) (hallowed j)))
  choose x hnz horth hspan using hx
  let v : Fin 10 → (j : Fin (n + 1)) → Fin (dimensions S j) → ℂ :=
    fun i => Fin.cases (P14TenRowQutrit.row i) (fun j => x j i)
  refine ⟨10, ?_, v, ?_, ?_, ?_⟩
  · simp [dimensions, Fin.sum_univ_succ, hsum]
  · intro i j
    refine Fin.cases ?_ (fun j => ?_) j
    · exact P14TenRowQutrit.row_ne_zero i
    · exact hnz j i
  · intro i i' hne
    rcases pair_cover i i' hne with he | ⟨k, hk⟩
    · exact ⟨0, P14TenRowQutrit.disjoint_pair i i' he⟩
    · obtain ⟨j, hj⟩ := hcover k
      refine ⟨j.succ, horth j i i' ?_⟩
      simp only [H, neighbors, dif_pos i.isLt]
      exact Finset.mem_image.mpr ⟨k, hj, congrArg Fin.val hk⟩
  · apply P14ComplexKillingBudget.survivor (dimensions S) (caps S) v
    · simp [caps, Fin.sum_univ_succ, hsum]
    · intro j
      refine Fin.cases ?_ (fun j => ?_) j
      · intro a ha A hA
        exact P14TenRowQutrit.killing_bound a ha A hA
      · intro a ha A hA
        exact P14ComplexKillingBudget.of_spanning (x j) (hspan j) a ha A hA

theorem six_qubits : Conclusion 7 ![3, 2, 2, 2, 2, 2, 2] := by
  let S : Fin 6 → Finset (Fin 6) := ![{0}, {1}, {2}, {3}, {4}, {5}]
  have hc := canonical S (by intro j; fin_cases j <;> decide) (by decide) (by decide)
  have hd : dimensions S = ![3, 2, 2, 2, 2, 2, 2] := by
    funext j
    fin_cases j <;> decide
  rwa [hd] at hc

