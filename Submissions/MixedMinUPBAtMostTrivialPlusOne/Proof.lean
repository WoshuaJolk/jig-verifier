/-! A complete canonical UPB construction in dimensions (2q-5,2,2,2,2)
for every q at least seven. The frame and all four qubits use one row set. -/

noncomputable section
open scoped BigOperators
namespace P14CubicFourQubitUPB
open P14CubicFrameLocalFactor P14ComplexLocalCover
open P14PrismRemainderCover P14CanonicalUPBTransport

def matching {q : ℕ} [NeZero q] (hq : 4 ≤ q) (c : Fin 4) :
    (Fin q ⊕ Fin q) → (Fin q ⊕ Fin q) :=
  crossMatching (-⟨c.val, lt_of_lt_of_le c.isLt hq⟩)

theorem cover {q : ℕ} [NeZero q] (hq : 4 ≤ q)
    (x y : Fin q ⊕ Fin q) (hxy : x ≠ y) :
    Prescribed x y ∨ ∃ c : Fin 4, matching hq c x = y := by
  cases x with
  | inl x =>
    cases y with
    | inl y => exact Or.inl (by simpa [Prescribed] using hxy)
    | inr y =>
      by_cases hh : 4 ≤ (x - y).val
      · exact Or.inl hh
      · let c : Fin 4 := ⟨(x - y).val, by omega⟩
        have hc : (⟨c.val, lt_of_lt_of_le c.isLt hq⟩ : Fin q) = x - y := Fin.ext rfl
        refine Or.inr ⟨c, ?_⟩
        change Sum.inr (x + -⟨c.val, lt_of_lt_of_le c.isLt hq⟩) = Sum.inr y
        rw [hc]
        congr 1
        abel
  | inr x =>
    cases y with
    | inl y =>
      by_cases hh : 4 ≤ (y - x).val
      · exact Or.inl hh
      · let c : Fin 4 := ⟨(y - x).val, by omega⟩
        have hc : (⟨c.val, lt_of_lt_of_le c.isLt hq⟩ : Fin q) = y - x := Fin.ext rfl
        refine Or.inr ⟨c, ?_⟩
        change Sum.inl (x - -⟨c.val, lt_of_lt_of_le c.isLt hq⟩) = Sum.inl y
        rw [hc]
        congr 1
        abel
    | inr y => exact Or.inl (by simpa [Prescribed] using hxy)

def dimensions (q : ℕ) : Fin 5 → ℕ := Fin.cons (2 * q - 5) (fun _ => 2)
def caps (q : ℕ) : Fin 5 → ℕ := Fin.cons (2 * q - 5) (fun _ => 1)

theorem canonical {q : ℕ} (hq : 7 ≤ q) : Conclusion 5 (dimensions q) := by
  letI : NeZero q := ⟨by omega⟩
  let R : Fin 5 → (Fin q ⊕ Fin q) → (Fin q ⊕ Fin q) → Prop :=
    Fin.cons Prescribed (fun c x y => matching (by omega) c x = y)
  have hl : ∀ j, HasLocalFactor (Fin q ⊕ Fin q) (dimensions q j) (caps q j) (R j) := by
    intro j
    refine Fin.cases ?_ (fun c => ?_) j
    · exact exists_factor hq
    · exact P14MatchingLocalFactor.on_finite _ (cross_involutive _) (cross_ne _)
  have hc : ∀ x y : Fin q ⊕ Fin q, x ≠ y → ∃ j, R j x y := by
    intro x y hxy
    rcases cover (by omega : 4 ≤ q) x y hxy with h | ⟨c, hh⟩
    · exact ⟨0, h⟩
    · exact ⟨c.succ, hh⟩
  apply P14ComplexLocalCover.canonical (dimensions q) (caps q) R hl hc
  · simp only [caps, Fin.sum_univ_succ, Fin.cons_zero, Fin.cons_succ,
      Finset.sum_const, Finset.card_univ, Fintype.card_fin, nsmul_eq_mul,
      Fintype.card_sum]
    omega
  · simp only [dimensions, Fin.sum_univ_succ, Fin.cons_zero, Fin.cons_succ,
      Nat.reduceSub, Finset.sum_const, Finset.card_univ, Fintype.card_fin,
      nsmul_eq_mul, Fintype.card_sum]
    omega

end P14CubicFourQubitUPB

end
end

