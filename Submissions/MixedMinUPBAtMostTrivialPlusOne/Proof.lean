/-! Assemble both pure-layer and all six mixed-layer triple patterns.
The single quadratic branch supplies the two mixed orientations. -/

noncomputable section
open Matrix
namespace P14QuadraticAllTriples
open P14QuadraticKernelRows P14QuadraticGridBranch P14QuadraticJetTriple
open P14QuadraticReverseTriples P14QuadraticSpectralCorrection

def triple (x y z : Fin 4 → ℂ) (last : Fin 4) : Matrix (Fin 3) (Fin 3) ℂ :=
  fun i j => (![x, y, z] i) (coordinates last j)

theorem cycle_det (x y z : Fin 4 → ℂ) (last : Fin 4) :
    (triple x y z last).det = (triple y z x last).det := by
  simp [triple, Matrix.det_fin_three]
  ring

theorem pure_det (L : Fin 4 → ℂ) (x y z : ℂ) :
    (triple (fun k => L k * row x k) (fun k => L k * row y k)
      (fun k => L k * row z k) 2).det =
      (L 0 * L 1 * L 2) * (y - x) * (z - x) * (z - y) := by
  simp [triple, P14QuadraticJetTriple.row, coordinates, Matrix.det_fin_three]
  ring

theorem pure_nonzero (L : Fin 4 → ℂ) (hL : ∀ k, L k ≠ 0)
    (x y z : ℂ) (hxy : x ≠ y) (hxz : x ≠ z) (hyz : y ≠ z) :
    (triple (fun k => L k * row x k) (fun k => L k * row y k)
      (fun k => L k * row z k) 2).det ≠ 0 := by
  rw [pure_det]
  exact mul_ne_zero (mul_ne_zero (mul_ne_zero (mul_ne_zero (mul_ne_zero
    (hL 0) (hL 1)) (hL 2)) (sub_ne_zero.mpr hxy.symm))
    (sub_ne_zero.mpr hxz.symm)) (sub_ne_zero.mpr hyz.symm)

theorem all_triples {q : ℕ} (hq : 0 < q) (e : ℝ) (b : Coeff)
    (hL : ∀ k : Fin 4, spectral q e b k.val ≠ 0)
    (hf : ∀ i j k : Fin q, j ≠ i → ∃ last : Fin 4,
      (forward (fun k => spectral q e b k.val) (node q i) (node q j) (node q k) last).det ≠ 0)
    (hr : ∀ i j k : Fin q, j ≠ i → ∃ last : Fin 4,
      (reverse (fun k => spectral q e b k.val) (node q i) (node q j) (node q k) last).det ≠ 0)
    (x y z : Fin q ⊕ Fin q) (hxy : x ≠ y) (hxz : x ≠ z) (hyz : y ≠ z) :
    ∃ last : Fin 4, (triple (model e b x) (model e b y) (model e b z) last).det ≠ 0 := by
  have hp (L : Fin 4 → ℂ) (hL : ∀ k, L k ≠ 0) (i j k : Fin q)
      (hij : i ≠ j) (hik : i ≠ k) (hjk : j ≠ k) :=
    pure_nonzero L hL (node q i) (node q j) (node q k)
      ((node_injective hq).ne hij) ((node_injective hq).ne hik) ((node_injective hq).ne hjk)
  rcases x with x | x <;> rcases y with y | y <;> rcases z with z | z
  · exact ⟨2, hp _ hL x y z (by simpa using hxy) (by simpa using hxz) (by simpa using hyz)⟩
  · exact hr x y z (by simpa using hxy.symm)
  · obtain ⟨last, hh⟩ := hr z x y (by simpa using hxz)
    refine ⟨last, ?_⟩
    rw [cycle_det, cycle_det]
    exact hh
  · obtain ⟨last, hh⟩ := hf y z x (by simpa using hyz.symm)
    refine ⟨last, ?_⟩
    rw [cycle_det]
    exact hh
  · obtain ⟨last, hh⟩ := hr y z x (by simpa using hyz.symm)
    refine ⟨last, ?_⟩
    rw [cycle_det]
    exact hh
  · obtain ⟨last, hh⟩ := hf z x y (by simpa using hxz)
    refine ⟨last, ?_⟩
    rw [cycle_det, cycle_det]
    exact hh
  · exact hf x y z (by simpa using hxy.symm)
  · refine ⟨2, ?_⟩
    change (triple (P14QuadraticJetTriple.row (node q x))
      (P14QuadraticJetTriple.row (node q y)) (P14QuadraticJetTriple.row (node q z)) 2).det ≠ 0
    simpa only [one_mul] using
      hp (fun _ => 1) (fun _ => one_ne_zero) x y z
        (by simpa using hxy) (by simpa using hxz) (by simpa using hyz)

theorem exists_all_triples {q : ℕ} (hq : 7 ≤ q) :
    ∃ e : ℝ, ∃ b : Coeff, 0 < e ∧
      (∀ k : Fin q, Complex.normSq (spectral q e b k.val) =
        1 - e * P14ConsecutiveFourGridSigns.grid q k.val) ∧
      (∀ x y z : Fin q ⊕ Fin q, x ≠ y → x ≠ z → y ≠ z →
        ∃ last : Fin 4, (triple (model e b x) (model e b y) (model e b z) last).det ≠ 0) := by
  obtain ⟨e, b, he, hn, _, hu, hf, hr⟩ := exists_data hq
  refine ⟨e, b, he, hn, all_triples (by omega) e b ?_ ?_ hr⟩
  · intro k hk
    have hh := hu k
    rw [hk, zero_mul] at hh
    exact zero_ne_one hh
  · intro i j k hji
    obtain ⟨last, hh⟩ := hf i j k hji
    refine ⟨last, ?_⟩
    rw [show (fun k : Fin 4 => spectral q e b k.val) =
      (fun k : Fin 4 => P14QuadraticSpectralFactor.value e b
        (P14FourierSpectralWeights.fourierRoot q ^ k.val)) from rfl, forward_wave]
    exact hh

end P14QuadraticAllTriples
end
end

section

/-! Every all-but-three selection of actual physical frame columns spans.
The proof uses explicit null vectors, their triple minors and a right inverse. -/

noncomputable section
open Matrix Submodule
open scoped BigOperators
namespace P14QuadraticFrameSpanning
open P14QuadraticPhysicalFrame P14QuadraticGridBranch P14QuadraticJetTriple
open P14QuadraticKernelRows P14QuadraticAllTriples P14QuadraticSpectralCorrection

def GoodTriples (q : ℕ) (e : ℝ) (b : Coeff) : Prop :=
  ∀ x y z : Fin q ⊕ Fin q, x ≠ y → x ≠ z → y ≠ z →
    ∃ last : Fin 4, (triple (model e b x) (model e b y) (model e b z) last).det ≠ 0

theorem null_minor {q : ℕ} (hq : 4 ≤ q) (e : ℝ) (b : Coeff)
    (ht : GoodTriples q e b) (r : Fin 3 → Fin q ⊕ Fin q) (hr : Function.Injective r) :
    ∃ last : Fin 4,
      (Matrix.of (fun i j => nullMatrix q hq e b (r i) (coordinates last j))).det ≠ 0 := by
  have hi := (relabel_injective (show 0 < q by omega)).comp hr
  obtain ⟨last, hh⟩ := ht (relabel (by omega) (r 0)) (relabel (by omega) (r 1))
    (relabel (by omega) (r 2)) (hi.ne (by decide)) (hi.ne (by decide)) (hi.ne (by decide))
  let M : Matrix (Fin 3) (Fin 3) ℂ := triple
    (model e b (relabel (by omega) (r 0))) (model e b (relabel (by omega) (r 1)))
    (model e b (relabel (by omega) (r 2))) last
  have hM : Matrix.of (fun i j => nullMatrix q hq e b (r i) (coordinates last j)) =
      Matrix.of (fun i j => rowScale q (r i) * M i j) := by
    funext i j
    change nullMatrix q hq e b (r i) (coordinates last j) = rowScale q (r i) * M i j
    rw [null_row]
    fin_cases i <;> rfl
  refine ⟨last, ?_⟩
  rw [hM, Matrix.det_mul_column (fun i => rowScale q (r i)) M]
  exact mul_ne_zero (Finset.prod_ne_zero_iff.mpr (fun i _ => rowScale_nonzero (by omega) (r i))) hh

theorem supported_preimage {q : ℕ} (hq : 4 ≤ q) {e : ℝ} (he : 0 < e) (b : Coeff)
    (ht : GoodTriples q e b) (S : Finset (Fin q ⊕ Fin q)) (hS : S.card = 2 * q - 3)
    (v : Fin q ⊕ tail q → ℂ) :
    ∃ a : Fin q ⊕ Fin q → ℂ,
      P14QuadraticPhysicalFrame.matrix q e b *ᵥ a = v ∧ ∀ i, i ∉ S → a i = 0 := by
  have hc : Sᶜ.card = 3 := by
    simp only [Finset.card_compl, Fintype.card_sum, Fintype.card_fin, hS]
    omega
  let f : Fin 3 ≃ ↥(Sᶜ) := (Finset.equivFinOfCardEq hc).symm
  let r : Fin 3 → Fin q ⊕ Fin q := fun j => (f j).val
  have hr : Function.Injective r := Subtype.val_injective.comp f.injective
  obtain ⟨last, hm⟩ := null_minor hq e b ht r hr
  apply P14KernelCoefficientCorrection.supported_preimage
    (P14QuadraticPhysicalFrame.matrix q e b) (nullMatrix q hq e b)
    (null_columns hq e b) S r (coordinates last) ?_ hm
    (P14QuadraticPhysicalFrame.surjective (by omega) he b) v
  intro i hi
  refine ⟨f.symm ⟨i, Finset.mem_compl.mpr hi⟩, ?_⟩
  exact congrArg Subtype.val (f.apply_symm_apply ⟨i, Finset.mem_compl.mpr hi⟩)

theorem every_plus_one {q : ℕ} (hq : 4 ≤ q) {e : ℝ} (he : 0 < e) (b : Coeff)
    (ht : GoodTriples q e b) (S : Finset (Fin q ⊕ Fin q)) (hS : S.card = 2 * q - 3) :
    span ℂ (Set.range (fun i : S => fun k => P14QuadraticPhysicalFrame.matrix q e b k i.val)) = ⊤ := by
  apply top_unique
  intro v _
  obtain ⟨a, ha, hz⟩ := supported_preimage hq he b ht S hS v
  have hv : P14QuadraticPhysicalFrame.matrix q e b *ᵥ a =
      ∑ i, a i • (fun k => P14QuadraticPhysicalFrame.matrix q e b k i) := by
    ext k
    simp [Matrix.mulVec, dotProduct, Finset.sum_apply, Pi.smul_apply, smul_eq_mul, mul_comm]
  rw [← ha, hv]
  apply Submodule.sum_mem
  intro i _
  by_cases hi : i ∈ S
  · apply Submodule.smul_mem
    exact subset_span ⟨⟨i, hi⟩, rfl⟩
  · rw [hz i hi, zero_smul]
    exact Submodule.zero_mem _

theorem exists_spanning_frame {q : ℕ} (hq : 7 ≤ q) :
    ∃ e : ℝ, ∃ b : Coeff, 0 < e ∧
      (∀ k : Fin q, Complex.normSq (spectral q e b k.val) =
        1 - e * P14ConsecutiveFourGridSigns.grid q k.val) ∧
      (∀ S : Finset (Fin q ⊕ Fin q), S.card = 2 * q - 3 →
        span ℂ (Set.range (fun i : S => fun k => P14QuadraticPhysicalFrame.matrix q e b k i.val)) = ⊤) := by
  obtain ⟨e, b, he, hn, ht⟩ := exists_all_triples hq
  exact ⟨e, b, he, hn, every_plus_one (by omega) he b ht⟩

end P14QuadraticFrameSpanning
end
end

