  apply hnot
  apply P14CanonicalUPBTransport.of_dimensions (P14CubicFourQubitUPB.dimensions q) d E.symm
  · intro j
    simpa only [Equiv.apply_symm_apply] using (hdim (E.symm j)).symm
  · exact P14CubicFourQubitUPB.canonical hq

theorem residual_six {p : ℕ} (d : Fin p → ℕ) (hp : 3 ≤ p)
    (hd : ∀ j, 2 ≤ d j) (hnq : ¬ (∀ j, d j=2)) (hnot : ¬ Conclusion p d) :
    6 ≤ p ∧ ∃ a, 6 ≤ d a ∧ (∀ j, j ≠ a → d j=2) ∧ p < d a ∧
      (∑ j, (d j-1)) % 4=0 ∧ 12 ≤ (∑ j, (d j-1)) := by
  obtain ⟨hp5,hrest⟩ := P14QuadraticFourCanonical.residual_five d hp hd hnq hnot
  refine ⟨?_,hrest⟩
  by_contra hh
  have he : p=5 := by omega
  subst p
  exact hnot (five d hd hnq)

