section

/-! Min-five allocations with no upper bound on an ordinary dimension.
A small seed suffices for backward allocation. If none exists, the total
degree budget forces at most one ordinary factor. Its balanced midpoint
is repaired with one unused layer step and two cross matchings. -/

noncomputable section
namespace P14FiveUnrestrictedAllocation
open scoped BigOperators
open P14BalancedLayerAllocation

theorem allocate_of_seed {ι : Type*} (S : Finset ι) (r : ι → ℕ) (L : ℕ)
    (hr : ∀ i ∈ S, 4 ≤ r i) (hseed : S.Nonempty → ∃ i ∈ S, r i / 2 ≤ L + 1) :
    ∃ x : ι → ℕ, (∀ i ∈ S, Allowed (r i) (x i)) ∧
      (∑ i ∈ S, x i) = min L (∑ i ∈ S, r i / 2) := by
  classical
  rcases S.eq_empty_or_nonempty with rfl | hS
  · refine ⟨fun _ => 0, ?_, ?_⟩ <;> simp
  obtain ⟨i, hi, hmi⟩ := hseed hS
  let K := ∑ j ∈ S, r j / 2
  let X := min L K
  have hsum := Finset.sum_erase_add S (fun j => r j / 2) hi
  have hri := hr i hi
  have hiK : r i / 2 ≤ K := by dsimp only [K]; omega
  have hXi : r i / 2 ≤ X + 1 := by dsimp only [X]; omega
  have hY : K - X ≤ 1 + ∑ j ∈ S.erase i, r j / 2 := by
    dsimp only [K] at *
    omega
  obtain ⟨a, ha, x, hx, hax⟩ := P14OddLayerAllocation.allocate_with_interval
    (S.erase i) r 1 (by omega) (fun j hj => by
      have h := hr j (Finset.mem_of_mem_erase hj); omega) (K - X) hY
  let y : ι → ℕ := Function.update x i a
  have hy : ∀ j ∈ S, Allowed (r j) (y j) := by
    intro j hj
    by_cases hji : j = i
    · subst j
      simp only [y, Function.update_self]
      constructor
      · omega
      · by_cases he : r i = 4
        · exact Or.inr he
        · left
          omega
    · rw [show y j = x j from Function.update_of_ne hji a x]
      have h := hx j (Finset.mem_erase.mpr ⟨hji, hj⟩)
      exact ⟨h.1, Or.inl h.2⟩
  have hupdate : (∑ j ∈ S.erase i, y j) = ∑ j ∈ S.erase i, x j := by
    apply Finset.sum_congr rfl
    intro j hj
    exact Function.update_of_ne (Finset.mem_erase.mp hj).1 a x
  have hysum : (∑ j ∈ S, y j) = K - X := by
    have h := Finset.sum_erase_add S y hi
    rw [hupdate, show y i = a from Function.update_self ..] at h
    omega
  refine ⟨fun j => r j / 2 - y j, fun j hj => complement (hy j hj), ?_⟩
  have he : (∑ j ∈ S, (r j / 2 - y j)) + (∑ j ∈ S, y j) = K := by
    rw [← Finset.sum_add_distrib]
    exact Finset.sum_congr rfl (fun j hj => Nat.sub_add_cancel (hy j hj).1)
  have hX : X ≤ K := min_le_right _ _
  change (∑ j ∈ S, (r j / 2 - y j)) = X
  omega

theorem allocate_with_prisms_of_seed {ι : Type*} (S : Finset ι) (r : ι → ℕ)
    (L C m : ℕ) (hr : ∀ i ∈ S, 4 ≤ r i) (hseed : S.Nonempty → ∃ i ∈ S, r i / 2 ≤ L + 1)
    (hdegree : 2 * L + C = (∑ i ∈ S, r i) + m)
    (hcapacity : L + (∑ i ∈ S, r i % 2) ≤ C) :
    ∃ x t : ι → ℕ, ∃ N B : ℕ,
      (∀ i ∈ S, 2 * x i + t i = r i ∧ (2 * x i ≠ t i ∨ r i = 4)) ∧
      (∑ i ∈ S, x i) + N = L ∧ (∑ i ∈ S, t i) + B = C ∧
      N ≤ B ∧ 3 * N + (B - N) = m := by
  classical
  let K := ∑ i ∈ S, r i / 2
  let X := min L K
  obtain ⟨x, hx, hsum⟩ := allocate_of_seed S r L hr hseed
  change (∑ i ∈ S, x i) = X at hsum
  let t : ι → ℕ := fun i => r i - 2 * x i
  have hparts : ∀ i ∈ S, 2 * x i + t i = r i ∧ (2 * x i ≠ t i ∨ r i = 4) := by
    intro i hi
    have h := hx i hi
    dsimp only [Allowed] at h
    dsimp only [t]
    refine ⟨by omega, ?_⟩
    rcases h.2 with hn | he
    · left
      omega
    · exact Or.inr he
  have htotal : 2 * X + (∑ i ∈ S, t i) = ∑ i ∈ S, r i := by
    rw [← hsum, Finset.mul_sum, ← Finset.sum_add_distrib]
    exact Finset.sum_congr rfl (fun i hi => (hparts i hi).1)
  have hX : X ≤ L := min_le_left _ _
  have hparity := P14OddLayerAllocation.parity_capacity S r
  have hcross : (∑ i ∈ S, t i) ≤ C := by
    by_cases hLK : L ≤ K
    · have he : X = L := min_eq_left hLK
      omega
    · have he : X = K := min_eq_right (by omega)
      dsimp only [K] at he
      omega
  have hNB : L - X ≤ C - (∑ i ∈ S, t i) := by
    by_cases hLK : L ≤ K
    · have he : X = L := min_eq_left hLK
      omega
    · have he : X = K := min_eq_right (by omega)
      dsimp only [K] at he
      omega
  refine ⟨x, t, L - X, C - (∑ i ∈ S, t i), hparts, ?_, ?_, hNB, ?_⟩ <;> omega


theorem singleton_widths (L r m : ℕ) (hr : 4 ≤ r) (hfit : 2 * L ≤ r)
    (htotal : r + m = 4 * L + 4) :
    ∃ x t N B : ℕ, (2 * x + t = r ∧ (2 * x ≠ t ∨ r = 4)) ∧
      x + N = L ∧ t + B = 2 * L + 4 ∧ N ≤ B ∧ 3 * N + (B - N) = m := by
  by_cases hmid : 4 * L = r
  · refine ⟨L - 1, 2 * L + 2, 1, 2, ⟨?_, Or.inl ?_⟩, ?_, ?_, ?_, ?_⟩ <;> omega
  · refine ⟨L, r - 2 * L, 0, m, ⟨?_, Or.inl ?_⟩, ?_, ?_, ?_, ?_⟩ <;> omega

theorem construct {ι : Type*} (S : Finset ι) (r : ι → ℕ)
    (q m : ℕ) (hq : 7 ≤ q) (ho : Odd q) (hr : ∀ i ∈ S, 4 ≤ r i)
    (htotal : (∑ i ∈ S, r i) + m = 2 * q - 6) :
    ∃ x t : ι → ℕ, ∃ N B : ℕ,
      (∀ i ∈ S, 2 * x i + t i = r i ∧ (2 * x i ≠ t i ∨ r i = 4)) ∧
      (∑ i ∈ S, x i) + N = (q - 5) / 2 ∧
      (∑ i ∈ S, t i) + B = q - 1 ∧
      N ≤ B ∧ 3 * N + (B - N) = m := by
  classical
  let L := (q - 5) / 2
  have hL : 2 * L + 5 = q := by
    obtain ⟨k, hk⟩ := ho
    dsimp only [L]
    omega
  by_cases hseed : S.Nonempty → ∃ i ∈ S, r i / 2 ≤ L + 1
  · exact allocate_with_prisms_of_seed S r L (q - 1) m hr hseed
      (by omega) (P14OddLayerAllocation.five_capacity S r q m hq ho hr htotal)
  · have hS : S.Nonempty := by
      by_contra hn
      exact hseed (fun h => False.elim (hn h))
    obtain ⟨i, hi⟩ := hS
    have hlarge : ∀ j ∈ S, L + 1 < r j / 2 := by
      intro j hj
      by_contra hn
      exact hseed (fun _ => ⟨j, hj, by omega⟩)
    have hsum := Finset.sum_erase_add S r hi
    have hli := hlarge i hi
    have hs : S = {i} := by
      ext j
      constructor
      · intro hj
        apply Finset.mem_singleton.mpr
        by_contra hji
        have hlj := hlarge j hj
        have hj' : j ∈ S.erase i := Finset.mem_erase.mpr ⟨hji, hj⟩
        have hle : r j ≤ ∑ k ∈ S.erase i, r k :=
          Finset.single_le_sum (fun k _ => Nat.zero_le (r k)) hj'
        omega
      · intro hj
        simpa only [Finset.mem_singleton.mp hj] using hi
    have hri := hr i hi
    have htotal' : r i + m = 4 * L + 4 := by
      rw [hs, Finset.sum_singleton] at htotal
      omega
    obtain ⟨a, b, N, B, hpart, hN, hB, hNB, hm⟩ :=
      singleton_widths L (r i) m hri (by omega) htotal'
    refine ⟨fun _ => a, fun _ => b, N, B, ?_, ?_, ?_, hNB, hm⟩
    · intro j hj
      have hji : j = i := Finset.mem_singleton.mp (hs ▸ hj)
      simpa only [hji] using hpart
    · simpa only [hs, Finset.sum_singleton] using hN
    · simp only [hs, Finset.sum_singleton]
      omega

end P14FiveUnrestrictedAllocation

end
