/- Modification: degreeOf_mul_exact reuses degreeOf_mul_eq under a local private name with renamed binders and reduced cached imports. -/

/-! A linear polynomial involving every variable cannot divide a nonzero
multiaffine polynomial of total degree at least two. -/

namespace P14FourierMultiaffineNondivisibility

open MvPolynomial

variable {σ R : Type*} [CommSemiring R] [NoZeroDivisors R]

/-- Local reuse of `MvPolynomial.degreeOf_mul_eq` from
Mathlib/Algebra/MvPolynomial/NoZeroDivisors.lean (Apache 2.0;
Antoine Chambert-Loir and Bolton Bailey). This short proof needs only the
cached equivalence and univariate degree imports above. -/
private lemma degreeOf_mul_exact {f g : MvPolynomial σ R} {i : σ}
    (hf : f ≠ 0) (hg : g ≠ 0) :
    degreeOf i (f * g) = degreeOf i f + degreeOf i g := by
  classical
  simp_rw [degreeOf_eq_natDegree, map_mul, ← renameEquiv_apply]
  rw [Polynomial.natDegree_mul] <;>
    simpa [-renameEquiv_apply, EmbeddingLike.map_eq_zero_iff]

/-- Every cofactor of this multiaffine product is its constant coefficient. -/
theorem factor_is_constant {L P A : MvPolynomial σ R}
    (hL : L ≠ 0) (hP : P ≠ 0)
    (hLvars : ∀ i, degreeOf i L = 1)
    (hPvars : ∀ i, degreeOf i P ≤ 1) (hfactor : P = L * A) :
    A = C (A.coeff 0) := by
  classical
  have hA : A ≠ 0 := by
    intro h
    apply hP
    rw [hfactor, h, mul_zero]
  apply vars_eq_empty_iff_eq_C.mp
  apply Finset.eq_empty_iff_forall_notMem.mpr
  intro i hi
  have hbound := hPvars i
  rw [hfactor, degreeOf_mul_exact hL hA, hLvars i] at hbound
  have hzero : degreeOf i A = 0 := by omega
  exact (mem_vars_iff_degreeOf_ne_zero.mp hi) hzero

/-- The total-degree condition excludes the only possible constant cofactor. -/
theorem not_dvd_of_multiaffine {L P : MvPolynomial σ R}
    (hL : L ≠ 0) (hLtotal : totalDegree L = 1)
    (hLvars : ∀ i, degreeOf i L = 1) (hP : P ≠ 0)
    (hPvars : ∀ i, degreeOf i P ≤ 1) (hPtotal : 2 ≤ totalDegree P) :
    ¬ L ∣ P := by
  rintro ⟨A, hfactor⟩
  have hconstant := factor_is_constant hL hP hLvars hPvars hfactor
  have hbound := totalDegree_mul L A
  rw [← hfactor, hconstant, totalDegree_C, hLtotal, add_zero] at hbound
  omega

end P14FourierMultiaffineNondivisibility
end

section

/-!
Source-only draft for the coordinate-restriction factorization step.
Every supplied factor is explicitly prime.  No global UFD instance, distinctness,
or squarefreeness premise is needed for this existence statement: the finite
index set records each occurrence.  This file has not been compiled.
-/

namespace P14PrimeProductDivisor

open scoped BigOperators

/-- A divisor of a finite product of primes is associated to a subset product. -/
theorem associated_subprod_of_dvd {ι M : Type*}
    [CommMonoidWithZero M] [IsCancelMulZero M] (p : ι → M) :
    ∀ s : Finset ι, (∀ i ∈ s, Prime (p i)) →
      ∀ a : M, a ∣ ∏ i ∈ s, p i →
        ∃ t : Finset ι, t ⊆ s ∧ Associated a (∏ i ∈ t, p i) := by
  classical
  intro s
  induction s using Finset.induction_on with
  | empty =>
      intro _ a ha
      refine ⟨∅, Finset.empty_subset _, ?_⟩
      have hu : IsUnit a := isUnit_of_dvd_one (by simpa only [Finset.prod_empty] using ha)
      simpa only [Finset.prod_empty] using associated_one_iff_isUnit.mpr hu
  | @insert i s hi ih =>
      intro hp a ha
      have hip : Prime (p i) := hp i (Finset.mem_insert_self i s)
      have hsp : ∀ j ∈ s, Prime (p j) :=
        fun j hj => hp j (Finset.mem_insert_of_mem hj)
      rw [Finset.prod_insert hi] at ha
      obtain ⟨b, hb⟩ := ha
      have hdiv : p i ∣ a * b := ⟨∏ j ∈ s, p j, hb.symm⟩
      rcases hip.dvd_or_dvd hdiv with hia | hib
      · obtain ⟨a', rfl⟩ := hia
        have ha' : a' ∣ ∏ j ∈ s, p j :=
          ⟨b, mul_left_cancel₀ hip.ne_zero (hb.trans (mul_assoc _ _ _))⟩
        obtain ⟨t, ht, hat⟩ := ih hsp a' ha'
        have hit : i ∉ t := fun h => hi (ht h)
        refine ⟨insert i t, Finset.insert_subset_insert i ht, ?_⟩
        rw [Finset.prod_insert hit]
        exact Associated.mul_left (p i) hat
      · obtain ⟨b', rfl⟩ := hib
        have ha' : a ∣ ∏ j ∈ s, p j :=
          ⟨b', mul_left_cancel₀ hip.ne_zero (hb.trans (mul_left_comm _ _ _))⟩
        obtain ⟨t, ht, hat⟩ := ih hsp a ha'
        exact ⟨t, ht.trans (Finset.subset_insert i s), hat⟩

end P14PrimeProductDivisor

end

section

/-!
Scalar adapter for the generic prime-product divisor lemma.
Canonical multivariate-polynomial units over a field are nonzero scalars.
-/

namespace P14PrimeProductDivisor

open scoped BigOperators

/-- Over a field, the associate unit of a polynomial is a nonzero scalar. -/
theorem scalar_subprod_of_mul_eq {ι σ K : Type*} [Field K]
    (p : ι → MvPolynomial σ K) (s : Finset ι)
    (hp : ∀ i ∈ s, Prime (p i)) {c : K} (hc : c ≠ 0)
    {A B : MvPolynomial σ K}
    (hAB : A * B = MvPolynomial.C c * ∏ i ∈ s, p i) :
    ∃ t : Finset ι, t ⊆ s ∧ ∃ a : K, a ≠ 0 ∧
      A = MvPolynomial.C a * ∏ i ∈ t, p i := by
  have hcUnit : IsUnit (MvPolynomial.C c : MvPolynomial σ K) :=
    (isUnit_iff_ne_zero.mpr hc).map MvPolynomial.C
  have hdiv : A ∣ ∏ i ∈ s, p i :=
    hcUnit.dvd_mul_left.mp ⟨B, hAB.symm⟩
  obtain ⟨t, ht, hat⟩ := associated_subprod_of_dvd p s hp A hdiv
  obtain ⟨u, hu⟩ := hat.symm
  obtain ⟨a, ha, hua⟩ :=
    MvPolynomial.isUnit_iff_eq_C_of_isReduced.mp u.isUnit
  refine ⟨t, ht, a, ha.ne_zero, ?_⟩
  calc
    A = (∏ i ∈ t, p i) * (u : MvPolynomial σ K) := hu.symm
    _ = (∏ i ∈ t, p i) * MvPolynomial.C a :=
      congrArg (fun q : MvPolynomial σ K => (∏ i ∈ t, p i) * q) hua
    _ = MvPolynomial.C a * ∏ i ∈ t, p i := mul_comm _ _


end P14PrimeProductDivisor
end

section

/-!
Simultaneous scalar descriptions of two factors of an indexed prime product.
The selected index subset and its literal complement partition the original
finite index set. Repeated or associated prime values are permitted.
-/

namespace P14PrimeProductComplementaryScalar

open MvPolynomial
open scoped BigOperators

/-- Both factors have complementary indexed subproducts, with nonzero scalar
coefficients whose product is the original scalar. No uniqueness or
pairwise-nonassociation hypothesis is required. -/
theorem complementary_scalar_subprod_of_mul_eq {ι σ K : Type*}
    [DecidableEq ι] [Field K]
    (p : ι → MvPolynomial σ K) (s : Finset ι)
    (hp : ∀ i ∈ s, Prime (p i)) {c : K} (hc : c ≠ 0)
    {A B : MvPolynomial σ K}
    (hAB : A * B = C c * ∏ i ∈ s, p i) :
    ∃ t : Finset ι, t ⊆ s ∧ ∃ a : K, a ≠ 0 ∧ ∃ b : K, b ≠ 0 ∧
      a * b = c ∧
      A = C a * (∏ i ∈ t, p i) ∧
      B = C b * (∏ i ∈ s \ t, p i) := by
  obtain ⟨t, ht, a, ha, hA⟩ :=
    P14PrimeProductDivisor.scalar_subprod_of_mul_eq p s hp hc hAB
  let b : K := a⁻¹ * c
  have hb : b ≠ 0 := mul_ne_zero (inv_ne_zero ha) hc
  have hab : a * b = c := by
    change a * (a⁻¹ * c) = c
    rw [← mul_assoc, mul_inv_cancel₀ ha, one_mul]
  have hPt : (∏ i ∈ t, p i) ≠ 0 :=
    Finset.prod_ne_zero_iff.mpr (fun i hi => (hp i (ht hi)).ne_zero)
  have hCa : (C a : MvPolynomial σ K) ≠ 0 := MvPolynomial.C_ne_zero.mpr ha
  have hprod : (∏ i ∈ t, p i) * (∏ i ∈ s \ t, p i) = ∏ i ∈ s, p i :=
    (mul_comm _ _).trans (Finset.prod_sdiff (f := p) ht)
  refine ⟨t, ht, a, ha, b, hb, hab, hA, ?_⟩
  apply mul_left_cancel₀ (mul_ne_zero hCa hPt)
  calc
    (C a * (∏ i ∈ t, p i)) * B = A * B := by rw [hA]
    _ = C c * (∏ i ∈ s, p i) := hAB
    _ = C (a * b) * ((∏ i ∈ t, p i) * (∏ i ∈ s \ t, p i)) := by
      rw [hab, hprod]
    _ = (C a * (∏ i ∈ t, p i)) * (C b * (∏ i ∈ s \ t, p i)) := by
      rw [MvPolynomial.C_mul]
      exact mul_mul_mul_comm _ _ _ _


end P14PrimeProductComplementaryScalar
end

section

/-!
A finite nonempty sum of distinct coordinate variables is prime.
The distinguished variable has coefficient one. Subtracting the sum of the
remaining variables takes this polynomial to a coordinate variable, and adding
that sum back gives a left inverse of the substitution on every polynomial.
-/

namespace P14MvPolynomialCoordinateSumPrime

open scoped BigOperators

variable {σ R : Type*} [CommRing R] [IsCancelMulZero R] [Nontrivial R]

/-- A finite sum of coordinate variables is prime whenever a distinguished
coordinate belongs to its support. The `Finset` ensures that variables occur
without repetition; no hypothesis of primality or irreducibility is assumed. -/
theorem prime_sum_X_of_mem (s : Finset σ) (i : σ) (hi : i ∈ s) :
    Prime (∑ j ∈ s, (MvPolynomial.X j : MvPolynomial σ R)) := by
  classical
  let q : MvPolynomial σ R := ∑ j ∈ s.erase i, MvPolynomial.X j
  let f : MvPolynomial σ R →ₐ[R] MvPolynomial σ R :=
    MvPolynomial.aeval (fun j => if j = i then MvPolynomial.X i + q else MvPolynomial.X j)
  let g : MvPolynomial σ R →ₐ[R] MvPolynomial σ R :=
    MvPolynomial.aeval (fun j => if j = i then MvPolynomial.X i - q else MvPolynomial.X j)
  have hfi : f (MvPolynomial.X i) = MvPolynomial.X i + q := by
    simp [f]
  have hgi : g (MvPolynomial.X i) = MvPolynomial.X i - q := by
    simp [g]
  have hfq : f q = q := by
    change f (∑ j ∈ s.erase i, MvPolynomial.X j) = ∑ j ∈ s.erase i, MvPolynomial.X j
    rw [map_sum]
    apply Finset.sum_congr rfl
    intro j hj
    simp [f, (Finset.mem_erase.mp hj).1]
  have hgq : g q = q := by
    change g (∑ j ∈ s.erase i, MvPolynomial.X j) = ∑ j ∈ s.erase i, MvPolynomial.X j
    rw [map_sum]
    apply Finset.sum_congr rfl
    intro j hj
    simp [g, (Finset.mem_erase.mp hj).1]
  have hfg : f.comp g = AlgHom.id R (MvPolynomial σ R) := by
    apply MvPolynomial.algHom_ext
    intro j
    rw [AlgHom.comp_apply, AlgHom.id_apply]
    by_cases hj : j = i
    · subst j
      rw [hgi, map_sub, hfi, hfq, add_sub_cancel_right]
    · simp [f, g, hj]
  have hsum : MvPolynomial.X i + q = ∑ j ∈ s, (MvPolynomial.X j : MvPolynomial σ R) :=
    Finset.add_sum_erase s (fun j => (MvPolynomial.X j : MvPolynomial σ R)) hi
  have hgSum : g (∑ j ∈ s, (MvPolynomial.X j : MvPolynomial σ R)) = MvPolynomial.X i := by
    rw [← hsum, map_add, hgi, hgq, sub_add_cancel]
  apply comap_prime g f
  · intro p
    exact DFunLike.congr_fun hfg p
  · rw [hgSum]
    exact MvPolynomial.X_prime (i := i)

/-- Every nonempty finite coordinate sum is prime over a nontrivial commutative
ring with multiplicative cancellation away from zero, in particular a field. -/
theorem prime_sum_X (s : Finset σ) (hs : s.Nonempty) :
    Prime (∑ j ∈ s, (MvPolynomial.X j : MvPolynomial σ R)) := by
  obtain ⟨i, hi⟩ := hs
  exact prime_sum_X_of_mem s i hi


end P14MvPolynomialCoordinateSumPrime
end

section

/-!
Set one multivariate variable to zero, keeping the coefficient semiring and
all other variables fixed. The restrictions commute and are idempotent.
Canonical homogeneity of the original degree is preserved, including when
the restricted polynomial becomes zero.

Source-only draft: root owns compilation and transitive axiom checks.
-/

noncomputable section

namespace P14MvPolynomialCoordinateRestriction

variable {σ R : Type*} [CommSemiring R]

/-- The canonical evaluation homomorphism setting the coordinate `i` to zero. -/
def coordinateRestriction (i : σ) : MvPolynomial σ R →+* MvPolynomial σ R := by
  classical
  exact MvPolynomial.eval₂Hom MvPolynomial.C
    (fun j => if j = i then 0 else MvPolynomial.X j)

theorem coordinateRestriction_C (i : σ) (r : R) :
    coordinateRestriction i (MvPolynomial.C r) = MvPolynomial.C r := by
  classical
  exact MvPolynomial.eval₂Hom_C _ _ _

theorem coordinateRestriction_X_self (i : σ) :
    coordinateRestriction i (MvPolynomial.X i : MvPolynomial σ R) = 0 := by
  classical
  simp only [coordinateRestriction, MvPolynomial.eval₂Hom_X', ite_true]

theorem coordinateRestriction_X_of_ne (i j : σ) (h : j ≠ i) :
    coordinateRestriction i (MvPolynomial.X j : MvPolynomial σ R) = MvPolynomial.X j := by
  classical
  simp only [coordinateRestriction, MvPolynomial.eval₂Hom_X', if_neg h]

/-- Coordinate restrictions commute, with no distinctness assumption. -/
theorem coordinateRestriction_comp_comm (i j : σ) :
    (coordinateRestriction (R := R) i).comp (coordinateRestriction j) =
      (coordinateRestriction j).comp (coordinateRestriction i) := by
  classical
  apply MvPolynomial.ringHom_ext
  · intro r
    simp only [RingHom.comp_apply, coordinateRestriction_C]
  · intro x
    by_cases hxi : x = i
    · by_cases hxj : x = j
      · simp only [RingHom.comp_apply, coordinateRestriction,
          MvPolynomial.eval₂Hom_X', if_pos hxi, if_pos hxj, map_zero]
      · simp only [RingHom.comp_apply, coordinateRestriction,
          MvPolynomial.eval₂Hom_X', if_pos hxi, if_neg hxj, map_zero]
    · by_cases hxj : x = j
      · simp only [RingHom.comp_apply, coordinateRestriction,
          MvPolynomial.eval₂Hom_X', if_neg hxi, if_pos hxj, map_zero]
      · simp only [RingHom.comp_apply, coordinateRestriction,
          MvPolynomial.eval₂Hom_X', if_neg hxi, if_neg hxj]

theorem coordinateRestriction_comm (i j : σ) (P : MvPolynomial σ R) :
    coordinateRestriction i (coordinateRestriction j P) =
      coordinateRestriction j (coordinateRestriction i P) :=
  RingHom.congr_fun (coordinateRestriction_comp_comm i j) P

theorem coordinateRestriction_comp_self (i : σ) :
    (coordinateRestriction (R := R) i).comp (coordinateRestriction i) =
      coordinateRestriction i := by
  classical
  apply MvPolynomial.ringHom_ext
  · intro r
    simp only [RingHom.comp_apply, coordinateRestriction_C]
  · intro x
    by_cases hxi : x = i
    · simp only [RingHom.comp_apply, coordinateRestriction,
        MvPolynomial.eval₂Hom_X', if_pos hxi, map_zero]
    · simp only [RingHom.comp_apply, coordinateRestriction,
        MvPolynomial.eval₂Hom_X', if_neg hxi]

theorem coordinateRestriction_idempotent (i : σ) (P : MvPolynomial σ R) :
    coordinateRestriction i (coordinateRestriction i P) = coordinateRestriction i P :=
  RingHom.congr_fun (coordinateRestriction_comp_self i) P

/-- Setting a variable to zero preserves homogeneity at the original degree. -/
theorem isHomogeneous_coordinateRestriction (i : σ) {P : MvPolynomial σ R} {d : ℕ}
    (hP : P.IsHomogeneous d) : (coordinateRestriction i P).IsHomogeneous d := by
  classical
  have hg : ∀ j : σ,
      (if j = i then 0 else MvPolynomial.X j : MvPolynomial σ R).IsHomogeneous 1 := by
    intro j
    by_cases hji : j = i
    · rw [if_pos hji]
      exact MvPolynomial.isHomogeneous_zero σ R 1
    · rw [if_neg hji]
      exact MvPolynomial.isHomogeneous_X R j
  simpa only [coordinateRestriction, MvPolynomial.coe_eval₂Hom, one_mul] using
    hP.eval₂ (MvPolynomial.C : R →+* MvPolynomial σ R)
      (fun j => if j = i then 0 else MvPolynomial.X j)
      (fun r => MvPolynomial.isHomogeneous_C σ r) hg


end P14MvPolynomialCoordinateRestriction
end
end

section

/-!
Exact zero-coordinate restrictions of the existing matching polynomial.
Every definition is imported from its original module. The eliminated
polynomial restricts to the stated coefficient times a variable sum and
product, with no nonzero-coefficient or cardinality assumption.

Source-only draft: root owns compilation and transitive axiom checks.
-/

noncomputable section

namespace P14MatchingPolynomialCoordinateRestriction

open MvPolynomial
open P14MatchingRestrictionPolynomial P14MvPolynomialCoordinateRestriction
open scoped BigOperators

variable {σ R : Type*} [DecidableEq σ] [CommRing R]

/-- The restricted variable sum is exactly the sum with that index erased. -/
theorem coordinateRestriction_variableSum (s : Finset σ) (i : σ) :
    coordinateRestriction i (variableSum s : MvPolynomial σ R) =
      variableSum (s.erase i) := by
  unfold variableSum
  rw [map_sum]
  calc
    (∑ j ∈ s, coordinateRestriction i (X j : MvPolynomial σ R)) =
        ∑ j ∈ s.erase i, coordinateRestriction i (X j : MvPolynomial σ R) :=
      (Finset.sum_erase s
        (f := fun j => coordinateRestriction i (X j : MvPolynomial σ R))
        (coordinateRestriction_X_self (R := R) i)).symm
    _ = ∑ j ∈ s.erase i, (X j : MvPolynomial σ R) := by
      apply Finset.sum_congr rfl
      intro j hj
      exact coordinateRestriction_X_of_ne i j (Finset.ne_of_mem_erase hj)

/-- A product over variables containing the restricted variable vanishes. -/
theorem coordinateRestriction_variableProduct_of_mem
    (s : Finset σ) (i : σ) (hi : i ∈ s) :
    coordinateRestriction i (variableProduct s : MvPolynomial σ R) = 0 := by
  have hprod : (X i : MvPolynomial σ R) * variableProduct (s.erase i) =
      variableProduct s :=
    Finset.mul_prod_erase s (fun j => (X j : MvPolynomial σ R)) hi
  rw [← hprod, map_mul, coordinateRestriction_X_self, zero_mul]

/-- A variable product not containing the restricted variable is fixed. -/
theorem coordinateRestriction_variableProduct_of_notMem
    (s : Finset σ) (i : σ) (hi : i ∉ s) :
    coordinateRestriction i (variableProduct s : MvPolynomial σ R) = variableProduct s := by
  unfold variableProduct
  rw [map_prod]
  apply Finset.prod_congr rfl
  intro j hj
  have hji : j ≠ i := fun hji => hi (hji ▸ hj)
  exact coordinateRestriction_X_of_ne i j hji

theorem coordinateRestriction_variableProduct_erase (s : Finset σ) (i : σ) :
    coordinateRestriction i (variableProduct (s.erase i) : MvPolynomial σ R) =
      variableProduct (s.erase i) :=
  coordinateRestriction_variableProduct_of_notMem (s.erase i) i (Finset.notMem_erase i s)

/-- In the reciprocal numerator, only the summand indexed by `i` survives. -/
theorem coordinateRestriction_reciprocalNumerator
    (s : Finset σ) (c : σ → R) (i : σ) (hi : i ∈ s) :
    coordinateRestriction i (reciprocalNumerator s c) =
      C (c i) * variableProduct (s.erase i) := by
  unfold reciprocalNumerator
  rw [map_sum]
  calc
    (∑ j ∈ s, coordinateRestriction i (C (c j) * variableProduct (s.erase j))) =
        coordinateRestriction i (C (c i) * variableProduct (s.erase i)) := by
      apply Finset.sum_eq_single_of_mem i hi
      intro j hj hji
      have himem : i ∈ s.erase j := Finset.mem_erase.mpr ⟨hji.symm, hi⟩
      rw [map_mul, coordinateRestriction_variableProduct_of_mem (s.erase j) i himem,
        mul_zero]
    _ = C (c i) * variableProduct (s.erase i) := by
      rw [map_mul, coordinateRestriction_C, coordinateRestriction_variableProduct_erase]

/-- The exact restriction of the existing eliminated matching polynomial. -/
theorem coordinateRestriction_eliminated
    (s : Finset σ) (c₀ : R) (c : σ → R) (i : σ) (hi : i ∈ s) :
    coordinateRestriction i (eliminated s c₀ c) =
      -C (c i) * variableSum (s.erase i) * variableProduct (s.erase i) := by
  unfold eliminated
  rw [RingHom.map_sub, map_mul, map_mul, coordinateRestriction_C,
    coordinateRestriction_variableProduct_of_mem s i hi,
    coordinateRestriction_variableSum, coordinateRestriction_reciprocalNumerator s c i hi,
    mul_zero, zero_sub]
  calc
    -(variableSum (s.erase i) * (C (c i) * variableProduct (s.erase i))) =
        -(C (c i) * (variableSum (s.erase i) * variableProduct (s.erase i))) :=
      congrArg (fun z : MvPolynomial σ R => -z) (mul_left_comm _ _ _)
    _ = -C (c i) * (variableSum (s.erase i) * variableProduct (s.erase i)) :=
      (neg_mul _ _).symm
    _ = -C (c i) * variableSum (s.erase i) * variableProduct (s.erase i) :=
      (mul_assoc _ _ _).symm


end P14MatchingPolynomialCoordinateRestriction
end
end

section

/-!
Uniqueness of an indexed finite product of explicitly prime factors up to
association.  Distinct indices in the relevant union are assumed to carry
nonassociated factors.  This source draft makes no polynomial nonassociation
claim and still requires an actual build and axiom observation by root.
-/

namespace P14PrimeProductSubsetUnique

open scoped BigOperators

/-- Associated products of distinctly labeled, nonassociated primes use the same indices. -/
theorem eq_of_associated_prod {ι M : Type*}
    [DecidableEq ι] [CommMonoidWithZero M] [IsCancelMulZero M]
    (p : ι → M) (s t : Finset ι)
    (hp : ∀ i ∈ s ∪ t, Prime (p i))
    (hunique : ∀ i ∈ s ∪ t, ∀ j ∈ s ∪ t,
      i ≠ j → ¬ Associated (p i) (p j))
    (hprod : Associated (∏ i ∈ s, p i) (∏ i ∈ t, p i)) : s = t := by
  classical
  apply Finset.ext
  intro i
  constructor
  · intro his
    have hiu : i ∈ s ∪ t := Finset.mem_union_left t his
    have hip : Prime (p i) := hp i hiu
    have hdiv : p i ∣ ∏ j ∈ t, p j :=
      (Finset.dvd_prod_of_mem p his).trans hprod.dvd
    obtain ⟨j, hjt, hij⟩ := hip.exists_mem_finset_dvd hdiv
    have hju : j ∈ s ∪ t := Finset.mem_union_right s hjt
    have hij_assoc : Associated (p i) (p j) :=
      hip.associated_of_dvd (hp j hju) hij
    have hij_eq : i = j := by
      by_contra hne
      exact hunique i hiu j hju hne hij_assoc
    exact hij_eq.symm ▸ hjt
  · intro hit
    have hiu : i ∈ s ∪ t := Finset.mem_union_right s hit
    have hip : Prime (p i) := hp i hiu
    have hdiv : p i ∣ ∏ j ∈ s, p j :=
      (Finset.dvd_prod_of_mem p hit).trans hprod.dvd'
    obtain ⟨j, hjs, hij⟩ := hip.exists_mem_finset_dvd hdiv
    have hju : j ∈ s ∪ t := Finset.mem_union_left t hjs
    have hij_assoc : Associated (p i) (p j) :=
      hip.associated_of_dvd (hp j hju) hij
    have hij_eq : i = j := by
      by_contra hne
      exact hunique i hiu j hju hne hij_assoc
    exact hij_eq.symm ▸ hjs

end P14PrimeProductSubsetUnique

end

section

/-!
Source-only support comparison for two coordinate restrictions of the same
polynomial. The Option label `none` records a coordinate-sum factor and
`some i` records a coordinate factor. Both primality and nonassociation are
discharged from the actual polynomial factors.
-/

namespace P14MatchingDoubleRestrictionSupport

open MvPolynomial P14MatchingRestrictionPolynomial
open P14MvPolynomialCoordinateRestriction P14MatchingPolynomialCoordinateRestriction
open P14MvPolynomialCoordinateNonassociated
open scoped BigOperators

variable {σ K : Type*} [DecidableEq σ] [Field K]

/-- Every member of the coordinate/sum family is prime when the sum support
is nonempty. This statement requires no supplied prime witnesses. -/
theorem coordinateFamily_prime (s : Finset σ) (hs : s.Nonempty) (o : Option σ) :
    Prime (coordinateFamily (R := K) s o) := by
  cases o with
  | none => exact P14MvPolynomialCoordinateSumPrime.prime_sum_X s hs
  | some i => exact MvPolynomial.X_prime (i := i)

/-- Equality of nonzero scalar multiples of coordinate/sum subproducts
determines both their full Option index sets and their scalar coefficients. -/
theorem scalar_and_support_eq (s : Finset σ) (hs : 2 ≤ s.card)
    (t u : Finset (Option σ)) {a b : K} (ha : a ≠ 0) (hb : b ≠ 0)
    (hEq : C a * (∏ o ∈ t, coordinateFamily (R := K) s o) =
      C b * (∏ o ∈ u, coordinateFamily (R := K) s o)) :
    t = u ∧ a = b := by
  have hsn : s.Nonempty := Finset.one_le_card.mp ((Nat.le_succ 1).trans hs)
  have haUnit : IsUnit (C a : MvPolynomial σ K) :=
    (isUnit_iff_ne_zero.mpr ha).map MvPolynomial.C
  have hbUnit : IsUnit (C b : MvPolynomial σ K) :=
    (isUnit_iff_ne_zero.mpr hb).map MvPolynomial.C
  have hScaled : Associated
      (C a * (∏ o ∈ t, coordinateFamily (R := K) s o))
      (C b * (∏ o ∈ u, coordinateFamily (R := K) s o)) := by
    rw [hEq]
  have hAssoc : Associated
      (∏ o ∈ t, coordinateFamily (R := K) s o)
      (∏ o ∈ u, coordinateFamily (R := K) s o) :=
    (associated_isUnit_mul_right_iff hbUnit).mp
      ((associated_isUnit_mul_left_iff haUnit).mp hScaled)
  have htu : t = u := by
    apply P14PrimeProductSubsetUnique.eq_of_associated_prod
      (coordinateFamily (R := K) s) t u
    · intro o ho
      exact coordinateFamily_prime s hsn o
    · intro o ho q hq hne
      exact coordinateFamily_not_associated s hs o q hne
    · exact hAssoc
  have hprod : (∏ o ∈ u, coordinateFamily (R := K) s o) ≠ 0 :=
    Finset.prod_ne_zero_iff.mpr (fun o _ => (coordinateFamily_prime s hsn o).ne_zero)
  have hC : (C a : MvPolynomial σ K) = C b := by
    apply mul_right_cancel₀ hprod
    simpa only [htu] using hEq
  exact ⟨htu, MvPolynomial.C_injective σ K hC⟩

/-- Restriction erases the sum's coordinate while fixing each surviving
coordinate label. The crossed coordinate itself is explicitly excluded. -/
theorem coordinateRestriction_coordinateFamily (s : Finset σ) (j : σ)
    (o : Option σ) (ho : o ≠ some j) :
    coordinateRestriction j (coordinateFamily (R := K) s o) =
      coordinateFamily (R := K) (s.erase j) o := by
  cases o with
  | none => exact coordinateRestriction_variableSum s j
  | some i =>
      exact coordinateRestriction_X_of_ne j i (fun hij => ho (congrArg Option.some hij))

/-- The exact restricted product formula when the crossed coordinate label
does not occur among the selected factors. -/
theorem coordinateRestriction_family_prod_of_notMem (s : Finset σ) (j : σ)
    (t : Finset (Option σ)) (hj : some j ∉ t) :
    coordinateRestriction j (∏ o ∈ t, coordinateFamily (R := K) s o) =
      ∏ o ∈ t, coordinateFamily (R := K) (s.erase j) o := by
  rw [map_prod]
  apply Finset.prod_congr rfl
  intro o ho
  exact coordinateRestriction_coordinateFamily s j o (fun heq => hj (heq ▸ ho))

/-- Two restrictions of the same polynomial have equal factor supports and
scalars when each omits the crossed coordinate. In the elementary matching
argument this compares A on a nonedge, and B on an edge. -/
theorem doubleRestriction_support_and_scalar_eq
    (s : Finset σ) (i j : σ) (hs : 2 ≤ ((s.erase i).erase j).card)
    (A : MvPolynomial σ K) (t u : Finset (Option σ))
    {a b : K} (ha : a ≠ 0) (hb : b ≠ 0)
    (hAi : coordinateRestriction i A =
      C a * (∏ o ∈ t, coordinateFamily (R := K) (s.erase i) o))
    (hAj : coordinateRestriction j A =
      C b * (∏ o ∈ u, coordinateFamily (R := K) (s.erase j) o))
    (hjt : some j ∉ t) (hiu : some i ∉ u) :
    t = u ∧ a = b := by
  have hleft : coordinateRestriction j (coordinateRestriction i A) =
      C a * (∏ o ∈ t, coordinateFamily (R := K) ((s.erase i).erase j) o) := by
    rw [hAi, map_mul, coordinateRestriction_C,
      coordinateRestriction_family_prod_of_notMem (s.erase i) j t hjt]
  have hright : coordinateRestriction i (coordinateRestriction j A) =
      C b * (∏ o ∈ u, coordinateFamily (R := K) ((s.erase j).erase i) o) := by
    rw [hAj, map_mul, coordinateRestriction_C,
      coordinateRestriction_family_prod_of_notMem (s.erase j) i u hiu]
  have hErase : (s.erase j).erase i = (s.erase i).erase j := Finset.erase_right_comm
  apply scalar_and_support_eq ((s.erase i).erase j) hs t u ha hb
  calc
    C a * (∏ o ∈ t, coordinateFamily (R := K) ((s.erase i).erase j) o) =
        coordinateRestriction j (coordinateRestriction i A) := hleft.symm
    _ = coordinateRestriction i (coordinateRestriction j A) := coordinateRestriction_comm j i A
    _ = C b * (∏ o ∈ u, coordinateFamily (R := K) ((s.erase i).erase j) o) := by
      simpa only [hErase] using hright


end P14MatchingDoubleRestrictionSupport
end

section

/-!
Factors of the exact coordinate-restriction shape are scalar products of
distinct coordinates, with at most one copy of the coordinate sum.
This does not yet compare different coordinate restrictions or prove
irreducibility of the eliminated polynomial.
-/

noncomputable section

namespace P14MatchingRestrictionFactorization

open MvPolynomial P14MatchingRestrictionPolynomial
open scoped BigOperators

variable {σ K : Type*} [DecidableEq σ] [Field K]

theorem option_factor_product (s : Finset σ) (t : Finset (Option σ)) :
    (∏ o ∈ t, o.elim (variableSum s : MvPolynomial σ K) X) =
      (if none ∈ t then variableSum s else 1) * variableProduct t.eraseNone := by
  classical
  by_cases hn : none ∈ t
  · rw [if_pos hn]
    have ht : t.eraseNone.insertNone = t := by
      rw [Finset.insertNone_eraseNone, Finset.insert_eq_of_mem hn]
    calc
      (∏ o ∈ t, o.elim (variableSum s : MvPolynomial σ K) X) =
          ∏ o ∈ t.eraseNone.insertNone,
            o.elim (variableSum s : MvPolynomial σ K) X :=
        congrArg (fun u => ∏ o ∈ u, o.elim (variableSum s : MvPolynomial σ K) X) ht.symm
      _ = variableSum s * variableProduct t.eraseNone := by
        simp only [Finset.prod_insertNone, Option.elim, variableProduct]
  · rw [if_neg hn, one_mul, variableProduct, Finset.prod_eraseNone]
    apply Finset.prod_congr rfl
    intro o ho
    cases o with
    | none => exact (hn ho).elim
    | some i => rfl

/-- Every factor of a nonzero scalar times a coordinate sum times the squarefree
coordinate product has one of the two displayed forms. Primality is proved from
the actual coordinate polynomials; it is not a premise. -/
theorem factor_of_sum_mul_product (s : Finset σ) (hs : s.Nonempty)
    {c : K} (hc : c ≠ 0) {A B : MvPolynomial σ K}
    (hAB : A * B = C c * (variableSum s * variableProduct s)) :
    ∃ u : Finset σ, u ⊆ s ∧ ∃ a : K, a ≠ 0 ∧
      (A = C a * variableProduct u ∨
        A = C a * variableSum s * variableProduct u) := by
  classical
  let p : Option σ → MvPolynomial σ K := fun o => o.elim (variableSum s) X
  have hp : ∀ o ∈ s.insertNone, Prime (p o) := by
    intro o ho
    cases o with
    | none => exact P14MvPolynomialCoordinateSumPrime.prime_sum_X s hs
    | some i => exact MvPolynomial.X_prime (i := i)
  have hprod : (∏ o ∈ s.insertNone, p o) = variableSum s * variableProduct s := by
    simp only [Finset.prod_insertNone, p, Option.elim, variableProduct]
  obtain ⟨t, ht, a, ha, hA⟩ :=
    P14PrimeProductDivisor.scalar_subprod_of_mul_eq p s.insertNone hp hc
      (by simpa only [hprod] using hAB)
  refine ⟨t.eraseNone, ?_, a, ha, ?_⟩
  · intro i hi
    exact Finset.some_mem_insertNone.mp (ht (Finset.mem_eraseNone.mp hi))
  · change A = C a * (∏ o ∈ t, o.elim (variableSum s) X) at hA
    rw [option_factor_product] at hA
    by_cases hn : none ∈ t
    · right
      simpa only [if_pos hn, mul_assoc] using hA
    · left
      simpa only [if_neg hn, one_mul] using hA


end P14MatchingRestrictionFactorization
end
end

section

/-!
Simultaneous complementary factor descriptions for the actual matching
polynomial coordinate restrictions. The coefficients are nonzero and their
product is the exact restricted scalar. This is a local algebraic bridge,
not matching-polynomial irreducibility or full UPB construction.
-/

namespace P14MatchingComplementaryRestrictions

open MvPolynomial P14MatchingRestrictionPolynomial
open P14MvPolynomialCoordinateRestriction P14MatchingPolynomialCoordinateRestriction
open P14MvPolynomialCoordinateNonassociated P14MatchingDoubleRestrictionSupport
open scoped BigOperators

variable {σ K : Type*} [DecidableEq σ] [Field K]

/-- The full Option family product is the coordinate sum times the product. -/
theorem coordinateFamily_prod_insertNone (s : Finset σ) :
    (∏ o ∈ s.insertNone, coordinateFamily (R := K) s o) =
      variableSum s * variableProduct s := by
  simp only [Finset.prod_insertNone, coordinateFamily, variableSum, variableProduct]

/-- Omitting all coordinate labels leaves either the sum or the empty product. -/
theorem coordinateFamily_prod_of_eraseNone_eq_empty
    (s : Finset σ) (t : Finset (Option σ)) (ht : t.eraseNone = ∅) :
    (∏ o ∈ t, coordinateFamily (R := K) s o) =
      if none ∈ t then variableSum s else 1 := by
  have hf : coordinateFamily (R := K) s =
      (fun o => o.elim (variableSum s) X) := by
    funext o
    cases o <;> rfl
  rw [hf, P14MatchingRestrictionFactorization.option_factor_product, ht]
  simp only [variableProduct, Finset.prod_empty, mul_one]

/-- Selecting every coordinate label leaves no coordinate labels in the
literal complement. The optional sum label is not fixed by this statement. -/
theorem complement_eraseNone_eq_empty
    (s : Finset σ) (t : Finset (Option σ)) (ht : t.eraseNone = s) :
    (s.insertNone \ t).eraseNone = ∅ := by
  classical
  apply Finset.eq_empty_iff_forall_notMem.mpr
  intro i hi
  obtain ⟨his, hit⟩ := Finset.mem_sdiff.mp (Finset.mem_eraseNone.mp hi)
  apply hit
  apply Finset.mem_eraseNone.mp
  rw [ht]
  exact Finset.some_mem_insertNone.mp his

/-- An actual factorization induces complementary subsets of the distinct
coordinate/sum labels at each coordinate. No complementary-factor description
or graph conclusion is assumed. -/
theorem complementary_factors_of_eliminated
    (s : Finset σ) (c₀ : K) (c : σ → K) (i : σ) (hi : i ∈ s)
    (hs : (s.erase i).Nonempty) (hc : c i ≠ 0)
    {A B : MvPolynomial σ K} (hAB : A * B = eliminated s c₀ c) :
    ∃ t : Finset (Option σ), t ⊆ (s.erase i).insertNone ∧
      ∃ a : K, a ≠ 0 ∧ ∃ b : K, b ≠ 0 ∧ a * b = -c i ∧
        coordinateRestriction i A =
          C a * (∏ o ∈ t, coordinateFamily (R := K) (s.erase i) o) ∧
        coordinateRestriction i B =
          C b * (∏ o ∈ (s.erase i).insertNone \ t,
            coordinateFamily (R := K) (s.erase i) o) := by
  classical
  have hprod : coordinateRestriction i A * coordinateRestriction i B =
      C (-c i) * (∏ o ∈ (s.erase i).insertNone,
        coordinateFamily (R := K) (s.erase i) o) := by
    rw [← map_mul, hAB, coordinateRestriction_eliminated s c₀ c i hi,
      coordinateFamily_prod_insertNone, map_neg, mul_assoc]
  exact P14PrimeProductComplementaryScalar.complementary_scalar_subprod_of_mul_eq
    (coordinateFamily (R := K) (s.erase i)) (s.erase i).insertNone
    (fun o _ => coordinateFamily_prime (s.erase i) hs o) (neg_ne_zero.mpr hc) hprod


end P14MatchingComplementaryRestrictions
end

section

/-!
Source-only vanishing criterion for the actual coordinate/sum factor family.
The surviving sum needs only nonempty support. Crossed-coordinate membership
is symmetric for two factor descriptions of restrictions of one polynomial.
-/

namespace P14MatchingRestrictionVanishing

open MvPolynomial P14MatchingRestrictionPolynomial
open P14MvPolynomialCoordinateRestriction P14MvPolynomialCoordinateNonassociated
open P14MatchingDoubleRestrictionSupport
open scoped BigOperators

variable {σ K : Type*} [DecidableEq σ] [Field K]

/-- A selected crossed coordinate makes the restricted product zero. -/
theorem coordinateRestriction_family_prod_eq_zero_of_mem
    (s : Finset σ) (j : σ) (t : Finset (Option σ)) (hj : some j ∈ t) :
    coordinateRestriction j (∏ o ∈ t, coordinateFamily (R := K) s o) = 0 := by
  rw [map_prod]
  apply Finset.prod_eq_zero hj
  exact coordinateRestriction_X_self j

/-- A nonzero scalar times a family subproduct vanishes on restriction
exactly when the selected factors include the crossed coordinate. -/
theorem coordinateRestriction_scalar_family_prod_eq_zero_iff
    (s : Finset σ) (j : σ) (hs : (s.erase j).Nonempty)
    (t : Finset (Option σ)) {a : K} (ha : a ≠ 0) :
    coordinateRestriction j (C a * (∏ o ∈ t, coordinateFamily (R := K) s o)) = 0 ↔
      some j ∈ t := by
  classical
  constructor
  · intro hz
    by_cases hj : some j ∈ t
    · exact hj
    · have hC : (C a : MvPolynomial σ K) ≠ 0 := MvPolynomial.C_ne_zero.mpr ha
      have hprod : (∏ o ∈ t, coordinateFamily (R := K) (s.erase j) o) ≠ 0 :=
        Finset.prod_ne_zero_iff.mpr (fun o _ =>
          (coordinateFamily_prime (s.erase j) hs o).ne_zero)
      rw [map_mul, coordinateRestriction_C,
        coordinateRestriction_family_prod_of_notMem s j t hj] at hz
      exact ((mul_ne_zero hC hprod) hz).elim
  · intro hj
    rw [map_mul, coordinateRestriction_family_prod_eq_zero_of_mem s j t hj, mul_zero]

/-- Crossed coordinate labels occur symmetrically in two actual restriction
factor descriptions. Nonempty double-erased support suffices; no graph or
factor-support uniqueness conclusion is assumed. -/
theorem crossed_label_mem_iff
    (s : Finset σ) (i j : σ) (hs : ((s.erase i).erase j).Nonempty)
    (A : MvPolynomial σ K) (t u : Finset (Option σ))
    {a b : K} (ha : a ≠ 0) (hb : b ≠ 0)
    (hAi : coordinateRestriction i A =
      C a * (∏ o ∈ t, coordinateFamily (R := K) (s.erase i) o))
    (hAj : coordinateRestriction j A =
      C b * (∏ o ∈ u, coordinateFamily (R := K) (s.erase j) o)) :
    some j ∈ t ↔ some i ∈ u := by
  have hErase : (s.erase j).erase i = (s.erase i).erase j := Finset.erase_right_comm
  have hs' : ((s.erase j).erase i).Nonempty := by
    rw [hErase]
    exact hs
  have hleft : coordinateRestriction j (coordinateRestriction i A) = 0 ↔ some j ∈ t := by
    rw [hAi]
    exact coordinateRestriction_scalar_family_prod_eq_zero_iff (s.erase i) j hs t ha
  have hright : coordinateRestriction i (coordinateRestriction j A) = 0 ↔ some i ∈ u := by
    rw [hAj]
    exact coordinateRestriction_scalar_family_prod_eq_zero_iff (s.erase j) i hs' u hb
  constructor
  · intro hj
    apply hright.mp
    rw [← coordinateRestriction_comm j i A]
    exact hleft.mpr hj
  · intro hi
    apply hleft.mp
    rw [coordinateRestriction_comm j i A]
    exact hright.mpr hi


end P14MatchingRestrictionVanishing
end

section

/-! The coordinate-restriction factor graph is complete or empty when
every two vertices have identical adjacency to each third vertex. -/

namespace P14CoordinateFactorGraph

theorem eq_bot_or_eq_top {V : Type*} (G : SimpleGraph V)
    (h : ∀ i j x : V, i ≠ x → j ≠ x → (G.Adj i x ↔ G.Adj j x)) :
    G = ⊥ ∨ G = ⊤ := by
  classical
  by_cases hempty : ∀ a b, ¬ G.Adj a b
  · left
    ext a b
    rw [SimpleGraph.bot_adj]
    exact iff_false_intro (hempty a b)
  · obtain ⟨a, ha⟩ := not_forall.mp hempty
    obtain ⟨b, hb⟩ := not_forall.mp ha
    have hab : G.Adj a b := not_not.mp hb
    have hba : G.Adj b a := G.adj_symm hab
    have hcol : ∀ c, c ≠ a → G.Adj c a := by
      intro c hca
      exact (h c b a hca (G.ne_of_adj hba)).mpr hba
    right
    ext u v
    rw [SimpleGraph.top_adj]
    constructor
    · exact G.ne_of_adj
    · intro huv
      by_cases hva : v = a
      · subst v
        exact hcol u huv
      · have hav : G.Adj a v := G.adj_symm (hcol v hva)
        exact (h u a v huv (Ne.symm hva)).mpr hav

end P14CoordinateFactorGraph
end

section

/-!
Source-only graph assembly from actual restrictions of two polynomials.
At every coordinate, the second polynomial uses the literal complement of
the first polynomial's selected Option labels. Adjacency consistency is
derived by comparing the first polynomial on nonedges and the second on
edges. This does not construct the descriptions from a factorization and
does not prove matching-polynomial irreducibility or the full UPB bound.
-/

namespace P14MatchingRestrictionGraphAssembly

open MvPolynomial P14MvPolynomialCoordinateRestriction
open P14MvPolynomialCoordinateNonassociated P14MatchingDoubleRestrictionSupport
open P14MatchingRestrictionVanishing
open scoped BigOperators

variable {σ K : Type*} [DecidableEq σ] [Field K]

private theorem double_erase_card_ge_two
    (s : Finset σ) (hs : 4 ≤ s.card) (i j : σ) :
    2 ≤ ((s.erase i).erase j).card := by
  calc
    2 = (4 - 1 : ℕ) - 1 := rfl
    _ ≤ (s.card - 1) - 1 :=
      Nat.sub_le_sub_right (Nat.sub_le_sub_right hs 1) 1
    _ ≤ (s.erase i).card - 1 :=
      Nat.sub_le_sub_right (Finset.pred_card_le_card_erase (s := s) (a := i)) 1
    _ ≤ ((s.erase i).erase j).card := Finset.pred_card_le_card_erase

/-- The selected coordinate labels are either empty at every coordinate or
all the other coordinates at every coordinate. The sum label is not classified.
The hypotheses are simultaneous descriptions of actual restrictions, with
literal complementary supports and nonzero scalars; no graph consistency
hypothesis is supplied. -/
theorem selected_coordinates_empty_or_complete
    (s : Finset σ) (hs : 4 ≤ s.card) (A B : MvPolynomial σ K)
    (t : σ → Finset (Option σ)) (a b : σ → K)
    (ht : ∀ i ∈ s, t i ⊆ (s.erase i).insertNone)
    (ha : ∀ i ∈ s, a i ≠ 0) (hb : ∀ i ∈ s, b i ≠ 0)
    (hA : ∀ i ∈ s, coordinateRestriction i A =
      C (a i) * (∏ o ∈ t i, coordinateFamily (R := K) (s.erase i) o))
    (hB : ∀ i ∈ s, coordinateRestriction i B =
      C (b i) * (∏ o ∈ (s.erase i).insertNone \ t i,
        coordinateFamily (R := K) (s.erase i) o)) :
    (∀ i ∈ s, (t i).eraseNone = ∅) ∨
      (∀ i ∈ s, (t i).eraseNone = s.erase i) := by
  classical
  have hcard (i j : σ) : 2 ≤ ((s.erase i).erase j).card :=
    double_erase_card_ge_two s hs i j
  have hsym (i : σ) (hi : i ∈ s) (j : σ) (hj : j ∈ s) :
      some j ∈ t i ↔ some i ∈ t j :=
    crossed_label_mem_iff s i j
      (Finset.one_le_card.mp ((Nat.le_succ 1).trans (hcard i j)))
      A (t i) (t j) (ha i hi) (ha j hj) (hA i hi) (hA j hj)
  have hself (i : σ) (hi : i ∈ s) : some i ∉ t i := by
    intro h
    exact Finset.notMem_erase i s (Finset.some_mem_insertNone.mp (ht i hi h))
  have hthird (i : σ) (hi : i ∈ s) (j : σ) (hj : j ∈ s)
      (x : σ) (hx : x ∈ s) (hix : i ≠ x) (hjx : j ≠ x) :
      some x ∈ t i ↔ some x ∈ t j := by
    by_cases hij : some j ∈ t i
    · have hji : some i ∈ t j := (hsym i hi j hj).mp hij
      have hcomp : (s.erase i).insertNone \ t i = (s.erase j).insertNone \ t j :=
        (doubleRestriction_support_and_scalar_eq s i j (hcard i j) B
          ((s.erase i).insertNone \ t i) ((s.erase j).insertNone \ t j)
          (hb i hi) (hb j hj) (hB i hi) (hB j hj)
          (fun h => (Finset.mem_sdiff.mp h).2 hij)
          (fun h => (Finset.mem_sdiff.mp h).2 hji)).1
      have hxi : some x ∈ (s.erase i).insertNone :=
        Finset.some_mem_insertNone.mpr (Finset.mem_erase.mpr ⟨hix.symm, hx⟩)
      have hxj : some x ∈ (s.erase j).insertNone :=
        Finset.some_mem_insertNone.mpr (Finset.mem_erase.mpr ⟨hjx.symm, hx⟩)
      constructor
      · intro hxti
        by_contra hxtj
        have hxcj : some x ∈ (s.erase j).insertNone \ t j :=
          Finset.mem_sdiff.mpr ⟨hxj, hxtj⟩
        have hxci : some x ∈ (s.erase i).insertNone \ t i := by
          rw [hcomp]
          exact hxcj
        exact (Finset.mem_sdiff.mp hxci).2 hxti
      · intro hxtj
        by_contra hxti
        have hxci : some x ∈ (s.erase i).insertNone \ t i :=
          Finset.mem_sdiff.mpr ⟨hxi, hxti⟩
        have hxcj : some x ∈ (s.erase j).insertNone \ t j := by
          rw [← hcomp]
          exact hxci
        exact (Finset.mem_sdiff.mp hxcj).2 hxtj
    · have hji : some i ∉ t j := fun h => hij ((hsym i hi j hj).mpr h)
      have heq : t i = t j :=
        (doubleRestriction_support_and_scalar_eq s i j (hcard i j) A
          (t i) (t j) (ha i hi) (ha j hj) (hA i hi) (hA j hj) hij hji).1
      rw [heq]
  let G : SimpleGraph {i : σ // i ∈ s} := {
    Adj := fun i j => some (j : σ) ∈ t (i : σ)
    symm := ⟨fun i j hij => (hsym i i.property j j.property).mp hij⟩
    loopless := ⟨fun i => hself i i.property⟩ }
  have hG : G = ⊥ ∨ G = ⊤ := by
    apply P14CoordinateFactorGraph.eq_bot_or_eq_top G
    intro i j x hix hjx
    change some (x : σ) ∈ t (i : σ) ↔ some (x : σ) ∈ t (j : σ)
    exact hthird i i.property j j.property x x.property
      (fun h => hix (Subtype.ext h)) (fun h => hjx (Subtype.ext h))
  rcases hG with hempty | hcomplete
  · left
    intro i hi
    apply Finset.eq_empty_iff_forall_notMem.mpr
    intro j hj
    have hjt : some j ∈ t i := Finset.mem_eraseNone.mp hj
    have hjs : j ∈ s := Finset.mem_of_mem_erase
      (Finset.some_mem_insertNone.mp (ht i hi hjt))
    have hadj : G.Adj ⟨i, hi⟩ ⟨j, hjs⟩ := hjt
    exact (SimpleGraph.bot_adj _ _).mp (hempty ▸ hadj)
  · right
    intro i hi
    apply Finset.ext
    intro j
    constructor
    · intro hj
      exact Finset.some_mem_insertNone.mp (ht i hi (Finset.mem_eraseNone.mp hj))
    · intro hj
      obtain ⟨hji, hjs⟩ := Finset.mem_erase.mp hj
      have hadj : (⊤ : SimpleGraph {x : σ // x ∈ s}).Adj ⟨i, hi⟩ ⟨j, hjs⟩ :=
        (SimpleGraph.top_adj _ _).mpr (fun h => hji (congrArg Subtype.val h).symm)
      rw [← hcomplete] at hadj
      exact Finset.mem_eraseNone.mpr hadj


end P14MatchingRestrictionGraphAssembly
end

section

/-!
An actual factorization of the eliminated matching polynomial forces one
of the two factors to have, at every supported coordinate, a restriction
that is either a nonzero scalar times the erased coordinate sum or a
nonzero constant. The choice of factor is global; the two forms may vary
with the coordinate. No homogeneity or irreducibility is concluded here.
-/

namespace P14MatchingFactorRestrictionDichotomy

open MvPolynomial P14MatchingRestrictionPolynomial
open P14MvPolynomialCoordinateRestriction P14MvPolynomialCoordinateNonassociated
open P14MatchingComplementaryRestrictions P14MatchingRestrictionGraphAssembly
open scoped BigOperators

variable {σ K : Type*} [DecidableEq σ] [Field K]

/-- Complementary prime-factor descriptions and the restriction graph give
a global choice of factor whose coordinate restrictions have no coordinate
factors. The optional sum factor is retained as a per-coordinate disjunction. -/
theorem factor_restriction_dichotomy
    (s : Finset σ) (hs : 4 ≤ s.card) (c₀ : K) (c : σ → K)
    (hc : ∀ i ∈ s, c i ≠ 0)
    {A B : MvPolynomial σ K} (hAB : A * B = eliminated s c₀ c) :
    (∀ i ∈ s, ∃ a : K, a ≠ 0 ∧
      (coordinateRestriction i A = C a * variableSum (s.erase i) ∨
        coordinateRestriction i A = C a)) ∨
    (∀ i ∈ s, ∃ b : K, b ≠ 0 ∧
      (coordinateRestriction i B = C b * variableSum (s.erase i) ∨
        coordinateRestriction i B = C b)) := by
  classical
  have htwo : 2 ≤ s.card :=
    (Nat.le_succ 2).trans ((Nat.le_succ 3).trans hs)
  have hnonempty (i : σ) : (s.erase i).Nonempty := by
    obtain ⟨j, hj, hji⟩ := Finset.exists_mem_ne (s := s) htwo i
    exact ⟨j, Finset.mem_erase.mpr ⟨hji, hj⟩⟩
  have hex (i : σ) :
      ∃ t : Finset (Option σ), ∃ a b : K, i ∈ s →
        t ⊆ (s.erase i).insertNone ∧ a ≠ 0 ∧ b ≠ 0 ∧
          coordinateRestriction i A =
            C a * (∏ o ∈ t, coordinateFamily (R := K) (s.erase i) o) ∧
          coordinateRestriction i B =
            C b * (∏ o ∈ (s.erase i).insertNone \ t,
              coordinateFamily (R := K) (s.erase i) o) := by
    by_cases hi : i ∈ s
    · obtain ⟨t, ht, a, ha, b, hb, hab, hA, hB⟩ :=
        complementary_factors_of_eliminated s c₀ c i hi (hnonempty i) (hc i hi) hAB
      exact ⟨t, a, b, fun _ => ⟨ht, ha, hb, hA, hB⟩⟩
    · exact ⟨∅, 1, 1, fun h => (hi h).elim⟩
  obtain ⟨t, ht⟩ := Classical.axiomOfChoice hex
  obtain ⟨a, ha⟩ := Classical.axiomOfChoice ht
  obtain ⟨b, hd⟩ := Classical.axiomOfChoice ha
  have hgraph := selected_coordinates_empty_or_complete s hs A B t a b
    (fun i hi => (hd i hi).1)
    (fun i hi => (hd i hi).2.1)
    (fun i hi => (hd i hi).2.2.1)
    (fun i hi => (hd i hi).2.2.2.1)
    (fun i hi => (hd i hi).2.2.2.2)
  rcases hgraph with hempty | hcomplete
  · left
    intro i hi
    refine ⟨a i, (hd i hi).2.1, ?_⟩
    have hAi := (hd i hi).2.2.2.1
    rw [coordinateFamily_prod_of_eraseNone_eq_empty
      (s.erase i) (t i) (hempty i hi)] at hAi
    by_cases hn : none ∈ t i
    · left
      simpa only [if_pos hn] using hAi
    · right
      simpa only [if_neg hn, mul_one] using hAi
  · right
    intro i hi
    refine ⟨b i, (hd i hi).2.2.1, ?_⟩
    have hBi := (hd i hi).2.2.2.2
    have hcompempty := complement_eraseNone_eq_empty
      (s.erase i) (t i) (hcomplete i hi)
    rw [coordinateFamily_prod_of_eraseNone_eq_empty
      (s.erase i) ((s.erase i).insertNone \ t i) hcompempty] at hBi
    by_cases hn : none ∈ (s.erase i).insertNone \ t i
    · left
      simpa only [if_pos hn] using hBi
    · right
      simpa only [if_neg hn, mul_one] using hBi


end P14MatchingFactorRestrictionDichotomy
end

section

/-!
Source-only reconstruction from actual zero-coordinate restrictions.
Homogeneous degree one is recovered from a nonzero linear restriction.
Two distinct restrictions determine a homogeneous linear polynomial; a third
surviving coordinate identifies their scalar coefficients.

All restriction equalities are in the full ambient polynomial ring. No
unstated support condition or projection to a smaller variable type is used.
Root owns compilation and actual transitive axiom reports.
-/

noncomputable section

namespace P14MvPolynomialLinearReconstruction

open MvPolynomial P14MvPolynomialCoordinateRestriction
open P14MatchingRestrictionPolynomial P14MatchingPolynomialCoordinateRestriction
open P14MvPolynomialCoordinateNonassociated

variable {σ R : Type*}

section Semiring

variable [CommSemiring R]

theorem coordinateRestriction_smul (i : σ) (a : R) (P : MvPolynomial σ R) :
    coordinateRestriction i (a • P) = a • coordinateRestriction i P := by
  simp only [MvPolynomial.smul_eq_C_mul, map_mul, coordinateRestriction_C]

/-- The inclusion-exclusion identity for a homogeneous polynomial of degree one. -/
theorem homogeneous_one_two_restrictions (i j : σ) (hij : i ≠ j)
    {P : MvPolynomial σ R} (hP : P.IsHomogeneous 1) :
    P + coordinateRestriction i (coordinateRestriction j P) =
      coordinateRestriction i P + coordinateRestriction j P := by
  classical
  have hspan : P ∈ Submodule.span R (Set.range (X : σ → MvPolynomial σ R)) := by
    rw [← MvPolynomial.homogeneousSubmodule_one_eq_span_X]
    exact hP
  clear hP
  induction hspan using Submodule.span_induction with
  | mem Q hQ =>
      obtain ⟨k, rfl⟩ := hQ
      by_cases hki : k = i
      · subst k
        simp only [coordinateRestriction_X_self,
          coordinateRestriction_X_of_ne j i hij, map_zero, add_zero, zero_add]
      · by_cases hkj : k = j
        · subst k
          simp only [coordinateRestriction_X_self,
            coordinateRestriction_X_of_ne i j hij.symm, map_zero, add_zero, zero_add]
        · simp only [coordinateRestriction_X_of_ne i k hki,
            coordinateRestriction_X_of_ne j k hkj]
  | zero => simp only [map_zero, add_zero]
  | add P Q _ _ hP hQ =>
      simp only [map_add]
      calc
        P + Q + (coordinateRestriction i (coordinateRestriction j P) +
            coordinateRestriction i (coordinateRestriction j Q)) =
          (P + coordinateRestriction i (coordinateRestriction j P)) +
            (Q + coordinateRestriction i (coordinateRestriction j Q)) :=
          add_add_add_comm _ _ _ _
        _ = (coordinateRestriction i P + coordinateRestriction j P) +
            (coordinateRestriction i Q + coordinateRestriction j Q) := by
          rw [hP, hQ]
        _ = (coordinateRestriction i P + coordinateRestriction i Q) +
            (coordinateRestriction j P + coordinateRestriction j Q) :=
          add_add_add_comm _ _ _ _
  | smul a P _ hP =>
      simpa only [coordinateRestriction_smul, smul_add] using
        congrArg (fun Q : MvPolynomial σ R => a • Q) hP

theorem eq_zero_of_homogeneous_one_restrictions (i j : σ) (hij : i ≠ j)
    {P : MvPolynomial σ R} (hP : P.IsHomogeneous 1)
    (hi : coordinateRestriction i P = 0) (hj : coordinateRestriction j P = 0) :
    P = 0 := by
  have h := homogeneous_one_two_restrictions i j hij hP
  simpa only [hi, hj, map_zero, add_zero] using h

/-- A positive-degree homogeneous polynomial cannot restrict to a nonzero constant. -/
theorem coordinateRestriction_ne_nonzero_C (i : σ) {P : MvPolynomial σ R} {d : ℕ}
    (hP : P.IsHomogeneous d) (hd : 0 < d) {a : R} (ha : a ≠ 0) :
    coordinateRestriction i P ≠ C a := by
  intro hEq
  have hC : (C a : MvPolynomial σ R).IsHomogeneous d :=
    hEq ▸ isHomogeneous_coordinateRestriction i hP
  have hd0 : d = 0 := hC.inj_right (MvPolynomial.isHomogeneous_C σ a)
    (MvPolynomial.C_ne_zero.mpr ha)
  exact (ne_of_gt hd) hd0

end Semiring

section Ring

variable [CommRing R]

theorem eq_of_homogeneous_one_restrictions (i j : σ) (hij : i ≠ j)
    {P Q : MvPolynomial σ R} (hP : P.IsHomogeneous 1) (hQ : Q.IsHomogeneous 1)
    (hi : coordinateRestriction i P = coordinateRestriction i Q)
    (hj : coordinateRestriction j P = coordinateRestriction j Q) : P = Q := by
  apply sub_eq_zero.mp
  apply eq_zero_of_homogeneous_one_restrictions i j hij (hP.sub hQ)
  · rw [RingHom.map_sub, hi, sub_self]
  · rw [RingHom.map_sub, hj, sub_self]

variable [DecidableEq σ] [Nontrivial R]

theorem scalar_eq_of_mul_variableSum_eq (s : Finset σ) (hs : s.Nonempty)
    {a b : R} (h : C a * variableSum s = (C b * variableSum s : MvPolynomial σ R)) :
    a = b := by
  obtain ⟨k, hk⟩ := hs
  have hc := congrArg (MvPolynomial.coeff (Finsupp.single k 1)) h
  simpa only [variableSum, coeff_C_mul, coeff_coordinate_sum, if_pos hk, mul_one] using hc

theorem C_mul_variableSum_ne_zero (s : Finset σ) (hs : s.Nonempty)
    {a : R} (ha : a ≠ 0) : (C a * variableSum s : MvPolynomial σ R) ≠ 0 := by
  obtain ⟨k, hk⟩ := hs
  intro hz
  have hc := congrArg (MvPolynomial.coeff (Finsupp.single k 1)) hz
  apply ha
  simpa only [variableSum, coeff_C_mul, coeff_coordinate_sum, if_pos hk,
    mul_one, coeff_zero] using hc

/-- A nonzero scalar-sum restriction determines the homogeneous degree. -/
theorem homogeneous_degree_eq_one_of_restriction (i : σ) (s : Finset σ)
    (hs : s.Nonempty) {P : MvPolynomial σ R} {d : ℕ}
    (hP : P.IsHomogeneous d) {a : R} (ha : a ≠ 0)
    (hi : coordinateRestriction i P = C a * variableSum s) : d = 1 := by
  have hLinear : (coordinateRestriction i P).IsHomogeneous 1 := by
    rw [hi]
    exact (variableSum_isHomogeneous s).C_mul a
  have hNonzero : coordinateRestriction i P ≠ 0 := by
    rw [hi]
    exact C_mul_variableSum_ne_zero s hs ha
  exact (isHomogeneous_coordinateRestriction i hP).inj_right hLinear hNonzero

/-- Three finite support coordinates suffice. The ambient variable type may be infinite.
The hypotheses are literal equalities in MvPolynomial σ R, not projected equalities. -/
theorem reconstruct_from_scalar_sum_restrictions (s : Finset σ) (hs : 2 < s.card)
    {P : MvPolynomial σ R} {d : ℕ} (hP : P.IsHomogeneous d)
    (hRestrictions : ∀ i ∈ s, ∃ a : R, a ≠ 0 ∧
      coordinateRestriction i P = C a * variableSum (s.erase i)) :
    d = 1 ∧ ∃ a : R, a ≠ 0 ∧ P = C a * variableSum s := by
  obtain ⟨i, j, k, hi, hj, hk, hij, hik, hjk⟩ := Finset.two_lt_card_iff.mp hs
  obtain ⟨a, ha, hPi⟩ := hRestrictions i hi
  obtain ⟨b, _hb, hPj⟩ := hRestrictions j hj
  have hji : j ∈ s.erase i := Finset.mem_erase.mpr ⟨hij.symm, hj⟩
  have hkij : k ∈ (s.erase i).erase j :=
    Finset.mem_erase.mpr ⟨hjk.symm, Finset.mem_erase.mpr ⟨hik.symm, hk⟩⟩
  have hErase : (s.erase j).erase i = (s.erase i).erase j := Finset.erase_right_comm
  have hScalar : C a * variableSum ((s.erase i).erase j) =
      (C b * variableSum ((s.erase i).erase j) : MvPolynomial σ R) := by
    calc
      C a * variableSum ((s.erase i).erase j) =
          coordinateRestriction j (coordinateRestriction i P) := by
        rw [hPi, map_mul, coordinateRestriction_C, coordinateRestriction_variableSum]
      _ = coordinateRestriction i (coordinateRestriction j P) :=
        coordinateRestriction_comm j i P
      _ = C b * variableSum ((s.erase i).erase j) := by
        rw [hPj, map_mul, coordinateRestriction_C, coordinateRestriction_variableSum, hErase]
  have hab : a = b := scalar_eq_of_mul_variableSum_eq _ ⟨k, hkij⟩ hScalar
  have hd : d = 1 := homogeneous_degree_eq_one_of_restriction i (s.erase i)
    ⟨j, hji⟩ hP ha hPi
  have hP1 : P.IsHomogeneous 1 := hd ▸ hP
  refine ⟨hd, a, ha, ?_⟩
  apply eq_of_homogeneous_one_restrictions i j hij hP1 ((variableSum_isHomogeneous s).C_mul a)
  · rw [map_mul, coordinateRestriction_C, coordinateRestriction_variableSum]
    exact hPi
  · rw [map_mul, coordinateRestriction_C, coordinateRestriction_variableSum, hab]
    exact hPj

/-- Finite-universe specialization for the eventual elementary matching theorem. -/
theorem reconstruct_from_univ_scalar_sum_restrictions [Fintype σ]
    (hcard : 2 < Fintype.card σ) {P : MvPolynomial σ R} {d : ℕ}
    (hP : P.IsHomogeneous d)
    (hRestrictions : ∀ i : σ, ∃ a : R, a ≠ 0 ∧
      coordinateRestriction i P = C a * variableSum (Finset.univ.erase i)) :
    d = 1 ∧ ∃ a : R, a ≠ 0 ∧ P = C a * variableSum Finset.univ := by
  apply reconstruct_from_scalar_sum_restrictions Finset.univ
  · simpa only [Finset.card_univ] using hcard
  · exact hP
  · intro i _hi
    exact hRestrictions i

end Ring


end P14MvPolynomialLinearReconstruction
end
end

section

/-!
Scaling all multivariate variables by one new univariate variable.

The map is `P(x) ↦ P(t*x)`. Its univariate coefficient at `q` is the
canonical homogeneous component of degree `q` of the original polynomial.
This source uses the canonical Mathlib definitions and requires no finite
variable set, domain hypothesis, or nonzero-polynomial assumption.

Source-only draft: root owns compilation, dependency review, and axiom checks.
-/

noncomputable section

namespace P14MvPolynomialScaling

open scoped BigOperators

variable {σ R : Type*} [CommSemiring R]

/-- Substitute `C (X i) * X` for every multivariate variable. -/
def scalingHom : MvPolynomial σ R →+* Polynomial (MvPolynomial σ R) :=
  MvPolynomial.eval₂Hom
    ((Polynomial.C : MvPolynomial σ R →+* Polynomial (MvPolynomial σ R)).comp
      MvPolynomial.C)
    (fun i => Polynomial.C (MvPolynomial.X i) * Polynomial.X)

private theorem scaled_variable_prod (d : σ →₀ ℕ) :
    (∏ i ∈ d.support,
      (Polynomial.C (MvPolynomial.X i : MvPolynomial σ R) * Polynomial.X) ^ d i) =
      Polynomial.C (MvPolynomial.monomial d (1 : R)) * Polynomial.X ^ d.degree := by
  classical
  simp only [mul_pow, ← Polynomial.C_pow]
  rw [Finset.prod_mul_distrib, ← map_prod, Finset.prod_pow_eq_pow_sum,
    ← Finsupp.degree_apply, MvPolynomial.prod_X_pow_eq_monomial]

/-- A monomial becomes a single univariate monomial at its total exponent degree. -/
theorem scaling_monomial (d : σ →₀ ℕ) (r : R) :
    scalingHom (MvPolynomial.monomial d r) =
      Polynomial.monomial d.degree (MvPolynomial.monomial d r) := by
  classical
  simp only [scalingHom, MvPolynomial.eval₂Hom_monomial, RingHom.comp_apply,
    Finsupp.prod]
  rw [scaled_variable_prod, ← mul_assoc, ← Polynomial.C_mul,
    MvPolynomial.C_mul_monomial, mul_one, Polynomial.C_mul_X_pow_eq_monomial]

/-- The explicit finite support expansion of the scaling map. -/
def supportSum (P : MvPolynomial σ R) : Polynomial (MvPolynomial σ R) :=
  ∑ d ∈ P.support,
    Polynomial.monomial d.degree (MvPolynomial.monomial d (MvPolynomial.coeff d P))

theorem supportSum_eq_scaling (P : MvPolynomial σ R) :
    supportSum P = scalingHom P := by
  classical
  calc
    supportSum P = ∑ d ∈ P.support,
        scalingHom (MvPolynomial.monomial d (MvPolynomial.coeff d P)) := by
      unfold supportSum
      apply Finset.sum_congr rfl
      intro d hd
      exact (scaling_monomial d (MvPolynomial.coeff d P)).symm
    _ = scalingHom (∑ d ∈ P.support,
        MvPolynomial.monomial d (MvPolynomial.coeff d P)) := (map_sum _ _ _).symm
    _ = scalingHom P := congrArg scalingHom (MvPolynomial.support_sum_monomial_coeff P)

/-- Substituting one for the new variable recovers the original polynomial. -/
theorem eval_one_scaling (P : MvPolynomial σ R) :
    (scalingHom P).eval 1 = P := by
  induction P using MvPolynomial.induction_on' with
  | monomial d r =>
      rw [scaling_monomial, Polynomial.eval_monomial, one_pow, mul_one]
  | add P Q hP hQ =>
      rw [map_add, Polynomial.eval_add, hP, hQ]

theorem scalingHom_injective :
    Function.Injective (scalingHom (σ := σ) (R := R)) := by
  intro P Q h
  have h' := congrArg
    (fun f : Polynomial (MvPolynomial σ R) => f.eval 1) h
  simpa only [eval_one_scaling] using h'

/-- The exact coefficient bridge to Mathlib's canonical homogeneous component. -/
theorem coeff_scaling (P : MvPolynomial σ R) (q : ℕ) :
    (scalingHom P).coeff q = MvPolynomial.homogeneousComponent q P := by
  induction P using MvPolynomial.induction_on' with
  | monomial d r =>
      rw [scaling_monomial, Polynomial.coeff_monomial,
        MvPolynomial.homogeneousComponent_of_mem
          (MvPolynomial.isHomogeneous_monomial r rfl)]
      by_cases h : d.degree = q
      · simp [h]
      · simp [h, Ne.symm h]
  | add P Q hP hQ =>
      rw [map_add, Polynomial.coeff_add, map_add, hP, hQ]

/-- Homogeneity becomes a single univariate degree, with the original polynomial as coefficient. -/
theorem scaling_of_isHomogeneous {P : MvPolynomial σ R} {q : ℕ}
    (h : P.IsHomogeneous q) :
    scalingHom P = Polynomial.monomial q P := by
  apply Polynomial.ext
  intro j
  rw [coeff_scaling, MvPolynomial.homogeneousComponent_of_mem h,
    Polynomial.coeff_monomial]
  by_cases hj : j = q
  · simp [hj]
  · simp [hj, Ne.symm hj]


end P14MvPolynomialScaling
end
end

section

/-!
Homogeneous factors of a nonzero homogeneous multivariate product.

Scaling by a new variable makes the highest and lowest degrees additive.
Equality of their sums forces equality for each factor. Nonzero original
coefficients then lie at that single degree by the canonical scaling bridge.

Source-only draft: compilation and transitive axiom checks belong to root.
-/

noncomputable section

namespace P14MvPolynomialHomogeneousFactors

open P14MvPolynomialScaling

variable {σ R : Type*} [CommSemiring R]

/-- A scaled polynomial with a single possible degree comes from a homogeneous polynomial. -/
theorem isHomogeneous_of_scaling_degrees_eq (P : MvPolynomial σ R)
    (h : (scalingHom P).natTrailingDegree = (scalingHom P).natDegree) :
    P.IsHomogeneous (scalingHom P).natDegree := by
  intro s hs
  have hc : (scalingHom P).coeff s.degree ≠ 0 := by
    intro hz
    have hz' := congrArg (MvPolynomial.coeff s) hz
    rw [coeff_scaling, MvPolynomial.coeff_homogeneousComponent,
      if_pos rfl, MvPolynomial.coeff_zero] at hz'
    exact hs hz'
  have hLower := Polynomial.natTrailingDegree_le_of_ne_zero hc
  have hUpper := Polynomial.le_natDegree_of_ne_zero hc
  rw [h] at hLower
  have hDegree : s.degree = (scalingHom P).natDegree := le_antisymm hUpper hLower
  simpa only [Finsupp.degree_eq_weight_one, Pi.one_def] using hDegree

section NoZeroDivisors

variable [NoZeroDivisors R]

/-- A nonzero homogeneous product has homogeneous factors at their actual total degrees. -/
theorem homogeneous_factors {A B : MvPolynomial σ R} {d : ℕ}
    (hAB : A * B ≠ 0) (h : (A * B).IsHomogeneous d) :
    A.IsHomogeneous A.totalDegree ∧
      B.IsHomogeneous B.totalDegree ∧
      A.totalDegree + B.totalDegree = d := by
  have hA : A ≠ 0 := left_ne_zero_of_mul hAB
  have hB : B ≠ 0 := right_ne_zero_of_mul hAB
  have hScaleA : scalingHom A ≠ 0 := by
    intro hz
    apply hA
    apply scalingHom_injective
    simpa only [map_zero] using hz
  have hScaleB : scalingHom B ≠ 0 := by
    intro hz
    apply hB
    apply scalingHom_injective
    simpa only [map_zero] using hz
  have hProduct : scalingHom A * scalingHom B = Polynomial.monomial d (A * B) := by
    rw [← map_mul]
    exact scaling_of_isHomogeneous h
  have hTop : (scalingHom A).natDegree + (scalingHom B).natDegree = d := by
    rw [← Polynomial.natDegree_mul hScaleA hScaleB, hProduct,
      Polynomial.natDegree_monomial_eq d hAB]
  have hBottom :
      (scalingHom A).natTrailingDegree + (scalingHom B).natTrailingDegree = d := by
    rw [← Polynomial.natTrailingDegree_mul hScaleA hScaleB, hProduct,
      Polynomial.natTrailingDegree_monomial hAB]
  have hDegrees :
      (scalingHom A).natTrailingDegree = (scalingHom A).natDegree ∧
        (scalingHom B).natTrailingDegree = (scalingHom B).natDegree :=
    (add_eq_add_iff_eq_and_eq
      (Polynomial.natTrailingDegree_le_natDegree (scalingHom A))
      (Polynomial.natTrailingDegree_le_natDegree (scalingHom B))).mp
        (hBottom.trans hTop.symm)
  have hHomA := isHomogeneous_of_scaling_degrees_eq A hDegrees.1
  have hHomB := isHomogeneous_of_scaling_degrees_eq B hDegrees.2
  have hDegreeA : A.totalDegree = (scalingHom A).natDegree := hHomA.totalDegree hA
  have hDegreeB : B.totalDegree = (scalingHom B).natDegree := hHomB.totalDegree hB
  refine ⟨?_, ?_, ?_⟩
  · rw [hDegreeA]
    exact hHomA
  · rw [hDegreeB]
    exact hHomB
  · rw [hDegreeA, hDegreeB]
    exact hTop

end NoZeroDivisors


end P14MvPolynomialHomogeneousFactors
end
end

section

/-!
Source-only assembly: the coordinate sum cannot divide the actual eliminated
matching polynomial when its support has at least two coordinates and the
leading scalar is nonzero. The other coefficients are unrestricted.
-/

namespace P14MatchingPolynomialSumObstruction

open MvPolynomial P14MatchingRestrictionPolynomial
open scoped BigOperators

variable {σ K : Type*} [DecidableEq σ] [Field K]

/-- A sum of at least two distinct coordinate variables cannot divide their
coordinate product. Primality and nonassociation are proved by the imported
coordinate lemmas, rather than assumed as hypotheses. -/
theorem variableSum_not_dvd_variableProduct (s : Finset σ) (hs : 2 ≤ s.card) :
    ¬ (variableSum s : MvPolynomial σ K) ∣ variableProduct s := by
  have hsn : s.Nonempty := Finset.one_le_card.mp ((Nat.le_succ 1).trans hs)
  have hS : Prime (variableSum s : MvPolynomial σ K) :=
    P14MvPolynomialCoordinateSumPrime.prime_sum_X s hsn
  intro hdiv
  change (variableSum s : MvPolynomial σ K) ∣ ∏ i ∈ s, X i at hdiv
  obtain ⟨i, hi, hSi⟩ := hS.exists_mem_finset_dvd hdiv
  have hassoc : Associated (variableSum s : MvPolynomial σ K) (X i) :=
    hS.associated_of_dvd (MvPolynomial.X_prime (i := i)) hSi
  exact P14MvPolynomialCoordinateNonassociated.not_associated_sum_X s hs i hassoc

/-- The full coordinate sum does not divide the eliminated polynomial. Only
the leading coefficient is required to be nonzero. -/
theorem variableSum_not_dvd_eliminated (s : Finset σ) (hs : 2 ≤ s.card)
    {c₀ : K} (hc₀ : c₀ ≠ 0) (c : σ → K) :
    ¬ (variableSum s : MvPolynomial σ K) ∣ eliminated s c₀ c := by
  intro hdiv
  change (variableSum s : MvPolynomial σ K) ∣
    C c₀ * variableProduct s - variableSum s * reciprocalNumerator s c at hdiv
  have hmultiple : (variableSum s : MvPolynomial σ K) ∣
      variableSum s * reciprocalNumerator s c :=
    ⟨reciprocalNumerator s c, rfl⟩
  have hconstantProduct : (variableSum s : MvPolynomial σ K) ∣
      C c₀ * variableProduct s :=
    (dvd_sub_left hmultiple).mp hdiv
  have hcUnit : IsUnit (C c₀ : MvPolynomial σ K) :=
    (isUnit_iff_ne_zero.mpr hc₀).map MvPolynomial.C
  exact variableSum_not_dvd_variableProduct s hs
    (hcUnit.dvd_mul_left.mp hconstantProduct)

/-- In particular, the eliminated polynomial cannot be zero under these
support and leading-coefficient assumptions. -/
theorem eliminated_ne_zero (s : Finset σ) (hs : 2 ≤ s.card)
    {c₀ : K} (hc₀ : c₀ ≠ 0) (c : σ → K) :
    eliminated s c₀ c ≠ (0 : MvPolynomial σ K) := by
  intro hz
  apply variableSum_not_dvd_eliminated s hs hc₀ c
  rw [hz]
  exact dvd_zero _


end P14MatchingPolynomialSumObstruction
end

section

/-!
Elementary irreducibility of the actual eliminated matching polynomial.
The finite support has at least four coordinates, and all displayed
coefficients are nonzero. This algebraic theorem does not provide a Fourier
seed, the analytic rank-avoidance argument, or the full canonical UPB bound.
-/

namespace P14MatchingPolynomialIrreducible

open MvPolynomial P14MatchingRestrictionPolynomial
open P14MvPolynomialCoordinateRestriction P14MvPolynomialLinearReconstruction
open P14MatchingPolynomialSumObstruction

variable {σ K : Type*} [DecidableEq σ] [Field K]

/-- A nonzero polynomial over a field which is not a unit has positive degree. -/
theorem totalDegree_pos_of_nonzero_nonunit {P : MvPolynomial σ K}
    (hP : P ≠ 0) (hUnit : ¬ IsUnit P) : 0 < P.totalDegree := by
  apply Nat.pos_of_ne_zero
  intro hDegree
  have hC : P = C (P.coeff 0) := totalDegree_eq_zero_iff_eq_C.mp hDegree
  have hc : P.coeff 0 ≠ 0 := by
    intro hz
    apply hP
    rw [hC, hz, map_zero]
  apply hUnit
  rw [hC]
  exact (isUnit_iff_ne_zero.mpr hc).map MvPolynomial.C

/-- The constant alternative is impossible for a nonunit homogeneous factor. -/
theorem scalar_sum_of_nonunit_restriction_dichotomy
    (s : Finset σ) (hs : 2 < s.card) {P : MvPolynomial σ K}
    (hP : P ≠ 0) (hUnit : ¬ IsUnit P) (hHom : P.IsHomogeneous P.totalDegree)
    (hRestrictions : ∀ i ∈ s, ∃ a : K, a ≠ 0 ∧
      (coordinateRestriction i P = C a * variableSum (s.erase i) ∨
        coordinateRestriction i P = C a)) :
    ∃ a : K, a ≠ 0 ∧ P = C a * variableSum s := by
  have hDegree : 0 < P.totalDegree := totalDegree_pos_of_nonzero_nonunit hP hUnit
  apply (reconstruct_from_scalar_sum_restrictions s hs hHom ?_).2
  intro i hi
  obtain ⟨a, ha, hLinear | hConstant⟩ := hRestrictions i hi
  · exact ⟨a, ha, hLinear⟩
  · exact (coordinateRestriction_ne_nonzero_C i hHom hDegree ha hConstant).elim

/-- Full irreducibility of the eliminated matching polynomial on at least
four coordinates, over any field, with all its coefficients nonzero. -/
theorem eliminated_irreducible (s : Finset σ) (hs : 4 ≤ s.card)
    {c₀ : K} (hc₀ : c₀ ≠ 0) (c : σ → K) (hc : ∀ i ∈ s, c i ≠ 0) :
    Irreducible (eliminated s c₀ c) := by
  have hs2 : 2 ≤ s.card := (by decide : 2 ≤ 4).trans hs
  have hs3 : 2 < s.card := (by decide : 2 < 4).trans_le hs
  have hsn : s.Nonempty := Finset.one_le_card.mp ((by decide : 1 ≤ 4).trans hs)
  have hf0 : eliminated s c₀ c ≠ (0 : MvPolynomial σ K) :=
    eliminated_ne_zero s hs2 hc₀ c
  have hfHom := eliminated_isHomogeneous s hsn c₀ c
  have hfDegree : (eliminated s c₀ c).totalDegree = s.card := hfHom.totalDegree hf0
  have hNotUnit : ¬ IsUnit (eliminated s c₀ c) := by
    intro hUnit
    have hz := (MvPolynomial.isUnit_iff_totalDegree_of_isReduced.mp hUnit).2
    rw [hfDegree] at hz
    exact (Nat.ne_of_gt (Finset.card_pos.mpr hsn)) hz
  refine ⟨hNotUnit, ?_⟩
  intro A B hFactor
  by_cases hAUnit : IsUnit A
  · exact Or.inl hAUnit
  by_cases hBUnit : IsUnit B
  · exact Or.inr hBUnit
  exfalso
  have hAB0 : A * B ≠ 0 := by rw [← hFactor]; exact hf0
  have hABHom : (A * B).IsHomogeneous s.card := by rw [← hFactor]; exact hfHom
  obtain ⟨hAHom, hBHom, _hDegree⟩ :=
    P14MvPolynomialHomogeneousFactors.homogeneous_factors hAB0 hABHom
  have hA0 : A ≠ 0 := left_ne_zero_of_mul hAB0
  have hB0 : B ≠ 0 := right_ne_zero_of_mul hAB0
  have hNoSum := variableSum_not_dvd_eliminated s hs2 hc₀ c
  rcases P14MatchingFactorRestrictionDichotomy.factor_restriction_dichotomy
      s hs c₀ c hc hFactor.symm with hAR | hBR
  · obtain ⟨a, _ha, hA⟩ :=
      scalar_sum_of_nonunit_restriction_dichotomy s hs3 hA0 hAUnit hAHom hAR
    apply hNoSum
    rw [hFactor, hA]
    exact ⟨C a * B, by ac_rfl⟩
  · obtain ⟨b, _hb, hB⟩ :=
      scalar_sum_of_nonunit_restriction_dichotomy s hs3 hB0 hBUnit hBHom hBR
    apply hNoSum
    rw [hFactor, hB]
    exact ⟨A * C b, by ac_rfl⟩


end P14MatchingPolynomialIrreducible
end

section

/-!
The eliminated matching equation defines a prime principal ideal, and
nonzero polynomials of smaller total degree survive in its quotient.
This does not identify that quotient with the full moment presentation,
localize to the coordinate torus, or construct a positive Fourier seed.
-/

namespace P14MatchingPolynomialPrincipalIdeal

open MvPolynomial P14MatchingRestrictionPolynomial P14MvPolynomialScaling

variable {σ K : Type*} [DecidableEq σ] [Field K]

/-- Primality supports finite products in the quotient; the strict degree
bound proves individual nonvanishing there without a desired-avoidance premise. -/
theorem eliminated_prime_span_and_degree_gap
    (s : Finset σ) (hs : 4 ≤ s.card) {c₀ : K} (hc₀ : c₀ ≠ 0)
    (c : σ → K) (hc : ∀ i ∈ s, c i ≠ 0) :
    (Ideal.span ({eliminated s c₀ c} : Set (MvPolynomial σ K))).IsPrime ∧
      ∀ P : MvPolynomial σ K, P ≠ 0 → P.totalDegree < s.card →
        P ∉ Ideal.span ({eliminated s c₀ c} : Set (MvPolynomial σ K)) := by
  have hp : Prime (eliminated s c₀ c) :=
    UniqueFactorizationMonoid.irreducible_iff_prime.mp
      (P14MatchingPolynomialIrreducible.eliminated_irreducible s hs hc₀ c hc)
  refine ⟨Ideal.isPrime_span_singleton_of_prime hp, ?_⟩
  intro P hP hDegree hMem
  have hsn : s.Nonempty := Finset.one_le_card.mp
    ((Nat.le_succ 1).trans ((Nat.le_succ 2).trans ((Nat.le_succ 3).trans hs)))
  have hScaleP : scalingHom P ≠ 0 := by
    intro hz
    apply hP
    apply scalingHom_injective
    simpa only [map_zero] using hz
  have hLe := Polynomial.natDegree_le_of_dvd
    (map_dvd scalingHom (Ideal.mem_span_singleton.mp hMem)) hScaleP
  rw [scaling_of_isHomogeneous (eliminated_isHomogeneous s hsn c₀ c),
    Polynomial.natDegree_monomial_eq _ hp.ne_zero] at hLe
  have hBound : (scalingHom P).natDegree ≤ P.totalDegree := by
    apply Polynomial.natDegree_le_iff_coeff_eq_zero.mpr
    intro n hn
    rw [coeff_scaling]
    exact homogeneousComponent_eq_zero n P hn
  exact (Nat.not_le_of_gt hDegree) (hLe.trans hBound)


end P14MatchingPolynomialPrincipalIdeal
end

section

/-!
The coordinate sum times the coordinate product survives in the quotient by
the actual eliminated matching equation. Consequently localization away from
that class embeds this quotient in a domain. The prime ideal and degree gap
are obtained from the proved matching-polynomial result, not assumed here.
-/

namespace P14MatchingTorusNonvanishing

open MvPolynomial P14MatchingRestrictionPolynomial
open P14MatchingPolynomialPrincipalIdeal
open scoped BigOperators

variable {σ K : Type*} [DecidableEq σ] [Field K]

/-- Every ambient coordinate, and the supported coordinate sum, survives in
the actual principal quotient because each is nonzero of degree one. -/
theorem quotient_coordinates_and_sum_ne_zero
    (s : Finset σ) (hs : 4 ≤ s.card) {c₀ : K} (hc₀ : c₀ ≠ 0)
    (c : σ → K) (hc : ∀ i ∈ s, c i ≠ 0) :
    let I := Ideal.span ({eliminated s c₀ c} : Set (MvPolynomial σ K))
    (∀ i : σ, Ideal.Quotient.mk I (X i) ≠ 0) ∧
      Ideal.Quotient.mk I (variableSum s) ≠ 0 := by
  let I := Ideal.span ({eliminated s c₀ c} : Set (MvPolynomial σ K))
  change (∀ i : σ, Ideal.Quotient.mk I (X i) ≠ 0) ∧
    Ideal.Quotient.mk I (variableSum s) ≠ 0
  have hGap := (eliminated_prime_span_and_degree_gap s hs hc₀ c hc).2
  have hOne : 1 < s.card := (by decide : 1 < 4).trans_le hs
  have hsn : s.Nonempty := Finset.one_le_card.mp (Nat.le_of_lt hOne)
  have hSum : (variableSum s : MvPolynomial σ K) ≠ 0 :=
    (P14MvPolynomialCoordinateSumPrime.prime_sum_X s hsn).ne_zero
  constructor
  · intro i hi
    apply hGap (X i) (X_ne_zero i)
      (by simpa only [totalDegree_X] using hOne)
    exact Ideal.Quotient.eq_zero_iff_mem.mp hi
  · intro hzero
    apply hGap (variableSum s) hSum
      (by rw [(variableSum_isHomogeneous s).totalDegree hSum]; exact hOne)
    exact Ideal.Quotient.eq_zero_iff_mem.mp hzero

/-- Primality of the actual ideal prevents the product of the surviving
coordinate classes and surviving sum class from vanishing. -/
theorem quotient_torus_ne_zero
    (s : Finset σ) (hs : 4 ≤ s.card) {c₀ : K} (hc₀ : c₀ ≠ 0)
    (c : σ → K) (hc : ∀ i ∈ s, c i ≠ 0) :
    let I := Ideal.span ({eliminated s c₀ c} : Set (MvPolynomial σ K))
    Ideal.Quotient.mk I (variableSum s * variableProduct s) ≠ 0 := by
  let I := Ideal.span ({eliminated s c₀ c} : Set (MvPolynomial σ K))
  change Ideal.Quotient.mk I (variableSum s * variableProduct s) ≠ 0
  letI : I.IsPrime := (eliminated_prime_span_and_degree_gap s hs hc₀ c hc).1
  obtain ⟨hX, hSum⟩ := quotient_coordinates_and_sum_ne_zero s hs hc₀ c hc
  rw [map_mul]
  apply mul_ne_zero hSum
  simpa only [variableProduct, map_prod] using
    (Finset.prod_ne_zero_iff.mpr (fun i _ => hX i) :
      (∏ i ∈ s, Ideal.Quotient.mk I (X i)) ≠ 0)

/-- The localization away from the actual torus class is a domain and the
canonical quotient-to-localization map is injective. No injectivity or
nonvanishing premise is imposed on that class. -/
theorem torus_localization_injective_and_isDomain
    (s : Finset σ) (hs : 4 ≤ s.card) {c₀ : K} (hc₀ : c₀ ≠ 0)
    (c : σ → K) (hc : ∀ i ∈ s, c i ≠ 0) :
    let I := Ideal.span ({eliminated s c₀ c} : Set (MvPolynomial σ K))
    let Q := MvPolynomial σ K ⧸ I
    let t : Q := Ideal.Quotient.mk I (variableSum s * variableProduct s)
    Function.Injective (algebraMap Q (Localization.Away t)) ∧
      IsDomain (Localization.Away t) := by
  let I := Ideal.span ({eliminated s c₀ c} : Set (MvPolynomial σ K))
  let Q := MvPolynomial σ K ⧸ I
  let t : Q := Ideal.Quotient.mk I (variableSum s * variableProduct s)
  change Function.Injective (algebraMap Q (Localization.Away t)) ∧
    IsDomain (Localization.Away t)
  letI : I.IsPrime := (eliminated_prime_span_and_degree_gap s hs hc₀ c hc).1
  have ht : t ≠ 0 := quotient_torus_ne_zero s hs hc₀ c hc
  have hPowers : Submonoid.powers t ≤ nonZeroDivisors Q :=
    powers_le_nonZeroDivisors_of_noZeroDivisors ht
  exact ⟨IsLocalization.injective (Localization.Away t) hPowers,
    IsLocalization.isDomain_of_le_nonZeroDivisors (Localization.Away t) hPowers⟩


end P14MatchingTorusNonvanishing
end

section

/-!
Coordinates become units on the actual principal open set, while every
nonzero polynomial below the eliminated equation's degree survives there.
A finite product of these surviving classes remains nonzero. This is an
algebraic nonidentity result, not existence of a positive real parameter.
-/

namespace P14MatchingTorusDegreeAvoidance

open MvPolynomial P14MatchingRestrictionPolynomial
open P14MatchingPolynomialPrincipalIdeal P14MatchingTorusNonvanishing
open scoped BigOperators

variable {σ K : Type*} [DecidableEq σ] [Field K]

theorem low_degree_survives_localization
    (s : Finset σ) (hs : 4 ≤ s.card) {c₀ : K} (hc₀ : c₀ ≠ 0)
    (c : σ → K) (hc : ∀ i ∈ s, c i ≠ 0)
    (P : MvPolynomial σ K) (hP : P ≠ 0) (hDegree : P.totalDegree < s.card) :
    let I := Ideal.span ({eliminated s c₀ c} : Set (MvPolynomial σ K))
    let Q := MvPolynomial σ K ⧸ I
    let t : Q := Ideal.Quotient.mk I (variableSum s * variableProduct s)
    algebraMap Q (Localization.Away t) (Ideal.Quotient.mk I P) ≠ 0 := by
  let I := Ideal.span ({eliminated s c₀ c} : Set (MvPolynomial σ K))
  let Q := MvPolynomial σ K ⧸ I
  let t : Q := Ideal.Quotient.mk I (variableSum s * variableProduct s)
  change algebraMap Q (Localization.Away t) (Ideal.Quotient.mk I P) ≠ 0
  have hInjective := (torus_localization_injective_and_isDomain s hs hc₀ c hc).1
  intro hz
  have hQuot : Ideal.Quotient.mk I P = 0 :=
    hInjective (hz.trans (map_zero (algebraMap Q (Localization.Away t))).symm)
  exact (eliminated_prime_span_and_degree_gap s hs hc₀ c hc).2 P hP hDegree
    (Ideal.Quotient.eq_zero_iff_mem.mp hQuot)

/-- Inverting the sum times the product makes every supported coordinate
and the sum a unit; the actual torus class is used throughout. -/
theorem localized_coordinates_and_sum_are_units
    (s : Finset σ) (c₀ : K) (c : σ → K) :
    let I := Ideal.span ({eliminated s c₀ c} : Set (MvPolynomial σ K))
    let Q := MvPolynomial σ K ⧸ I
    let t : Q := Ideal.Quotient.mk I (variableSum s * variableProduct s)
    IsUnit (algebraMap Q (Localization.Away t) (Ideal.Quotient.mk I (variableSum s))) ∧
      ∀ i ∈ s, IsUnit (algebraMap Q (Localization.Away t) (Ideal.Quotient.mk I (X i))) := by
  let I := Ideal.span ({eliminated s c₀ c} : Set (MvPolynomial σ K))
  let Q := MvPolynomial σ K ⧸ I
  let t : Q := Ideal.Quotient.mk I (variableSum s * variableProduct s)
  let F : MvPolynomial σ K →+* Localization.Away t :=
    (algebraMap Q (Localization.Away t)).comp (Ideal.Quotient.mk I)
  change IsUnit (F (variableSum s)) ∧ ∀ i ∈ s, IsUnit (F (X i))
  have hUnit : IsUnit (F (variableSum s * variableProduct s)) :=
    IsLocalization.map_units (Localization.Away t) ⟨t, Submonoid.mem_powers t⟩
  rw [map_mul] at hUnit
  refine ⟨(IsUnit.mul_iff.mp hUnit).1, ?_⟩
  have hProduct := (IsUnit.mul_iff.mp hUnit).2
  rw [variableProduct, map_prod] at hProduct
  exact IsUnit.prod_iff.mp hProduct

theorem finite_low_degree_product_survives
    (s : Finset σ) (hs : 4 ≤ s.card) {c₀ : K} (hc₀ : c₀ ≠ 0)
    (c : σ → K) (hc : ∀ i ∈ s, c i ≠ 0)
    {ι : Type*} (u : Finset ι) (P : ι → MvPolynomial σ K)
    (hP : ∀ i ∈ u, P i ≠ 0) (hDegree : ∀ i ∈ u, (P i).totalDegree < s.card) :
    let I := Ideal.span ({eliminated s c₀ c} : Set (MvPolynomial σ K))
    let Q := MvPolynomial σ K ⧸ I
    let t : Q := Ideal.Quotient.mk I (variableSum s * variableProduct s)
    (∏ i ∈ u, algebraMap Q (Localization.Away t) (Ideal.Quotient.mk I (P i))) ≠ 0 := by
  let I := Ideal.span ({eliminated s c₀ c} : Set (MvPolynomial σ K))
  let Q := MvPolynomial σ K ⧸ I
  let t : Q := Ideal.Quotient.mk I (variableSum s * variableProduct s)
  change (∏ i ∈ u, algebraMap Q (Localization.Away t) (Ideal.Quotient.mk I (P i))) ≠ 0
  letI : IsDomain (Localization.Away t) :=
    (torus_localization_injective_and_isDomain s hs hc₀ c hc).2
  apply Finset.prod_ne_zero_iff.mpr
  intro i hi
  exact low_degree_survives_localization s hs hc₀ c hc (P i) (hP i hi) (hDegree i hi)


end P14MatchingTorusDegreeAvoidance
end

section

/-!
A nonzero homogeneous multiaffine polynomial in the full coordinate ring
cannot vanish after eliminating the sum of all coordinates when its degree
is at least two. If its degree is strictly below the eliminated reciprocal
equation, its class also survives the quotient and the torus localization.
The strict upper bound and full ambient coordinate support are essential.
-/

namespace P14MatchingMultiaffineSurvival

open MvPolynomial P14MatchingRestrictionPolynomial
open P14FullCoordinateSumDegrees P14MatchingLinearElimination
open P14FourierMultiaffineNondivisibility
open P14MatchingPolynomialPrincipalIdeal P14MatchingTorusDegreeAvoidance
open scoped BigOperators

variable {σ K : Type*} [Fintype σ] [DecidableEq σ] [Field K]

theorem linearElimination_ne_zero
    (P : MvPolynomial (Option σ) K) (hP : P ≠ 0)
    {r : ℕ} (hHom : P.IsHomogeneous r)
    (hMulti : ∀ i, degreeOf i P ≤ 1) (hr : 2 ≤ r) :
    linearElimination P ≠ 0 := by
  obtain ⟨hL, hLtotal, hLvars⟩ :=
    fullCoordinateSum_degree_data (σ := Option σ) (R := K)
  have hDegree : 2 ≤ P.totalDegree := by
    rw [hHom.totalDegree hP]
    exact hr
  intro hzero
  exact not_dvd_of_multiaffine hL hLtotal hLvars hP hMulti hDegree
    ((linearElimination_eq_zero_iff P).mp hzero)

theorem multiaffine_survives_quotient
    (hs : 4 ≤ Fintype.card σ) {c₀ : K} (hc₀ : c₀ ≠ 0)
    (c : σ → K) (hc : ∀ i, c i ≠ 0)
    (P : MvPolynomial (Option σ) K) (hP : P ≠ 0)
    {r : ℕ} (hHom : P.IsHomogeneous r)
    (hMulti : ∀ i, degreeOf i P ≤ 1) (hr : 2 ≤ r)
    (hrUpper : r < Fintype.card σ) :
    Ideal.Quotient.mk (Ideal.span ({eliminated Finset.univ c₀ c} :
      Set (MvPolynomial σ K))) (linearElimination P) ≠ 0 := by
  have hE := linearElimination_ne_zero P hP hHom hMulti hr
  have hEDegree : (linearElimination P).totalDegree < (Finset.univ : Finset σ).card := by
    rw [(linearElimination_isHomogeneous hHom).totalDegree hE, Finset.card_univ]
    exact hrUpper
  intro hzero
  exact (eliminated_prime_span_and_degree_gap Finset.univ (by simpa using hs)
    hc₀ c (fun i _ => hc i)).2 (linearElimination P) hE hEDegree
    (Ideal.Quotient.eq_zero_iff_mem.mp hzero)

theorem multiaffine_survives_localization
    (hs : 4 ≤ Fintype.card σ) {c₀ : K} (hc₀ : c₀ ≠ 0)
    (c : σ → K) (hc : ∀ i, c i ≠ 0)
    (P : MvPolynomial (Option σ) K) (hP : P ≠ 0)
    {r : ℕ} (hHom : P.IsHomogeneous r)
    (hMulti : ∀ i, degreeOf i P ≤ 1) (hr : 2 ≤ r)
    (hrUpper : r < Fintype.card σ) :
    let I := Ideal.span ({eliminated Finset.univ c₀ c} : Set (MvPolynomial σ K))
    let Q := MvPolynomial σ K ⧸ I
    let t : Q := Ideal.Quotient.mk I (variableSum Finset.univ * variableProduct Finset.univ)
    algebraMap Q (Localization.Away t) (Ideal.Quotient.mk I (linearElimination P)) ≠ 0 := by
  have hE := linearElimination_ne_zero P hP hHom hMulti hr
  apply low_degree_survives_localization Finset.univ (by simpa using hs)
    hc₀ c (fun i _ => hc i) (linearElimination P) hE
  rw [(linearElimination_isHomogeneous hHom).totalDegree hE, Finset.card_univ]
  exact hrUpper


end P14MatchingMultiaffineSurvival
end

section

/-!
The actual mixed determinant, renamed onto the full matching-coordinate
ring, survives the eliminated matching quotient and its coordinate torus.
The fixed complementary block determinants are explicit hypotheses;
nonzeroness, homogeneity and multiaffinity of the renamed polynomial are
derived. This does not establish those block hypotheses for Fourier data.
-/

noncomputable section

namespace P14FourierMixedMatchingSurvival

open Matrix MvPolynomial P14FourierMixedDeterminant
open P14FourierMixedPolynomialDegrees P14MatchingMultiaffineSurvival
open P14MatchingRestrictionPolynomial P14MatchingLinearElimination

variable {α β σ K : Type*} [Field K]
variable [Fintype α] [DecidableEq α] [Fintype β] [DecidableEq β]
variable [Fintype σ] [DecidableEq σ]

theorem renamed_mixedPolynomial_data (e : (α ⊕ β) ≃ Option σ)
    (A : Matrix α (α ⊕ β) K) (B : Matrix β (α ⊕ β) K)
    (hA : (A.submatrix id Sum.inl).det ≠ 0)
    (hB : (B.submatrix id Sum.inr).det ≠ 0) :
    renameEquiv K e (mixedPolynomial A B) ≠ 0 ∧
      (renameEquiv K e (mixedPolynomial A B)).IsHomogeneous (Fintype.card α) ∧
        ∀ j : Option σ, degreeOf j (renameEquiv K e (mixedPolynomial A B)) ≤ 1 := by
  refine ⟨?_, ?_, ?_⟩
  · intro hz
    apply mixedPolynomial_ne_zero A B hA hB
    apply (renameEquiv K e).injective
    exact hz.trans (map_zero (renameEquiv K e)).symm
  · change (rename e (mixedPolynomial A B)).IsHomogeneous (Fintype.card α)
    exact (mixedPolynomial_isHomogeneous A B).rename_isHomogeneous
  · intro j
    change degreeOf j (rename e (mixedPolynomial A B)) ≤ 1
    calc
      _ = degreeOf (e.symm j) (mixedPolynomial A B) := by
        simpa only [Equiv.apply_symm_apply] using
          (degreeOf_rename_of_injective (p := mixedPolynomial A B)
            e.injective (e.symm j))
      _ ≤ 1 := mixedPolynomial_degreeOf_le_one A B (e.symm j)

theorem mixedPolynomial_survives_quotient
    (e : (α ⊕ β) ≃ Option σ)
    (A : Matrix α (α ⊕ β) K) (B : Matrix β (α ⊕ β) K)
    (hA : (A.submatrix id Sum.inl).det ≠ 0)
    (hB : (B.submatrix id Sum.inr).det ≠ 0)
    (hs : 4 ≤ Fintype.card σ) (hr : 2 ≤ Fintype.card α)
    (hrUpper : Fintype.card α < Fintype.card σ)
    {c₀ : K} (hc₀ : c₀ ≠ 0) (c : σ → K) (hc : ∀ i, c i ≠ 0) :
    Ideal.Quotient.mk (Ideal.span ({eliminated Finset.univ c₀ c} :
      Set (MvPolynomial σ K)))
        (linearElimination (renameEquiv K e (mixedPolynomial A B))) ≠ 0 := by
  obtain ⟨hP, hHom, hMulti⟩ := renamed_mixedPolynomial_data e A B hA hB
  exact multiaffine_survives_quotient hs hc₀ c hc
    (renameEquiv K e (mixedPolynomial A B)) hP hHom hMulti hr hrUpper

theorem mixedPolynomial_survives_localization
    (e : (α ⊕ β) ≃ Option σ)
    (A : Matrix α (α ⊕ β) K) (B : Matrix β (α ⊕ β) K)
    (hA : (A.submatrix id Sum.inl).det ≠ 0)
    (hB : (B.submatrix id Sum.inr).det ≠ 0)
    (hs : 4 ≤ Fintype.card σ) (hr : 2 ≤ Fintype.card α)
    (hrUpper : Fintype.card α < Fintype.card σ)
    {c₀ : K} (hc₀ : c₀ ≠ 0) (c : σ → K) (hc : ∀ i, c i ≠ 0) :
    let I := Ideal.span ({eliminated Finset.univ c₀ c} : Set (MvPolynomial σ K))
    let Q := MvPolynomial σ K ⧸ I
    let t : Q := Ideal.Quotient.mk I (variableSum Finset.univ * variableProduct Finset.univ)
    algebraMap Q (Localization.Away t)
      (Ideal.Quotient.mk I (linearElimination (renameEquiv K e (mixedPolynomial A B)))) ≠ 0 := by
  obtain ⟨hP, hHom, hMulti⟩ := renamed_mixedPolynomial_data e A B hA hB
  exact multiaffine_survives_localization hs hc₀ c hc
    (renameEquiv K e (mixedPolynomial A B)) hP hHom hMulti hr hrUpper


end P14FourierMixedMatchingSurvival
end
end

section

/-!
The normalized Fourier coefficient matrices and their actual squared
spectral weights satisfy the generic matching survival theorem. Both
complementary determinants and all equation-coefficient nonzeroness are
derived. Algebraic survival still does not assert a positive real point.
-/

noncomputable section

namespace P14FourierActualMatchingSurvival

open Matrix MvPolynomial P14FourierSpectralWeights P14FourierMatchingBlocks
open P14FourierMixedDeterminant P14FourierMixedMatchingSurvival
open P14MatchingRestrictionPolynomial P14MatchingLinearElimination

def equationCoefficient {r s : ℕ} {σ : Type*} (ζ : ℂ) (d : ℕ)
    (e : (Fin r ⊕ Fin s) ≃ Option σ) (o : Option σ) : ℂ :=
  (Complex.normSq (spectralWeight ζ d (retainedFrequency d (e.symm o))) : ℂ)

theorem equationCoefficient_ne_zero {n r s d : ℕ} {σ : Type*} {ζ : ℂ}
    (hζ : IsPrimitiveRoot ζ n) (hdim : d + r + s = n)
    (e : (Fin r ⊕ Fin s) ≃ Option σ) (o : Option σ) :
    equationCoefficient ζ d e o ≠ 0 := by
  have hbounds := retainedFrequency_bounds hdim (e.symm o)
  exact ofReal_normSq_spectralWeight_ne_zero hζ hbounds.1 hbounds.2

def normalizedMixedPolynomial {n r s : ℕ} {σ : Type*}
    (d : ℕ) (e : (Fin r ⊕ Fin s) ≃ Option σ)
    (I : Fin r → Fin n) (T : Fin s → Fin n) : MvPolynomial (Option σ) ℂ :=
  renameEquiv ℂ e (mixedPolynomial
    (aCoefficients (s := s) (fourierRoot n) (fourierNormalization n) d I)
    (bCoefficients (r := r) (fourierRoot n) (fourierNormalization n) d T))

theorem fourier_mixed_survives_quotient {n r s d : ℕ} {σ : Type*}
    [Fintype σ] [DecidableEq σ]
    (hn : 0 < n) (hdim : d + r + s = n)
    (e : (Fin r ⊕ Fin s) ≃ Option σ)
    (I : Fin r → Fin n) (hI : Function.Injective I)
    (T : Fin s → Fin n) (hT : Function.Injective T)
    (hs : 4 ≤ Fintype.card σ) (hr : 2 ≤ r) (hrUpper : r < Fintype.card σ) :
    Ideal.Quotient.mk (Ideal.span ({eliminated Finset.univ
      (equationCoefficient (fourierRoot n) d e none)
      (fun i => equationCoefficient (fourierRoot n) d e (some i))} :
      Set (MvPolynomial σ ℂ))) (linearElimination (normalizedMixedPolynomial d e I T)) ≠ 0 := by
  have hblocks := fourier_complementary_blocks_ne_zero hn hdim I hI T hT
  have hc := equationCoefficient_ne_zero (fourierRoot_isPrimitiveRoot n hn) hdim e
  exact mixedPolynomial_survives_quotient e
    (aCoefficients (s := s) (fourierRoot n) (fourierNormalization n) d I)
    (bCoefficients (r := r) (fourierRoot n) (fourierNormalization n) d T)
    hblocks.1 hblocks.2 hs (by simpa using hr) (by simpa using hrUpper)
    (hc none) (fun i => equationCoefficient (fourierRoot n) d e (some i))
    (fun i => hc (some i))

theorem fourier_mixed_survives_localization {n r s d : ℕ} {σ : Type*}
    [Fintype σ] [DecidableEq σ]
    (hn : 0 < n) (hdim : d + r + s = n)
    (e : (Fin r ⊕ Fin s) ≃ Option σ)
    (Irows : Fin r → Fin n) (hI : Function.Injective Irows)
    (Trows : Fin s → Fin n) (hT : Function.Injective Trows)
    (hs : 4 ≤ Fintype.card σ) (hr : 2 ≤ r) (hrUpper : r < Fintype.card σ) :
    let I := Ideal.span ({eliminated Finset.univ
      (equationCoefficient (fourierRoot n) d e none)
      (fun i => equationCoefficient (fourierRoot n) d e (some i))} : Set (MvPolynomial σ ℂ))
    let Q := MvPolynomial σ ℂ ⧸ I
    let t : Q := Ideal.Quotient.mk I (variableSum Finset.univ * variableProduct Finset.univ)
    algebraMap Q (Localization.Away t)
      (Ideal.Quotient.mk I (linearElimination (normalizedMixedPolynomial d e Irows Trows))) ≠ 0 := by
  have hblocks := fourier_complementary_blocks_ne_zero hn hdim Irows hI Trows hT
  have hc := equationCoefficient_ne_zero (fourierRoot_isPrimitiveRoot n hn) hdim e
  exact mixedPolynomial_survives_localization e
    (aCoefficients (s := s) (fourierRoot n) (fourierNormalization n) d Irows)
    (bCoefficients (r := r) (fourierRoot n) (fourierNormalization n) d Trows)
    hblocks.1 hblocks.2 hs (by simpa using hr) (by simpa using hrUpper)
    (hc none) (fun i => equationCoefficient (fourierRoot n) d e (some i))
    (fun i => hc (some i))


end P14FourierActualMatchingSurvival
end
end

section

/-! Common retained-frequency coordinates for different row splits of the
same total size. A single Option equivalence gives identical equation
coefficients for all splits. No parameter-existence or rank claim is made. -/

noncomputable section

namespace P14FourierCommonCoordinates

open P14FourierMatchingBlocks P14FourierSpectralWeights
open P14FourierActualMatchingSurvival

def splitEquiv {r s k : ℕ} (h : r + s = k) : (Fin r ⊕ Fin s) ≃ Fin k :=
  finSumFinEquiv.trans (finCongr h)

def optionEquiv {r s k : ℕ} {σ : Type*} (h : r + s = k)
    (E : Fin k ≃ Option σ) : (Fin r ⊕ Fin s) ≃ Option σ :=
  (splitEquiv h).trans E

theorem retainedFrequency_splitEquiv {r s k : ℕ} (d : ℕ) (h : r + s = k)
    (j : Fin r ⊕ Fin s) :
    retainedFrequency d j = d + (splitEquiv h j).val := by
  simpa only [splitEquiv, Equiv.trans_apply, finCongr_apply_coe] using
    P14FourierParityCoordinates.retainedFrequency_eq_add_index d j

theorem splitEquiv_optionEquiv_symm {r s k : ℕ} {σ : Type*}
    (h : r + s = k) (E : Fin k ≃ Option σ) (o : Option σ) :
    splitEquiv h ((optionEquiv h E).symm o) = E.symm o := by
  change splitEquiv h ((splitEquiv h).symm (E.symm o)) = E.symm o
  exact (splitEquiv h).apply_symm_apply (E.symm o)

theorem retainedFrequency_optionEquiv_symm {r s k : ℕ} {σ : Type*}
    (d : ℕ) (h : r + s = k) (E : Fin k ≃ Option σ) (o : Option σ) :
    retainedFrequency d ((optionEquiv h E).symm o) = d + (E.symm o).val := by
  rw [retainedFrequency_splitEquiv d h, splitEquiv_optionEquiv_symm h E o]

theorem equationCoefficient_optionEquiv {r s k : ℕ} {σ : Type*}
    (ζ : ℂ) (d : ℕ) (h : r + s = k) (E : Fin k ≃ Option σ) (o : Option σ) :
    equationCoefficient ζ d (optionEquiv h E) o =
      (Complex.normSq (spectralWeight ζ d (d + (E.symm o).val)) : ℂ) := by
  unfold equationCoefficient
  rw [retainedFrequency_optionEquiv_symm d h E o]

theorem exists_common_parity_coordinates {k : ℕ} {σ : Type*} [Fintype σ]
    (d : ℕ) (hcard : 4 ≤ Fintype.card σ) (hk : k = Fintype.card σ + 1) :
    ∃ (E : Fin k ≃ Option σ) (b : σ),
      (d + (E.symm none).val) % 2 = 0 ∧
      (d + (E.symm (some b)).val) % 2 = 0 ∧
      ∃ u v : {o : Option σ // ¬ (d + (E.symm o).val) % 2 = 0}, u ≠ v := by
  obtain ⟨e0, b, hNone, hSome, u0, v0, huv⟩ :=
    P14FourierParityCoordinates.exists_parity_coordinates (r := k) (s := 0)
      d hcard (by simpa only [Nat.add_zero] using hk)
  let E : Fin k ≃ Option σ := (splitEquiv (Nat.add_zero k)).symm.trans e0
  have hfreq (o : Option σ) :
      retainedFrequency d (e0.symm o) = d + (E.symm o).val := by
    change retainedFrequency d (e0.symm o) =
      d + (splitEquiv (Nat.add_zero k) (e0.symm o)).val
    exact retainedFrequency_splitEquiv d (Nat.add_zero k) (e0.symm o)
  let u : {o : Option σ // ¬ (d + (E.symm o).val) % 2 = 0} :=
    ⟨u0.val, by simpa only [hfreq] using u0.property⟩
  let v : {o : Option σ // ¬ (d + (E.symm o).val) % 2 = 0} :=
    ⟨v0.val, by simpa only [hfreq] using v0.property⟩
  refine ⟨E, b, ?_, ?_, u, v, ?_⟩
  · simpa only [hfreq] using hNone
  · simpa only [hfreq] using hSome
  · intro h
    apply huv
    apply Subtype.ext
    exact congrArg (fun x : {o : Option σ // ¬ (d + (E.symm o).val) % 2 = 0} => x.val) h


end P14FourierCommonCoordinates
end
end

section

/-!
Evaluate the actual signed Fourier mixed matrix at signed positive real
parameters. The resulting matrix is the actual square-root row stack with
each column multiplied by its square root. This is a pointwise identity;
the parameters are not assumed or asserted to solve the matching equations.
-/

noncomputable section

namespace P14FourierClearedRows

open Matrix MvPolynomial P14FourierSpectralWeights P14FourierMatchingBlocks
open P14FourierMixedDeterminant
open scoped BigOperators

def signedParameter {r s : ℕ} (d : ℕ) (h : Fin r ⊕ Fin s → ℝ) :
    Fin r ⊕ Fin s → ℂ :=
  fun j => (-1 : ℂ) ^ retainedFrequency d j * (h j : ℂ)

def actualRows {n r s : ℕ} (d : ℕ) (I : Fin r → Fin n) (T : Fin s → Fin n)
    (h : Fin r ⊕ Fin s → ℝ) : Matrix (Fin r ⊕ Fin s) (Fin r ⊕ Fin s) ℂ :=
  fun i j => Sum.elim
    (fun a => fourierNormalization n *
      fourierRoot n ^ ((I a).val * retainedFrequency d j) * (Real.sqrt (h j) : ℂ))
    (fun b => fourierNormalization n *
      fourierRoot n ^ ((T b).val * retainedFrequency d j) *
        star (spectralWeight (fourierRoot n) d (retainedFrequency d j)) /
          (Real.sqrt (h j) : ℂ)) i

private theorem complex_sqrt_ne_zero {x : ℝ} (hx : 0 < x) :
    (Real.sqrt x : ℂ) ≠ 0 :=
  Complex.ofReal_ne_zero.mpr (ne_of_gt (Real.sqrt_pos.mpr hx))

private theorem signed_sqrt_identity (z : ℂ) (q : ℕ) {x : ℝ} (hx : 0 ≤ x) :
    (z * (-1 : ℂ) ^ q) * ((-1 : ℂ) ^ q * (x : ℂ)) =
      (z * (Real.sqrt x : ℂ)) * (Real.sqrt x : ℂ) := by
  have hsign : (-1 : ℂ) ^ q * (-1 : ℂ) ^ q = 1 := by
    rw [← mul_pow, neg_mul_neg, one_mul, one_pow]
  have hsqrt : (Real.sqrt x : ℂ) * (Real.sqrt x : ℂ) = (x : ℂ) := by
    rw [← Complex.ofReal_mul, Real.mul_self_sqrt hx]
  calc
    _ = z * (((-1 : ℂ) ^ q * (-1 : ℂ) ^ q) * (x : ℂ)) := by
      simp only [mul_assoc]
    _ = z * (x : ℂ) := by rw [hsign, one_mul]
    _ = _ := by rw [mul_assoc, hsqrt]

theorem eval_mixedMatrix_eq_actualRows_mul_diagonal {n r s : ℕ}
    (d : ℕ) (I : Fin r → Fin n) (T : Fin s → Fin n)
    (h : Fin r ⊕ Fin s → ℝ) (hpos : ∀ j, 0 < h j) :
    (eval (signedParameter d h)).mapMatrix
      (mixedMatrix
        (aCoefficients (s := s) (fourierRoot n) (fourierNormalization n) d I)
        (bCoefficients (r := r) (fourierRoot n) (fourierNormalization n) d T)) =
      actualRows d I T h * Matrix.diagonal (fun j => (Real.sqrt (h j) : ℂ)) := by
  ext i j
  rw [Matrix.mul_diagonal]
  cases i with
  | inl a =>
      change eval (signedParameter d h)
        (C (aCoefficients (s := s) (fourierRoot n) (fourierNormalization n) d I a j) * X j) =
          (fourierNormalization n * fourierRoot n ^ ((I a).val * retainedFrequency d j) *
            (Real.sqrt (h j) : ℂ)) * (Real.sqrt (h j) : ℂ)
      rw [map_mul, eval_C, eval_X]
      exact signed_sqrt_identity
        (fourierNormalization n * fourierRoot n ^ ((I a).val * retainedFrequency d j))
        (retainedFrequency d j) (hpos j).le
  | inr b =>
      change eval (signedParameter d h)
        (C (bCoefficients (r := r) (fourierRoot n) (fourierNormalization n) d T b j)) =
          (fourierNormalization n * fourierRoot n ^ ((T b).val * retainedFrequency d j) *
            star (spectralWeight (fourierRoot n) d (retainedFrequency d j)) /
              (Real.sqrt (h j) : ℂ)) * (Real.sqrt (h j) : ℂ)
      rw [eval_C]
      exact (div_mul_cancel₀ _ (complex_sqrt_ne_zero (hpos j))).symm

theorem eval_mixedPolynomial_eq_det_mul {n r s : ℕ}
    (d : ℕ) (I : Fin r → Fin n) (T : Fin s → Fin n)
    (h : Fin r ⊕ Fin s → ℝ) (hpos : ∀ j, 0 < h j) :
    eval (signedParameter d h)
      (mixedPolynomial
        (aCoefficients (s := s) (fourierRoot n) (fourierNormalization n) d I)
        (bCoefficients (r := r) (fourierRoot n) (fourierNormalization n) d T)) =
      (actualRows d I T h).det * ∏ j : Fin r ⊕ Fin s, (Real.sqrt (h j) : ℂ) := by
  unfold mixedPolynomial
  rw [RingHom.map_det, eval_mixedMatrix_eq_actualRows_mul_diagonal d I T h hpos,
    Matrix.det_mul, Matrix.det_diagonal]

theorem actualRows_det_ne_zero_iff {n r s : ℕ}
    (d : ℕ) (I : Fin r → Fin n) (T : Fin s → Fin n)
    (h : Fin r ⊕ Fin s → ℝ) (hpos : ∀ j, 0 < h j) :
    (actualRows d I T h).det ≠ 0 ↔
      eval (signedParameter d h)
        (mixedPolynomial
          (aCoefficients (s := s) (fourierRoot n) (fourierNormalization n) d I)
          (bCoefficients (r := r) (fourierRoot n) (fourierNormalization n) d T)) ≠ 0 := by
  rw [eval_mixedPolynomial_eq_det_mul d I T h hpos]
  have hprod : (∏ j : Fin r ⊕ Fin s, (Real.sqrt (h j) : ℂ)) ≠ 0 :=
    Finset.prod_ne_zero_iff.mpr (fun j _ => complex_sqrt_ne_zero (hpos j))
  exact (mul_ne_zero_iff_right hprod).symm


end P14FourierClearedRows
end
end

section

/-! One physical complex Fourier family in common coordinates, with an exact
row/column identification and determinant-to-independence transport. -/

noncomputable section

namespace P14FourierPhysicalFamily

open P14FourierSpectralWeights P14FourierMatchingBlocks
open P14FourierCommonCoordinates P14FourierClearedRows

def physicalFamily {n k : ℕ} (d : ℕ) (H : Fin k → ℝ) :
    (Fin n ⊕ Fin n) → Fin k → ℂ :=
  fun p j => Sum.elim
    (fun a => fourierNormalization n * fourierRoot n ^ (a.val * (d + j.val)) *
      (Real.sqrt (H j) : ℂ))
    (fun b => fourierNormalization n * fourierRoot n ^ (b.val * (d + j.val)) *
      star (spectralWeight (fourierRoot n) d (d + j.val)) / (Real.sqrt (H j) : ℂ)) p

theorem actualRows_eq_physicalFamily {n r s k : ℕ} (d : ℕ)
    (hsize : r + s = k) (H : Fin k → ℝ)
    (I : Fin r → Fin n) (T : Fin s → Fin n)
    (p q : Fin r ⊕ Fin s) :
    actualRows d I T (H ∘ splitEquiv hsize) p q =
      physicalFamily d H (Sum.map I T p) (splitEquiv hsize q) := by
  cases p <;> simp only [actualRows, physicalFamily, Sum.map_inl, Sum.map_inr,
    Sum.elim_inl, Sum.elim_inr, Function.comp_apply, retainedFrequency_splitEquiv d hsize]

theorem independent_of_actualRows_det_ne_zero {n r s k : ℕ} (d : ℕ)
    (hsize : r + s = k) (H : Fin k → ℝ)
    (I : Fin r → Fin n) (T : Fin s → Fin n)
    (hdet : (actualRows d I T (H ∘ splitEquiv hsize)).det ≠ 0) :
    LinearIndependent ℂ (fun p => physicalFamily d H (Sum.map I T p)) := by
  let f : (Fin k → ℂ) →ₗ[ℂ] ((Fin r ⊕ Fin s) → ℂ) :=
    LinearMap.pi (fun q => LinearMap.proj (splitEquiv hsize q))
  have hfun : (fun p => f (physicalFamily d H (Sum.map I T p))) =
      (fun p => actualRows d I T (H ∘ splitEquiv hsize) p) := by
    funext p q
    exact (actualRows_eq_physicalFamily d hsize H I T p q).symm
  apply LinearIndependent.of_comp f
  change LinearIndependent ℂ (fun p => f (physicalFamily d H (Sum.map I T p)))
  rw [hfun]
  exact Matrix.linearIndependent_rows_of_det_ne_zero hdet


end P14FourierPhysicalFamily
end
end

section

/-! Exact scalar entries for the two positive-weight complex row families. -/

namespace P14ComplexSqrtPairEntries

theorem sqrt_square (H : ℝ) (hH : 0 ≤ H) :
    (Real.sqrt H : ℂ) * (Real.sqrt H : ℂ) = (H : ℂ) := by
  exact_mod_cast Real.mul_self_sqrt hH

theorem a_entry (ρ a b : ℂ) (H : ℝ) (hH : 0 ≤ H) :
    star (ρ * a * (Real.sqrt H : ℂ)) * (ρ * b * (Real.sqrt H : ℂ)) =
      star ρ * ρ * (star a * b) * (H : ℂ) := by
  have hs : star (Real.sqrt H : ℂ) = (Real.sqrt H : ℂ) := by
    simp only [Complex.star_def, Complex.conj_ofReal]
  simp only [star_mul, hs]
  calc
    _ = star ρ * ρ * (star a * b) *
        ((Real.sqrt H : ℂ) * (Real.sqrt H : ℂ)) := by ring
    _ = _ := by rw [sqrt_square H hH]

theorem b_entry (ρ a b w : ℂ) (H : ℝ) (hH : 0 ≤ H) :
    star (ρ * a * star w / (Real.sqrt H : ℂ)) *
      (ρ * b * star w / (Real.sqrt H : ℂ)) =
        star ρ * ρ * (star a * b) * (Complex.normSq w : ℂ) / (H : ℂ) := by
  have hs : star (Real.sqrt H : ℂ) = (Real.sqrt H : ℂ) := by
    simp only [Complex.star_def, Complex.conj_ofReal]
  simp only [star_div₀, star_mul, star_star, hs]
  calc
    _ = star ρ * ρ * (star a * b) * (w * star w) /
        ((Real.sqrt H : ℂ) * (Real.sqrt H : ℂ)) := by
      rw [div_mul_div_comm]
      congr 1
      ring
    _ = _ := by rw [sqrt_square H hH, Complex.star_def, Complex.mul_conj]

theorem cross_entry (ρ a b w : ℂ) (H : ℝ) (hH : 0 < H) :
    star (ρ * a * (Real.sqrt H : ℂ)) *
      (ρ * b * star w / (Real.sqrt H : ℂ)) =
        star ρ * ρ * (star a * b) * star w := by
  have hs : star (Real.sqrt H : ℂ) = (Real.sqrt H : ℂ) := by
    simp only [Complex.star_def, Complex.conj_ofReal]
  have hnz : (Real.sqrt H : ℂ) ≠ 0 :=
    Complex.ofReal_ne_zero.mpr (ne_of_gt (Real.sqrt_pos.mpr hH))
  simp only [star_mul, hs]
  calc
    _ = star ρ * ρ * (star a * b) * star w *
        ((Real.sqrt H : ℂ) / (Real.sqrt H : ℂ)) := by
      simp only [div_eq_mul_inv]
      ring
    _ = _ := by rw [div_self hnz, mul_one]


end P14ComplexSqrtPairEntries
end

section

noncomputable section
namespace P14RealComplex

def embed {d : Type*} : (d → ℝ) →ₗ[ℝ] (d → ℂ) where
  toFun v j := v j
  map_add' := by intros; ext; simp
  map_smul' := by intros; ext; simp

lemma embed_injective {d : Type*} : Function.Injective (@embed d) := by
  intro v w h
  ext j
  exact Complex.ofReal_injective (congrFun h j)

theorem independent_of_complex {ι d : Type*} (v : ι → d → ℝ)
    (hv : LinearIndependent ℂ (fun i => embed (v i))) : LinearIndependent ℝ v := by
  exact (hv.restrict_scalars' ℝ).of_comp embed

theorem independent {ι d : Type*} [Fintype ι] (v : ι → d → ℝ)
    (hv : LinearIndependent ℝ v) : LinearIndependent ℂ (fun i => embed (v i)) := by
  rw [Fintype.linearIndependent_iff] at hv ⊢
  intro c hc i
  have hr : ∑ i, (c i).re • v i = 0 := by
    ext j
    have h := congrArg Complex.re (congrFun hc j)
    simpa [embed, Complex.mul_re] using h
  have hi : ∑ i, (c i).im • v i = 0 := by
    ext j
    have h := congrArg Complex.im (congrFun hc j)
    simpa [embed, Complex.mul_im] using h
  apply Complex.ext
  · exact hv _ hr i
  · exact hv _ hi i

theorem spanning {ι d : Type*} (v : ι → d → ℝ)
    (hv : Submodule.span ℝ (Set.range v) = ⊤) :
    Submodule.span ℂ (Set.range fun i => embed (v i)) = ⊤ := by
  let W := Submodule.span ℂ (Set.range fun i => embed (v i))
  have hreal : ∀ x : d → ℝ, embed x ∈ W := by
    have hs : Submodule.span ℝ (Set.range v) ≤
        (W.restrictScalars ℝ).comap embed := by
      apply Submodule.span_le.mpr
      rintro _ ⟨i,rfl⟩
      exact Submodule.subset_span (Set.mem_range_self i)
    intro x
    exact hs (by rw [hv]; trivial)
  apply top_unique
  intro z _
  have h := W.add_mem (hreal (fun j => (z j).re))
    (W.smul_mem Complex.I (hreal (fun j => (z j).im)))
  have he : embed (fun j => (z j).re) + Complex.I • embed (fun j => (z j).im) = z := by
    ext j
    simpa [embed, mul_comm] using Complex.re_add_im (z j)
  rwa [he] at h

theorem pair {d : Type*} [Fintype d] (v w : d → ℝ) :
    (∑ j, star (embed v j) * embed w j) = ((∑ j, v j * w j : ℝ) : ℂ) := by
  simp [embed]

theorem spanning_of_complex {ι d : Type*} [Fintype ι] [Fintype d]
    (v : ι → d → ℝ) (hv : Submodule.span ℂ (Set.range fun i => embed (v i)) = ⊤) :
    Submodule.span ℝ (Set.range v) = ⊤ := by
  classical
  obtain ⟨κ,a,ha,hspan,hli⟩ := exists_linearIndependent' ℂ (fun i => embed (v i))
  letI : Finite κ := Finite.of_injective a ha
  letI : Fintype κ := Fintype.ofFinite κ
  have hc : Fintype.card κ = Fintype.card d := by
    rw [← finrank_span_eq_card hli, hspan, hv]
    simp
  have hr : LinearIndependent ℝ (fun q => v (a q)) := independent_of_complex _ hli
  have ht : Submodule.span ℝ (Set.range fun q => v (a q)) = ⊤ :=
    hr.span_eq_top_of_card_eq_finrank' (by simpa using hc)
  apply top_unique
  rw [← ht]
  apply Submodule.span_mono
  rintro _ ⟨q,rfl⟩
  exact ⟨a q,rfl⟩

end P14RealComplex
end
end

section

noncomputable section
namespace P14MetricRealization
open Matrix
open scoped MatrixOrder

/-- A positive real metric can be realized by an invertible change of Euclidean coordinates. -/
theorem exists_coordinates {d : Type*} [Fintype d] [DecidableEq d]
    (H : Matrix d d ℝ) (hH : H.PosDef) :
    ∃ F : (d → ℝ) ≃ₗ[ℝ] (d → ℝ),
      ∀ v w, dotProduct (F v) (F w) = dotProduct v (H *ᵥ w) := by
  obtain ⟨L,hL,hfac⟩ := CStarAlgebra.isStrictlyPositive_iff_eq_star_mul_self.mp
    hH.isStrictlyPositive
  let F : (d → ℝ) ≃ₗ[ℝ] (d → ℝ) :=
    LinearEquiv.ofBijective L.mulVecLin
      ⟨Matrix.mulVec_injective_iff_isUnit.mpr hL, Matrix.mulVec_surjective_iff_isUnit.mpr hL⟩
  refine ⟨F, ?_⟩
  intro v w
  change dotProduct (L *ᵥ v) (L *ᵥ w) = dotProduct v (H *ᵥ w)
  rw [hfac, star_eq_conjTranspose, conjTranspose_eq_transpose_of_trivial,
    ← Matrix.mulVec_mulVec]
  conv_rhs => rw [dotProduct_mulVec, vecMul_transpose]

end P14MetricRealization
end
end

section

noncomputable section
namespace P14SeedInterfaceDim
open Matrix Submodule
open scoped ComplexOrder

def pair {k : ℕ} (v w : Fin k → ℂ) : ℂ := ∑ j, star (v j) * w j

def orthGraph {k m : ℕ} (v : Fin m → Fin k → ℂ) : SimpleGraph (Fin m) :=
  SimpleGraph.fromRel fun i j => pair (v i) (v j) = 0

/-- The dimension-parameterized seed predicate; the bridge is adapted from the
previously verified k=4 SeedInterface without changing that source. -/
def Seed (k m : ℕ) : Prop :=
  ∃ v : Fin m → Fin k → ℂ, ∃ N : Fin m → Finset (Fin m),
    (∀ i, v i ≠ 0) ∧
    (∀ i j, pair (v i) (v j) = 0 ↔ j ∈ N i) ∧
    (∀ i, (N i).card = k) ∧
    (orthGraph v).Connected ∧
    (∀ S : Finset (Fin m), S.card ≤ k - 1 →
      LinearIndependent ℂ fun i : (S : Set (Fin m)) => v i) ∧
    (∀ S : Finset (Fin m), S.card = k + 1 → ∀ a : Fin k → ℂ, a ≠ 0 →
      ∃ i ∈ S, pair a (v i) ≠ 0)

def pairMap {k : ℕ} (a : Fin k → ℂ) : (Fin k → ℂ) →ₗ[ℂ] ℂ where
  toFun := pair a
  map_add' := by intro x y; simp [pair, mul_add, Finset.sum_add_distrib]
  map_smul' := by
    intro c x
    simp only [pair, Pi.smul_apply, smul_eq_mul, RingHom.id_apply]
    rw [Finset.mul_sum]
    apply Finset.sum_congr rfl
    intro j _
    ring

lemma spanning_survivor {k : ℕ} {ι : Type*} (v : ι → Fin k → ℂ)
    (hv : span ℂ (Set.range v) = ⊤) (a : Fin k → ℂ) (ha : a ≠ 0) :
    ∃ i, pair a (v i) ≠ 0 := by
  by_contra h
  push Not at h
  have hs : span ℂ (Set.range v) ≤ LinearMap.ker (pairMap a) := by
    apply span_le.mpr
    rintro _ ⟨i,rfl⟩
    exact h i
  have he : pair a a = 0 := hs (by rw [hv]; trivial)
  exact ha (dotProduct_star_self_eq_zero.mp he)

theorem of_metric_family {ι : Type*} [Fintype ι] [DecidableEq ι]
    {k m : ℕ} (e : Fin m ≃ ι) (G : SimpleGraph ι) [DecidableRel G.Adj]
    (hconn : G.Connected) (hdeg : ∀ i, G.degree i = k)
    (H : Matrix (Fin k) (Fin k) ℝ) (hH : H.PosDef)
    (v : ι → Fin k → ℝ) (hnz : ∀ i, v i ≠ 0)
    (hedge : ∀ i j, dotProduct (v i) (H *ᵥ v j) = 0 ↔ G.Adj i j)
    (hli : ∀ d : ℕ, d ≤ k - 1 → ∀ f : Fin d → ι, Function.Injective f →
      LinearIndependent ℝ (fun q => v (f q)))
    (hspan : ∀ f : Fin (k + 1) → ι, Function.Injective f →
      span ℝ (Set.range fun q => v (f q)) = ⊤) : Seed k m := by
  classical
  obtain ⟨F,hF⟩ := P14MetricRealization.exists_coordinates H hH
  let w : Fin m → Fin k → ℂ := fun i => P14RealComplex.embed (F (v (e i)))
  let G' := G.comap e
  let iso : G' ≃g G := SimpleGraph.Iso.comap e G
  have hp (i j : Fin m) : pair (w i) (w j) = 0 ↔ G'.Adj i j := by
    change (∑ r, star (P14RealComplex.embed (F (v (e i))) r) *
      P14RealComplex.embed (F (v (e j))) r) = 0 ↔ G.Adj (e i) (e j)
    rw [P14RealComplex.pair]
    change ((dotProduct (F (v (e i))) (F (v (e j))) : ℝ) : ℂ) = 0 ↔ _
    rw [hF, Complex.ofReal_eq_zero, hedge]
  have hg : orthGraph w = G' := by
    ext i j
    simp only [orthGraph, SimpleGraph.fromRel_adj, hp]
    constructor
    · rintro ⟨_,h | h⟩
      · exact h
      · exact h.symm
    · intro h; exact ⟨h.ne, Or.inl h⟩
  refine ⟨w, (fun i => G'.neighborFinset i), ?_, ?_, ?_, ?_, ?_, ?_⟩
  · intro i h
    apply hnz (e i)
    apply F.injective
    apply P14RealComplex.embed_injective
    simpa [w] using h
  · intro i j
    rw [SimpleGraph.mem_neighborFinset]
    exact hp i j
  · intro i
    rw [SimpleGraph.card_neighborFinset_eq_degree, ← iso.degree_eq]
    exact hdeg (e i)
  · rw [hg]
    exact iso.connected_iff.mpr hconn
  · intro S hS
    let es : (S : Set (Fin m)) ≃ Fin S.card := Fintype.equivFinOfCardEq (by simp)
    let f : Fin S.card → ι := fun q => e (es.symm q).val
    have hf : Function.Injective f := e.injective.comp
      (Subtype.val_injective.comp es.symm.injective)
    have hr := (hli S.card hS f hf).map' F.toLinearMap F.ker
    have hc := P14RealComplex.independent (fun q => F (v (f q))) hr
    have ht := hc.comp es es.injective
    simpa [w, f, Function.comp_def] using ht
  · intro S hS a ha
    let es : (S : Set (Fin m)) ≃ Fin (k + 1) := Fintype.equivFinOfCardEq (by simpa using hS)
    let f : Fin (k + 1) → ι := fun q => e (es.symm q).val
    have hf : Function.Injective f := e.injective.comp
      (Subtype.val_injective.comp es.symm.injective)
    have hr : span ℝ (Set.range fun q => F (v (f q))) = ⊤ := by
      have hm := congrArg (Submodule.map F.toLinearMap) (hspan f hf)
      simpa [Submodule.map_span, ← Set.range_comp, Function.comp_def, Submodule.map_top,
        LinearMap.range_eq_top.mpr F.surjective] using hm
    have hc := P14RealComplex.spanning (fun q => F (v (f q))) hr
    obtain ⟨q,hq⟩ := spanning_survivor _ hc a ha
    exact ⟨(es.symm q).val, (es.symm q).property, hq⟩

end P14SeedInterfaceDim
end
end

section

/-! Exact Hermitian pairings of the actual common Fourier family. -/

noncomputable section

namespace P14FourierPhysicalPairings

open P14FourierPhysicalFamily P14FourierSpectralWeights P14SeedInterfaceDim

def phase {n : ℕ} (a b : Fin n) (q : ℕ) : ℂ :=
  star (fourierRoot n ^ (a.val * q)) * fourierRoot n ^ (b.val * q)

def scale (n : ℕ) : ℂ := star (fourierNormalization n) * fourierNormalization n

theorem scale_ne_zero (n : ℕ) (hn : 0 < n) : scale n ≠ 0 :=
  mul_ne_zero (star_ne_zero.mpr (fourierNormalization_ne_zero n hn))
    (fourierNormalization_ne_zero n hn)

theorem a_pairing {n k : ℕ} (d : ℕ) (H : Fin k → ℝ)
    (hH : ∀ j, 0 ≤ H j) (a b : Fin n) :
    pair (physicalFamily d H (Sum.inl a)) (physicalFamily d H (Sum.inl b)) =
      scale n * ∑ j, phase a b (d + j.val) * (H j : ℂ) := by
  unfold pair
  rw [Finset.mul_sum]
  apply Finset.sum_congr rfl
  intro j _
  simpa only [physicalFamily, Sum.elim_inl, scale, phase, mul_assoc] using
    P14ComplexSqrtPairEntries.a_entry (fourierNormalization n)
      (fourierRoot n ^ (a.val * (d + j.val)))
      (fourierRoot n ^ (b.val * (d + j.val))) (H j) (hH j)

theorem b_pairing {n k : ℕ} (d : ℕ) (H : Fin k → ℝ)
    (hH : ∀ j, 0 ≤ H j) (a b : Fin n) :
    pair (physicalFamily d H (Sum.inr a)) (physicalFamily d H (Sum.inr b)) =
      scale n * ∑ j, phase a b (d + j.val) *
        (Complex.normSq (spectralWeight (fourierRoot n) d (d + j.val)) : ℂ) / (H j : ℂ) := by
  unfold pair
  rw [Finset.mul_sum]
  apply Finset.sum_congr rfl
  intro j _
  simpa only [physicalFamily, Sum.elim_inr, scale, phase, mul_assoc, mul_div_assoc] using
    P14ComplexSqrtPairEntries.b_entry (fourierNormalization n)
      (fourierRoot n ^ (a.val * (d + j.val)))
      (fourierRoot n ^ (b.val * (d + j.val)))
      (spectralWeight (fourierRoot n) d (d + j.val)) (H j) (hH j)

theorem cross_pairing {n k : ℕ} (d : ℕ) (H : Fin k → ℝ)
    (hH : ∀ j, 0 < H j) (a b : Fin n) :
    pair (physicalFamily d H (Sum.inl a)) (physicalFamily d H (Sum.inr b)) =
      scale n * ∑ j : Fin k, phase a b (d + j.val) *
        star (spectralWeight (fourierRoot n) d (d + j.val)) := by
  unfold pair
  rw [Finset.mul_sum]
  apply Finset.sum_congr rfl
  intro j _
  simpa only [physicalFamily, Sum.elim_inl, Sum.elim_inr, scale, phase, mul_assoc] using
    P14ComplexSqrtPairEntries.cross_entry (fourierNormalization n)
      (fourierRoot n ^ (a.val * (d + j.val)))
      (fourierRoot n ^ (b.val * (d + j.val)))
      (spectralWeight (fourierRoot n) d (d + j.val)) (H j) (hH j)

theorem cross_pairing_independent_parameters {n k : ℕ} (d : ℕ)
    (H H' : Fin k → ℝ) (hH : ∀ j, 0 < H j) (hH' : ∀ j, 0 < H' j) (a b : Fin n) :
    pair (physicalFamily d H (Sum.inl a)) (physicalFamily d H (Sum.inr b)) =
      pair (physicalFamily d H' (Sum.inl a)) (physicalFamily d H' (Sum.inr b)) := by
  rw [cross_pairing d H hH, cross_pairing d H' hH']


end P14FourierPhysicalPairings
end
end

section

/-! Exact finite character orthogonality for the actual complex Fourier root.
The geometric sum needs only an nth-root equation; primitivity identifies
the surviving character with the original modulo row label. -/

namespace P14FourierRootOrthogonality

open P14FourierPhysicalPairings P14FourierSpectralWeights
open scoped BigOperators

theorem sum_pow_eq_ite {n : ℕ} (w : ℂ) (hw : w ^ n = 1) :
    (∑ q : Fin n, w ^ q.val) = if w = 1 then (n : ℂ) else 0 := by
  classical
  by_cases hwOne : w = 1
  · simp [hwOne]
  · rw [if_neg hwOne, Fin.sum_univ_eq_sum_range]
    have hzero : (∑ q ∈ Finset.range n, w ^ q) * (w - 1) = 0 := by
      rw [geom_sum_mul, hw, sub_self]
    exact (mul_eq_zero.mp hzero).resolve_right (sub_ne_zero.mpr hwOne)

theorem root_character_orthogonality {n : ℕ} (hn : 0 < n) (a b j : Fin n) :
    (∑ q : Fin n, phase a b q.val * star ((fourierRoot n ^ q.val) ^ j.val)) =
      if b.val = (a.val + j.val) % n then (n : ℂ) else 0 := by
  classical
  let ζ : ℂ := fourierRoot n
  have hζ : IsPrimitiveRoot ζ n := fourierRoot_isPrimitiveRoot n hn
  let w : ℂ := phase a b 1 * star (ζ ^ j.val)
  have hPower (m : ℕ) : (ζ ^ m) ^ n = 1 := by
    rw [← pow_mul, Nat.mul_comm, pow_mul, hζ.pow_eq_one, one_pow]
  have hw : w ^ n = 1 := by
    change ((star (ζ ^ (a.val * 1)) * ζ ^ (b.val * 1)) * star (ζ ^ j.val)) ^ n = 1
    simp only [Nat.mul_one, mul_pow, ← star_pow, hPower, star_one, one_mul]
  have hunit : star ζ * ζ = 1 := by
    change (starRingEnd ℂ) ζ * ζ = 1
    simpa only [hζ.norm'_eq_one (Nat.ne_of_gt hn), one_pow, Complex.ofReal_one]
      using Complex.conj_mul' ζ
  have hself (m : ℕ) : star (ζ ^ m) * ζ ^ m = 1 := by
    rw [star_pow, ← mul_pow, hunit, one_pow]
  have hwForm : w = star (ζ ^ (a.val + j.val)) * ζ ^ b.val := by
    change (star (ζ ^ (a.val * 1)) * ζ ^ (b.val * 1)) * star (ζ ^ j.val) = _
    simp only [Nat.mul_one, pow_add, star_mul]
    ring
  have hBaseEq : w = 1 ↔ ζ ^ b.val = ζ ^ (a.val + j.val) := by
    rw [hwForm]
    constructor
    · intro h
      apply mul_left_cancel₀
        (star_ne_zero.mpr (pow_ne_zero _ (hζ.ne_zero (Nat.ne_of_gt hn))))
      exact h.trans (hself (a.val + j.val)).symm
    · intro h
      rw [h, hself]
  have hLabel : w = 1 ↔ b.val = (a.val + j.val) % n := by
    rw [hBaseEq]
    constructor
    · intro h
      apply hζ.pow_inj b.isLt (Nat.mod_lt _ hn)
      exact h.trans (pow_eq_pow_mod (a.val + j.val) hζ.pow_eq_one)
    · intro h
      rw [h, ← pow_eq_pow_mod (a.val + j.val) hζ.pow_eq_one]
  have hTerm (q : Fin n) :
      phase a b q.val * star ((ζ ^ q.val) ^ j.val) = w ^ q.val := by
    have hcomm : (ζ ^ q.val) ^ j.val = (ζ ^ j.val) ^ q.val := by
      rw [← pow_mul, Nat.mul_comm, pow_mul]
    rw [hcomm]
    change (star (ζ ^ (a.val * q.val)) * ζ ^ (b.val * q.val)) *
        star ((ζ ^ j.val) ^ q.val) =
      ((star (ζ ^ (a.val * 1)) * ζ ^ (b.val * 1)) * star (ζ ^ j.val)) ^ q.val
    simp only [Nat.mul_one, pow_mul, star_pow, mul_pow]
  calc
    (∑ q : Fin n, phase a b q.val * star ((fourierRoot n ^ q.val) ^ j.val)) =
        ∑ q : Fin n, w ^ q.val := Finset.sum_congr rfl (fun q _ => hTerm q)
    _ = if w = 1 then (n : ℂ) else 0 := sum_pow_eq_ite w hw
    _ = if b.val = (a.val + j.val) % n then (n : ℂ) else 0 := by simp only [hLabel]


end P14FourierRootOrthogonality
end

section

/-! The explicit balanced spectral matrix in border/Fourier coordinates.
The middle operator swaps the border and the constant character and phases
every other character. The actual matrix has orthonormal nonzero columns. -/

noncomputable section
namespace P14BalancedSpectralMatrix

open Matrix P14FourierSpectralWeights P14FourierPhysicalPairings
open P14FourierRootOrthogonality
open scoped BigOperators

def fourierMatrix (p : ℕ) : Matrix (Fin p) (Fin p) ℂ :=
  fun a b => fourierNormalization p * fourierRoot p ^ (a.val * b.val)

private theorem normalization_gram (p : ℕ) (hp : 0 < p) :
    star (fourierNormalization p) * fourierNormalization p * (p : ℂ) = 1 := by
  have hpC : (p : ℂ) ≠ 0 := Nat.cast_ne_zero.mpr (Nat.ne_of_gt hp)
  have hs : (Real.sqrt (p : ℝ) : ℂ) * (Real.sqrt (p : ℝ) : ℂ) = (p : ℂ) := by
    norm_cast
    exact Real.mul_self_sqrt (Nat.cast_nonneg p)
  simp only [fourierNormalization, Complex.star_def, map_inv₀, Complex.conj_ofReal]
  rw [← mul_inv, hs, inv_mul_cancel₀ hpC]

theorem fourierMatrix_unitary (p : ℕ) (hp : 0 < p) :
    fourierMatrix p ∈ Matrix.unitaryGroup (Fin p) ℂ := by
  classical
  letI : NeZero p := ⟨Nat.ne_of_gt hp⟩
  apply Matrix.mem_unitaryGroup_iff'.mpr
  ext a b
  change (∑ q, star (fourierMatrix p q a) * fourierMatrix p q b) =
    if a = b then 1 else 0
  have hsum : (∑ q : Fin p, phase a b q.val) = if a = b then (p : ℂ) else 0 := by
    simpa [Fin.ext_iff, Nat.mod_eq_of_lt a.isLt, eq_comm] using
      root_character_orthogonality hp a b (0 : Fin p)
  have hterm (q : Fin p) :
      star (fourierMatrix p q a) * fourierMatrix p q b =
        (star (fourierNormalization p) * fourierNormalization p) * phase a b q.val := by
    simp only [fourierMatrix, phase, star_mul,
      Nat.mul_comm q.val a.val, Nat.mul_comm q.val b.val]
    ring
  calc
    _ = (star (fourierNormalization p) * fourierNormalization p) *
        (∑ q : Fin p, phase a b q.val) := by
      rw [Finset.mul_sum]
      exact Finset.sum_congr rfl (fun q _ => hterm q)
    _ = _ := by
      rw [hsum]
      by_cases hab : a = b
      · simp only [if_pos hab]
        exact normalization_gram p hp
      · simp only [if_neg hab, mul_zero]

def basisChange (p : ℕ) : Matrix (Option (Fin p)) (Option (Fin p)) ℂ
  | none, none => 1
  | none, some _ => 0
  | some _, none => 0
  | some a, some b => fourierMatrix p a b

theorem basisChange_unitary (p : ℕ) (hp : 0 < p) :
    basisChange p ∈ Matrix.unitaryGroup (Option (Fin p)) ℂ := by
  classical
  apply Matrix.mem_unitaryGroup_iff'.mpr
  ext i j
  cases i with
  | none =>
    cases j <;> simp [Matrix.mul_apply, Matrix.star_eq_conjTranspose,
      Matrix.conjTranspose_apply, Fintype.sum_option, basisChange, Matrix.one_apply]
  | some a =>
    cases j with
    | none =>
      simp [Matrix.mul_apply, Matrix.star_eq_conjTranspose,
        Matrix.conjTranspose_apply, Fintype.sum_option, basisChange, Matrix.one_apply]
    | some b =>
      have h := congrArg (fun M : Matrix (Fin p) (Fin p) ℂ => M a b)
        (fourierMatrix_unitary p hp).1
      simpa [Matrix.mul_apply, Matrix.star_eq_conjTranspose,
        Matrix.conjTranspose_apply, Fintype.sum_option, basisChange, Matrix.one_apply] using h

def weightedPermutation {V : Type*} [DecidableEq V] (e : V ≃ V) (w : V → ℂ) :
    Matrix V V ℂ := fun i j => if i = e j then w j else 0

private theorem weightedPermutation_unitary {V : Type*} [Fintype V] [DecidableEq V]
    (e : V ≃ V) (w : V → ℂ) (hw : ∀ j, star (w j) * w j = 1) :
    weightedPermutation e w ∈ Matrix.unitaryGroup V ℂ := by
  apply Matrix.mem_unitaryGroup_iff'.mpr
  ext i j
  change (∑ q, star (weightedPermutation e w q i) * weightedPermutation e w q j) =
    if i = j then 1 else 0
  by_cases hij : i = j
  · subst j
    simpa [weightedPermutation, ite_mul, mul_ite] using hw i
  · have heij : e i ≠ e j := e.injective.ne hij
    simp [weightedPermutation, ite_mul, mul_ite, hij, Ne.symm hij, heij]

def phaseWeight {p : ℕ} (η : ℂ) : Option (Fin p) → ℂ
  | none => 1
  | some j => η ^ j.val

def swapPhase {p : ℕ} [NeZero p] (η : ℂ) :
    Matrix (Option (Fin p)) (Option (Fin p)) ℂ :=
  weightedPermutation (Equiv.swap none (some (0 : Fin p))) (phaseWeight η)

def spectralMatrix {p : ℕ} [NeZero p] (η : ℂ) :
    Matrix (Option (Fin p)) (Option (Fin p)) ℂ :=
  basisChange p * swapPhase η * (basisChange p)ᴴ

theorem spectralMatrix_unitary {p : ℕ} [NeZero p] (hp : 3 ≤ p)
    {η : ℂ} (hη : IsPrimitiveRoot η (p - 1)) :
    spectralMatrix (p := p) η ∈ Matrix.unitaryGroup (Option (Fin p)) ℂ := by
  have hηunit : star η * η = 1 := by
    change (starRingEnd ℂ) η * η = 1
    simpa only [hη.norm'_eq_one (by omega), one_pow, Complex.ofReal_one] using
      Complex.conj_mul' η
  have hw : ∀ j : Option (Fin p), star (phaseWeight η j) * phaseWeight η j = 1 := by
    intro j
    cases j with
    | none => simp [phaseWeight]
    | some j =>
      simp only [phaseWeight, star_pow, ← mul_pow, hηunit, one_pow]
  have hC := basisChange_unitary p (by omega)
  have hS : swapPhase (p := p) η ∈ Matrix.unitaryGroup (Option (Fin p)) ℂ :=
    weightedPermutation_unitary _ _ hw
  change basisChange p * swapPhase η * star (basisChange p) ∈
    unitary (Matrix (Option (Fin p)) (Option (Fin p)) ℂ)
  exact (unitary _).mul_mem ((unitary _).mul_mem hC hS) (Unitary.star_mem hC)

def matrix (p : ℕ) [NeZero p] : Matrix (Option (Fin p)) (Option (Fin p)) ℂ :=
  spectralMatrix (p := p) (fourierRoot (p - 1))

theorem matrix_unitary {p : ℕ} [NeZero p] (hp : 3 ≤ p) :
    matrix p ∈ Matrix.unitaryGroup (Option (Fin p)) ℂ :=
  spectralMatrix_unitary hp (fourierRoot_isPrimitiveRoot (p - 1) (by omega))

theorem columns_gram {p : ℕ} [NeZero p] (hp : 3 ≤ p)
    (i j : Option (Fin p)) :
    (∑ q, star (matrix p q i) * matrix p q j) = if i = j then 1 else 0 := by
  have h := congrArg (fun M : Matrix (Option (Fin p)) (Option (Fin p)) ℂ => M i j)
    (matrix_unitary hp).1
  simpa only [Matrix.star_eq_conjTranspose, Matrix.mul_apply,
    Matrix.conjTranspose_apply, Matrix.one_apply] using h

theorem columns_ne_zero {p : ℕ} [NeZero p] (hp : 3 ≤ p) (j : Option (Fin p)) :
    (fun q => matrix p q j) ≠ 0 := by
  intro hz
  have hz' : ∀ q, matrix p q j = 0 := fun q => congrFun hz q
  have hbad : (0 : ℂ) = 1 := by simpa [hz'] using columns_gram hp j j
  exact zero_ne_one hbad

end P14BalancedSpectralMatrix

end
end

section

/-! The general Fourier defect frame. Its discarded weights are the
positive square roots of the actual spectral norm deficits. -/

noncomputable section
open Matrix
namespace P14GeneralPhysicalFrame
open Polynomial P14FourierSpectralWeights P14FourierWeightWindow
open P14BalancedSpectralMatrix P14UnitaryDefectFrame P14UnitaryDefectGram

def spectral (q : ℕ) (e : ℝ) (P : ℂ[X]) (k : Fin q) : ℂ :=
  1+(e:ℂ)*P.eval (fourierRoot q^k.val)

def tail (q m : ℕ) : Finset (Fin q) := Finset.univ.filter (fun k => m < k.val)

def delta (q m : ℕ) (e : ℝ) (P : ℂ[X]) (k : tail q m) : ℂ :=
  Real.sqrt (1-Complex.normSq (spectral q e P k.val))

def matrix (q m : ℕ) (e : ℝ) (P : ℂ[X]) :
    Matrix (Fin q ⊕ tail q m) (Fin q ⊕ Fin q) ℂ :=
  frame (fourierMatrix q) (spectral q e P) (tail q m) (delta q m e P)

def nullMatrix (q m : ℕ) (hq : m+1 ≤ q) (e : ℝ) (P : ℂ[X]) :
    Matrix (Fin q ⊕ Fin q) (Fin (m+1)) ℂ :=
  kernel (fourierMatrix q) (spectral q e P)
    (fun k => ⟨k.val, lt_of_lt_of_le k.isLt hq⟩)

theorem delta_nonzero {q m : ℕ} {e : ℝ} {P : ℂ[X]}
    (ht : ∀ k : Fin q, m < k.val → Complex.normSq (spectral q e P k) < 1)
    (k : tail q m) : delta q m e P k ≠ 0 := by
  have hk := (Finset.mem_filter.mp k.property).2
  have hp := Real.sqrt_pos.mpr (sub_pos.mpr (ht k.val hk))
  unfold delta
  exact_mod_cast hp.ne'

theorem delta_square {q m : ℕ} {e : ℝ} {P : ℂ[X]}
    (ht : ∀ k : Fin q, m < k.val → Complex.normSq (spectral q e P k) < 1)
    (k : tail q m) :
    star (delta q m e P k)*delta q m e P k =
      ((1-Complex.normSq (spectral q e P k.val) : ℝ) : ℂ) := by
  have hp := (sub_pos.mpr (ht k.val (Finset.mem_filter.mp k.property).2)).le
  simp only [delta, Complex.star_def, Complex.conj_ofReal, ← Complex.ofReal_mul]
  exact congrArg Complex.ofReal (Real.mul_self_sqrt hp)

theorem energy {q m : ℕ} {e : ℝ} {P : ℂ[X]}
    (hr : ∀ k : Fin (m+1), Complex.normSq (1+(e:ℂ)*P.eval (sample q m k))=1)
    (ht : ∀ k : Fin q, m < k.val → Complex.normSq (spectral q e P k) < 1)
    (k : Fin q) :
    star (spectral q e P k)*spectral q e P k +
      defectWeight (tail q m) (delta q m e P) k = 1 := by
  have hl : star (spectral q e P k)*spectral q e P k =
      (Complex.normSq (spectral q e P k) : ℂ) := by
    exact Complex.normSq_eq_conj_mul_self.symm
  rw [hl]
  by_cases hk : k ∈ tail q m
  · simp only [defectWeight, dif_pos hk]
    rw [delta_square ht]
    push_cast
    ring
  · have hk' : k.val < m+1 := by
      simp only [tail, Finset.mem_filter, Finset.mem_univ, true_and] at hk
      omega
    have hn : Complex.normSq (spectral q e P k)=1 := hr ⟨k.val,hk'⟩
    simp [hn,defectWeight,hk]

theorem null_columns {q m : ℕ} (hq : m+1 ≤ q) (e : ℝ) (P : ℂ[X])
    (k : Fin (m+1)) : matrix q m e P *ᵥ (fun i => nullMatrix q m hq e P i k)=0 := by
  apply kernel_null (fourierMatrix q) (fourierMatrix_unitary q (by omega))
  intro j
  simp only [tail, Finset.mem_filter, Finset.mem_univ, true_and]
  have := j.isLt
  omega

theorem surjective {q m : ℕ} (hq : 0 < q) {e : ℝ} {P : ℂ[X]}
    (ht : ∀ k : Fin q, m < k.val → Complex.normSq (spectral q e P k) < 1) :
    Function.Surjective (fun a => matrix q m e P *ᵥ a) :=
  P14UnitaryDefectFrame.surjective (fourierMatrix q) (fourierMatrix_unitary q hq)
    _ _ _ (delta_nonzero ht)

theorem base_orthonormal {q m : ℕ} (hq : 0 < q) (e : ℝ) (P : ℂ[X]) (i j : Fin q) :
    pair (matrix q m e P) (Sum.inl i) (Sum.inl j) = if i=j then 1 else 0 :=
  base_gram (fourierMatrix q) (fourierMatrix_unitary q hq) _ _ _ i j

theorem spectral_orthonormal {q m : ℕ} (hq : 0 < q) {e : ℝ} {P : ℂ[X]}
    (hr : ∀ k : Fin (m+1), Complex.normSq (1+(e:ℂ)*P.eval (sample q m k))=1)
    (ht : ∀ k : Fin q, m < k.val → Complex.normSq (spectral q e P k) < 1)
    (i j : Fin q) :
    pair (matrix q m e P) (Sum.inr i) (Sum.inr j) = if i=j then 1 else 0 :=
  spectral_gram (fourierMatrix q) (fourierMatrix_unitary q hq) _ _ _ (energy hr ht) i j

theorem columns_nonzero {q m : ℕ} (hq : 0 < q) {e : ℝ} {P : ℂ[X]}
    (hr : ∀ k : Fin (m+1), Complex.normSq (1+(e:ℂ)*P.eval (sample q m k))=1)
    (ht : ∀ k : Fin q, m < k.val → Complex.normSq (spectral q e P k) < 1)
    (j : Fin q ⊕ Fin q) : (fun k => matrix q m e P k j) ≠ 0 :=
  P14UnitaryDefectGram.columns_nonzero (fourierMatrix q) (fourierMatrix_unitary q hq)
    _ _ _ (energy hr ht) j

theorem exists_data {q m : ℕ} (hm : 3 ≤ m) (hq : m+1 < q) (hodd : Odd q) :
    ∃ (e : ℝ) (P : ℂ[X]), 0 < e ∧ P.natDegree ≤ m-1 ∧
      (∀ k : Fin (m+1), Complex.normSq (1+(e:ℂ)*P.eval (sample q m k))=1) ∧
      (∀ k : Fin q, m < k.val → Complex.normSq (spectral q e P k) < 1) ∧
      ∀ f : Fin m → Fin q ⊕ Fin q, Function.Injective f →
        LinearIndependent ℂ (fun i => P14TwoLayerSelectionRows.model e
          (fun k : Fin (m+1) => P.eval (sample q m k)) (P14CubicGridBranch.node q) (f i)) := by
  apply P14AllTwoLayerSelections.exists_parameter hm hq hodd
    (P14CubicGridBranch.node q) (P14CubicGridBranch.node_injective (by omega))
  intro i
  exact pow_ne_zero _ ((fourierRoot_isPrimitiveRoot q (by omega)).ne_zero (by omega))

end P14GeneralPhysicalFrame
end
end

section

/-! The collision jet for the three-qubit spectral proposal. Two explicit
minors cannot both vanish. The second base point is allowed to coincide
with either shifted node; there is no genericity assumption. -/

noncomputable section
namespace P14QuadraticJetTriple

def row (x : ℂ) : Fin 4 → ℂ := fun i => x ^ i.val

def coordinates (last : Fin 4) : Fin 3 → Fin 4 := ![0, 1, last]

def minor (x y u v a b : ℂ) (last : Fin 4) : Matrix (Fin 3) (Fin 3) ℂ :=
  fun i j => (![row x, row y, fun k => a * row u k + b * row v k] i)
    (coordinates last j)

theorem det_two (x y u v a b : ℂ) :
    (minor x y u v a b 2).det = (y - x) *
      (a * (u - x) * (u - y) + b * (v - x) * (v - y)) := by
  simp [minor, row, coordinates, Matrix.det_fin_three]
  ring

theorem det_three (x y u v a b : ℂ) :
    (minor x y u v a b 3).det = (y - x) *
      (a * (u - x) * (u - y) * (u + x + y) +
       b * (v - x) * (v - y) * (v + x + y)) := by
  simp [minor, row, coordinates, Matrix.det_fin_three]
  ring

theorem exists_minor (x y u v a b : ℂ)
    (hxy : y ≠ x) (hux : u ≠ x) (hvx : v ≠ x) (huv : u ≠ v)
    (ha : a ≠ 0) (hb : b ≠ 0) :
    (minor x y u v a b 2).det ≠ 0 ∨ (minor x y u v a b 3).det ≠ 0 := by
  by_contra h
  push_neg at h
  rw [det_two] at h
  have he : a * (u - x) * (u - y) + b * (v - x) * (v - y) = 0 :=
    (mul_eq_zero.mp h.1).resolve_left (sub_ne_zero.mpr hxy)
  have hf : a * (u - x) * (u - y) * (u + x + y) +
      b * (v - x) * (v - y) * (v + x + y) = 0 := by
    have h3 := h.2
    rw [det_three] at h3
    exact (mul_eq_zero.mp h3).resolve_left (sub_ne_zero.mpr hxy)
  have hg : a * (u - x) * (u - y) * (u - v) = 0 := by
    linear_combination hf - (v + x + y) * he
  have huy : u = y := by
    rcases mul_eq_zero.mp hg with hg | hg
    · rcases mul_eq_zero.mp hg with hg | hg
      · exact False.elim ((mul_ne_zero ha (sub_ne_zero.mpr hux)) hg)
      · exact sub_eq_zero.mp hg
    · exact False.elim ((sub_ne_zero.mpr huv) hg)
  subst y
  have hvu : v ≠ u := Ne.symm huv
  have hz : b * (v - x) * (v - u) = 0 := by
    simpa only [sub_self, mul_zero, zero_add] using he
  exact (mul_ne_zero (mul_ne_zero hb (sub_ne_zero.mpr hvx))
    (sub_ne_zero.mpr hvu)) hz

theorem cyclic_collision (x y w a b : ℂ) (hxy : y ≠ x) (hx : x ≠ 0)
    (hw : w ≠ 0) (hw1 : w ≠ 1) (hw2 : w ^ 2 ≠ 1) (ha : a ≠ 0) (hb : b ≠ 0) :
    (minor x y (w * x) (w ^ 2 * x) a b 2).det ≠ 0 ∨
      (minor x y (w * x) (w ^ 2 * x) a b 3).det ≠ 0 := by
  apply exists_minor _ _ _ _ _ _ hxy
  · intro h
    exact hw1 (mul_right_cancel₀ hx (by simpa using h))
  · intro h
    exact hw2 (mul_right_cancel₀ hx (by simpa using h))
  · intro h
    have he : w = w ^ 2 := mul_right_cancel₀ hx h
    have hf : w * 1 = w * w := by simpa [pow_two] using he
    exact hw1 (mul_left_cancel₀ hw hf).symm
  · exact ha
  · exact hb

end P14QuadraticJetTriple
end
end

section

/-! The exact spectral branch separates an actual coincident row. The
same coordinate minor works for every sufficiently small nonzero parameter.
This resolves the limiting collision estimate, not the full UPB assembly. -/

noncomputable section
open Filter
open scoped Topology
namespace P14QuadraticCollisionLimit
open P14QuadraticSpectralCorrection P14QuadraticJetTriple

def wave (e : ℝ) (b : Coeff) (w x : ℂ) : Fin 4 → ℂ := fun k =>
  ((1 + e * b.1 : ℝ) : ℂ) * row x k +
    (e : ℂ) * b.2.1 * row (w * x) k +
    (e : ℂ) * b.2.2 * row (w ^ 2 * x) k

def waveMinor (e : ℝ) (b : Coeff) (w x y : ℂ) (last : Fin 4) :
    Matrix (Fin 3) (Fin 3) ℂ := fun i j =>
  (![row x, row y, wave e b w x] i) (coordinates last j)

theorem wave_det (e : ℝ) (b : Coeff) (w x y : ℂ) (last : Fin 4) :
    (waveMinor e b w x y last).det =
      (e : ℂ) * (minor x y (w * x) (w ^ 2 * x) b.2.1 b.2.2 last).det := by
  simp [waveMinor, wave, minor, coordinates, Matrix.det_fin_three]
  ring

theorem minor_continuous (x y u v : ℂ) (last : Fin 4) :
    Continuous (fun c : ℂ × ℂ => (minor x y u v c.1 c.2 last).det) := by
  apply Continuous.matrix_det
  apply continuous_pi
  intro i
  apply continuous_pi
  intro j
  fin_cases i <;> simp only [minor] <;> fun_prop

theorem eventually_collision (t : Coeff) (b : ℝ → Coeff)
    (hlim : Tendsto b (𝓝 0) (𝓝 t))
    (x y w : ℂ) (hxy : y ≠ x) (hx : x ≠ 0)
    (hw : w ≠ 0) (hw1 : w ≠ 1) (hw2 : w ^ 2 ≠ 1)
    (ha : t.2.1 ≠ 0) (hb : t.2.2 ≠ 0) :
    ∃ last : Fin 4, ∀ᶠ e in 𝓝 (0 : ℝ), e ≠ 0 →
      (waveMinor e (b e) w x y last).det ≠ 0 := by
  have hm := cyclic_collision x y w t.2.1 t.2.2 hxy hx hw hw1 hw2 ha hb
  have hex : ∃ last : Fin 4,
      (minor x y (w * x) (w ^ 2 * x) t.2.1 t.2.2 last).det ≠ 0 := by
    rcases hm with hm | hm
    · exact ⟨2, hm⟩
    · exact ⟨3, hm⟩
  obtain ⟨last, hn⟩ := hex
  have hl := ((minor_continuous x y (w * x) (w ^ 2 * x) last).tendsto
    t.2).comp ((continuous_snd.tendsto t).comp hlim)
  have hev : ∀ᶠ e in 𝓝 (0 : ℝ),
      (minor x y (w * x) (w ^ 2 * x) (b e).2.1 (b e).2.2 last).det ≠ 0 :=
    hl.eventually (isOpen_compl_singleton.mem_nhds hn)
  refine ⟨last, ?_⟩
  filter_upwards [hev] with e he
  intro he0
  rw [wave_det]
  exact mul_ne_zero (Complex.ofReal_ne_zero.mpr he0) he

theorem wave_value (e : ℝ) (b : Coeff) (w x : ℂ) (k : Fin 4) :
    wave e b w x k = P14QuadraticSpectralFactor.value e b (w ^ k.val) *
      row x k := by
  simp only [wave, P14QuadraticSpectralFactor.value, row, mul_pow]
  ring

end P14QuadraticCollisionLimit
end
end

section

/-! All two-base/one-spectral triples, including both collision cases,
are nondegenerate for one common sufficiently small parameter. -/

noncomputable section
open Filter
open scoped Topology
namespace P14QuadraticMixedTriples
open P14QuadraticSpectralCorrection P14QuadraticJetTriple P14QuadraticCollisionLimit

def matrix (e : ℝ) (b : Coeff) (w x y z : ℂ) (last : Fin 4) :
    Matrix (Fin 3) (Fin 3) ℂ := fun i j =>
  (![row x, row y, wave e b w z] i) (coordinates last j)

theorem zero_det (b : Coeff) (w x y z : ℂ) :
    (matrix 0 b w x y z 2).det = (y - x) * (z - x) * (z - y) := by
  simp [matrix, wave, row, coordinates, Matrix.det_fin_three]
  ring

theorem swap_collision (e : ℝ) (b : Coeff) (w x y : ℂ) (last : Fin 4) :
    (matrix e b w x y y last).det = -(waveMinor e b w y x last).det := by
  simp [matrix, waveMinor, coordinates, Matrix.det_fin_three]
  ring

theorem continuous_det (w x y z : ℂ) (last : Fin 4) :
    Continuous (fun p : ℝ × Coeff => (matrix p.1 p.2 w x y z last).det) := by
  apply Continuous.matrix_det
  apply continuous_pi
  intro i
  apply continuous_pi
  intro j
  fin_cases i
  · change Continuous (fun _ : ℝ × Coeff => row x (coordinates last j))
    exact continuous_const
  · change Continuous (fun _ : ℝ × Coeff => row y (coordinates last j))
    exact continuous_const
  · change Continuous (fun p : ℝ × Coeff => wave p.1 p.2 w z (coordinates last j))
    unfold wave
    fun_prop

theorem eventually_mixed (t : Coeff) (b : ℝ → Coeff)
    (hlim : Tendsto b (𝓝 0) (𝓝 t))
    (w x y z : ℂ) (hxy : y ≠ x) (hx : x ≠ 0) (hy : y ≠ 0)
    (hw : w ≠ 0) (hw1 : w ≠ 1) (hw2 : w ^ 2 ≠ 1)
    (ha : t.2.1 ≠ 0) (hb : t.2.2 ≠ 0) :
    ∀ᶠ e in 𝓝 (0 : ℝ), e ≠ 0 → ∃ last : Fin 4,
      (matrix e (b e) w x y z last).det ≠ 0 := by
  by_cases hzx : z = x
  · subst z
    obtain ⟨last, he⟩ := eventually_collision t b hlim x y w hxy hx hw hw1 hw2 ha hb
    filter_upwards [he] with e he
    intro he0
    exact ⟨last, he he0⟩
  by_cases hzy : z = y
  · subst z
    obtain ⟨last, he⟩ := eventually_collision t b hlim y x w hxy.symm hy hw hw1 hw2 ha hb
    filter_upwards [he] with e he
    intro he0
    refine ⟨last, ?_⟩
    rw [swap_collision]
    exact neg_ne_zero.mpr (he he0)
  have hn : (matrix 0 t w x y z 2).det ≠ 0 := by
    rw [zero_det]
    exact mul_ne_zero (mul_ne_zero (sub_ne_zero.mpr hxy) (sub_ne_zero.mpr hzx))
      (sub_ne_zero.mpr hzy)
  have hp : Tendsto (fun e => (e, b e)) (𝓝 (0 : ℝ)) (𝓝 (0, t)) :=
    tendsto_id.prodMk_nhds hlim
  have hl := ((continuous_det w x y z 2).tendsto (0, t)).comp hp
  have he := hl.eventually (isOpen_compl_singleton.mem_nhds hn)
  filter_upwards [he] with e he
  exact fun _ => ⟨2, he⟩

theorem eventually_common {ι : Type*} [Finite ι]
    (t : Coeff) (b : ℝ → Coeff) (hlim : Tendsto b (𝓝 0) (𝓝 t))
    (w : ℂ) (X : ι → ℂ) (hX : Function.Injective X) (hzero : ∀ i, X i ≠ 0)
    (hw : w ≠ 0) (hw1 : w ≠ 1) (hw2 : w ^ 2 ≠ 1)
    (ha : t.2.1 ≠ 0) (hb : t.2.2 ≠ 0) :
    ∀ᶠ e in 𝓝 (0 : ℝ), ∀ i j k : ι, j ≠ i → e ≠ 0 → ∃ last : Fin 4,
      (matrix e (b e) w (X i) (X j) (X k) last).det ≠ 0 := by
  apply Filter.eventually_all.mpr
  intro i
  apply Filter.eventually_all.mpr
  intro j
  apply Filter.eventually_all.mpr
  intro k
  by_cases hji : j = i
  · exact Filter.Eventually.of_forall (fun _ h => False.elim (h hji))
  · have hxy : X j ≠ X i := fun h => hji (hX h)
    filter_upwards [eventually_mixed t b hlim w (X i) (X j) (X k)
      hxy (hzero i) (hzero j) hw hw1 hw2 ha hb] with e he
    exact fun _ => he

end P14QuadraticMixedTriples
end
end

section

/-! Conjugation transfers two-base/one-spectral minors to the opposite
orientation on the same unit-modulus spectral branch. -/

noncomputable section
open Filter
open scoped BigOperators Topology
namespace P14QuadraticReverseTriples
open P14QuadraticSpectralCorrection P14QuadraticSpectralFactor
open P14QuadraticJetTriple P14QuadraticCollisionLimit P14QuadraticMixedTriples

def forward (L : Fin 4 → ℂ) (x y z : ℂ) (last : Fin 4) :
    Matrix (Fin 3) (Fin 3) ℂ := fun i j =>
  (![row x, row y, fun k => L k * row z k] i) (coordinates last j)

def reverse (L : Fin 4 → ℂ) (x y z : ℂ) (last : Fin 4) :
    Matrix (Fin 3) (Fin 3) ℂ := fun i j =>
  (![fun k => L k * row x k, fun k => L k * row y k, row z] i)
    (coordinates last j)

theorem reverse_eq (L : Fin 4 → ℂ) (hL : ∀ k, L k * star (L k) = 1)
    (x y z : ℂ) (last : Fin 4) :
    reverse L x y z last = fun i j => L (coordinates last j) *
      star (forward L (star x) (star y) (star z) last i j) := by
  have hu (k : Fin 4) : L k * (starRingEnd ℂ) (L k) = 1 := hL k
  funext i j
  fin_cases i <;> simp [reverse, forward, row, ← mul_assoc, hu]

theorem reverse_nonzero (L : Fin 4 → ℂ) (hL : ∀ k, L k * star (L k) = 1)
    (x y z : ℂ) (last : Fin 4)
    (h : (forward L (star x) (star y) (star z) last).det ≠ 0) :
    (reverse L x y z last).det ≠ 0 := by
  let N : Matrix (Fin 3) (Fin 3) ℂ := forward L (star x) (star y) (star z) last
  rw [reverse_eq L hL]
  change (Matrix.of (fun (i j : Fin 3) => L (coordinates last j) * star (N i j))).det ≠ 0
  have hd := Matrix.det_mul_row (fun j : Fin 3 => L (coordinates last j))
    (fun (i j : Fin 3) => star (N i j))
  rw [hd]
  apply mul_ne_zero
  · apply Finset.prod_ne_zero_iff.mpr
    intro j _ hj
    have hh := hL (coordinates last j)
    rw [hj, zero_mul] at hh
    exact zero_ne_one hh
  · change ((starRingEnd ℂ).mapMatrix N).det ≠ 0
    rw [← (starRingEnd ℂ).map_det]
    exact star_ne_zero.mpr h

theorem forward_wave (e : ℝ) (b : Coeff) (w x y z : ℂ) (last : Fin 4) :
    forward (fun k => value e b (w ^ k.val)) x y z last =
      matrix e b w x y z last := by
  funext i j
  fin_cases i
  · rfl
  · rfl
  · exact (wave_value e b w z (coordinates last j)).symm

theorem eventually_reverse {ι : Type*} [Finite ι]
    (t : Coeff) (b : ℝ → Coeff) (hlim : Tendsto b (𝓝 0) (𝓝 t))
    (w : ℂ) (X : ι → ℂ) (hX : Function.Injective X) (hzero : ∀ i, X i ≠ 0)
    (hw : w ≠ 0) (hw1 : w ≠ 1) (hw2 : w ^ 2 ≠ 1)
    (ha : t.2.1 ≠ 0) (hb : t.2.2 ≠ 0) :
    ∀ᶠ e in 𝓝 (0 : ℝ),
      (∀ k : Fin 4, value e (b e) (w ^ k.val) *
        star (value e (b e) (w ^ k.val)) = 1) →
      ∀ i j k : ι, j ≠ i → e ≠ 0 → ∃ last : Fin 4,
        (reverse (fun k => value e (b e) (w ^ k.val)) (X i) (X j) (X k) last).det ≠ 0 := by
  have hconj : Function.Injective (fun i => star (X i)) :=
    star_injective.comp hX
  have hcz : ∀ i, star (X i) ≠ 0 := fun i => star_ne_zero.mpr (hzero i)
  filter_upwards [eventually_common t b hlim w (fun i => star (X i))
    hconj hcz hw hw1 hw2 ha hb] with e he
  intro hunit i j k hji he0
  obtain ⟨last, hm⟩ := he i j k hji he0
  refine ⟨last, reverse_nonzero _ hunit _ _ _ _ ?_⟩
  rwa [forward_wave]

end P14QuadraticReverseTriples
end
end

section

/-! One actual positive parameter satisfies the prescribed Fourier defect,
unit values at the first four frequencies, and all mixed triple minors in
both orientations. No genericity, rank or positivity premise remains. -/

noncomputable section
open Filter
open scoped Topology
namespace P14QuadraticGridBranch
open P14ConsecutiveFourGridSigns P14QuadraticFourierTarget
open P14QuadraticSpectralCorrection P14QuadraticSpectralFactor P14FourierSpectralWeights
open P14QuadraticMixedTriples P14QuadraticReverseTriples

def node (q : ℕ) (i : Fin q) : ℂ := fourierRoot q ^ i.val
def spectral (q : ℕ) (e : ℝ) (b : Coeff) (k : ℕ) : ℂ := value e b (fourierRoot q ^ k)

theorem exists_data {q : ℕ} (hq : 7 ≤ q) :
    ∃ e : ℝ, ∃ b : Coeff, 0 < e ∧
      (∀ k : Fin q, Complex.normSq (spectral q e b k.val) = 1 - e * grid q k.val) ∧
      (∀ k : Fin q, spectral q e b k.val ≠ 0) ∧
      (∀ k : Fin 4, spectral q e b k.val * star (spectral q e b k.val) = 1) ∧
      (∀ i j k : Fin q, j ≠ i → ∃ last : Fin 4,
        (matrix e b (fourierRoot q) (node q i) (node q j) (node q k) last).det ≠ 0) ∧
      (∀ i j k : Fin q, j ≠ i → ∃ last : Fin 4,
        (reverse (fun k => spectral q e b k.val) (node q i) (node q j) (node q k) last).det ≠ 0) := by
  obtain ⟨b, _, hlim, hf⟩ := exists_factor (data q)
  have hp := fourierRoot_isPrimitiveRoot q (by omega)
  have hw : fourierRoot q ≠ 0 := hp.ne_zero (by omega)
  have hw1 : fourierRoot q ≠ 1 := by
    simpa using hp.pow_ne_one_of_pos_of_lt (by decide : 1 ≠ 0) (by omega : 1 < q)
  have hw2 : fourierRoot q ^ 2 ≠ 1 :=
    hp.pow_ne_one_of_pos_of_lt (by decide : 2 ≠ 0) (by omega : 2 < q)
  have hn : Function.Injective (node q) := by
    intro i j h
    exact Fin.ext (hp.pow_inj i.isLt j.isLt h)
  have hn0 : ∀ i, node q i ≠ 0 := fun i => pow_ne_zero _ hw
  obtain ⟨ha, hb⟩ := data_nonzero hq
  have hm := eventually_common (data q) b hlim (fourierRoot q) (node q) hn hn0
    hw hw1 hw2 ha hb
  have hr := eventually_reverse (data q) b hlim (fourierRoot q) (node q) hn hn0
    hw hw1 hw2 ha hb
  have hpos : ∀ᶠ e in 𝓝 (0 : ℝ), ∀ k : Fin q, 0 < 1 - e * grid q k.val := by
    apply Filter.eventually_all.mpr
    intro k
    have ht : Tendsto (fun e : ℝ => 1 - e * grid q k.val) (𝓝 0) (𝓝 1) := by
      simpa using tendsto_const_nhds.sub (tendsto_id.mul
        (tendsto_const_nhds : Tendsto (fun _ : ℝ => grid q k.val) (𝓝 0) (𝓝 (grid q k.val))))
    exact ht.eventually (lt_mem_nhds zero_lt_one)
  have hepos : ∀ᶠ e in 𝓝[>] (0 : ℝ), 0 < e := self_mem_nhdsWithin
  have hall := (((hf.and hm).and hr).and hpos).filter_mono
    (nhdsWithin_le_nhds : 𝓝[>] (0 : ℝ) ≤ 𝓝 0)
  obtain ⟨e, ⟨⟨⟨hfe, hme⟩, hre⟩, hpe⟩, he⟩ := (hall.and hepos).exists
  have hnorm (k : ℕ) : Complex.normSq (spectral q e (b e) k) = 1 - e * grid q k := by
    have hu : Complex.normSq (fourierRoot q ^ k) = 1 := by
      rw [root_power]
      exact phase_normSq _
    have h := hfe (fourierRoot q ^ k) hu
    rw [target_grid] at h
    simpa only [spectral, mul_neg, ← sub_eq_add_neg] using h
  have hunit (k : Fin 4) : spectral q e (b e) k.val *
      star (spectral q e (b e) k.val) = 1 := by
    have hz : Complex.normSq (spectral q e (b e) k.val) = 1 := by
      rw [hnorm, zero_first_four q k.val k.isLt]
      ring
    calc
      _ = (Complex.normSq (spectral q e (b e) k.val) : ℂ) := by
        rw [Complex.normSq_eq_conj_mul_self]
        exact mul_comm _ _
      _ = 1 := by rw [hz]; rfl
  refine ⟨e, b e, he, fun k => hnorm k.val, ?_, hunit, ?_, ?_⟩
  · intro k
    apply Complex.normSq_pos.mp
    rw [hnorm]
    exact hpe k
  · intro i j k hji
    exact hme i j k hji he.ne'
  · intro i j k hji
    exact hre hunit i j k hji he.ne'

end P14QuadraticGridBranch
end
end

section

/-! The actual Fourier defect frame and its four explicit null columns.
Every scalar energy and nonzero-weight hypothesis is discharged from the
checked quadratic grid data. Full triple and UPB assembly remain separate. -/

noncomputable section
open Matrix
open scoped BigOperators
namespace P14QuadraticPhysicalFrame
open P14ConsecutiveFourGridSigns P14QuadraticGridBranch
open P14QuadraticSpectralCorrection P14BalancedSpectralMatrix
open P14UnitaryDefectFrame P14UnitaryDefectGram

def tail (q : ℕ) : Finset (Fin q) := Finset.univ.filter (fun k => 4 ≤ k.val)

def delta (q : ℕ) (e : ℝ) (k : tail q) : ℂ := Real.sqrt (e * grid q k.val.val)

def matrix (q : ℕ) (e : ℝ) (b : Coeff) :
    Matrix (Fin q ⊕ tail q) (Fin q ⊕ Fin q) ℂ :=
  frame (fourierMatrix q) (fun k => spectral q e b k.val) (tail q) (delta q e)

def nullMatrix (q : ℕ) (hq : 4 ≤ q) (e : ℝ) (b : Coeff) :
    Matrix (Fin q ⊕ Fin q) (Fin 4) ℂ :=
  kernel (fourierMatrix q) (fun k => spectral q e b k.val)
    (fun k => ⟨k.val, lt_of_lt_of_le k.isLt hq⟩)

theorem delta_nonzero {q : ℕ} {e : ℝ} (he : 0 < e) (k : tail q) :
    delta q e k ≠ 0 := by
  have hk : 4 ≤ k.val.val := (Finset.mem_filter.mp k.property).2
  have hp := Real.sqrt_pos.mpr (mul_pos he (grid_positive hk k.val.isLt))
  unfold delta
  exact_mod_cast hp.ne'

theorem delta_square {q : ℕ} {e : ℝ} (he : 0 ≤ e) (k : tail q) :
    star (delta q e k) * delta q e k = (e * grid q k.val.val : ℝ) := by
  have hp := mul_nonneg he (grid_nonnegative k.val.isLt)
  simp only [delta, Complex.star_def, Complex.conj_ofReal, ← Complex.ofReal_mul]
  exact congrArg Complex.ofReal (Real.mul_self_sqrt hp)

theorem energy {q : ℕ} {e : ℝ} {b : Coeff} (he : 0 ≤ e)
    (hn : ∀ k : Fin q, Complex.normSq (spectral q e b k.val) = 1 - e * grid q k.val)
    (k : Fin q) :
    star (spectral q e b k.val) * spectral q e b k.val +
      defectWeight (tail q) (delta q e) k = 1 := by
  have hl : star (spectral q e b k.val) * spectral q e b k.val =
      ((1 - e * grid q k.val : ℝ) : ℂ) := by
    change (starRingEnd ℂ) (spectral q e b k.val) * spectral q e b k.val = _
    rw [← Complex.normSq_eq_conj_mul_self, hn k]
  rw [hl]
  by_cases hk : k ∈ tail q
  · simp only [defectWeight, dif_pos hk]
    rw [delta_square he]
    push_cast
    ring
  · have hk4 : k.val < 4 := by
      simp only [tail, Finset.mem_filter, Finset.mem_univ, true_and] at hk
      omega
    rw [zero_first_four q k.val hk4]
    simp [defectWeight, hk]

theorem null_columns {q : ℕ} (hq : 4 ≤ q) (e : ℝ) (b : Coeff) (k : Fin 4) :
    matrix q e b *ᵥ (fun i => nullMatrix q hq e b i k) = 0 := by
  apply kernel_null (fourierMatrix q) (fourierMatrix_unitary q (by omega))
  intro j
  simp only [tail, Finset.mem_filter, Finset.mem_univ, true_and]
  exact Nat.not_le.mpr j.isLt

theorem surjective {q : ℕ} (hq : 0 < q) {e : ℝ} (he : 0 < e) (b : Coeff) :
    Function.Surjective (fun a => matrix q e b *ᵥ a) :=
  P14UnitaryDefectFrame.surjective (fourierMatrix q) (fourierMatrix_unitary q hq)
    _ _ _ (delta_nonzero he)

theorem base_orthonormal {q : ℕ} (hq : 0 < q) (e : ℝ) (b : Coeff) (i j : Fin q) :
    pair (matrix q e b) (Sum.inl i) (Sum.inl j) = if i = j then 1 else 0 :=
  base_gram (fourierMatrix q) (fourierMatrix_unitary q hq) _ _ _ i j

theorem spectral_orthonormal {q : ℕ} (hq : 0 < q) {e : ℝ} {b : Coeff} (he : 0 ≤ e)
    (hn : ∀ k : Fin q, Complex.normSq (spectral q e b k.val) = 1 - e * grid q k.val)
    (i j : Fin q) :
    pair (matrix q e b) (Sum.inr i) (Sum.inr j) = if i = j then 1 else 0 :=
  spectral_gram (fourierMatrix q) (fourierMatrix_unitary q hq) _ _ _ (energy he hn) i j

theorem columns_nonzero {q : ℕ} (hq : 0 < q) {e : ℝ} {b : Coeff} (he : 0 ≤ e)
    (hn : ∀ k : Fin q, Complex.normSq (spectral q e b k.val) = 1 - e * grid q k.val)
    (j : Fin q ⊕ Fin q) : (fun k => matrix q e b k j) ≠ 0 :=
  P14UnitaryDefectGram.columns_nonzero (fourierMatrix q) (fourierMatrix_unitary q hq)
    _ _ _ (energy he hn) j

theorem exists_frame {q : ℕ} (hq : 7 ≤ q) :
    ∃ e : ℝ, ∃ b : Coeff, 0 < e ∧
      (∀ k : Fin q, Complex.normSq (spectral q e b k.val) = 1 - e * grid q k.val) ∧
      Function.Surjective (fun a => matrix q e b *ᵥ a) ∧
      (∀ k : Fin 4, matrix q e b *ᵥ (fun i => nullMatrix q (by omega) e b i k) = 0) ∧
      (∀ i j : Fin q, pair (matrix q e b) (Sum.inl i) (Sum.inl j) = if i = j then 1 else 0) ∧
      (∀ i j : Fin q, pair (matrix q e b) (Sum.inr i) (Sum.inr j) = if i = j then 1 else 0) ∧
      (∀ j : Fin q ⊕ Fin q, (fun k => matrix q e b k j) ≠ 0) := by
  obtain ⟨e, b, he, hn, _⟩ := exists_data hq
  exact ⟨e, b, he, hn, surjective (by omega) he b, null_columns (by omega) e b,
    base_orthonormal (by omega) e b, spectral_orthonormal (by omega) he.le hn,
    columns_nonzero (by omega) he.le hn⟩

end P14QuadraticPhysicalFrame
end
end

section

/-! The actual null rows are nonzero multiples of the checked
Vandermonde/spectral rows, at a bijective relabelling of Fourier nodes. -/

noncomputable section
open Matrix
namespace P14QuadraticKernelRows
open P14QuadraticPhysicalFrame P14QuadraticGridBranch P14QuadraticJetTriple
open P14QuadraticSpectralCorrection P14BalancedSpectralMatrix P14FourierSpectralWeights

def inverseIndex {q : ℕ} (hq : 0 < q) (i : Fin q) : Fin q :=
  ⟨(q - i.val) % q, Nat.mod_lt _ hq⟩

theorem node_injective {q : ℕ} (hq : 0 < q) : Function.Injective (node q) := by
  intro i j h
  exact Fin.ext ((fourierRoot_isPrimitiveRoot q hq).pow_inj i.isLt j.isLt h)

theorem inverse_node {q : ℕ} (hq : 0 < q) (i : Fin q) :
    node q (inverseIndex hq i) = star (node q i) := by
  have hp := fourierRoot_isPrimitiveRoot q hq
  have hn : node q i ≠ 0 := pow_ne_zero _ (hp.ne_zero (Nat.ne_of_gt hq))
  have he : node q (inverseIndex hq i) * node q i = 1 := by
    change fourierRoot q ^ ((q - i.val) % q) * fourierRoot q ^ i.val = 1
    rw [← pow_eq_pow_mod (q - i.val) hp.pow_eq_one, ← pow_add,
      Nat.sub_add_cancel i.isLt.le, hp.pow_eq_one]
  have hu : star (node q i) * node q i = 1 := by
    have hz : Complex.normSq (node q i) = 1 := by
      rw [node, P14QuadraticFourierTarget.root_power]
      exact P14QuadraticFourierTarget.phase_normSq _
    change (starRingEnd ℂ) (node q i) * node q i = 1
    rw [← Complex.normSq_eq_conj_mul_self, hz]
    rfl
  exact mul_right_cancel₀ hn (he.trans hu.symm)

theorem inverseIndex_injective {q : ℕ} (hq : 0 < q) :
    Function.Injective (inverseIndex hq) := by
  intro i j h
  have hn := congrArg (node q) h
  rw [inverse_node, inverse_node] at hn
  exact node_injective hq (star_injective hn)

theorem normalization_star (q : ℕ) : star (fourierNormalization q) = fourierNormalization q := by
  simp [fourierNormalization]

theorem dual_entry {q : ℕ} (hq : 0 < q) (i k : Fin q) :
    (fourierMatrix q)ᴴ i k =
      fourierNormalization q * (node q (inverseIndex hq i)) ^ k.val := by
  rw [inverse_node]
  simp only [Matrix.conjTranspose_apply, fourierMatrix, node, star_mul,
    normalization_star, star_pow, ← pow_mul, Nat.mul_comm]
  ring

def model {q : ℕ} (e : ℝ) (b : Coeff) : (Fin q ⊕ Fin q) → Fin 4 → ℂ
  | Sum.inl i, k => spectral q e b k.val * row (node q i) k
  | Sum.inr i, k => row (node q i) k

def relabel {q : ℕ} (hq : 0 < q) : (Fin q ⊕ Fin q) → (Fin q ⊕ Fin q)
  | Sum.inl i => Sum.inl (inverseIndex hq i)
  | Sum.inr i => Sum.inr (inverseIndex hq i)

def rowScale (q : ℕ) : (Fin q ⊕ Fin q) → ℂ
  | Sum.inl _ => -fourierNormalization q
  | Sum.inr _ => fourierNormalization q

theorem relabel_injective {q : ℕ} (hq : 0 < q) : Function.Injective (relabel hq) := by
  intro i j h
  cases i <;> cases j <;> simp only [relabel, Sum.inl.injEq, Sum.inr.injEq,
    Sum.inl_ne_inr, Sum.inr_ne_inl] at h
  · exact congrArg Sum.inl (inverseIndex_injective hq h)
  · exact congrArg Sum.inr (inverseIndex_injective hq h)

theorem rowScale_nonzero {q : ℕ} (hq : 0 < q) (i : Fin q ⊕ Fin q) :
    rowScale q i ≠ 0 := by
  cases i with
  | inl i => exact neg_ne_zero.mpr (fourierNormalization_ne_zero q hq)
  | inr i => exact fourierNormalization_ne_zero q hq

theorem null_row {q : ℕ} (hq : 4 ≤ q) (e : ℝ) (b : Coeff)
    (i : Fin q ⊕ Fin q) (k : Fin 4) :
    nullMatrix q hq e b i k = rowScale q i * model e b (relabel (by omega) i) k := by
  cases i with
  | inl i =>
    change -((fourierMatrix q)ᴴ i ⟨k.val, lt_of_lt_of_le k.isLt hq⟩ * spectral q e b k.val) = _
    rw [dual_entry (by omega)]
    simp only [rowScale, model, relabel, P14QuadraticJetTriple.row]
    ring
  | inr i =>
    change (fourierMatrix q)ᴴ i ⟨k.val, lt_of_lt_of_le k.isLt hq⟩ = _
    rw [dual_entry (by omega)]
    rfl

end P14QuadraticKernelRows
end
end

section

/-! Exact identification of the general null rows with the two-layer
selection model, including the Fourier conjugation and layer swap. -/

noncomputable section
open Matrix
namespace P14GeneralKernelRows
open Polynomial P14GeneralPhysicalFrame P14FourierWeightWindow
open P14BalancedSpectralMatrix P14FourierSpectralWeights P14CubicGridBranch
open P14QuadraticKernelRows (inverseIndex inverseIndex_injective rowScale rowScale_nonzero)

def relabel {q : ℕ} (hq : 0 < q) : (Fin q ⊕ Fin q) → (Fin q ⊕ Fin q)
  | Sum.inl i => Sum.inr (inverseIndex hq i)
  | Sum.inr i => Sum.inl (inverseIndex hq i)

theorem relabel_injective {q : ℕ} (hq : 0 < q) : Function.Injective (relabel hq) := by
  intro i j h
  cases i <;> cases j <;> simp only [relabel, Sum.inl.injEq, Sum.inr.injEq,
    Sum.inl_ne_inr, Sum.inr_ne_inl] at h
  · exact congrArg Sum.inl (inverseIndex_injective hq h)
  · exact congrArg Sum.inr (inverseIndex_injective hq h)

def GoodRows (q m : ℕ) (e : ℝ) (P : ℂ[X]) : Prop :=
  ∀ f : Fin m → Fin q ⊕ Fin q, Function.Injective f →
    LinearIndependent ℂ (fun i => P14TwoLayerSelectionRows.model e
      (fun k : Fin (m+1) => P.eval (sample q m k)) (node q) (f i))

theorem null_row {q m : ℕ} (hq : m+1 ≤ q) (e : ℝ) (P : ℂ[X])
    (i : Fin q ⊕ Fin q) (k : Fin (m+1)) :
    nullMatrix q m hq e P i k = rowScale q i *
      P14TwoLayerSelectionRows.model e (fun k : Fin (m+1) => P.eval (sample q m k))
        (node q) (relabel (by omega) i) k := by
  cases i with
  | inl i =>
    change -((fourierMatrix q)ᴴ i ⟨k.val,lt_of_lt_of_le k.isLt hq⟩ *
      spectral q e P ⟨k.val,lt_of_lt_of_le k.isLt hq⟩) = _
    rw [P14QuadraticKernelRows.dual_entry (by omega)]
    change -(fourierNormalization q * (node q (inverseIndex (by omega) i)) ^ k.val *
      (1+(e:ℂ)*P.eval (sample q m k))) =
      -fourierNormalization q * ((1+(e:ℂ)*P.eval (sample q m k)) *
        (node q (inverseIndex (by omega) i)) ^ k.val)
    ring
  | inr i =>
    change (fourierMatrix q)ᴴ i ⟨k.val,lt_of_lt_of_le k.isLt hq⟩ = _
    rw [P14QuadraticKernelRows.dual_entry (by omega)]
    rfl

theorem null_independent {q m : ℕ} (hq : m+1 ≤ q) (e : ℝ) (P : ℂ[X])
    (ht : GoodRows q m e P) (f : Fin m → Fin q ⊕ Fin q) (hf : Function.Injective f) :
    LinearIndependent ℂ (fun i k => nullMatrix q m hq e P (f i) k) := by
  have h := ht (relabel (by omega) ∘ f) ((relabel_injective (by omega)).comp hf)
  have hs := P14CubicRowOperations.row_scale _
    (fun i => rowScale q (f i)) (fun i => rowScale_nonzero (by omega) (f i)) h
  convert! hs using 1
  funext i k
  exact null_row hq e P (f i) k

end P14GeneralKernelRows
end
end

section

/-! Every all-but-m selection of general physical frame columns spans.
The m omitted coefficients can be canceled using the m+1 null columns. -/

noncomputable section
open Matrix Submodule
open scoped BigOperators
namespace P14GeneralFrameSpanning
open Polynomial P14GeneralPhysicalFrame P14GeneralKernelRows P14FourierWeightWindow

theorem supported_preimage {q m : ℕ} (hq : m+1 ≤ q) (e : ℝ) (P : ℂ[X])
    (hd : ∀ k : Fin q, m < k.val → Complex.normSq (spectral q e P k) < 1)
    (ht : GoodRows q m e P) (S : Finset (Fin q ⊕ Fin q)) (hS : S.card=2*q-m)
    (v : Fin q ⊕ tail q m → ℂ) :
    ∃ a : Fin q ⊕ Fin q → ℂ,
      matrix q m e P *ᵥ a = v ∧ ∀ i, i ∉ S → a i=0 := by
  have hc : Sᶜ.card=m := by
    simp only [Finset.card_compl, Fintype.card_sum, Fintype.card_fin, hS]
    omega
  let f : Fin m ≃ ↥(Sᶜ) := (Finset.equivFinOfCardEq hc).symm
  let r : Fin m → Fin q ⊕ Fin q := fun j => (f j).val
  have hr : Function.Injective r := Subtype.val_injective.comp f.injective
  apply P14RectangularKernelCorrection.supported_preimage
    (matrix q m e P) (nullMatrix q m hq e P)
    (null_columns hq e P) S r ?_ (null_independent hq e P ht r hr)
    (P14GeneralPhysicalFrame.surjective (by omega) hd) v
  intro i hi
  refine ⟨f.symm ⟨i,Finset.mem_compl.mpr hi⟩,?_⟩
  exact congrArg Subtype.val (f.apply_symm_apply ⟨i,Finset.mem_compl.mpr hi⟩)

theorem every_plus_one {q m : ℕ} (hq : m+1 ≤ q) (e : ℝ) (P : ℂ[X])
    (hd : ∀ k : Fin q, m < k.val → Complex.normSq (spectral q e P k) < 1)
    (ht : GoodRows q m e P) (S : Finset (Fin q ⊕ Fin q)) (hS : S.card=2*q-m) :
    span ℂ (Set.range (fun i : S => fun k => matrix q m e P k i.val))=⊤ := by
  apply top_unique
  intro v _
  obtain ⟨a,ha,hz⟩ := supported_preimage hq e P hd ht S hS v
  have hv : matrix q m e P *ᵥ a = ∑ i, a i • (fun k => matrix q m e P k i) := by
    ext k
    simp [Matrix.mulVec,dotProduct,Finset.sum_apply,Pi.smul_apply,smul_eq_mul,mul_comm]
  rw [←ha,hv]
  apply Submodule.sum_mem
  intro i _
  by_cases hi : i ∈ S
  · apply Submodule.smul_mem
    exact subset_span ⟨⟨i,hi⟩,rfl⟩
  · rw [hz i hi,zero_smul]
    exact Submodule.zero_mem _

theorem exists_spanning_frame {q m : ℕ} (hm : 3 ≤ m) (hq : m+1 < q) (hodd : Odd q) :
    ∃ (e : ℝ) (P : ℂ[X]), 0 < e ∧ P.natDegree ≤ m-1 ∧
      (∀ k : Fin (m+1), Complex.normSq (1+(e:ℂ)*P.eval (sample q m k))=1) ∧
      (∀ k : Fin q, m < k.val → Complex.normSq (spectral q e P k) < 1) ∧
      ∀ S : Finset (Fin q ⊕ Fin q), S.card=2*q-m →
        span ℂ (Set.range (fun i : S => fun k => matrix q m e P k i.val))=⊤ := by
  obtain ⟨e,P,he,hP,hr,hd,ht⟩ := exists_data hm hq hodd
  exact ⟨e,P,he,hP,hr,hd,every_plus_one (by omega) e P hd ht⟩

end P14GeneralFrameSpanning
end
end

section

/-! Discrete Fourier extraction of the coefficient indexed by the actual
modulo row difference. Degree below n prevents aliasing. -/

namespace P14FourierPolynomialExtraction

open P14FourierPolynomialExpansion P14FourierRootOrthogonality
open P14FourierPhysicalPairings P14FourierSpectralWeights
open scoped BigOperators

theorem label_iff_sub {n : ℕ} (hn : 0 < n) (a b j : Fin n) :
    b.val = (a.val + j.val) % n ↔ j = b - a := by
  letI : NeZero n := ⟨Nat.ne_of_gt hn⟩
  change b.val = (a + j).val ↔ j = b - a
  rw [Fin.val_inj, eq_sub_iff_add_eq]
  exact ⟨fun h => (add_comm j a).trans h.symm,
    fun h => h.symm.trans (add_comm j a)⟩

theorem fourier_extract_coefficient {n : ℕ} (hn : 0 < n)
    (P : Polynomial ℂ) (hdeg : P.natDegree < n) (a b : Fin n) :
    (∑ q : Fin n, phase a b q.val * star (P.eval (fourierRoot n ^ q.val))) =
      (n : ℂ) * star (P.coeff (b - a).val) := by
  classical
  rw [weighted_star_eval_sum P hdeg]
  simp_rw [root_character_orthogonality hn a b, label_iff_sub hn a b]
  rw [Finset.sum_eq_single (b - a)]
  · simp only [if_pos rfl]
    exact mul_comm _ _
  · intro j _ hj
    rw [if_neg hj, mul_zero]
  · intro h
    exact False.elim (h (Finset.mem_univ _))


end P14FourierPolynomialExtraction
end

section

/-! Fourier extraction for an arbitrary primitive complex root, with an
unconjugated polynomial value. The surviving index is a-b. -/

namespace P14PrimitiveFourierExtraction
open scoped BigOperators

theorem character {q : ℕ} (hq : 0 < q) (z : ℂ) (hz : IsPrimitiveRoot z q)
    (a b j : Fin q) :
    (∑ k : Fin q, (star (z ^ (a.val * k.val)) * z ^ (b.val * k.val)) *
      (z ^ k.val) ^ j.val) = if j = a - b then (q : ℂ) else 0 := by
  classical
  letI : NeZero q := ⟨Nat.ne_of_gt hq⟩
  let w : ℂ := star (z ^ a.val) * z ^ (b.val + j.val)
  have hp (m : ℕ) : (z ^ m) ^ q = 1 := by
    rw [← pow_mul, Nat.mul_comm, pow_mul, hz.pow_eq_one, one_pow]
  have hw : w ^ q = 1 := by
    simp only [w, mul_pow, ← star_pow, hp, star_one, one_mul]
  have hu : star z * z = 1 := by
    change (starRingEnd ℂ) z * z = 1
    simpa only [hz.norm'_eq_one (Nat.ne_of_gt hq), one_pow, Complex.ofReal_one]
      using Complex.conj_mul' z
  have hs (m : ℕ) : star (z ^ m) * z ^ m = 1 := by
    rw [star_pow, ← mul_pow, hu, one_pow]
  have he : w = 1 ↔ z ^ (b.val + j.val) = z ^ a.val := by
    constructor
    · intro h
      apply mul_left_cancel₀ (star_ne_zero.mpr (pow_ne_zero _ (hz.ne_zero (Nat.ne_of_gt hq))))
      exact h.trans (hs a.val).symm
    · intro h
      simp only [w, h, hs]
  have hl : w = 1 ↔ j = a - b := by
    rw [he, ← P14FourierPolynomialExtraction.label_iff_sub hq b a j]
    constructor
    · intro h
      apply hz.pow_inj a.isLt (Nat.mod_lt _ hq)
      exact h.symm.trans (pow_eq_pow_mod (b.val + j.val) hz.pow_eq_one)
    · intro h
      rw [h, ← pow_eq_pow_mod (b.val + j.val) hz.pow_eq_one]
  have ht (k : Fin q) :
      (star (z ^ (a.val * k.val)) * z ^ (b.val * k.val)) * (z ^ k.val) ^ j.val =
        w ^ k.val := by
    rw [show (z ^ k.val) ^ j.val = (z ^ j.val) ^ k.val by
      rw [← pow_mul, Nat.mul_comm, pow_mul]]
    simp only [w, pow_add, pow_mul, star_pow, mul_pow]
    ring
  calc
    _ = ∑ k : Fin q, w ^ k.val := Finset.sum_congr rfl (fun k _ => ht k)
    _ = if w = 1 then (q : ℂ) else 0 := P14FourierRootOrthogonality.sum_pow_eq_ite w hw
    _ = if j = a - b then (q : ℂ) else 0 := by simp only [hl]

theorem extract {q : ℕ} (hq : 0 < q) (z : ℂ) (hz : IsPrimitiveRoot z q)
    (P : Polynomial ℂ) (hP : P.natDegree < q) (a b : Fin q) :
    (∑ k : Fin q, (star (z ^ (a.val * k.val)) * z ^ (b.val * k.val)) *
      P.eval (z ^ k.val)) = (q : ℂ) * P.coeff (a - b).val := by
  classical
  simp_rw [P14FourierPolynomialExpansion.eval_eq_sum_fin P hP, Finset.mul_sum]
  rw [Finset.sum_comm]
  calc
    _ = ∑ j : Fin q, P.coeff j.val *
        ∑ k : Fin q, (star (z ^ (a.val * k.val)) * z ^ (b.val * k.val)) *
          (z ^ k.val) ^ j.val := by
      apply Finset.sum_congr rfl
      intro j _
      rw [Finset.mul_sum]
      apply Finset.sum_congr rfl
      intro k _
      ring
    _ = (q : ℂ) * P.coeff (a - b).val := by
      simp_rw [character hq z hz a b]
      rw [Finset.sum_eq_single (a - b)]
      · simp [mul_comm]
      · intro j _ hj
        rw [if_neg hj, mul_zero]
      · intro h
        exact False.elim (h (Finset.mem_univ _))

end P14PrimitiveFourierExtraction
end

section

/-! Exact three-shift cross support of the physical Fourier frame. -/

noncomputable section
open Matrix
open scoped BigOperators
namespace P14QuadraticFrameCrossSupport
open P14QuadraticPhysicalFrame P14QuadraticGridBranch
open P14QuadraticSpectralCorrection P14QuadraticSpectralFactor
open P14BalancedSpectralMatrix P14FourierSpectralWeights
open P14FourierPhysicalPairings P14UnitaryDefectGram

theorem weighted_character_zero {q : ℕ} (hq : 0 < q) (a b r : Fin q)
    (hr : r ≠ a - b) :
    (∑ k : Fin q, star (fourierMatrix q k a) *
      (fourierRoot q ^ k.val) ^ r.val * fourierMatrix q k b) = 0 := by
  have h := P14PrimitiveFourierExtraction.character hq (fourierRoot q)
    (fourierRoot_isPrimitiveRoot q hq) a b r
  rw [if_neg hr] at h
  calc
    _ = scale q * ∑ k : Fin q,
        (star (fourierRoot q ^ (a.val * k.val)) * fourierRoot q ^ (b.val * k.val)) *
          (fourierRoot q ^ k.val) ^ r.val := by
      rw [Finset.mul_sum]
      apply Finset.sum_congr rfl
      intro k _
      simp only [fourierMatrix, star_mul, scale, Nat.mul_comm k.val a.val,
        Nat.mul_comm k.val b.val]
      ring
    _ = 0 := by rw [h, mul_zero]

theorem cross_zero {q : ℕ} (hq : 3 ≤ q) (e : ℝ) (b : Coeff) (i j : Fin q)
    (hij : 3 ≤ (i - j).val) :
    pair (P14QuadraticPhysicalFrame.matrix q e b) (Sum.inl i) (Sum.inr j) = 0 := by
  have hh (m : Fin 3) :
      (∑ k : Fin q, star (fourierMatrix q k i) *
        (fourierRoot q ^ k.val) ^ m.val * fourierMatrix q k j) = 0 := by
    apply weighted_character_zero (by omega) i j (⟨m.val, by omega⟩ : Fin q)
    intro he
    have hv := congrArg Fin.val he
    change m.val = (i - j).val at hv
    have hm := m.isLt
    omega
  change pair (P14UnitaryDefectFrame.frame (fourierMatrix q)
    (fun k => spectral q e b k.val) (tail q) (delta q e)) (Sum.inl i) (Sum.inr j) = 0
  rw [cross_gram]
  have ht (k : Fin q) : star (fourierMatrix q k i) * spectral q e b k.val * fourierMatrix q k j =
      ((1 + e * b.1 : ℝ) : ℂ) *
        (star (fourierMatrix q k i) * (fourierRoot q ^ k.val) ^ (0 : Fin 3).val * fourierMatrix q k j) +
      ((e : ℂ) * b.2.1) *
        (star (fourierMatrix q k i) * (fourierRoot q ^ k.val) ^ (1 : Fin 3).val * fourierMatrix q k j) +
      ((e : ℂ) * b.2.2) *
        (star (fourierMatrix q k i) * (fourierRoot q ^ k.val) ^ (2 : Fin 3).val * fourierMatrix q k j) := by
    simp only [spectral, value, Fin.val_zero, Fin.val_one, show (2 : Fin 3).val = 2 from rfl, pow_zero, pow_one]
    ring
  simp_rw [ht, Finset.sum_add_distrib, ← Finset.mul_sum, hh]
  ring

end P14QuadraticFrameCrossSupport
end
end

section

/-! A polynomial of degree at most m-1 has cross-layer Fourier support
only on the first m shifts. The claim is exact, not asymptotic. -/

noncomputable section
open Matrix
open scoped BigOperators
namespace P14GeneralFrameCrossSupport
open Polynomial P14GeneralPhysicalFrame P14BalancedSpectralMatrix
open P14FourierSpectralWeights P14UnitaryDefectGram
open P14QuadraticFrameCrossSupport (weighted_character_zero)

theorem polynomial_cross_zero {q n : ℕ} (hq : n < q) (Q : ℂ[X])
    (hQ : Q.natDegree ≤ n) (i j : Fin q) (hij : n < (i-j).val) :
    (∑ k : Fin q, star (fourierMatrix q k i) *
      Q.eval (fourierRoot q^k.val) * fourierMatrix q k j)=0 := by
  have hval (z : ℂ) : Q.eval z=∑ r : Fin (n+1), Q.coeff r.val*z^r.val := by
    calc
      _ = (P14PolynomialCoefficientSpace.poly (fun r : Fin (n+1) => Q.coeff r.val)).eval z :=
        congrArg (fun R : ℂ[X] => R.eval z) (P14PolynomialCoefficientSpace.reconstruct Q hQ).symm
      _ = _ := P14PolynomialCoefficientSpace.eval_eq _ z
  simp_rw [hval,Finset.mul_sum,Finset.sum_mul]
  rw [Finset.sum_comm]
  apply Finset.sum_eq_zero
  intro r _
  have hh : (∑ k : Fin q, star (fourierMatrix q k i) *
      (fourierRoot q^k.val)^r.val * fourierMatrix q k j)=0 := by
    apply weighted_character_zero (by omega) i j (⟨r.val,by have := r.isLt; omega⟩ : Fin q)
    intro he
    have hv := congrArg Fin.val he
    change r.val=(i-j).val at hv
    have := r.isLt
    omega
  calc
    _ = Q.coeff r.val * (∑ k : Fin q, star (fourierMatrix q k i) *
        (fourierRoot q^k.val)^r.val * fourierMatrix q k j) := by
      rw [Finset.mul_sum]
      apply Finset.sum_congr rfl
      intro k _
      ring
    _ = 0 := by rw [hh,mul_zero]

theorem cross_zero {q m : ℕ} (hm : 0 < m) (hq : m ≤ q) (e : ℝ) (P : ℂ[X])
    (hP : P.natDegree ≤ m-1) (i j : Fin q) (hij : m ≤ (i-j).val) :
    pair (matrix q m e P) (Sum.inl i) (Sum.inr j)=0 := by
  change pair (P14UnitaryDefectFrame.frame (fourierMatrix q)
    (spectral q e P) (tail q m) (delta q m e P)) (Sum.inl i) (Sum.inr j)=0
  rw [cross_gram]
  have h := polynomial_cross_zero (by omega : m-1 < q) (1+C (e:ℂ)*P)
    (P14GeneralSpectralFactor.factor_degree P hP e) i j (by omega)
  simpa only [spectral,eval_add,eval_one,eval_mul,eval_C] using h

end P14GeneralFrameCrossSupport
end
end

section

/-!
Reusable final gluing for the problem-14 UPB constructions.

The finite budget argument is adapted from the existing green submission
`Submissions/UPBFromDegreeBudget/Budget.lean` (s3), and span induction from
`Submissions/UPBIffNoDeficientCover/DeficientCover.lean` (s52).
This file supplies a Euclidean spanning-to-budget interface and the s56 specialization.
It does not assert the missing graph decomposition or local vector existence.
-/

noncomputable section
open scoped BigOperators

namespace P14UPBAssembly

abbrev Space (k : ℕ) := EuclideanSpace ℂ (Fin k)

/-- Every subfamily with exactly `s` members spans the ambient space. -/
def SpansEvery {V : Type*} [Fintype V] [DecidableEq V] {k : ℕ}
    (v : V → Space k) (s : ℕ) : Prop :=
  ∀ S : Finset V, S.card = s →
    Submodule.span ℂ (Set.range fun i : (S : Set V) => v i.1) = ⊤

/-- The span-induction argument already used by the green deficient-cover theorem. -/
lemma span_inner_right_eq_zero {k : ℕ} {s : Set (Space k)} {a x : Space k}
    (hgen : ∀ y ∈ s, inner ℂ y a = 0)
    (hx : x ∈ Submodule.span ℂ s) : inner ℂ x a = 0 := by
  induction hx using Submodule.span_induction with
  | mem y hy => exact hgen y hy
  | zero => simp
  | add x y _ _ hx hy => simp [inner_add_left, hx, hy]
  | smul c x _ hx => simp [inner_smul_left, hx]

/-- A nonzero vector kills at most `c` members of a `(c+1)`-spanning family. -/
theorem killing_bound {V : Type*} [Fintype V] [DecidableEq V] {k c : ℕ}
    (v : V → Space k) (hspan : SpansEvery v (c + 1))
    (a : Space k) (ha : a ≠ 0) (S : Finset V)
    (hkill : ∀ i ∈ S, inner ℂ (v i) a = 0) : S.card ≤ c := by
  by_contra hbad
  obtain ⟨T, hTS, hT⟩ := Finset.exists_subset_card_eq (show c + 1 ≤ S.card by omega)
  have haSpan : a ∈ Submodule.span ℂ
      (Set.range fun i : (T : Set V) => v i.1) := by
    rw [hspan T hT]
    exact Submodule.mem_top
  have hself : inner ℂ a a = 0 := span_inner_right_eq_zero (by
    rintro _ ⟨i, rfl⟩
    exact hkill i.1 (hTS i.2)) haSpan
  exact ha (inner_self_eq_zero.mp hself)

/-- Dimension-sized independent subfamilies give the required spanning interface. -/
theorem spansEvery_of_independent {V : Type*} [Fintype V] [DecidableEq V] {k : ℕ}
    (v : V → Space k)
    (h : ∀ S : Finset V, S.card = k →
      LinearIndependent ℂ (fun i : (S : Set V) => v i.1)) : SpansEvery v k := by
  intro S hS
  apply (h S hS).span_eq_top_of_card_eq_finrank'
  simpa [finrank_euclideanSpace_fin] using hS

/-- Existing s3 finite budget argument, generalized to arbitrary finite index types. -/
theorem finite_budget {V J : Type*} [Fintype V] [DecidableEq V] [Fintype J]
    (d c : J → ℕ) (v : V → (j : J) → Space (d j))
    (hbudget : (∑ j, c j) < Fintype.card V)
    (hkill : ∀ j (a : Space (d j)), a ≠ 0 →
      ∀ S : Finset V, (∀ i ∈ S, inner ℂ (v i j) a = 0) → S.card ≤ c j) :
    ∀ a : (j : J) → Space (d j), (∀ j, a j ≠ 0) →
      ∃ i, ∀ j, inner ℂ (v i j) (a j) ≠ 0 := by
  classical
  intro a ha
  by_contra hsurvivor
  push Not at hsurvivor
  choose f hf using hsurvivor
  let S : J → Finset V := fun j => Finset.univ.filter (fun i => f i = j)
  have hScap : ∀ j, (S j).card ≤ c j := by
    intro j
    apply hkill j (a j) (ha j)
    intro i hi
    have hfi : f i = j := (Finset.mem_filter.mp hi).2
    rw [← hfi]
    exact hf i
  have hcard : Fintype.card V = ∑ j, (S j).card := by
    have h := Finset.card_eq_sum_card_fiberwise (f := f)
      (s := (Finset.univ : Finset V)) (t := (Finset.univ : Finset J))
      (fun _ _ => Finset.mem_univ _)
    simpa [S] using h
  have hle : Fintype.card V ≤ ∑ j, c j := by
    calc
      Fintype.card V = ∑ j, (S j).card := hcard
      _ ≤ ∑ j, c j := Finset.sum_le_sum (fun j _ => hScap j)
  exact (Nat.not_lt_of_ge hle) hbudget

theorem survivor_of_spanning {V J : Type*} [Fintype V] [DecidableEq V] [Fintype J]
    (d c : J → ℕ) (v : V → (j : J) → Space (d j))
    (hbudget : (∑ j, c j) < Fintype.card V)
    (hspan : ∀ j, SpansEvery (fun i => v i j) (c j + 1)) :
    ∀ a : (j : J) → Space (d j), (∀ j, a j ≠ 0) →
      ∃ i, ∀ j, inner ℂ (v i j) (a j) ≠ 0 :=
  finite_budget d c v hbudget (fun j a ha S hS =>
    killing_bound (fun i => v i j) (hspan j) a ha S hS)

/-- Convenient input form for matrix and Vandermonde constructions. -/
theorem spansEvery_of_exact_independent {V : Type*} [Fintype V] [DecidableEq V]
    {k : ℕ} (v : V → Space k)
    (h : ∀ f : Fin k → V, Function.Injective f →
      LinearIndependent ℂ (fun q => v (f q))) : SpansEvery v k := by
  apply spansEvery_of_independent
  intro S hS
  let e : (S : Set V) ≃ Fin k := Fintype.equivFinOfCardEq (by simpa using hS)
  let f : Fin k → V := fun q => (e.symm q).val
  have hf : Function.Injective f := Subtype.val_injective.comp e.symm.injective
  have hli := (h f hf).comp e e.injective
  simpa [f, Function.comp_def] using hli

theorem exact_independent_of_spansEvery {V : Type*} [Fintype V] [DecidableEq V]
    {k : ℕ} (v : V → Space k) (h : SpansEvery v k)
    (f : Fin k → V) (hf : Function.Injective f) :
    LinearIndependent ℂ (fun q => v (f q)) := by
  classical
  let S : Finset V := Finset.univ.image f
  have hS : S.card = k := by simp [S, Finset.card_image_of_injective _ hf]
  have hs := h S hS
  have heq : Set.range (fun i : (S : Set V) => v i.1) = Set.range (fun q => v (f q)) := by
    ext x
    constructor
    · rintro ⟨i, rfl⟩
      obtain ⟨q, _, hq⟩ := Finset.mem_image.mp i.2
      exact ⟨q, congrArg v hq⟩
    · rintro ⟨q, rfl⟩
      exact ⟨⟨f q, Finset.mem_image.mpr ⟨q, Finset.mem_univ q, rfl⟩⟩, rfl⟩
  rw [heq] at hs
  apply linearIndependent_of_top_le_span_of_card_le_finrank hs.ge
  simp

theorem spansEvery_pullback {V W : Type*} [Fintype V] [DecidableEq V]
    [Fintype W] [DecidableEq W] {k : ℕ} (v : V → Space k)
    (h : SpansEvery v k) (f : W → V) (hf : Function.Injective f) :
    SpansEvery (fun w => v (f w)) k := by
  apply spansEvery_of_exact_independent
  intro g hg
  exact exact_independent_of_spansEvery v h (f ∘ g) (hf.comp hg)

/-- The survivor clause of s56: budget `t + 3 + k < t + k + 4`. -/
theorem two_four_survivor {V : Type*} [Fintype V] [DecidableEq V] {k t : ℕ}
    (z : V → Fin t → Space 2) (y : V → Space 4) (x : V → Space k)
    (hcard : Fintype.card V = t + k + 4)
    (hz : ∀ q, SpansEvery (fun i => z i q) 2)
    (hy : SpansEvery y 4) (hx : SpansEvery x (k + 1)) :
    ∀ az : Fin t → Space 2, ∀ ay : Space 4, ∀ ax : Space k,
      (∀ q, az q ≠ 0) → ay ≠ 0 → ax ≠ 0 →
      ∃ i, (∀ q, inner ℂ (z i q) (az q) ≠ 0) ∧
        inner ℂ (y i) ay ≠ 0 ∧ inner ℂ (x i) ax ≠ 0 := by
  classical
  intro az ay ax haz hay hax
  let J := (Fin t ⊕ Unit) ⊕ Unit
  let d : J → ℕ := Sum.elim (Sum.elim (fun _ => 2) (fun _ => 4)) (fun _ => k)
  let c : J → ℕ := Sum.elim (Sum.elim (fun _ => 1) (fun _ => 3)) (fun _ => k)
  let v : V → (j : J) → Space (d j) := fun i j => match j with
    | .inl (.inl q) => z i q
    | .inl (.inr _) => y i
    | .inr _ => x i
  let a : (j : J) → Space (d j) := fun j => match j with
    | .inl (.inl q) => az q
    | .inl (.inr _) => ay
    | .inr _ => ax
  have hb : (∑ j, c j) < Fintype.card V := by
    simp [c, J, Fintype.sum_sum_type, hcard]
    omega
  have hs : ∀ j, SpansEvery (fun i => v i j) (c j + 1) := by
    rintro ((q | u) | u)
    · exact hz q
    · exact hy
    · exact hx
  have ha : ∀ j, a j ≠ 0 := by
    rintro ((q | u) | u)
    · exact haz q
    · exact hay
    · exact hax
  obtain ⟨i, hi⟩ := survivor_of_spanning d c v hb hs a ha
  exact ⟨i, fun q => hi (.inl (.inl q)), hi (.inl (.inr ())), hi (.inr ())⟩

end P14UPBAssembly
end
end

section

/-! Complex-coordinate assembly through the previously checked spanning budget.
This is the direct complex analogue of RealRowsUPB.coordinates. Every local
spanning and pair-coverage premise is explicit; no row family is constructed.
-/
noncomputable section
namespace P14ComplexRowsUPB
open Submodule P14UPBAssembly
open scoped BigOperators

private lemma pair_eq_inner {k : ℕ} (x y : Space k) :
    (∑ r, star (x r) * y r) = inner ℂ x y := by
  simp only [PiLp.inner_apply, RCLike.inner_apply]
  apply Finset.sum_congr rfl
  intro r _
  exact mul_comm _ _

/-- A strict total killing budget gives the canonical survivor for actual
complex coordinate rows with the prescribed spanning thresholds. -/
theorem survivor {p m : ℕ} (d c : Fin p → ℕ)
    (x : Fin m → (j : Fin p) → Fin (d j) → ℂ)
    (hspan : ∀ j (S : Finset (Fin m)), S.card = c j + 1 →
      span ℂ (Set.range (fun i : S => x i j)) = ⊤)
    (hbudget : (∑ j, c j) < Fintype.card (Fin m)) :
    ∀ a : (j : Fin p) → Fin (d j) → ℂ, (∀ j, a j ≠ 0) →
      ∃ i, ∀ j, (∑ r, star (x i j r) * a j r) ≠ 0 := by
  classical
  let C (j : Fin p) : (Fin (d j) → ℂ) ≃ₗ[ℂ] Space (d j) :=
    (WithLp.linearEquiv 2 ℂ (Fin (d j) → ℂ)).symm
  let y : Fin m → (j : Fin p) → Space (d j) := fun i j => C j (x i j)
  have hys : ∀ j, SpansEvery (fun i => y i j) (c j + 1) := by
    intro j S hS
    have hm := congrArg (Submodule.map (C j).toLinearMap) (hspan j S hS)
    simpa [y, Submodule.map_span, ← Set.range_comp, Function.comp_def,
      Submodule.map_top, LinearMap.range_eq_top.mpr (C j).surjective] using hm
  intro a ha
  let aE : (j : Fin p) → Space (d j) := fun j => C j (a j)
  have haE : ∀ j, aE j ≠ 0 := by
    intro j hzero
    exact ha j ((C j).map_eq_zero_iff.mp hzero)
  obtain ⟨i, hi⟩ := survivor_of_spanning d c y hbudget hys aE haE
  refine ⟨i, ?_⟩
  intro j
  change (∑ r, star (y i j r) * aE j r) ≠ 0
  rw [pair_eq_inner]
  exact hi j

/-- The very same coordinate family is an orthogonal unextendible product
family when nonzero local rows and pair coverage are supplied. -/
theorem coordinates {p m : ℕ} (d c : Fin p → ℕ)
    (x : Fin m → (j : Fin p) → Fin (d j) → ℂ)
    (hnz : ∀ i j, x i j ≠ 0)
    (hspan : ∀ j (S : Finset (Fin m)), S.card = c j + 1 →
      span ℂ (Set.range (fun i : S => x i j)) = ⊤)
    (hcover : ∀ i i', i ≠ i' →
      ∃ j, (∑ r, star (x i j r) * x i' j r) = 0)
    (hbudget : (∑ j, c j) < Fintype.card (Fin m)) :
    ∃ v : Fin m → (j : Fin p) → Fin (d j) → ℂ,
      (∀ i j, v i j ≠ 0) ∧
      (∀ i i', i ≠ i' →
        ∃ j, (∑ r, star (v i j r) * v i' j r) = 0) ∧
      (∀ a : (j : Fin p) → Fin (d j) → ℂ, (∀ j, a j ≠ 0) →
        ∃ i, ∀ j, (∑ r, star (v i j r) * a j r) ≠ 0) :=
  ⟨x, hnz, hcover, survivor d c x hspan hbudget⟩

end P14ComplexRowsUPB
end
end

section

/-! Assemble separately chosen local factors on one common finite row set.
The relations, complete pair cover, actual dimensions and strict killing
budget are explicit inputs. This does not prove that such a cover exists. -/

noncomputable section
namespace P14ComplexLocalCover
open Submodule
open scoped BigOperators

def HasLocalFactor (V : Type*) (k c : ℕ) (R : V → V → Prop) : Prop :=
  ∃ v : V → Fin k → ℂ,
    (∀ i, v i ≠ 0) ∧
    (∀ S : Finset V, S.card = c + 1 →
      span ℂ (Set.range (fun i : S => v i)) = ⊤) ∧
    (∀ i j, R i j → (∑ r, star (v i r) * v j r) = 0)

/-- One row equivalence transports all three properties of the same witness. -/
theorem reindex {V W : Type*} {k c : ℕ} {R : V → V → Prop}
    (e : W ≃ V) (h : HasLocalFactor V k c R) :
    HasLocalFactor W k c (fun i j => R (e i) (e j)) := by
  classical
  obtain ⟨v, hnz, hspan, hpair⟩ := h
  refine ⟨fun i => v (e i), fun i => hnz (e i), ?_, ?_⟩
  · intro S hS
    let T := S.map e.toEmbedding
    have hT : T.card = c + 1 := by
      simpa only [T, Finset.card_map] using hS
    let selected : (S : Set W) ≃ (T : Set V) := Finset.equivMap e.toEmbedding S
    have hrange : Set.range (fun i : S => v (e i)) =
        Set.range (fun i : T => v i) := by
      ext y
      constructor
      · rintro ⟨i, rfl⟩
        exact ⟨selected i, rfl⟩
      · rintro ⟨i, rfl⟩
        obtain ⟨j, rfl⟩ := selected.surjective i
        exact ⟨j, rfl⟩
    rw [hrange]
    exact hspan T hT
  · intro i j hij
    exact hpair (e i) (e j) hij

/-- Independent choices for distinct factors produce one common coordinate
family. The survivor is for arbitrary complex local test vectors. -/
theorem assemble {V : Type*} [Fintype V] {p m : ℕ}
    (d c : Fin p → ℕ) (R : Fin p → V → V → Prop)
    (hcard : Fintype.card V = m)
    (hlocal : ∀ j, HasLocalFactor V (d j) (c j) (R j))
    (hcover : ∀ i i', i ≠ i' → ∃ j, R j i i')
    (hbudget : (∑ j, c j) < m) :
    ∃ v : Fin m → (j : Fin p) → Fin (d j) → ℂ,
      (∀ i j, v i j ≠ 0) ∧
      (∀ i i', i ≠ i' →
        ∃ j, (∑ r, star (v i j r) * v i' j r) = 0) ∧
      (∀ a : (j : Fin p) → Fin (d j) → ℂ, (∀ j, a j ≠ 0) →
        ∃ i, ∀ j, (∑ r, star (v i j r) * a j r) ≠ 0) := by
  classical
  let e : Fin m ≃ V := (Fintype.equivFinOfCardEq hcard).symm
  have local' : ∀ j, HasLocalFactor (Fin m) (d j) (c j)
      (fun i i' => R j (e i) (e i')) := fun j => reindex e (hlocal j)
  unfold HasLocalFactor at local'
  choose w hnz hspan hpair using local'
  apply P14ComplexRowsUPB.coordinates d c (fun i j => w j i)
  · intro i j
    exact hnz j i
  · exact hspan
  · intro i i' hii'
    obtain ⟨j, hj⟩ := hcover (e i) (e i') (e.injective.ne hii')
    exact ⟨j, hpair j i i' hj⟩
  · simpa only [Fintype.card_fin] using hbudget

/-- Exact canonical conclusion with its original dimension-dependent bound.
Complete cover/local-factor existence remain explicit mathematical obligations. -/
theorem canonical {V : Type*} [Fintype V] {p : ℕ}
    (d c : Fin p → ℕ) (R : Fin p → V → V → Prop)
    (hlocal : ∀ j, HasLocalFactor V (d j) (c j) (R j))
    (hcover : ∀ i i', i ≠ i' → ∃ j, R j i i')
    (hbudget : (∑ j, c j) < Fintype.card V)
    (hbound : Fintype.card V ≤ 2 + ∑ j, (d j - 1)) :
    ∃ m : ℕ, m ≤ 2 + ∑ j, (d j - 1) ∧
      ∃ v : Fin m → (j : Fin p) → Fin (d j) → ℂ,
        (∀ i j, v i j ≠ 0) ∧
        (∀ i i', i ≠ i' →
          ∃ j, (∑ r, star (v i j r) * v i' j r) = 0) ∧
        (∀ a : (j : Fin p) → Fin (d j) → ℂ, (∀ j, a j ≠ 0) →
          ∃ i, ∀ j, (∑ r, star (v i j r) * a j r) ≠ 0) :=
  ⟨Fintype.card V, hbound, assemble d c R rfl hlocal hcover hbudget⟩

end P14ComplexLocalCover

end
end

section

/-! The general Fourier frame realizes the literal local-factor interface
in dimension 2q-m-1 with exactly m uncovered cross shifts. -/

noncomputable section
open Submodule
open scoped BigOperators
namespace P14GeneralFrameLocalFactor
open P14GeneralPhysicalFrame P14GeneralFrameSpanning P14UnitaryDefectGram
open P14GeneralFrameCrossSupport P14ComplexLocalCover

def tailEquiv {q m : ℕ} (hq : m+1 ≤ q) : tail q m ≃ Fin (q-(m+1)) where
  toFun k := ⟨k.val.val-(m+1), by
    have hk := k.val.isLt
    have hl : m < k.val.val := (Finset.mem_filter.mp k.property).2
    omega⟩
  invFun k := ⟨⟨k.val+(m+1),by have hk := k.isLt; omega⟩,by
    simp only [tail,Finset.mem_filter,Finset.mem_univ,true_and]
    omega⟩
  left_inv k := by
    apply Subtype.ext
    apply Fin.ext
    have hl : m < k.val.val := (Finset.mem_filter.mp k.property).2
    dsimp
    omega
  right_inv k := by
    apply Fin.ext
    dsimp
    omega

def coordinateEquiv {q m : ℕ} (hq : m+1 ≤ q) :
    (Fin q ⊕ tail q m) ≃ Fin (2*q-m-1) :=
  ((Equiv.sumCongr (Equiv.refl (Fin q)) (tailEquiv hq)).trans finSumFinEquiv).trans
    (finCongr (by omega))

def Prescribed (m : ℕ) {q : ℕ} : (Fin q ⊕ Fin q) → (Fin q ⊕ Fin q) → Prop
  | Sum.inl i, Sum.inl j => i ≠ j
  | Sum.inr i, Sum.inr j => i ≠ j
  | Sum.inl i, Sum.inr j => m ≤ (i-j).val
  | Sum.inr i, Sum.inl j => m ≤ (j-i).val

theorem pair_reverse {δ α : Type*} [Fintype δ] (A : Matrix δ α ℂ) (x y : α) :
    pair A y x=star (pair A x y) := by
  simp [pair,star_sum,star_mul,mul_comm]

theorem exists_factor {q m : ℕ} (hm : 3 ≤ m) (hq : m+1 < q) (hodd : Odd q) :
    HasLocalFactor (Fin q ⊕ Fin q) (2*q-m-1) (2*q-m-1) (Prescribed m) := by
  obtain ⟨e,P,_,hP,hr,hd,hs⟩ := exists_spanning_frame hm hq hodd
  let E := coordinateEquiv (show m+1 ≤ q by omega)
  let C : ((Fin q ⊕ tail q m) → ℂ) ≃ₗ[ℂ] (Fin (2*q-m-1) → ℂ) :=
    LinearEquiv.piCongrLeft' ℂ (fun _ : Fin q ⊕ tail q m => ℂ) E
  let A := matrix q m e P
  refine ⟨fun i => C (fun k => A k i),?_,?_,?_⟩
  · intro i hi
    exact columns_nonzero (by omega) hr hd i (C.map_eq_zero_iff.mp hi)
  · intro S hS
    have hc : S.card=2*q-m := by omega
    have hh := congrArg (Submodule.map C.toLinearMap) (hs S hc)
    simpa [Submodule.map_span,←Set.range_comp,Function.comp_def,
      Submodule.map_top,LinearMap.range_eq_top.mpr C.surjective,A] using hh
  · intro i j hij
    have hp : pair A i j=0 := by
      cases i with
      | inl i =>
        cases j with
        | inl j => exact (base_orthonormal (by omega) e P i j).trans (if_neg hij)
        | inr j => exact cross_zero (by omega) (by omega) e P hP i j hij
      | inr i =>
        cases j with
        | inl j =>
          rw [pair_reverse]
          change star (pair (matrix q m e P) (Sum.inl j) (Sum.inr i))=0
          rw [cross_zero (by omega) (by omega) e P hP j i hij,star_zero]
        | inr j => exact (spectral_orthonormal (by omega) hr hd i j).trans (if_neg hij)
    change (∑ k,star (A (E.symm k) i)*A (E.symm k) j)=0
    exact (E.symm.sum_comp (fun k => star (A k i)*A k j)).trans hp

end P14GeneralFrameLocalFactor
end
end

section

/-!
The finite spectral product satisfies an exact polynomial shift identity.
Comparing consecutive coefficients gives a recurrence without division or
any assumption that a coefficient is nonzero.
-/

namespace P14FourierSpectralShift

open Polynomial P14FourierSpectralPolynomial
open scoped BigOperators

theorem finite_product_shift {R : Type*} [CommRing R] (q : R) (d : ℕ) :
    (1 - X) *
        (∏ t : Fin d, (1 - C (q ^ t.val) * X : Polynomial R)).comp (C q * X) =
      (1 - C (q ^ d) * X) *
        ∏ t : Fin d, (1 - C (q ^ t.val) * X : Polynomial R) := by
  let f : ℕ → Polynomial R := fun j => 1 - C (q ^ j) * X
  have hcomp :
      (∏ t : Fin d, f t.val).comp (C q * X) = ∏ t : Fin d, f (t.val + 1) := by
    rw [prod_comp]
    apply Finset.prod_congr rfl
    intro t _
    dsimp only [f]
    rw [sub_comp, one_comp, C_mul_comp, X_comp, pow_succ, C_mul, mul_assoc]
  change (1 - X) * (∏ t : Fin d, f t.val).comp (C q * X) =
    f d * ∏ t : Fin d, f t.val
  rw [hcomp]
  have hfirst := Fin.prod_univ_succ (fun t : Fin (d + 1) => f t.val)
  have hlast := Fin.prod_univ_castSucc (fun t : Fin (d + 1) => f t.val)
  have hshift := hfirst.symm.trans hlast
  change f 0 * (∏ t : Fin d, f (t.val + 1)) =
    (∏ t : Fin d, f t.val) * f d at hshift
  simpa only [f, pow_zero, C_1, one_mul, mul_comm] using hshift

theorem spectralPolynomial_shift (ζ : ℂ) (d : ℕ) :
    (1 - X) * (spectralPolynomial ζ d).comp (C (ζ⁻¹) * X) =
      (1 - C ((ζ⁻¹) ^ d) * X) * spectralPolynomial ζ d := by
  simpa only [spectralPolynomial, ← inv_pow] using finite_product_shift (ζ⁻¹) d

theorem spectralPolynomial_coeff_recurrence (ζ : ℂ) (d j : ℕ) :
    (1 - (ζ⁻¹) ^ (j + 1)) * (spectralPolynomial ζ d).coeff (j + 1) =
      ((ζ⁻¹) ^ d - (ζ⁻¹) ^ j) * (spectralPolynomial ζ d).coeff j := by
  have h := congrArg (fun p : Polynomial ℂ => p.coeff (j + 1))
    (spectralPolynomial_shift ζ d)
  simp only [sub_mul, one_mul, coeff_sub, mul_assoc, coeff_C_mul,
    coeff_X_mul, comp_C_mul_X_coeff] at h
  simp only [sub_mul, one_mul]
  apply sub_eq_sub_iff_add_eq_add.mpr
  simpa only [mul_comm, add_comm] using (sub_eq_sub_iff_add_eq_add.mp h).symm


end P14FourierSpectralShift
end

section

/-!
The actual spectral polynomial has every coefficient from zero through d
nonzero when its base has primitive order greater than d. The proof uses
the shift recurrence, without dividing by its left coefficient.
-/

namespace P14FourierSpectralCoefficients

open P14FourierSpectralPolynomial P14FourierSpectralShift
open P14FourierSpectralWeights

theorem spectralPolynomial_coeff_ne_zero {ζ : ℂ} {n d : ℕ}
    (hζ : IsPrimitiveRoot ζ n) (hd : d < n) (j : ℕ) (hj : j ≤ d) :
    (spectralPolynomial ζ d).coeff j ≠ 0 := by
  induction j with
  | zero =>
      rw [spectralPolynomial_coeff_zero]
      exact one_ne_zero
  | succ j ih =>
      have hprev := ih (Nat.le_of_succ_le hj)
      have hjd : j < d := Nat.lt_of_succ_le hj
      have hfactor : (ζ⁻¹) ^ d - (ζ⁻¹) ^ j ≠ 0 := by
        apply sub_ne_zero.mpr
        intro heq
        have he := hζ.inv.pow_inj hd (hjd.trans hd) heq
        exact (Nat.ne_of_gt hjd) he
      have hrec := spectralPolynomial_coeff_recurrence ζ d j
      intro hzero
      rw [hzero, mul_zero] at hrec
      exact (mul_ne_zero hfactor hprev) hrec.symm

theorem spectralPolynomial_coeff_ne_zero_iff {ζ : ℂ} {n d : ℕ}
    (hζ : IsPrimitiveRoot ζ n) (hd : d < n) (j : ℕ) :
    (spectralPolynomial ζ d).coeff j ≠ 0 ↔ j ≤ d := by
  constructor
  · intro h
    by_contra hj
    exact h (Polynomial.coeff_eq_zero_of_natDegree_lt
      ((natDegree_spectralPolynomial_le ζ d).trans_lt (Nat.lt_of_not_ge hj)))
  · exact spectralPolynomial_coeff_ne_zero hζ hd j

theorem fourier_spectral_coeff_ne_zero_iff {n d : ℕ}
    (hn : 0 < n) (hd : d < n) (j : ℕ) :
    (spectralPolynomial (fourierRoot n) d).coeff j ≠ 0 ↔ j ≤ d :=
  spectralPolynomial_coeff_ne_zero_iff (fourierRoot_isPrimitiveRoot n hn) hd j


end P14FourierSpectralCoefficients
end

section

/-!
A cyclic window of real variable roots admits a complex polynomial specialization.
The target variable of Polynomial ℂ is the formal scale L. The outer polynomial
variable of windowPolynomial records row coordinates by coefficient extraction.
Cyclic subtraction is subtraction in Fin n, including windows crossing zero.
-/

noncomputable section

namespace P14CyclicWindowSpecialization

open Polynomial P14FourierSpectralPolynomial P14FourierSpectralCoefficients
open scoped BigOperators

section ReciprocalProduct

variable {R ι : Type*} [CommRing R] [DecidableEq ι]

private theorem natDegree_one_sub_C_mul_X_le (a : R) :
    (1 - C a * X : Polynomial R).natDegree ≤ 1 := by
  apply (Polynomial.natDegree_sub_le _ _).trans
  apply max_le
  · simp only [Polynomial.natDegree_one, Nat.zero_le]
  · simpa only [pow_one] using Polynomial.natDegree_C_mul_X_pow_le a 1

theorem reflect_prod_one_sub_C_mul_X (s : Finset ι) (w : ι → R) :
    (∏ i ∈ s, (1 - C (w i) * X : Polynomial R)).reflect s.card =
      ∏ i ∈ s, (X - C (w i) : Polynomial R) := by
  induction s using Finset.induction_on with
  | empty => simp
  | @insert a s ha ih =>
      have hdegree :
          (∏ i ∈ s, (1 - C (w i) * X : Polynomial R)).natDegree ≤ s.card := by
        calc
          _ ≤ ∑ i ∈ s, (1 - C (w i) * X : Polynomial R).natDegree :=
            Polynomial.natDegree_prod_le s _
          _ ≤ ∑ _i ∈ s, (1 : ℕ) :=
            Finset.sum_le_sum (fun i _ => natDegree_one_sub_C_mul_X_le (w i))
          _ = s.card := by simp
      rw [Finset.card_insert_of_notMem ha, Finset.prod_insert ha,
        Finset.prod_insert ha, Nat.add_comm s.card 1,
        Polynomial.reflect_mul _ _ (natDegree_one_sub_C_mul_X_le (w a)) hdegree, ih]
      simp only [Polynomial.reflect_sub, Polynomial.reflect_one, pow_one,
        Polynomial.reflect_C_mul, Polynomial.reflect_one_X, mul_one]

theorem coeff_prod_X_sub_C_mul (s : Finset ι) (w : ι → R) (a : R)
    (j : ℕ) (hj : j ≤ s.card) :
    (∏ i ∈ s, (X - C (a * w i) : Polynomial R)).coeff j =
      (∏ i ∈ s, (1 - C (w i) * X : Polynomial R)).coeff (s.card - j) *
        a ^ (s.card - j) := by
  have hcomp :
      (∏ i ∈ s, (1 - C (w i) * X : Polynomial R)).comp (C a * X) =
        ∏ i ∈ s, (1 - C (a * w i) * X : Polynomial R) := by
    rw [Polynomial.prod_comp]
    apply Finset.prod_congr rfl
    intro i _
    simp only [Polynomial.sub_comp, Polynomial.one_comp, Polynomial.C_mul_comp,
      Polynomial.X_comp, Polynomial.C_mul]
    ring
  rw [← reflect_prod_one_sub_C_mul_X s (fun i => a * w i),
    Polynomial.coeff_reflect, Polynomial.revAt_le hj, ← hcomp,
    Polynomial.comp_C_mul_X_coeff]

end ReciprocalProduct

/-- The monic polynomial whose roots are the e cyclic labels ending at b. -/
def windowPolynomial {n : ℕ} (e : ℕ) (he : e ≤ n) (b : Fin n) :
    Polynomial (MvPolynomial (Fin n) ℝ) :=
  ∏ t : Fin e, (X - C (MvPolynomial.X (b - t.castLE he)))

/-- Substitute T_a = L ζ^a into a real multivariate polynomial. -/
def geometricSpecialization {n : ℕ} (ζ : ℂ) :
    MvPolynomial (Fin n) ℝ →+* Polynomial ℂ :=
  MvPolynomial.eval₂Hom (Polynomial.C.comp Complex.ofRealHom)
    (fun a => C (ζ ^ a.val) * X)

@[simp] theorem geometricSpecialization_X {n : ℕ} (ζ : ℂ) (a : Fin n) :
    geometricSpecialization ζ (MvPolynomial.X a) = C (ζ ^ a.val) * X := by
  simp only [geometricSpecialization, MvPolynomial.eval₂Hom_X']

/-- Powers at cyclic differences use inverses, not truncated natural subtraction. -/
theorem pow_fin_sub {n : ℕ} {ζ : ℂ} (hζ : IsPrimitiveRoot ζ n)
    (b t : Fin n) :
    ζ ^ (b - t).val = ζ ^ b.val * (ζ ^ t.val)⁻¹ := by
  have hζ0 : ζ ≠ 0 := hζ.ne_zero (Nat.ne_of_gt b.pos)
  have hmod (q : ℕ) : ζ ^ (q % n) = ζ ^ q := by
    calc
      _ = ζ ^ (q % n + n * (q / n)) := by
        simp only [pow_add, pow_mul, hζ.pow_eq_one, one_pow, mul_one]
      _ = ζ ^ q := by rw [Nat.mod_add_div]
  have hsum : (n - t.val + b.val) + t.val = n + b.val := by omega
  have hmul : ζ ^ (b - t).val * ζ ^ t.val = ζ ^ b.val := by
    rw [Fin.val_sub, hmod, ← pow_add, hsum, pow_add, hζ.pow_eq_one, one_mul]
  calc
    _ = (ζ ^ (b - t).val * ζ ^ t.val) * (ζ ^ t.val)⁻¹ := by
      rw [mul_assoc, mul_inv_cancel₀ (pow_ne_zero _ hζ0), mul_one]
    _ = _ := by rw [hmul]

theorem map_windowPolynomial {n : ℕ} {ζ : ℂ} (hζ : IsPrimitiveRoot ζ n)
    (e : ℕ) (he : e ≤ n) (b : Fin n) :
    (windowPolynomial e he b).map (geometricSpecialization ζ) =
      ∏ t : Fin e,
        (X - C ((C (ζ ^ b.val) * X) * C ((ζ ^ t.val)⁻¹)) :
          Polynomial (Polynomial ℂ)) := by
  unfold windowPolynomial
  rw [Polynomial.map_prod]
  apply Finset.prod_congr rfl
  intro t _
  simp only [Polynomial.map_sub, Polynomial.map_X, Polynomial.map_C,
    geometricSpecialization_X, pow_fin_sub hζ, Fin.val_castLE, Polynomial.C_mul]
  ring

/-- The jth B-row coordinate becomes γ_(e-j) L^(e-j) ζ^(b(e-j)). -/
theorem specialize_window_coeff {n : ℕ} {ζ : ℂ} (hζ : IsPrimitiveRoot ζ n)
    (e : ℕ) (he : e ≤ n) (b : Fin n) (j : ℕ) (hj : j ≤ e) :
    geometricSpecialization ζ ((windowPolynomial e he b).coeff j) =
      C ((spectralPolynomial ζ e).coeff (e - j) * ζ ^ (b.val * (e - j))) *
        X ^ (e - j) := by
  have hbase :
      (∏ t : Fin e, (1 - C (C ((ζ ^ t.val)⁻¹)) * X :
          Polynomial (Polynomial ℂ))) = (spectralPolynomial ζ e).map Polynomial.C := by
    simp only [spectralPolynomial, Polynomial.map_prod, Polynomial.map_sub,
      Polynomial.map_one, Polynomial.map_mul, Polynomial.map_C, Polynomial.map_X]
  rw [← Polynomial.coeff_map, map_windowPolynomial hζ,
    coeff_prod_X_sub_C_mul Finset.univ
      (fun t : Fin e => C ((ζ ^ t.val)⁻¹)) (C (ζ ^ b.val) * X) j (by simpa using hj),
    hbase, Polynomial.coeff_map]
  simp only [Finset.card_univ, Fintype.card_fin]
  rw [mul_pow, ← Polynomial.C_pow, ← mul_assoc, ← Polynomial.C_mul, ← pow_mul]

theorem specialized_coefficient_scalar_ne_zero {n e : ℕ} {ζ : ℂ}
    (hζ : IsPrimitiveRoot ζ n) (he : e < n) (b : Fin n) (j : ℕ) :
    (spectralPolynomial ζ e).coeff (e - j) * ζ ^ (b.val * (e - j)) ≠ 0 := by
  exact mul_ne_zero
    (spectralPolynomial_coeff_ne_zero hζ he (e - j) (Nat.sub_le _ _))
    (pow_ne_zero _ (hζ.ne_zero (Nat.ne_of_gt b.pos)))


end P14CyclicWindowSpecialization
end
end

section

/-!
A polynomial determinant with opposite column weights is nonzero when
its two literal complementary blocks have nonzero determinants. Polynomial
row and column scaling reduces the claim to a matrix whose value at zero
is block diagonal. No positive block-size assumption is needed.
-/

noncomputable section
namespace P14WeightedTwoBlockDeterminant

open Matrix Polynomial
open scoped BigOperators

variable {R : Type*} [CommRing R] {r s : ℕ}

def columnIndex : Fin r ⊕ Fin s → ℕ :=
  Sum.elim (fun j => j.val) (fun j => r + j.val)

def columnScale : Fin r ⊕ Fin s → ℕ :=
  Sum.elim (fun j => r - 1 - j.val) (fun j => j.val)

def rowScale : Fin r ⊕ Fin s → ℕ :=
  Sum.elim (fun _ => r - 1) (fun _ => s - 1)

def weightedMatrix (A : Matrix (Fin r) (Fin r ⊕ Fin s) R)
    (B : Matrix (Fin s) (Fin r ⊕ Fin s) R) :
    Matrix (Fin r ⊕ Fin s) (Fin r ⊕ Fin s) R[X] :=
  fun i j => Sum.elim
    (fun a => C (A a j) * X ^ columnIndex j)
    (fun b => C (B b j) * X ^ (r + s - 1 - columnIndex j)) i

def normalizedMatrix (A : Matrix (Fin r) (Fin r ⊕ Fin s) R)
    (B : Matrix (Fin s) (Fin r ⊕ Fin s) R) :
    Matrix (Fin r ⊕ Fin s) (Fin r ⊕ Fin s) R[X] :=
  fun i j => match i, j with
    | .inl a, .inl u => C (A a (.inl u))
    | .inl a, .inr v => C (A a (.inr v)) * X ^ (2 * v.val + 1)
    | .inr b, .inl u => C (B b (.inl u)) * X ^ (2 * (r - u.val) - 1)
    | .inr b, .inr v => C (B b (.inr v))

private theorem mul_powers_scale (a : R[X]) (p q u v : ℕ)
    (h : p + q = u + v) :
    (a * X ^ p) * X ^ q = X ^ u * (a * X ^ v) := by
  rw [mul_assoc, ← pow_add, h, pow_add, mul_left_comm]

theorem weightedMatrix_scaling
    (A : Matrix (Fin r) (Fin r ⊕ Fin s) R)
    (B : Matrix (Fin s) (Fin r ⊕ Fin s) R) :
    weightedMatrix A B * Matrix.diagonal (fun j => (X : R[X]) ^ columnScale j) =
      Matrix.diagonal (fun i => (X : R[X]) ^ rowScale i) * normalizedMatrix A B := by
  apply Matrix.ext
  intro i j
  rw [Matrix.mul_diagonal, Matrix.diagonal_mul]
  rcases i with a | b <;> rcases j with u | v
  · change (C (A a (.inl u)) * X ^ u.val) * X ^ (r - 1 - u.val) =
      X ^ (r - 1) * C (A a (.inl u))
    have hu := u.isLt
    simpa only [pow_zero, mul_one] using
      mul_powers_scale (C (A a (.inl u))) u.val (r - 1 - u.val)
        (r - 1) 0 (by omega)
  · change (C (A a (.inr v)) * X ^ (r + v.val)) * X ^ v.val =
      X ^ (r - 1) * (C (A a (.inr v)) * X ^ (2 * v.val + 1))
    have ha := a.isLt
    exact mul_powers_scale _ _ _ _ _ (by omega)
  · change (C (B b (.inl u)) * X ^ (r + s - 1 - u.val)) *
      X ^ (r - 1 - u.val) =
        X ^ (s - 1) * (C (B b (.inl u)) * X ^ (2 * (r - u.val) - 1))
    have hb := b.isLt
    have hu := u.isLt
    exact mul_powers_scale _ _ _ _ _ (by omega)
  · change (C (B b (.inr v)) * X ^ (r + s - 1 - (r + v.val))) *
      X ^ v.val = X ^ (s - 1) * C (B b (.inr v))
    have hv := v.isLt
    simpa only [pow_zero, mul_one] using
      mul_powers_scale (C (B b (.inr v))) (r + s - 1 - (r + v.val))
        v.val (s - 1) 0 (by omega)

theorem eval_normalizedMatrix
    (A : Matrix (Fin r) (Fin r ⊕ Fin s) R)
    (B : Matrix (Fin s) (Fin r ⊕ Fin s) R) :
    (Polynomial.evalRingHom (0 : R)).mapMatrix (normalizedMatrix A B) =
      Matrix.fromBlocks (A.submatrix id Sum.inl) 0 0 (B.submatrix id Sum.inr) := by
  ext i j
  rcases i with a | b <;> rcases j with u | v
  · simp [normalizedMatrix, Matrix.map_apply, Matrix.submatrix]
  · simp [normalizedMatrix, Matrix.map_apply, Matrix.submatrix]
  · have hu := u.isLt
    have hpos : 2 * (r - u.val) - 1 ≠ 0 := by omega
    simp [normalizedMatrix, Matrix.map_apply, Matrix.submatrix, hpos]
  · simp [normalizedMatrix, Matrix.map_apply, Matrix.submatrix]

theorem eval_normalizedMatrix_det
    (A : Matrix (Fin r) (Fin r ⊕ Fin s) R)
    (B : Matrix (Fin s) (Fin r ⊕ Fin s) R) :
    (Polynomial.evalRingHom (0 : R)) (normalizedMatrix A B).det =
      (A.submatrix id Sum.inl).det * (B.submatrix id Sum.inr).det := by
  rw [RingHom.map_det, eval_normalizedMatrix, Matrix.det_fromBlocks_zero₁₂]

theorem weightedMatrix_det_ne_zero [IsDomain R]
    (A : Matrix (Fin r) (Fin r ⊕ Fin s) R)
    (B : Matrix (Fin s) (Fin r ⊕ Fin s) R)
    (hA : (A.submatrix id Sum.inl).det ≠ 0)
    (hB : (B.submatrix id Sum.inr).det ≠ 0) :
    (weightedMatrix A B).det ≠ 0 := by
  have hN : (normalizedMatrix A B).det ≠ 0 := by
    intro hzero
    apply mul_ne_zero hA hB
    rw [← eval_normalizedMatrix_det A B, hzero, map_zero]
  have hrow :
      (Matrix.diagonal (fun i : Fin r ⊕ Fin s =>
        (X : R[X]) ^ rowScale i)).det ≠ 0 := by
    rw [Matrix.det_diagonal]
    exact Finset.prod_ne_zero_iff.mpr
      (fun i _ => pow_ne_zero _ Polynomial.X_ne_zero)
  have hdet := congrArg Matrix.det (weightedMatrix_scaling A B)
  rw [Matrix.det_mul, Matrix.det_mul] at hdet
  intro hzero
  rw [hzero, zero_mul] at hdet
  exact (mul_ne_zero hrow hN) hdet.symm

end P14WeightedTwoBlockDeterminant

end
end

section

/-! Discharge both complementary blocks for opposite Fourier powers.
The selected labels are injective separately in each half; they may overlap
between halves. No positive block-size assumption is needed. -/

noncomputable section
namespace P14WeightedFourierDeterminant
open Matrix Polynomial
open P14WeightedTwoBlockDeterminant P14FourierConsecutiveBlock
open scoped BigOperators

variable {K : Type*} [CommRing K] [IsDomain K] {n r s : ℕ}

def topCoefficients (ζ : K) (a : Fin r → Fin n) :
    Matrix (Fin r) (Fin r ⊕ Fin s) K :=
  fun i j => ζ ^ ((a i).val * columnIndex j)

def bottomCoefficients (ζ : K) (γ : ℕ → K) (b : Fin s → Fin n) :
    Matrix (Fin s) (Fin r ⊕ Fin s) K :=
  fun i j => ζ ^ ((b i).val * (r + s - 1 - columnIndex j)) *
    γ (r + s - 1 - columnIndex j)

theorem top_block_det_ne_zero (ζ : K) (a : Fin r → Fin n)
    (hn : n ≠ 0) (hζ : IsPrimitiveRoot ζ n) (ha : Function.Injective a) :
    ((topCoefficients ζ a : Matrix (Fin r) (Fin r ⊕ Fin s) K).submatrix
      id Sum.inl).det ≠ 0 := by
  have h := consecutiveBlock_det_ne_zero ζ 1 0 a (fun _ => 1)
    hn hζ one_ne_zero ha (fun _ => one_ne_zero)
  have heq : ((topCoefficients ζ a : Matrix (Fin r) (Fin r ⊕ Fin s) K).submatrix
      id Sum.inl) = consecutiveBlock ζ 1 0 a (fun _ => 1) := by
    apply Matrix.ext
    intro i j
    simp [consecutiveBlock, topCoefficients, columnIndex, Matrix.submatrix]
  rw [heq]
  exact h

theorem bottom_block_det_ne_zero (ζ : K) (γ : ℕ → K) (b : Fin s → Fin n)
    (hn : n ≠ 0) (hζ : IsPrimitiveRoot ζ n) (hb : Function.Injective b)
    (hγ : ∀ j < s, γ j ≠ 0) :
    ((bottomCoefficients ζ γ b : Matrix (Fin s) (Fin r ⊕ Fin s) K).submatrix
      id Sum.inr).det ≠ 0 := by
  let B : Matrix (Fin s) (Fin s) K :=
    (bottomCoefficients ζ γ b : Matrix (Fin s) (Fin r ⊕ Fin s) K).submatrix
      id Sum.inr
  have heq : B.submatrix id Fin.revPerm =
      consecutiveBlock ζ 1 0 b (fun j => γ j.val) := by
    apply Matrix.ext
    intro i j
    change ζ ^ ((b i).val * (r + s - 1 - (r + j.rev.val))) *
        γ (r + s - 1 - (r + j.rev.val)) =
      1 * ζ ^ ((b i).val * (0 + j.val)) * γ j.val
    have hj := j.isLt
    have he : r + s - 1 - (r + j.rev.val) = j.val := by
      rw [Fin.val_rev]
      omega
    simp only [he, zero_add, one_mul]
  have h := consecutiveBlock_det_ne_zero ζ 1 0 b (fun j => γ j.val)
    hn hζ one_ne_zero hb (fun j => hγ j.val j.isLt)
  rw [← heq, Matrix.det_permute'] at h
  intro hz
  change B.det = 0 at hz
  exact h (by rw [hz, mul_zero])

theorem weighted_fourier_det_ne_zero (ζ : K) (γ : ℕ → K)
    (a : Fin r → Fin n) (b : Fin s → Fin n)
    (hn : n ≠ 0) (hζ : IsPrimitiveRoot ζ n)
    (ha : Function.Injective a) (hb : Function.Injective b)
    (hγ : ∀ j < s, γ j ≠ 0) :
    (weightedMatrix (topCoefficients ζ a) (bottomCoefficients ζ γ b)).det ≠ 0 := by
  apply weightedMatrix_det_ne_zero
  · exact top_block_det_ne_zero ζ a hn hζ ha
  · exact bottom_block_det_ne_zero ζ γ b hn hζ hb hγ

end P14WeightedFourierDeterminant

end
end

section

/-!
The actual real polynomial matrix of selected cyclic-window A/B rows has
nonzero determinant. Complex geometric specialization identifies it with
the checked weighted Fourier matrix. The two selections need only be
injective separately; labels may coincide between the two halves.
-/

noncomputable section

namespace P14CyclicWindowSplitDeterminant

open Matrix Polynomial
open P14CyclicWindowSpecialization P14WeightedTwoBlockDeterminant
open P14WeightedFourierDeterminant P14FourierSpectralPolynomial
open P14FourierSpectralCoefficients

variable {n e r s : ℕ}

/-- The square A/B matrix using the consecutive column order of the two blocks. -/
def splitWindowMatrix (e : ℕ) (he : e ≤ n)
    (a : Fin r → Fin n) (b : Fin s → Fin n) :
    Matrix (Fin r ⊕ Fin s) (Fin r ⊕ Fin s) (MvPolynomial (Fin n) ℝ) :=
  fun i j => Sum.elim
    (fun u => MvPolynomial.X (a u) ^ columnIndex j)
    (fun v => (windowPolynomial e he (b v)).coeff (columnIndex j)) i

private theorem columnIndex_lt (j : Fin r ⊕ Fin s) : columnIndex j < r + s := by
  cases j with
  | inl j =>
      change j.val < r + s
      have hj := j.isLt
      omega
  | inr j =>
      change r + j.val < r + s
      have hj := j.isLt
      omega

theorem specialize_splitWindowMatrix {ζ : ℂ} (hζ : IsPrimitiveRoot ζ n)
    (he : e ≤ n) (hdim : r + s = e + 1)
    (a : Fin r → Fin n) (b : Fin s → Fin n) :
    (geometricSpecialization ζ).mapMatrix (splitWindowMatrix e he a b) =
      weightedMatrix (topCoefficients ζ a)
        (bottomCoefficients ζ (spectralPolynomial ζ e).coeff b) := by
  apply Matrix.ext
  intro i j
  cases i with
  | inl u =>
      change geometricSpecialization ζ (MvPolynomial.X (a u) ^ columnIndex j) =
        C (ζ ^ ((a u).val * columnIndex j)) * X ^ columnIndex j
      rw [map_pow, geometricSpecialization_X, mul_pow, ← Polynomial.C_pow, ← pow_mul]
  | inr v =>
      change geometricSpecialization ζ ((windowPolynomial e he (b v)).coeff (columnIndex j)) =
        C (ζ ^ ((b v).val * (r + s - 1 - columnIndex j)) *
          (spectralPolynomial ζ e).coeff (r + s - 1 - columnIndex j)) *
            X ^ (r + s - 1 - columnIndex j)
      have hj : columnIndex j ≤ e := by
        have hlt := columnIndex_lt j
        omega
      have hdegree : r + s - 1 = e := by omega
      simpa only [hdegree, mul_comm] using
        specialize_window_coeff hζ e he (b v) (columnIndex j) hj

theorem splitWindow_det_ne_zero {ζ : ℂ} (hζ : IsPrimitiveRoot ζ n)
    (he : e < n) (hdim : r + s = e + 1)
    (a : Fin r → Fin n) (b : Fin s → Fin n)
    (ha : Function.Injective a) (hb : Function.Injective b) :
    (splitWindowMatrix e (Nat.le_of_lt he) a b).det ≠ 0 := by
  have hn : n ≠ 0 := Nat.ne_of_gt ((Nat.zero_le e).trans_lt he)
  have hγ : ∀ j < s, (spectralPolynomial ζ e).coeff j ≠ 0 := by
    intro j hj
    apply spectralPolynomial_coeff_ne_zero hζ he j
    omega
  have hw := weighted_fourier_det_ne_zero ζ (spectralPolynomial ζ e).coeff
    a b hn hζ ha hb hγ
  have hspec := specialize_splitWindowMatrix hζ (Nat.le_of_lt he) hdim a b
  intro hzero
  apply hw
  rw [← hspec, ← RingHom.map_det, hzero, map_zero]


end P14CyclicWindowSplitDeterminant
end
end

section

/-!
The literal cyclic-window row family has nonzero determinant on every
injective selection of e+1 labels. The proof enumerates the left and right
parts of that very selection and retains both its row and column changes
of coordinates. Empty selected halves and coinciding cross-half labels
are allowed.
-/

noncomputable section

namespace P14CyclicWindowRows

open Matrix
open P14CyclicWindowSpecialization P14CyclicWindowSplitDeterminant
open P14WeightedTwoBlockDeterminant

/-- A rows are powers of one variable; B rows are the actual window coefficients. -/
def windowRow {n : ℕ} (e : ℕ) (he : e ≤ n) :
    (Fin n ⊕ Fin n) → Fin (e + 1) → MvPolynomial (Fin n) ℝ :=
  fun p j => Sum.elim
    (fun a => MvPolynomial.X a ^ j.val)
    (fun b => (windowPolynomial e he b).coeff j.val) p

@[simp] theorem windowRow_inl {n : ℕ} (e : ℕ) (he : e ≤ n)
    (a : Fin n) (j : Fin (e + 1)) :
    windowRow e he (Sum.inl a) j = MvPolynomial.X a ^ j.val := rfl

@[simp] theorem windowRow_inr {n : ℕ} (e : ℕ) (he : e ≤ n)
    (b : Fin n) (j : Fin (e + 1)) :
    windowRow e he (Sum.inr b) j = (windowPolynomial e he b).coeff j.val := rfl

theorem windowRow_det_ne_zero {n e : ℕ} {ζ : ℂ}
    (hζ : IsPrimitiveRoot ζ n) (he : e < n)
    (f : Fin (e + 1) → Fin n ⊕ Fin n) (hf : Function.Injective f) :
    Matrix.det (fun i => windowRow e (Nat.le_of_lt he) (f i)) ≠ 0 := by
  classical
  let S : Finset (Fin n ⊕ Fin n) := Finset.univ.image f
  have hS : S.card = e + 1 := by
    dsimp only [S]
    rw [Finset.card_image_of_injective _ hf, Finset.card_univ, Fintype.card_fin]
  let r : ℕ := S.toLeft.card
  let s : ℕ := S.toRight.card
  have hdim : r + s = e + 1 :=
    (Finset.card_toLeft_add_card_toRight (u := S)).trans hS
  let a : Fin r → Fin n := S.toLeft.orderEmbOfFin rfl
  let b : Fin s → Fin n := S.toRight.orderEmbOfFin rfl
  have ha : Function.Injective a := (S.toLeft.orderEmbOfFin rfl).injective
  have hb : Function.Injective b := (S.toRight.orderEmbOfFin rfl).injective
  have hg : Function.Injective (Sum.map a b) := Sum.map_injective.mpr ⟨ha, hb⟩
  have hpre (p : Fin r ⊕ Fin s) : ∃ i : Fin (e + 1), f i = Sum.map a b p := by
    have hp : Sum.map a b p ∈ S := by
      cases p with
      | inl i => exact Finset.mem_toLeft.mp (S.toLeft.orderEmbOfFin_mem rfl i)
      | inr i => exact Finset.mem_toRight.mp (S.toRight.orderEmbOfFin_mem rfl i)
    obtain ⟨i, _, hi⟩ := Finset.mem_image.mp hp
    exact ⟨i, hi⟩
  let rowIndex : Fin r ⊕ Fin s → Fin (e + 1) := fun p => Classical.choose (hpre p)
  have hrowIndex (p : Fin r ⊕ Fin s) : f (rowIndex p) = Sum.map a b p :=
    Classical.choose_spec (hpre p)
  have hrowInjective : Function.Injective rowIndex := by
    intro p q hpq
    apply hg
    rw [← hrowIndex p, ← hrowIndex q, hpq]
  have hrowBijective : Function.Bijective rowIndex := by
    apply (Fintype.bijective_iff_injective_and_card rowIndex).mpr
    refine ⟨hrowInjective, ?_⟩
    simpa only [Fintype.card_sum, Fintype.card_fin] using hdim
  let rowEquiv : (Fin r ⊕ Fin s) ≃ Fin (e + 1) :=
    Equiv.ofBijective rowIndex hrowBijective
  have hrow (p : Fin r ⊕ Fin s) : f (rowEquiv p) = Sum.map a b p := hrowIndex p
  let colEquiv : (Fin r ⊕ Fin s) ≃ Fin (e + 1) :=
    finSumFinEquiv.trans (finCongr hdim)
  have hcol (j : Fin r ⊕ Fin s) : (colEquiv j).val = columnIndex j := by
    change ((finCongr hdim) (finSumFinEquiv j)).val = columnIndex j
    rw [finCongr_apply_coe]
    cases j <;> rfl
  let M : Matrix (Fin (e + 1)) (Fin (e + 1)) (MvPolynomial (Fin n) ℝ) :=
    fun i => windowRow e (Nat.le_of_lt he) (f i)
  have hmatrix : M.submatrix rowEquiv colEquiv =
      splitWindowMatrix e (Nat.le_of_lt he) a b := by
    apply Matrix.ext
    intro i j
    change windowRow e (Nat.le_of_lt he) (f (rowEquiv i)) (colEquiv j) =
      splitWindowMatrix e (Nat.le_of_lt he) a b i j
    rw [hrow i]
    cases i with
    | inl u =>
        change MvPolynomial.X (a u) ^ (colEquiv j).val =
          MvPolynomial.X (a u) ^ columnIndex j
        rw [hcol j]
    | inr v =>
        change (windowPolynomial e (Nat.le_of_lt he) (b v)).coeff (colEquiv j).val =
          (windowPolynomial e (Nat.le_of_lt he) (b v)).coeff (columnIndex j)
        rw [hcol j]
  have hsplit := splitWindow_det_ne_zero hζ he hdim a b ha hb
  intro hzero
  change M.det = 0 at hzero
  have hdet := Matrix.det_reindex rowEquiv.symm colEquiv.symm M
  apply hsplit
  rw [← hmatrix]
  simpa only [Matrix.reindex_apply, Equiv.symm_symm, hzero, mul_zero] using hdet


end P14CyclicWindowRows
end
end

section

/-! Literal evaluation and leading coordinate of the cyclic-window polynomial.
The finite coordinate sum is the product of its prescribed real root factors.
No generic rank or full UPB conclusion is assumed or asserted here. -/

noncomputable section
namespace P14CyclicWindowEvaluation
open Polynomial P14CyclicWindowSpecialization
open scoped BigOperators

variable {n : ℕ}

theorem window_monic (e : ℕ) (he : e ≤ n) (b : Fin n) :
    (windowPolynomial e he b).Monic := by
  unfold windowPolynomial
  exact monic_prod_of_monic _ _ (fun _ _ => monic_X_sub_C _)

theorem window_natDegree (e : ℕ) (he : e ≤ n) (b : Fin n) :
    (windowPolynomial e he b).natDegree = e := by
  unfold windowPolynomial
  rw [natDegree_prod_of_monic _ _ (fun _ _ => monic_X_sub_C _)]
  simp

theorem window_top_coeff (e : ℕ) (he : e ≤ n) (b : Fin n) :
    (windowPolynomial e he b).coeff e = 1 := by
  have h : (windowPolynomial e he b).coeff (windowPolynomial e he b).natDegree = 1 := by
    rw [coeff_natDegree]
    exact (window_monic e he b).leadingCoeff
  simpa only [window_natDegree] using h

theorem window_eval_sum (e : ℕ) (he : e ≤ n) (b : Fin n)
    (z : Fin n → ℝ) (x : ℝ) :
    (∑ j : Fin (e + 1), x ^ j.val *
      MvPolynomial.eval z ((windowPolynomial e he b).coeff j.val)) =
      ∏ t : Fin e, (x - z (b - t.castLE he)) := by
  calc
    _ = ∑ j : Fin (e + 1),
        MvPolynomial.eval z ((windowPolynomial e he b).coeff j.val) * x ^ j.val := by
      apply Finset.sum_congr rfl
      intro j _
      exact mul_comm _ _
    _ = ∑ j ∈ Finset.range (e + 1),
        MvPolynomial.eval z ((windowPolynomial e he b).coeff j) * x ^ j :=
      Fin.sum_univ_eq_sum_range
        (fun j : ℕ => MvPolynomial.eval z ((windowPolynomial e he b).coeff j) * x ^ j)
        (e + 1)
    _ = (windowPolynomial e he b).eval₂ (MvPolynomial.eval z) x := by
      symm
      apply eval₂_eq_sum_range'
      rw [window_natDegree]
      exact Nat.lt_succ_self e
    _ = _ := by
      simp [windowPolynomial, eval₂_finsetProd]

theorem window_eval_sum_zero (e : ℕ) (he : e ≤ n) (b : Fin n)
    (z : Fin n → ℝ) (t : Fin e) :
    (∑ j : Fin (e + 1), z (b - t.castLE he) ^ j.val *
      MvPolynomial.eval z ((windowPolynomial e he b).coeff j.val)) = 0 := by
  rw [window_eval_sum]
  exact Finset.prod_eq_zero (Finset.mem_univ t) (sub_self _)

end P14CyclicWindowEvaluation

end
end

section

/-! The exact polynomial determinant to complex spanning bridge in arbitrary
finite dimension. Reuses the verified real finite-product avoidance theorem.
No determinant nonvanishing premise is supplied by this transport alone. -/

noncomputable section
namespace P14PolynomialRowsSpanning
open MvPolynomial Matrix Submodule
open scoped BigOperators
variable {d : ℕ}

def complexRow {σ : Type*} (p : Fin d → MvPolynomial σ ℝ) (z : σ → ℝ) :
    Fin d → ℂ := fun j => (eval z (p j) : ℂ)

theorem complex_det_ne_zero {σ : Type*}
    (p : Matrix (Fin d) (Fin d) (MvPolynomial σ ℝ)) (z : σ → ℝ)
    (h : eval z (Matrix.det p) ≠ 0) :
    Matrix.det (fun i => complexRow (p i) z) ≠ 0 := by
  have hr : ((eval z).mapMatrix p).det ≠ 0 := by
    rwa [← (eval z).map_det]
  have hc : (Complex.ofRealHom (((eval z).mapMatrix p).det)) ≠ 0 :=
    Complex.ofReal_ne_zero.mpr hr
  rw [Complex.ofRealHom.map_det] at hc
  exact hc

theorem complex_spanning_of_det (v : Matrix (Fin d) (Fin d) ℂ)
    (hv : Matrix.det v ≠ 0) : span ℂ (Set.range v) = ⊤ := by
  change span ℂ (Set.range (Matrix.row v)) = ⊤
  rw [← range_vecMulLinear]
  apply LinearMap.range_eq_top.mpr
  exact Matrix.vecMul_surjective_iff_isUnit.mpr
    ((Matrix.isUnit_iff_isUnit_det v).mpr (isUnit_iff_ne_zero.mpr hv))

theorem exists_complex_spanning {σ ι : Type*} [Fintype ι]
    (p : ι → Fin d → MvPolynomial σ ℝ)
    (hp : ∀ f : Fin d → ι, Function.Injective f →
      Matrix.det (fun i => p (f i)) ≠ 0) :
    ∃ z : σ → ℝ, ∀ S : Finset ι, S.card = d →
      span ℂ (Set.range (fun i : (S : Set ι) => complexRow (p i) z)) = ⊤ := by
  classical
  let T := {f : Fin d → ι // Function.Injective f}
  obtain ⟨z, hz⟩ := P14PolynomialThreeRows.exists_common_nonzero
    (fun f : T => Matrix.det (fun i => p (f.val i))) (fun f => hp f.val f.property)
  refine ⟨z, ?_⟩
  intro S hS
  let e : Fin d ≃ (S : Set ι) :=
    (Fintype.equivFinOfCardEq (by simpa using hS)).symm
  let f : Fin d → ι := fun i => (e i).val
  have hf : Function.Injective f := by
    intro i j hij
    exact e.injective (Subtype.ext hij)
  have hd := complex_det_ne_zero (fun i => p (f i)) z (hz ⟨f, hf⟩)
  have hs := complex_spanning_of_det (fun i => complexRow (p (f i)) z) hd
  have hr : Set.range (fun i : Fin d => complexRow (p (f i)) z) =
      Set.range (fun i : (S : Set ι) => complexRow (p i) z) := by
    ext v
    constructor
    · rintro ⟨i, rfl⟩
      exact ⟨e i, rfl⟩
    · rintro ⟨i, rfl⟩
      obtain ⟨j, rfl⟩ := e.surjective i
      exact ⟨j, rfl⟩
  rwa [hr] at hs


end P14PolynomialRowsSpanning
end
end

section

/-! Actual complex local factors from one real specialization of cyclic windows.
Every selected e+1 rows span, and both orientations of every prescribed
cross-window incidence are orthogonal. Global UPB assembly is separate. -/

noncomputable section
namespace P14CyclicWindowComplex
open Submodule
open P14CyclicWindowRows P14CyclicWindowSpecialization
open P14CyclicWindowEvaluation P14PolynomialRowsSpanning
open scoped BigOperators

variable {n : ℕ}

def complexFamily (e : ℕ) (he : e ≤ n) (z : Fin n → ℝ)
    (i : Fin n ⊕ Fin n) : Fin (e + 1) → ℂ :=
  complexRow (windowRow e he i) z

theorem complexFamily_ne_zero (e : ℕ) (he : e ≤ n) (z : Fin n → ℝ)
    (i : Fin n ⊕ Fin n) : complexFamily e he z i ≠ 0 := by
  rcases i with a | b
  · intro h
    have hz := congrFun h 0
    simpa [complexFamily, complexRow, windowRow] using hz
  · intro h
    have hz := congrFun h (Fin.last e)
    simpa [complexFamily, complexRow, windowRow, window_top_coeff] using hz

theorem pair_inl_inr (e : ℕ) (he : e ≤ n) (z : Fin n → ℝ) (a b : Fin n) :
    (∑ j, star (complexFamily e he z (Sum.inl a) j) *
      complexFamily e he z (Sum.inr b) j) =
      ((∏ t : Fin e, (z a - z (b - t.castLE he)) : ℝ) : ℂ) := by
  calc
    _ = ((∑ j : Fin (e + 1), z a ^ j.val *
        MvPolynomial.eval z ((windowPolynomial e he b).coeff j.val) : ℝ) : ℂ) := by
      simp [complexFamily, complexRow, windowRow, Complex.star_def]
    _ = _ := congrArg Complex.ofReal (window_eval_sum e he b z (z a))

theorem pair_inr_inl (e : ℕ) (he : e ≤ n) (z : Fin n → ℝ) (a b : Fin n) :
    (∑ j, star (complexFamily e he z (Sum.inr b) j) *
      complexFamily e he z (Sum.inl a) j) =
      ((∏ t : Fin e, (z a - z (b - t.castLE he)) : ℝ) : ℂ) := by
  calc
    _ = ∑ j, star (complexFamily e he z (Sum.inl a) j) *
        complexFamily e he z (Sum.inr b) j := by
      apply Finset.sum_congr rfl
      intro j _
      simp only [complexFamily, complexRow, Complex.star_def, Complex.conj_ofReal]
      exact mul_comm _ _
    _ = _ := pair_inl_inr e he z a b

theorem pair_inl_inr_zero (e : ℕ) (he : e ≤ n) (z : Fin n → ℝ)
    (b : Fin n) (t : Fin e) :
    (∑ j, star (complexFamily e he z (Sum.inl (b - t.castLE he)) j) *
      complexFamily e he z (Sum.inr b) j) = 0 := by
  rw [pair_inl_inr]
  have h : (∏ u : Fin e, (z (b - t.castLE he) - z (b - u.castLE he))) = 0 :=
    Finset.prod_eq_zero (Finset.mem_univ t) (sub_self _)
  rw [h, Complex.ofReal_zero]

theorem pair_inr_inl_zero (e : ℕ) (he : e ≤ n) (z : Fin n → ℝ)
    (b : Fin n) (t : Fin e) :
    (∑ j, star (complexFamily e he z (Sum.inr b) j) *
      complexFamily e he z (Sum.inl (b - t.castLE he)) j) = 0 := by
  rw [pair_inr_inl]
  have h : (∏ u : Fin e, (z (b - t.castLE he) - z (b - u.castLE he))) = 0 :=
    Finset.prod_eq_zero (Finset.mem_univ t) (sub_self _)
  rw [h, Complex.ofReal_zero]

theorem exists_local_factor {e : ℕ} {ζ : ℂ}
    (hζ : IsPrimitiveRoot ζ n) (he : e < n) :
    ∃ z : Fin n → ℝ,
      (∀ i : Fin n ⊕ Fin n, complexFamily e (Nat.le_of_lt he) z i ≠ 0) ∧
      (∀ S : Finset (Fin n ⊕ Fin n), S.card = e + 1 →
        span ℂ (Set.range (fun i : (S : Set (Fin n ⊕ Fin n)) =>
          complexFamily e (Nat.le_of_lt he) z i.val)) = ⊤) ∧
      (∀ b : Fin n, ∀ t : Fin e,
        (∑ j, star (complexFamily e (Nat.le_of_lt he) z
          (Sum.inl (b - t.castLE (Nat.le_of_lt he))) j) *
          complexFamily e (Nat.le_of_lt he) z (Sum.inr b) j) = 0) ∧
      (∀ b : Fin n, ∀ t : Fin e,
        (∑ j, star (complexFamily e (Nat.le_of_lt he) z (Sum.inr b) j) *
          complexFamily e (Nat.le_of_lt he) z
            (Sum.inl (b - t.castLE (Nat.le_of_lt he))) j) = 0) := by
  obtain ⟨z, hz⟩ := exists_complex_spanning (windowRow e (Nat.le_of_lt he))
    (windowRow_det_ne_zero hζ he)
  exact ⟨z, complexFamily_ne_zero e (Nat.le_of_lt he) z, hz,
    pair_inl_inr_zero e (Nat.le_of_lt he) z, pair_inr_inl_zero e (Nat.le_of_lt he) z⟩

end P14CyclicWindowComplex

end
end

section

/-! Translate the B labels of the actual cyclic-window family. The same real
parameter works under every translation; all selected-set ranks are retained. -/

noncomputable section
namespace P14CyclicWindowTranslated

open Submodule P14CyclicWindowComplex
open scoped BigOperators

variable {n : ℕ} [NeZero n]

def labelEquiv (δ : Fin n) : (Fin n ⊕ Fin n) ≃ (Fin n ⊕ Fin n) where
  toFun := Sum.map id (fun b => b - δ)
  invFun := Sum.map id (fun b => b + δ)
  left_inv i := by cases i <;> simp
  right_inv i := by cases i <;> simp

def translatedFamily (e : ℕ) (he : e ≤ n) (δ : Fin n) (z : Fin n → ℝ)
    (i : Fin n ⊕ Fin n) : Fin (e + 1) → ℂ :=
  complexFamily e he z (labelEquiv δ i)

theorem translatedFamily_ne_zero (e : ℕ) (he : e ≤ n)
    (δ : Fin n) (z : Fin n → ℝ) (i : Fin n ⊕ Fin n) :
    translatedFamily e he δ z i ≠ 0 :=
  complexFamily_ne_zero e he z (labelEquiv δ i)

theorem translatedFamily_spanning (e : ℕ) (he : e ≤ n)
    (δ : Fin n) (z : Fin n → ℝ)
    (hspan : ∀ S : Finset (Fin n ⊕ Fin n), S.card = e + 1 →
      span ℂ (Set.range (fun i : ↥(S : Set (Fin n ⊕ Fin n)) =>
        complexFamily e he z i.val)) = ⊤)
    (S : Finset (Fin n ⊕ Fin n)) (hS : S.card = e + 1) :
    span ℂ (Set.range (fun i : ↥(S : Set (Fin n ⊕ Fin n)) =>
      translatedFamily e he δ z i.val)) = ⊤ := by
  classical
  let T := S.map (labelEquiv δ).toEmbedding
  have hT : T.card = e + 1 := by simpa only [T, Finset.card_map] using hS
  have hr : Set.range (fun i : ↥(S : Set (Fin n ⊕ Fin n)) =>
      translatedFamily e he δ z i.val) =
      Set.range (fun i : ↥(T : Set (Fin n ⊕ Fin n)) => complexFamily e he z i.val) := by
    ext v
    constructor
    · rintro ⟨i, rfl⟩
      exact ⟨⟨labelEquiv δ i.val,
        Finset.mem_map_of_mem (labelEquiv δ).toEmbedding i.property⟩, rfl⟩
    · rintro ⟨j, rfl⟩
      have hj : j.val ∈ S.map (labelEquiv δ).toEmbedding := j.property
      rcases Finset.mem_map.mp hj with ⟨i, hi, hij⟩
      refine ⟨⟨i, hi⟩, ?_⟩
      change complexFamily e he z (labelEquiv δ i) = complexFamily e he z j.val
      exact congrArg (complexFamily e he z) hij
  rw [hr]
  exact hspan T hT

theorem pair_inl_inr (e : ℕ) (he : e ≤ n) (δ : Fin n)
    (z : Fin n → ℝ) (a b : Fin n) :
    (∑ j, star (translatedFamily e he δ z (Sum.inl a) j) *
      translatedFamily e he δ z (Sum.inr b) j) =
      ((∏ t : Fin e, (z a - z ((b - δ) - t.castLE he)) : ℝ) : ℂ) := by
  exact P14CyclicWindowComplex.pair_inl_inr e he z a (b - δ)

theorem pair_inr_inl (e : ℕ) (he : e ≤ n) (δ : Fin n)
    (z : Fin n → ℝ) (a b : Fin n) :
    (∑ j, star (translatedFamily e he δ z (Sum.inr b) j) *
      translatedFamily e he δ z (Sum.inl a) j) =
      ((∏ t : Fin e, (z a - z ((b - δ) - t.castLE he)) : ℝ) : ℂ) := by
  exact P14CyclicWindowComplex.pair_inr_inl e he z a (b - δ)

theorem offset_eq_iff (a b δ t : Fin n) :
    a = (b - δ) - t ↔ b - a = δ + t := by
  rw [sub_sub, eq_sub_iff_add_eq, sub_eq_iff_eq_add]
  exact ⟨fun h => h.symm.trans (add_comm a _),
    fun h => (add_comm a _).trans h.symm⟩

theorem pair_inl_inr_zero (e : ℕ) (he : e ≤ n) (δ : Fin n)
    (z : Fin n → ℝ) (a b : Fin n) (t : Fin e)
    (hab : b - a = δ + t.castLE he) :
    (∑ j, star (translatedFamily e he δ z (Sum.inl a) j) *
      translatedFamily e he δ z (Sum.inr b) j) = 0 := by
  have ha := (offset_eq_iff a b δ (t.castLE he)).mpr hab
  rw [ha]
  exact P14CyclicWindowComplex.pair_inl_inr_zero e he z (b - δ) t

theorem pair_inr_inl_zero (e : ℕ) (he : e ≤ n) (δ : Fin n)
    (z : Fin n → ℝ) (a b : Fin n) (t : Fin e)
    (hab : b - a = δ + t.castLE he) :
    (∑ j, star (translatedFamily e he δ z (Sum.inr b) j) *
      translatedFamily e he δ z (Sum.inl a) j) = 0 := by
  have ha := (offset_eq_iff a b δ (t.castLE he)).mpr hab
  rw [ha]
  exact P14CyclicWindowComplex.pair_inr_inl_zero e he z (b - δ) t

theorem exists_all_translated_factors {e : ℕ} {ζ : ℂ}
    (hζ : IsPrimitiveRoot ζ n) (he : e < n) :
    ∃ z : Fin n → ℝ, ∀ δ : Fin n,
      (∀ i : Fin n ⊕ Fin n,
        translatedFamily e (Nat.le_of_lt he) δ z i ≠ 0) ∧
      (∀ S : Finset (Fin n ⊕ Fin n), S.card = e + 1 →
        span ℂ (Set.range (fun i : ↥(S : Set (Fin n ⊕ Fin n)) =>
          translatedFamily e (Nat.le_of_lt he) δ z i.val)) = ⊤) ∧
      (∀ a b : Fin n, ∀ t : Fin e, b - a = δ + t.castLE (Nat.le_of_lt he) →
        (∑ j, star (translatedFamily e (Nat.le_of_lt he) δ z (Sum.inl a) j) *
          translatedFamily e (Nat.le_of_lt he) δ z (Sum.inr b) j) = 0) ∧
      (∀ a b : Fin n, ∀ t : Fin e, b - a = δ + t.castLE (Nat.le_of_lt he) →
        (∑ j, star (translatedFamily e (Nat.le_of_lt he) δ z (Sum.inr b) j) *
          translatedFamily e (Nat.le_of_lt he) δ z (Sum.inl a) j) = 0) := by
  obtain ⟨z, _, hspan, _, _⟩ := P14CyclicWindowComplex.exists_local_factor hζ he
  refine ⟨z, fun δ => ?_⟩
  exact ⟨translatedFamily_ne_zero e (Nat.le_of_lt he) δ z,
    translatedFamily_spanning e (Nat.le_of_lt he) δ z hspan,
    pair_inl_inr_zero e (Nat.le_of_lt he) δ z,
    pair_inr_inl_zero e (Nat.le_of_lt he) δ z⟩

end P14CyclicWindowTranslated

end
end

section

/-! The exact finite graph prescribed by the Fourier zero pattern.
Its two internal matchings use the half-period shift. Cross edges retain the
A-to-B difference orientation, and every vertex has degree k when d+k=n.
Physical realization, connectedness and Seed assembly are separate. -/

noncomputable section

namespace P14FourierOrthogonalityGraph

def offsets (n d : ℕ) : Finset (Fin n) :=
  Finset.univ.filter (fun δ => d < δ.val)

@[simp] theorem mem_offsets (n d : ℕ) (δ : Fin n) :
    δ ∈ offsets n d ↔ d < δ.val := by
  simp [offsets]

theorem offsets_eq_Ioi {n d : ℕ} (hdn : d < n) :
    offsets n d = Finset.Ioi (⟨d, hdn⟩ : Fin n) := by
  ext δ
  simp [offsets, Fin.lt_def]

theorem card_offsets {n d : ℕ} (hdn : d < n) :
    (offsets n d).card = n - 1 - d := by
  rw [offsets_eq_Ioi hdn]
  exact Fin.card_Ioi (⟨d, hdn⟩ : Fin n)

def half {n : ℕ} (hn : 0 < n) : Fin n :=
  ⟨n / 2, Nat.div_lt_self hn (by decide)⟩

def opposite {n : ℕ} (hn : 0 < n) (a : Fin n) : Fin n :=
  a + half hn

theorem opposite_val {n : ℕ} (hn : 0 < n) (a : Fin n) :
    (opposite hn a).val = (a.val + n / 2) % n := rfl

theorem opposite_involutive {n : ℕ} (hn : 0 < n) (he : Even n) :
    Function.Involutive (opposite hn) := by
  letI : NeZero n := ⟨Nat.ne_of_gt hn⟩
  have hsum : n / 2 + n / 2 = n := by
    obtain ⟨m, hm⟩ := he
    omega
  have hhalf : half hn + half hn = (0 : Fin n) := by
    apply Fin.ext
    change (n / 2 + n / 2) % n = 0
    rw [hsum, Nat.mod_self]
  intro a
  change (a + half hn) + half hn = a
  rw [add_assoc, hhalf, add_zero]

theorem opposite_ne {n : ℕ} (hn : 0 < n) (he : Even n) (a : Fin n) :
    opposite hn a ≠ a := by
  letI : NeZero n := ⟨Nat.ne_of_gt hn⟩
  have hpos : 0 < n / 2 := by
    obtain ⟨m, hm⟩ := he
    omega
  intro h
  have hEq : a + half hn = a + (0 : Fin n) := by
    simpa only [opposite, add_zero] using h
  have hzero : half hn = (0 : Fin n) := add_left_cancel hEq
  have hv : n / 2 = 0 := congrArg Fin.val hzero
  omega

def Adj {n : ℕ} (hn : 0 < n) (d : ℕ) : (Fin n ⊕ Fin n) → (Fin n ⊕ Fin n) → Prop
  | .inl a, .inl b => b = opposite hn a
  | .inr a, .inr b => b = opposite hn a
  | .inl a, .inr b => b - a ∈ offsets n d
  | .inr b, .inl a => b - a ∈ offsets n d

def graph {n : ℕ} (hn : 0 < n) (he : Even n) (d : ℕ) :
    SimpleGraph (Fin n ⊕ Fin n) where
  Adj := Adj hn d
  symm := ⟨by
    intro u v h
    rcases u with a | a <;> rcases v with b | b
    · change b = opposite hn a at h
      change a = opposite hn b
      rw [h, opposite_involutive hn he a]
    · exact h
    · exact h
    · change b = opposite hn a at h
      change a = opposite hn b
      rw [h, opposite_involutive hn he a]⟩
  loopless := ⟨by
    intro u h
    rcases u with a | a
    · change a = opposite hn a at h
      exact opposite_ne hn he a h.symm
    · change a = opposite hn a at h
      exact opposite_ne hn he a h.symm⟩

instance instDecidableRelGraph {n : ℕ} (hn : 0 < n) (he : Even n) (d : ℕ) :
    DecidableRel (graph hn he d).Adj :=
  fun _ _ => Classical.propDecidable _

@[simp] theorem adj_inl_inl {n : ℕ} (hn : 0 < n) (he : Even n) (d : ℕ) (a b : Fin n) :
    (graph hn he d).Adj (Sum.inl a) (Sum.inl b) ↔
      b.val = (a.val + n / 2) % n := by
  change b = opposite hn a ↔ _
  rw [Fin.ext_iff, opposite_val]

@[simp] theorem adj_inr_inr {n : ℕ} (hn : 0 < n) (he : Even n) (d : ℕ) (a b : Fin n) :
    (graph hn he d).Adj (Sum.inr a) (Sum.inr b) ↔
      b.val = (a.val + n / 2) % n := by
  change b = opposite hn a ↔ _
  rw [Fin.ext_iff, opposite_val]

@[simp] theorem adj_inl_inr {n : ℕ} (hn : 0 < n) (he : Even n) (d : ℕ) (a b : Fin n) :
    (graph hn he d).Adj (Sum.inl a) (Sum.inr b) ↔ d < (b - a).val := by
  exact mem_offsets n d (b - a)

@[simp] theorem adj_inr_inl {n : ℕ} (hn : 0 < n) (he : Even n) (d : ℕ) (a b : Fin n) :
    (graph hn he d).Adj (Sum.inr a) (Sum.inl b) ↔ d < (a - b).val := by
  exact mem_offsets n d (a - b)

theorem neighborFinset_inl {n : ℕ} (hn : 0 < n) (he : Even n) (d : ℕ) (a : Fin n) :
    (graph hn he d).neighborFinset (Sum.inl a) =
      insert (Sum.inl (opposite hn a))
        ((offsets n d).image (fun δ => Sum.inr (a + δ))) := by
  letI : NeZero n := ⟨Nat.ne_of_gt hn⟩
  ext v
  rw [SimpleGraph.mem_neighborFinset]
  cases v with
  | inl b =>
    change b = opposite hn a ↔ _
    simp
  | inr b =>
    change b - a ∈ offsets n d ↔ _
    simp only [Finset.mem_insert, Finset.mem_image, Sum.inr_ne_inl, false_or, Sum.inr.injEq]
    constructor
    · intro h
      exact ⟨b - a, h, add_sub_cancel a b⟩
    · rintro ⟨δ, hδ, hEq⟩
      rw [← hEq, add_sub_cancel_left]
      exact hδ

theorem neighborFinset_inr {n : ℕ} (hn : 0 < n) (he : Even n) (d : ℕ) (b : Fin n) :
    (graph hn he d).neighborFinset (Sum.inr b) =
      insert (Sum.inr (opposite hn b))
        ((offsets n d).image (fun δ => Sum.inl (b - δ))) := by
  letI : NeZero n := ⟨Nat.ne_of_gt hn⟩
  ext v
  rw [SimpleGraph.mem_neighborFinset]
  cases v with
  | inl a =>
    change b - a ∈ offsets n d ↔ _
    simp only [Finset.mem_insert, Finset.mem_image, Sum.inl_ne_inr, false_or, Sum.inl.injEq]
    constructor
    · intro h
      exact ⟨b - a, h, sub_sub_self b a⟩
    · rintro ⟨δ, hδ, hEq⟩
      rw [← hEq, sub_sub_self]
      exact hδ
  | inr a =>
    change a = opposite hn b ↔ _
    simp

theorem degree {n k : ℕ} (hn : 0 < n) (he : Even n) (d : ℕ)
    (hdim : d + k = n) (hk : 5 ≤ k) (v : Fin n ⊕ Fin n) :
    (graph hn he d).degree v = k := by
  letI : NeZero n := ⟨Nat.ne_of_gt hn⟩
  have hdn : d < n := by omega
  have hcard : (offsets n d).card = k - 1 := by
    rw [card_offsets hdn]
    omega
  have hAdd (a : Fin n) :
      Function.Injective (fun δ : Fin n => (Sum.inr (a + δ) : Fin n ⊕ Fin n)) := by
    intro δ ε h
    exact add_left_cancel (Sum.inr.inj h)
  have hSub (b : Fin n) :
      Function.Injective (fun δ : Fin n => (Sum.inl (b - δ) : Fin n ⊕ Fin n)) := by
    intro δ ε h
    have hEq : b - δ = b - ε := Sum.inl.inj h
    have hCancel := congrArg (fun x : Fin n => b - x) hEq
    simpa only [sub_sub_self] using hCancel
  cases v with
  | inl a =>
    rw [← SimpleGraph.card_neighborFinset_eq_degree, neighborFinset_inl,
      Finset.card_insert_of_notMem (by simp),
      Finset.card_image_of_injective _ (hAdd a), hcard]
    omega
  | inr b =>
    rw [← SimpleGraph.card_neighborFinset_eq_degree, neighborFinset_inr,
      Finset.card_insert_of_notMem (by simp),
      Finset.card_image_of_injective _ (hSub b), hcard]
    omega


end P14FourierOrthogonalityGraph
end
end

section

/-! Circle-method matchings with a prescribed excluded half-period matching.
The local circle formulas and their elementary proofs are adapted from the
inspected first circle-method section of P14OddComplementRounds. No legacy
SchurGraph module is imported. Cycle-type conjugacy carries one actual circle
round to the actual Fourier half-period involution before that round is removed.
-/

noncomputable section

namespace P14FourierHalfMatchings

namespace Circle

open Fin.NatCast Fin.CommRing

abbrev Index (r : ℕ) := Fin (2 * r + 3)
abbrev Half (r : ℕ) := Option (Index r)

def halfColor (r : ℕ) : Index r := (r + 2 : ℕ)

lemma two_halfColor (r : ℕ) : (2 : Index r) * halfColor r = 1 := by
  calc
    (2 : Index r) * halfColor r = ((2 * (r + 2) : ℕ) : Index r) := by
      simp [halfColor]
    _ = (((2 * r + 3) + 1 : ℕ) : Index r) := by congr 1 <;> omega
    _ = 1 := by rw [Nat.cast_add, Fin.natCast_self, Nat.cast_one, zero_add]

lemma two_cancel {r : ℕ} {x y : Index r} (he : 2 * x = 2 * y) : x = y := by
  have hi : halfColor r * 2 = 1 := (mul_comm _ _).trans (two_halfColor r)
  have ht := congrArg (fun z : Index r => halfColor r * z) he
  simpa only [← mul_assoc, hi, one_mul] using ht

/-- Infinity is paired with the round label; the other labels are reflected. -/
def halfRound {r : ℕ} (c : Index r) : Half r → Half r
  | none => some c
  | some x => if x = c then none else some (2 * c - x)

lemma reflect_ne {r : ℕ} (c x : Index r) (hx : x ≠ c) : 2 * c - x ≠ c := by
  intro he
  apply hx
  linear_combination -he

theorem halfRound_involutive {r : ℕ} (c : Index r) :
    Function.Involutive (halfRound c) := by
  intro x
  cases x with
  | none => simp [halfRound]
  | some x =>
    by_cases hx : x = c
    · simp [halfRound, hx]
    · have hr : 2 * c - (2 * c - x) = x := by ring
      simp only [halfRound, if_neg hx, if_neg (reflect_ne c x hx), hr]

theorem halfRound_fixed_free {r : ℕ} (c : Index r) (x : Half r) :
    halfRound c x ≠ x := by
  cases x with
  | none => simp [halfRound]
  | some x =>
    by_cases hx : x = c
    · simp [halfRound, hx]
    · intro h
      have he : 2 * c - x = x := Option.some.inj (by
        simpa only [halfRound, if_neg hx] using h)
      apply hx
      apply two_cancel
      linear_combination -he

/-- Every pair of distinct vertices occurs in a circle round. -/
theorem halfRound_cover {r : ℕ} (x y : Half r) (hxy : x ≠ y) :
    ∃ c, halfRound c x = y := by
  cases x with
  | none =>
    cases y with
    | none => exact False.elim (hxy rfl)
    | some y => exact ⟨y, rfl⟩
  | some x =>
    cases y with
    | none => exact ⟨x, by simp [halfRound]⟩
    | some y =>
      let c : Index r := halfColor r * (x + y)
      have hd : 2 * c = x + y := by
        dsimp only [c]
        rw [← mul_assoc, two_halfColor, one_mul]
      have hx : x ≠ c := by
        intro he
        apply hxy
        apply congrArg some
        rw [← he] at hd
        linear_combination hd
      refine ⟨c, ?_⟩
      have hr : 2 * c - x = y := by linear_combination hd
      simp only [halfRound, if_neg hx, hr]


end Circle

/-- Two fixed-point-free involutions of one finite set are conjugate.
The conclusion is proved from their cycle types, without a matching premise. -/
theorem exists_conjugacy_of_involutive_fixed_free {α : Type*} [Fintype α]
    [DecidableEq α] (f g : α → α) (hf : Function.Involutive f)
    (hg : Function.Involutive g) (hff : ∀ x, f x ≠ x) (hgf : ∀ x, g x ≠ x) :
    ∃ e : Equiv.Perm α, ∀ x, e (f (e.symm x)) = g x := by
  letI : Fact (Nat.Prime 2) := ⟨by decide⟩
  let p : Equiv.Perm α :=
    { toFun := f, invFun := f, left_inv := hf, right_inv := hf }
  let q : Equiv.Perm α :=
    { toFun := g, invFun := g, left_inv := hg, right_inv := hg }
  have hp2 : p ^ 2 = 1 := by
    apply Equiv.ext
    intro x
    exact hf x
  have hq2 : q ^ 2 = 1 := by
    apply Equiv.ext
    intro x
    exact hg x
  have cycleCard (s : Equiv.Perm α) (hs2 : s ^ 2 = 1)
      (hsf : ∀ x, s x ≠ x) : s.cycleType.card * 2 = Fintype.card α := by
    have hsSupport : s.support = Finset.univ := by
      ext x
      simp only [Equiv.Perm.mem_support, Finset.mem_univ, iff_true]
      exact hsf x
    have hsType := Equiv.Perm.cycleType_of_pow_prime_eq_one hs2
    calc
      s.cycleType.card * 2 = (Multiset.replicate s.cycleType.card 2).sum := by
        simp only [Multiset.sum_replicate, nsmul_eq_mul, Nat.cast_id]
      _ = s.cycleType.sum := congrArg Multiset.sum hsType.symm
      _ = s.support.card := s.sum_cycleType
      _ = Fintype.card α := by rw [hsSupport, Finset.card_univ]
  have hpCard := cycleCard p hp2 hff
  have hqCard := cycleCard q hq2 hgf
  have hCard : p.cycleType.card = q.cycleType.card := by omega
  have hType : p.cycleType = q.cycleType := by
    calc
      p.cycleType = Multiset.replicate p.cycleType.card 2 :=
        Equiv.Perm.cycleType_of_pow_prime_eq_one hp2
      _ = Multiset.replicate q.cycleType.card 2 := by rw [hCard]
      _ = q.cycleType := (Equiv.Perm.cycleType_of_pow_prime_eq_one hq2).symm
  obtain ⟨e, he⟩ := isConj_iff.mp (Equiv.Perm.isConj_of_cycleType_eq hType)
  refine ⟨e, fun x => ?_⟩
  have hx := congrArg (fun s : Equiv.Perm α => s x) he
  exact hx

/-- The complement of the prescribed Fourier half-period matching is covered
by exactly n-2 fixed-point-free involutions. -/
theorem exists_half_matchings {n : ℕ} (hn : 0 < n) (he : Even n) (hn6 : 6 ≤ n) :
    ∃ F : Fin (n - 2) → Fin n → Fin n,
      (∀ q, Function.Involutive (F q)) ∧
      (∀ q a, F q a ≠ a) ∧
      ∀ a b, a ≠ b → b ≠ P14FourierOrthogonalityGraph.opposite hn a →
        ∃ q, F q a = b := by
  classical
  let r : ℕ := n / 2 - 2
  have hnEq : n = 2 * r + 4 := by
    obtain ⟨m, hm⟩ := he
    dsimp only [r]
    omega
  let e : Fin n ≃ Circle.Half r := Fintype.equivOfCardEq (by
    simp only [Circle.Half, Circle.Index, Fintype.card_option, Fintype.card_fin]
    omega)
  let round : Circle.Index r → Fin n → Fin n :=
    fun c a => e.symm (Circle.halfRound c (e a))
  have hRoundInv (c : Circle.Index r) : Function.Involutive (round c) := by
    intro a
    simp only [round, Equiv.apply_symm_apply, Circle.halfRound_involutive c _,
      Equiv.symm_apply_apply]
  have hRoundFree (c : Circle.Index r) (a : Fin n) : round c a ≠ a := by
    intro h
    apply Circle.halfRound_fixed_free c (e a)
    simpa only [round, Equiv.apply_symm_apply] using congrArg e h
  have hRoundCover (a b : Fin n) (hab : a ≠ b) : ∃ c, round c a = b := by
    obtain ⟨c, hc⟩ := Circle.halfRound_cover (e a) (e b)
      (fun h => hab (e.injective h))
    refine ⟨c, ?_⟩
    change e.symm (Circle.halfRound c (e a)) = b
    rw [hc, Equiv.symm_apply_apply]
  obtain ⟨u, hu⟩ := exists_conjugacy_of_involutive_fixed_free
    (round 0) (P14FourierOrthogonalityGraph.opposite hn)
    (hRoundInv 0) (P14FourierOrthogonalityGraph.opposite_involutive hn he)
    (hRoundFree 0) (P14FourierOrthogonalityGraph.opposite_ne hn he)
  let R : Circle.Index r → Fin n → Fin n :=
    fun c a => u (round c (u.symm a))
  have hR0 (a : Fin n) : R 0 a = P14FourierOrthogonalityGraph.opposite hn a := hu a
  let colors : Fin (n - 2) ≃ {c : Circle.Index r // c ≠ 0} :=
    Fintype.equivOfCardEq (by
      rw [Fintype.card_fin, Fintype.card_subtype_compl (fun c : Circle.Index r => c = 0),
        Fintype.card_subtype_eq]
      simp only [Circle.Index, Fintype.card_fin]
      omega)
  refine ⟨fun q => R (colors q).val, ?_, ?_, ?_⟩
  · intro q a
    simp only [R, Equiv.symm_apply_apply, hRoundInv (colors q).val _,
      Equiv.apply_symm_apply]
  · intro q a h
    apply hRoundFree (colors q).val (u.symm a)
    simpa only [R, Equiv.symm_apply_apply] using congrArg u.symm h
  · intro a b hab hbp
    obtain ⟨c, hc⟩ := hRoundCover (u.symm a) (u.symm b)
      (fun h => hab (u.symm.injective h))
    have hRc : R c a = b := by
      change u (round c (u.symm a)) = b
      rw [hc, Equiv.apply_symm_apply]
    have hc0 : c ≠ 0 := by
      intro h0
      subst c
      exact hbp (hRc.symm.trans (hR0 a))
    refine ⟨colors.symm ⟨c, hc0⟩, ?_⟩
    simpa only [Equiv.apply_symm_apply] using hRc


end P14FourierHalfMatchings
end
end

section

/-! An explicit alternating Hamilton sequence for two consecutive circle
rounds, before any relabeling of the remaining colors. For h=r+2 and
M=2*r+3, the sequence is infinity,c,c+2,c-2,...,c+2(h-1),c+1.
The bipartite labeling A_j=c-2j and B_j=c+2j (B_0=infinity)
matches the moment-cycle incidence b=a or b=a+1. No vector realization,
conjugated color pairing or mixed-half general-position assertion is made. -/

noncomputable section
namespace P14CircleConsecutiveCycle

open P14FourierHalfMatchings.Circle
open Fin.NatCast Fin.CommRing

abbrev Step (r : ℕ) := Fin (r + 2)

def embed {r : ℕ} (j : Step r) : Index r :=
  ⟨j.val, by have hj := j.isLt; omega⟩

@[simp] theorem embed_zero (r : ℕ) : embed (0 : Step r) = 0 := rfl

theorem embed_injective {r : ℕ} : Function.Injective (embed (r := r)) := by
  intro j k h
  apply Fin.ext
  exact congrArg (fun x : Index r => x.val) h

theorem embed_add_ne_zero {r : ℕ} (j k : Step r) (hj : j ≠ 0) :
    embed j + embed k ≠ 0 := by
  intro h
  have hjv : j.val ≠ 0 := by
    intro h0
    exact hj (Fin.ext h0)
  have hlt : j.val + k.val < 2 * r + 3 := by
    have hjlt := j.isLt
    have hklt := k.isLt
    omega
  have hv := congrArg Fin.val h
  change (j.val + k.val) % (2 * r + 3) = 0 at hv
  rw [Nat.mod_eq_of_lt hlt] at hv
  omega

def evenVertex {r : ℕ} (c : Index r) (j : Step r) : Half r :=
  if j = 0 then none else some (c + 2 * embed j)

def oddVertex {r : ℕ} (c : Index r) (j : Step r) : Half r :=
  some (c - 2 * embed j)

@[simp] theorem evenVertex_zero {r : ℕ} (c : Index r) :
    evenVertex c 0 = none := by simp [evenVertex]

@[simp] theorem oddVertex_zero {r : ℕ} (c : Index r) :
    oddVertex c 0 = some c := by simp [oddVertex]

theorem odd_value_injective {r : ℕ} (c : Index r) :
    Function.Injective (fun j : Step r => c - 2 * embed j) := by
  intro j k h
  apply embed_injective
  apply two_cancel
  linear_combination -h

theorem oddVertex_injective {r : ℕ} (c : Index r) :
    Function.Injective (oddVertex c) := by
  intro j k h
  exact odd_value_injective c (Option.some.inj h)

theorem evenVertex_injective {r : ℕ} (c : Index r) :
    Function.Injective (evenVertex c) := by
  intro j k h
  by_cases hj : j = 0
  · subst j
    by_cases hk : k = 0
    · exact hk.symm
    · simp [evenVertex, hk] at h
  · by_cases hk : k = 0
    · subst k
      simp [evenVertex, hj] at h
    · have hv : c + 2 * embed j = c + 2 * embed k :=
        Option.some.inj (by simpa only [evenVertex, if_neg hj, if_neg hk] using h)
      apply embed_injective
      exact two_cancel (add_left_cancel hv)

theorem oddVertex_ne_evenVertex {r : ℕ} (c : Index r) (j k : Step r) :
    oddVertex c j ≠ evenVertex c k := by
  intro h
  by_cases hk : k = 0
  · subst k
    simp [oddVertex, evenVertex] at h
  · have hv : c - 2 * embed j = c + 2 * embed k :=
      Option.some.inj (by simpa only [oddVertex, evenVertex, if_neg hk] using h)
    apply embed_add_ne_zero k j hk
    apply two_cancel
    linear_combination -hv

/-- A labels use the odd positions; B labels use the even positions. -/
def label {r : ℕ} (c : Index r) : (Step r ⊕ Step r) → Half r :=
  Sum.elim (oddVertex c) (evenVertex c)

theorem label_injective {r : ℕ} (c : Index r) : Function.Injective (label c) := by
  intro u v h
  cases u with
  | inl j =>
      cases v with
      | inl k => exact congrArg Sum.inl (oddVertex_injective c h)
      | inr k => exact False.elim (oddVertex_ne_evenVertex c j k h)
  | inr j =>
      cases v with
      | inl k => exact False.elim (oddVertex_ne_evenVertex c k j h.symm)
      | inr k => exact congrArg Sum.inr (evenVertex_injective c h)

theorem label_bijective {r : ℕ} (c : Index r) : Function.Bijective (label c) := by
  apply (Fintype.bijective_iff_injective_and_card (label c)).mpr
  refine ⟨label_injective c, ?_⟩
  simp [Step, Half, Index] <;> omega

def labeling {r : ℕ} (c : Index r) : (Step r ⊕ Step r) ≃ Half r :=
  Equiv.ofBijective (label c) (label_bijective c)

@[simp] theorem labeling_inl {r : ℕ} (c : Index r) (j : Step r) :
    labeling c (Sum.inl j) = oddVertex c j := rfl

@[simp] theorem labeling_inr {r : ℕ} (c : Index r) (j : Step r) :
    labeling c (Sum.inr j) = evenVertex c j := rfl

theorem round_center_odd {r : ℕ} (c : Index r) (j : Step r) :
    halfRound c (oddVertex c j) = evenVertex c j := by
  by_cases hj : j = 0
  · subst j
    simp [halfRound, oddVertex, evenVertex]
  · have hne : c - 2 * embed j ≠ c := by
      intro h
      apply hj
      apply embed_injective
      apply two_cancel
      simp only [embed_zero, mul_zero]
      linear_combination -h
    have he : 2 * c - (c - 2 * embed j) = c + 2 * embed j := by ring
    simp only [oddVertex, halfRound, if_neg hne, evenVertex, if_neg hj, he]

theorem round_center_even {r : ℕ} (c : Index r) (j : Step r) :
    halfRound c (evenVertex c j) = oddVertex c j := by
  rw [← round_center_odd c j]
  exact halfRound_involutive c (oddVertex c j)

theorem odd_value_last {r : ℕ} (c : Index r) :
    c - 2 * embed (Fin.last (r + 1)) = c + 1 := by
  have he : embed (Fin.last (r + 1)) + 1 = halfColor r := by
    apply Fin.ext
    change (r + 1 + 1) % (2 * r + 3) = (r + 2) % (2 * r + 3)
    rfl
  have ht : (2 : Index r) * (embed (Fin.last (r + 1)) + 1) = 1 := by
    rw [he]
    exact two_halfColor r
  linear_combination -ht

theorem step_next_value {r : ℕ} (j : Step r) (hj : j ≠ Fin.last (r + 1)) :
    (j + 1).val = j.val + 1 := by
  apply Fin.val_add_one_of_lt
  change j.val < r + 1
  have hjlt := j.isLt
  have hjne : j.val ≠ r + 1 := by
    intro h
    exact hj (Fin.ext h)
  omega

theorem embed_next {r : ℕ} (j : Step r) (hj : j ≠ Fin.last (r + 1)) :
    embed (j + 1) = embed j + 1 := by
  apply Fin.ext
  change (j + 1).val = (j.val + 1) % (2 * r + 3)
  rw [step_next_value j hj]
  exact (Nat.mod_eq_of_lt (by have h := j.isLt; omega)).symm

theorem round_next_odd {r : ℕ} (c : Index r) (j : Step r) :
    halfRound (c + 1) (oddVertex c j) = evenVertex c (j + 1) := by
  by_cases hj : j = Fin.last (r + 1)
  · subst j
    rw [Fin.last_add_one]
    simp only [oddVertex, odd_value_last, halfRound, if_true, evenVertex_zero]
  · have hne : c - 2 * embed j ≠ c + 1 := by
      intro h
      apply hj
      apply odd_value_injective c
      exact h.trans (odd_value_last c).symm
    have hnz : j + 1 ≠ (0 : Step r) := by
      intro h
      have hv := congrArg Fin.val h
      rw [step_next_value j hj] at hv
      change j.val + 1 = 0 at hv
      omega
    have he : 2 * (c + 1) - (c - 2 * embed j) = c + 2 * embed (j + 1) := by
      rw [embed_next j hj]
      ring
    simp only [oddVertex, halfRound, if_neg hne, evenVertex, if_neg hnz, he]

theorem round_next_even {r : ℕ} (c : Index r) (j : Step r) :
    halfRound (c + 1) (evenVertex c j) = oddVertex c (j - 1) := by
  have h := round_next_odd c (j - 1)
  rw [sub_add_cancel] at h
  rw [← h]
  exact halfRound_involutive (c + 1) (oddVertex c (j - 1))

/-- The two actual rounds become the two literal bipartite cycle edges. -/
theorem labeling_rounds {r : ℕ} (c : Index r) (j : Step r) :
    halfRound c (labeling c (.inl j)) = labeling c (.inr j) ∧
    halfRound c (labeling c (.inr j)) = labeling c (.inl j) ∧
    halfRound (c + 1) (labeling c (.inl j)) = labeling c (.inr (j + 1)) ∧
    halfRound (c + 1) (labeling c (.inr j)) = labeling c (.inl (j - 1)) :=
  ⟨round_center_odd c j, round_center_even c j, round_next_odd c j, round_next_even c j⟩

theorem cross_edge_iff {r : ℕ} (c : Index r) (a b : Step r) :
    (halfRound c (labeling c (.inl a)) = labeling c (.inr b) ∨
      halfRound (c + 1) (labeling c (.inl a)) = labeling c (.inr b)) ↔
      b = a ∨ b = a + 1 := by
  constructor
  · rintro (h | h)
    · have he := (labeling c).injective ((labeling_rounds c a).1.symm.trans h)
      exact Or.inl (Sum.inr.inj he).symm
    · have he := (labeling c).injective ((labeling_rounds c a).2.2.1.symm.trans h)
      exact Or.inr (Sum.inr.inj he).symm
  · rintro (h | h)
    · subst b
      exact Or.inl (labeling_rounds c a).1
    · subst b
      exact Or.inr (labeling_rounds c a).2.2.1

/-- Interleave B_j,A_j in successive even and odd positions. -/
def interleave (r : ℕ) : (Step r × Fin 2) ≃ (Step r ⊕ Step r) where
  toFun := fun p => if p.2 = 0 then .inr p.1 else .inl p.1
  invFun := Sum.elim (fun j => (j, 1)) (fun j => (j, 0))
  left_inv := by
    rintro ⟨j, b⟩
    fin_cases b <;> rfl
  right_inv := by
    rintro (j | j) <;> rfl

/-- A bijective sequence of all 2r+4 vertices, with its explicit alternating edges below. -/
def sequence {r : ℕ} (c : Index r) : Fin ((r + 2) * 2) ≃ Half r :=
  finProdFinEquiv.symm.trans ((interleave r).trans (labeling c))

@[simp] theorem sequence_even {r : ℕ} (c : Index r) (j : Step r) :
    sequence c (finProdFinEquiv (j, (0 : Fin 2))) = evenVertex c j := by
  simp [sequence, interleave]

@[simp] theorem sequence_odd {r : ℕ} (c : Index r) (j : Step r) :
    sequence c (finProdFinEquiv (j, (1 : Fin 2))) = oddVertex c j := by
  simp [sequence, interleave]

theorem sequence_even_edge {r : ℕ} (c : Index r) (j : Step r) :
    halfRound c (sequence c (finProdFinEquiv (j, (0 : Fin 2)))) =
      sequence c (finProdFinEquiv (j, (1 : Fin 2))) := by
  rw [sequence_even, sequence_odd]
  exact round_center_even c j

theorem sequence_odd_edge {r : ℕ} (c : Index r) (j : Step r) :
    halfRound (c + 1) (sequence c (finProdFinEquiv (j, (1 : Fin 2)))) =
      sequence c (finProdFinEquiv (j + 1, (0 : Fin 2))) := by
  rw [sequence_odd, sequence_even]
  exact round_next_odd c j

end P14CircleConsecutiveCycle

end
end

section

/-!
Algebraic identities for moment-curve rows and the quadratic coefficient
rows of their two-point annihilators. The polynomial nonvanishing lemmas
require distinct variable indices only where a displayed difference occurs.
No cyclic indexing or simultaneous generic parameter is asserted here.
-/

namespace P14MomentCyclePolynomial

variable {R : Type*} [CommRing R]

def rowA (x : R) : Fin 3 → R := ![1, x, x ^ 2]

def rowB (u v : R) : Fin 3 → R := ![u * v, -(u + v), 1]

noncomputable def detRows (a b c : Fin 3 → R) : R :=
  Matrix.det ![a, b, c]

theorem detRows_eq (a b c : Fin 3 → R) :
    detRows a b c = a 0 * b 1 * c 2 - a 0 * b 2 * c 1 -
      a 1 * b 0 * c 2 + a 1 * b 2 * c 0 +
      a 2 * b 0 * c 1 - a 2 * b 1 * c 0 :=
  Matrix.det_fin_three (Matrix.of ![a, b, c])

theorem detRows_swap_first (a b c : Fin 3 → R) :
    detRows b a c = -detRows a b c := by
  simp [detRows_eq] <;> ring

theorem detRows_swap_last (a b c : Fin 3 → R) :
    detRows a c b = -detRows a b c := by
  simp [detRows_eq] <;> ring

theorem detRows_rotate (a b c : Fin 3 → R) :
    detRows b c a = detRows a b c := by
  simp [detRows_eq] <;> ring

theorem rowB_comm (u v : R) : rowB u v = rowB v u := by
  simp [rowB, mul_comm, add_comm]

theorem dotProduct_rowA_rowA (x y : R) :
    dotProduct (rowA x) (rowA y) = 1 + x * y + x ^ 2 * y ^ 2 := by
  simp [rowA, Matrix.vec3_dotProduct] <;> ring

theorem dotProduct_rowA_rowB (x u v : R) :
    dotProduct (rowA x) (rowB u v) = (x - u) * (x - v) := by
  simp [rowA, rowB, Matrix.vec3_dotProduct] <;> ring

theorem dotProduct_rowB_rowB (u v r s : R) :
    dotProduct (rowB u v) (rowB r s) =
      u * v * r * s + (u + v) * (r + s) + 1 := by
  simp [rowB, Matrix.vec3_dotProduct] <;> ring

theorem detRows_AAA (x y z : R) :
    detRows (rowA x) (rowA y) (rowA z) =
      (y - x) * (z - x) * (z - y) := by
  simp [detRows_eq, rowA] <;> ring

theorem detRows_AAB (x y u v : R) :
    detRows (rowA x) (rowA y) (rowB u v) =
      (y - x) * (1 + (x + y) * (u + v) + x * y * u * v) := by
  simp [detRows_eq, rowA, rowB] <;> ring

theorem detRows_ABB (x u v r s : R) :
    detRows (rowA x) (rowB u v) (rowB r s) =
      (r + s - u - v) + x * (r * s - u * v) +
        x ^ 2 * ((u + v) * r * s - u * v * (r + s)) := by
  simp [detRows_eq, rowA, rowB] <;> ring

theorem detRows_BBB_shared (u v w r s : R) :
    detRows (rowB u v) (rowB v w) (rowB r s) =
      (w - u) * (v - r) * (v - s) := by
  simp [detRows_eq, rowB] <;> ring

/-- A sparse assignment for two distinct two-point edge rows. -/
theorem detRows_ABB_zero_one (x : R) :
    detRows (rowA x) (rowB 0 0) (rowB 0 1) = 1 := by
  simp [detRows_ABB]

/-- The six endpoints of disjoint edges can receive these three pairs. -/
theorem detRows_BBB_zero_one :
    detRows (rowB (0 : R) 0) (rowB 0 1) (rowB 1 1) = 1 := by
  simp [detRows_BBB_shared]

section PolynomialNonvanishing

variable {σ : Type*} [IsDomain R]

theorem detRows_AAA_X_ne_zero (a b c : σ)
    (hab : a ≠ b) (hac : a ≠ c) (hbc : b ≠ c) :
    detRows (rowA (MvPolynomial.X a : MvPolynomial σ R))
      (rowA (MvPolynomial.X b)) (rowA (MvPolynomial.X c)) ≠ 0 := by
  rw [detRows_AAA]
  apply mul_ne_zero
  · apply mul_ne_zero
    · exact sub_ne_zero.mpr (fun h => hab (MvPolynomial.X_injective h).symm)
    · exact sub_ne_zero.mpr (fun h => hac (MvPolynomial.X_injective h).symm)
  · exact sub_ne_zero.mpr (fun h => hbc (MvPolynomial.X_injective h).symm)

/-- The second factor has constant coefficient one even when indices overlap. -/
theorem detRows_AAB_X_ne_zero (a b u v : σ) (hab : a ≠ b) :
    detRows (rowA (MvPolynomial.X a : MvPolynomial σ R))
      (rowA (MvPolynomial.X b))
      (rowB (MvPolynomial.X u) (MvPolynomial.X v)) ≠ 0 := by
  rw [detRows_AAB]
  apply mul_ne_zero
  · exact sub_ne_zero.mpr (fun h => hab (MvPolynomial.X_injective h).symm)
  · intro h
    have hc := congrArg
      (MvPolynomial.constantCoeff : MvPolynomial σ R → R) h
    simpa using hc

theorem detRows_BBB_shared_X_ne_zero (u v w r s : σ)
    (hwu : w ≠ u) (hvr : v ≠ r) (hvs : v ≠ s) :
    detRows (rowB (MvPolynomial.X u : MvPolynomial σ R) (MvPolynomial.X v))
      (rowB (MvPolynomial.X v) (MvPolynomial.X w))
      (rowB (MvPolynomial.X r) (MvPolynomial.X s)) ≠ 0 := by
  rw [detRows_BBB_shared]
  apply mul_ne_zero
  · apply mul_ne_zero
    · exact sub_ne_zero.mpr (fun h => hwu (MvPolynomial.X_injective h))
    · exact sub_ne_zero.mpr (fun h => hvr (MvPolynomial.X_injective h))
  · exact sub_ne_zero.mpr (fun h => hvs (MvPolynomial.X_injective h))

end PolynomialNonvanishing

end P14MomentCyclePolynomial

end

section

/-! Incidence of the modular cycle edges (b - 1, b).
These are the endpoint hypotheses for a generic three-edge determinant lemma.
The cycle size is at least three; no parity or polynomial assumption is used.
No Nat-to-Fin coercion scope is enabled. -/

namespace P14MomentCycleIncidence

variable {n : ℕ} [NeZero n]

theorem one_ne_zero (hn : 2 ≤ n) : (1 : Fin n) ≠ 0 := by
  intro h
  have hv := congrArg Fin.val h
  change 1 % n = 0 at hv
  have hmod : 1 % n = 1 := Nat.mod_eq_of_lt (by omega)
  omega

theorem one_add_one_ne_zero (hn : 3 ≤ n) : (1 : Fin n) + 1 ≠ 0 := by
  have hval : (1 : Fin n).val = 1 := by
    rw [Fin.val_one', Nat.mod_eq_of_lt (by omega)]
  intro h
  have hv := congrArg Fin.val h
  rw [Fin.val_add, hval, Fin.val_zero, Nat.mod_eq_of_lt (by omega)] at hv
  omega

theorem edge_endpoints_ne (hn : 3 ≤ n) (b : Fin n) : b - 1 ≠ b := by
  intro h
  exact one_ne_zero (n := n) (by omega) (sub_eq_self.mp h)

theorem edge_reverse_impossible (hn : 3 ≤ n) (b c : Fin n) :
    ¬ (b - 1 = c ∧ b = c - 1) := by
  rintro ⟨hbc, hcb⟩
  have hb : b = c + 1 := sub_eq_iff_eq_add.mp hbc
  have hc : b + 1 = c := eq_sub_iff_add_eq.mp hcb
  have hEq : b + ((1 : Fin n) + 1) = b + 0 := by
    calc
      b + ((1 : Fin n) + 1) = (b + 1) + 1 := (add_assoc b 1 1).symm
      _ = c + 1 := congrArg (fun x : Fin n => x + 1) hc
      _ = b := hb.symm
      _ = b + 0 := (add_zero b).symm
  exact one_add_one_ne_zero hn (add_left_cancel hEq)

theorem edge_endpoints_eq_iff (hn : 3 ≤ n) (b c : Fin n) :
    ((b - 1 = c - 1 ∧ b = c) ∨ (b - 1 = c ∧ b = c - 1)) ↔ b = c := by
  constructor
  · rintro (h | h)
    · exact h.2
    · exact False.elim (edge_reverse_impossible hn b c h)
  · intro h
    subst c
    exact Or.inl ⟨rfl, rfl⟩

theorem different_edge_endpoints (hn : 3 ≤ n) (b c : Fin n) (hbc : b ≠ c) :
    ¬ ((b - 1 = c - 1 ∧ b = c) ∨ (b - 1 = c ∧ b = c - 1)) := by
  intro h
  exact hbc ((edge_endpoints_eq_iff hn b c).mp h)

theorem incidence_orientation (a b : Fin n) :
    (b = a ∨ b = a + 1) ↔ (a = b ∨ a = b - 1) := by
  constructor
  · rintro (h | h)
    · exact Or.inl h.symm
    · exact Or.inr (eq_sub_iff_add_eq.mpr h.symm)
  · rintro (h | h)
    · exact Or.inl h.symm
    · exact Or.inr (eq_sub_iff_add_eq.mp h).symm

theorem incident_iff (a b : Fin n) :
    (a = b - 1 ∨ a = b) ↔ (b = a ∨ b = a + 1) := by
  rw [incidence_orientation, or_comm]

theorem not_three_incident (a b c e : Fin n)
    (hbc : b ≠ c) (hbe : b ≠ e) (hce : c ≠ e) :
    ¬ ((a = b - 1 ∨ a = b) ∧ (a = c - 1 ∨ a = c) ∧
      (a = e - 1 ∨ a = e)) := by
  rintro ⟨hb, hc, he⟩
  have hb' := (incident_iff a b).mp hb
  have hc' := (incident_iff a c).mp hc
  have he' := (incident_iff a e).mp he
  rcases hb' with hb' | hb' <;> rcases hc' with hc' | hc' <;>
    rcases he' with he' | he'
  · exact hbc (hb'.trans hc'.symm)
  · exact hbc (hb'.trans hc'.symm)
  · exact hbe (hb'.trans he'.symm)
  · exact hce (hc'.trans he'.symm)
  · exact hce (hc'.trans he'.symm)
  · exact hbe (hb'.trans he'.symm)
  · exact hbc (hb'.trans hc'.symm)
  · exact hbc (hb'.trans hc'.symm)

theorem selected_edges (hn : 3 ≤ n) (f : Fin 3 → Fin n)
    (hf : Function.Injective f) :
    (∀ i, f i - 1 ≠ f i) ∧
    (∀ i j, i ≠ j →
      ¬ ((f i - 1 = f j - 1 ∧ f i = f j) ∨
        (f i - 1 = f j ∧ f i = f j - 1))) ∧
    ¬ ∃ a, (a = f 0 - 1 ∨ a = f 0) ∧
      (a = f 1 - 1 ∨ a = f 1) ∧ (a = f 2 - 1 ∨ a = f 2) := by
  refine ⟨fun i => edge_endpoints_ne hn (f i), ?_, ?_⟩
  · intro i j hij
    exact different_edge_endpoints hn (f i) (f j) (fun h => hij (hf h))
  · rintro ⟨a, ha⟩
    apply not_three_incident a (f 0) (f 1) (f 2) _ _ _ ha
    · intro h
      exact (by decide : (0 : Fin 3) ≠ 1) (hf h)
    · intro h
      exact (by decide : (0 : Fin 3) ≠ 2) (hf h)
    · intro h
      exact (by decide : (1 : Fin 3) ≠ 2) (hf h)

end P14MomentCycleIncidence

end

section

/-! Two distinct nonloop edges admit a sparse parameter assignment that
keeps their coefficient rows independent with any moment-curve row. -/

namespace P14MomentCycleTwoEdges

open MvPolynomial P14MomentCyclePolynomial

theorem second_edge_has_outside_endpoint {σ : Type*} (u v r s : σ)
    (hrs : r ≠ s)
    (hdiff : ¬ ((u = r ∧ v = s) ∨ (u = s ∧ v = r))) :
    (r ≠ u ∧ r ≠ v) ∨ (s ≠ u ∧ s ≠ v) := by
  classical
  by_cases hru : r = u
  · right
    constructor
    · exact fun hsu => hrs (hru.trans hsu.symm)
    · exact fun hsv => hdiff (Or.inl ⟨hru.symm, hsv.symm⟩)
  by_cases hrv : r = v
  · right
    constructor
    · exact fun hsu => hdiff (Or.inr ⟨hsu.symm, hrv.symm⟩)
    · exact fun hsv => hrs (hrv.trans hsv.symm)
  exact Or.inl ⟨hru, hrv⟩

theorem detRows_ABB_X_ne_zero {σ : Type*} (a u v r s : σ)
    (hrs : r ≠ s)
    (hdiff : ¬ ((u = r ∧ v = s) ∨ (u = s ∧ v = r))) :
    detRows (rowA (X a : MvPolynomial σ ℝ))
      (rowB (X u) (X v)) (rowB (X r) (X s)) ≠ 0 := by
  classical
  rcases second_edge_has_outside_endpoint u v r s hrs hdiff with
    ⟨hru, hrv⟩ | ⟨hsu, hsv⟩
  · intro h
    rw [detRows_ABB] at h
    have he := congrArg (eval (fun i : σ => if i = r then (1 : ℝ) else 0)) h
    simp [Ne.symm hru, Ne.symm hrv, Ne.symm hrs] at he
  · intro h
    rw [detRows_ABB] at h
    have he := congrArg (eval (fun i : σ => if i = s then (1 : ℝ) else 0)) h
    simp [Ne.symm hsu, Ne.symm hsv, hrs] at he


end P14MomentCycleTwoEdges
end

section

/-! Three distinct nonloop unordered edges without a common vertex give a
nonzero determinant polynomial for their quadratic-coefficient rows.
No cyclic indexing, parameter choice, or general-position witness is assumed. -/

noncomputable section
namespace P14MomentCycleThreeEdges
open P14MomentCyclePolynomial MvPolynomial

theorem shared_edges_X_ne_zero {R σ : Type*} [CommRing R] [IsDomain R]
    (a b c d e f : σ)
    (hedge : ¬ ((a = c ∧ b = d) ∨ (a = d ∧ b = c)))
    (hshare : a = c ∨ a = d ∨ b = c ∨ b = d)
    (hthird : ∀ x, (x = a ∨ x = b) → (x = c ∨ x = d) →
      ¬ (x = e ∨ x = f)) :
    detRows (rowB (X a : MvPolynomial σ R) (X b))
      (rowB (X c) (X d)) (rowB (X e) (X f)) ≠ 0 := by
  rcases hshare with hac | had | hbc | hbd
  · subst c
    have hdb : d ≠ b := fun h => hedge (Or.inl ⟨rfl, h.symm⟩)
    have ht := hthird a (Or.inl rfl) (Or.inl rfl)
    rw [rowB_comm (X a : MvPolynomial σ R) (X b)]
    exact detRows_BBB_shared_X_ne_zero b a d e f hdb
      (fun h => ht (Or.inl h)) (fun h => ht (Or.inr h))
  · subst d
    have hcb : c ≠ b := fun h => hedge (Or.inr ⟨rfl, h.symm⟩)
    have ht := hthird a (Or.inl rfl) (Or.inr rfl)
    rw [rowB_comm (X a : MvPolynomial σ R) (X b),
      rowB_comm (X c : MvPolynomial σ R) (X a)]
    exact detRows_BBB_shared_X_ne_zero b a c e f hcb
      (fun h => ht (Or.inl h)) (fun h => ht (Or.inr h))
  · subst c
    have hda : d ≠ a := fun h => hedge (Or.inr ⟨h.symm, rfl⟩)
    have ht := hthird b (Or.inr rfl) (Or.inl rfl)
    exact detRows_BBB_shared_X_ne_zero a b d e f hda
      (fun h => ht (Or.inl h)) (fun h => ht (Or.inr h))
  · subst d
    have hca : c ≠ a := fun h => hedge (Or.inl ⟨h.symm, rfl⟩)
    have ht := hthird b (Or.inr rfl) (Or.inr rfl)
    rw [rowB_comm (X c : MvPolynomial σ R) (X b)]
    exact detRows_BBB_shared_X_ne_zero a b c e f hca
      (fun h => ht (Or.inl h)) (fun h => ht (Or.inr h))

theorem detRows_BBB_X_ne_zero {R σ : Type*} [CommRing R] [IsDomain R]
    (u v : Fin 3 → σ) (hne : ∀ i, u i ≠ v i)
    (hedge : ∀ i j, i ≠ j →
      ¬ ((u i = u j ∧ v i = v j) ∨ (u i = v j ∧ v i = u j)))
    (hcommon : ¬ ∃ a, (a = u 0 ∨ a = v 0) ∧
      (a = u 1 ∨ a = v 1) ∧ (a = u 2 ∨ a = v 2)) :
    detRows (rowB (X (u 0) : MvPolynomial σ R) (X (v 0)))
      (rowB (X (u 1)) (X (v 1))) (rowB (X (u 2)) (X (v 2))) ≠ 0 := by
  classical
  by_cases h01 : u 0 = u 1 ∨ u 0 = v 1 ∨ v 0 = u 1 ∨ v 0 = v 1
  · apply shared_edges_X_ne_zero (u 0) (v 0) (u 1) (v 1) (u 2) (v 2)
      (hedge 0 1 (by decide)) h01
    intro a ha hb hc
    exact hcommon ⟨a, ha, hb, hc⟩
  by_cases h12 : u 1 = u 2 ∨ u 1 = v 2 ∨ v 1 = u 2 ∨ v 1 = v 2
  · rw [← detRows_rotate]
    apply shared_edges_X_ne_zero (u 1) (v 1) (u 2) (v 2) (u 0) (v 0)
      (hedge 1 2 (by decide)) h12
    intro a ha hb hc
    exact hcommon ⟨a, hc, ha, hb⟩
  by_cases h20 : u 2 = u 0 ∨ u 2 = v 0 ∨ v 2 = u 0 ∨ v 2 = v 0
  · rw [← detRows_rotate, ← detRows_rotate]
    apply shared_edges_X_ne_zero (u 2) (v 2) (u 0) (v 0) (u 1) (v 1)
      (hedge 2 0 (by decide)) h20
    intro a ha hb hc
    exact hcommon ⟨a, hb, hc, ha⟩
  simp only [not_or] at h01 h12 h20
  let z : σ → R := fun a => if a = u 0 ∨ a = v 0 ∨ a = u 1 then 0 else 1
  have hu0 : z (u 0) = 0 := if_pos (Or.inl rfl)
  have hv0 : z (v 0) = 0 := if_pos (Or.inr (Or.inl rfl))
  have hu1 : z (u 1) = 0 := if_pos (Or.inr (Or.inr rfl))
  have hv1 : z (v 1) = 1 := by
    apply if_neg
    rintro (h | h | h)
    · exact h01.2.1 h.symm
    · exact h01.2.2.2 h.symm
    · exact hne 1 h.symm
  have hu2 : z (u 2) = 1 := by
    apply if_neg
    rintro (h | h | h)
    · exact h20.1 h
    · exact h20.2.1 h
    · exact h12.1 h.symm
  have hv2 : z (v 2) = 1 := by
    apply if_neg
    rintro (h | h | h)
    · exact h20.2.2.1 h
    · exact h20.2.2.2 h
    · exact h12.2.1 h.symm
  intro hzero
  have heval := congrArg (MvPolynomial.eval z) hzero
  simpa [detRows_eq, rowB, hu0, hv0, hu1, hv1, hu2, hv2]
    using heval

end P14MomentCycleThreeEdges

end
end

section

/-! Every injective triple of the actual modular moment-cycle polynomial
family has nonzero determinant. The same variables X a occur in both halves.
This is a polynomial statement; a common real specialization is separate. -/

noncomputable section
namespace P14MomentCycleAllTriples

open MvPolynomial P14MomentCyclePolynomial

variable {n : ℕ} [NeZero n]

def polynomialFamily : (Fin n ⊕ Fin n) → Fin 3 → MvPolynomial (Fin n) ℝ
  | .inl a => rowA (X a)
  | .inr b => rowB (X (b - 1)) (X b)

@[simp] theorem polynomialFamily_inl (a : Fin n) :
    polynomialFamily (Sum.inl a : Fin n ⊕ Fin n) = rowA (X a) := rfl

@[simp] theorem polynomialFamily_inr (b : Fin n) :
    polynomialFamily (Sum.inr b : Fin n ⊕ Fin n) = rowB (X (b - 1)) (X b) := rfl

theorem three_distinct_det_ne_zero (hn : 3 ≤ n)
    (u v w : Fin n ⊕ Fin n) (huv : u ≠ v) (huw : u ≠ w) (hvw : v ≠ w) :
    detRows (polynomialFamily u) (polynomialFamily v) (polynomialFamily w) ≠ 0 := by
  rcases u with a | a <;> rcases v with b | b <;> rcases w with c | c
  all_goals simp only [polynomialFamily]
  · exact detRows_AAA_X_ne_zero a b c
      (fun h => huv (congrArg Sum.inl h))
      (fun h => huw (congrArg Sum.inl h))
      (fun h => hvw (congrArg Sum.inl h))
  · exact detRows_AAB_X_ne_zero a b (c - 1) c
      (fun h => huv (congrArg Sum.inl h))
  · rw [detRows_swap_last, neg_ne_zero]
    exact detRows_AAB_X_ne_zero a c (b - 1) b
      (fun h => huw (congrArg Sum.inl h))
  · exact P14MomentCycleTwoEdges.detRows_ABB_X_ne_zero a (b - 1) b (c - 1) c
      (P14MomentCycleIncidence.edge_endpoints_ne hn c)
      (P14MomentCycleIncidence.different_edge_endpoints hn b c
        (fun h => hvw (congrArg Sum.inr h)))
  · rw [← detRows_rotate]
    exact detRows_AAB_X_ne_zero b c (a - 1) a
      (fun h => hvw (congrArg Sum.inl h))
  · rw [detRows_swap_first, neg_ne_zero]
    exact P14MomentCycleTwoEdges.detRows_ABB_X_ne_zero b (a - 1) a (c - 1) c
      (P14MomentCycleIncidence.edge_endpoints_ne hn c)
      (P14MomentCycleIncidence.different_edge_endpoints hn a c
        (fun h => huw (congrArg Sum.inr h)))
  · rw [detRows_rotate]
    exact P14MomentCycleTwoEdges.detRows_ABB_X_ne_zero c (a - 1) a (b - 1) b
      (P14MomentCycleIncidence.edge_endpoints_ne hn b)
      (P14MomentCycleIncidence.different_edge_endpoints hn a b
        (fun h => huv (congrArg Sum.inr h)))
  · have hab : a ≠ b := fun h => huv (congrArg Sum.inr h)
    have hac : a ≠ c := fun h => huw (congrArg Sum.inr h)
    have hbc : b ≠ c := fun h => hvw (congrArg Sum.inr h)
    have hf : Function.Injective ![a, b, c] := by
      intro i j hij
      fin_cases i <;> fin_cases j <;> simp_all
    obtain ⟨hne, hedge, hcommon⟩ :=
      P14MomentCycleIncidence.selected_edges hn ![a, b, c] hf
    exact P14MomentCycleThreeEdges.detRows_BBB_X_ne_zero (R := ℝ)
      (fun i => ![a, b, c] i - 1) ![a, b, c] hne hedge hcommon

theorem all_triples_det_ne_zero (hn : 3 ≤ n)
    (f : Fin 3 → Fin n ⊕ Fin n) (hf : Function.Injective f) :
    Matrix.det (fun i => polynomialFamily (f i)) ≠ 0 := by
  have hRows : (fun i : Fin 3 => polynomialFamily (f i)) =
      ![polynomialFamily (f 0), polynomialFamily (f 1), polynomialFamily (f 2)] := by
    funext i
    fin_cases i <;> rfl
  rw [hRows]
  exact three_distinct_det_ne_zero hn (f 0) (f 1) (f 2)
    (fun h => (by decide : (0 : Fin 3) ≠ 1) (hf h))
    (fun h => (by decide : (0 : Fin 3) ≠ 2) (hf h))
    (fun h => (by decide : (1 : Fin 3) ≠ 2) (hf h))

end P14MomentCycleAllTriples

end
end

section

/-!
Explicit coordinate form of the Cayley numerator identities. The local
cross definition avoids requiring the separate CrossProduct library.
The denominator is positive for every real parameter, and each constraint
between two nonzero real vectors has an explicit nonzero witness.
-/

namespace P14CayleyRotationCoordinates

open Matrix

section Algebra

variable {R : Type*} [CommRing R]

def cross (u v : Fin 3 → R) : Fin 3 → R :=
  ![u 1 * v 2 - u 2 * v 1,
    u 2 * v 0 - u 0 * v 2,
    u 0 * v 1 - u 1 * v 0]

def denominator (x : Fin 3 → R) : R := 1 + dotProduct x x

def numerator (x v : Fin 3 → R) : Fin 3 → R := fun i =>
  (1 - dotProduct x x) * v i +
    2 * dotProduct x v * x i + 2 * cross x v i

theorem dot_numerator (a x b : Fin 3 → R) :
    dotProduct a (numerator x b) =
      (1 - dotProduct x x) * dotProduct a b +
        2 * dotProduct x b * dotProduct a x +
        2 * dotProduct a (cross x b) := by
  simp [numerator, Matrix.vec3_dotProduct, cross, Matrix.vecHead, Matrix.vecTail] <;> ring

theorem dot_numerator_numerator (x u v : Fin 3 → R) :
    dotProduct (numerator x u) (numerator x v) =
      denominator x ^ 2 * dotProduct u v := by
  simp [numerator, denominator, Matrix.vec3_dotProduct, cross] <;> ring

theorem cross_numerator_numerator (x u v : Fin 3 → R) :
    cross (numerator x u) (numerator x v) =
      fun i => denominator x * numerator x (cross u v) i := by
  funext i
  fin_cases i <;>
    simp [numerator, denominator, Matrix.vec3_dotProduct, cross,
      Matrix.vecHead, Matrix.vecTail] <;> ring

theorem numerator_zero (v : Fin 3 → R) : numerator 0 v = v := by
  funext i
  fin_cases i <;> simp [numerator, Matrix.vec3_dotProduct, cross]

theorem dot_numerator_cross_witness (a b : Fin 3 → R)
    (hab : dotProduct a b = 0) :
    dotProduct a (numerator (cross b a) b) =
      2 * dotProduct a a * dotProduct b b := by
  have h : dotProduct a (numerator (cross b a) b) =
      (1 - dotProduct (cross b a) (cross b a)) * dotProduct a b +
        2 * (dotProduct a a * dotProduct b b - dotProduct a b ^ 2) := by
    simp [numerator, Matrix.vec3_dotProduct, cross] <;> ring
  rw [h, hab]
  ring

end Algebra

theorem denominator_pos (x : Fin 3 → ℝ) : 0 < denominator x := by
  unfold denominator
  rw [Matrix.vec3_dotProduct]
  nlinarith [sq_nonneg (x 0), sq_nonneg (x 1), sq_nonneg (x 2)]

theorem dot_self_pos (v : Fin 3 → ℝ) (hv : v ≠ 0) : 0 < dotProduct v v := by
  by_contra hpos
  have hle : v 0 * v 0 + v 1 * v 1 + v 2 * v 2 ≤ 0 := by
    simpa only [Matrix.vec3_dotProduct] using le_of_not_gt hpos
  have h0sq : (v 0) ^ 2 = 0 := by
    nlinarith [sq_nonneg (v 0), sq_nonneg (v 1), sq_nonneg (v 2)]
  have h1sq : (v 1) ^ 2 = 0 := by
    nlinarith [sq_nonneg (v 0), sq_nonneg (v 1), sq_nonneg (v 2)]
  have h2sq : (v 2) ^ 2 = 0 := by
    nlinarith [sq_nonneg (v 0), sq_nonneg (v 1), sq_nonneg (v 2)]
  have h0 : v 0 = 0 := sq_eq_zero_iff.mp h0sq
  have h1 : v 1 = 0 := sq_eq_zero_iff.mp h1sq
  have h2 : v 2 = 0 := sq_eq_zero_iff.mp h2sq
  apply hv
  funext i
  fin_cases i
  · change v 0 = 0
    exact h0
  · change v 1 = 0
    exact h1
  · change v 2 = 0
    exact h2

theorem exists_dot_numerator_ne_zero (a b : Fin 3 → ℝ)
    (ha : a ≠ 0) (hb : b ≠ 0) :
    ∃ x : Fin 3 → ℝ, dotProduct a (numerator x b) ≠ 0 := by
  by_cases hab : dotProduct a b = 0
  · refine ⟨cross b a, ?_⟩
    rw [dot_numerator_cross_witness a b hab]
    exact mul_ne_zero
      (mul_ne_zero two_ne_zero (ne_of_gt (dot_self_pos a ha)))
      (ne_of_gt (dot_self_pos b hb))
  · refine ⟨0, ?_⟩
    simpa only [numerator_zero] using hab

end P14CayleyRotationCoordinates

end

section

/-! Literal three-row determinant identities for the existing Cayley numerator.
No division or genericity assumption is used. -/

namespace P14CayleyTripleDeterminant

open Matrix P14CayleyRotationCoordinates

section Algebra

variable {R : Type*} [CommRing R]

theorem det_rows_eq_dot_cross (a b c : Fin 3 → R) :
    Matrix.det ![a, b, c] = dotProduct a (cross b c) := by
  have hd : Matrix.det ![a, b, c] =
      a 0 * b 1 * c 2 - a 0 * b 2 * c 1 -
        a 1 * b 0 * c 2 + a 1 * b 2 * c 0 +
        a 2 * b 0 * c 1 - a 2 * b 1 * c 0 :=
    Matrix.det_fin_three (Matrix.of ![a, b, c])
  rw [hd]
  simp [Matrix.vec3_dotProduct, cross, Matrix.vecHead, Matrix.vecTail] <;> ring

theorem det_rows_eq_cross_dot (a b c : Fin 3 → R) :
    Matrix.det ![a, b, c] = dotProduct (cross a b) c := by
  rw [det_rows_eq_dot_cross]
  simp [Matrix.vec3_dotProduct, cross, Matrix.vecHead, Matrix.vecTail] <;> ring

theorem det_rows_rotate (a b c : Fin 3 → R) :
    Matrix.det ![b, c, a] = Matrix.det ![a, b, c] := by
  rw [det_rows_eq_cross_dot, det_rows_eq_dot_cross, dotProduct_comm]

theorem det_rows_AAB (x a b c : Fin 3 → R) :
    Matrix.det ![a, b, numerator x c] =
      dotProduct (cross a b) (numerator x c) :=
  det_rows_eq_cross_dot a b (numerator x c)

theorem det_rows_ABB (x a b c : Fin 3 → R) :
    Matrix.det ![a, numerator x b, numerator x c] =
      denominator x * dotProduct a (numerator x (cross b c)) := by
  rw [det_rows_eq_dot_cross, cross_numerator_numerator]
  simp only [Matrix.vec3_dotProduct]
  ring

theorem det_rows_BBB (x a b c : Fin 3 → R) :
    Matrix.det ![numerator x a, numerator x b, numerator x c] =
      denominator x ^ 3 * Matrix.det ![a, b, c] := by
  rw [det_rows_ABB, dot_numerator_numerator, det_rows_eq_dot_cross]
  ring

end Algebra

theorem numerator_ne_zero (x v : Fin 3 → ℝ) (hv : v ≠ 0) :
    numerator x v ≠ 0 := by
  intro hz
  apply mul_ne_zero (pow_ne_zero 2 (ne_of_gt (denominator_pos x)))
    (ne_of_gt (dot_self_pos v hv))
  calc
    denominator x ^ 2 * dotProduct v v =
        dotProduct (numerator x v) (numerator x v) :=
      (dot_numerator_numerator x v v).symm
    _ = 0 := by rw [hz]; simp [dotProduct]

end P14CayleyTripleDeterminant

end

section

/-! Actual real moment-cycle rows with simultaneous triple determinants and
nonzero pair crosses. Prescribed cycle dot products vanish for every parameter. -/

noncomputable section
namespace P14MomentCycleRealGeneralPosition

open MvPolynomial Matrix P14MomentCyclePolynomial P14MomentCycleAllTriples
open P14CayleyRotationCoordinates P14CayleyTripleDeterminant

variable {n : ℕ} [NeZero n]

def realFamily (z : Fin n → ℝ) (v : Fin n ⊕ Fin n) : Fin 3 → ℝ :=
  fun j => eval z (polynomialFamily v j)

theorem realFamily_inl (z : Fin n → ℝ) (a : Fin n) :
    realFamily z (Sum.inl a : Fin n ⊕ Fin n) = rowA (z a) := by
  funext j
  fin_cases j <;> simp [realFamily, polynomialFamily, rowA]

theorem realFamily_inr (z : Fin n → ℝ) (b : Fin n) :
    realFamily z (Sum.inr b : Fin n ⊕ Fin n) = rowB (z (b - 1)) (z b) := by
  funext j
  fin_cases j <;> simp [realFamily, polynomialFamily, rowB]

theorem realFamily_ne_zero (z : Fin n → ℝ) (v : Fin n ⊕ Fin n) :
    realFamily z v ≠ 0 := by
  rcases v with a | b
  · rw [realFamily_inl]
    intro h
    have h0 := congrFun h 0
    simpa [rowA] using h0
  · rw [realFamily_inr]
    intro h
    have h2 := congrFun h 2
    simpa [rowB] using h2

theorem dot_realFamily_inl_inr (z : Fin n → ℝ) (a b : Fin n) :
    dotProduct (realFamily z (Sum.inl a)) (realFamily z (Sum.inr b)) =
      (z a - z (b - 1)) * (z a - z b) := by
  rw [realFamily_inl, realFamily_inr, dotProduct_rowA_rowB]

theorem dot_realFamily_incident (z : Fin n → ℝ) (a b : Fin n)
    (hab : b = a ∨ b = a + 1) :
    dotProduct (realFamily z (Sum.inl a)) (realFamily z (Sum.inr b)) = 0 := by
  rw [dot_realFamily_inl_inr]
  rcases (P14MomentCycleIncidence.incident_iff a b).mpr hab with h | h <;> simp [h]

theorem dot_realFamily_incident_reverse (z : Fin n → ℝ) (a b : Fin n)
    (hab : b = a ∨ b = a + 1) :
    dotProduct (realFamily z (Sum.inr b)) (realFamily z (Sum.inl a)) = 0 := by
  rw [dotProduct_comm]
  exact dot_realFamily_incident z a b hab

theorem exists_real_general_position (hn : 3 ≤ n) :
    ∃ z : Fin n → ℝ,
      (∀ v : Fin n ⊕ Fin n, realFamily z v ≠ 0) ∧
      (∀ u v : Fin n ⊕ Fin n, u ≠ v →
        cross (realFamily z u) (realFamily z v) ≠ 0) ∧
      (∀ p : Fin 3 → Fin n ⊕ Fin n, Function.Injective p →
        Matrix.det (fun i => realFamily z (p i)) ≠ 0) := by
  classical
  let T := {p : Fin 3 → Fin n ⊕ Fin n // Function.Injective p}
  obtain ⟨z, hz⟩ := P14PolynomialThreeRows.exists_common_nonzero
    (fun p : T => Matrix.det (fun i => polynomialFamily (p.val i)))
    (fun p => all_triples_det_ne_zero hn p.val p.property)
  have hdet : ∀ p : Fin 3 → Fin n ⊕ Fin n, Function.Injective p →
      Matrix.det (fun i => realFamily z (p i)) ≠ 0 := by
    intro p hp
    have hmap := (eval z).map_det
      (Matrix.of (fun i : Fin 3 => polynomialFamily (p i)))
    change (eval z) (Matrix.det (fun i => polynomialFamily (p i))) =
      Matrix.det (fun i => realFamily z (p i)) at hmap
    intro hzero
    exact hz ⟨p, hp⟩ (hmap.trans hzero)
  refine ⟨z, realFamily_ne_zero z, ?_, hdet⟩
  intro u v huv
  let label : (Fin n ⊕ Fin n) → Fin n := Sum.elim id id
  obtain ⟨k, hku, hkv⟩ :=
    Fin.exists_ne_and_ne_of_two_lt (label u) (label v) (by omega)
  let w : Fin n ⊕ Fin n := Sum.inl k
  have huw : u ≠ w := by
    intro h
    exact hku (congrArg label h).symm
  have hvw : v ≠ w := by
    intro h
    exact hkv (congrArg label h).symm
  have hp : Function.Injective ![u, v, w] := by
    intro i j hij
    fin_cases i <;> fin_cases j <;> simp_all
  have hrows : (fun i : Fin 3 => realFamily z (![u, v, w] i)) =
      ![realFamily z u, realFamily z v, realFamily z w] := by
    funext i
    fin_cases i <;> rfl
  have hd := hdet ![u, v, w] hp
  rw [hrows] at hd
  intro hc
  apply hd
  rw [det_rows_eq_cross_dot, hc]
  simp [dotProduct]

end P14MomentCycleRealGeneralPosition

end
end

section

/-! One real Cayley numerator parameter simultaneously avoids every constraint
in an arbitrary finite family of pairs of nonzero real three-vectors. -/

noncomputable section
namespace P14CayleyFiniteAvoidance
open MvPolynomial Matrix P14CayleyRotationCoordinates
open scoped BigOperators

def constraint (a b : Fin 3 → ℝ) : MvPolynomial (Fin 3) ℝ :=
  dotProduct (fun j => C (a j)) (numerator X (fun j => C (b j)))

theorem eval_constraint (a b x : Fin 3 → ℝ) :
    eval x (constraint a b) = dotProduct a (numerator x b) := by
  simp [constraint, numerator, cross, dotProduct, Fin.sum_univ_succ]

theorem constraint_ne_zero (a b : Fin 3 → ℝ) (ha : a ≠ 0) (hb : b ≠ 0) :
    constraint a b ≠ 0 := by
  obtain ⟨x, hx⟩ := exists_dot_numerator_ne_zero a b ha hb
  intro h
  apply hx
  rw [← eval_constraint, h, map_zero]

theorem exists_common_parameter {T : Type*} [Fintype T]
    (a b : T → Fin 3 → ℝ) (ha : ∀ t, a t ≠ 0) (hb : ∀ t, b t ≠ 0) :
    ∃ x : Fin 3 → ℝ, 0 < denominator x ∧
      ∀ t, dotProduct (a t) (numerator x (b t)) ≠ 0 := by
  obtain ⟨x, hx⟩ := P14PolynomialThreeRows.exists_common_nonzero
    (fun t => constraint (a t) (b t))
    (fun t => constraint_ne_zero (a t) (b t) (ha t) (hb t))
  refine ⟨x, denominator_pos x, ?_⟩
  intro t
  simpa only [eval_constraint] using hx t

end P14CayleyFiniteAvoidance

end
end

section

/-! One common Cayley numerator combines two finite real three-row families.
Only within-family row, pair-cross and triple nonvanishing are assumed. -/

noncomputable section
namespace P14CayleyTwoFamilies

open Matrix P14CayleyRotationCoordinates P14CayleyTripleDeterminant

def combined {ι κ : Type*} (x : Fin 3 → ℝ)
    (f : ι → Fin 3 → ℝ) (g : κ → Fin 3 → ℝ) : (ι ⊕ κ) → Fin 3 → ℝ
  | .inl i => f i
  | .inr j => numerator x (g j)

private theorem distinct_det_of_injective {ι : Type*} (f : ι → Fin 3 → ℝ)
    (hf : ∀ p : Fin 3 → ι, Function.Injective p →
      Matrix.det (fun i => f (p i)) ≠ 0)
    (i j k : ι) (hij : i ≠ j) (hik : i ≠ k) (hjk : j ≠ k) :
    Matrix.det ![f i, f j, f k] ≠ 0 := by
  have hp : Function.Injective ![i, j, k] := by
    intro a b hab
    fin_cases a <;> fin_cases b <;> simp_all
  have hrows : (fun a : Fin 3 => f (![i, j, k] a)) = ![f i, f j, f k] := by
    funext a
    fin_cases a <;> rfl
  have hd := hf ![i, j, k] hp
  rwa [hrows] at hd

theorem exists_combined {ι κ : Type*} [Fintype ι] [Fintype κ]
    (f : ι → Fin 3 → ℝ) (g : κ → Fin 3 → ℝ)
    (hf0 : ∀ i, f i ≠ 0) (hg0 : ∀ j, g j ≠ 0)
    (hf2 : ∀ i j, i ≠ j → cross (f i) (f j) ≠ 0)
    (hg2 : ∀ i j, i ≠ j → cross (g i) (g j) ≠ 0)
    (hf3 : ∀ p : Fin 3 → ι, Function.Injective p →
      Matrix.det (fun i => f (p i)) ≠ 0)
    (hg3 : ∀ p : Fin 3 → κ, Function.Injective p →
      Matrix.det (fun i => g (p i)) ≠ 0) :
    ∃ x : Fin 3 → ℝ, 0 < denominator x ∧
      (∀ u, combined x f g u ≠ 0) ∧
      (∀ p : Fin 3 → ι ⊕ κ, Function.Injective p →
        Matrix.det (fun i => combined x f g (p i)) ≠ 0) ∧
      (∀ i j, dotProduct (combined x f g (.inl i)) (combined x f g (.inl j)) =
        dotProduct (f i) (f j)) ∧
      (∀ i j, dotProduct (combined x f g (.inr i)) (combined x f g (.inr j)) =
        denominator x ^ 2 * dotProduct (g i) (g j)) := by
  classical
  let AAB := {p : ι × ι // p.1 ≠ p.2} × κ
  let ABB := ι × {p : κ × κ // p.1 ≠ p.2}
  let a : AAB ⊕ ABB → Fin 3 → ℝ
    | .inl t => cross (f t.1.val.1) (f t.1.val.2)
    | .inr t => f t.1
  let b : AAB ⊕ ABB → Fin 3 → ℝ
    | .inl t => g t.2
    | .inr t => cross (g t.2.val.1) (g t.2.val.2)
  have ha : ∀ t, a t ≠ 0 := by
    intro t
    rcases t with t | t
    · exact hf2 _ _ t.1.property
    · exact hf0 t.1
  have hb : ∀ t, b t ≠ 0 := by
    intro t
    rcases t with t | t
    · exact hg0 t.2
    · exact hg2 _ _ t.2.property
  obtain ⟨x, hq, hx⟩ :=
    P14CayleyFiniteAvoidance.exists_common_parameter a b ha hb
  have hAAB (i j : ι) (k : κ) (hij : i ≠ j) :
      Matrix.det ![f i, f j, numerator x (g k)] ≠ 0 := by
    rw [det_rows_AAB]
    exact hx (.inl (⟨(i, j), hij⟩, k))
  have hABB (i : ι) (j k : κ) (hjk : j ≠ k) :
      Matrix.det ![f i, numerator x (g j), numerator x (g k)] ≠ 0 := by
    rw [det_rows_ABB]
    exact mul_ne_zero (ne_of_gt hq) (hx (.inr (i, ⟨(j, k), hjk⟩)))
  have hdistinct (u v w : ι ⊕ κ) (huv : u ≠ v) (huw : u ≠ w) (hvw : v ≠ w) :
      Matrix.det ![combined x f g u, combined x f g v, combined x f g w] ≠ 0 := by
    rcases u with i | i <;> rcases v with j | j <;> rcases w with k | k
    all_goals simp only [combined]
    · exact distinct_det_of_injective f hf3 i j k
        (fun h => huv (congrArg Sum.inl h))
        (fun h => huw (congrArg Sum.inl h))
        (fun h => hvw (congrArg Sum.inl h))
    · exact hAAB i j k (fun h => huv (congrArg Sum.inl h))
    · rw [det_rows_rotate]
      exact hAAB k i j (fun h => huw (congrArg Sum.inl h.symm))
    · exact hABB i j k (fun h => hvw (congrArg Sum.inr h))
    · rw [← det_rows_rotate]
      exact hAAB j k i (fun h => hvw (congrArg Sum.inl h))
    · rw [← det_rows_rotate]
      exact hABB j k i (fun h => huw (congrArg Sum.inr h.symm))
    · rw [det_rows_rotate]
      exact hABB k i j (fun h => huv (congrArg Sum.inr h))
    · rw [det_rows_BBB]
      exact mul_ne_zero (pow_ne_zero 3 (ne_of_gt hq))
        (distinct_det_of_injective g hg3 i j k
          (fun h => huv (congrArg Sum.inr h))
          (fun h => huw (congrArg Sum.inr h))
          (fun h => hvw (congrArg Sum.inr h)))
  refine ⟨x, hq, ?_, ?_, ?_, ?_⟩
  · intro u
    rcases u with i | j
    · exact hf0 i
    · exact numerator_ne_zero x (g j) (hg0 j)
  · intro p hp
    have hrows : (fun i : Fin 3 => combined x f g (p i)) =
        ![combined x f g (p 0), combined x f g (p 1), combined x f g (p 2)] := by
      funext i
      fin_cases i <;> rfl
    rw [hrows]
    exact hdistinct (p 0) (p 1) (p 2)
      (fun h => (by decide : (0 : Fin 3) ≠ 1) (hp h))
      (fun h => (by decide : (0 : Fin 3) ≠ 2) (hp h))
      (fun h => (by decide : (1 : Fin 3) ≠ 2) (hp h))
  · intro i j
    rfl
  · intro i j
    exact dot_numerator_numerator x (g i) (g j)

end P14CayleyTwoFamilies

end
end

section

/-! Direct transport of an actual real row family into complex coordinate space.
The witness is unchanged; no second generic specialization is chosen. -/

noncomputable section
namespace P14RealRowsComplexSpanning
open Matrix Submodule
open scoped BigOperators

def complexify {d : ℕ} (v : Fin d → ℝ) : Fin d → ℂ := fun j => (v j : ℂ)

theorem complexify_ne_zero {d : ℕ} (v : Fin d → ℝ) (hv : v ≠ 0) :
    complexify v ≠ 0 := by
  intro h
  apply hv
  funext j
  exact Complex.ofReal_eq_zero.mp (congrFun h j)

theorem complexify_pair {d : ℕ} (v w : Fin d → ℝ) :
    (∑ j, star (complexify v j) * complexify w j) = ((dotProduct v w : ℝ) : ℂ) := by
  change (∑ j, star (complexify v j) * complexify w j) =
    Complex.ofRealHom (∑ j, v j * w j)
  rw [map_sum]
  apply Finset.sum_congr rfl
  intro j _
  change star (v j : ℂ) * (w j : ℂ) = ((v j * w j : ℝ) : ℂ)
  simp [Complex.star_def, Complex.ofReal_mul]

theorem complexify_det_ne_zero {d : ℕ} (f : Matrix (Fin d) (Fin d) ℝ)
    (hf : f.det ≠ 0) : Matrix.det (fun i => complexify (f i)) ≠ 0 := by
  have hc : Complex.ofRealHom (Matrix.det f) ≠ 0 := Complex.ofReal_ne_zero.mpr hf
  rw [Complex.ofRealHom.map_det] at hc
  exact hc

theorem complexify_spanning {d : ℕ} {ι : Type*} (f : ι → Fin d → ℝ)
    (hf : ∀ p : Fin d → ι, Function.Injective p →
      Matrix.det (fun i => f (p i)) ≠ 0)
    (S : Finset ι) (hS : S.card = d) :
    span ℂ (Set.range (fun i : (S : Set ι) => complexify (f i.val))) = ⊤ := by
  classical
  let e : Fin d ≃ (S : Set ι) :=
    (Fintype.equivFinOfCardEq (by simpa using hS)).symm
  let p : Fin d → ι := fun i => (e i).val
  have hp : Function.Injective p := by
    intro i j hij
    exact e.injective (Subtype.ext hij)
  have hd := complexify_det_ne_zero (fun i => f (p i)) (hf p hp)
  have hs := P14PolynomialRowsSpanning.complex_spanning_of_det
    (fun i => complexify (f (p i))) hd
  have hr : Set.range (fun i : Fin d => complexify (f (p i))) =
      Set.range (fun i : (S : Set ι) => complexify (f i.val)) := by
    ext v
    constructor
    · rintro ⟨i, rfl⟩
      exact ⟨e i, rfl⟩
    · rintro ⟨i, rfl⟩
      obtain ⟨j, rfl⟩ := e.surjective i
      exact ⟨j, rfl⟩
  rwa [hr] at hs

end P14RealRowsComplexSpanning

end
end

section

/-! Two actual moment cycles in one complex qutrit coordinate space. One real
moment specialization and one relative Cayley parameter serve the entire family.
This does not yet identify physical circle rounds or assemble a global UPB. -/

noncomputable section
namespace P14TwoMomentCyclesQutrit
open Matrix Submodule
open P14MomentCycleRealGeneralPosition P14CayleyTwoFamilies
open P14CayleyRotationCoordinates P14RealRowsComplexSpanning
open scoped BigOperators

variable {n : ℕ} [NeZero n]

def halfIndex (second : Bool) (v : Fin n ⊕ Fin n) :
    (Fin n ⊕ Fin n) ⊕ (Fin n ⊕ Fin n) :=
  if second then Sum.inr v else Sum.inl v

def pairedFamily (z : Fin n → ℝ) (x : Fin 3 → ℝ)
    (i : (Fin n ⊕ Fin n) ⊕ (Fin n ⊕ Fin n)) : Fin 3 → ℂ :=
  complexify (combined x (realFamily z) (realFamily z) i)

theorem pair_incident (z : Fin n → ℝ) (x : Fin 3 → ℝ)
    (second : Bool) (a b : Fin n) (hab : b = a ∨ b = a + 1) :
    (∑ j, star (pairedFamily z x (halfIndex second (Sum.inl a)) j) *
      pairedFamily z x (halfIndex second (Sum.inr b)) j) = 0 := by
  change (∑ j, star (complexify (combined x (realFamily z) (realFamily z)
    (halfIndex second (Sum.inl a))) j) * complexify
    (combined x (realFamily z) (realFamily z) (halfIndex second (Sum.inr b))) j) = 0
  rw [complexify_pair]
  have hreal : dotProduct
      (combined x (realFamily z) (realFamily z) (halfIndex second (Sum.inl a)))
      (combined x (realFamily z) (realFamily z) (halfIndex second (Sum.inr b))) = 0 := by
    cases second with
    | false => exact dot_realFamily_incident z a b hab
    | true =>
      change dotProduct (numerator x (realFamily z (Sum.inl a)))
        (numerator x (realFamily z (Sum.inr b))) = 0
      rw [dot_numerator_numerator, dot_realFamily_incident z a b hab, mul_zero]
  rw [hreal, Complex.ofReal_zero]

theorem pair_incident_reverse (z : Fin n → ℝ) (x : Fin 3 → ℝ)
    (second : Bool) (a b : Fin n) (hab : b = a ∨ b = a + 1) :
    (∑ j, star (pairedFamily z x (halfIndex second (Sum.inr b)) j) *
      pairedFamily z x (halfIndex second (Sum.inl a)) j) = 0 := by
  change (∑ j, star (complexify (combined x (realFamily z) (realFamily z)
    (halfIndex second (Sum.inr b))) j) * complexify
    (combined x (realFamily z) (realFamily z) (halfIndex second (Sum.inl a))) j) = 0
  rw [complexify_pair]
  have hreal : dotProduct
      (combined x (realFamily z) (realFamily z) (halfIndex second (Sum.inr b)))
      (combined x (realFamily z) (realFamily z) (halfIndex second (Sum.inl a))) = 0 := by
    rw [dotProduct_comm]
    cases second with
    | false => exact dot_realFamily_incident z a b hab
    | true =>
      change dotProduct (numerator x (realFamily z (Sum.inl a)))
        (numerator x (realFamily z (Sum.inr b))) = 0
      rw [dot_numerator_numerator, dot_realFamily_incident z a b hab, mul_zero]
  rw [hreal, Complex.ofReal_zero]

theorem exists_paired_qutrit (hn : 3 ≤ n) :
    ∃ z : Fin n → ℝ, ∃ x : Fin 3 → ℝ,
      (∀ i : (Fin n ⊕ Fin n) ⊕ (Fin n ⊕ Fin n), pairedFamily z x i ≠ 0) ∧
      (∀ S : Finset ((Fin n ⊕ Fin n) ⊕ (Fin n ⊕ Fin n)), S.card = 3 →
        span ℂ (Set.range (fun i : (S : Set ((Fin n ⊕ Fin n) ⊕ (Fin n ⊕ Fin n))) =>
          pairedFamily z x i.val)) = ⊤) ∧
      (∀ second : Bool, ∀ a b : Fin n, b = a ∨ b = a + 1 →
        (∑ j, star (pairedFamily z x (halfIndex second (Sum.inl a)) j) *
          pairedFamily z x (halfIndex second (Sum.inr b)) j) = 0) ∧
      (∀ second : Bool, ∀ a b : Fin n, b = a ∨ b = a + 1 →
        (∑ j, star (pairedFamily z x (halfIndex second (Sum.inr b)) j) *
          pairedFamily z x (halfIndex second (Sum.inl a)) j) = 0) := by
  obtain ⟨z, h0, h2, h3⟩ := exists_real_general_position hn
  obtain ⟨x, _hq, hc0, hc3, _hl, _hr⟩ :=
    exists_combined (realFamily z) (realFamily z) h0 h0 h2 h2 h3 h3
  refine ⟨z, x, ?_, ?_, pair_incident z x, pair_incident_reverse z x⟩
  · intro i
    exact complexify_ne_zero _ (hc0 i)
  · intro S hS
    exact complexify_spanning _ hc3 S hS

end P14TwoMomentCyclesQutrit

end
end

section

/-! One actual qutrit for two physical circle halves. The same moment and
Cayley parameters serve both halves and all three-element selections.
The two required rounds are the literal centers c and c+1. -/

noncomputable section
namespace P14CirclePairedQutrit

open Submodule
open P14FourierHalfMatchings.Circle P14CircleConsecutiveCycle
open Fin.CommRing
open scoped BigOperators

/-- Apply the actual circle labeling separately to the two physical halves. -/
def pairedLabeling {r : ℕ} (c : Index r) :
    ((Step r ⊕ Step r) ⊕ (Step r ⊕ Step r)) ≃ (Half r ⊕ Half r) :=
  Equiv.sumCongr (labeling c) (labeling c)

def halfIndex {r : ℕ} (second : Bool) (v : Half r) : Half r ⊕ Half r :=
  if second then Sum.inr v else Sum.inl v

def circleFamily {r : ℕ} (c : Index r) (z : Step r → ℝ) (x : Fin 3 → ℝ)
    (i : Half r ⊕ Half r) : Fin 3 → ℂ :=
  P14TwoMomentCyclesQutrit.pairedFamily z x ((pairedLabeling c).symm i)

@[simp] theorem circleFamily_half_label {r : ℕ} (c : Index r)
    (z : Step r → ℝ) (x : Fin 3 → ℝ) (second : Bool) (v : Step r ⊕ Step r) :
    circleFamily c z x (halfIndex second (labeling c v)) =
      P14TwoMomentCyclesQutrit.pairedFamily z x
        (P14TwoMomentCyclesQutrit.halfIndex second v) := by
  cases second <;>
    simp [circleFamily, halfIndex, pairedLabeling, Equiv.sumCongr,
      P14TwoMomentCyclesQutrit.halfIndex]

theorem pair_round_center {r : ℕ} (c : Index r) (z : Step r → ℝ)
    (x : Fin 3 → ℝ) (second : Bool) (v : Half r) :
    (∑ j, star (circleFamily c z x (halfIndex second v) j) *
      circleFamily c z x (halfIndex second (halfRound c v)) j) = 0 := by
  obtain ⟨w, rfl⟩ := (labeling c).surjective v
  cases w with
  | inl a =>
      rw [(labeling_rounds c a).1]
      simpa only [circleFamily_half_label] using
        P14TwoMomentCyclesQutrit.pair_incident z x second a a (Or.inl rfl)
  | inr b =>
      rw [(labeling_rounds c b).2.1]
      simpa only [circleFamily_half_label] using
        P14TwoMomentCyclesQutrit.pair_incident_reverse z x second b b (Or.inl rfl)

theorem pair_round_next {r : ℕ} (c : Index r) (z : Step r → ℝ)
    (x : Fin 3 → ℝ) (second : Bool) (v : Half r) :
    (∑ j, star (circleFamily c z x (halfIndex second v) j) *
      circleFamily c z x (halfIndex second (halfRound (c + 1) v)) j) = 0 := by
  obtain ⟨w, rfl⟩ := (labeling c).surjective v
  cases w with
  | inl a =>
      rw [(labeling_rounds c a).2.2.1]
      simpa only [circleFamily_half_label] using
        P14TwoMomentCyclesQutrit.pair_incident z x second a (a + 1) (Or.inr rfl)
  | inr b =>
      rw [(labeling_rounds c b).2.2.2]
      simpa only [circleFamily_half_label] using
        P14TwoMomentCyclesQutrit.pair_incident_reverse z x second (b - 1) b
          (Or.inr (sub_add_cancel b 1).symm)

/-- Each half has 2r+4 vertices; r≥1 gives the cycle size required for qutrit
three-row general position. All conclusions use the same z and x. -/
theorem exists_circle_paired_qutrit (r : ℕ) (hr : 1 ≤ r) (c : Index r) :
    ∃ z : Step r → ℝ, ∃ x : Fin 3 → ℝ,
      (∀ i : Half r ⊕ Half r, circleFamily c z x i ≠ 0) ∧
      (∀ S : Finset (Half r ⊕ Half r), S.card = 3 →
        span ℂ (Set.range (fun i : (S : Set (Half r ⊕ Half r)) =>
          circleFamily c z x i.val)) = ⊤) ∧
      (∀ second : Bool, ∀ v : Half r,
        (∑ j, star (circleFamily c z x (halfIndex second v) j) *
          circleFamily c z x (halfIndex second (halfRound c v)) j) = 0) ∧
      (∀ second : Bool, ∀ v : Half r,
        (∑ j, star (circleFamily c z x (halfIndex second v) j) *
          circleFamily c z x (halfIndex second (halfRound (c + 1) v)) j) = 0) := by
  classical
  obtain ⟨z, x, hrows, hspan, _hforward, _hreverse⟩ :=
    P14TwoMomentCyclesQutrit.exists_paired_qutrit (n := r + 2) (by omega)
  refine ⟨z, x, ?_, ?_, pair_round_center c z x, pair_round_next c z x⟩
  · intro i
    exact hrows ((pairedLabeling c).symm i)
  · intro S hS
    let T := S.map (pairedLabeling c).symm.toEmbedding
    have hT : T.card = 3 := by
      simpa only [T, Finset.card_map] using hS
    let selection : (S : Set (Half r ⊕ Half r)) ≃
        (T : Set ((Step r ⊕ Step r) ⊕ (Step r ⊕ Step r))) :=
      Finset.equivMap (pairedLabeling c).symm.toEmbedding S
    have hrange :
        Set.range (fun i : (S : Set (Half r ⊕ Half r)) => circleFamily c z x i.val) =
        Set.range (fun i : (T : Set ((Step r ⊕ Step r) ⊕ (Step r ⊕ Step r))) =>
          P14TwoMomentCyclesQutrit.pairedFamily z x i.val) := by
      ext y
      constructor
      · rintro ⟨i, rfl⟩
        exact ⟨selection i, rfl⟩
      · rintro ⟨i, rfl⟩
        obtain ⟨j, rfl⟩ := selection.surjective i
        exact ⟨j, rfl⟩
    rw [hrange]
    exact hspan T hT

end P14CirclePairedQutrit

end
end

section

/-! Common physical labels for every circle center. One half equivalence is
chosen before the center; its round zero is the actual Fourier opposite map.
Qutrit parameters may depend on the center, but no center is re-enumerated. -/

noncomputable section
namespace P14CircleCommonLabels

open Submodule
open P14FourierHalfMatchings P14FourierHalfMatchings.Circle
open P14CircleConsecutiveCycle
open Fin.CommRing
open scoped BigOperators

/-- All circle rounds use this same half equivalence. -/
def round {n r : ℕ} (E : Half r ≃ Fin n) (c : Index r) (a : Fin n) : Fin n :=
  E (halfRound c (E.symm a))

theorem round_involutive {n r : ℕ} (E : Half r ≃ Fin n) (c : Index r) :
    Function.Involutive (round E c) := by
  intro a
  simp only [round, Equiv.symm_apply_apply, halfRound_involutive c _,
    Equiv.apply_symm_apply]

theorem round_fixed_free {n r : ℕ} (E : Half r ≃ Fin n)
    (c : Index r) (a : Fin n) : round E c a ≠ a := by
  intro h
  apply halfRound_fixed_free c (E.symm a)
  simpa only [round, Equiv.symm_apply_apply] using congrArg E.symm h

theorem round_cover {n r : ℕ} (E : Half r ≃ Fin n) (a b : Fin n)
    (hab : a ≠ b) : ∃ c : Index r, round E c a = b := by
  obtain ⟨c, hc⟩ := halfRound_cover (E.symm a) (E.symm b)
    (fun h => hab (E.symm.injective h))
  refine ⟨c, ?_⟩
  change E (halfRound c (E.symm a)) = b
  rw [hc, Equiv.apply_symm_apply]

/-- The same equivalence sends round zero to the actual Fourier half-period
matching; every other circle center remains literally indexed. -/
theorem exists_labeling_opposite {n : ℕ} (hn : 0 < n) (he : Even n) (hn6 : 6 ≤ n) :
    ∃ E : Half (n / 2 - 2) ≃ Fin n, ∀ a : Fin n,
      round E 0 a = P14FourierOrthogonalityGraph.opposite hn a := by
  classical
  let r : ℕ := n / 2 - 2
  have hnEq : n = 2 * r + 4 := by
    obtain ⟨m, hm⟩ := he
    dsimp only [r]
    omega
  let e : Half r ≃ Fin n := Fintype.equivOfCardEq (by
    simp only [Half, Index, Fintype.card_option, Fintype.card_fin]
    omega)
  obtain ⟨u, hu⟩ := exists_conjugacy_of_involutive_fixed_free
    (round e 0) (P14FourierOrthogonalityGraph.opposite hn)
    (round_involutive e 0) (P14FourierOrthogonalityGraph.opposite_involutive hn he)
    (round_fixed_free e 0) (P14FourierOrthogonalityGraph.opposite_ne hn he)
  refine ⟨e.trans u, ?_⟩
  intro a
  change u (round e 0 (u.symm a)) = P14FourierOrthogonalityGraph.opposite hn a
  exact hu a

/-- First and second refer to the physical halves, independently of the center. -/
def halfIndex {n : ℕ} (second : Bool) (a : Fin n) : Fin n ⊕ Fin n :=
  if second then Sum.inr a else Sum.inl a

def sumLabeling {n r : ℕ} (E : Half r ≃ Fin n) :
    (Half r ⊕ Half r) ≃ (Fin n ⊕ Fin n) := Equiv.sumCongr E E

def family {n r : ℕ} (E : Half r ≃ Fin n) (c : Index r)
    (z : Step r → ℝ) (x : Fin 3 → ℝ) (i : Fin n ⊕ Fin n) : Fin 3 → ℂ :=
  P14CirclePairedQutrit.circleFamily c z x ((sumLabeling E).symm i)

@[simp] theorem family_half_index {n r : ℕ} (E : Half r ≃ Fin n) (c : Index r)
    (z : Step r → ℝ) (x : Fin 3 → ℝ) (second : Bool) (a : Fin n) :
    family E c z x (halfIndex second a) =
      P14CirclePairedQutrit.circleFamily c z x
        (P14CirclePairedQutrit.halfIndex second (E.symm a)) := by
  cases second <;>
    simp [family, halfIndex, sumLabeling, Equiv.sumCongr,
      P14CirclePairedQutrit.halfIndex]

theorem pair_round_center {n r : ℕ} (E : Half r ≃ Fin n) (c : Index r)
    (z : Step r → ℝ) (x : Fin 3 → ℝ) (second : Bool) (a : Fin n) :
    (∑ j, star (family E c z x (halfIndex second a) j) *
      family E c z x (halfIndex second (round E c a)) j) = 0 := by
  simpa only [family_half_index, round, Equiv.symm_apply_apply] using
    P14CirclePairedQutrit.pair_round_center c z x second (E.symm a)

theorem pair_round_next {n r : ℕ} (E : Half r ≃ Fin n) (c : Index r)
    (z : Step r → ℝ) (x : Fin 3 → ℝ) (second : Bool) (a : Fin n) :
    (∑ j, star (family E c z x (halfIndex second a) j) *
      family E c z x (halfIndex second (round E (c + 1) a)) j) = 0 := by
  simpa only [family_half_index, round, Equiv.symm_apply_apply] using
    P14CirclePairedQutrit.pair_round_next c z x second (E.symm a)

/-- Transport one actual paired qutrit using an arbitrary fixed common labeling. -/
theorem exists_qutrit {n r : ℕ} (hr : 1 ≤ r) (E : Half r ≃ Fin n) (c : Index r) :
    ∃ z : Step r → ℝ, ∃ x : Fin 3 → ℝ,
      (∀ i : Fin n ⊕ Fin n, family E c z x i ≠ 0) ∧
      (∀ S : Finset (Fin n ⊕ Fin n), S.card = 3 →
        span ℂ (Set.range (fun i : (S : Set (Fin n ⊕ Fin n)) =>
          family E c z x i.val)) = ⊤) ∧
      (∀ second : Bool, ∀ a : Fin n,
        (∑ j, star (family E c z x (halfIndex second a) j) *
          family E c z x (halfIndex second (round E c a)) j) = 0) ∧
      (∀ second : Bool, ∀ a : Fin n,
        (∑ j, star (family E c z x (halfIndex second a) j) *
          family E c z x (halfIndex second (round E (c + 1) a)) j) = 0) := by
  classical
  obtain ⟨z, x, hrows, hspan, _hcenter, _hnext⟩ :=
    P14CirclePairedQutrit.exists_circle_paired_qutrit r hr c
  refine ⟨z, x, ?_, ?_, pair_round_center E c z x, pair_round_next E c z x⟩
  · intro i
    exact hrows ((sumLabeling E).symm i)
  · intro S hS
    let T := S.map (sumLabeling E).symm.toEmbedding
    have hT : T.card = 3 := by
      simpa only [T, Finset.card_map] using hS
    let selection : (S : Set (Fin n ⊕ Fin n)) ≃ (T : Set (Half r ⊕ Half r)) :=
      Finset.equivMap (sumLabeling E).symm.toEmbedding S
    have hrange :
        Set.range (fun i : (S : Set (Fin n ⊕ Fin n)) => family E c z x i.val) =
        Set.range (fun i : (T : Set (Half r ⊕ Half r)) =>
          P14CirclePairedQutrit.circleFamily c z x i.val) := by
      ext y
      constructor
      · rintro ⟨i, rfl⟩
        exact ⟨selection i, rfl⟩
      · rintro ⟨i, rfl⟩
        obtain ⟨j, rfl⟩ := selection.surjective i
        exact ⟨j, rfl⟩
    rw [hrange]
    exact hspan T hT

/-- One equivalence is selected before all centers. Local parameters may vary
with the center, as different local factors are permitted different vectors. -/
theorem exists_common_qutrits {n : ℕ} (hn : 0 < n) (he : Even n) (hn6 : 6 ≤ n) :
    ∃ E : Half (n / 2 - 2) ≃ Fin n,
      (∀ a : Fin n, round E 0 a = P14FourierOrthogonalityGraph.opposite hn a) ∧
      ∀ c : Index (n / 2 - 2), ∃ z : Step (n / 2 - 2) → ℝ, ∃ x : Fin 3 → ℝ,
        (∀ i : Fin n ⊕ Fin n, family E c z x i ≠ 0) ∧
        (∀ S : Finset (Fin n ⊕ Fin n), S.card = 3 →
          span ℂ (Set.range (fun i : (S : Set (Fin n ⊕ Fin n)) =>
            family E c z x i.val)) = ⊤) ∧
        (∀ second : Bool, ∀ a : Fin n,
          (∑ j, star (family E c z x (halfIndex second a) j) *
            family E c z x (halfIndex second (round E c a)) j) = 0) ∧
        (∀ second : Bool, ∀ a : Fin n,
          (∑ j, star (family E c z x (halfIndex second a) j) *
            family E c z x (halfIndex second (round E (c + 1) a)) j) = 0) := by
  obtain ⟨E, hE⟩ := exists_labeling_opposite hn he hn6
  exact ⟨E, hE, fun c => exists_qutrit (by omega) E c⟩

end P14CircleCommonLabels

end
