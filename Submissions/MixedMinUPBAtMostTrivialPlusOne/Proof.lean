section

/-! The literal canonical conclusion for every multipartite dimension tuple
with deficit eight and at least one qutrit, in arbitrary factor order.
The finite allocation has no unproved local-realizability hypothesis. -/

noncomputable section
namespace P14TenRowQutritCanonical
open P14CanonicalUPBTransport
open scoped BigOperators

theorem multipartite {p : ℕ} (d : Fin p → ℕ) (hp : 3 ≤ p)
    (hd : ∀ j, 2 ≤ d j) (hq : ∃ j, d j = 3)
    (hsum : (∑ j, (d j - 1)) = 8) : Conclusion p d := by
  classical
  cases p with
  | zero => omega
  | succ n =>
    have hn : 2 ≤ n := by omega
    obtain ⟨t, ht⟩ := hq
    let E : Fin (n + 1) ≃ Fin (n + 1) := Equiv.swap 0 t
    have hzero : d (E 0) = 3 := by simp [E, ht]
    have hE : (∑ j, (d (E j) - 1)) = 8 :=
      (E.sum_comp (fun j => d j - 1)).trans hsum
    let R : Fin n → ℕ := fun j => d (E j.succ) - 1
    have hpos : ∀ j, 1 ≤ R j := by
      intro j
      have hj := hd (E j.succ)
      dsimp [R]
      omega
    have hR : (∑ j, R j) = 6 := by
      rw [Fin.sum_univ_succ] at hE
      simp only [hzero] at hE
      change 3 - 1 + (∑ j, R j) = 8 at hE
      omega
    obtain ⟨S, hcard, hallowed, hcover⟩ :=
      P14TenRowQutritAllocation.allocation R hn hpos hR
    have hsumS : (∑ j, (S j).card) = 6 := by
      simpa only [hcard] using hR
    have hdim : P14TenRowQutritUPB.dimensions S = fun j => d (E j) := by
      funext j
      refine Fin.cases ?_ (fun j => ?_) j
      · simp [P14TenRowQutritUPB.dimensions, hzero]
      · change (S j).card + 1 = d (E j.succ)
        rw [hcard]
        dsimp [R]
        have hj := hd (E j.succ)
        omega
    have hc : Conclusion (n + 1) (fun j => d (E j)) := by
      rw [← hdim]
      exact P14TenRowQutritUPB.canonical S hallowed hcover hsumS
    have hf := reindex (fun j => d (E j)) E hc
    simpa only [E, Equiv.swap_apply_self] using hf

end P14TenRowQutritCanonical

end
end

section

/-! The literal canonical conclusion for every multipartite dimension tuple
with deficit eight and at least one ququart, in arbitrary factor order.
The finite allocation has no unproved local-realizability hypothesis. -/

noncomputable section
namespace P14TenRowQuquartCanonical
open P14CanonicalUPBTransport
open scoped BigOperators

private theorem allocation {n : ℕ} (R : Fin n → ℕ) (hn : 2 ≤ n)
    (hpos : ∀ j, 1 ≤ R j) (hno : ∀ j, R j ≠ 2) (hsum : (∑ j, R j) = 5) :
    ∃ S : Fin n → Finset (Fin 5), (∀ j, (S j).card = R j) ∧
      (∀ j, S j ∈ P14TenRowQuquartBlocks.allowed) ∧ (∀ k : Fin 5, ∃ j, k ∈ S j) := by
  have hn5 : n ≤ 5 := by
    calc
      n = ∑ _j : Fin n, (1 : ℕ) := by simp
      _ ≤ ∑ j, R j := Finset.sum_le_sum (fun j _ => hpos j)
      _ = 5 := hsum
  have hncase : n = 2 ∨ n = 3 ∨ n = 4 ∨ n = 5 := by omega
  rcases hncase with rfl | rfl | rfl | rfl
  · have h0 := hpos (0 : Fin 2)
    have h1 := hpos (1 : Fin 2)
    have hn0 := hno (0 : Fin 2)
    have hn1 := hno (1 : Fin 2)
    have hs : R 0 + (R 1) = 5 := by simpa [Fin.sum_univ_succ] using hsum
    have hc : (R 0 = 1 ∧ R 1 = 4) ∨ (R 0 = 4 ∧ R 1 = 1) := by omega
    rcases hc with ⟨e0, e1⟩ | ⟨e0, e1⟩
    · have he : R = ![1, 4] := by
        funext j
        fin_cases j <;> assumption
      rw [he]
      exact ⟨![{4}, {0, 1, 2, 3}], by decide, by decide, by decide⟩
    · have he : R = ![4, 1] := by
        funext j
        fin_cases j <;> assumption
      rw [he]
      exact ⟨![{0, 1, 2, 3}, {4}], by decide, by decide, by decide⟩
  · have h0 := hpos (0 : Fin 3)
    have h1 := hpos (1 : Fin 3)
    have h2 := hpos (2 : Fin 3)
    have hn0 := hno (0 : Fin 3)
    have hn1 := hno (1 : Fin 3)
    have hn2 := hno (2 : Fin 3)
    have hs : R 0 + (R 1 + (R 2)) = 5 := by simpa [Fin.sum_univ_succ] using hsum
    have hc : (R 0 = 1 ∧ R 1 = 1 ∧ R 2 = 3) ∨ (R 0 = 1 ∧ R 1 = 3 ∧ R 2 = 1) ∨ (R 0 = 3 ∧ R 1 = 1 ∧ R 2 = 1) := by omega
    rcases hc with ⟨e0, e1, e2⟩ | ⟨e0, e1, e2⟩ | ⟨e0, e1, e2⟩
    · have he : R = ![1, 1, 3] := by
        funext j
        fin_cases j <;> assumption
      rw [he]
      exact ⟨![{3}, {4}, {0, 1, 2}], by decide, by decide, by decide⟩
    · have he : R = ![1, 3, 1] := by
        funext j
        fin_cases j <;> assumption
      rw [he]
      exact ⟨![{3}, {0, 1, 2}, {4}], by decide, by decide, by decide⟩
    · have he : R = ![3, 1, 1] := by
        funext j
        fin_cases j <;> assumption
      rw [he]
      exact ⟨![{0, 1, 2}, {3}, {4}], by decide, by decide, by decide⟩
  · have h0 := hpos (0 : Fin 4)
    have h1 := hpos (1 : Fin 4)
    have h2 := hpos (2 : Fin 4)
    have h3 := hpos (3 : Fin 4)
    have hn0 := hno (0 : Fin 4)
    have hn1 := hno (1 : Fin 4)
    have hn2 := hno (2 : Fin 4)
    have hn3 := hno (3 : Fin 4)
    have hs : R 0 + (R 1 + (R 2 + (R 3))) = 5 := by simpa [Fin.sum_univ_succ] using hsum
    omega
  · have h0 := hpos (0 : Fin 5)
    have h1 := hpos (1 : Fin 5)
    have h2 := hpos (2 : Fin 5)
    have h3 := hpos (3 : Fin 5)
    have h4 := hpos (4 : Fin 5)
    have hn0 := hno (0 : Fin 5)
    have hn1 := hno (1 : Fin 5)
    have hn2 := hno (2 : Fin 5)
    have hn3 := hno (3 : Fin 5)
    have hn4 := hno (4 : Fin 5)
    have hs : R 0 + (R 1 + (R 2 + (R 3 + (R 4)))) = 5 := by simpa [Fin.sum_univ_succ] using hsum
    have hc : (R 0 = 1 ∧ R 1 = 1 ∧ R 2 = 1 ∧ R 3 = 1 ∧ R 4 = 1) := by omega
    rcases hc with ⟨e0, e1, e2, e3, e4⟩
    · have he : R = ![1, 1, 1, 1, 1] := by
        funext j
        fin_cases j <;> assumption
      rw [he]
      exact ⟨![{0}, {1}, {2}, {3}, {4}], by decide, by decide, by decide⟩

theorem multipartite {p : ℕ} (d : Fin p → ℕ) (hp : 3 ≤ p)
    (hd : ∀ j, 2 ≤ d j) (hq : ∃ j, d j = 4)
    (hsum : (∑ j, (d j - 1)) = 8) : Conclusion p d := by
  classical
  by_cases hthree : ∃ j, d j = 3
  · exact P14TenRowQutritCanonical.multipartite d hp hd hthree hsum
  cases p with
  | zero => omega
  | succ n =>
    have hn : 2 ≤ n := by omega
    obtain ⟨t, ht⟩ := hq
    let E : Fin (n + 1) ≃ Fin (n + 1) := Equiv.swap 0 t
    have hzero : d (E 0) = 4 := by simp [E, ht]
    have hE : (∑ j, (d (E j) - 1)) = 8 :=
      (E.sum_comp (fun j => d j - 1)).trans hsum
    let R : Fin n → ℕ := fun j => d (E j.succ) - 1
    have hpos : ∀ j, 1 ≤ R j := by
      intro j
      have hj := hd (E j.succ)
      dsimp [R]
      omega
    have hR : (∑ j, R j) = 5 := by
      rw [Fin.sum_univ_succ] at hE
      simp only [hzero] at hE
      change 4 - 1 + (∑ j, R j) = 8 at hE
      omega
    have hno : ∀ j, R j ≠ 2 := by
      intro j hj
      have hdj := hd (E j.succ)
      have hnj : d (E j.succ) ≠ 3 := fun h => hthree ⟨E j.succ, h⟩
      dsimp [R] at hj
      omega
    obtain ⟨S, hcard, hallowed, hcover⟩ :=
      allocation R hn hpos hno hR
    have hsumS : (∑ j, (S j).card) = 5 := by
      simpa only [hcard] using hR
    have hdim : P14TenRowQuquartUPB.dimensions S = fun j => d (E j) := by
      funext j
      refine Fin.cases ?_ (fun j => ?_) j
      · simp [P14TenRowQuquartUPB.dimensions, hzero]
      · change (S j).card + 1 = d (E j.succ)
        rw [hcard]
        dsimp [R]
        have hj := hd (E j.succ)
        omega
    have hc : Conclusion (n + 1) (fun j => d (E j)) := by
      rw [← hdim]
      exact P14TenRowQuquartUPB.canonical S hallowed hcover hsumS
    have hf := reindex (fun j => d (E j)) E hc
    simpa only [E, Equiv.swap_apply_self] using hf

end P14TenRowQuquartCanonical

end
end

section

/-! Every corrected multipartite tuple with deficit eight has the literal
canonical UPB conclusion. The all-qubit exclusion is retained explicitly.
This finite region is not the unrestricted mixed-dimensional theorem. -/

noncomputable section
namespace P14TenRowFullCanonical
open P14CanonicalUPBTransport P14TenRowQuadraticUPB
open scoped BigOperators

private theorem rest_bound {n : ℕ} (R : Fin n → ℕ) (hpos : ∀ j, 1 ≤ R j)
    (j : Fin n) : n - 1 + R j ≤ ∑ i, R i := by
  classical
  have hr : n - 1 ≤ ∑ i ∈ (Finset.univ : Finset (Fin n)).erase j, R i := by
    calc
      n - 1 = ∑ _i ∈ (Finset.univ : Finset (Fin n)).erase j, (1 : ℕ) := by
        simp [Finset.card_erase_of_mem (Finset.mem_univ j)]
      _ ≤ ∑ i ∈ (Finset.univ : Finset (Fin n)).erase j, R i :=
        Finset.sum_le_sum (fun i _ => hpos i)
  have he := Finset.sum_erase_add (Finset.univ : Finset (Fin n)) R (Finset.mem_univ j)
  omega

private theorem seven_two_qubits : Conclusion 3 (dimensions 7 2) := by
  have h : Conclusion 3 ![2, 2, 7] := P14TwoQubitsUPB.canonical 7 (by omega)
  have hr := reindex (![2, 2, 7] : Fin 3 → ℕ) (Equiv.swap 0 2) h
  have he : (fun j => (![2, 2, 7] : Fin 3 → ℕ) (Equiv.swap 0 2 j)) = dimensions 7 2 := by
    funext j
    fin_cases j <;> decide
  rwa [he] at hr

theorem multipartite {p : ℕ} (d : Fin p → ℕ) (hp : 3 ≤ p)
    (hd : ∀ j, 2 ≤ d j) (hnotqubits : ¬ (∀ j, d j = 2))
    (hsum : (∑ j, (d j - 1)) = 8) : Conclusion p d := by
  classical
  by_cases hthree : ∃ j, d j = 3
  · exact P14TenRowQutritCanonical.multipartite d hp hd hthree hsum
  by_cases hfour : ∃ j, d j = 4
  · exact P14TenRowQuquartCanonical.multipartite d hp hd hfour hsum
  obtain ⟨t, ht⟩ : ∃ t, d t ≠ 2 := not_forall.mp hnotqubits
  have ht5 : 5 ≤ d t := by
    have ht2 := hd t
    have ht3 : d t ≠ 3 := fun h => hthree ⟨t, h⟩
    have ht4 : d t ≠ 4 := fun h => hfour ⟨t, h⟩
    omega
  cases p with
  | zero => omega
  | succ n =>
    have hn : 2 ≤ n := by omega
    let E : Fin (n + 1) ≃ Fin (n + 1) := Equiv.swap 0 t
    have hzero : d (E 0) = d t := by simp [E]
    have hE : (∑ j, (d (E j) - 1)) = 8 :=
      (E.sum_comp (fun j => d j - 1)).trans hsum
    let R : Fin n → ℕ := fun j => d (E j.succ) - 1
    have hpos : ∀ j, 1 ≤ R j := by
      intro j
      have hj := hd (E j.succ)
      dsimp [R]
      omega
    have hR : (∑ j, R j) ≤ 4 := by
      rw [Fin.sum_univ_succ] at hE
      change d (E 0) - 1 + (∑ j, R j) = 8 at hE
      rw [hzero] at hE
      omega
    have hrest : ∀ j : Fin n, d (E j.succ) = 2 := by
      intro j
      have hr := rest_bound R hpos j
      have hj := hd (E j.succ)
      have h3 : d (E j.succ) ≠ 3 := fun h => hthree ⟨E j.succ, h⟩
      have h4 : d (E j.succ) ≠ 4 := fun h => hfour ⟨E j.succ, h⟩
      rw [show R j = d (E j.succ) - 1 from rfl] at hr
      omega
    have hdim : (fun j => d (E j)) = dimensions (d t) n := by
      funext j
      refine Fin.cases ?_ (fun j => ?_) j
      · exact hzero
      · exact hrest j
    have hdn : d t + n = 9 := by
      rw [Fin.sum_univ_succ] at hE
      simp only [hzero, hrest] at hE
      simp at hE
      omega
    have hc : Conclusion (n + 1) (fun j => d (E j)) := by
      rw [hdim]
      have hncase : n = 2 ∨ n = 3 ∨ n = 4 := by omega
      rcases hncase with rfl | rfl | rfl
      · have hdt : d t = 7 := by omega
        rw [hdt]
        exact seven_two_qubits
      · have hdt : d t = 6 := by omega
        rw [hdt]
        exact six_three_qubits
      · have hdt : d t = 5 := by omega
        rw [hdt]
        exact five_four_qubits
    have hf := reindex (fun j => d (E j)) E hc
    simpa only [E, Equiv.swap_apply_self] using hf

end P14TenRowFullCanonical

end
end

section

/-! The complete multipartite family with one qutrit and otherwise qubits,
including every number of factors and arbitrary factor order. -/

noncomputable section
namespace P14QutritOnlyCanonical
open P14QutritOnlyUPB P14CanonicalUPBTransport
open scoped BigOperators

private theorem two_qubits : Conclusion 3 (dimensions 2) := by
  have h : Conclusion 3 ![2, 2, 3] := P14TwoQubitsUPB.canonical 3 (by omega)
  have hr := reindex (![2, 2, 3] : Fin 3 → ℕ) (Equiv.swap 0 2) h
  have he : (fun j => (![2, 2, 3] : Fin 3 → ℕ) (Equiv.swap 0 2 j)) = dimensions 2 := by
    funext j
    fin_cases j <;> decide
  rwa [he] at hr

theorem with_qubits (m : ℕ) (hm : 2 ≤ m) : Conclusion (m + 1) (dimensions m) := by
  classical
  by_contra hnot
  have hd : ∀ j, 2 ≤ dimensions m j := by
    intro j
    refine Fin.cases ?_ (fun j => ?_) j <;> simp [dimensions]
  have hbi : ¬ (m + 1 = 2 ∧ ∃ j, dimensions m j = 2) := by rintro ⟨he,_⟩; omega
  obtain ⟨_,_,hr⟩ :=
    P14CanonicalResidualAfterEight.necessary_conditions (by omega) (dimensions m) hd hbi hnot
  have hmod : (4 + m) % 4 = 2 := by
    rcases hr with htwo | hr
    · omega
    · rw [sum_deficits] at hr
      omega
  by_cases h2 : m = 2
  · subst m
    exact hnot two_qubits
  by_cases h6 : m = 6
  · subst m
    apply hnot
    apply P14TenRowFullCanonical.multipartite (dimensions 6) (by omega) hd
    · intro h
      have h0 := h 0
      norm_num [dimensions] at h0
    · rw [sum_deficits]
  let q := (m + 4) / 2
  have hq : 7 ≤ q := by dsimp [q]; omega
  have ho : Odd q := by
    refine ⟨m / 4 + 1, ?_⟩
    dsimp [q]
    omega
  letI : NeZero q := ⟨by omega⟩
  have he : m = 2 * q - 4 := by dsimp [q]; omega
  apply hnot
  have hc := P14QutritOnlyUPB.canonical hq ho
  rw [← he] at hc
  exact hc

theorem multipartite {p : ℕ} (d : Fin p → ℕ) (hp : 3 ≤ p)
    (hone : ∃ a : Fin p, d a = 3 ∧ ∀ j, j ≠ a → d j = 2) :
    Conclusion p d := by
  classical
  obtain ⟨a,ha,hrest⟩ := hone
  cases p with
  | zero => omega
  | succ n =>
    let E : Fin (n + 1) ≃ Fin (n + 1) := Equiv.swap 0 a
    have h0 : E 0 = a := Equiv.swap_apply_left 0 a
    have he : ∀ j, dimensions n j = d (E j) := by
      intro j
      refine Fin.cases ?_ (fun j => ?_) j
      · simpa only [dimensions, Fin.cons_zero, h0] using ha.symm
      · have hne : E j.succ ≠ a := by
          intro hh
          have hz := E.injective (hh.trans h0.symm)
          exact Fin.succ_ne_zero j hz
        simpa only [dimensions, Fin.cons_succ] using (hrest (E j.succ) hne).symm
    apply P14CanonicalUPBTransport.of_dimensions (dimensions n) d E.symm
    · intro j
      simpa only [Equiv.apply_symm_apply] using (he (E.symm j)).symm
    · exact with_qubits n (by omega)

end P14QutritOnlyCanonical

end
end

section

/-! Recognize arbitrary dimension lists containing a qutrit and a partner
with room supplied by the numerical bound or a third sufficiently large
factor. The partition and factor permutations are constructed internally. -/

noncomputable section
namespace P14QutritPartnerCanonical
open P14LargePartnerUPB P14CanonicalUPBTransport P14NonQubitPartition
open scoped BigOperators

theorem with_heads {q n k : ℕ} [NeZero q] (hq : 7 ≤ q) (ho : Odd q)
    (d : Fin (n + 2) → ℕ) (hd : ∀ j, 2 ≤ d j)
    (hzero : d 0 = 3) (hone : d 1 = k + 3)
    (hsum : (∑ j, (d j - 1)) = 2 * q - 2)
    (hroom : 2 * k ≤ q + 3 ∨ ∃ j : Fin n, k + 3 ≤ d j.succ.succ) :
    Conclusion (n + 2) d := by
  classical
  let t : Fin n → ℕ := fun j => d j.succ.succ
  obtain ⟨p, m, r, E, hr, he⟩ := P14NonQubitPartition.split t (fun j => hd j.succ.succ)
  let F : Fin (p + m + 2) ≃ Fin (n + 2) := lift (lift E)
  have hdim : ∀ j, dimensions r m k j = d (F j) := by
    intro j
    refine Fin.cases ?_ (fun j => ?_) j
    · simpa only [dimensions, Fin.cons_zero, F, lift_zero] using hzero.symm
    · refine Fin.cases ?_ (fun j => ?_) j
      · have hone' : k + 3 = d (0 : Fin (n + 1)).succ := by
          rw [Fin.succ_zero_eq_one]
          exact hone.symm
        simpa only [dimensions, Fin.cons_succ, Fin.cons_zero, F, lift_succ, lift_zero]
          using hone'
      · simpa only [dimensions, Fin.cons_succ, F, lift_succ, t] using (he j).symm
  have hs : (∑ j, (dimensions r m k j - 1)) = 2 * q - 2 := by
    calc
      _ = ∑ j, (d (F j) - 1) :=
        Finset.sum_congr rfl (fun j _ => congrArg (fun a : ℕ => a - 1) (hdim j))
      _ = _ := (F.sum_comp (fun j => d j - 1)).trans hsum
  rw [sum_deficits] at hs
  have htotal : (∑ i, r i) + m + k = 2 * q - 6 := by
    clear hroom
    omega
  have hcap : 2 * k ≤ q + 3 ∨ ∃ i, k + 2 ≤ r i := by
    rcases hroom with h | h
    · exact Or.inl h
    · obtain ⟨i, hi⟩ := P14NonQubitPartition.large_witness t r E he (by omega) h
      exact Or.inr ⟨i, by omega⟩
  have hc := P14UnifiedPartnerUPB.canonical hq ho r hr htotal hcap
  apply P14CanonicalUPBTransport.of_dimensions (dimensions r m k) d F.symm
  · intro j
    simpa only [Equiv.apply_symm_apply] using (hdim (F.symm j)).symm
  · exact hc

theorem off_heads {n : ℕ} (v : Fin (n + 2)) (hzero : v ≠ 0) (hone : v ≠ 1) :
    ∃ u : Fin n, v = u.succ.succ := by
  revert hzero hone
  refine Fin.cases ?_ (fun w => ?_) v
  · intro h _
    exact False.elim (h rfl)
  · refine Fin.cases ?_ (fun u _ _ => ⟨u, rfl⟩) w
    intro _ h
    exact False.elim (h rfl)

theorem with_factors {q p : ℕ} [NeZero q] (hq : 7 ≤ q) (ho : Odd q)
    (d : Fin p → ℕ) (hd : ∀ j, 2 ≤ d j)
    (a b : Fin p) (hab : a ≠ b) (ha : d a = 3) (hb : 3 ≤ d b)
    (hsum : (∑ j, (d j - 1)) = 2 * q - 2)
    (hroom : 2 * (d b - 3) ≤ q + 3 ∨
      ∃ c : Fin p, c ≠ a ∧ c ≠ b ∧ d b ≤ d c) : Conclusion p d := by
  classical
  cases p with
  | zero => exact Fin.elim0 a
  | succ n =>
    cases n with
    | zero => exact False.elim (hab (Fin.ext (by have ha := a.isLt; have hb := b.isLt; omega)))
    | succ n =>
      let E : Fin (n + 2) ≃ Fin (n + 2) := Equiv.swap 0 a
      have hE0 : E 0 = a := Equiv.swap_apply_left _ _
      have hB : E.symm b ≠ 0 := by
        intro he
        have h := congrArg E he
        rw [Equiv.apply_symm_apply, hE0] at h
        exact hab h.symm
      obtain ⟨t, ht⟩ : ∃ t : Fin (n + 1), E.symm b = t.succ := by
        rcases Fin.eq_zero_or_eq_succ (E.symm b) with h | h
        · exact False.elim (hB h)
        · exact h
      let G : Fin (n + 1) ≃ Fin (n + 1) := Equiv.swap 0 t
      let F : Fin (n + 2) ≃ Fin (n + 2) := (lift G).trans E
      have hF0 : F 0 = a := by simp only [F, Equiv.trans_apply, lift_zero, hE0]
      have hF1 : F 1 = b := by
        change E (lift G (0 : Fin (n + 1)).succ) = b
        rw [lift_succ]
        have hG0 : G 0 = t := Equiv.swap_apply_left _ _
        rw [hG0, ← ht, Equiv.apply_symm_apply]
      let D : Fin (n + 2) → ℕ := fun j => d (F j)
      have hD0 : D 0 = 3 := by simpa only [D, hF0] using ha
      have hD1 : D 1 = (d b - 3) + 3 := by
        dsimp only [D]
        rw [hF1]
        omega
      have hcap : 2 * (d b - 3) ≤ q + 3 ∨
          ∃ j : Fin n, (d b - 3) + 3 ≤ D j.succ.succ := by
        rcases hroom with h | ⟨c, hca, hcb, hc⟩
        · exact Or.inl h
        · have hc0 : F.symm c ≠ 0 := by
            intro he
            have h := congrArg F he
            rw [Equiv.apply_symm_apply, hF0] at h
            exact hca h
          have hc1 : F.symm c ≠ 1 := by
            intro he
            have h := congrArg F he
            rw [Equiv.apply_symm_apply, hF1] at h
            exact hcb h
          obtain ⟨j, hj⟩ := off_heads (F.symm c) hc0 hc1
          refine Or.inr ⟨j, ?_⟩
          dsimp only [D]
          rw [← hj, Equiv.apply_symm_apply]
          omega
      have hs : (∑ j, (D j - 1)) = 2 * q - 2 :=
        (F.sum_comp (fun j => d j - 1)).trans hsum
      have H := with_heads hq ho D (fun j => hd (F j)) hD0 hD1 hs hcap
      have H' := reindex D F.symm H
      simpa only [D, Equiv.apply_symm_apply] using H'

theorem three_nonqubit {q p : ℕ} [NeZero q] (hq : 7 ≤ q) (ho : Odd q)
    (d : Fin p → ℕ) (hd : ∀ j, 2 ≤ d j)
    (hsum : (∑ j, (d j - 1)) = 2 * q - 2)
    (hthree : ∃ a b c : Fin p, a ≠ b ∧ a ≠ c ∧ b ≠ c ∧
      d a = 3 ∧ 3 ≤ d b ∧ 3 ≤ d c) : Conclusion p d := by
  obtain ⟨a, b, c, hab, hac, hbc, ha, hb, hc⟩ := hthree
  by_cases hle : d b ≤ d c
  · exact with_factors hq ho d hd a b hab ha hb hsum
      (Or.inr ⟨c, hac.symm, hbc.symm, hle⟩)
  · exact with_factors hq ho d hd a c hac ha hc hsum
      (Or.inr ⟨b, hab.symm, hbc, by omega⟩)

end P14QutritPartnerCanonical

end
end

section

/-! The full canonical conclusion for every multipartite dimension list
containing a qutrit and at least two other non-qubit factors. All parities
and total deficits are handled using the previously checked regions. -/

noncomputable section
namespace P14QutritThreeCanonical
open P14CanonicalUPBTransport
open scoped BigOperators

theorem multipartite {p : ℕ} (d : Fin p → ℕ) (hp : 3 ≤ p)
    (hd : ∀ j, 2 ≤ d j)
    (hthree : ∃ a b c : Fin p, a ≠ b ∧ a ≠ c ∧ b ≠ c ∧
      d a = 3 ∧ 3 ≤ d b ∧ 3 ≤ d c) : Conclusion p d := by
  classical
  by_contra hnot
  have hbi : ¬ (p = 2 ∧ ∃ j, d j = 2) := by rintro ⟨he, _⟩; omega
  obtain ⟨_, _, hr⟩ :=
    P14CanonicalResidualAfterEight.necessary_conditions (by omega) d hd hbi hnot
  have hmod : (2 + ∑ j, (d j - 1)) % 4 = 2 := by
    rcases hr with hp2 | hmod
    · omega
    · exact hmod
  obtain ⟨a, b, c, hab, hac, hbc, ha, hb, hc⟩ := hthree
  let T : Finset (Fin p) := {a, b, c}
  have hsub : (∑ j ∈ T, (d j - 1)) ≤ ∑ j, (d j - 1) :=
    Finset.sum_le_sum_of_subset_of_nonneg (Finset.subset_univ T)
      (fun _ _ _ => Nat.zero_le _)
  have hT : (∑ j ∈ T, (d j - 1)) = (d a - 1) + (d b - 1) + (d c - 1) := by
    simp [T, hab, hac, hbc, Nat.add_assoc]
  rw [hT] at hsub
  have hl : 6 ≤ ∑ j, (d j - 1) := by omega
  have hnq : ¬ (∀ j, d j = 2) := by intro h; have h' := h a; omega
  by_cases h8 : (∑ j, (d j - 1)) = 8
  · exact hnot (P14TenRowFullCanonical.multipartite d hp hd hnq h8)
  let S := ∑ j, (d j - 1)
  have hS : S % 4 = 0 ∧ 12 ≤ S := by dsimp only [S]; omega
  let q := (S + 2) / 2
  have hq : 7 ≤ q := by dsimp only [q]; omega
  have ho : Odd q := by
    refine ⟨S / 4, ?_⟩
    dsimp only [q]
    omega
  letI : NeZero q := ⟨by omega⟩
  have hsum : (∑ j, (d j - 1)) = 2 * q - 2 := by
    change S = 2 * q - 2
    dsimp only [q]
    omega
  exact hnot (P14QutritPartnerCanonical.three_nonqubit hq ho d hd hsum
    ⟨a, b, c, hab, hac, hbc, ha, hb, hc⟩)

end P14QutritThreeCanonical

end
end

section

/-! The complete multipartite qutrit family, with arbitrary factor order
and no parity, partner-size or factor-count restriction beyond p>=3. -/
noncomputable section
namespace P14QutritFullCanonical
open P14CanonicalUPBTransport P14QutritPartnerRows P14NonQubitPartition
open scoped BigOperators

theorem canonical {q D m : ℕ} [NeZero q] (hq : 7 ≤ q) (ho : Odd q)
    (hD : 3 ≤ D) (hm : 1 ≤ m) (htotal : D + m = 2 * q - 3) :
    Conclusion (m + 2) (dimensions D m) := by
  by_cases hqD : q ≤ D
  · exact P14QutritPartnerRows.dominant hq ho hqD hm htotal
  · by_cases hq9 : 9 ≤ q
    · obtain ⟨G,F,hsym,hirr,hbound,hF,hFne,hcover⟩ :=
        P14QutritFreeCover.construct hq9 ho hD (by omega) htotal
      exact P14QutritPartnerRows.from_cover hq ho (by omega) htotal
        G hsym hirr hbound F hF hFne hcover
    · have hq7 : q = 7 := by obtain ⟨k,hk⟩ := ho; omega
      have hd : ∀ j, 2 ≤ dimensions D m j := by
        intro j
        refine Fin.cases (by simp [dimensions]) (fun j => ?_) j
        refine Fin.cases (by simpa [dimensions] using (show 2 ≤ D by omega))
          (fun j => by simp [dimensions]) j
      apply P14QutritPartnerCanonical.with_heads (k := D - 3) hq ho (dimensions D m) hd
      · rfl
      · change D = (D - 3) + 3
        omega
      · rw [sum_deficits]
        omega
      · exact Or.inl (by omega)

theorem sum_two_heads {p : ℕ} (d : Fin p → ℕ) (a b : Fin p)
    (hab : a ≠ b) (ha : d a = 3) (hb : 3 ≤ d b)
    (hrest : ∀ j, j ≠ a → j ≠ b → d j = 2) :
    (∑ j, (d j - 1)) + 1 = d b + p := by
  classical
  have hf (j : Fin p) : d j - 1 =
      1 + (if j = a then 1 else 0) + (if j = b then d b - 2 else 0) := by
    by_cases hja : j = a
    · subst j
      simp [ha, hab]
    · by_cases hjb : j = b
      · subst j
        simp only [hja, if_false, if_true, add_zero]
        omega
      · rw [hrest j hja hjb]
        simp [hja, hjb]
  have hs : (∑ j, (d j - 1)) = p + 1 + (d b - 2) := by
    calc
      _ = ∑ j, (1 + (if j = a then 1 else 0) + (if j = b then d b - 2 else 0)) :=
        Finset.sum_congr rfl (fun j _ => hf j)
      _ = _ := by simp [Finset.sum_add_distrib]
  omega

theorem with_factors {q p : ℕ} [NeZero q] (hq : 7 ≤ q) (ho : Odd q)
    (d : Fin p → ℕ) (hp : 3 ≤ p) (a b : Fin p)
    (hab : a ≠ b) (ha : d a = 3) (hb : 3 ≤ d b)
    (hrest : ∀ j, j ≠ a → j ≠ b → d j = 2)
    (hsum : (∑ j, (d j - 1)) = 2 * q - 2) : Conclusion p d := by
  classical
  cases p with
  | zero => omega
  | succ n =>
    cases n with
    | zero => omega
    | succ n =>
      let E : Fin (n + 2) ≃ Fin (n + 2) := Equiv.swap 0 a
      have hE0 : E 0 = a := Equiv.swap_apply_left _ _
      have hB : E.symm b ≠ 0 := by
        intro he
        have h := congrArg E he
        rw [Equiv.apply_symm_apply, hE0] at h
        exact hab h.symm
      obtain ⟨t, ht⟩ : ∃ t : Fin (n + 1), E.symm b = t.succ := by
        rcases Fin.eq_zero_or_eq_succ (E.symm b) with h | h
        · exact False.elim (hB h)
        · exact h
      let G : Fin (n + 1) ≃ Fin (n + 1) := Equiv.swap 0 t
      let F : Fin (n + 2) ≃ Fin (n + 2) := (lift G).trans E
      have hF0 : F 0 = a := by simp only [F, Equiv.trans_apply, lift_zero, hE0]
      have hF1 : F 1 = b := by
        change E (lift G (0 : Fin (n + 1)).succ) = b
        rw [lift_succ]
        have hG0 : G 0 = t := Equiv.swap_apply_left _ _
        rw [hG0, ← ht, Equiv.apply_symm_apply]
      have hdim : ∀ j, dimensions (d b) n j = d (F j) := by
        intro j
        refine Fin.cases ?_ (fun j => ?_) j
        · simpa only [dimensions, Fin.cons_zero, hF0] using ha.symm
        · refine Fin.cases ?_ (fun j => ?_) j
          · change d b = d (F 1)
            rw [hF1]
          · change 2 = d (F j.succ.succ)
            apply (hrest _ ?_ ?_).symm
            · intro he
              have hz := F.injective (he.trans hF0.symm)
              exact Fin.succ_ne_zero j.succ hz
            · intro he
              have hz := F.injective (he.trans hF1.symm)
              have h' : j.succ = (0 : Fin (n + 1)) := Fin.succ_injective (n + 1) hz
              exact Fin.succ_ne_zero j h'
      have htotal : d b + n = 2 * q - 3 := by
        have hs := sum_two_heads d a b hab ha hb hrest
        omega
      apply P14CanonicalUPBTransport.of_dimensions (dimensions (d b) n) d F.symm
      · intro j
        simpa only [Equiv.apply_symm_apply] using (hdim (F.symm j)).symm
      · exact canonical hq ho hb (by omega) htotal

theorem multipartite {p : ℕ} (d : Fin p → ℕ) (hp : 3 ≤ p)
    (hd : ∀ j, 2 ≤ d j) (hthree : ∃ a, d a = 3) : Conclusion p d := by
  classical
  by_contra hnot
  obtain ⟨a,ha⟩ := hthree
  have hshape : ∃ b : Fin p, b ≠ a ∧ 3 ≤ d b ∧
      ∀ j, j ≠ a → j ≠ b → d j = 2 := by
    by_cases hs : ∀ j, j ≠ a → d j = 2
    · exact False.elim (hnot (P14QutritOnlyCanonical.multipartite d hp ⟨a,ha,hs⟩))
    push_neg at hs
    obtain ⟨b,hba,hb⟩ := hs
    have hb3 : 3 ≤ d b := by have h := hd b; omega
    refine ⟨b,hba,hb3,?_⟩
    intro j hja hjb
    by_contra hj
    have hj3 : 3 ≤ d j := by have h := hd j; omega
    exact hnot (P14QutritThreeCanonical.multipartite d hp hd
      ⟨a,b,j,hba.symm,hja.symm,hjb.symm,ha,hb3,hj3⟩)
  obtain ⟨b,hba,hb,hrest⟩ := hshape
  have hsum0 := sum_two_heads d a b hba.symm ha hb hrest
  have hbi : ¬ (p = 2 ∧ ∃ j, d j = 2) := by rintro ⟨he,_⟩; omega
  obtain ⟨_,_,hr⟩ :=
    P14CanonicalResidualAfterEight.necessary_conditions (by omega) d hd hbi hnot
  have hmod : (2 + ∑ j, (d j - 1)) % 4 = 2 := by
    rcases hr with hp2 | hmod
    · omega
    · exact hmod
  have hnq : ¬ (∀ j, d j = 2) := by intro h; have hh := h a; omega
  have h8 : (∑ j, (d j - 1)) ≠ 8 := by
    intro he
    exact hnot (P14TenRowFullCanonical.multipartite d hp hd hnq he)
  let S := ∑ j, (d j - 1)
  have hS : S % 4 = 0 ∧ 12 ≤ S := by dsimp only [S]; omega
  let q := (S + 2) / 2
  have hq : 7 ≤ q := by dsimp [q]; omega
  have ho : Odd q := by refine ⟨S / 4,?_⟩; dsimp [q]; omega
  letI : NeZero q := ⟨by omega⟩
  have hsum : (∑ j, (d j - 1)) = 2 * q - 2 := by
    change S = 2 * q - 2
    dsimp [q]
    omega
  exact hnot (with_factors hq ho d hp a b hba.symm ha hb hrest hsum)

end P14QutritFullCanonical
end
end

