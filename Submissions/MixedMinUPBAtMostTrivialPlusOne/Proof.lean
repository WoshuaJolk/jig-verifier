/- Modification: quadratic_irreducible specializes the degree2/3 divisor/root argument to degree2 and explicitly normalizes the leading coefficient. -/

/-! The explicit exceptional-ququart quadratic is irreducible over the
complex rational function field, by the checked simple-root discriminant
obstruction. This is an actual irreducibility theorem, not a premise
delegated to a caller. -/

noncomputable section
namespace P14QuquartCurve
open Polynomial P14QuquartDiscriminant

def embed : ℂ[X] →+* RatFunc ℂ := algebraMap ℂ[X] (RatFunc ℂ)

def curve (r : ℂ) : Polynomial (RatFunc ℂ) :=
  C (embed (A r)) * X ^ 2 + C (-embed (B r)) * X + C (embed (K r))

theorem A_ne_zero (r : ℂ) : A r ≠ 0 :=
  mul_ne_zero X_ne_zero (X_add_C_ne_zero r)

theorem degree_two (r : ℂ) : (curve r).natDegree = 2 := by
  apply natDegree_quadratic
  exact RatFunc.algebraMap_ne_zero (A_ne_zero r)

theorem not_isRoot (r : ℂ) (hr : r ≠ 0) (h2 : r ^ 2 ≠ 2) (h4 : r ^ 2 ≠ 4)
    (z : RatFunc ℂ) : ¬ (curve r).IsRoot z := by
  intro hz
  have he : embed (A r) * z ^ 2 - embed (B r) * z + embed (K r) = 0 := by
    simpa only [curve, IsRoot.def, eval_add, eval_mul, eval_pow, eval_X, eval_C,
      neg_mul, sub_eq_add_neg] using hz
  have ht : embed z.denom ≠ 0 := RatFunc.algebraMap_ne_zero (RatFunc.denom_ne_zero z)
  have hn : embed z.num = z * embed z.denom :=
    (div_eq_iff ht).mp (RatFunc.num_div_denom z)
  apply no_rational_root r hr h2 h4 z.num z.denom (RatFunc.denom_ne_zero z)
  apply RatFunc.algebraMap_injective
  change embed (A r * z.num ^ 2 - B r * z.num * z.denom + K r * z.denom ^ 2) = embed 0
  rw [map_zero, map_add, map_sub, map_mul, map_mul, map_mul, map_mul, map_pow, map_pow]
  calc
    embed (A r) * embed z.num ^ 2 -
        embed (B r) * embed z.num * embed z.denom +
        embed (K r) * embed z.denom ^ 2 =
      embed z.denom ^ 2 * (embed (A r) * z ^ 2 - embed (B r) * z + embed (K r)) := by
        rw [hn]
        ring
    _ = 0 := by rw [he, mul_zero]

/-- Degree-two specialization of the standard monic divisor criterion.
The approach follows Mathlib's SpecificDegree proof (Apache-2.0, Anne
Baanen and Alex J. Best); only already cached imported lemmas are used. -/
private theorem quadratic_irreducible {F : Type*} [Field F] (p : F[X])
    (hp : p.natDegree = 2) (hroot : ∀ z, ¬ p.IsRoot z) : Irreducible p := by
  have hp0 : p ≠ 0 := by intro h; simp [h] at hp
  let m := p * C p.leadingCoeff⁻¹
  have hm : m.Monic := monic_mul_leadingCoeff_inv hp0
  have hmd : m.natDegree = 2 := by
    dsimp [m]
    rw [natDegree_mul_leadingCoeff_inv _ hp0, hp]
  have hm1 : m ≠ 1 := by intro h; simp [h] at hmd
  apply irreducible_mul_leadingCoeff_inv.mp
  apply (hm.irreducible_iff_lt_natDegree_lt hm1).mpr
  intro q hq hqd hdiv
  have hq1 : q.natDegree = 1 := by
    rw [hmd, Finset.mem_Ioc] at hqd
    omega
  have hd : q ∣ p := (dvd_mul_leadingCoeff_inv hp0).mp hdiv
  rw [hq.eq_X_add_C hq1, ← sub_neg_eq_add, ← C_neg] at hd
  exact hroot _ (dvd_iff_isRoot.mp hd)

theorem irreducible (r : ℂ) (hr : r ≠ 0) (h2 : r ^ 2 ≠ 2) (h4 : r ^ 2 ≠ 4) :
    Irreducible (curve r) := by
  exact quadratic_irreducible (curve r) (degree_two r) (not_isRoot r hr h2 h4)

end P14QuquartCurve

end
end

section

/-!
A nonzero resultant certificate for an irreducible nonconstant polynomial
over a GCD domain. All resultant degree arguments are kept explicit when
mapping coefficients. The common-root identity uses fixed upper bounds and
therefore does not assume that a coefficient specialization preserves degree.

These algebraic statements do not construct a positive matching patch, prove
its polynomial density, or establish the full mixed UPB bound.
-/

namespace P14IrreducibleResultantAvoidance

open Polynomial

section FractionField

variable {A : Type*} [CommRing A] [IsDomain A] [IsGCDMonoid A]

/-- Gauss's lemma derives coprimality after passing to a fraction field. -/
theorem fraction_map_isCoprime
    (F : Type*) [Field F] [Algebra A F] [IsFractionRing A F]
    {G Q : A[X]} (hG : Irreducible G) (hDegree : G.natDegree ≠ 0)
    (hNotDvd : ¬ G ∣ Q) :
    IsCoprime (G.map (algebraMap A F)) (Q.map (algebraMap A F)) := by
  have hPrimitive : G.IsPrimitive := hG.isPrimitive hDegree
  have hIrreducible : Irreducible (G.map (algebraMap A F)) :=
    (hPrimitive.irreducible_iff_irreducible_map_fraction_map (K := F)).mp hG
  apply hIrreducible.coprime_iff_not_dvd.mpr
  intro hDvd
  exact hNotDvd (hPrimitive.dvd_of_fraction_map_dvd_fraction_map hDvd)

/-- The resultant computed over the original coefficient domain is nonzero. -/
theorem resultant_ne_zero_of_irreducible
    (F : Type*) [Field F] [Algebra A F] [IsFractionRing A F]
    {G Q : A[X]} (hG : Irreducible G) (hDegree : G.natDegree ≠ 0)
    (hNotDvd : ¬ G ∣ Q) :
    resultant G Q G.natDegree Q.natDegree ≠ 0 := by
  have hFraction := Polynomial.resultant_ne_zero
    (G.map (algebraMap A F)) (Q.map (algebraMap A F))
    (fraction_map_isCoprime F hG hDegree hNotDvd)
  have hInjective := IsFractionRing.injective A F
  have hMapped :
      algebraMap A F (resultant G Q G.natDegree Q.natDegree) ≠ 0 := by
    simpa only [natDegree_map_eq_of_injective hInjective, resultant_map_map]
      using hFraction
  intro hZero
  exact hMapped (by simp only [hZero, map_zero])

/-- Nonvanishing and bounded-degree Bezout witnesses use one exact resultant. -/
theorem resultant_certificate_of_irreducible
    (F : Type*) [Field F] [Algebra A F] [IsFractionRing A F]
    {G Q : A[X]} (hG : Irreducible G) (hDegree : G.natDegree ≠ 0)
    (hNotDvd : ¬ G ∣ Q) :
    resultant G Q G.natDegree Q.natDegree ≠ 0 ∧
      ∃ U V : A[X], U.degree < ↑Q.natDegree ∧ V.degree < ↑G.natDegree ∧
        G * U + Q * V = C (resultant G Q G.natDegree Q.natDegree) := by
  exact ⟨resultant_ne_zero_of_irreducible F hG hDegree hNotDvd,
    exists_mul_add_mul_eq_C_resultant G Q le_rfl le_rfl (Or.inl hDegree)⟩

end FractionField

section Specialization

variable {A B : Type*} [CommRing A] [CommRing B]

/-- Every common root kills the coefficient image of a fixed-degree resultant.
No injectivity or preservation of polynomial degree is required of `φ`. -/
theorem map_resultant_eq_zero_of_common_root
    {G Q : A[X]} {m n : ℕ}
    (hG : G.natDegree ≤ m) (hQ : Q.natDegree ≤ n) (hDegree : m ≠ 0 ∨ n ≠ 0)
    (φ : A →+* B) (x : B)
    (hGRoot : G.eval₂ φ x = 0) (hQRoot : Q.eval₂ φ x = 0) :
    φ (resultant G Q m n) = 0 := by
  obtain ⟨U, V, _hU, _hV, hIdentity⟩ :=
    exists_mul_add_mul_eq_C_resultant G Q hG hQ hDegree
  have hEvaluation := congrArg (fun P : A[X] => P.eval₂ φ x) hIdentity
  simpa only [eval₂_add, eval₂_mul, eval₂_C, hGRoot, hQRoot, zero_mul, zero_add]
    using hEvaluation.symm

end Specialization


end P14IrreducibleResultantAvoidance
end

section

/-! Irreducibility of the explicit two-variable ququart equation before
passing to rational functions. A Bezout identity between its leading and
constant coefficients proves primitivity, so Gauss's lemma applies. -/

noncomputable section
namespace P14QuquartClearedCurve
open Polynomial P14QuquartDiscriminant

def curve (r : ℂ) : Polynomial (ℂ[X]) :=
  C (A r) * X ^ 2 + C (-B r) * X + C (K r)

theorem mapped (r : ℂ) :
    (curve r).map P14QuquartCurve.embed = P14QuquartCurve.curve r := by
  simp only [curve, P14QuquartCurve.curve, Polynomial.map_add, Polynomial.map_mul,
    Polynomial.map_pow, Polynomial.map_neg, map_C, map_X, map_neg]

theorem coefficient_bezout (r : ℂ) :
    (C r) ^ 2 * A r - (C r * X + (C r) ^ 2 - 1) * K r = C (1 - r ^ 2) := by
  simp only [A, K, map_sub, map_one, map_pow]
  ring

theorem primitive (r : ℂ) (h1 : r ^ 2 ≠ 1) : (curve r).IsPrimitive := by
  intro g hg
  have hd := (C_dvd_iff_dvd_coeff g (curve r)).mp hg
  have ha : g ∣ A r := by
    simpa [curve, coeff_add, coeff_C_mul, coeff_mul_X] using hd 2
  have hk : g ∣ K r := by
    simpa [curve, coeff_add, coeff_C_mul, coeff_mul_X] using hd 0
  have hc : g ∣ C (1 - r ^ 2) := by
    rw [← coefficient_bezout]
    exact dvd_sub (dvd_mul_of_dvd_right ha _) (dvd_mul_of_dvd_right hk _)
  apply isUnit_of_dvd_unit hc
  apply isUnit_C.mpr
  exact isUnit_iff_ne_zero.mpr (sub_ne_zero.mpr (Ne.symm h1))

theorem irreducible (r : ℂ) (hr : r ≠ 0) (h1 : r ^ 2 ≠ 1)
    (h2 : r ^ 2 ≠ 2) (h4 : r ^ 2 ≠ 4) : Irreducible (curve r) := by
  apply ((primitive r h1).irreducible_iff_irreducible_map_fraction_map
    (K := RatFunc ℂ)).mpr
  change Irreducible ((curve r).map P14QuquartCurve.embed)
  rw [mapped]
  exact P14QuquartCurve.irreducible r hr h2 h4

end P14QuquartClearedCurve

end
end

section

/-! Exact bivariate polynomial rows for the exceptional ququart family.
V is multiplied by a(a+r)(1+ra) after coordinate normalization. At a=0
it becomes a nonzero final coordinate, proving an actual three-U/one-V
minor is not divisible by the checked parameter curve. -/

noncomputable section
namespace P14QuquartPolynomialRows
open Polynomial Matrix P14QuquartDiscriminant
open scoped BigOperators

abbrev Ring := Polynomial (Polynomial ℂ)
def c (z : ℂ) : Ring := C (C z)
def a : Ring := C X

def u (w : ℂ) : Fin 4 → ℂ := fun k => w ^ k.val
def U (w : ℂ) : Fin 4 → Ring := fun k => c (w ^ k.val)
def V (r xi w : ℂ) : Fin 4 → Ring :=
  ![-a * c (xi ^ 3) * X * (a + c r) * (1 + c r * a),
    a * c (xi ^ 2) * (1 + c r * X) * (1 + c r * a) * c w,
    -a * c xi * (c r + X) * (a + c r) * c (w ^ 2),
    (a + c r) * (1 + c r * a) * c (w ^ 3)]

def point (s z : ℂ) : Ring →+* ℂ :=
  (evalRingHom s).comp (evalRingHom (C z))

theorem point_U (s z w : ℂ) : (fun k => point s z (U w k)) = u w := by
  funext k
  simp [U, u, c, point]

theorem point_V_zero (r xi z w : ℂ) :
    (fun k => point 0 z (V r xi w k)) = ![0, 0, 0, r * w ^ 3] := by
  funext k
  fin_cases k <;> simp [V, a, c, point]

theorem point_curve_zero (r : ℂ) (hs : r ^ 3 - 3 * r ≠ 0) :
    point 0 (r ^ 3 - 3 * r)⁻¹ (P14QuquartClearedCurve.curve r) = 0 := by
  simp [point, P14QuquartClearedCurve.curve, A, B, K, H]
  rw [show 3 * r - r ^ 3 = -(r ^ 3 - 3 * r) by ring,
    neg_mul, mul_inv_cancel₀ hs]
  ring

def threeOne (r xi : ℂ) (x : Fin 3 → ℂ) (y : ℂ) : Matrix (Fin 4) (Fin 4) Ring :=
  ![U (x 0), U (x 1), U (x 2), V r xi y]

def axisRows (r : ℂ) (x : Fin 3 → ℂ) (y : ℂ) : Matrix (Fin 4) (Fin 4) ℂ :=
  ![u (x 0), u (x 1), u (x 2), ![0, 0, 0, r * y ^ 3]]

theorem axis_det_ne_zero (r : ℂ) (hr : r ≠ 0) (x : Fin 3 → ℂ)
    (hx : Function.Injective x) (y : ℂ) (hy : y ≠ 0) : (axisRows r x y).det ≠ 0 := by
  intro h
  obtain ⟨w, hw, hker⟩ := Matrix.exists_mulVec_eq_zero_iff.mpr h
  have ht : r * y ^ 3 * w 3 = 0 := by
    simpa [axisRows, Matrix.mulVec, dotProduct, Fin.sum_univ_succ] using congrFun hker 3
  have h3 : w 3 = 0 :=
    (mul_eq_zero.mp ht).resolve_left (mul_ne_zero hr (pow_ne_zero _ hy))
  have hhead : (fun j : Fin 3 => w j.castSucc) = 0 := by
    apply Matrix.eq_zero_of_forall_index_sum_pow_mul_eq_zero (f := x) hx
    intro i
    have hi := congrFun hker i.castSucc
    fin_cases i <;>
      simpa [axisRows, u, Matrix.mulVec, dotProduct, Fin.sum_univ_succ, h3] using hi
  apply hw
  funext i
  fin_cases i
  · exact congrFun hhead 0
  · exact congrFun hhead 1
  · exact congrFun hhead 2
  · exact h3

theorem point_threeOne (r xi z : ℂ) (x : Fin 3 → ℂ) (y : ℂ) :
    (point 0 z).mapMatrix (threeOne r xi x y) = axisRows r x y := by
  apply Matrix.ext
  intro i k
  fin_cases i
  · exact congrFun (point_U 0 z (x 0)) k
  · exact congrFun (point_U 0 z (x 1)) k
  · exact congrFun (point_U 0 z (x 2)) k
  · exact congrFun (point_V_zero r xi z y) k

theorem threeOne_not_dvd (r xi : ℂ) (hr : r ≠ 0) (hs : r ^ 3 - 3 * r ≠ 0)
    (x : Fin 3 → ℂ) (hx : Function.Injective x) (y : ℂ) (hy : y ≠ 0) :
    ¬ P14QuquartClearedCurve.curve r ∣ (threeOne r xi x y).det := by
  intro h
  have hd := (point 0 (r ^ 3 - 3 * r)⁻¹).map_dvd h
  change point 0 (r ^ 3 - 3 * r)⁻¹ (P14QuquartClearedCurve.curve r) ∣
    point 0 (r ^ 3 - 3 * r)⁻¹ (threeOne r xi x y).det at hd
  rw [point_curve_zero r hs, zero_dvd_iff] at hd
  rw [(point 0 (r ^ 3 - 3 * r)⁻¹).map_det, point_threeOne] at hd
  exact axis_det_ne_zero r hr x hx y hy hd

end P14QuquartPolynomialRows

end
end

section

/-! An actual positive real parameter interval and explicit upper-half-plane
root of the ququart equation. The interval is above a=1, so the root has
squared norm below1 and cannot be an extra root of unity. -/

noncomputable section
namespace P14QuquartParameterBranch
open Filter P14QuquartPolynomialRows
open scoped Topology

def A (r a : ℝ) : ℝ := a * (a + r)
def B (r a : ℝ) : ℝ := (r ^ 3 - 3 * r) * (a ^ 2 + r * a + 1) - 2 * a
def K (r a : ℝ) : ℝ := 1 + r * a
def D (r a : ℝ) : ℝ := B r a ^ 2 - 4 * A r a * K r a

def root (r a : ℝ) : ℂ :=
  ((B r a / (2 * A r a) : ℝ) : ℂ) +
    ((Real.sqrt (-D r a) / (2 * A r a) : ℝ) : ℂ) * Complex.I

theorem discriminant_one (r : ℝ) :
    D r 1 = ((r ^ 2 - 4) * (r + 1) ^ 2) * (r * (r + 1) * (r ^ 2 + r - 4)) := by
  dsimp [D, A, B, K]
  ring

theorem discriminant_one_neg (r : ℝ) (hr : (9 : ℝ) / 5 < r) (h2 : r < 2) :
    D r 1 < 0 := by
  rw [discriminant_one]
  have hp : 0 < r := by linarith
  have hsq : r ^ 2 < 4 := by nlinarith
  have hq : 0 < r ^ 2 + r - 4 := by nlinarith
  have hplus : 0 < r + 1 := by linarith
  exact mul_neg_of_neg_of_pos
    (mul_neg_of_neg_of_pos (sub_neg.mpr hsq) (sq_pos_of_pos hplus))
    (mul_pos (mul_pos hp hplus) hq)

theorem negative_interval (r : ℝ) (hr : (9 : ℝ) / 5 < r) (h2 : r < 2) :
    ∃ b : ℝ, 1 < b ∧ ∀ a : ℝ, 1 < a → a < b → D r a < 0 := by
  have hc : ContinuousAt (fun a : ℝ => D r a) 1 := by
    unfold D A B K
    fun_prop
  have he : ∀ᶠ a in 𝓝 (1 : ℝ), D r a < 0 :=
    hc.eventually (eventually_lt_nhds (discriminant_one_neg r hr h2))
  obtain ⟨e, hepos, he⟩ := Metric.eventually_nhds_iff.mp he
  refine ⟨1 + e, by linarith, ?_⟩
  intro a ha hab
  apply he
  rw [Real.dist_eq, abs_of_pos (by linarith : 0 < a - 1)]
  linarith

theorem root_im_pos (r a : ℝ) (hA : 0 < A r a) (hD : D r a < 0) :
    0 < (root r a).im := by
  simpa only [root, Complex.add_im, Complex.ofReal_im, Complex.mul_im,
    Complex.ofReal_re, Complex.I_im, Complex.I_re, mul_one, mul_zero, zero_add, add_zero] using div_pos (Real.sqrt_pos.mpr (neg_pos.mpr hD)) (mul_pos (by norm_num : (0 : ℝ) < 2) hA)

theorem root_normSq (r a : ℝ) (hA : 0 < A r a) (hD : D r a < 0) :
    Complex.normSq (root r a) = K r a / A r a := by
  rw [root, Complex.normSq_add_mul_I]
  have hs := Real.sq_sqrt (neg_nonneg.mpr hD.le)
  generalize hx : Real.sqrt (-D r a) = x at *
  dsimp [D] at hs
  field_simp [hA.ne']
  nlinarith

theorem root_trace (r a : ℝ) (hA : 0 < A r a) :
    root r a + star (root r a) = ((B r a / A r a : ℝ) : ℂ) := by
  rw [Complex.star_def, Complex.add_conj]
  apply congrArg Complex.ofReal
  simp only [root, Complex.add_re, Complex.ofReal_re, Complex.mul_re,
    Complex.I_re, Complex.ofReal_im, Complex.I_im, mul_zero, zero_mul, sub_zero, add_zero]
  field_simp [hA.ne']

theorem point_curve (r a : ℝ) (z : ℂ) :
    point (a : ℂ) z (P14QuquartClearedCurve.curve (r : ℂ)) =
      (A r a : ℂ) * z ^ 2 - (B r a : ℂ) * z + (K r a : ℂ) := by
  simp [point, P14QuquartClearedCurve.curve, P14QuquartDiscriminant.A,
    P14QuquartDiscriminant.B, P14QuquartDiscriminant.K, P14QuquartDiscriminant.H,
    A, B, K]
  ring

theorem root_curve (r a : ℝ) (hA : 0 < A r a) (hD : D r a < 0) :
    point (a : ℂ) (root r a) (P14QuquartClearedCurve.curve (r : ℂ)) = 0 := by
  have hz : root r a ^ 2 - ((B r a / A r a : ℝ) : ℂ) * root r a +
      ((K r a / A r a : ℝ) : ℂ) = 0 := by
    rw [← root_trace r a hA, ← root_normSq r a hA hD, Complex.star_def,
      ← Complex.mul_conj]
    ring
  rw [point_curve]
  calc
    _ = (A r a : ℂ) * (root r a ^ 2 - ((B r a / A r a : ℝ) : ℂ) * root r a +
        ((K r a / A r a : ℝ) : ℂ)) := by
      push_cast
      field_simp [Complex.ofReal_ne_zero.mpr hA.ne']
    _ = 0 := by rw [hz, mul_zero]

structure Admissible (r a : ℝ) (z : ℂ) : Prop where
  a_gt_one : 1 < a
  shifted_pos : 0 < a + r
  affine_pos : 0 < 1 + r * a
  sigma_pos : 0 < r ^ 3 - 3 * r
  im_pos : 0 < z.im
  normSq_eq : Complex.normSq z = K r a / A r a
  trace_eq : z + star z = ((B r a / A r a : ℝ) : ℂ)
  curve_eq : point (a : ℂ) z (P14QuquartClearedCurve.curve (r : ℂ)) = 0
  normSq_lt_one : Complex.normSq z < 1

theorem root_admissible (r a : ℝ) (hr : (9 : ℝ) / 5 < r)
    (ha : 1 < a) (hD : D r a < 0) : Admissible r a (root r a) := by
  have hp : 0 < r := by linarith
  have hap : 0 < a := by linarith
  have hshift : 0 < a + r := add_pos hap hp
  have haff : 0 < 1 + r * a := by positivity
  have hA : 0 < A r a := mul_pos hap hshift
  have hsq : 3 < r ^ 2 := by nlinarith
  have hsigma : 0 < r ^ 3 - 3 * r := by
    have := mul_pos hp (sub_pos.mpr hsq)
    nlinarith
  refine ⟨ha, hshift, haff, hsigma, root_im_pos r a hA hD,
    root_normSq r a hA hD, root_trace r a hA, root_curve r a hA hD, ?_⟩
  rw [root_normSq r a hA hD]
  apply (div_lt_one hA).mpr
  dsimp [K, A]
  nlinarith

theorem exists_admissible_interval (r : ℝ) (hr : (9 : ℝ) / 5 < r) (h2 : r < 2) :
    ∃ b : ℝ, 1 < b ∧ ∀ a : ℝ, 1 < a → a < b → Admissible r a (root r a) := by
  obtain ⟨b, hb, hd⟩ := negative_interval r hr h2
  exact ⟨b, hb, fun a ha hab => root_admissible r a hr ha (hd a ha hab)⟩

end P14QuquartParameterBranch

end
end

section

/-! First-order minors for two U rows and two V rows. The row difference
is exactly divisible by the parameter a; irreducibility of the checked
curve allows this factor to be cancelled before specialization. -/

noncomputable section
namespace P14QuquartFirstJet
open Polynomial Matrix P14QuquartPolynomialRows
open scoped BigOperators

def delta (r xi s t : ℂ) : Fin 4 → Ring :=
  ![-c (xi ^ 3) * X * (a + c r) * (1 + c r * a) * (c (t ^ 3) - c (s ^ 3)),
    c (xi ^ 2) * (1 + c r * X) * (1 + c r * a) * (c s * c (t ^ 3) - c t * c (s ^ 3)),
    -c xi * (c r + X) * (a + c r) * (c (s ^ 2) * c (t ^ 3) - c (t ^ 2) * c (s ^ 3)),
    0]

theorem delta_scaled (r xi s t : ℂ) :
    a • delta r xi s t = c (t ^ 3) • V r xi s + (-c (s ^ 3)) • V r xi t := by
  funext k
  fin_cases k <;> simp [delta, V, Pi.smul_apply, smul_eq_mul] <;> ring

def minor (r xi x₁ x₂ s t : ℂ) : Matrix (Fin 4) (Fin 4) Ring :=
  ![U x₁, U x₂, V r xi s, V r xi t]

def reduced (r xi x₁ x₂ s t : ℂ) : Matrix (Fin 4) (Fin 4) Ring :=
  (minor r xi x₁ x₂ s t).updateRow 3 (delta r xi s t)

theorem scaled_det (r xi x₁ x₂ s t : ℂ) :
    a * (reduced r xi x₁ x₂ s t).det =
      -c (s ^ 3) * (minor r xi x₁ x₂ s t).det := by
  rw [reduced, ← det_updateRow_smul, delta_scaled, det_updateRow_add,
    det_updateRow_smul, det_updateRow_smul]
  have hz : ((minor r xi x₁ x₂ s t).updateRow 3 (V r xi s)).det = 0 := by
    exact det_updateRow_eq_zero (M := minor r xi x₁ x₂ s t)
      (i := (2 : Fin 4)) (j := 3) (by decide)
  have he : (minor r xi x₁ x₂ s t).updateRow 3 (V r xi t) =
      minor r xi x₁ x₂ s t := updateRow_eq_self _ _
  rw [hz, he, mul_zero, zero_add]

theorem curve_not_dvd_a (r : ℂ) : ¬ P14QuquartClearedCurve.curve r ∣ a := by
  intro hd
  have hA : P14QuquartDiscriminant.A r ≠ 0 :=
    mul_ne_zero X_ne_zero (monic_X_add_C r).ne_zero
  have hcoeff : (P14QuquartClearedCurve.curve r).coeff 2 ≠ 0 := by
    simpa [P14QuquartClearedCurve.curve, coeff_add, coeff_C_mul, coeff_mul_X] using hA
  have hlo := le_natDegree_of_ne_zero hcoeff
  have hhi := natDegree_le_of_dvd hd (show a ≠ 0 by simp [a])
  simp only [a, natDegree_C] at hhi
  omega

theorem curve_dvd_reduced (r xi x₁ x₂ s t : ℂ)
    (hr : r ≠ 0) (h1 : r ^ 2 ≠ 1) (h2 : r ^ 2 ≠ 2) (h4 : r ^ 2 ≠ 4)
    (hd : P14QuquartClearedCurve.curve r ∣ (minor r xi x₁ x₂ s t).det) :
    P14QuquartClearedCurve.curve r ∣ (reduced r xi x₁ x₂ s t).det := by
  have hm : P14QuquartClearedCurve.curve r ∣ a * (reduced r xi x₁ x₂ s t).det := by
    rw [scaled_det]
    exact dvd_mul_of_dvd_right hd _
  exact ((P14QuquartClearedCurve.irreducible r hr h1 h2 h4).prime.dvd_or_dvd hm).resolve_left
    (curve_not_dvd_a r)

def d (r xi z : ℂ) : Fin 3 → ℂ :=
  ![-xi ^ 3 * z * r, xi ^ 2 * (1 + r * z), -xi * (r + z) * r]

def jetRow (b : Fin 3 → ℂ) (s t : ℂ) : Fin 4 → ℂ :=
  ![b 0 * (t ^ 3 - s ^ 3), b 1 * (s * t ^ 3 - t * s ^ 3),
    b 2 * (s ^ 2 * t ^ 3 - t ^ 2 * s ^ 3), 0]

def jetMatrix (r x₁ x₂ s t : ℂ) (b : Fin 3 → ℂ) : Matrix (Fin 4) (Fin 4) ℂ :=
  ![u x₁, u x₂, ![0, 0, 0, r * s ^ 3], jetRow b s t]

def f (b : Fin 3 → ℂ) (x₁ x₂ w : ℂ) : ℂ :=
  b 0 * x₁ * x₂ - b 1 * (x₁ + x₂) * w + b 2 * w ^ 2

theorem point_delta (r xi z s t : ℂ) :
    (fun k => point 0 z (delta r xi s t k)) = jetRow (d r xi z) s t := by
  funext k
  fin_cases k <;> simp [delta, d, jetRow, a, c, point]

theorem point_reduced (r xi z x₁ x₂ s t : ℂ) :
    (point 0 z).mapMatrix (reduced r xi x₁ x₂ s t) = jetMatrix r x₁ x₂ s t (d r xi z) := by
  apply Matrix.ext
  intro i k
  fin_cases i
  · simpa [reduced, minor, jetMatrix, Matrix.updateRow] using congrFun (point_U 0 z x₁) k
  · simpa [reduced, minor, jetMatrix, Matrix.updateRow] using congrFun (point_U 0 z x₂) k
  · simpa [reduced, minor, jetMatrix, Matrix.updateRow] using congrFun (point_V_zero r xi z s) k
  · simpa [reduced, minor, jetMatrix, Matrix.updateRow] using congrFun (point_delta r xi z s t) k

theorem jet_det (r x₁ x₂ s t : ℂ) (b : Fin 3 → ℂ) :
    (jetMatrix r x₁ x₂ s t b).det =
      -(r * s ^ 3 * (x₂ - x₁)) * (t ^ 3 * f b x₁ x₂ s - s ^ 3 * f b x₁ x₂ t) := by
  let B : Matrix (Fin 3) (Fin 3) ℂ :=
    ![![1, x₁, x₁ ^ 2], ![1, x₂, x₂ ^ 2],
      ![b 0 * (t ^ 3 - s ^ 3), b 1 * (s * t ^ 3 - t * s ^ 3),
        b 2 * (s ^ 2 * t ^ 3 - t ^ 2 * s ^ 3)]]
  have hm : (jetMatrix r x₁ x₂ s t b).submatrix
      (2 : Fin 4).succAbove (3 : Fin 4).succAbove = B := by
    ext i j
    fin_cases i <;> fin_cases j <;> first | rfl | exact pow_one _
  have he : ∀ j : Fin 4, jetMatrix r x₁ x₂ s t b 2 j =
      if j = 3 then r * s ^ 3 else 0 := by
    intro j
    fin_cases j <;> rfl
  calc
    _ = -(r * s ^ 3) * ((jetMatrix r x₁ x₂ s t b).submatrix
        (2 : Fin 4).succAbove (3 : Fin 4).succAbove).det := by
      rw [det_succ_row _ (2 : Fin 4)]
      simp_rw [he]
      simp only [mul_ite, mul_zero, ite_mul, zero_mul]
      rw [Finset.sum_ite_eq']
      norm_num
    _ = _ := by
      rw [hm, Matrix.det_fin_three]
      change -(r * s ^ 3) *
        (1 * x₂ * (b 2 * (s ^ 2 * t ^ 3 - t ^ 2 * s ^ 3)) -
         1 * x₂ ^ 2 * (b 1 * (s * t ^ 3 - t * s ^ 3)) -
         x₁ * 1 * (b 2 * (s ^ 2 * t ^ 3 - t ^ 2 * s ^ 3)) +
         x₁ * x₂ ^ 2 * (b 0 * (t ^ 3 - s ^ 3)) +
         x₁ ^ 2 * 1 * (b 1 * (s * t ^ 3 - t * s ^ 3)) -
         x₁ ^ 2 * x₂ * (b 0 * (t ^ 3 - s ^ 3))) = _
      dsimp [f]
      ring

theorem gap_zero_of_dvd (r xi x₁ x₂ s t : ℂ)
    (hr : r ≠ 0) (h1 : r ^ 2 ≠ 1) (h2 : r ^ 2 ≠ 2) (h4 : r ^ 2 ≠ 4)
    (hsigma : r ^ 3 - 3 * r ≠ 0) (hs : s ≠ 0) (hxx : x₂ ≠ x₁)
    (hd : P14QuquartClearedCurve.curve r ∣ (minor r xi x₁ x₂ s t).det) :
    t ^ 3 * f (d r xi (r ^ 3 - 3 * r)⁻¹) x₁ x₂ s -
      s ^ 3 * f (d r xi (r ^ 3 - 3 * r)⁻¹) x₁ x₂ t = 0 := by
  have hd' := (point 0 (r ^ 3 - 3 * r)⁻¹).map_dvd
    (curve_dvd_reduced r xi x₁ x₂ s t hr h1 h2 h4 hd)
  change point 0 (r ^ 3 - 3 * r)⁻¹ (P14QuquartClearedCurve.curve r) ∣
    point 0 (r ^ 3 - 3 * r)⁻¹ (reduced r xi x₁ x₂ s t).det at hd'
  rw [point_curve_zero r hsigma, zero_dvd_iff,
    (point 0 (r ^ 3 - 3 * r)⁻¹).map_det, point_reduced, jet_det] at hd'
  exact (mul_eq_zero.mp hd').resolve_left
    (neg_ne_zero.mpr (mul_ne_zero (mul_ne_zero hr (pow_ne_zero _ hs)) (sub_ne_zero.mpr hxx)))

end P14QuquartFirstJet

end
end

section

/-! A direct uniform obstruction to the exceptional-ququart first-order
rank identity for every q>=11. It uses the elementary norm bound3, so no
sharp extremal theorem about three roots on a grid is assumed. -/

noncomputable section
namespace P14QuquartLargeOrder

def rho (q : ℕ) : ℝ := 2 * Real.cos (Real.pi / q)
def sigma (q : ℕ) : ℝ := rho q ^ 3 - 3 * rho q

theorem sigma_trigonometric (q : ℕ) :
    sigma q = 2 * Real.cos (3 * (Real.pi / q)) := by
  simp only [sigma, rho, Real.cos_three_mul]
  ring

theorem rho_lower (q : ℕ) (hq : 11 ≤ q) : (19 : ℝ) / 10 < rho q := by
  have hqR : (11 : ℝ) ≤ q := by exact_mod_cast hq
  have hqpos : (0 : ℝ) < q := by linarith
  have ht : (0 : ℝ) ≤ Real.pi / q := (div_pos Real.pi_pos hqpos).le
  have hangle : Real.pi / q ≤ Real.pi / 10 :=
    div_le_div_of_nonneg_left Real.pi_pos.le (by norm_num) (by linarith)
  have hmono := Real.cos_le_cos_of_nonneg_of_le_pi ht
    (show Real.pi / 10 ≤ Real.pi by linarith [Real.pi_pos]) hangle
  have hcos : 0 ≤ Real.cos (Real.pi / 10) :=
    Real.cos_nonneg_of_mem_Icc (by constructor <;> linarith [Real.pi_pos])
  have hroot := Real.sq_sqrt (show (0 : ℝ) ≤ 5 by norm_num)
  have hrootpos := Real.sqrt_nonneg (5 : ℝ)
  have hrootlower : (111 : ℝ) / 50 < Real.sqrt 5 := by nlinarith
  have hd := Real.cos_two_mul (Real.pi / 10)
  rw [show 2 * (Real.pi / 10) = Real.pi / 5 by ring, Real.cos_pi_div_five] at hd
  have hc : (19 : ℝ) / 20 < Real.cos (Real.pi / 10) := by nlinarith
  dsimp [rho]
  linarith

theorem coefficient_gt_three (q : ℕ) (hq : 11 ≤ q) :
    3 < rho q * sigma q + 1 := by
  have hr := rho_lower q hq
  have hr2 : (361 : ℝ) / 100 < rho q ^ 2 := by nlinarith
  have hp := sq_nonneg (rho q ^ 2 - (361 : ℝ) / 100)
  dsimp [sigma]
  nlinarith

theorem root_sum_identity_impossible (q : ℕ) (hq : 11 ≤ q)
    (xi x₁ x₂ y₁ y₂ y₃ : ℂ)
    (hxi : ‖xi‖ = 1) (hx₁ : ‖x₁‖ = 1) (hx₂ : ‖x₂‖ = 1)
    (hy₁ : ‖y₁‖ = 1) (hy₂ : ‖y₂‖ = 1) (hy₃ : ‖y₃‖ = 1) :
    ((rho q * sigma q + 1 : ℝ) : ℂ) * y₁ * y₂ * y₃ ≠
      xi ^ 2 * x₁ * x₂ * (y₁ + y₂ + y₃) := by
  have hc := coefficient_gt_three q hq
  have hpos : 0 ≤ rho q * sigma q + 1 := by linarith
  have hbound : ‖y₁ + y₂ + y₃‖ ≤ 3 := by
    calc
      _ ≤ ‖y₁ + y₂‖ + ‖y₃‖ := norm_add_le _ _
      _ ≤ (‖y₁‖ + ‖y₂‖) + ‖y₃‖ := add_le_add (norm_add_le _ _) le_rfl
      _ = 3 := by rw [hy₁, hy₂, hy₃]; norm_num
  intro h
  have hn := congrArg norm h
  simp only [norm_mul, norm_pow, hxi, hx₁, hx₂, hy₁, hy₂, hy₃,
    one_pow, one_mul, mul_one, Complex.norm_real, Real.norm_eq_abs,
    abs_of_nonneg hpos] at hn
  linarith

end P14QuquartLargeOrder

end
end

section

/-! Actual two-U/three-V minors cannot all vanish identically on the
ququart parameter curve for q>=11. The coefficient relation is derived
by exact divided differences; no interpolation or rank premise is used. -/

noncomputable section
namespace P14QuquartTwoThree
open P14QuquartPolynomialRows P14QuquartFirstJet P14QuquartLargeOrder

theorem coefficient_relation (b : Fin 3 → ℂ) (x₁ x₂ : ℂ)
    (y : Fin 3 → ℂ) (hy : Function.Injective y) (hy0 : y 0 ≠ 0)
    (hg : ∀ i, (y i) ^ 3 * f b x₁ x₂ (y 0) -
      (y 0) ^ 3 * f b x₁ x₂ (y i) = 0) :
    b 2 * y 0 * y 1 * y 2 = b 0 * x₁ * x₂ * (y 0 + y 1 + y 2) := by
  let G : ℂ → ℂ := fun t =>
    b 0 * x₁ * x₂ * ((y 0) ^ 2 + y 0 * t + t ^ 2) -
    b 1 * (x₁ + x₂) * y 0 * t * (y 0 + t) +
    b 2 * (y 0) ^ 2 * t ^ 2
  have hG (i : Fin 3) (hi : i ≠ 0) : G (y i) = 0 := by
    have he : (y i - y 0) * G (y i) =
        (y i) ^ 3 * f b x₁ x₂ (y 0) - (y 0) ^ 3 * f b x₁ x₂ (y i) := by
      dsimp [G, f]
      ring
    rw [hg] at he
    exact (mul_eq_zero.mp he).resolve_left (sub_ne_zero.mpr (fun h => hi (hy h)))
  have he : (y 0) ^ 2 * (y 2 - y 1) *
      (b 0 * x₁ * x₂ * (y 0 + y 1 + y 2) - b 2 * y 0 * y 1 * y 2) = 0 := by
    calc
      _ = y 2 * (y 0 + y 2) * G (y 1) - y 1 * (y 0 + y 1) * G (y 2) := by
        dsimp [G]
        ring
      _ = 0 := by rw [hG 1 (by decide), hG 2 (by decide)]; ring
  have hn : y 2 - y 1 ≠ 0 :=
    sub_ne_zero.mpr (fun h => (by decide : (2 : Fin 3) ≠ 1) (hy h))
  exact (sub_eq_zero.mp ((mul_eq_zero.mp he).resolve_left
    (mul_ne_zero (pow_ne_zero _ hy0) hn))).symm

theorem identity_of_gaps (r xi x₁ x₂ : ℂ) (y : Fin 3 → ℂ)
    (hr : r ≠ 0) (hxi : xi ≠ 0) (hsigma : r ^ 3 - 3 * r ≠ 0)
    (hy : Function.Injective y) (hy0 : y 0 ≠ 0)
    (hg : ∀ i, (y i) ^ 3 * f (d r xi (r ^ 3 - 3 * r)⁻¹) x₁ x₂ (y 0) -
      (y 0) ^ 3 * f (d r xi (r ^ 3 - 3 * r)⁻¹) x₁ x₂ (y i) = 0) :
    (r * (r ^ 3 - 3 * r) + 1) * y 0 * y 1 * y 2 =
      xi ^ 2 * x₁ * x₂ * (y 0 + y 1 + y 2) := by
  have hc := coefficient_relation (d r xi (r ^ 3 - 3 * r)⁻¹) x₁ x₂ y hy hy0 hg
  change (-xi * (r + (r ^ 3 - 3 * r)⁻¹) * r) * y 0 * y 1 * y 2 =
    (-xi ^ 3 * (r ^ 3 - 3 * r)⁻¹ * r) * x₁ * x₂ * (y 0 + y 1 + y 2) at hc
  have he : (-xi * r * (r ^ 3 - 3 * r)⁻¹) *
      ((r * (r ^ 3 - 3 * r) + 1) * y 0 * y 1 * y 2 -
        xi ^ 2 * x₁ * x₂ * (y 0 + y 1 + y 2)) = 0 := by
    calc
      _ = (-xi * (r + (r ^ 3 - 3 * r)⁻¹) * r) * y 0 * y 1 * y 2 -
          (-xi ^ 3 * (r ^ 3 - 3 * r)⁻¹ * r) * x₁ * x₂ * (y 0 + y 1 + y 2) := by
        linear_combination -xi * r ^ 2 * y 0 * y 1 * y 2 * (mul_inv_cancel₀ hsigma)
      _ = 0 := sub_eq_zero.mpr hc
  exact sub_eq_zero.mp ((mul_eq_zero.mp he).resolve_left
    (mul_ne_zero (mul_ne_zero (neg_ne_zero.mpr hxi) hr) (inv_ne_zero hsigma)))

theorem real_parameters (q : ℕ) (hq : 11 ≤ q) :
    rho q ≠ 0 ∧ (rho q) ^ 2 ≠ 1 ∧ (rho q) ^ 2 ≠ 2 ∧
      (rho q) ^ 2 ≠ 4 ∧ (rho q) ^ 3 - 3 * rho q ≠ 0 := by
  have hlo := rho_lower q hq
  have hpos : 0 < rho q := by linarith
  have hsq : 3 < (rho q) ^ 2 := by nlinarith
  have hqR : (11 : ℝ) ≤ q := by exact_mod_cast hq
  have hqp : (0 : ℝ) < q := by linarith
  have ht : 0 < Real.pi / q := div_pos Real.pi_pos hqp
  have htp : Real.pi / q ≤ Real.pi :=
    div_le_self Real.pi_pos.le (by linarith)
  have hc := Real.cos_lt_cos_of_nonneg_of_le_pi (by norm_num : (0 : ℝ) ≤ 0) htp ht
  have hup : rho q < 2 := by simpa [rho] using mul_lt_mul_of_pos_left hc (by norm_num : (0 : ℝ) < 2)
  have h4 : (rho q) ^ 2 < 4 := by nlinarith
  refine ⟨hpos.ne', (by nlinarith), (by nlinarith), ne_of_lt h4, ?_⟩
  apply ne_of_gt
  have hm := mul_pos hpos (sub_pos.mpr hsq)
  nlinarith

theorem exists_minor_not_dvd (q : ℕ) (hq : 11 ≤ q)
    (xi x₁ x₂ : ℂ) (y : Fin 3 → ℂ)
    (hxi : ‖xi‖ = 1) (hx₁ : ‖x₁‖ = 1) (hx₂ : ‖x₂‖ = 1)
    (hyunit : ∀ i, ‖y i‖ = 1) (hxx : x₂ ≠ x₁) (hy : Function.Injective y) :
    ∃ i : Fin 3, i ≠ 0 ∧
      ¬ P14QuquartClearedCurve.curve (rho q : ℂ) ∣
        (minor (rho q) xi x₁ x₂ (y 0) (y i)).det := by
  obtain ⟨hrR, h1R, h2R, h4R, hsR⟩ := real_parameters q hq
  have hr : (rho q : ℂ) ≠ 0 := by exact_mod_cast hrR
  have h1 : (rho q : ℂ) ^ 2 ≠ 1 := by exact_mod_cast h1R
  have h2 : (rho q : ℂ) ^ 2 ≠ 2 := by exact_mod_cast h2R
  have h4 : (rho q : ℂ) ^ 2 ≠ 4 := by exact_mod_cast h4R
  have hs : (rho q : ℂ) ^ 3 - 3 * (rho q : ℂ) ≠ 0 := by exact_mod_cast hsR
  have hxi0 : xi ≠ 0 := by intro h; simp [h] at hxi
  have hy0 : y 0 ≠ 0 := by intro h; simpa [h] using hyunit 0
  by_contra hn
  push Not at hn
  have hg : ∀ i, (y i) ^ 3 * f (d (rho q) xi ((rho q : ℂ) ^ 3 - 3 * rho q)⁻¹) x₁ x₂ (y 0) -
      (y 0) ^ 3 * f (d (rho q) xi ((rho q : ℂ) ^ 3 - 3 * rho q)⁻¹) x₁ x₂ (y i) = 0 := by
    intro i
    by_cases hi : i = 0
    · subst i; ring
    · exact gap_zero_of_dvd (rho q) xi x₁ x₂ (y 0) (y i)
        hr h1 h2 h4 hs hy0 hxx (hn i hi)
  have hi := identity_of_gaps (rho q) xi x₁ x₂ y hr hxi0 hs hy hy0 hg
  apply root_sum_identity_impossible q hq xi x₁ x₂ (y 0) (y 1) (y 2)
    hxi hx₁ hx₂ (hyunit 0) (hyunit 1) (hyunit 2)
  simpa [sigma, Complex.ofReal_add, Complex.ofReal_mul, Complex.ofReal_sub, Complex.ofReal_pow] using hi

end P14QuquartTwoThree

end
end

section

/-! A single point on a supplied complex root branch over a real interval
avoids an arbitrary finite family of nondivisible polynomial constraints.
Nonzero resultants and the elementary finite-root theorem suffice. -/

noncomputable section
namespace P14ResultantRealInterval
open Polynomial
open scoped BigOperators

theorem exists_eval_real_interval (P : ℂ[X]) (hP : P ≠ 0)
    (l u : ℝ) (hlu : l < u) :
    ∃ a : ℝ, l < a ∧ a < u ∧ P.eval (a : ℂ) ≠ 0 := by
  by_contra hn
  push Not at hn
  apply hP
  apply Polynomial.eq_zero_of_infinite_isRoot
  apply ((Set.Ioo_infinite hlu).image Complex.ofReal_injective.injOn).mono
  intro z hz
  obtain ⟨a, ha, rfl⟩ := hz
  exact hn a ha.1 ha.2

theorem exists_branch_avoiding {T : Type*} [Fintype T]
    (G : Polynomial (ℂ[X])) (Q : T → Polynomial (ℂ[X]))
    (hG : Irreducible G) (hDegree : G.natDegree ≠ 0) (hQ : ∀ i, ¬ G ∣ Q i)
    (l u : ℝ) (hlu : l < u) (f : ℝ → ℂ)
    (hRoots : ∀ a : ℝ, l < a → a < u →
      G.eval₂ (evalRingHom (a : ℂ)) (f a) = 0) :
    ∃ a : ℝ, l < a ∧ a < u ∧
      ∀ i : T, (Q i).eval₂ (evalRingHom (a : ℂ)) (f a) ≠ 0 := by
  classical
  let R : T → ℂ[X] := fun i => resultant G (Q i) G.natDegree (Q i).natDegree
  have hR : ∀ i, R i ≠ 0 := fun i =>
    P14IrreducibleResultantAvoidance.resultant_ne_zero_of_irreducible
      (RatFunc ℂ) hG hDegree (hQ i)
  let P : ℂ[X] := ∏ i, R i
  have hP : P ≠ 0 := Finset.prod_ne_zero_iff.mpr (fun i _ => hR i)
  obtain ⟨a, hal, hau, ha⟩ := exists_eval_real_interval P hP l u hlu
  have hp : (∏ i, (R i).eval (a : ℂ)) ≠ 0 := by
    simpa only [P, eval_prod] using ha
  have he : ∀ i, (R i).eval (a : ℂ) ≠ 0 :=
    fun i => Finset.prod_ne_zero_iff.mp hp i (Finset.mem_univ i)
  refine ⟨a, hal, hau, ?_⟩
  intro i hi
  apply he i
  exact P14IrreducibleResultantAvoidance.map_resultant_eq_zero_of_common_root
    (G := G) (Q := Q i) (m := G.natDegree) (n := (Q i).natDegree)
    le_rfl le_rfl (Or.inl hDegree) (evalRingHom (a : ℂ)) (f a)
    (hRoots a hal hau) hi

end P14ResultantRealInterval

end
end

section

/-! One actual admissible ququart parameter simultaneously makes the
selected mixed minors nonzero. All nondivisibility premises are discharged
for the full finite collection of three-U and two-U mixed selections. -/

noncomputable section
namespace P14QuquartCommonParameter
open Polynomial P14QuquartPolynomialRows P14QuquartLargeOrder

theorem point_eval₂ (a z : ℂ) (P : Ring) :
    point a z P = P.eval₂ (evalRingHom a) z := by
  simpa [point] using (eval₂_at_apply (p := P) (evalRingHom a) (C z)).symm

theorem exists_avoiding {T : Type*} [Fintype T]
    (r : ℝ) (hr : (9 : ℝ) / 5 < r) (h2 : r < 2)
    (Q : T → Ring) (hQ : ∀ i, ¬ P14QuquartClearedCurve.curve (r : ℂ) ∣ Q i) :
    ∃ a : ℝ, ∃ z : ℂ, P14QuquartParameterBranch.Admissible r a z ∧
      ∀ i : T, point (a : ℂ) z (Q i) ≠ 0 := by
  have hp : 0 < r := by linarith
  have hsq : 3 < r ^ 2 := by nlinarith
  have hs4 : r ^ 2 < 4 := by nlinarith
  have hrC : (r : ℂ) ≠ 0 := by exact_mod_cast hp.ne'
  have h1C : (r : ℂ) ^ 2 ≠ 1 := by exact_mod_cast (show r ^ 2 ≠ 1 by linarith)
  have h2C : (r : ℂ) ^ 2 ≠ 2 := by exact_mod_cast (show r ^ 2 ≠ 2 by linarith)
  have h4C : (r : ℂ) ^ 2 ≠ 4 := by exact_mod_cast (ne_of_lt hs4)
  have hG := P14QuquartClearedCurve.irreducible (r : ℂ) hrC h1C h2C h4C
  have hdegree : (P14QuquartClearedCurve.curve (r : ℂ)).natDegree = 2 := by
    unfold P14QuquartClearedCurve.curve
    exact natDegree_quadratic (P14QuquartCurve.A_ne_zero _)
  obtain ⟨b, hb, hbranch⟩ := P14QuquartParameterBranch.exists_admissible_interval r hr h2
  obtain ⟨a, ha, hab, hav⟩ := P14ResultantRealInterval.exists_branch_avoiding
    (P14QuquartClearedCurve.curve (r : ℂ)) Q hG (by rw [hdegree]; decide)
    hQ 1 b hb (P14QuquartParameterBranch.root r) (by
      intro a ha hab
      rw [← point_eval₂]
      exact (hbranch a ha hab).curve_eq)
  refine ⟨a, P14QuquartParameterBranch.root r a, hbranch a ha hab, ?_⟩
  intro i
  simpa only [point_eval₂] using hav i

theorem rho_bounds (q : ℕ) (hq : 11 ≤ q) :
    (9 : ℝ) / 5 < rho q ∧ rho q < 2 := by
  have hlo := rho_lower q hq
  have hle : rho q ≤ 2 := by
    dsimp [rho]
    nlinarith [Real.cos_le_one (Real.pi / q)]
  have hne := (P14QuquartTwoThree.real_parameters q hq).2.2.2.1
  refine ⟨by linarith, ?_⟩
  by_contra hn
  have he : rho q = 2 := le_antisymm hle (le_of_not_gt hn)
  exact hne (by rw [he]; norm_num)

theorem exists_mixed_minors (q : ℕ) (hq : 11 ≤ q)
    (xi : ℂ) (hxi : ‖xi‖ = 1) (w : Fin q → ℂ)
    (hw : Function.Injective w) (hunit : ∀ i, ‖w i‖ = 1) :
    ∃ a : ℝ, ∃ z : ℂ, P14QuquartParameterBranch.Admissible (rho q) a z ∧
      (∀ x : Fin 3 → Fin q, Function.Injective x → ∀ y : Fin q,
        point (a : ℂ) z (threeOne (rho q) xi (w ∘ x) (w y)).det ≠ 0) ∧
      (∀ x : Fin 2 → Fin q, Function.Injective x →
        ∀ y : Fin 3 → Fin q, Function.Injective y →
        ∃ i : Fin 3, i ≠ 0 ∧ point (a : ℂ) z
          (P14QuquartFirstJet.minor (rho q) xi (w (x 0)) (w (x 1)) (w (y 0)) (w (y i))).det ≠ 0) := by
  classical
  let E (k : ℕ) := {f : Fin k → Fin q // Function.Injective f}
  let T := (E 3 × Fin q) ⊕ (E 2 × E 3)
  have hp : ∀ p : E 2 × E 3, ∃ i : Fin 3, i ≠ 0 ∧
      ¬ P14QuquartClearedCurve.curve (rho q : ℂ) ∣
        (P14QuquartFirstJet.minor (rho q) xi (w (p.1.val 0)) (w (p.1.val 1))
          (w (p.2.val 0)) (w (p.2.val i))).det := by
    intro p
    exact P14QuquartTwoThree.exists_minor_not_dvd q hq xi
      (w (p.1.val 0)) (w (p.1.val 1)) (w ∘ p.2.val)
      hxi (hunit _) (hunit _) (fun i => hunit _)
      (fun he => (by decide : (1 : Fin 2) ≠ 0) (p.1.property (hw he)))
      (hw.comp p.2.property)
  let sel : E 2 × E 3 → Fin 3 := fun p => Classical.choose (hp p)
  have hs (p : E 2 × E 3) : sel p ≠ 0 ∧
      ¬ P14QuquartClearedCurve.curve (rho q : ℂ) ∣
        (P14QuquartFirstJet.minor (rho q) xi (w (p.1.val 0)) (w (p.1.val 1))
          (w (p.2.val 0)) (w (p.2.val (sel p)))).det := Classical.choose_spec (hp p)
  let Q : T → Ring := fun t => match t with
    | .inl (x, y) => (threeOne (rho q) xi (w ∘ x.val) (w y)).det
    | .inr p => (P14QuquartFirstJet.minor (rho q) xi (w (p.1.val 0)) (w (p.1.val 1))
        (w (p.2.val 0)) (w (p.2.val (sel p)))).det
  have hQ : ∀ t, ¬ P14QuquartClearedCurve.curve (rho q : ℂ) ∣ Q t := by
    intro t
    rcases t with ⟨x, y⟩ | p
    · obtain ⟨hr, _, _, _, hsigma⟩ := P14QuquartTwoThree.real_parameters q hq
      apply threeOne_not_dvd (rho q) xi
      · exact_mod_cast hr
      · exact_mod_cast hsigma
      · exact hw.comp x.property
      · intro he
        have hu := hunit y
        simp [he] at hu
    · exact (hs p).2
  obtain ⟨hl, hu⟩ := rho_bounds q hq
  obtain ⟨a, z, hag, hav⟩ := exists_avoiding (rho q) hl hu Q hQ
  refine ⟨a, z, hag, ?_, ?_⟩
  · intro x hx y
    exact hav (.inl (⟨x, hx⟩, y))
  · intro x hx y hy
    let p : E 2 × E 3 := (⟨x, hx⟩, ⟨y, hy⟩)
    exact ⟨sel p, (hs p).1, hav (.inr p)⟩

end P14QuquartCommonParameter

end
end

section

/-! Actual evaluated polynomial rows, nonzero coordinate weights and pure
four-row determinants on the verified ququart parameter branch. -/

noncomputable section
namespace P14QuquartNormalizedRows
open Matrix P14QuquartPolynomialRows
open scoped BigOperators

def v (r : ℝ) (xi : ℂ) (a : ℝ) (z w : ℂ) : Fin 4 → ℂ :=
  fun k => point (a : ℂ) z (V (r : ℂ) xi w k)

def coeff (r : ℝ) (xi : ℂ) (a : ℝ) (z : ℂ) : Fin 4 → ℂ :=
  ![-(a : ℂ) * xi ^ 3 * z * ((a : ℂ) + r) * (1 + (r : ℂ) * a),
    (a : ℂ) * xi ^ 2 * (1 + (r : ℂ) * z) * (1 + (r : ℂ) * a),
    -(a : ℂ) * xi * ((r : ℂ) + z) * ((a : ℂ) + r),
    ((a : ℂ) + r) * (1 + (r : ℂ) * a)]

theorem v_eq (r : ℝ) (xi : ℂ) (a : ℝ) (z w : ℂ) :
    v r xi a z w = fun k => coeff r xi a z k * w ^ k.val := by
  funext k
  fin_cases k <;> simp [v, coeff, V, P14QuquartPolynomialRows.a, c, point] <;> ring_nf <;> simp

theorem coeff_ne_zero (r : ℝ) (hr : 0 < r) (xi : ℂ) (hxi : xi ≠ 0)
    (a : ℝ) (z : ℂ) (h : P14QuquartParameterBranch.Admissible r a z) :
    ∀ k, coeff r xi a z k ≠ 0 := by
  have ha : (a : ℂ) ≠ 0 := Complex.ofReal_ne_zero.mpr (ne_of_gt (by linarith [h.a_gt_one]))
  have hshift : (a : ℂ) + r ≠ 0 := by
    exact_mod_cast (ne_of_gt h.shifted_pos)
  have haff : (1 : ℂ) + (r : ℂ) * a ≠ 0 := by
    exact_mod_cast (ne_of_gt h.affine_pos)
  have hz : z ≠ 0 := by
    intro he
    have hi := h.im_pos
    simp [he] at hi
  have hrz : (r : ℂ) + z ≠ 0 := by
    intro he
    have hi := congrArg Complex.im he
    have hp := h.im_pos
    simp at hi
    linarith
  have h1rz : (1 : ℂ) + (r : ℂ) * z ≠ 0 := by
    intro he
    have hi : r * z.im = 0 := by simpa using congrArg Complex.im he
    exact (ne_of_gt (mul_pos hr h.im_pos)) hi
  intro k
  fin_cases k
  · exact mul_ne_zero (mul_ne_zero (mul_ne_zero
      (mul_ne_zero (neg_ne_zero.mpr ha) (pow_ne_zero _ hxi)) hz) hshift) haff
  · exact mul_ne_zero (mul_ne_zero (mul_ne_zero ha (pow_ne_zero _ hxi)) h1rz) haff
  · exact mul_ne_zero (mul_ne_zero (mul_ne_zero (neg_ne_zero.mpr ha) hxi) hrz) hshift
  · exact mul_ne_zero hshift haff

theorem weighted_det_ne_zero (b : Fin 4 → ℂ) (hb : ∀ k, b k ≠ 0)
    (x : Fin 4 → ℂ) (hx : Function.Injective x) :
    (Matrix.of (fun i k => b k * x i ^ k.val)).det ≠ 0 := by
  intro hd
  obtain ⟨w, hw, hker⟩ := Matrix.exists_mulVec_eq_zero_iff.mpr hd
  have hc : (fun k => b k * w k) = 0 := by
    apply Matrix.eq_zero_of_forall_index_sum_pow_mul_eq_zero (f := x) hx
    intro i
    simpa only [Matrix.mulVec, dotProduct, Matrix.of_apply, Pi.zero_apply,
      mul_assoc, mul_left_comm] using congrFun hker i
  apply hw
  funext k
  exact (mul_eq_zero.mp (congrFun hc k)).resolve_left (hb k)

theorem u_det_ne_zero (x : Fin 4 → ℂ) (hx : Function.Injective x) :
    (Matrix.of (fun i => u (x i))).det ≠ 0 := by
  change (Matrix.of (fun i k => x i ^ k.val)).det ≠ 0
  simpa only [one_mul] using weighted_det_ne_zero (fun _ => 1)
    (fun _ => one_ne_zero) x hx

theorem v_det_ne_zero (r : ℝ) (hr : 0 < r) (xi : ℂ) (hxi : xi ≠ 0)
    (a : ℝ) (z : ℂ) (h : P14QuquartParameterBranch.Admissible r a z)
    (x : Fin 4 → ℂ) (hx : Function.Injective x) :
    (Matrix.of (fun i => v r xi a z (x i))).det ≠ 0 := by
  simp_rw [v_eq]
  exact weighted_det_ne_zero (coeff r xi a z) (coeff_ne_zero r hr xi hxi a z h) x hx

theorem map_threeOne (r : ℝ) (xi : ℂ) (a : ℝ) (z : ℂ)
    (x : Fin 3 → ℂ) (y : ℂ) :
    (point (a : ℂ) z).mapMatrix (threeOne (r : ℂ) xi x y) =
      (![u (x 0), u (x 1), u (x 2), v r xi a z y] : Matrix (Fin 4) (Fin 4) ℂ) := by
  apply Matrix.ext
  intro i k
  fin_cases i
  · exact congrFun (point_U (a : ℂ) z (x 0)) k
  · exact congrFun (point_U (a : ℂ) z (x 1)) k
  · exact congrFun (point_U (a : ℂ) z (x 2)) k
  · rfl

theorem map_minor (r : ℝ) (xi : ℂ) (a : ℝ) (z x₁ x₂ s t : ℂ) :
    (point (a : ℂ) z).mapMatrix (P14QuquartFirstJet.minor (r : ℂ) xi x₁ x₂ s t) =
      (![u x₁, u x₂, v r xi a z s, v r xi a z t] : Matrix (Fin 4) (Fin 4) ℂ) := by
  apply Matrix.ext
  intro i k
  fin_cases i
  · exact congrFun (point_U (a : ℂ) z x₁) k
  · exact congrFun (point_U (a : ℂ) z x₂) k
  · rfl
  · rfl

end P14QuquartNormalizedRows

end
end

section

/-! Every five evaluated normalized ququart rows span four dimensions at
one common admissible parameter. Pure-layer and mixed minors are all
discharged, rather than assumed in the final existence theorem. -/

noncomputable section
namespace P14QuquartFiveSpanning
open Submodule Matrix P14QuquartPolynomialRows P14QuquartNormalizedRows
open P14QuquartLargeOrder P14TwoLayerSpanExtraction

def rows {q : ℕ} (r : ℝ) (xi : ℂ) (a : ℝ) (z : ℂ) (w : Fin q → ℂ) :
    Fin q ⊕ Fin q → Fin 4 → ℂ :=
  Sum.elim (fun i => P14QuquartPolynomialRows.u (w i)) (fun i => v r xi a z (w i))

theorem rows_ne_zero {q : ℕ} (r : ℝ) (hr : 0 < r) (xi : ℂ) (hxi : xi ≠ 0)
    (a : ℝ) (z : ℂ) (h : P14QuquartParameterBranch.Admissible r a z)
    (w : Fin q → ℂ) : ∀ i, rows r xi a z w i ≠ 0 := by
  intro i
  have h0 : rows r xi a z w i 0 ≠ 0 := by
    rcases i with i | i
    · change P14QuquartPolynomialRows.u (w i) 0 ≠ 0
      simp [P14QuquartPolynomialRows.u]
    · change v r xi a z (w i) 0 ≠ 0
      rw [v_eq]
      simpa using coeff_ne_zero r hr xi hxi a z h 0
  exact fun he => h0 (congrFun he 0)

theorem every_five {q : ℕ} (r : ℝ) (hr : 0 < r) (xi : ℂ) (hxi : xi ≠ 0)
    (a : ℝ) (z : ℂ) (had : P14QuquartParameterBranch.Admissible r a z)
    (w : Fin q → ℂ) (hw : Function.Injective w)
    (h31 : ∀ x : Fin 3 → Fin q, Function.Injective x → ∀ y : Fin q,
      point (a : ℂ) z (threeOne (r : ℂ) xi (w ∘ x) (w y)).det ≠ 0)
    (h23 : ∀ x : Fin 2 → Fin q, Function.Injective x →
      ∀ y : Fin 3 → Fin q, Function.Injective y →
      ∃ i : Fin 3, i ≠ 0 ∧ point (a : ℂ) z
        (P14QuquartFirstJet.minor (r : ℂ) xi (w (x 0)) (w (x 1)) (w (y 0)) (w (y i))).det ≠ 0)
    (S : Finset (Fin q ⊕ Fin q)) (hS : S.card = 5) :
    span ℂ (Set.range (fun s : S => rows r xi a z w s.val)) = ⊤ := by
  classical
  have hcount := S.card_toLeft_add_card_toRight
  by_cases hU4 : 4 ≤ S.toLeft.card
  · obtain ⟨U, hi, hm⟩ := select S.toLeft 4 hU4
    have hs := P14PolynomialRowsSpanning.complex_spanning_of_det
      (Matrix.of (fun i => P14QuquartPolynomialRows.u (w (U i))))
      (u_det_ne_zero (w ∘ U) (hw.comp hi))
    apply of_included (rows r xi a z w) S _ hs
    intro i
    exact ⟨⟨.inl (U i), Finset.mem_toLeft.mp (hm i)⟩, rfl⟩
  by_cases hV4 : 4 ≤ S.toRight.card
  · obtain ⟨V, hi, hm⟩ := select S.toRight 4 hV4
    have hs := P14PolynomialRowsSpanning.complex_spanning_of_det
      (Matrix.of (fun i => v r xi a z (w (V i))))
      (v_det_ne_zero r hr xi hxi a z had (w ∘ V) (hw.comp hi))
    apply of_included (rows r xi a z w) S _ hs
    intro i
    exact ⟨⟨.inr (V i), Finset.mem_toRight.mp (hm i)⟩, rfl⟩
  by_cases hU3 : 3 ≤ S.toLeft.card
  · have hV1 : 1 ≤ S.toRight.card := by omega
    obtain ⟨U, hiU, hmU⟩ := select S.toLeft 3 hU3
    obtain ⟨V, _, hmV⟩ := select S.toRight 1 hV1
    let M : Matrix (Fin 4) (Fin 4) ℂ :=
      ![P14QuquartPolynomialRows.u (w (U 0)), P14QuquartPolynomialRows.u (w (U 1)),
        P14QuquartPolynomialRows.u (w (U 2)), v r xi a z (w (V 0))]
    have hd : M.det ≠ 0 := by
      have h := h31 U hiU (V 0)
      rw [(point (a : ℂ) z).map_det, map_threeOne] at h
      exact h
    apply of_included (rows r xi a z w) S M
      (P14PolynomialRowsSpanning.complex_spanning_of_det M hd)
    intro i
    fin_cases i
    · exact ⟨⟨.inl (U 0), Finset.mem_toLeft.mp (hmU 0)⟩, rfl⟩
    · exact ⟨⟨.inl (U 1), Finset.mem_toLeft.mp (hmU 1)⟩, rfl⟩
    · exact ⟨⟨.inl (U 2), Finset.mem_toLeft.mp (hmU 2)⟩, rfl⟩
    · exact ⟨⟨.inr (V 0), Finset.mem_toRight.mp (hmV 0)⟩, rfl⟩
  have hU2 : 2 ≤ S.toLeft.card := by omega
  have hV3 : 3 ≤ S.toRight.card := by omega
  obtain ⟨U, hiU, hmU⟩ := select S.toLeft 2 hU2
  obtain ⟨V, hiV, hmV⟩ := select S.toRight 3 hV3
  obtain ⟨j, _, hdj⟩ := h23 U hiU V hiV
  let M : Matrix (Fin 4) (Fin 4) ℂ :=
    ![P14QuquartPolynomialRows.u (w (U 0)), P14QuquartPolynomialRows.u (w (U 1)),
      v r xi a z (w (V 0)), v r xi a z (w (V j))]
  have hd : M.det ≠ 0 := by
    rw [(point (a : ℂ) z).map_det, map_minor] at hdj
    exact hdj
  apply of_included (rows r xi a z w) S M
    (P14PolynomialRowsSpanning.complex_spanning_of_det M hd)
  intro i
  fin_cases i
  · exact ⟨⟨.inl (U 0), Finset.mem_toLeft.mp (hmU 0)⟩, rfl⟩
  · exact ⟨⟨.inl (U 1), Finset.mem_toLeft.mp (hmU 1)⟩, rfl⟩
  · exact ⟨⟨.inr (V 0), Finset.mem_toRight.mp (hmV 0)⟩, rfl⟩
  · exact ⟨⟨.inr (V j), Finset.mem_toRight.mp (hmV j)⟩, rfl⟩

theorem exists_normalized_spanning (q : ℕ) (hq : 11 ≤ q)
    (xi : ℂ) (hxi : ‖xi‖ = 1) (w : Fin q → ℂ)
    (hw : Function.Injective w) (hunit : ∀ i, ‖w i‖ = 1) :
    ∃ a : ℝ, ∃ z : ℂ, P14QuquartParameterBranch.Admissible (rho q) a z ∧
      (∀ i, rows (rho q) xi a z w i ≠ 0) ∧
      (∀ S : Finset (Fin q ⊕ Fin q), S.card = 5 →
        span ℂ (Set.range (fun s : S => rows (rho q) xi a z w s.val)) = ⊤) := by
  obtain ⟨a, z, had, h31, h23⟩ := P14QuquartCommonParameter.exists_mixed_minors q hq xi hxi w hw hunit
  have hr : 0 < rho q := by linarith [rho_lower q hq]
  have hxi0 : xi ≠ 0 := by intro he; simp [he] at hxi
  exact ⟨a, z, had, rows_ne_zero (rho q) hr xi hxi0 a z had w,
    every_five (rho q) hr xi hxi0 a z had w hw h31 h23⟩

end P14QuquartFiveSpanning

end
end

section

/-! Exact metric and row-scalar transport from the checked normalized rows
to Wang's square-root-weighted ququart vectors. -/

noncomputable section
namespace P14QuquartPhysicalRows
open Submodule P14QuquartPolynomialRows P14QuquartLargeOrder

def weights (r a : ℝ) : Fin 4 → ℝ := ![1, a + r, 1 + r * a, a]
def p (r : ℝ) (xi z : ℂ) : Fin 4 → ℂ :=
  ![-xi ^ 3 * z, xi ^ 2 * (1 + (r : ℂ) * z), -xi * ((r : ℂ) + z), 1]
def scale (r a : ℝ) : ℝ := a * (a + r) * (1 + r * a)
def u (r a : ℝ) (w : ℂ) : Fin 4 → ℂ :=
  fun k => (Real.sqrt (weights r a k) : ℂ) * w ^ k.val
def v (r : ℝ) (xi : ℂ) (a : ℝ) (z w : ℂ) : Fin 4 → ℂ :=
  fun k => p r xi z k / (Real.sqrt (weights r a k) : ℂ) * w ^ k.val
def rows {q : ℕ} (r : ℝ) (xi : ℂ) (a : ℝ) (z : ℂ) (w : Fin q → ℂ) :
    Fin q ⊕ Fin q → Fin 4 → ℂ :=
  Sum.elim (fun i => u r a (w i)) (fun i => v r xi a z (w i))

def diagonal (r a : ℝ) : (Fin 4 → ℂ) →ₗ[ℂ] (Fin 4 → ℂ) where
  toFun x := fun k => (Real.sqrt (weights r a k) : ℂ) * x k
  map_add' x y := by funext k; exact mul_add _ _ _
  map_smul' c x := by
    funext k
    simp only [Pi.smul_apply, smul_eq_mul, RingHom.id_apply]
    ring

theorem weights_pos (r a : ℝ) (z : ℂ)
    (h : P14QuquartParameterBranch.Admissible r a z) : ∀ k, 0 < weights r a k := by
  intro k
  fin_cases k
  · norm_num [weights]
  · exact h.shifted_pos
  · exact h.affine_pos
  · change 0 < a
    linarith [h.a_gt_one]

theorem scale_ne_zero (r a : ℝ) (z : ℂ)
    (h : P14QuquartParameterBranch.Admissible r a z) : (scale r a : ℂ) ≠ 0 := by
  apply Complex.ofReal_ne_zero.mpr
  exact ne_of_gt (mul_pos (mul_pos (by linarith [h.a_gt_one]) h.shifted_pos) h.affine_pos)

theorem coefficient_clear (r : ℝ) (xi : ℂ) (a : ℝ) (z : ℂ) (k : Fin 4) :
    P14QuquartNormalizedRows.coeff r xi a z k * (weights r a k : ℂ) =
      (scale r a : ℂ) * p r xi z k := by
  fin_cases k <;> simp [P14QuquartNormalizedRows.coeff, weights, scale, p] <;> ring

theorem diagonal_injective (r a : ℝ) (h : ∀ k, 0 < weights r a k) :
    Function.Injective (diagonal r a) := by
  intro x y he
  funext k
  have hs : (Real.sqrt (weights r a k) : ℂ) ≠ 0 :=
    Complex.ofReal_ne_zero.mpr (Real.sqrt_ne_zero'.mpr (h k))
  exact mul_left_cancel₀ hs (congrFun he k)

theorem diagonal_surjective (r a : ℝ) (h : ∀ k, 0 < weights r a k) :
    Function.Surjective (diagonal r a) := by
  intro x
  refine ⟨fun k => x k / (Real.sqrt (weights r a k) : ℂ), ?_⟩
  funext k
  have hs : (Real.sqrt (weights r a k) : ℂ) ≠ 0 :=
    Complex.ofReal_ne_zero.mpr (Real.sqrt_ne_zero'.mpr (h k))
  change (Real.sqrt (weights r a k) : ℂ) * (x k / (Real.sqrt (weights r a k) : ℂ)) = x k
  field_simp

theorem diagonal_v (r : ℝ) (xi : ℂ) (a : ℝ) (z w : ℂ)
    (h : ∀ k, 0 < weights r a k) :
    diagonal r a (P14QuquartNormalizedRows.v r xi a z w) =
      (scale r a : ℂ) • v r xi a z w := by
  funext k
  have hs : (Real.sqrt (weights r a k) : ℂ) ≠ 0 :=
    Complex.ofReal_ne_zero.mpr (Real.sqrt_ne_zero'.mpr (h k))
  have hsq : (Real.sqrt (weights r a k) : ℂ) ^ 2 = (weights r a k : ℂ) := by
    exact_mod_cast Real.sq_sqrt (h k).le
  rw [P14QuquartNormalizedRows.v_eq]
  change (Real.sqrt (weights r a k) : ℂ) *
      (P14QuquartNormalizedRows.coeff r xi a z k * w ^ k.val) =
    (scale r a : ℂ) * (p r xi z k / (Real.sqrt (weights r a k) : ℂ) * w ^ k.val)
  calc
    _ = (P14QuquartNormalizedRows.coeff r xi a z k *
        (Real.sqrt (weights r a k) : ℂ) ^ 2) / (Real.sqrt (weights r a k) : ℂ) * w ^ k.val := by
      field_simp
    _ = _ := by
      rw [hsq, coefficient_clear]
      ring

def factor {q : ℕ} (r a : ℝ) : Fin q ⊕ Fin q → ℂ :=
  Sum.elim (fun _ => 1) (fun _ => (scale r a : ℂ)⁻¹)

theorem factor_ne_zero {q : ℕ} (r a : ℝ) (z : ℂ)
    (h : P14QuquartParameterBranch.Admissible r a z) :
    ∀ i : Fin q ⊕ Fin q, factor r a i ≠ 0 := by
  intro i
  rcases i with i | i
  · exact one_ne_zero
  · exact inv_ne_zero (scale_ne_zero r a z h)

theorem physical_eq {q : ℕ} (r : ℝ) (xi : ℂ) (a : ℝ) (z : ℂ)
    (h : P14QuquartParameterBranch.Admissible r a z) (w : Fin q → ℂ)
    (i : Fin q ⊕ Fin q) :
    rows r xi a z w i = factor r a i •
      diagonal r a (P14QuquartFiveSpanning.rows r xi a z w i) := by
  rcases i with i | i
  · simp only [rows, factor, P14QuquartFiveSpanning.rows, Sum.elim_inl, one_smul]
    rfl
  · change v r xi a z (w i) = (scale r a : ℂ)⁻¹ •
      diagonal r a (P14QuquartNormalizedRows.v r xi a z (w i))
    rw [diagonal_v r xi a z (w i) (weights_pos r a z h),
      smul_smul, inv_mul_cancel₀ (scale_ne_zero r a z h), one_smul]

/-- Same elementary two-sided span argument as the earlier checked row-scaling
transport, specialized here to keep the ququart dependency closure small. -/
theorem span_scaled {ι : Type*} (x : ι → Fin 4 → ℂ) (c : ι → ℂ)
    (hc : ∀ i, c i ≠ 0) :
    span ℂ (Set.range (fun i => c i • x i)) = span ℂ (Set.range x) := by
  apply le_antisymm
  · apply span_le.mpr
    rintro _ ⟨i, rfl⟩
    exact smul_mem _ _ (subset_span ⟨i, rfl⟩)
  · apply span_le.mpr
    rintro _ ⟨i, rfl⟩
    have h := smul_mem (span ℂ (Set.range (fun i => c i • x i))) (c i)⁻¹
      (subset_span (Set.mem_range_self i))
    change x i ∈ span ℂ (Set.range (fun i => c i • x i))
    simpa only [smul_smul, inv_mul_cancel₀ (hc i), one_smul] using h

theorem span_diagonal {ι : Type*} (r a : ℝ) (h : ∀ k, 0 < weights r a k)
    (x : ι → Fin 4 → ℂ) (hx : span ℂ (Set.range x) = ⊤) :
    span ℂ (Set.range (fun i => diagonal r a (x i))) = ⊤ := by
  have he := congrArg (Submodule.map (diagonal r a)) hx
  rw [Submodule.map_span, ← Set.range_comp, Submodule.map_top,
    LinearMap.range_eq_top.mpr (diagonal_surjective r a h)] at he
  exact he

theorem exists_physical_spanning (q : ℕ) (hq : 11 ≤ q)
    (xi : ℂ) (hxi : ‖xi‖ = 1) (w : Fin q → ℂ)
    (hw : Function.Injective w) (hunit : ∀ i, ‖w i‖ = 1) :
    ∃ a : ℝ, ∃ z : ℂ, P14QuquartParameterBranch.Admissible (rho q) a z ∧
      (∀ i, rows (rho q) xi a z w i ≠ 0) ∧
      (∀ S : Finset (Fin q ⊕ Fin q), S.card = 5 →
        span ℂ (Set.range (fun s : S => rows (rho q) xi a z w s.val)) = ⊤) := by
  obtain ⟨a, z, had, hnz, hspan⟩ := P14QuquartFiveSpanning.exists_normalized_spanning q hq xi hxi w hw hunit
  have hpos := weights_pos (rho q) a z had
  refine ⟨a, z, had, ?_, ?_⟩
  · intro i
    rw [physical_eq (rho q) xi a z had]
    apply smul_ne_zero (factor_ne_zero (rho q) a z had i)
    intro he
    apply hnz i
    apply diagonal_injective (rho q) a hpos
    simpa only [map_zero] using he
  · intro S hS
    simp_rw [physical_eq (rho q) xi a z had]
    rw [span_scaled _ _ (fun s : S => factor_ne_zero (rho q) a z had s.val)]
    exact span_diagonal (rho q) a hpos _ (hspan S hS)

end P14QuquartPhysicalRows

end
end

section

/-! Exact squared coefficient lengths of the physical ququart vectors.
This is an algebraic consequence of the already constructed admissible branch. -/
noncomputable section
namespace P14QuquartCoefficientNorms
open P14QuquartPhysicalRows P14QuquartParameterBranch

def sigma (r : ℝ) : ℝ := r ^ 3 - 3 * r
def dual (r a : ℝ) : ℝ := (a + r) / (1 + r * a)
def dualWeights (r a : ℝ) : Fin 4 → ℝ :=
  ![1, sigma r + dual r a, 1 + sigma r * dual r a, dual r a]

theorem trace_real (r a : ℝ) (z : ℂ) (h : Admissible r a z) :
    2 * z.re = B r a / A r a := by
  have ht := congrArg Complex.re h.trace_eq
  simpa only [Complex.add_re, Complex.star_def, Complex.conj_re,
    Complex.ofReal_re, two_mul] using ht

theorem norm_one_add (r a : ℝ) (z : ℂ) (h : Admissible r a z) :
    Complex.normSq (1 + (r : ℂ) * z) =
      1 + r * (B r a / A r a) + r ^ 2 * (K r a / A r a) := by
  have hn := h.normSq_eq
  have ht := trace_real r a z h
  simp only [Complex.normSq_apply, Complex.add_re, Complex.one_re,
    Complex.mul_re, Complex.ofReal_re, Complex.ofReal_im, zero_mul, sub_zero,
    Complex.add_im, Complex.one_im, Complex.mul_im, zero_add] at hn ⊢
  linear_combination r ^ 2 * hn + r * ht

theorem norm_add (r a : ℝ) (z : ℂ) (h : Admissible r a z) :
    Complex.normSq ((r : ℂ) + z) =
      r ^ 2 + r * (B r a / A r a) + K r a / A r a := by
  have hn := h.normSq_eq
  have ht := trace_real r a z h
  simp only [Complex.normSq_apply, Complex.add_re, Complex.ofReal_re,
    Complex.add_im, Complex.ofReal_im, zero_add] at hn ⊢
  linear_combination hn + r * ht

theorem lengths (r a : ℝ) (xi z : ℂ) (hxi : ‖xi‖ = 1)
    (h : Admissible r a z) (k : Fin 4) :
    Complex.normSq (p r xi z k) =
      (K r a / A r a) * weights r a k * dualWeights r a k := by
  have hx : Complex.normSq xi = 1 := by
    rw [Complex.normSq_eq_norm_sq, hxi]; norm_num
  have ha : a ≠ 0 := ne_of_gt (by linarith [h.a_gt_one] : 0 < a)
  have har : a + r ≠ 0 := ne_of_gt h.shifted_pos
  have hk : 1 + r * a ≠ 0 := ne_of_gt h.affine_pos
  fin_cases k
  · simp [p, weights, dualWeights, Complex.normSq_mul, hx, h.normSq_eq]
  · change Complex.normSq (xi ^ 2 * (1 + (r : ℂ) * z)) =
      (K r a / A r a) * (a + r) * (sigma r + dual r a)
    simp only [Complex.normSq_mul, map_pow, hx, one_pow, one_mul]
    rw [norm_one_add r a z h]
    dsimp [A, B, K, sigma, dual]
    field_simp
    <;> ring
  · change Complex.normSq (-xi * ((r : ℂ) + z)) =
      (K r a / A r a) * (1 + r * a) * (1 + sigma r * dual r a)
    simp only [Complex.normSq_mul, Complex.normSq_neg, hx, one_mul]
    rw [norm_add r a z h]
    dsimp [A, B, K, sigma, dual]
    field_simp
    <;> ring
  · change Complex.normSq 1 = (K r a / A r a) * a * dual r a
    norm_num only [map_one]
    dsimp [A, K, dual]
    field_simp
    <;> norm_num

end P14QuquartCoefficientNorms
end
end

section

/-! Actual Hermitian pairing kernels of the square-root-weighted ququart rows. -/
noncomputable section
namespace P14QuquartPairingKernels
open P14QuquartPhysicalRows P14QuquartParameterBranch P14QuquartCoefficientNorms

def pair (x y : Fin 4 → ℂ) : ℂ := ∑ k, star (x k) * y k

theorem weighted_pair (c d : Fin 4 → ℂ) (w t : ℂ) :
    pair (fun k => c k * w ^ k.val) (fun k => d k * t ^ k.val) =
      ∑ k, (star (c k) * d k) * (star w * t) ^ k.val := by
  unfold pair
  apply Finset.sum_congr rfl
  intro k _
  simp only [star_mul, star_pow, mul_pow]
  ring

theorem sqrt_square (r a : ℝ) (z : ℂ) (h : Admissible r a z) (k : Fin 4) :
    (Real.sqrt (weights r a k) : ℂ) ^ 2 = (weights r a k : ℂ) := by
  exact_mod_cast Real.sq_sqrt (weights_pos r a z h k).le

theorem uu (r a : ℝ) (z w t : ℂ) (h : Admissible r a z) :
    pair (u r a w) (u r a t) =
      (1 + (a : ℂ) * (star w * t)) *
        (1 + (r : ℂ) * (star w * t) + (star w * t) ^ 2) := by
  unfold u
  rw [weighted_pair]
  have hc (k : Fin 4) :
      star (Real.sqrt (weights r a k) : ℂ) * (Real.sqrt (weights r a k) : ℂ) =
        (weights r a k : ℂ) := by
    simpa only [Complex.star_def, Complex.conj_ofReal, pow_two] using sqrt_square r a z h k
  simp_rw [hc]
  simp [Fin.sum_univ_succ, weights]
  ring

theorem vv_coefficient (r a : ℝ) (xi z : ℂ) (hxi : ‖xi‖ = 1)
    (h : Admissible r a z) (k : Fin 4) :
    star (p r xi z k / (Real.sqrt (weights r a k) : ℂ)) *
        (p r xi z k / (Real.sqrt (weights r a k) : ℂ)) =
      ((K r a / A r a : ℝ) : ℂ) * (dualWeights r a k : ℂ) := by
  have hs : (Real.sqrt (weights r a k) : ℂ) ≠ 0 :=
    Complex.ofReal_ne_zero.mpr (Real.sqrt_ne_zero'.mpr (weights_pos r a z h k))
  have hw : (weights r a k : ℂ) ≠ 0 :=
    Complex.ofReal_ne_zero.mpr (ne_of_gt (weights_pos r a z h k))
  have hp : star (p r xi z k) * p r xi z k =
      ((K r a / A r a * weights r a k * dualWeights r a k : ℝ) : ℂ) := by
    rw [Complex.star_def, ← Complex.normSq_eq_conj_mul_self, lengths r a xi z hxi h]
  rw [star_div₀]
  simp only [Complex.star_def, Complex.conj_ofReal]
  calc
    _ = (star (p r xi z k) * p r xi z k) /
        (Real.sqrt (weights r a k) : ℂ) ^ 2 := by
      simp only [Complex.star_def]
      ring
    _ = _ := by
      rw [hp, sqrt_square r a z h]
      push_cast
      field_simp

theorem vv (r a : ℝ) (xi z w t : ℂ) (hxi : ‖xi‖ = 1)
    (h : Admissible r a z) :
    pair (v r xi a z w) (v r xi a z t) =
      ((K r a / A r a : ℝ) : ℂ) *
        (1 + (dual r a : ℂ) * (star w * t)) *
        (1 + (sigma r : ℂ) * (star w * t) + (star w * t) ^ 2) := by
  unfold v
  rw [weighted_pair]
  simp_rw [vv_coefficient r a xi z hxi h]
  simp [Fin.sum_univ_succ, dualWeights]
  ring

theorem uv_polynomial (r a : ℝ) (xi z w t : ℂ) (h : Admissible r a z) :
    pair (u r a w) (v r xi a z t) =
      -xi ^ 3 * z + xi ^ 2 * (1 + (r : ℂ) * z) * (star w * t) -
        xi * ((r : ℂ) + z) * (star w * t) ^ 2 + (star w * t) ^ 3 := by
  unfold u v
  rw [weighted_pair]
  have hc (k : Fin 4) :
      star (Real.sqrt (weights r a k) : ℂ) *
        (p r xi z k / (Real.sqrt (weights r a k) : ℂ)) = p r xi z k := by
    have hs : (Real.sqrt (weights r a k) : ℂ) ≠ 0 :=
      Complex.ofReal_ne_zero.mpr (Real.sqrt_ne_zero'.mpr (weights_pos r a z h k))
    simp only [Complex.star_def, Complex.conj_ofReal]
    field_simp
  simp_rw [hc]
  simp [Fin.sum_univ_succ, p]
  ring

theorem uv (r a : ℝ) (xi z w t : ℂ) (h : Admissible r a z)
    (hphase : xi ^ 2 + 1 = (r : ℂ) * xi) :
    pair (u r a w) (v r xi a z t) =
      (star w * t - 1) * (star w * t - xi ^ 2) * (star w * t - xi * z) := by
  rw [uv_polynomial r a xi z w t h]
  linear_combination ((star w * t) ^ 2 - xi * z * (star w * t)) * hphase

theorem reverse_zero (x y : Fin 4 → ℂ) (h : pair x y = 0) :
    pair y x = 0 := by
  simpa [pair, Fin.sum_univ_succ, star_mul, mul_comm] using congrArg star h

end P14QuquartPairingKernels
end
end

section

/-! Exact phase, cyclic nodes and prescribed orthogonality for the physical
ququart family. The cyclic graph is the previously checked complement-cover graph. -/
noncomputable section
namespace P14QuquartRootGrid
open P14QuquartPhysicalRows P14QuquartParameterBranch
  P14QuquartPairingKernels P14QuquartCoefficientNorms
  P14FiveRootGrid P14FivePrescribedPairings P14FourierSpectralWeights
open P14QuquartLargeOrder (rho)

def phase (q : ℕ) : ℂ := Complex.exp (((Real.pi / q : ℝ) : ℂ) * Complex.I)

theorem phase_norm (q : ℕ) : ‖phase q‖ = 1 :=
  Complex.norm_exp_ofReal_mul_I _

theorem phase_square (q : ℕ) : phase q ^ 2 = fourierRoot q := by
  unfold phase fourierRoot
  rw [← Complex.exp_nat_mul]
  congr 1
  push_cast
  ring

theorem phase_relation (q : ℕ) : phase q ^ 2 + 1 = (rho q : ℂ) * phase q := by
  have hu : star (phase q) * phase q = 1 := by
    change (starRingEnd ℂ) (phase q) * phase q = 1
    simpa only [phase_norm, one_pow, Complex.ofReal_one] using Complex.conj_mul' (phase q)
  have hs : phase q + star (phase q) = (rho q : ℂ) := by
    rw [Complex.star_def, Complex.add_conj]
    simp only [phase, Complex.exp_ofReal_mul_I_re, rho, Complex.ofReal_mul,
      Complex.ofReal_ofNat]
  calc
    _ = phase q ^ 2 + star (phase q) * phase q := by rw [hu]
    _ = (phase q + star (phase q)) * phase q := by ring
    _ = _ := by rw [hs]

theorem node_norm {q : ℕ} (hq : 0 < q) (i : Fin q) : ‖rootNode q i‖ = 1 := by
  unfold rootNode
  rw [norm_pow, (fourierRoot_isPrimitiveRoot q hq).norm'_eq_one (Nat.ne_of_gt hq), one_pow]

theorem upper_quadratic {q : ℕ} (hq : 7 ≤ q) (ho : Odd q) :
    1 + (rho q : ℂ) * rootNode q (halfIndex hq) +
      rootNode q (halfIndex hq) ^ 2 = 0 := by
  have hf := quadratic_factorization
    (Real.cos (P14FivePositiveWeights.theta q)) (fourierRoot q ^ half q)
    (root_pow_unit (by omega : 0 < q) _) (root_half_re hq ho)
    (fourierRoot q ^ half q)
  simp only [sub_self, zero_mul] at hf
  simpa only [rootNode, halfIndex, rho, P14FivePositiveWeights.theta,
    Complex.ofReal_mul, Complex.ofReal_ofNat, add_comm, add_left_comm, add_assoc] using hf

theorem lower_quadratic {q : ℕ} (hq : 7 ≤ q) (ho : Odd q) :
    1 + (sigma (rho q) : ℂ) * rootNode q (predHalfIndex hq) +
      rootNode q (predHalfIndex hq) ^ 2 = 0 := by
  have hs : sigma (rho q) = 2 * Real.cos (3 * P14FivePositiveWeights.theta q) :=
    P14QuquartLargeOrder.sigma_trigonometric q
  rw [hs]
  have hf := quadratic_factorization
    (Real.cos (3 * P14FivePositiveWeights.theta q)) (fourierRoot q ^ (half q - 1))
    (root_pow_unit (by omega : 0 < q) _) (root_pred_half_re hq ho)
    (fourierRoot q ^ (half q - 1))
  simp only [sub_self, zero_mul] at hf
  simpa only [rootNode, predHalfIndex, Complex.ofReal_mul, Complex.ofReal_ofNat,
    add_comm, add_left_comm, add_assoc] using hf

variable {q : ℕ} [NeZero q]

theorem node_one (hq : 7 ≤ q) : rootNode q (1 : Fin q) = fourierRoot q := by
  unfold rootNode
  rw [Fin.val_one', Nat.mod_eq_of_lt (by omega : 1 < q), pow_one]

def fixedFamily (q : ℕ) (a : ℝ) (z : ℂ) : Fin q ⊕ Fin q → Fin 4 → ℂ :=
  rows (rho q) (phase q) a z (rootNode q)

theorem upper_pair (hq : 7 ≤ q) (ho : Odd q) (a : ℝ) (z : ℂ)
    (h : Admissible (rho q) a z) (i j : Fin q)
    (hij : j = i + halfIndex hq ∨ i = j + halfIndex hq) :
    pair (u (rho q) a (rootNode q i)) (u (rho q) a (rootNode q j)) = 0 := by
  have hf (i : Fin q) :
      pair (u (rho q) a (rootNode q i))
        (u (rho q) a (rootNode q (i + halfIndex hq))) = 0 := by
    rw [uu (rho q) a z _ _ h, rootNode_ratio (by omega : 0 < q),
      add_sub_cancel_left, upper_quadratic hq ho, mul_zero]
  rcases hij with hij | hij
  · rw [hij]; exact hf i
  · apply reverse_zero
    rw [hij]; exact hf j

theorem lower_pair (hq : 7 ≤ q) (ho : Odd q) (a : ℝ) (z : ℂ)
    (h : Admissible (rho q) a z) (i j : Fin q)
    (hij : j = i + predHalfIndex hq ∨ i = j + predHalfIndex hq) :
    pair (v (rho q) (phase q) a z (rootNode q i))
      (v (rho q) (phase q) a z (rootNode q j)) = 0 := by
  have hf (i : Fin q) :
      pair (v (rho q) (phase q) a z (rootNode q i))
        (v (rho q) (phase q) a z (rootNode q (i + predHalfIndex hq))) = 0 := by
    rw [vv (rho q) a (phase q) z _ _ (phase_norm q) h,
      rootNode_ratio (by omega : 0 < q), add_sub_cancel_left,
      lower_quadratic hq ho, mul_zero]
  rcases hij with hij | hij
  · rw [hij]; exact hf i
  · apply reverse_zero
    rw [hij]; exact hf j

theorem cross_pair (hq : 7 ≤ q) (a : ℝ) (z : ℂ)
    (h : Admissible (rho q) a z) (i j : Fin q) (hij : i = j ∨ j = i + 1) :
    pair (u (rho q) a (rootNode q i))
      (v (rho q) (phase q) a z (rootNode q j)) = 0 := by
  rw [uv (rho q) a (phase q) z _ _ h (phase_relation q)]
  rcases hij with hij | hij
  · subst j
    rw [rootNode_unit (by omega : 0 < q)]
    simp
  · rw [hij, rootNode_ratio (by omega : 0 < q), add_sub_cancel_left,
      node_one hq, ← phase_square q]
    simp

theorem prescribed_pairing (hq : 7 ≤ q) (ho : Odd q) (a : ℝ) (z : ℂ)
    (h : Admissible (rho q) a z) (i j : Fin q ⊕ Fin q)
    (hij : P14QuquartGraphCover.E hq i j) :
    pair (fixedFamily q a z i) (fixedFamily q a z j) = 0 := by
  cases i with
  | inl i =>
    cases j with
    | inl j => exact upper_pair hq ho a z h i j hij
    | inr j => exact cross_pair hq a z h i j hij
  | inr i =>
    cases j with
    | inl j =>
      apply reverse_zero
      apply cross_pair hq a z h j i
      rcases hij with hij | hij
      · exact Or.inl hij.symm
      · exact Or.inr hij
    | inr j => exact lower_pair hq ho a z h i j hij

end P14QuquartRootGrid

end
end

section

/-! A quantitative separation bound for three distinct ninth roots.
The coarse pairwise estimate suffices; no sharp triple extremum is assumed. -/
noncomputable section
namespace P14QuquartNineBounds
open P14QuquartLargeOrder P14QuquartRootGrid
open P14FivePrescribedPairings P14FiveRootGrid P14FourierSpectralWeights

theorem cos_fifth_lt : Real.cos (Real.pi / 5) < (5 : ℝ) / 6 := by
  rw [Real.cos_pi_div_five]
  have h := Real.sq_sqrt (show (0 : ℝ) ≤ 5 by norm_num)
  have hp := Real.sqrt_nonneg (5 : ℝ)
  have hlt : Real.sqrt 5 < (7 : ℝ) / 3 := by nlinarith
  linarith

theorem rho_nine_lower : (11 : ℝ) / 6 < rho 9 := by
  have h2 := Real.sq_sqrt (show (0 : ℝ) ≤ 2 by norm_num)
  have h2p := Real.sqrt_nonneg (2 : ℝ)
  have h2l : (7 : ℝ) / 5 < Real.sqrt 2 := by nlinarith
  have hs := Real.sq_sqrt (show (0 : ℝ) ≤ 2 + Real.sqrt 2 by positivity)
  have hsp := Real.sqrt_nonneg (2 + Real.sqrt 2)
  have hsl : (11 : ℝ) / 6 < Real.sqrt (2 + Real.sqrt 2) := by nlinarith
  have hc := Real.cos_le_cos_of_nonneg_of_le_pi
    (show (0 : ℝ) ≤ Real.pi / 9 by positivity)
    (show Real.pi / 8 ≤ Real.pi by linarith [Real.pi_pos])
    (show Real.pi / 9 ≤ Real.pi / 8 by linarith [Real.pi_pos])
  rw [Real.cos_pi_div_eight] at hc
  dsimp [rho]
  norm_num only [Nat.cast_ofNat]
  nlinarith

theorem rho_nine_bounds : (9 : ℝ) / 5 < rho 9 ∧ rho 9 < 2 := by
  have hc := Real.cos_lt_cos_of_nonneg_of_le_pi
    (show (0 : ℝ) ≤ 0 by norm_num)
    (show Real.pi / 9 ≤ Real.pi by linarith [Real.pi_pos])
    (show (0 : ℝ) < Real.pi / 9 by positivity)
  refine ⟨by linarith [rho_nine_lower], ?_⟩
  simp only [Real.cos_zero] at hc
  dsimp [rho]
  norm_num only [Nat.cast_ofNat]
  linarith

theorem sigma_nine : sigma 9 = 1 := by
  rw [sigma_trigonometric]
  norm_num only [Nat.cast_ofNat]
  rw [show 3 * (Real.pi / 9) = Real.pi / 3 by ring, Real.cos_pi_div_three]
  norm_num

theorem nonzero_node_re (k : Fin 9) (hk : k ≠ 0) :
    (rootNode 9 k).re < (5 : ℝ) / 6 := by
  have hs (n : ℕ) (hn1 : 1 ≤ n) (hn4 : n ≤ 4) :
      Real.cos (2 * Real.pi * (n : ℝ) / 9) < (5 : ℝ) / 6 := by
    have h1 : (1 : ℝ) ≤ n := by exact_mod_cast hn1
    have h4 : (n : ℝ) ≤ 4 := by exact_mod_cast hn4
    have hl := mul_le_mul_of_nonneg_left h1 Real.pi_pos.le
    have hu := mul_le_mul_of_nonneg_left h4 Real.pi_pos.le
    have hc := Real.cos_le_cos_of_nonneg_of_le_pi
      (show (0 : ℝ) ≤ Real.pi / 5 by positivity)
      (show 2 * Real.pi * (n : ℝ) / 9 ≤ Real.pi by nlinarith [Real.pi_pos])
      (show Real.pi / 5 ≤ 2 * Real.pi * (n : ℝ) / 9 by nlinarith [Real.pi_pos])
    exact hc.trans_lt cos_fifth_lt
  have hk0 : k.val ≠ 0 := Fin.val_ne_zero_iff.mpr hk
  change (fourierRoot 9 ^ k.val).re < _
  rw [root_pow_re]
  norm_num only [Nat.cast_ofNat]
  by_cases h4 : k.val ≤ 4
  · exact hs k.val (by omega) h4
  · have hb := k.isLt
    have hsub : ((9 - k.val : ℕ) : ℝ) = 9 - (k.val : ℝ) := by
      rw [Nat.cast_sub (by omega : k.val ≤ 9)]
      norm_num
    have he : 2 * Real.pi * (k.val : ℝ) / 9 =
        2 * Real.pi - 2 * Real.pi * ((9 - k.val : ℕ) : ℝ) / 9 := by
      rw [hsub]
      ring
    rw [he, Real.cos_two_pi_sub]
    exact hs (9 - k.val) (by omega) (by omega)

theorem pair_re (i j : Fin 9) (hij : i ≠ j) :
    (star (rootNode 9 i) * rootNode 9 j).re < (5 : ℝ) / 6 := by
  rw [rootNode_ratio (by decide : 0 < 9)]
  apply nonzero_node_re
  intro he
  exact hij (sub_eq_zero.mp he).symm

theorem three_normSq (x y z : ℂ) :
    Complex.normSq (x + y + z) =
      Complex.normSq x + Complex.normSq y + Complex.normSq z +
        2 * (star x * y).re + 2 * (star x * z).re + 2 * (star y * z).re := by
  simp [Complex.normSq_apply, Complex.star_def, Complex.mul_re]
  ring

theorem triple_normSq_lt (y : Fin 3 → Fin 9) (hy : Function.Injective y) :
    Complex.normSq (rootNode 9 (y 0) + rootNode 9 (y 1) + rootNode 9 (y 2)) < 8 := by
  have hn (i : Fin 9) : Complex.normSq (rootNode 9 i) = 1 := by
    rw [Complex.normSq_eq_norm_sq, node_norm (by decide : 0 < 9) i]
    norm_num
  rw [three_normSq, hn, hn, hn]
  have h01 := pair_re (y 0) (y 1) (fun h => (by decide : (0 : Fin 3) ≠ 1) (hy h))
  have h02 := pair_re (y 0) (y 2) (fun h => (by decide : (0 : Fin 3) ≠ 2) (hy h))
  have h12 := pair_re (y 1) (y 2) (fun h => (by decide : (1 : Fin 3) ≠ 2) (hy h))
  linarith

theorem triple_norm_ne (y : Fin 3 → Fin 9) (hy : Function.Injective y) :
    ‖rootNode 9 (y 0) + rootNode 9 (y 1) + rootNode 9 (y 2)‖ ≠
      rho 9 * sigma 9 + 1 := by
  have hn := triple_normSq_lt y hy
  rw [Complex.normSq_eq_norm_sq] at hn
  intro he
  rw [he, sigma_nine, mul_one] at hn
  have hr := rho_nine_lower
  nlinarith

end P14QuquartNineBounds

end
end

section

/-! Exact seventh-root trigonometry and the admissible rho interval.
The close lower bound9/5 comes from the cubic, not decimal approximation. -/
noncomputable section
namespace P14QuquartSevenTrig
open P14QuquartLargeOrder P14FivePrescribedPairings P14FiveRootGrid P14FourierSpectralWeights

def c₁ : ℝ := Real.cos (2 * Real.pi / 7)
def c₂ : ℝ := Real.cos (4 * Real.pi / 7)
def c₃ : ℝ := Real.cos (6 * Real.pi / 7)

theorem rho_coarse : (17 : ℝ) / 10 < rho 7 ∧ rho 7 < 2 := by
  have hs := Real.sq_sqrt (show (0 : ℝ) ≤ 3 by norm_num)
  have hp := Real.sqrt_nonneg (3 : ℝ)
  have hl : (17 : ℝ) / 10 < Real.sqrt 3 := by nlinarith
  have hc := Real.cos_le_cos_of_nonneg_of_le_pi
    (show (0 : ℝ) ≤ Real.pi / 7 by positivity)
    (show Real.pi / 6 ≤ Real.pi by linarith [Real.pi_pos])
    (show Real.pi / 7 ≤ Real.pi / 6 by linarith [Real.pi_pos])
  rw [Real.cos_pi_div_six] at hc
  have hu := Real.cos_lt_cos_of_nonneg_of_le_pi
    (show (0 : ℝ) ≤ 0 by norm_num)
    (show Real.pi / 7 ≤ Real.pi by linarith [Real.pi_pos])
    (show (0 : ℝ) < Real.pi / 7 by positivity)
  simp only [Real.cos_zero] at hu
  dsimp [rho]
  norm_num only [Nat.cast_ofNat]
  constructor <;> nlinarith

theorem rho_cubic : rho 7 ^ 3 - rho 7 ^ 2 - 2 * rho 7 + 1 = 0 := by
  have hc := Real.cos_two_mul (2 * (Real.pi / 7))
  rw [show 2 * (2 * (Real.pi / 7)) = Real.pi - 3 * (Real.pi / 7) by ring,
    Real.cos_pi_sub, Real.cos_three_mul, Real.cos_two_mul] at hc
  have he : (rho 7 + 2) * (rho 7 ^ 3 - rho 7 ^ 2 - 2 * rho 7 + 1) = 0 := by
    dsimp [rho]
    norm_num only [Nat.cast_ofNat]
    nlinarith [hc]
  exact (mul_eq_zero.mp he).resolve_left (by linarith [rho_coarse.1])

theorem rho_bounds : (9 : ℝ) / 5 < rho 7 ∧ rho 7 < 2 := by
  refine ⟨?_, rho_coarse.2⟩
  have hc := rho_cubic
  have hl := rho_coarse.1
  by_contra hn
  have hd : 0 ≤ (9 : ℝ) / 5 - rho 7 := by linarith
  have hp : 0 ≤ rho 7 ^ 2 + (4 : ℝ) / 5 * rho 7 - (14 : ℝ) / 25 := by nlinarith
  have hm := mul_nonneg hd hp
  nlinarith

theorem coefficient : rho 7 * sigma 7 + 1 = rho 7 := by
  unfold sigma
  linear_combination (rho 7 + 1) * rho_cubic

theorem rho_square : rho 7 ^ 2 = 2 + 2 * c₁ := by
  have hc := Real.cos_two_mul (Real.pi / 7)
  dsimp [rho, c₁]
  norm_num only [Nat.cast_ofNat]
  rw [show 2 * Real.pi / 7 = 2 * (Real.pi / 7) by ring]
  nlinarith

def realTable : Fin 7 → ℝ := ![1, c₁, c₂, c₃, c₃, c₂, c₁]

theorem root_real (k : Fin 7) : (rootNode 7 k).re = realTable k := by
  change (fourierRoot 7 ^ k.val).re = _
  rw [root_pow_re]
  fin_cases k <;> norm_num only [Nat.cast_ofNat, Fin.val_mk]
  · norm_num [realTable]
  · change Real.cos (2 * Real.pi * 1 / 7) = c₁
    unfold c₁
    congr 1 <;> ring
  · change Real.cos (2 * Real.pi * 2 / 7) = c₂
    unfold c₂
    congr 1 <;> ring
  · change Real.cos (2 * Real.pi * 3 / 7) = c₃
    unfold c₃
    congr 1 <;> ring
  · change Real.cos (2 * Real.pi * 4 / 7) = c₃
    rw [show 2 * Real.pi * 4 / 7 = 2 * Real.pi - 6 * Real.pi / 7 by ring,
      Real.cos_two_pi_sub]
    rfl
  · change Real.cos (2 * Real.pi * 5 / 7) = c₂
    rw [show 2 * Real.pi * 5 / 7 = 2 * Real.pi - 4 * Real.pi / 7 by ring,
      Real.cos_two_pi_sub]
    rfl
  · change Real.cos (2 * Real.pi * 6 / 7) = c₁
    rw [show 2 * Real.pi * 6 / 7 = 2 * Real.pi - 2 * Real.pi / 7 by ring,
      Real.cos_two_pi_sub]
    rfl

theorem cosine_sum : c₁ + c₂ + c₃ = -(1 : ℝ) / 2 := by
  have hg := (fourierRoot_isPrimitiveRoot 7 (by decide)).geom_sum_eq_zero (by decide)
  have hr := congrArg Complex.re hg
  have hk (k : ℕ) (h : k < 7) : (fourierRoot 7 ^ k).re = realTable ⟨k, h⟩ := root_real ⟨k, h⟩
  simp only [Finset.sum_range_succ, Finset.sum_range_zero, Complex.add_re,
    Complex.zero_re] at hr
  rw [hk 0 (by decide), hk 1 (by decide), hk 2 (by decide), hk 3 (by decide),
    hk 4 (by decide), hk 5 (by decide), hk 6 (by decide)] at hr
  norm_num [realTable] at hr
  linarith

theorem cosine_signs : 0 < c₁ ∧ c₂ < 0 ∧ c₃ < -(1 : ℝ) / 2 := by
  have h1 : 0 < c₁ := by
    apply Real.cos_pos_of_mem_Ioo
    constructor <;> linarith [Real.pi_pos]
  have h2 : c₂ < 0 := by
    apply Real.cos_neg_of_pi_div_two_lt_of_lt <;> linarith [Real.pi_pos]
  have he : c₃ = -Real.cos (Real.pi / 7) := by
    unfold c₃
    rw [show 6 * Real.pi / 7 = Real.pi - Real.pi / 7 by ring, Real.cos_pi_sub]
  refine ⟨h1, h2, ?_⟩
  have hr := rho_coarse.1
  dsimp [rho] at hr
  norm_num only [Nat.cast_ofNat] at hr
  rw [he]
  linarith

end P14QuquartSevenTrig
end
end

section

/-! Generic root-grid minor bridge. The only new grid-specific hypothesis is
the explicit triple norm obstruction, later discharged for q=9. -/
noncomputable section
namespace P14QuquartGridMinors
open Polynomial P14QuquartPolynomialRows P14QuquartFirstJet P14QuquartLargeOrder
open P14FivePrescribedPairings P14QuquartRootGrid

def TripleGap (q : ℕ) : Prop :=
  ∀ y : Fin 3 → Fin q, Function.Injective y →
    ‖rootNode q (y 0) + rootNode q (y 1) + rootNode q (y 2)‖ ≠ rho q * sigma q + 1

theorem real_parameters (r : ℝ) (hl : (9 : ℝ) / 5 < r) (hu : r < 2) :
    r ≠ 0 ∧ r ^ 2 ≠ 1 ∧ r ^ 2 ≠ 2 ∧ r ^ 2 ≠ 4 ∧ r ^ 3 - 3 * r ≠ 0 := by
  have hp : 0 < r := by linarith
  have hs : 3 < r ^ 2 := by nlinarith
  have h4 : r ^ 2 < 4 := by nlinarith
  refine ⟨hp.ne', (by nlinarith), (by nlinarith), ne_of_lt h4, ?_⟩
  apply ne_of_gt
  have hm := mul_pos hp (sub_pos.mpr hs)
  nlinarith

theorem coefficient_pos (r : ℝ) (hl : (9 : ℝ) / 5 < r) :
    0 < r * (r ^ 3 - 3 * r) + 1 := by
  have hp : 0 < r := by linarith
  have hs : 3 < r ^ 2 := by nlinarith
  have hsp : 0 < r ^ 3 - 3 * r := by
    have hm := mul_pos hp (sub_pos.mpr hs)
    nlinarith
  have hm := mul_pos hp hsp
  linarith

theorem identity_impossible (q : ℕ) (hq : 7 ≤ q) (hl : (9 : ℝ) / 5 < rho q)
    (hgap : TripleGap q) (xi x₁ x₂ : ℂ) (y : Fin 3 → Fin q)
    (hxi : ‖xi‖ = 1) (hx₁ : ‖x₁‖ = 1) (hx₂ : ‖x₂‖ = 1)
    (hy : Function.Injective y) :
    ((rho q * sigma q + 1 : ℝ) : ℂ) *
        rootNode q (y 0) * rootNode q (y 1) * rootNode q (y 2) ≠
      xi ^ 2 * x₁ * x₂ * (rootNode q (y 0) + rootNode q (y 1) + rootNode q (y 2)) := by
  have hc : 0 ≤ rho q * sigma q + 1 := (coefficient_pos (rho q) hl).le
  intro he
  have hn := congrArg norm he
  simp only [norm_mul, norm_pow, hxi, hx₁, hx₂,
    node_norm (by omega : 0 < q), one_pow, one_mul, mul_one,
    Complex.norm_real, Real.norm_eq_abs, abs_of_nonneg hc] at hn
  exact hgap y hy hn.symm

theorem exists_minor_not_dvd (q : ℕ) (hq : 7 ≤ q)
    (hl : (9 : ℝ) / 5 < rho q) (hu : rho q < 2) (hgap : TripleGap q)
    (xi x₁ x₂ : ℂ) (y : Fin 3 → Fin q)
    (hxi : ‖xi‖ = 1) (hx₁ : ‖x₁‖ = 1) (hx₂ : ‖x₂‖ = 1)
    (hxx : x₂ ≠ x₁) (hy : Function.Injective y) :
    ∃ i : Fin 3, i ≠ 0 ∧
      ¬ P14QuquartClearedCurve.curve (rho q : ℂ) ∣
        (minor (rho q) xi x₁ x₂ (rootNode q (y 0)) (rootNode q (y i))).det := by
  obtain ⟨hrR, h1R, h2R, h4R, hsR⟩ := real_parameters (rho q) hl hu
  have hr : (rho q : ℂ) ≠ 0 := by exact_mod_cast hrR
  have h1 : (rho q : ℂ) ^ 2 ≠ 1 := by exact_mod_cast h1R
  have h2 : (rho q : ℂ) ^ 2 ≠ 2 := by exact_mod_cast h2R
  have h4 : (rho q : ℂ) ^ 2 ≠ 4 := by exact_mod_cast h4R
  have hs : (rho q : ℂ) ^ 3 - 3 * (rho q : ℂ) ≠ 0 := by exact_mod_cast hsR
  have hxi0 : xi ≠ 0 := by intro he; simp [he] at hxi
  have hy0 := rootNode_ne_zero (by omega : 0 < q) (y 0)
  by_contra hn
  push Not at hn
  have hg : ∀ i, (rootNode q (y i)) ^ 3 *
        f (d (rho q) xi ((rho q : ℂ) ^ 3 - 3 * rho q)⁻¹) x₁ x₂ (rootNode q (y 0)) -
      (rootNode q (y 0)) ^ 3 *
        f (d (rho q) xi ((rho q : ℂ) ^ 3 - 3 * rho q)⁻¹) x₁ x₂ (rootNode q (y i)) = 0 := by
    intro i
    by_cases hi : i = 0
    · subst i; ring
    · exact gap_zero_of_dvd (rho q) xi x₁ x₂ (rootNode q (y 0)) (rootNode q (y i))
        hr h1 h2 h4 hs hy0 hxx (hn i hi)
  have hi := P14QuquartTwoThree.identity_of_gaps (rho q) xi x₁ x₂ (rootNode q ∘ y)
    hr hxi0 hs ((rootNode_injective (by omega : 0 < q)).comp hy) hy0 hg
  apply identity_impossible q hq hl hgap xi x₁ x₂ y hxi hx₁ hx₂ hy
  simpa [sigma, Complex.ofReal_add, Complex.ofReal_mul, Complex.ofReal_sub, Complex.ofReal_pow] using hi

theorem exists_mixed_minors (q : ℕ) (hq : 7 ≤ q)
    (hl : (9 : ℝ) / 5 < rho q) (hu : rho q < 2) (hgap : TripleGap q)
    (xi : ℂ) (hxi : ‖xi‖ = 1) :
    ∃ a : ℝ, ∃ z : ℂ, P14QuquartParameterBranch.Admissible (rho q) a z ∧
      (∀ x : Fin 3 → Fin q, Function.Injective x → ∀ y : Fin q,
        point (a : ℂ) z (threeOne (rho q) xi (rootNode q ∘ x) (rootNode q y)).det ≠ 0) ∧
      (∀ x : Fin 2 → Fin q, Function.Injective x →
        ∀ y : Fin 3 → Fin q, Function.Injective y →
        ∃ i : Fin 3, i ≠ 0 ∧ point (a : ℂ) z
          (minor (rho q) xi (rootNode q (x 0)) (rootNode q (x 1))
            (rootNode q (y 0)) (rootNode q (y i))).det ≠ 0) := by
  classical
  let E (k : ℕ) := {f : Fin k → Fin q // Function.Injective f}
  let T := (E 3 × Fin q) ⊕ (E 2 × E 3)
  have hw := rootNode_injective (by omega : 0 < q)
  have hp : ∀ p : E 2 × E 3, ∃ i : Fin 3, i ≠ 0 ∧
      ¬ P14QuquartClearedCurve.curve (rho q : ℂ) ∣
        (minor (rho q) xi (rootNode q (p.1.val 0)) (rootNode q (p.1.val 1))
          (rootNode q (p.2.val 0)) (rootNode q (p.2.val i))).det := by
    intro p
    exact exists_minor_not_dvd q hq hl hu hgap xi
      (rootNode q (p.1.val 0)) (rootNode q (p.1.val 1)) p.2.val
      hxi (node_norm (by omega) _) (node_norm (by omega) _)
      (fun he => (by decide : (1 : Fin 2) ≠ 0) (p.1.property (hw he))) p.2.property
  let sel : E 2 × E 3 → Fin 3 := fun p => Classical.choose (hp p)
  have hs (p : E 2 × E 3) : sel p ≠ 0 ∧
      ¬ P14QuquartClearedCurve.curve (rho q : ℂ) ∣
        (minor (rho q) xi (rootNode q (p.1.val 0)) (rootNode q (p.1.val 1))
          (rootNode q (p.2.val 0)) (rootNode q (p.2.val (sel p)))).det :=
    Classical.choose_spec (hp p)
  let Q : T → Ring := fun t => match t with
    | .inl (x, y) => (threeOne (rho q) xi (rootNode q ∘ x.val) (rootNode q y)).det
    | .inr p => (minor (rho q) xi (rootNode q (p.1.val 0)) (rootNode q (p.1.val 1))
        (rootNode q (p.2.val 0)) (rootNode q (p.2.val (sel p)))).det
  have hQ : ∀ t, ¬ P14QuquartClearedCurve.curve (rho q : ℂ) ∣ Q t := by
    intro t
    rcases t with ⟨x, y⟩ | p
    · obtain ⟨hr, _, _, _, hsigma⟩ := real_parameters (rho q) hl hu
      apply threeOne_not_dvd (rho q) xi
      · exact_mod_cast hr
      · exact_mod_cast hsigma
      · exact hw.comp x.property
      · exact rootNode_ne_zero (by omega) y
    · exact (hs p).2
  obtain ⟨a, z, hag, hav⟩ := P14QuquartCommonParameter.exists_avoiding (rho q) hl hu Q hQ
  refine ⟨a, z, hag, ?_, ?_⟩
  · intro x hx y
    exact hav (.inl (⟨x, hx⟩, y))
  · intro x hx y hy
    let p : E 2 × E 3 := (⟨x, hx⟩, ⟨y, hy⟩)
    exact ⟨sel p, (hs p).1, hav (.inr p)⟩

end P14QuquartGridMinors

end
end

