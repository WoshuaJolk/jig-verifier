/-! A complex hyperplane whose coefficients share one conjugation phase
is the complex span of its actual real constraint kernel. Real and
imaginary parts give an explicit decomposition; no rank premise is used. -/

noncomputable section
open scoped BigOperators
namespace P14PhaseKernelSpan

variable {ι : Type*} [Fintype ι]

def cmap (a : ι → ℂ) : (ι → ℂ) →ₗ[ℂ] ℂ :=
  ∑ i, (LinearMap.proj i).smulRight (a i)

theorem cmap_apply (a h : ι → ℂ) : cmap a h=∑ i, h i*a i := by
  simp [cmap]

def realSpace (a : ι → ℂ) : Submodule ℝ (ι → ℝ) :=
  LinearMap.ker (P14RealKernelCircuits.constraint a)

def realRow (a : ι → ℂ) (t : realSpace a) : ι → ℂ := fun i => (t.val i : ℂ)

theorem real_mem (a : ι → ℂ) (t : realSpace a) :
    realRow a t ∈ LinearMap.ker (cmap a) := by
  apply LinearMap.mem_ker.mpr
  rw [cmap_apply]
  exact (P14RealKernelCircuits.constraint_apply a t.val).symm.trans
    (LinearMap.mem_ker.mp t.property)

theorem conjugate_zero (a h : ι → ℂ) (c : ℂ) (hc : c ≠ 0)
    (hphase : ∀ i, star (a i)=c*a i) (hh : cmap a h=0) :
    cmap a (fun i => star (h i))=0 := by
  rw [cmap_apply] at hh ⊢
  apply (mul_eq_zero.mp (show c*(∑ i, star (h i)*a i)=0 from ?_)).resolve_left hc
  calc
    c*(∑ i, star (h i)*a i)=∑ i, star (h i)*star (a i) := by
      rw [Finset.mul_sum]
      apply Finset.sum_congr rfl
      intro i _
      rw [hphase i]
      ring
    _ = star (∑ i, h i*a i) := by simp only [star_sum,star_mul,mul_comm]
    _ = 0 := by rw [hh,star_zero]

theorem parts (a h : ι → ℂ) (c : ℂ) (hc : c ≠ 0)
    (hphase : ∀ i, star (a i)=c*a i) (hh : cmap a h=0) :
    P14RealKernelCircuits.constraint a (fun i => (h i).re)=0 ∧
    P14RealKernelCircuits.constraint a (fun i => (h i).im)=0 := by
  have hs := conjugate_zero a h c hc hphase hh
  have hre : (fun i => ((h i).re : ℂ)) =
      (2 : ℂ)⁻¹ • (h+(fun i => star (h i))) := by
    funext i
    simp only [Pi.smul_apply,Pi.add_apply,smul_eq_mul]
    rw [Complex.re_eq_add_conj]
    change (h i+star (h i))/2=(2 : ℂ)⁻¹*(h i+star (h i))
    ring
  have him : (fun i => ((h i).im : ℂ)) =
      (2*Complex.I : ℂ)⁻¹ • (h-(fun i => star (h i))) := by
    funext i
    simp only [Pi.smul_apply,Pi.sub_apply,smul_eq_mul]
    rw [Complex.im_eq_sub_conj]
    change (h i-star (h i))/(2*Complex.I)=(2*Complex.I)⁻¹*(h i-star (h i))
    ring
  constructor
  · rw [P14RealKernelCircuits.constraint_apply,←cmap_apply,hre,map_smul,map_add,hh,hs]
    simp
  · rw [P14RealKernelCircuits.constraint_apply,←cmap_apply,him,map_smul,map_sub,hh,hs]
    simp

theorem span_eq_kernel (a : ι → ℂ) (c : ℂ) (hc : c ≠ 0)
    (hphase : ∀ i, star (a i)=c*a i) :
    Submodule.span ℂ (Set.range (realRow a))=LinearMap.ker (cmap a) := by
  apply le_antisymm
  · apply Submodule.span_le.mpr
    rintro _ ⟨t,rfl⟩
    exact real_mem a t
  · intro h hh
    obtain ⟨hr,hi⟩ := parts a h c hc hphase (LinearMap.mem_ker.mp hh)
    let tr : realSpace a := ⟨fun i => (h i).re,LinearMap.mem_ker.mpr hr⟩
    let ti : realSpace a := ⟨fun i => (h i).im,LinearMap.mem_ker.mpr hi⟩
    have hdecomp : h=realRow a tr+Complex.I • realRow a ti := by
      funext i
      simpa only [realRow,tr,ti,Pi.add_apply,Pi.smul_apply,smul_eq_mul,mul_comm] using
        (Complex.re_add_im (h i)).symm
    rw [hdecomp]
    apply Submodule.add_mem
    · exact Submodule.subset_span ⟨tr,rfl⟩
    · exact Submodule.smul_mem _ _ (Submodule.subset_span ⟨ti,rfl⟩)

end P14PhaseKernelSpan
end
end

