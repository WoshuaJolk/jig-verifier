/-! A large partner absorbs every remaining within-layer edge and a
consecutive cross interval. The remaining cross offsets are actual qubit
matchings. No coprimality of the exceptional cyclic steps is assumed. -/
noncomputable section
namespace P14QuquartDenseCover
open P14OddLayerLabels P14FiveComplementCover P14FivePrescribedPairings
open P14BicliqueComplementConnection
variable {q : ℕ} [NeZero q]

def H (hq : 7 ≤ q) (t : ℕ) : ℕ → ℕ → Prop :=
  P14DenseLayerComplement.H (Side q) (label q)
    (P14OddLayerLabels.cast (halfIndex hq))
    (P14OddLayerLabels.cast (predHalfIndex hq)) 2 t

theorem symmetric (hq : 7 ≤ q) (t : ℕ) {i j : ℕ}
    (h : H hq t i j) : H hq t j i :=
  P14DenseLayerComplement.symmetric _ _ _ _ _ _ h

theorem irreflexive (hq : 7 ≤ q) (t i : ℕ) : ¬ H hq t i i :=
  P14DenseLayerComplement.irreflexive _ _ _ _ _ _ i

theorem bound (hq : 7 ≤ q) (ho : Odd q) (t D : ℕ)
    (ht : t < q - 3) (hD : q - 3 + t + 1 ≤ D) (hqD : q ≤ D) :
    BicliqueBound (H hq t) (Finset.range (2 * q)) D := by
  apply P14DenseLayerComplement.bound _ _ _ labels_injective _ _ _ ho ?_ ?_ t D ht hD hqD
  · intro hz
    have he : halfIndex hq = (0 : Fin q) :=
      cast_injective (by simpa [P14OddLayerLabels.cast] using hz)
    have hv := congrArg Fin.val he
    rw [P14DoubleConeSplit.half_val hq ho] at hv
    change q / 2 = 0 at hv
    omega
  · intro hz
    have he : predHalfIndex hq = (0 : Fin q) :=
      cast_injective (by simpa [P14OddLayerLabels.cast] using hz)
    have hv := congrArg Fin.val he
    rw [P14DoubleConeSplit.pred_val hq ho] at hv
    change q / 2 - 1 = 0 at hv
    omega

theorem avoid (a x y : Fin q) (hxy : x ≠ y)
    (hstep : ¬ (y = x + a ∨ x = y + a)) :
    P14OddLayerLabels.cast y - P14OddLayerLabels.cast x ∉
      ({0, P14OddLayerLabels.cast a, -P14OddLayerLabels.cast a} : Finset (ZMod q)) := by
  have step (i j : Fin q)
      (he : P14OddLayerLabels.cast j - P14OddLayerLabels.cast i = P14OddLayerLabels.cast a) :
      j = i + a := by
    apply cast_injective
    rw [cast_add]
    exact (sub_eq_iff_eq_add.mp he).trans (add_comm _ _)
  simp only [Finset.mem_insert, Finset.mem_singleton]
  rintro (he | he | he)
  · exact hxy (cast_injective (sub_eq_zero.mp he).symm)
  · exact hstep (Or.inl (step x y he))
  · apply hstep
    right
    apply step y x
    simpa only [neg_sub, neg_neg] using congrArg Neg.neg he

def offset {t m : ℕ} (hcount : t + m + 2 = q) (j : Fin m) : Fin q :=
  ⟨2 + t + j.val, by have hj := j.isLt; omega⟩

theorem cover (hq : 7 ≤ q) {t m : ℕ} (hcount : t + m + 2 = q) :
    ∃ F : Fin m → (Fin q ⊕ Fin q) → (Fin q ⊕ Fin q),
      (∀ c, Function.Involutive (F c)) ∧ (∀ c x, F c x ≠ x) ∧
      (∀ x y, x ≠ y → P14QuquartGraphCover.E hq x y ∨
        H hq t (encode x) (encode y) ∨ ∃ c, F c x = y) := by
  classical
  let F : Fin m → (Fin q ⊕ Fin q) → (Fin q ⊕ Fin q) :=
    fun j => P14PrismRemainderCover.crossMatching (offset hcount j)
  have hF (j : Fin m) : Function.Involutive (F j) :=
    P14PrismRemainderCover.cross_involutive _
  have hcross (x y : Fin q) (hdiag : x ≠ y) (hnext : y ≠ x + 1) :
      H hq t (encode (Sum.inl x)) (encode (Sum.inr y)) ∨
        ∃ c, F c (Sum.inl x) = Sum.inr y := by
    have hd : y - x ≠ 0 := sub_ne_zero.mpr hdiag.symm
    have hp := Nat.pos_of_ne_zero (Fin.val_ne_zero_iff.mpr hd)
    have hlt := (y - x).isLt
    have htwo : 2 ≤ (y - x).val := by
      by_contra h
      have hv : (y - x).val = 1 := by omega
      have he : y - x = (1 : Fin q) := by
        apply Fin.ext
        rw [Fin.val_one', Nat.mod_eq_of_lt (by omega)]
        exact hv
      exact hnext (by rw [← he, add_sub_cancel])
    by_cases hi : (y - x).val < 2 + t
    · left
      right
      apply (cross_inl_inr 2 t x y).mpr
      rw [← cast_sub]
      apply Finset.mem_image.mpr
      refine ⟨(y - x).val - 2, Finset.mem_range.mpr (by omega), ?_⟩
      change (2 : ZMod q) + ((y - x).val - 2 : ℕ) = ((y - x).val : ZMod q)
      have he : 2 + ((y - x).val - 2) = (y - x).val := by omega
      simpa only [Nat.cast_add, Nat.cast_ofNat] using congrArg (fun n : ℕ => (n : ZMod q)) he
    · right
      let j : Fin m := ⟨(y - x).val - (2 + t), by omega⟩
      have he : offset hcount j = y - x := by
        apply Fin.ext
        change 2 + t + ((y - x).val - (2 + t)) = (y - x).val
        omega
      refine ⟨j, ?_⟩
      change Sum.inr (x + offset hcount j) = Sum.inr y
      rw [he, add_sub_cancel]
  refine ⟨F, hF, fun j x => P14PrismRemainderCover.cross_ne _ x, ?_⟩
  intro x y hxy
  cases x with
  | inl x =>
    cases y with
    | inl y =>
      by_cases he : P14QuquartGraphCover.E hq (Sum.inl x) (Sum.inl y)
      · exact Or.inl he
      · right; left; left; left
        refine ⟨side_inl x, side_inl y, ?_⟩
        simpa only [label_inl] using avoid (halfIndex hq) x y
          (fun h => hxy (congrArg Sum.inl h)) he
    | inr y =>
      by_cases hd : x = y
      · exact Or.inl (Or.inl hd)
      · by_cases hn : y = x + 1
        · exact Or.inl (Or.inr hn)
        · exact Or.inr (hcross x y hd hn)
  | inr x =>
    cases y with
    | inl y =>
      by_cases hd : x = y
      · exact Or.inl (Or.inl hd)
      · by_cases hn : x = y + 1
        · exact Or.inl (Or.inr hn)
        · rcases hcross y x (fun h => hd h.symm) hn with hh | ⟨j, hj⟩
          · exact Or.inr (Or.inl (symmetric hq t hh))
          · right; right
            refine ⟨j, ?_⟩
            rw [← hj]
            exact hF j (Sum.inl y)
    | inr y =>
      by_cases he : P14QuquartGraphCover.E hq (Sum.inr x) (Sum.inr y)
      · exact Or.inl he
      · right; left; left; right
        refine ⟨side_inr x, side_inr y, ?_⟩
        simpa only [label_inr] using avoid (predHalfIndex hq) x y
          (fun h => hxy (congrArg Sum.inr h)) he

end P14QuquartDenseCover
end
end

section

/-! The cleared quadratic of Wang Appendix D.2 has a discriminant with
a simple complex root. Consequently it is not a rational-function square,
and the cleared quadratic has no rational-function root. All coefficients
are explicit; no irreducibility or generic spanning hypothesis is assumed. -/

noncomputable section
namespace P14QuquartDiscriminant
open Polynomial

def H (r : ℂ) : ℂ[X] := X ^ 2 + C r * X + 1
def A (r : ℂ) : ℂ[X] := X * (X + C r)
def B (r : ℂ) : ℂ[X] := ((C r) ^ 3 - 3 * C r) * H r - 2 * X
def K (r : ℂ) : ℂ[X] := 1 + C r * X
def Q (r : ℂ) : ℂ[X] :=
  C r * ((C r) ^ 2 - 3) ^ 2 * (X ^ 2 + 1) +
    ((C r) ^ 6 - 6 * (C r) ^ 4 + 5 * (C r) ^ 2 + 8) * X
def D (r : ℂ) : ℂ[X] := B r ^ 2 - 4 * A r * K r

theorem factor (r : ℂ) : D r = C r * H r * Q r := by
  unfold D B A K H Q
  ring

theorem remainder (r : ℂ) :
    Q r + 4 * X * ((C r) ^ 2 - 2) =
      C r * ((C r) ^ 2 - 3) ^ 2 * H r := by
  unfold Q H
  ring

theorem simple_root (r : ℂ) (hr : r ≠ 0) (h2 : r ^ 2 ≠ 2) (h4 : r ^ 2 ≠ 4) :
    ∃ t : ℂ, (D r).IsRoot t ∧ (D r).derivative.eval t ≠ 0 := by
  obtain ⟨z, hz⟩ := IsAlgClosed.exists_pow_nat_eq (r ^ 2 - 4) (by norm_num : 0 < (2 : ℕ))
  let t : ℂ := (-r + z) / 2
  have ht : (H r).eval t = 0 := by
    simp only [H, eval_add, eval_pow, eval_X, eval_mul, eval_C, eval_one]
    dsimp [t]
    linear_combination hz / 4
  have ht0 : t ≠ 0 := by
    intro h
    simpa [H, h] using ht
  have hh : (H r).derivative.eval t ≠ 0 := by
    intro he
    have he' : 2 * t + r = 0 := by norm_num [H] at he; exact he
    have ht' : t ^ 2 + r * t + 1 = 0 := by simpa [H] using ht
    apply h4
    linear_combination (2 * t + r) * he' - 4 * ht'
  have hq : (Q r).eval t = -4 * t * (r ^ 2 - 2) := by
    have he := congrArg (fun P : ℂ[X] => P.eval t) (remainder r)
    simp only [eval_add, eval_mul, eval_pow, eval_sub, eval_ofNat, eval_X, eval_C, ht,
      mul_zero] at he
    linear_combination he
  have hq0 : (Q r).eval t ≠ 0 := by
    rw [hq]
    exact mul_ne_zero (mul_ne_zero (by norm_num) ht0) (sub_ne_zero.mpr h2)
  have hd : (D r).IsRoot t := by
    rw [IsRoot.def, factor]
    simp only [eval_mul, eval_C, ht, mul_zero, zero_mul]
  have hder : (D r).derivative.eval t =
      r * (H r).derivative.eval t * (Q r).eval t := by
    rw [factor]
    simp only [derivative_mul, derivative_C, zero_mul, zero_add,
      eval_add, eval_mul, eval_C, ht, mul_zero, zero_mul, add_zero]
  exact ⟨t, hd, by rw [hder]; exact mul_ne_zero (mul_ne_zero hr hh) hq0⟩

theorem no_rational_square (r : ℂ) (hr : r ≠ 0) (h2 : r ^ 2 ≠ 2) (h4 : r ^ 2 ≠ 4)
    (N T : ℂ[X]) (hT : T ≠ 0) : D r * T ^ 2 ≠ N ^ 2 := by
  obtain ⟨t, ht, hd⟩ := simple_root r hr h2 h4
  have hD : D r ≠ 0 := by
    intro h
    apply hd
    simp [h]
  have hmult : (D r).rootMultiplicity t = 1 := by
    have hp := (rootMultiplicity_pos hD).mpr ht
    have hn : ¬ 1 < (D r).rootMultiplicity t := by
      intro hn
      exact hd ((one_lt_rootMultiplicity_iff_isRoot hD).mp hn).2
    omega
  intro h
  have hN : N ≠ 0 := by
    intro hn
    have hh : D r * T ^ 2 ≠ 0 := mul_ne_zero hD (pow_ne_zero _ hT)
    apply hh
    simpa [hn] using h
  simp only [pow_two] at h
  have hm := congrArg (fun P : ℂ[X] => P.rootMultiplicity t) h
  rw [rootMultiplicity_mul (mul_ne_zero hD (mul_ne_zero hT hT)),
    rootMultiplicity_mul (mul_ne_zero hT hT),
    rootMultiplicity_mul (mul_ne_zero hN hN), hmult] at hm
  omega

theorem no_rational_root (r : ℂ) (hr : r ≠ 0) (h2 : r ^ 2 ≠ 2) (h4 : r ^ 2 ≠ 4)
    (N T : ℂ[X]) (hT : T ≠ 0) :
    A r * N ^ 2 - B r * N * T + K r * T ^ 2 ≠ 0 := by
  intro h
  apply no_rational_square r hr h2 h4 (2 * A r * N - B r * T) T hT
  unfold D
  linear_combination -4 * A r * h

end P14QuquartDiscriminant

end
end

