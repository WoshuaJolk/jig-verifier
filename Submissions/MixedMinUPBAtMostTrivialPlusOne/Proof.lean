/-! Shared literal labeling of the actual dimension-five U/V family.
The same a,b,c,t and node map occur in both layers. -/

noncomputable section
namespace P14FiveFamilies

open P14FiveMonomialFamily

def family {ι : Type*} (a b : ℝ) (c t : ℂ) (z : ι → ℂ) :
    (ι ⊕ ι) → Fin 5 → ℂ :=
  Sum.elim (fun i => u a b (z i)) (fun i => v a b c t (z i))

end P14FiveFamilies

end
end

section

/-! The actual dimension-five U/V family on one common cyclic label set.
Only the prescribed internal shifts and diagonal cross pairs are proved
orthogonal. The same fixed weights, phase, nodes and parameter occur in
both layers. No spanning or exact-orthogonality converse is assumed. -/

noncomputable section
namespace P14FivePrescribedPairings

open P14FiveFamilies P14FiveMonomialFamily P14FivePositiveWeights
  P14FiveRootGrid P14FourierSpectralWeights
open scoped BigOperators

/-- The actual Fourier node at a physical cyclic label. -/
def rootNode (q : ℕ) (i : Fin q) : ℂ := fourierRoot q ^ i.val

theorem rootNode_ne_zero {q : ℕ} (hq : 0 < q) (i : Fin q) : rootNode q i ≠ 0 :=
  pow_ne_zero i.val ((fourierRoot_isPrimitiveRoot q hq).ne_zero (Nat.ne_of_gt hq))

theorem rootNode_injective {q : ℕ} (hq : 0 < q) :
    Function.Injective (rootNode q) := by
  intro i j hij
  exact Fin.ext ((fourierRoot_isPrimitiveRoot q hq).pow_inj i.isLt j.isLt hij)

theorem rootNode_unit {q : ℕ} (hq : 0 < q) (i : Fin q) :
    star (rootNode q i) * rootNode q i = 1 := root_pow_unit hq i.val

/-- The finite addition really is reduced modulo q before taking a power. -/
theorem rootNode_add {q : ℕ} (hq : 0 < q) (i j : Fin q) :
    rootNode q (i + j) = rootNode q i * rootNode q j := by
  unfold rootNode
  rw [Fin.val_add]
  exact (pow_eq_pow_mod (i.val + j.val)
    (fourierRoot_isPrimitiveRoot q hq).pow_eq_one).symm.trans (pow_add _ _ _)

/-- Exact cyclic ratio identity, including wraparound of j-i. -/
theorem rootNode_ratio {q : ℕ} (hq : 0 < q) (i j : Fin q) :
    star (rootNode q i) * rootNode q j = rootNode q (j - i) := by
  letI : NeZero q := ⟨Nat.ne_of_gt hq⟩
  have hj : rootNode q j = rootNode q (j - i) * rootNode q i := by
    simpa only [sub_add_cancel] using rootNode_add hq (j - i) i
  rw [hj]
  calc
    _ = rootNode q (j - i) * (star (rootNode q i) * rootNode q i) := by ring
    _ = rootNode q (j - i) := by rw [rootNode_unit hq i, mul_one]

/-- Explicit bounded representatives; no scoped natural cast into Fin is used. -/
def halfIndex {q : ℕ} (hq : 7 ≤ q) : Fin q :=
  ⟨half q, by unfold half; omega⟩

def predHalfIndex {q : ℕ} (hq : 7 ≤ q) : Fin q :=
  ⟨half q - 1, by unfold half; omega⟩

/-- Both orientations of the two internal cyclic shifts. -/
def LayerAdj {q : ℕ} (hq : 7 ≤ q) (i j : Fin q) : Prop :=
  j = i + halfIndex hq ∨ i = j + halfIndex hq ∨
    j = i + predHalfIndex hq ∨ i = j + predHalfIndex hq

/-- Internal shifts in each layer and the diagonal cross-layer matching. -/
def Prescribed {q : ℕ} (hq : 7 ≤ q) : (Fin q ⊕ Fin q) → (Fin q ⊕ Fin q) → Prop
  | .inl i, .inl j => LayerAdj hq i j
  | .inr i, .inr j => LayerAdj hq i j
  | .inl i, .inr j => i = j
  | .inr i, .inl j => i = j

/-- The shared generic family, at the actual fixed weights, phase and nodes. -/
def fixedFamily (q : ℕ) (t : ℂ) : (Fin q ⊕ Fin q) → Fin 5 → ℂ :=
  family (weightA q) (weightB q) (unitPhase q) t (rootNode q)

theorem pair_reverse_zero {x y : Fin 5 → ℂ} (h : pair x y = 0) : pair y x = 0 := by
  simpa [pair, Fin.sum_univ_succ, star_mul, mul_comm] using congrArg star h

theorem u_pair_layerAdj {q : ℕ} (hq : 7 ≤ q) (ho : Odd q)
    (i j : Fin q) (hij : LayerAdj hq i j) :
    pair (u (weightA q) (weightB q) (rootNode q i))
      (u (weightA q) (weightB q) (rootNode q j)) = 0 := by
  have hn : 0 < q := by omega
  letI : NeZero q := ⟨Nat.ne_of_gt hn⟩
  have hhalf : kernel (weightA q) (weightB q) (rootNode q (halfIndex hq)) = 0 := by
    simpa only [rootNode, halfIndex] using (kernel_root_grid hq ho).1
  have hpred : kernel (weightA q) (weightB q) (rootNode q (predHalfIndex hq)) = 0 := by
    simpa only [rootNode, predHalfIndex] using (kernel_root_grid hq ho).2.2.1
  have hforward (a δ : Fin q)
      (hδ : kernel (weightA q) (weightB q) (rootNode q δ) = 0) :
      pair (u (weightA q) (weightB q) (rootNode q a))
        (u (weightA q) (weightB q) (rootNode q (a + δ))) = 0 := by
    rw [u_pair, rootNode_ratio hn, add_sub_cancel_left]
    exact hδ
  rcases hij with hij | hij | hij | hij
  · rw [hij]
    exact hforward i (halfIndex hq) hhalf
  · apply pair_reverse_zero
    rw [hij]
    exact hforward j (halfIndex hq) hhalf
  · rw [hij]
    exact hforward i (predHalfIndex hq) hpred
  · apply pair_reverse_zero
    rw [hij]
    exact hforward j (predHalfIndex hq) hpred

theorem v_pair_layerAdj {q : ℕ} (hq : 7 ≤ q) (ho : Odd q)
    (t : ℂ) (ht : star t * t = 1) (i j : Fin q) (hij : LayerAdj hq i j) :
    pair (v (weightA q) (weightB q) (unitPhase q) t (rootNode q i))
      (v (weightA q) (weightB q) (unitPhase q) t (rootNode q j)) = 0 := by
  rw [v_pair _ _ _ _ (weights_and_phase hq).2.2.1 ht]
  exact u_pair_layerAdj hq ho i j hij

theorem diagonal_pair {q : ℕ} (hq : 7 ≤ q) (t : ℂ) (i : Fin q) :
    pair (u (weightA q) (weightB q) (rootNode q i))
      (v (weightA q) (weightB q) (unitPhase q) t (rootNode q i)) = 0 :=
  matching_pair_zero _ _ _ _ _ (rootNode_unit (by omega : 0 < q) i)
    (weights_and_phase hq).2.2.2

theorem fixedFamily_nonzero {q : ℕ} (hq : 7 ≤ q) (t : ℂ) (i : Fin q ⊕ Fin q) :
    fixedFamily q t i ≠ 0 := by
  have hc : unitPhase q ≠ 0 := by
    intro hc
    have hu := (weights_and_phase hq).2.2.1
    simp [hc] at hu
  cases i with
  | inl i => exact u_ne_zero _ _ _
  | inr i => exact v_ne_zero _ _ hc _ _

/-- Every prescribed edge is orthogonal for the very same actual family. -/
theorem prescribed_pairing {q : ℕ} (hq : 7 ≤ q) (ho : Odd q)
    (t : ℂ) (ht : star t * t = 1) (i j : Fin q ⊕ Fin q)
    (hij : Prescribed hq i j) : pair (fixedFamily q t i) (fixedFamily q t j) = 0 := by
  cases i with
  | inl i =>
      cases j with
      | inl j => exact u_pair_layerAdj hq ho i j hij
      | inr j =>
          change i = j at hij
          subst j
          exact diagonal_pair hq t i
  | inr i =>
      cases j with
      | inl j =>
          change i = j at hij
          subst j
          exact pair_reverse_zero (diagonal_pair hq t i)
      | inr j => exact v_pair_layerAdj hq ho t ht i j hij

/-- The norm-one form matches the finite polynomial-avoidance output. -/
theorem prescribed_pairing_of_norm {q : ℕ} (hq : 7 ≤ q) (ho : Odd q)
    (t : ℂ) (ht : ‖t‖ = 1) (i j : Fin q ⊕ Fin q) (hij : Prescribed hq i j) :
    pair (fixedFamily q t i) (fixedFamily q t j) = 0 := by
  have ht' : star t * t = 1 := by
    change (starRingEnd ℂ) t * t = 1
    simpa only [ht, one_pow, Complex.ofReal_one] using Complex.conj_mul' t
  exact prescribed_pairing hq ho t ht' i j hij

end P14FivePrescribedPairings

end
end

section

/-! A full complement cover for the actual dimension-five prescribed graph.
Every small internal step is paired with one cross offset and uses the three
global prism colors. The remaining cross offsets each use one matching. -/

noncomputable section
namespace P14FiveComplementCover

open P14FiveRootGrid P14FivePrescribedPairings P14CyclicStepPrisms

def smallCount (q : ℕ) : ℕ := (q - 5) / 2

theorem smallCount_spec {q : ℕ} (hq : 7 ≤ q) (ho : Odd q) :
    2 * smallCount q + 5 = q := by
  have hh := half_spec ho
  dsimp only [smallCount]
  omega

def smallStep {q : ℕ} (hq : 7 ≤ q) (i : Fin (smallCount q)) : Fin q :=
  ⟨i.val + 1, by have hi := i.isLt; dsimp only [smallCount] at hi; omega⟩

def remainingOffset {q : ℕ} (hq : 7 ≤ q)
    (i : Fin (q - 1 - smallCount q)) : Fin q :=
  ⟨smallCount q + 1 + i.val, by
    have hi := i.isLt
    dsimp only [smallCount] at *
    omega⟩

theorem internal_cover {q : ℕ} [NeZero q] (hq : 7 ≤ q) (ho : Odd q)
    (x y : Fin q) (hxy : x ≠ y) :
    LayerAdj hq x y ∨ ∃ i : Fin (smallCount q),
      y = x + smallStep hq i ∨ x = y + smallStep hq i := by
  have hd : y - x ≠ 0 := sub_ne_zero.mpr hxy.symm
  have he : x - y ≠ 0 := sub_ne_zero.mpr hxy
  have hdp : 0 < (y - x).val := Nat.pos_of_ne_zero (Fin.val_ne_zero_iff.mpr hd)
  have hep : 0 < (x - y).val := Nat.pos_of_ne_zero (Fin.val_ne_zero_iff.mpr he)
  have hdlt := (y - x).isLt
  have helt := (x - y).isLt
  have hsum : (x - y).val + (y - x).val = q := by
    have hneg : x - y = -(y - x) := (neg_sub y x).symm
    rw [hneg, Fin.val_neg, if_neg hd]
    omega
  by_cases hlo : (y - x).val ≤ smallCount q
  · let i : Fin (smallCount q) := ⟨(y - x).val - 1, by omega⟩
    have hi : smallStep hq i = y - x := by
      apply Fin.ext
      change (y - x).val - 1 + 1 = (y - x).val
      omega
    exact Or.inr ⟨i, Or.inl (by rw [hi, add_sub_cancel])⟩
  by_cases hrev : (x - y).val ≤ smallCount q
  · let i : Fin (smallCount q) := ⟨(x - y).val - 1, by omega⟩
    have hi : smallStep hq i = x - y := by
      apply Fin.ext
      change (x - y).val - 1 + 1 = (x - y).val
      omega
    exact Or.inr ⟨i, Or.inr (by rw [hi, add_sub_cancel])⟩
  have hh := half_spec ho
  have hr := smallCount_spec hq ho
  have hopts : (y - x).val = half q ∨ (x - y).val = half q ∨
      (y - x).val = half q - 1 ∨ (x - y).val = half q - 1 := by omega
  left
  rcases hopts with h | h | h | h
  · have heq : y - x = halfIndex hq := Fin.ext h
    exact Or.inl (by rw [← heq, add_sub_cancel])
  · have heq : x - y = halfIndex hq := Fin.ext h
    exact Or.inr (Or.inl (by rw [← heq, add_sub_cancel]))
  · have heq : y - x = predHalfIndex hq := Fin.ext h
    exact Or.inr (Or.inr (Or.inl (by rw [← heq, add_sub_cancel])))
  · have heq : x - y = predHalfIndex hq := Fin.ext h
    exact Or.inr (Or.inr (Or.inr (by rw [← heq, add_sub_cancel])))

def crossMatching {q : ℕ} (d : Fin q) : (Fin q ⊕ Fin q) → (Fin q ⊕ Fin q) :=
  Sum.elim (fun x => Sum.inr (x + d)) (fun y => Sum.inl (y - d))

theorem crossMatching_involutive {q : ℕ} [NeZero q] (d : Fin q) :
    Function.Involutive (crossMatching d) := by
  intro x
  cases x with
  | inl x => change Sum.inl ((x + d) - d) = Sum.inl x; rw [add_sub_cancel_right]
  | inr x => change Sum.inr ((x - d) + d) = Sum.inr x; rw [sub_add_cancel]

theorem crossMatching_ne {q : ℕ} (d : Fin q) (x : Fin q ⊕ Fin q) :
    crossMatching d x ≠ x := by
  cases x with
  | inl x => exact Sum.inr_ne_inl
  | inr x => exact Sum.inl_ne_inr

theorem exists_complement_matchings {q : ℕ} (hq : 7 ≤ q) (ho : Odd q) :
    ∃ F : Fin (2 * q - 6) → (Fin q ⊕ Fin q) → (Fin q ⊕ Fin q),
      (∀ c, Function.Involutive (F c)) ∧
      (∀ c x, F c x ≠ x) ∧
      (∀ x y, x ≠ y → Prescribed hq x y ∨ ∃ c, F c x = y) := by
  classical
  letI : NeZero q := ⟨by omega⟩
  have hs (i : Fin (smallCount q)) :
      ∃ F : Fin 3 → (Fin q ⊕ Fin q) → (Fin q ⊕ Fin q),
        (∀ c, Function.Involutive (F c)) ∧ (∀ c x, F c x ≠ x) ∧
        (∀ x y, stepPrismAdj (smallStep hq i) x y ↔ ∃ c, F c x = y) := by
    apply exists_matchings (by omega) ho (smallStep hq i)
    intro hzero
    have hval := congrArg Fin.val hzero
    change i.val + 1 = 0 at hval
    omega
  choose G hG hGne hGC using hs
  let C := (Fin (smallCount q) × Fin 3) ⊕ Fin (q - 1 - smallCount q)
  let all : C → (Fin q ⊕ Fin q) → (Fin q ⊕ Fin q) :=
    Sum.elim (fun p => G p.1 p.2) (fun c => crossMatching (remainingOffset hq c))
  have hall (c : C) : Function.Involutive (all c) := by
    cases c with
    | inl p => exact hG p.1 p.2
    | inr c => exact crossMatching_involutive _
  have hallne (c : C) (x : Fin q ⊕ Fin q) : all c x ≠ x := by
    cases c with
    | inl p => exact hGne p.1 p.2 x
    | inr c => exact crossMatching_ne _ x
  have hcover (x y : Fin q ⊕ Fin q) (hxy : x ≠ y) :
      Prescribed hq x y ∨ ∃ c : C, all c x = y := by
    cases x with
    | inl x =>
      cases y with
      | inl y =>
        rcases internal_cover hq ho x y (fun h => hxy (congrArg Sum.inl h)) with h | ⟨i, hi⟩
        · exact Or.inl h
        · obtain ⟨c, hc⟩ := (hGC i (Sum.inl x) (Sum.inl y)).mp hi
          exact Or.inr ⟨Sum.inl (i, c), hc⟩
      | inr y =>
        by_cases hdiag : x = y
        · exact Or.inl hdiag
        have hd : y - x ≠ 0 := sub_ne_zero.mpr (fun h => hdiag h.symm)
        have hpos : 0 < (y - x).val := Nat.pos_of_ne_zero (Fin.val_ne_zero_iff.mpr hd)
        have hlt := (y - x).isLt
        by_cases hsmall : (y - x).val ≤ smallCount q
        · let i : Fin (smallCount q) := ⟨(y - x).val - 1, by omega⟩
          have hi : smallStep hq i = y - x := by apply Fin.ext; change _ - 1 + 1 = _; omega
          have hadj : stepPrismAdj (smallStep hq i) (Sum.inl x) (Sum.inr y) := by
            change y = x + smallStep hq i
            rw [hi, add_sub_cancel]
          obtain ⟨c, hc⟩ := (hGC i _ _).mp hadj
          exact Or.inr ⟨Sum.inl (i, c), hc⟩
        · let i : Fin (q - 1 - smallCount q) :=
            ⟨(y - x).val - smallCount q - 1, by omega⟩
          have hi : remainingOffset hq i = y - x := by
            apply Fin.ext
            change smallCount q + 1 + ((y - x).val - smallCount q - 1) = (y - x).val
            omega
          refine Or.inr ⟨Sum.inr i, ?_⟩
          change Sum.inr (x + remainingOffset hq i) = Sum.inr y
          rw [hi, add_sub_cancel]
    | inr x =>
      cases y with
      | inl y =>
        by_cases hdiag : x = y
        · exact Or.inl hdiag
        have hd : x - y ≠ 0 := sub_ne_zero.mpr hdiag
        have hpos : 0 < (x - y).val := Nat.pos_of_ne_zero (Fin.val_ne_zero_iff.mpr hd)
        have hlt := (x - y).isLt
        by_cases hsmall : (x - y).val ≤ smallCount q
        · let i : Fin (smallCount q) := ⟨(x - y).val - 1, by omega⟩
          have hi : smallStep hq i = x - y := by apply Fin.ext; change _ - 1 + 1 = _; omega
          have hadj : stepPrismAdj (smallStep hq i) (Sum.inr x) (Sum.inl y) := by
            change x = y + smallStep hq i
            rw [hi, add_sub_cancel]
          obtain ⟨c, hc⟩ := (hGC i _ _).mp hadj
          exact Or.inr ⟨Sum.inl (i, c), hc⟩
        · let i : Fin (q - 1 - smallCount q) :=
            ⟨(x - y).val - smallCount q - 1, by omega⟩
          have hi : remainingOffset hq i = x - y := by
            apply Fin.ext
            change smallCount q + 1 + ((x - y).val - smallCount q - 1) = (x - y).val
            omega
          refine Or.inr ⟨Sum.inr i, ?_⟩
          change Sum.inl (x - remainingOffset hq i) = Sum.inl y
          rw [hi, sub_sub_self]
      | inr y =>
        rcases internal_cover hq ho x y (fun h => hxy (congrArg Sum.inr h)) with h | ⟨i, hi⟩
        · exact Or.inl h
        · obtain ⟨c, hc⟩ := (hGC i (Sum.inr x) (Sum.inr y)).mp hi
          exact Or.inr ⟨Sum.inl (i, c), hc⟩
  have hcard : Fintype.card C = 2 * q - 6 := by
    simp only [C, Fintype.card_sum, Fintype.card_prod, Fintype.card_fin]
    have hr := smallCount_spec hq ho
    omega
  let e : Fin (2 * q - 6) ≃ C := (Fintype.equivFinOfCardEq hcard).symm
  refine ⟨fun c => all (e c), fun c => hall (e c), fun c => hallne (e c), ?_⟩
  intro x y hxy
  rcases hcover x y hxy with h | ⟨c, hc⟩
  · exact Or.inl h
  · exact Or.inr ⟨e.symm c, by simpa only [Equiv.apply_symm_apply] using hc⟩

end P14FiveComplementCover

end
end

section

/-! The actual phase for the uniform double-cone qutrit construction.
An elementary product identity puts it strictly between two and three
grid half-steps, excluding the resonance that could destroy spanning. -/

noncomputable section
namespace P14DoubleConePhase

def x (q : ℕ) : ℝ := Real.pi / q
def R (q : ℕ) : ℝ := Real.cos (x q)
def S (q : ℕ) : ℝ := Real.cos (3 * x q)
def delta (q : ℕ) : ℝ := Real.arccos (Real.sqrt (R q * S q))
def eta (q : ℕ) : ℂ := Complex.exp ((delta q : ℂ) * Complex.I)

theorem x_pos {q : ℕ} (hq : 7 ≤ q) : 0 < x q :=
  div_pos Real.pi_pos (Nat.cast_pos.mpr (by omega))

theorem three_x_lt {q : ℕ} (hq : 7 ≤ q) : 3 * x q < Real.pi / 2 := by
  have hq0 : (0 : ℝ) < q := Nat.cast_pos.mpr (by omega)
  have hq7 : (7 : ℝ) ≤ q := by exact_mod_cast hq
  dsimp [x]
  apply (lt_div_iff₀ (by norm_num : (0 : ℝ) < 2)).mpr
  have h : 6 * Real.pi < Real.pi * (q : ℝ) := by nlinarith [Real.pi_pos]
  have h' := (div_lt_iff₀ hq0).mpr h
  convert h' using 1 <;> ring

theorem positive {q : ℕ} (hq : 7 ≤ q) : 0 < S q ∧ S q < R q ∧ 0 < R q := by
  have hx := x_pos hq
  have h3 := three_x_lt hq
  have hs : 0 < S q := Real.cos_pos_of_mem_Ioo ⟨by linarith [Real.pi_pos], h3⟩
  have hsr : S q < R q :=
    Real.cos_lt_cos_of_nonneg_of_le_pi (le_of_lt hx) (by linarith [Real.pi_pos]) (by linarith)
  exact ⟨hs, hsr, hs.trans hsr⟩

theorem product_identity (t : ℝ) :
    Real.cos t * Real.cos (3 * t) = Real.cos (2 * t) ^ 2 - Real.sin t ^ 2 := by
  have h := Real.sin_sq_add_cos_sq (2 * t)
  have ht := Real.sin_sq_add_cos_sq t
  calc
    Real.cos t * Real.cos (3 * t) = Real.cos (2 * t - t) * Real.cos (2 * t + t) := by
      congr 1 <;> congr 1 <;> ring
    _ = Real.cos (2 * t) ^ 2 - Real.sin t ^ 2 := by
      rw [Real.cos_sub, Real.cos_add]
      linear_combination (Real.cos (2 * t)) ^ 2 * ht - (Real.sin t) ^ 2 * h

theorem sqrt_bounds {q : ℕ} (hq : 7 ≤ q) :
    S q < Real.sqrt (R q * S q) ∧ Real.sqrt (R q * S q) < Real.cos (2 * x q) := by
  obtain ⟨hs, hsr, hr⟩ := positive hq
  have hx := x_pos hq
  have h3 := three_x_lt hq
  have h2 : 0 < Real.cos (2 * x q) := Real.cos_pos_of_mem_Ioo ⟨by linarith [Real.pi_pos], by linarith⟩
  have hsin : 0 < Real.sin (x q) := Real.sin_pos_of_pos_of_lt_pi hx (by linarith [Real.pi_pos])
  have hsq := Real.sq_sqrt (mul_nonneg hr.le hs.le)
  have hn := Real.sqrt_nonneg (R q * S q)
  have hi : R q * S q = Real.cos (2 * x q) ^ 2 - Real.sin (x q) ^ 2 := product_identity (x q)
  constructor
  · nlinarith [mul_pos hs (sub_pos.mpr hsr)]
  · nlinarith [sq_pos_of_pos hsin]

theorem delta_bounds {q : ℕ} (hq : 7 ≤ q) : 2 * x q < delta q ∧ delta q < 3 * x q := by
  obtain ⟨hs, hsr, _⟩ := positive hq
  obtain ⟨hl, hu⟩ := sqrt_bounds hq
  have hx := x_pos hq
  have h3 := three_x_lt hq
  have hn := Real.sqrt_nonneg (R q * S q)
  have ha := Real.arccos_lt_arccos (by linarith : -1 ≤ Real.sqrt (R q * S q)) hu
    (Real.cos_le_one (2 * x q))
  have hb := Real.arccos_lt_arccos (by dsimp [S]; exact Real.neg_one_le_cos _) hl
    (hu.le.trans (Real.cos_le_one _))
  rw [Real.arccos_cos (by linarith) (by linarith [Real.pi_pos])] at ha
  change delta q < Real.arccos (Real.cos (3 * x q)) at hb
  rw [Real.arccos_cos (by linarith) (by linarith [Real.pi_pos])] at hb
  exact ⟨ha, hb⟩

theorem cos_delta {q : ℕ} (hq : 7 ≤ q) :
    Real.cos (delta q) = Real.sqrt (R q * S q) := by
  obtain ⟨_, hu⟩ := sqrt_bounds hq
  exact Real.cos_arccos (by linarith [Real.sqrt_nonneg (R q * S q)])
    (hu.le.trans (Real.cos_le_one _))

theorem delta_ne_grid {q : ℕ} (hq : 7 ≤ q) (n : ℤ) : delta q ≠ (n : ℝ) * x q := by
  intro he
  obtain ⟨hl, hu⟩ := delta_bounds hq
  rw [he] at hl hu
  have hn2 : (2 : ℝ) < n := (mul_lt_mul_iff_left₀ (x_pos hq)).mp hl
  have hn3 : (n : ℝ) < 3 := (mul_lt_mul_iff_left₀ (x_pos hq)).mp hu
  have hn2' : (2 : ℤ) < n := by exact_mod_cast hn2
  have hn3' : n < (3 : ℤ) := by exact_mod_cast hn3
  omega

theorem eta_nonresonant {q : ℕ} (hq : 7 ≤ q) : eta q ^ (2 * q) ≠ 1 := by
  intro he
  rw [eta, ← Complex.exp_nat_mul] at he
  obtain ⟨n, hn⟩ := Complex.exp_eq_one_iff.mp he
  have hi := congrArg Complex.im hn
  norm_num at hi
  apply delta_ne_grid hq n
  have hq0 : (q : ℝ) ≠ 0 := by exact_mod_cast (show q ≠ 0 by omega)
  dsimp [x]
  rw [← mul_div_assoc]
  apply (eq_div_iff hq0).mpr
  nlinarith [hi]

end P14DoubleConePhase

end
end

section

/-! Two circle orbits in three complex coordinates. Quadratic root products
exclude a common annihilator of two rows in each orbit when the relative
phase is nonresonant. Three rows in either orbit also span. -/

noncomputable section
namespace P14DoubleConeSpanning
open scoped BigOperators

def cone (c z : ℂ) : Fin 3 → ℂ := ![c, star z, z]

theorem cone_ne_zero (c z : ℂ) (hc : c ≠ 0) : cone c z ≠ 0 := by
  intro he
  exact hc (congrFun he 0)

theorem cone_pair_shift (c d z t : ℂ) (hu : star z * z = 1) :
    (∑ r, star (cone c z r) * cone d (z * t) r) = star c * d + star t + t := by
  simp only [cone, Fin.sum_univ_succ, Fin.sum_univ_zero, add_zero,
    Matrix.cons_val_zero, Matrix.cons_val_succ, star_star, star_mul]
  calc
    _ = star c * d + (star z * z) * star t + (star z * z) * t := by ring
    _ = _ := by rw [hu]; ring

theorem quadratic_pair (A B C z w : ℂ) (hzw : z ≠ w)
    (hz : A * z ^ 2 + B * z + C = 0)
    (hw : A * w ^ 2 + B * w + C = 0) :
    A * (z + w) + B = 0 ∧ C = A * z * w := by
  have he : (z - w) * (A * (z + w) + B) = 0 := by linear_combination hz - hw
  have hl := (mul_eq_zero.mp he).resolve_left (sub_ne_zero.mpr hzw)
  exact ⟨hl, by linear_combination hz - z * hl⟩

theorem quadratic_three (A B C z w t : ℂ) (hz0 : z ≠ 0)
    (hzw : z ≠ w) (hzt : z ≠ t) (hwt : w ≠ t)
    (hz : A * z ^ 2 + B * z + C = 0)
    (hw : A * w ^ 2 + B * w + C = 0)
    (ht : A * t ^ 2 + B * t + C = 0) : A = 0 ∧ B = 0 ∧ C = 0 := by
  obtain ⟨hl, hc⟩ := quadratic_pair A B C z w hzw hz hw
  have hc' := (quadratic_pair A B C z t hzt hz ht).2
  have hp : A * z * (w - t) = 0 := by linear_combination hc' - hc
  have hA := (mul_eq_zero.mp ((mul_eq_zero.mp hp).resolve_right
    (sub_ne_zero.mpr hwt))).resolve_right hz0
  exact ⟨hA, by simpa [hA] using hl, by simpa [hA] using hc⟩

theorem annihilator_equation (c z : ℂ) (hu : star z * z = 1)
    (a : Fin 3 → ℂ) (ha : (∑ r, star (cone c z r) * a r) = 0) :
    a 1 * z ^ 2 + (star c * a 0) * z + a 2 = 0 := by
  have he : star c * a 0 + z * a 1 + star z * a 2 = 0 := by
    simpa [cone, Fin.sum_univ_succ, add_assoc] using ha
  linear_combination z * he - a 2 * hu

theorem zero_of_coefficients (c : ℂ) (hc : c ≠ 0) (a : Fin 3 → ℂ)
    (h1 : a 1 = 0) (h0 : star c * a 0 = 0) (h2 : a 2 = 0) : a = 0 := by
  have hz : a 0 = 0 := (mul_eq_zero.mp h0).resolve_left (star_ne_zero.mpr hc)
  funext j
  fin_cases j <;> assumption

theorem layer_bound {ι : Type*} (c : ℂ) (hc : c ≠ 0) (z : ι → ℂ)
    (hz : Function.Injective z) (hu : ∀ i, star (z i) * z i = 1)
    (a : Fin 3 → ℂ) (ha : a ≠ 0) (T : Finset ι)
    (hT : ∀ i ∈ T, (∑ r, star (cone c (z i) r) * a r) = 0) : T.card ≤ 2 := by
  classical
  by_contra hl
  obtain ⟨i, hi, j, hj, k, hk, hij, hik, hjk⟩ := Finset.two_lt_card.mp (by omega : 2 < T.card)
  have hi0 : z i ≠ 0 := by intro h; simpa [h] using hu i
  have hcoeff := quadratic_three (a 1) (star c * a 0) (a 2) (z i) (z j) (z k)
    hi0 (fun h => hij (hz h)) (fun h => hik (hz h)) (fun h => hjk (hz h))
    (annihilator_equation c (z i) (hu i) a (hT i hi))
    (annihilator_equation c (z j) (hu j) a (hT j hj))
    (annihilator_equation c (z k) (hu k) a (hT k hk))
  exact ha (zero_of_coefficients c hc a hcoeff.1 hcoeff.2.1 hcoeff.2.2)

def rows {ι : Type*} (c₀ c₁ η : ℂ) (z : ι → ℂ) : ι ⊕ ι → Fin 3 → ℂ :=
  Sum.elim (fun i => cone c₀ (z i)) (fun i => cone c₁ (η * z i))

theorem killing_bound {ι : Type*} (q : ℕ) (c₀ c₁ η : ℂ) (z : ι → ℂ)
    (hc₀ : c₀ ≠ 0) (hc₁ : c₁ ≠ 0) (hz : Function.Injective z)
    (hu : ∀ i, star (z i) * z i = 1) (hηu : star η * η = 1)
    (hpow : ∀ i, z i ^ q = 1) (hη : η ^ (2 * q) ≠ 1)
    (a : Fin 3 → ℂ) (ha : a ≠ 0) (T : Finset (ι ⊕ ι))
    (hT : ∀ i ∈ T, (∑ r, star (rows c₀ c₁ η z i r) * a r) = 0) : T.card ≤ 3 := by
  classical
  have hη0 : η ≠ 0 := by intro h; simpa [h] using hηu
  have hv : ∀ i, star (η * z i) * (η * z i) = 1 := by
    intro i
    calc
      star (η * z i) * (η * z i) = (star η * η) * (star (z i) * z i) := by rw [star_mul]; ring
      _ = 1 := by rw [hηu, hu]; ring
  have hzinj : Function.Injective (fun i => η * z i) := by
    intro i j he
    exact hz (mul_left_cancel₀ hη0 he)
  have hL : ∀ i ∈ T.toLeft, (∑ r, star (cone c₀ (z i) r) * a r) = 0 :=
    fun i hi => hT (Sum.inl i) (Finset.mem_toLeft.mp hi)
  have hR : ∀ i ∈ T.toRight, (∑ r, star (cone c₁ (η * z i) r) * a r) = 0 :=
    fun i hi => hT (Sum.inr i) (Finset.mem_toRight.mp hi)
  have hl := layer_bound c₀ hc₀ z hz hu a ha T.toLeft hL
  have hr := layer_bound c₁ hc₁ (fun i => η * z i) hzinj hv a ha T.toRight hR
  have hcard := T.card_toLeft_add_card_toRight
  by_contra hlarge
  obtain ⟨i, hi, j, hj, hij⟩ := Finset.one_lt_card.mp (by omega : 1 < T.toLeft.card)
  obtain ⟨k, hk, l, hl', hkl⟩ := Finset.one_lt_card.mp (by omega : 1 < T.toRight.card)
  obtain ⟨hlin, hp⟩ := quadratic_pair (a 1) (star c₀ * a 0) (a 2) (z i) (z j)
    (fun he => hij (hz he))
    (annihilator_equation c₀ (z i) (hu i) a (hL i hi))
    (annihilator_equation c₀ (z j) (hu j) a (hL j hj))
  have hp' := (quadratic_pair (a 1) (star c₁ * a 0) (a 2) (η * z k) (η * z l)
    (fun he => hkl (hzinj he))
    (annihilator_equation c₁ (η * z k) (hv k) a (hR k hk))
    (annihilator_equation c₁ (η * z l) (hv l) a (hR l hl'))).2
  have ha1 : a 1 ≠ 0 := by
    intro he
    apply ha (zero_of_coefficients c₀ hc₀ a he ?_ ?_)
    · simpa [he] using hlin
    · simpa [he] using hp
  have he : z i * z j = (η * z k) * (η * z l) := by
    apply mul_left_cancel₀ ha1
    linear_combination hp' - hp
  have heq := congrArg (fun w : ℂ => w ^ q) he
  apply hη
  simpa only [mul_pow, hpow, mul_one, ← pow_add, ← two_mul] using heq.symm

end P14DoubleConeSpanning

end
end

section

/-! Actual uniform qutrit vectors for odd q>=7. Every four rows span in
the annihilator sense, and the two specified cyclic layer graphs and
identity cross matching are realized by complex orthogonality. -/

noncomputable section
namespace P14DoubleConeQutrit
open P14DoubleConePhase P14DoubleConeSpanning P14FourierSpectralWeights
open scoped BigOperators

def unit (t : ℝ) : ℂ := Complex.exp ((t : ℂ) * Complex.I)
def height (t : ℝ) : ℂ := (Real.sqrt (2 * t) : ℂ)
def z (q : ℕ) (i : Fin q) : ℂ := fourierRoot q ^ i.val
def row (q : ℕ) : Fin q ⊕ Fin q → Fin 3 → ℂ :=
  rows (height (R q)) (-height (S q)) (eta q) (z q)

theorem unit_unit (t : ℝ) : star (unit t) * unit t = 1 := by
  change (starRingEnd ℂ) (Complex.exp ((t : ℂ) * Complex.I)) *
    Complex.exp ((t : ℂ) * Complex.I) = 1
  rw [← Complex.exp_conj, ← Complex.exp_add]
  convert Complex.exp_zero using 1 <;> simp

theorem unit_sum (t : ℝ) : star (unit t) + unit t = 2 * (Real.cos t : ℂ) := by
  simp only [unit, Complex.exp_mul_I, ← Complex.ofReal_cos, ← Complex.ofReal_sin,
    star_add, star_mul, Complex.star_def, Complex.conj_ofReal, Complex.conj_I]
  ring

theorem unit_pow (t : ℝ) (n : ℕ) : unit t ^ n = unit ((n : ℝ) * t) := by
  simp only [unit, ← Complex.exp_nat_mul, Complex.ofReal_mul, Complex.ofReal_natCast]
  congr 1
  ring

theorem root_unit (q : ℕ) : fourierRoot q = unit (2 * x q) := by
  simp only [fourierRoot, unit, x, Complex.ofReal_mul, Complex.ofReal_div,
    Complex.ofReal_ofNat, Complex.ofReal_natCast]
  congr 1
  ring

theorem z_unit (q : ℕ) (i : Fin q) : star (z q i) * z q i = 1 := by
  rw [z, star_pow, ← mul_pow, root_unit, unit_unit, one_pow]

theorem z_injective {q : ℕ} (hq : 7 ≤ q) : Function.Injective (z q) := by
  intro i j he
  exact Fin.ext ((fourierRoot_isPrimitiveRoot q (by omega)).pow_inj i.isLt j.isLt he)

theorem z_pow {q : ℕ} (hq : 7 ≤ q) (i : Fin q) : z q i ^ q = 1 := by
  unfold z
  rw [← pow_mul, Nat.mul_comm i.val q, pow_mul,
    (fourierRoot_isPrimitiveRoot q (by omega)).pow_eq_one, one_pow]

theorem height_ne_zero {t : ℝ} (ht : 0 < t) : height t ≠ 0 :=
  Complex.ofReal_ne_zero.mpr (ne_of_gt (Real.sqrt_pos.mpr (by linarith)))

theorem height_square {t : ℝ} (ht : 0 ≤ t) : star (height t) * height t = 2 * (t : ℂ) := by
  have h := Real.sq_sqrt (by linarith : 0 ≤ 2 * t)
  simp only [height, Complex.star_def, Complex.conj_ofReal]
  exact_mod_cast (by simpa only [pow_two] using h)

theorem row_ne_zero {q : ℕ} (hq : 7 ≤ q) (i : Fin q ⊕ Fin q) : row q i ≠ 0 := by
  obtain ⟨hs, _, hr⟩ := positive hq
  cases i with
  | inl i => exact cone_ne_zero _ _ (height_ne_zero hr)
  | inr i => exact cone_ne_zero _ _ (neg_ne_zero.mpr (height_ne_zero hs))

theorem killing_bound {q : ℕ} (hq : 7 ≤ q) (a : Fin 3 → ℂ) (ha : a ≠ 0)
    (T : Finset (Fin q ⊕ Fin q))
    (hT : ∀ i ∈ T, (∑ r, star (row q i r) * a r) = 0) : T.card ≤ 3 := by
  obtain ⟨hs, _, hr⟩ := positive hq
  exact P14DoubleConeSpanning.killing_bound q (height (R q)) (-height (S q)) (eta q) (z q)
    (height_ne_zero hr) (neg_ne_zero.mpr (height_ne_zero hs)) (z_injective hq)
    (z_unit q) (unit_unit (delta q)) (z_pow hq) (eta_nonresonant hq) a ha T hT

theorem root_step_sum {q : ℕ} (hq : 7 ≤ q) (s t : ℕ) (hst : 2 * s + t = q) :
    star (fourierRoot q ^ s) + fourierRoot q ^ s = -2 * (Real.cos ((t : ℝ) * x q) : ℂ) := by
  have hq0 : (q : ℝ) ≠ 0 := by exact_mod_cast (show q ≠ 0 by omega)
  have hxq : x q * (q : ℝ) = Real.pi := div_mul_cancel₀ _ hq0
  have hst' : 2 * (s : ℝ) + t = q := by exact_mod_cast hst
  have he : (s : ℝ) * (2 * x q) = Real.pi - (t : ℝ) * x q := by
    linear_combination hxq + x q * hst'
  rw [root_unit, unit_pow, unit_sum, he, Real.cos_pi_sub]
  push_cast
  ring

theorem cross_height {q : ℕ} (hq : 7 ≤ q) :
    star (height (R q)) * (-height (S q)) + star (eta q) + eta q = 0 := by
  obtain ⟨hs, _, hr⟩ := positive hq
  have ha := Real.sq_sqrt (by linarith : 0 ≤ 2 * R q)
  have hb := Real.sq_sqrt (by linarith : 0 ≤ 2 * S q)
  have hc := Real.sq_sqrt (mul_nonneg hr.le hs.le)
  have hp : (Real.sqrt (2 * R q) * Real.sqrt (2 * S q)) ^ 2 = 4 * (R q * S q) := by
    rw [mul_pow, ha, hb]
    ring
  have he : Real.sqrt (2 * R q) * Real.sqrt (2 * S q) = 2 * Real.sqrt (R q * S q) := by
    nlinarith [Real.sqrt_nonneg (R q * S q),
      mul_nonneg (Real.sqrt_nonneg (2 * R q)) (Real.sqrt_nonneg (2 * S q))]
  have hu : star (eta q) + eta q = 2 * (Real.sqrt (R q * S q) : ℂ) := by
    change star (unit (delta q)) + unit (delta q) = _
    rw [unit_sum, cos_delta hq]
  have he' : (Real.sqrt (2 * R q) : ℂ) * (Real.sqrt (2 * S q) : ℂ) =
      2 * (Real.sqrt (R q * S q) : ℂ) := by exact_mod_cast he
  simp only [height, Complex.star_def, Complex.conj_ofReal] at hu ⊢
  linear_combination hu - he'

theorem matching_orthogonal {q : ℕ} (hq : 7 ≤ q) (i : Fin q) :
    (∑ r, star (row q (Sum.inl i) r) * row q (Sum.inr i) r) = 0 := by
  change (∑ r, star (cone (height (R q)) (z q i) r) *
    cone (-height (S q)) (eta q * z q i) r) = 0
  rw [mul_comm (eta q), cone_pair_shift _ _ _ _ (z_unit q i)]
  exact cross_height hq

theorem shifted_z {q : ℕ} (hq : 7 ≤ q) (s : ℕ) (i j : Fin q)
    (hj : j.val = (i.val + s) % q) : z q j = z q i * fourierRoot q ^ s := by
  unfold z
  rw [hj, ← pow_eq_pow_mod (i.val + s) (fourierRoot_isPrimitiveRoot q (by omega)).pow_eq_one,
    pow_add]

theorem upper_shift {q : ℕ} (hq : 7 ≤ q) (ho : Odd q) (i j : Fin q)
    (hj : j.val = (i.val + q / 2) % q) :
    (∑ r, star (row q (Sum.inl i) r) * row q (Sum.inl j) r) = 0 := by
  have hs : 2 * (q / 2) + 1 = q := by obtain ⟨k, hk⟩ := ho; omega
  change (∑ r, star (cone (height (R q)) (z q i) r) * cone (height (R q)) (z q j) r) = 0
  rw [shifted_z hq _ i j hj, cone_pair_shift _ _ _ _ (z_unit q i)]
  have hp := height_square (positive hq).2.2.le
  have ht := root_step_sum hq (q / 2) 1 hs
  simp only [Nat.cast_one, one_mul] at ht
  change star (height (R q)) * height (R q) = 2 * (Real.cos (x q) : ℂ) at hp
  linear_combination hp + ht

theorem lower_shift {q : ℕ} (hq : 7 ≤ q) (ho : Odd q) (i j : Fin q)
    (hj : j.val = (i.val + (q / 2 - 1)) % q) :
    (∑ r, star (row q (Sum.inr i) r) * row q (Sum.inr j) r) = 0 := by
  have hs : 2 * (q / 2 - 1) + 3 = q := by obtain ⟨k, hk⟩ := ho; omega
  have hv : star (eta q * z q i) * (eta q * z q i) = 1 := by
    calc
      _ = (star (eta q) * eta q) * (star (z q i) * z q i) := by rw [star_mul]; ring
      _ = 1 := by rw [show star (eta q) * eta q = 1 from unit_unit (delta q), z_unit]; ring
  have hzj : eta q * z q j = (eta q * z q i) * fourierRoot q ^ (q / 2 - 1) := by
    rw [shifted_z hq _ i j hj]
    ring
  change (∑ r, star (cone (-height (S q)) (eta q * z q i) r) *
    cone (-height (S q)) (eta q * z q j) r) = 0
  rw [hzj, cone_pair_shift _ _ _ _ hv]
  have hp := height_square (positive hq).1.le
  have ht := root_step_sum hq (q / 2 - 1) 3 hs
  norm_num only [Nat.cast_ofNat] at ht
  simp only [star_neg, neg_mul_neg]
  change star (height (S q)) * height (S q) = 2 * (Real.cos (3 * x q) : ℂ) at hp
  linear_combination hp + ht

end P14DoubleConeQutrit

end
end

section

/-! The ordinary qutrit graph complementary to the double-cone factor:
the upper layer uses step q/2-1 and the lower layer uses step q/2.
Every biclique lies in one layer, so its two sides total at most three.
No connectedness or coprimality of either cyclic step is assumed. -/

noncomputable section
namespace P14DoubleConeAbsorb
open P14OddLayerLabels P14OddLayerBlockBiclique P14OddCyclicAnnulus
open P14BicliqueComplementConnection
variable {q : ℕ} [NeZero q]

def H (q i j : ℕ) : Prop :=
  (Side q i ∧ Side q j ∧ label q j - label q i ∈ annulus (q / 2 - 1) 1) ∨
  (¬ Side q i ∧ ¬ Side q j ∧ label q j - label q i ∈ annulus (q / 2) 1)

theorem symmetric {i j : ℕ} (h : H q i j) : H q j i := by
  rcases h with ⟨hi, hj, he⟩ | ⟨hi, hj, he⟩
  · exact Or.inl ⟨hj, hi, by simpa only [neg_sub] using neg_mem _ _ he⟩
  · exact Or.inr ⟨hj, hi, by simpa only [neg_sub] using neg_mem _ _ he⟩

theorem irreflexive (hq : 7 ≤ q) (ho : Odd q) (i : ℕ) : ¬ H q i i := by
  obtain ⟨k, hk⟩ := ho
  rintro (⟨hi, _, he⟩ | ⟨hi, _, he⟩)
  · exact within_irreflexive (Side q) (label q) (q / 2 - 1) 1
      (by omega) (by omega) i ⟨Or.inl ⟨hi, hi⟩, he⟩
  · exact within_irreflexive (Side q) (label q) (q / 2) 1
      (by omega) (by omega) i ⟨Or.inr ⟨hi, hi⟩, he⟩

theorem bound (hq : 7 ≤ q) (ho : Odd q) :
    BicliqueBound (H q) (Finset.range (2 * q)) 3 := by
  classical
  have hodd := ho
  obtain ⟨k, hk⟩ := hodd
  intro A hAS B hBS hA hB hdis hedge
  obtain ⟨i₀, hi₀⟩ := hA
  obtain ⟨j₀, hj₀⟩ := hB
  by_cases hc : Side q i₀
  · have hjc : Side q j₀ := by
      rcases hedge i₀ hi₀ j₀ hj₀ with h | h
      · exact h.2.1
      · exact False.elim (h.1 hc)
    apply within_bound (Side q) (Finset.range (2 * q)) (label q)
      labels_injective ho (q / 2 - 1) 1 (by omega) (by omega)
      A hAS B hBS ⟨i₀, hi₀⟩ ⟨j₀, hj₀⟩ hdis
    intro i hi j hj
    have hic : Side q i := by
      rcases hedge i hi j₀ hj₀ with h | h
      · exact h.1
      · exact False.elim (h.2.1 hjc)
    rcases hedge i hi j hj with h | h
    · exact ⟨Or.inl ⟨h.1, h.2.1⟩, h.2.2⟩
    · exact False.elim (h.1 hic)
  · have hjc : ¬ Side q j₀ := by
      rcases hedge i₀ hi₀ j₀ hj₀ with h | h
      · exact False.elim (hc h.1)
      · exact h.2.1
    apply within_bound (Side q) (Finset.range (2 * q)) (label q)
      labels_injective ho (q / 2) 1 (by omega) (by omega)
      A hAS B hBS ⟨i₀, hi₀⟩ ⟨j₀, hj₀⟩ hdis
    intro i hi j hj
    have hic : ¬ Side q i := by
      rcases hedge i hi j₀ hj₀ with h | h
      · exact False.elim (hjc h.2.1)
      · exact h.1
    rcases hedge i hi j hj with h | h
    · exact False.elim (hic h.1)
    · exact ⟨Or.inr ⟨h.1, h.2.1⟩, h.2.2⟩

theorem step_mem (i δ : Fin q) :
    cast (i + δ) - cast i ∈ annulus δ.val 1 := by
  rw [cast_add, add_sub_cancel_left]
  exact (mem_iff _ _ _).mpr ⟨δ.val, le_rfl, by omega, Or.inl rfl⟩

theorem upper_step (i δ : Fin q) (hδ : δ.val = q / 2 - 1) :
    H q (encode (Sum.inl i)) (encode (Sum.inl (i + δ))) := by
  apply Or.inl
  refine ⟨side_inl i, side_inl (i + δ), ?_⟩
  simpa only [label_inl, ← hδ] using step_mem i δ

theorem lower_step (i δ : Fin q) (hδ : δ.val = q / 2) :
    H q (encode (Sum.inr i)) (encode (Sum.inr (i + δ))) := by
  apply Or.inr
  refine ⟨side_inr i, side_inr (i + δ), ?_⟩
  simpa only [label_inr, ← hδ] using step_mem i δ

end P14DoubleConeAbsorb

end
end

section

/-! The same two-qutrit rows split the prescribed dimension-five graph.
The first factor supplies one cycle per layer and the cross matching;
the ordinary qutrit absorbs the other cycle in each layer. -/

noncomputable section
namespace P14DoubleConeSplit
open P14FivePrescribedPairings P14OddLayerLabels
open scoped BigOperators
variable {q : ℕ} [NeZero q]

theorem half_val (hq : 7 ≤ q) (ho : Odd q) :
    (halfIndex hq).val = q / 2 := by
  change (q - 1) / 2 = q / 2
  obtain ⟨k, hk⟩ := ho
  omega

theorem pred_val (hq : 7 ≤ q) (ho : Odd q) :
    (predHalfIndex hq).val = q / 2 - 1 := by
  change (q - 1) / 2 - 1 = q / 2 - 1
  obtain ⟨k, hk⟩ := ho
  omega

def E (hq : 7 ≤ q) : (Fin q ⊕ Fin q) → (Fin q ⊕ Fin q) → Prop
  | .inl i, .inl j => j = i + halfIndex hq ∨ i = j + halfIndex hq
  | .inr i, .inr j => j = i + predHalfIndex hq ∨ i = j + predHalfIndex hq
  | .inl i, .inr j => i = j
  | .inr i, .inl j => i = j

theorem reverse_zero {x y : Fin 3 → ℂ}
    (h : (∑ r, star (x r) * y r) = 0) : (∑ r, star (y r) * x r) = 0 := by
  simpa [Fin.sum_univ_succ, star_mul, mul_comm] using congrArg star h

theorem orthogonal (hq : 7 ≤ q) (ho : Odd q) (u v : Fin q ⊕ Fin q)
    (he : E hq u v) :
    (∑ r, star (P14DoubleConeQutrit.row q u r) * P14DoubleConeQutrit.row q v r) = 0 := by
  have hU (i : Fin q) := P14DoubleConeQutrit.upper_shift hq ho i
    (i + halfIndex hq) (by simp only [Fin.val_add, half_val hq ho])
  have hV (i : Fin q) := P14DoubleConeQutrit.lower_shift hq ho i
    (i + predHalfIndex hq) (by simp only [Fin.val_add, pred_val hq ho])
  cases u with
  | inl i =>
    cases v with
    | inl j =>
      rcases he with he | he
      · subst j; exact hU i
      · subst i; exact reverse_zero (hU j)
    | inr j =>
      change i = j at he
      subst j
      exact P14DoubleConeQutrit.matching_orthogonal hq i
  | inr i =>
    cases v with
    | inl j =>
      change i = j at he
      subst j
      exact reverse_zero (P14DoubleConeQutrit.matching_orthogonal hq i)
    | inr j =>
      rcases he with he | he
      · subst j; exact hV i
      · subst i; exact reverse_zero (hV j)

theorem prescribed_split (hq : 7 ≤ q) (ho : Odd q) (u v : Fin q ⊕ Fin q)
    (h : Prescribed hq u v) :
    E hq u v ∨ P14DoubleConeAbsorb.H q (encode u) (encode v) := by
  cases u with
  | inl i =>
    cases v with
    | inl j =>
      rcases h with h | h | h | h
      · exact Or.inl (Or.inl h)
      · exact Or.inl (Or.inr h)
      · subst j
        exact Or.inr (P14DoubleConeAbsorb.upper_step i _ (pred_val hq ho))
      · subst i
        exact Or.inr (P14DoubleConeAbsorb.symmetric
          (P14DoubleConeAbsorb.upper_step j _ (pred_val hq ho)))
    | inr j => exact Or.inl h
  | inr i =>
    cases v with
    | inl j => exact Or.inl h
    | inr j =>
      rcases h with h | h | h | h
      · subst j
        exact Or.inr (P14DoubleConeAbsorb.lower_step i _ (half_val hq ho))
      · subst i
        exact Or.inr (P14DoubleConeAbsorb.symmetric
          (P14DoubleConeAbsorb.lower_step j _ (half_val hq ho)))
      · exact Or.inl (Or.inl h)
      · exact Or.inl (Or.inr h)

end P14DoubleConeSplit

end
end

section

/-! Explicit three-edge colors for the two-layer step-one/step-three graph.
Three finite prefixes and a six-position period cover every odd order >=7.
No Hamiltonicity or general factorization theorem is assumed. -/

namespace P14PetersenThreeColors

def good (a b c : ℕ) : Prop :=
  a < 3 ∧ b < 3 ∧ c < 3 ∧ a ≠ b ∧ a ≠ c ∧ b ≠ c

private def prefixO (r i : ℕ) : ℕ :=
  if r = 7 then
    if i = 0 then 1 else if i = 1 then 0 else if i = 2 then 2
    else if i = 3 then 1 else if i = 4 then 0 else if i = 5 then 2 else 0
  else if r = 9 then
    if i = 0 then 1 else if i = 1 then 0 else if i = 2 then 1
    else if i = 3 then 2 else if i = 4 then 1 else if i = 5 then 2
    else if i = 6 then 0 else if i = 7 then 2 else 0
  else
    if i = 0 then 1 else if i = 1 then 0 else if i = 2 then 1
    else if i = 3 then 0 else if i = 4 then 1 else if i = 5 then 2
    else if i = 6 then 0 else if i = 7 then 2 else if i = 8 then 0
    else if i = 9 then 2 else 0

private def prefixB (r i : ℕ) : ℕ :=
  if r = 7 then
    if i < 2 then 1 else if i < 4 then 2 else 0
  else if r = 9 then
    if i < 3 then 1 else if i < 6 then 2 else 0
  else
    if i < 3 then 1 else if i < 5 then 0 else if i < 8 then 2 else 0

private def prefixS (r i : ℕ) : ℕ :=
  if r = 7 then
    if i < 2 then 2 else if i = 2 then 1 else if i = 3 then 0
    else if i = 4 then 2 else 1
  else if r = 9 then
    if i < 3 then 2 else if i < 6 then 0 else 1
  else
    if i < 5 then 2 else if i = 5 then 0 else 1

def outer (r i : ℕ) : ℕ :=
  if i < r then prefixO r i else if (i - r) % 2 = 0 then 1 else 0
def inner (r i : ℕ) : ℕ :=
  if i < r then prefixB r i else if (i - r) % 6 < 3 then 1 else 0
def spoke (r i : ℕ) : ℕ := if i < r then prefixS r i else 2

private theorem outer_period (r i : ℕ) (hi : r ≤ i) :
    outer r (i + 6) = outer r i := by
  have h : (i + 6 - r) % 2 = (i - r) % 2 := by omega
  simp [outer, show ¬ i < r by omega, show ¬ i + 6 < r by omega, h]

private theorem inner_period (r i : ℕ) (hi : r ≤ i) :
    inner r (i + 6) = inner r i := by
  have h : (i + 6 - r) % 6 = (i - r) % 6 := by omega
  simp [inner, show ¬ i < r by omega, show ¬ i + 6 < r by omega, h]

private theorem spoke_period (r i : ℕ) (hi : r ≤ i) :
    spoke r (i + 6) = spoke r i := by
  simp [spoke, show ¬ i < r by omega, show ¬ i + 6 < r by omega]

private def core (r i : ℕ) : Prop :=
  good (outer r (i - 1)) (outer r i) (spoke r i) ∧
  good (inner r (i - 3)) (inner r i) (spoke r i)

private theorem core_period (r i : ℕ) (hi : r + 3 ≤ i) :
    core r (i + 6) ↔ core r i := by
  simp only [core, show i + 6 - 1 = (i - 1) + 6 by omega,
    show i + 6 - 3 = (i - 3) + 6 by omega,
    outer_period r (i - 1) (by omega), outer_period r i (by omega),
    inner_period r (i - 3) (by omega), inner_period r i (by omega),
    spoke_period r i (by omega)]

private theorem core_all (r : ℕ) (hr : r = 7 ∨ r = 9 ∨ r = 11)
    (i : ℕ) (hi : 3 ≤ i) : core r i := by
  induction i using Nat.strong_induction_on with
  | h i ih =>
    by_cases hs : i < r + 9
    · rcases hr with rfl | rfl | rfl
      all_goals interval_cases i <;>
        norm_num [core, good, outer, inner, spoke, prefixO, prefixB, prefixS] at *
    · have hlow : r + 3 ≤ i - 6 := by omega
      have hprev := ih (i - 6) (by omega) (by omega)
      have he : i - 6 + 6 = i := by omega
      exact (he ▸ (core_period r (i - 6) hlow)).mpr hprev

private theorem tail (r k : ℕ) (hr : r = 7 ∨ r = 9 ∨ r = 11) :
    outer r (6 * k + r - 1) = 0 ∧ inner r (6 * k + r - 1) = 0 ∧
    inner r (6 * k + r - 2) = 0 ∧ inner r (6 * k + r - 3) = 0 := by
  by_cases hk : k = 0
  · subst k
    rcases hr with rfl | rfl | rfl <;>
      norm_num [outer, inner, prefixO, prefixB]
  · have h1 : ¬ 6 * k + r - 1 < r := by omega
    have h2 : ¬ 6 * k + r - 2 < r := by omega
    have h3 : ¬ 6 * k + r - 3 < r := by omega
    have ho : (6 * k + r - 1 - r) % 2 ≠ 0 := by omega
    have hb1 : ¬ (6 * k + r - 1 - r) % 6 < 3 := by omega
    have hb2 : ¬ (6 * k + r - 2 - r) % 6 < 3 := by omega
    have hb3 : ¬ (6 * k + r - 3 - r) % 6 < 3 := by omega
    simp [outer, inner, h1, h2, h3, ho, hb1, hb2, hb3]

def prevOne (q i : ℕ) : ℕ := if i = 0 then q - 1 else i - 1
def prevThree (q i : ℕ) : ℕ := if i < 3 then q + i - 3 else i - 3

theorem cyclic (r k : ℕ) (hr : r = 7 ∨ r = 9 ∨ r = 11) (i : ℕ)
    (hi : i < 6 * k + r) :
    good (outer r (prevOne (6 * k + r) i)) (outer r i) (spoke r i) ∧
    good (inner r (prevThree (6 * k + r) i)) (inner r i) (spoke r i) := by
  by_cases h3 : 3 ≤ i
  · simpa only [core, prevOne, if_neg (show i ≠ 0 by omega), prevThree,
      if_neg (show ¬ i < 3 by omega)] using core_all r hr i h3
  · obtain ⟨ho, hb1, hb2, hb3⟩ := tail r k hr
    interval_cases i
    · simp only [prevOne, prevThree, if_pos, Nat.add_zero, show (0 : ℕ) < 3 by decide] 
      rw [ho, hb3]
      rcases hr with rfl | rfl | rfl <;>
        norm_num [good, outer, inner, spoke, prefixO, prefixB, prefixS]
    · have he : 6 * k + r + 1 - 3 = 6 * k + r - 2 := by omega
      simp only [prevOne, prevThree, show (1 : ℕ) ≠ 0 by decide,
        if_false, show (1 : ℕ) < 3 by decide, if_true, he]
      rw [hb2]
      rcases hr with rfl | rfl | rfl <;>
        norm_num [good, outer, inner, spoke, prefixO, prefixB, prefixS]
    · have he : 6 * k + r + 2 - 3 = 6 * k + r - 1 := by omega
      simp only [prevOne, prevThree, show (2 : ℕ) ≠ 0 by decide,
        if_false, show (2 : ℕ) < 3 by decide, if_true, he]
      rw [hb1]
      rcases hr with rfl | rfl | rfl <;>
        norm_num [good, outer, inner, spoke, prefixO, prefixB, prefixS]

theorem exists_colors {q : ℕ} (hq : 7 ≤ q) (ho : Odd q) :
    ∃ O B S : ℕ → ℕ, ∀ i < q,
      good (O (prevOne q i)) (O i) (S i) ∧
      good (B (prevThree q i)) (B i) (S i) := by
  have hodd : q % 2 = 1 := Nat.odd_iff.mp ho
  have hr : q % 6 = 1 ∨ q % 6 = 3 ∨ q % 6 = 5 := by omega
  rcases hr with hr | hr | hr
  · have he : 6 * ((q - 7) / 6) + 7 = q := by omega
    refine ⟨outer 7, inner 7, spoke 7, ?_⟩
    intro i hi
    simpa only [he] using cyclic 7 ((q - 7) / 6) (Or.inl rfl) i (by omega)
  · have he : 6 * ((q - 9) / 6) + 9 = q := by omega
    refine ⟨outer 9, inner 9, spoke 9, ?_⟩
    intro i hi
    simpa only [he] using cyclic 9 ((q - 9) / 6) (Or.inr (Or.inl rfl)) i (by omega)
  · have he : 6 * ((q - 11) / 6) + 11 = q := by omega
    refine ⟨outer 11, inner 11, spoke 11, ?_⟩
    intro i hi
    simpa only [he] using cyclic 11 ((q - 11) / 6) (Or.inr (Or.inr rfl)) i (by omega)

end P14PetersenThreeColors

end

section

/-! Actual perfect matchings of the step-one/step-three Petersen graph.
The arithmetic colors give a unique neighbor of each color at every vertex. -/

noncomputable section
namespace P14PetersenThreeMatchings
open P14PetersenThreeColors
open Fin.NatCast
variable {q : ℕ} [NeZero q]

private theorem sub_val (i : Fin q) (a : ℕ) (ha : a < q) :
    (i - (a : Fin q)).val =
      if i.val < a then q + i.val - a else i.val - a := by
  rw [Fin.val_sub, Fin.val_natCast, Nat.mod_eq_of_lt ha]
  by_cases h : i.val < a
  · rw [Nat.mod_eq_of_lt (by have hi := i.isLt; omega), if_pos h]
    omega
  · have he : q - a + i.val = q + (i.val - a) := by omega
    rw [he, Nat.add_mod, Nat.mod_self, zero_add, Nat.mod_mod, if_neg h]
    exact Nat.mod_eq_of_lt (lt_of_le_of_lt (Nat.sub_le _ _) i.isLt)

private theorem sub_one_val (hq : 7 ≤ q) (i : Fin q) :
    (i - 1).val = prevOne q i.val := by
  have h := sub_val i 1 (by omega)
  simp only [Nat.cast_one] at h
  rw [h]
  by_cases hi : i.val = 0
  · simp [prevOne, hi]
  · simp [prevOne, hi, show ¬ i.val < 1 by omega]

private theorem sub_three_val (hq : 7 ≤ q) (i : Fin q) :
    (i - 3).val = prevThree q i.val := by
  simpa only [Nat.cast_ofNat, prevThree] using sub_val i 3 (by omega)

def Adj : (Fin q ⊕ Fin q) → (Fin q ⊕ Fin q) → Prop
  | .inl i, .inl j => j = i + 1 ∨ i = j + 1
  | .inr i, .inr j => j = i + 3 ∨ i = j + 3
  | .inl i, .inr j => i = j
  | .inr i, .inl j => i = j

private def Local (a : Fin q) (O S : Fin q → ℕ) (c : Fin 3)
    (i : Fin q) : (Fin q ⊕ Fin q) → Prop
  | .inl j => (j = i + a ∧ O i = c.val) ∨ (i = j + a ∧ O j = c.val)
  | .inr j => i = j ∧ S i = c.val

private theorem local_unique (a : Fin q) (O S : Fin q → ℕ)
    (i : Fin q) (hg : good (O (i - a)) (O i) (S i)) (c : Fin 3) :
    ∃! y, Local a O S c i y := by
  rcases hg with ⟨ha, hb, hc, hab, hac, hbc⟩
  have hcv := c.isLt
  by_cases hforward : O i = c.val
  · refine ⟨Sum.inl (i + a), Or.inl ⟨rfl, hforward⟩, ?_⟩
    rintro (j | j) hj
    · rcases hj with ⟨he, _⟩ | ⟨he, hcolor⟩
      · exact congrArg Sum.inl he
      · have hj : j = i - a := (eq_sub_iff_add_eq).mpr he.symm
        rw [hj] at hcolor
        omega
    · change i = j ∧ S i = c.val at hj
      omega
  · by_cases hback : O (i - a) = c.val
    · refine ⟨Sum.inl (i - a), Or.inr ⟨(sub_add_cancel i a).symm, hback⟩, ?_⟩
      rintro (j | j) hj
      · rcases hj with ⟨_, hcolor⟩ | ⟨he, _⟩
        · omega
        · exact congrArg Sum.inl ((eq_sub_iff_add_eq).mpr he.symm)
      · change i = j ∧ S i = c.val at hj
        omega
    · have hspoke : S i = c.val := by omega
      refine ⟨Sum.inr i, ⟨rfl, hspoke⟩, ?_⟩
      rintro (j | j) hj
      · rcases hj with ⟨_, hcolor⟩ | ⟨he, hcolor⟩
        · omega
        · have hj : j = i - a := (eq_sub_iff_add_eq).mpr he.symm
          rw [hj] at hcolor
          omega
      · exact congrArg Sum.inr hj.1.symm

private def Colored (O B S : Fin q → ℕ) (c : Fin 3) :
    (Fin q ⊕ Fin q) → (Fin q ⊕ Fin q) → Prop
  | .inl i, .inl j => (j = i + 1 ∧ O i = c.val) ∨ (i = j + 1 ∧ O j = c.val)
  | .inr i, .inr j => (j = i + 3 ∧ B i = c.val) ∨ (i = j + 3 ∧ B j = c.val)
  | .inl i, .inr j => i = j ∧ S i = c.val
  | .inr i, .inl j => i = j ∧ S i = c.val

private theorem colored_symm (O B S : Fin q → ℕ) (c : Fin 3)
    (x y : Fin q ⊕ Fin q) (h : Colored O B S c x y) : Colored O B S c y x := by
  cases x <;> cases y
  · exact h.symm
  · obtain ⟨rfl, hc⟩ := h
    exact ⟨rfl, hc⟩
  · obtain ⟨rfl, hc⟩ := h
    exact ⟨rfl, hc⟩
  · exact h.symm

private theorem colored_unique (O B S : Fin q → ℕ)
    (hg : ∀ i, good (O (i - 1)) (O i) (S i) ∧ good (B (i - 3)) (B i) (S i))
    (c : Fin 3) (x : Fin q ⊕ Fin q) : ∃! y, Colored O B S c x y := by
  cases x with
  | inl i =>
    obtain ⟨y, hy, hu⟩ := local_unique 1 O S i (hg i).1 c
    refine ⟨y, ?_, ?_⟩
    · cases y <;> exact hy
    · intro z hz
      apply hu
      cases z <;> exact hz
  | inr i =>
    obtain ⟨y, hy, hu⟩ := local_unique 3 B S i (hg i).2 c
    refine ⟨Sum.swap y, ?_, ?_⟩
    · cases y <;> exact hy
    · intro z hz
      have hlocal : Local 3 B S c i (Sum.swap z) := by cases z <;> exact hz
      have he := congrArg Sum.swap (hu (Sum.swap z) hlocal)
      simpa only [Sum.swap_swap] using he

private theorem colored_adj (O B S : Fin q → ℕ) (c : Fin 3)
    (x y : Fin q ⊕ Fin q) (h : Colored O B S c x y) : Adj x y := by
  cases x <;> cases y
  · exact h.imp And.left And.left
  · exact h.1
  · exact h.1
  · exact h.imp And.left And.left

private theorem adj_irrefl (hq : 7 ≤ q) (x : Fin q ⊕ Fin q) : ¬ Adj x x := by
  have h1 : (1 : Fin q) ≠ 0 := by
    intro h
    have hv := congrArg Fin.val h
    simp only [Fin.val_one', Fin.val_zero, Nat.mod_eq_of_lt (show 1 < q by omega)] at hv
    omega
  have h3 : (3 : Fin q) ≠ 0 := by
    intro h
    have hv := congrArg Fin.val h
    change 3 % q = 0 at hv
    rw [Nat.mod_eq_of_lt (by omega)] at hv
    omega
  have hne (a : Fin q) (ha : a ≠ 0) (i : Fin q) : i ≠ i + a := by
    intro h
    exact ha (add_left_cancel (h.symm.trans (add_zero i).symm))
  cases x with
  | inl i => rintro (h | h) <;> exact hne 1 h1 i h
  | inr i => rintro (h | h) <;> exact hne 3 h3 i h

theorem exists_matchings (hq : 7 ≤ q) (ho : Odd q) :
    ∃ F : Fin 3 → (Fin q ⊕ Fin q) → (Fin q ⊕ Fin q),
      (∀ c, Function.Involutive (F c)) ∧ (∀ c x, F c x ≠ x) ∧
      (∀ x y, Adj x y ↔ ∃ c, F c x = y) := by
  classical
  obtain ⟨o, b, s, hcolors⟩ := P14PetersenThreeColors.exists_colors hq ho
  let O : Fin q → ℕ := fun i => o i.val
  let B : Fin q → ℕ := fun i => b i.val
  let S : Fin q → ℕ := fun i => s i.val
  have hg (i : Fin q) :
      good (O (i - 1)) (O i) (S i) ∧ good (B (i - 3)) (B i) (S i) := by
    simpa only [O, B, S, sub_one_val hq, sub_three_val hq] using hcolors i.val i.isLt
  have hu (c : Fin 3) (x : Fin q ⊕ Fin q) := colored_unique O B S hg c x
  let F (c : Fin 3) (x : Fin q ⊕ Fin q) := Classical.choose (hu c x)
  have hF (c : Fin 3) (x : Fin q ⊕ Fin q) : Colored O B S c x (F c x) :=
    (Classical.choose_spec (hu c x)).1
  have huniq (c : Fin 3) (x y : Fin q ⊕ Fin q) (hy : Colored O B S c x y) :
      y = F c x := (Classical.choose_spec (hu c x)).2 y hy
  refine ⟨F, ?_, ?_, ?_⟩
  · intro c x
    exact (huniq c (F c x) x (colored_symm O B S c x (F c x) (hF c x))).symm
  · intro c x he
    have hh := colored_adj O B S c x (F c x) (hF c x)
    rw [he] at hh
    exact adj_irrefl hq x hh
  · intro x y
    constructor
    · intro h
      have hc : ∃ c : Fin 3, Colored O B S c x y := by
        cases x with
        | inl i =>
          cases y with
          | inl j =>
            rcases h with h | h
            · exact ⟨⟨O i, (hg i).1.2.1⟩, Or.inl ⟨h, rfl⟩⟩
            · exact ⟨⟨O j, (hg j).1.2.1⟩, Or.inr ⟨h, rfl⟩⟩
          | inr j => exact ⟨⟨S i, (hg i).1.2.2.1⟩, h, rfl⟩
        | inr i =>
          cases y with
          | inl j => exact ⟨⟨S i, (hg i).1.2.2.1⟩, h, rfl⟩
          | inr j =>
            rcases h with h | h
            · exact ⟨⟨B i, (hg i).2.2.1⟩, Or.inl ⟨h, rfl⟩⟩
            · exact ⟨⟨B j, (hg j).2.2.1⟩, Or.inr ⟨h, rfl⟩⟩
      obtain ⟨c, hc⟩ := hc
      exact ⟨c, (huniq c x y hc).symm⟩
    · rintro ⟨c, rfl⟩
      exact colored_adj O B S c x (F c x) (hF c x)

end P14PetersenThreeMatchings

end
end

section

/-! Transport the actual Petersen matchings to the mismatched half-order
cycle steps, with any chosen cross offset. -/

noncomputable section
namespace P14MismatchedStepMatchings
open Fin.CommRing
variable {q : ℕ} [NeZero q]

def A (hq : 7 ≤ q) : Fin q := ⟨q / 2, by omega⟩
def B (hq : 7 ≤ q) : Fin q := ⟨q / 2 - 1, by omega⟩

private theorem double_add_one (hq : 7 ≤ q) (ho : Odd q) :
    A hq + A hq + 1 = 0 := by
  have hqodd : q / 2 + q / 2 + 1 = q := by obtain ⟨k, hk⟩ := ho; omega
  apply Fin.ext
  change ((q / 2 + q / 2) % q + 1 % q) % q = 0
  have h1 : 1 % q = 1 := Nat.mod_eq_of_lt (by omega)
  have h2 : (q / 2 + q / 2) % q = q / 2 + q / 2 := Nat.mod_eq_of_lt (by omega)
  rw [h1, h2, hqodd, Nat.mod_self]

private theorem B_add_one (hq : 7 ≤ q) : B hq + 1 = A hq := by
  apply Fin.ext
  change ((q / 2 - 1) + 1 % q) % q = q / 2
  have h1 : 1 % q = 1 := Nat.mod_eq_of_lt (by omega)
  rw [h1]
  have he : q / 2 - 1 + 1 = q / 2 := by omega
  rw [he, Nat.mod_eq_of_lt (by omega)]

theorem inverse_A (hq : 7 ≤ q) (ho : Odd q) : (-2 : Fin q) * A hq = 1 := by
  have h := double_add_one hq ho
  linear_combination -h

theorem triple_A (hq : 7 ≤ q) (ho : Odd q) : A hq * 3 = B hq := by
  have ha := double_add_one hq ho
  have hb := B_add_one hq
  linear_combination ha - hb

def scale (hq : 7 ≤ q) (ho : Odd q) : Fin q ≃ Fin q where
  toFun x := A hq * x
  invFun x := -2 * x
  left_inv x := by
    change -2 * (A hq * x) = x
    rw [← mul_assoc, inverse_A hq ho, one_mul]
  right_inv x := by
    change A hq * (-2 * x) = x
    rw [← mul_assoc, mul_comm (A hq) (-2), inverse_A hq ho, one_mul]

theorem scale_one (hq : 7 ≤ q) (ho : Odd q) (i : Fin q) :
    scale hq ho (i + 1) = scale hq ho i + A hq := by
  change A hq * (i + 1) = A hq * i + A hq
  ring

theorem scale_three (hq : 7 ≤ q) (ho : Odd q) (i : Fin q) :
    scale hq ho (i + 3) = scale hq ho i + B hq := by
  change A hq * (i + 3) = A hq * i + B hq
  rw [mul_add, triple_A hq ho]

def Adj (hq : 7 ≤ q) (b : Fin q) :
    (Fin q ⊕ Fin q) → (Fin q ⊕ Fin q) → Prop
  | .inl i, .inl j => j = i + B hq ∨ i = j + B hq
  | .inr i, .inr j => j = i + A hq ∨ i = j + A hq
  | .inl i, .inr j => j = i + b
  | .inr i, .inl j => i = j + b

def labels (hq : 7 ≤ q) (ho : Odd q) (b : Fin q) :
    (Fin q ⊕ Fin q) ≃ (Fin q ⊕ Fin q) where
  toFun := Sum.elim (fun i => Sum.inr (scale hq ho i + b))
    (fun i => Sum.inl (scale hq ho i))
  invFun := Sum.elim (fun i => Sum.inr ((scale hq ho).symm i))
    (fun i => Sum.inl ((scale hq ho).symm (i - b)))
  left_inv := by rintro (i | i) <;> simp
  right_inv := by rintro (i | i) <;> simp

private theorem shifted_iff (e : Fin q ≃ Fin q) (s a c : Fin q)
    (he : ∀ i, e (i + s) = e i + a) (i j : Fin q) :
    e j + c = (e i + c) + a ↔ j = i + s := by
  have h : (e i + c) + a = e (i + s) + c := by rw [he]; abel
  rw [h, add_right_cancel_iff, Equiv.apply_eq_iff_eq]

theorem adj_transport (hq : 7 ≤ q) (ho : Odd q) (b : Fin q)
    (x y : Fin q ⊕ Fin q) :
    Adj hq b (labels hq ho b x) (labels hq ho b y) ↔
      P14PetersenThreeMatchings.Adj x y := by
  cases x with
  | inl i =>
    cases y with
    | inl j =>
      change (scale hq ho j + b = (scale hq ho i + b) + A hq ∨
        scale hq ho i + b = (scale hq ho j + b) + A hq) ↔
        (j = i + 1 ∨ i = j + 1)
      rw [shifted_iff (scale hq ho) 1 (A hq) b (scale_one hq ho),
        shifted_iff (scale hq ho) 1 (A hq) b (scale_one hq ho)]
    | inr j =>
      change scale hq ho i + b = scale hq ho j + b ↔ i = j
      rw [add_right_cancel_iff, Equiv.apply_eq_iff_eq]
  | inr i =>
    cases y with
    | inl j =>
      change scale hq ho j + b = scale hq ho i + b ↔ i = j
      simp only [add_right_cancel_iff, Equiv.apply_eq_iff_eq, eq_comm]
    | inr j =>
      change (scale hq ho j = scale hq ho i + B hq ∨
        scale hq ho i = scale hq ho j + B hq) ↔
        (j = i + 3 ∨ i = j + 3)
      have h1 := shifted_iff (scale hq ho) 3 (B hq) 0 (scale_three hq ho) i j
      have h2 := shifted_iff (scale hq ho) 3 (B hq) 0 (scale_three hq ho) j i
      simp only [add_zero] at h1 h2
      rw [h1, h2]

theorem exists_matchings (hq : 7 ≤ q) (ho : Odd q) (b : Fin q) :
    ∃ F : Fin 3 → (Fin q ⊕ Fin q) → (Fin q ⊕ Fin q),
      (∀ c, Function.Involutive (F c)) ∧ (∀ c x, F c x ≠ x) ∧
      (∀ x y, Adj hq b x y ↔ ∃ c, F c x = y) := by
  obtain ⟨G, hG, hne, hcover⟩ := P14PetersenThreeMatchings.exists_matchings hq ho
  let E := labels hq ho b
  let F (c : Fin 3) (x : Fin q ⊕ Fin q) := E (G c (E.symm x))
  refine ⟨F, ?_, ?_, ?_⟩
  · intro c x
    change E (G c (E.symm (E (G c (E.symm x))))) = x
    rw [Equiv.symm_apply_apply, hG c, Equiv.apply_symm_apply]
  · intro c x h
    exact hne c (E.symm x) (E.injective (h.trans (E.apply_symm_apply x).symm))
  · intro x y
    have he : Adj hq b x y ↔ P14PetersenThreeMatchings.Adj (E.symm x) (E.symm y) := by
      simpa only [E, Equiv.apply_symm_apply] using
        adj_transport hq ho b (E.symm x) (E.symm y)
    rw [he, hcover]
    constructor
    · rintro ⟨c, hc⟩
      exact ⟨c, by change E (G c (E.symm x)) = y; rw [hc, Equiv.apply_symm_apply]⟩
    · rintro ⟨c, hc⟩
      exact ⟨c, E.injective (hc.trans (E.apply_symm_apply y).symm)⟩

end P14MismatchedStepMatchings

end
end

section

/-! A constructive complement cover for the dimension-four exceptional
graph: upper half-step, lower preceding-half-step, and cross shifts zero
and one. Exactly 2q-5 actual fixed-point-free involutions suffice.
This module does not assume or prove a four-dimensional representation
or its five-row spanning property. -/

noncomputable section
namespace P14QuquartGraphCover
open P14FiveComplementCover P14FivePrescribedPairings P14CyclicStepPrisms
variable {q : ℕ} [NeZero q]

def E (hq : 7 ≤ q) :
    (Fin q ⊕ Fin q) → (Fin q ⊕ Fin q) → Prop
  | .inl x, .inl y => y = x + halfIndex hq ∨ x = y + halfIndex hq
  | .inr x, .inr y => y = x + predHalfIndex hq ∨ x = y + predHalfIndex hq
  | .inl x, .inr y => x = y ∨ y = x + 1
  | .inr x, .inl y => x = y ∨ x = y + 1

def smallOffset (hq : 7 ≤ q) (i : Fin (smallCount q)) : Fin q :=
  ⟨i.val + 2, by have hi := i.isLt; dsimp [smallCount] at *; omega⟩

def mismatchOffset (hq : 7 ≤ q) : Fin q :=
  ⟨smallCount q + 2, by dsimp [smallCount]; omega⟩
def finalOffset (hq : 7 ≤ q) (i : Fin (q - 3 - smallCount q)) : Fin q :=
  ⟨smallCount q + 3 + i.val, by have hi := i.isLt; dsimp [smallCount] at *; omega⟩

theorem construct (hq : 7 ≤ q) (ho : Odd q) :
    ∃ F : Fin (2 * q - 5) → (Fin q ⊕ Fin q) → (Fin q ⊕ Fin q),
      (∀ c, Function.Involutive (F c)) ∧ (∀ c x, F c x ≠ x) ∧
      (∀ x y, x ≠ y → E hq x y ∨ ∃ c, F c x = y) := by
  classical
  have hs (i : Fin (smallCount q)) :
      ∃ F : Fin 3 → (Fin q ⊕ Fin q) → (Fin q ⊕ Fin q),
        (∀ c, Function.Involutive (F c)) ∧ (∀ c x, F c x ≠ x) ∧
        (∀ x y, P14ShiftedStepPrisms.Adj (smallStep hq i) (smallOffset hq i) x y ↔ ∃ c, F c x = y) := by
    apply P14ShiftedStepPrisms.exists_matchings (by omega) ho (smallStep hq i) (smallOffset hq i)
    intro h
    have hv := congrArg Fin.val h
    change i.val + 1 = 0 at hv
    omega
  choose G hG hGne hGC using hs
  obtain ⟨M, hM, hMne, hMC⟩ :=
    P14MismatchedStepMatchings.exists_matchings hq ho (mismatchOffset hq)
  have hA : P14MismatchedStepMatchings.A hq = halfIndex hq :=
    Fin.ext (P14DoubleConeSplit.half_val hq ho).symm
  have hB : P14MismatchedStepMatchings.B hq = predHalfIndex hq :=
    Fin.ext (P14DoubleConeSplit.pred_val hq ho).symm
  let C := (Fin (smallCount q) × Fin 3) ⊕ (Fin 3 ⊕ Fin (q - 3 - smallCount q))
  let all : C → (Fin q ⊕ Fin q) → (Fin q ⊕ Fin q) :=
    Sum.elim (fun p => G p.1 p.2)
      (Sum.elim M (fun c => crossMatching (finalOffset hq c)))
  have hall (c : C) : Function.Involutive (all c) := by
    rcases c with ⟨i,c⟩ | (c | c)
    · exact hG i c
    · exact hM c
    · exact crossMatching_involutive _
  have hallne (c : C) (x : Fin q ⊕ Fin q) : all c x ≠ x := by
    rcases c with ⟨i,c⟩ | (c | c)
    · exact hGne i c x
    · exact hMne c x
    · exact crossMatching_ne _ x
  have hmis (x y : Fin q ⊕ Fin q)
      (h : P14MismatchedStepMatchings.Adj hq (mismatchOffset hq) x y) :
      ∃ c : C, all c x = y := by
    obtain ⟨c,hc⟩ := (hMC x y).mp h
    exact ⟨Sum.inr (Sum.inl c), hc⟩
  have hcross (x y : Fin q) (hdiag : x ≠ y) (hnext : y ≠ x + 1) :
      ∃ c : C, all c (Sum.inl x) = Sum.inr y := by
    have hd : y - x ≠ 0 := sub_ne_zero.mpr hdiag.symm
    have hp : 0 < (y - x).val := Nat.pos_of_ne_zero (Fin.val_ne_zero_iff.mpr hd)
    have ht := (y - x).isLt
    have htwo : 2 ≤ (y - x).val := by
      by_contra h
      have hv : (y - x).val = 1 := by omega
      have he : y - x = (1 : Fin q) := by
        apply Fin.ext
        rw [Fin.val_one', Nat.mod_eq_of_lt (by omega)]
        exact hv
      exact hnext (by rw [← he, add_sub_cancel])
    by_cases hsmall : (y - x).val ≤ smallCount q + 1
    · let i : Fin (smallCount q) := ⟨(y - x).val - 2, by omega⟩
      have hi : smallOffset hq i = y - x := by
        apply Fin.ext
        change (y - x).val - 2 + 2 = (y - x).val
        omega
      have hadj : P14ShiftedStepPrisms.Adj (smallStep hq i) (smallOffset hq i)
          (Sum.inl x) (Sum.inr y) := by
        change y = x + smallOffset hq i
        rw [hi, add_sub_cancel]
      obtain ⟨c,hc⟩ := (hGC i _ _).mp hadj
      exact ⟨Sum.inl (i,c), hc⟩
    · by_cases hm : (y - x).val = smallCount q + 2
      · apply hmis
        change y = x + mismatchOffset hq
        have he : mismatchOffset hq = y - x := Fin.ext hm.symm
        rw [he, add_sub_cancel]
      · let i : Fin (q - 3 - smallCount q) :=
          ⟨(y - x).val - smallCount q - 3, by omega⟩
        have hi : finalOffset hq i = y - x := by
          apply Fin.ext
          change smallCount q + 3 + ((y - x).val - smallCount q - 3) = (y - x).val
          omega
        refine ⟨Sum.inr (Sum.inr i), ?_⟩
        change Sum.inr (x + finalOffset hq i) = Sum.inr y
        rw [hi, add_sub_cancel]
  have hcover (x y : Fin q ⊕ Fin q) (hxy : x ≠ y) :
      E hq x y ∨ ∃ c : C, all c x = y := by
    cases x with
    | inl x =>
      cases y with
      | inl y =>
        rcases internal_cover hq ho x y (fun h => hxy (congrArg Sum.inl h)) with h | ⟨i,hi⟩
        · rcases h with h | h | h | h
          · exact Or.inl (Or.inl h)
          · exact Or.inl (Or.inr h)
          · right
            apply hmis
            change y = x + P14MismatchedStepMatchings.B hq ∨
              x = y + P14MismatchedStepMatchings.B hq
            rw [hB]
            exact Or.inl h
          · right
            apply hmis
            change y = x + P14MismatchedStepMatchings.B hq ∨
              x = y + P14MismatchedStepMatchings.B hq
            rw [hB]
            exact Or.inr h
        · obtain ⟨c,hc⟩ := (hGC i (Sum.inl x) (Sum.inl y)).mp hi
          exact Or.inr ⟨Sum.inl (i,c), hc⟩
      | inr y =>
        by_cases hdiag : x = y
        · exact Or.inl (Or.inl hdiag)
        · by_cases hnext : y = x + 1
          · exact Or.inl (Or.inr hnext)
          · exact Or.inr (hcross x y hdiag hnext)
    | inr x =>
      cases y with
      | inl y =>
        by_cases hdiag : x = y
        · exact Or.inl (Or.inl hdiag)
        · by_cases hnext : x = y + 1
          · exact Or.inl (Or.inr hnext)
          · obtain ⟨c,hc⟩ := hcross y x (fun h => hdiag h.symm) hnext
            right
            refine ⟨c, ?_⟩
            rw [← hc]
            exact hall c (Sum.inl y)
      | inr y =>
        rcases internal_cover hq ho x y (fun h => hxy (congrArg Sum.inr h)) with h | ⟨i,hi⟩
        · rcases h with h | h | h | h
          · right
            apply hmis
            change y = x + P14MismatchedStepMatchings.A hq ∨
              x = y + P14MismatchedStepMatchings.A hq
            rw [hA]
            exact Or.inl h
          · right
            apply hmis
            change y = x + P14MismatchedStepMatchings.A hq ∨
              x = y + P14MismatchedStepMatchings.A hq
            rw [hA]
            exact Or.inr h
          · exact Or.inl (Or.inl h)
          · exact Or.inl (Or.inr h)
        · obtain ⟨c,hc⟩ := (hGC i (Sum.inr x) (Sum.inr y)).mp hi
          exact Or.inr ⟨Sum.inl (i,c), hc⟩
  have hcard : Fintype.card C = 2 * q - 5 := by
    simp only [C, Fintype.card_sum, Fintype.card_prod, Fintype.card_fin]
    have hr := smallCount_spec hq ho
    omega
  let e : Fin (2 * q - 5) ≃ C := (Fintype.equivFinOfCardEq hcard).symm
  refine ⟨fun c => all (e c), fun c => hall (e c), fun c => hallne (e c), ?_⟩
  intro x y hxy
  rcases hcover x y hxy with he | ⟨c,hc⟩
  · exact Or.inl he
  · exact Or.inr ⟨e.symm c, by simpa only [Equiv.apply_symm_apply] using hc⟩

end P14QuquartGraphCover

end
end

section

/-! A large partner absorbs every remaining within-layer edge and a
consecutive cross interval. The remaining cross offsets are actual qubit
matchings. No coprimality of the exceptional cyclic steps is assumed. -/
noncomputable section
namespace P14QutritDenseCover
open P14OddLayerLabels P14FiveComplementCover P14FivePrescribedPairings
open P14BicliqueComplementConnection
variable {q : ℕ} [NeZero q]

def H (hq : 7 ≤ q) (t : ℕ) : ℕ → ℕ → Prop :=
  P14DenseLayerComplement.H (Side q) (label q)
    (P14OddLayerLabels.cast (halfIndex hq))
    (P14OddLayerLabels.cast (predHalfIndex hq)) 1 t

theorem symmetric (hq : 7 ≤ q) (t : ℕ) {i j : ℕ}
    (h : H hq t i j) : H hq t j i :=
  P14DenseLayerComplement.symmetric _ _ _ _ _ _ h

theorem irreflexive (hq : 7 ≤ q) (t i : ℕ) : ¬ H hq t i i :=
  P14DenseLayerComplement.irreflexive _ _ _ _ _ _ i

theorem bound (hq : 7 ≤ q) (ho : Odd q) (t D : ℕ)
    (ht : t ≤ q - 2) (hD : q - 3 + t + 1 ≤ D) (hqD : q ≤ D) :
    BicliqueBound (H hq t) (Finset.range (2 * q)) D := by
  have cast_val (i : Fin q) : (P14OddLayerLabels.cast i).val = i.val :=
    ZMod.val_natCast_of_lt i.isLt
  have hA : (P14OddLayerLabels.cast (halfIndex hq)).val = q / 2 := by
    rw [cast_val, P14DoubleConeSplit.half_val hq ho]
  have hB : (P14OddLayerLabels.cast (predHalfIndex hq)).val = q / 2 - 1 := by
    rw [cast_val, P14DoubleConeSplit.pred_val hq ho]
  have ha : P14OddLayerLabels.cast (halfIndex hq) ≠ 0 := by
    intro hz
    have hv := congrArg ZMod.val hz
    rw [hA, ZMod.val_zero] at hv
    omega
  have hb : P14OddLayerLabels.cast (predHalfIndex hq) ≠ 0 := by
    intro hz
    have hv := congrArg ZMod.val hz
    rw [hB, ZMod.val_zero] at hv
    omega
  by_cases hlt : t < q - 3
  · exact P14DenseLayerComplement.bound _ _ _ labels_injective _ _ _ ho ha hb t D hlt hD hqD
  · have he : t = q - 3 ∨ t = q - 2 := by omega
    rcases he with rfl | rfl
    · have hbase : BicliqueBound (H hq (q - 3)) (Finset.range (2 * q)) (2 * q - 5) := by
        apply P14DenseBalancedComplement.bound hq ho (Side q) (Finset.range (2 * q))
          (label q) labels_injective _ _ _ ha hb
        rw [hA,hB]
        omega
      intro A hAS B hBS hAn hBn hdis hedge
      exact (hbase A hAS B hBS hAn hBn hdis hedge).trans (by omega)
    · have hbase : BicliqueBound (H hq (q - 2)) (Finset.range (2 * q)) (2 * q - 4) :=
        P14DenseOneQubitComplement.bound hq ho (Side q) (Finset.range (2 * q))
          (label q) labels_injective _ _ _ ha hb
      intro A hAS B hBS hAn hBn hdis hedge
      exact (hbase A hAS B hBS hAn hBn hdis hedge).trans (by omega)

theorem avoid (a x y : Fin q) (hxy : x ≠ y)
    (hstep : ¬ (y = x + a ∨ x = y + a)) :
    P14OddLayerLabels.cast y - P14OddLayerLabels.cast x ∉
      ({0, P14OddLayerLabels.cast a, -P14OddLayerLabels.cast a} : Finset (ZMod q)) := by
  have step (i j : Fin q)
      (he : P14OddLayerLabels.cast j - P14OddLayerLabels.cast i = P14OddLayerLabels.cast a) :
      j = i + a := by
    apply cast_injective
    rw [cast_add]
    exact (sub_eq_iff_eq_add.mp he).trans (add_comm _ _)
  simp only [Finset.mem_insert, Finset.mem_singleton]
  rintro (he | he | he)
  · exact hxy (cast_injective (sub_eq_zero.mp he).symm)
  · exact hstep (Or.inl (step x y he))
  · apply hstep
    right
    apply step y x
    simpa only [neg_sub, neg_neg] using congrArg Neg.neg he

def offset {t m : ℕ} (hcount : t + m + 1 = q) (j : Fin m) : Fin q :=
  ⟨1 + t + j.val, by have hj := j.isLt; omega⟩

theorem cover (hq : 7 ≤ q) {t m : ℕ} (hcount : t + m + 1 = q) :
    ∃ F : Fin m → (Fin q ⊕ Fin q) → (Fin q ⊕ Fin q),
      (∀ c, Function.Involutive (F c)) ∧ (∀ c x, F c x ≠ x) ∧
      (∀ x y, x ≠ y → P14DoubleConeSplit.E hq x y ∨
        H hq t (encode x) (encode y) ∨ ∃ c, F c x = y) := by
  classical
  let F : Fin m → (Fin q ⊕ Fin q) → (Fin q ⊕ Fin q) :=
    fun j => P14PrismRemainderCover.crossMatching (offset hcount j)
  have hF (j : Fin m) : Function.Involutive (F j) :=
    P14PrismRemainderCover.cross_involutive _
  have hcross (x y : Fin q) (hdiag : x ≠ y) :
      H hq t (encode (Sum.inl x)) (encode (Sum.inr y)) ∨
        ∃ c, F c (Sum.inl x) = Sum.inr y := by
    have hd : y - x ≠ 0 := sub_ne_zero.mpr hdiag.symm
    have hp := Nat.pos_of_ne_zero (Fin.val_ne_zero_iff.mpr hd)
    have hlt := (y - x).isLt
    by_cases hi : (y - x).val < 1 + t
    · left
      right
      apply (cross_inl_inr 1 t x y).mpr
      rw [← cast_sub]
      apply Finset.mem_image.mpr
      refine ⟨(y - x).val - 1, Finset.mem_range.mpr (by omega), ?_⟩
      change (1 : ZMod q) + ((y - x).val - 1 : ℕ) = ((y - x).val : ZMod q)
      have he : 1 + ((y - x).val - 1) = (y - x).val := by omega
      simpa only [Nat.cast_add, Nat.cast_ofNat, Nat.cast_one] using congrArg (fun n : ℕ => (n : ZMod q)) he
    · right
      let j : Fin m := ⟨(y - x).val - (1 + t), by omega⟩
      have he : offset hcount j = y - x := by
        apply Fin.ext
        change 1 + t + ((y - x).val - (1 + t)) = (y - x).val
        omega
      refine ⟨j, ?_⟩
      change Sum.inr (x + offset hcount j) = Sum.inr y
      rw [he, add_sub_cancel]
  refine ⟨F, hF, fun j x => P14PrismRemainderCover.cross_ne _ x, ?_⟩
  intro x y hxy
  cases x with
  | inl x =>
    cases y with
    | inl y =>
      by_cases he : P14DoubleConeSplit.E hq (Sum.inl x) (Sum.inl y)
      · exact Or.inl he
      · right; left; left; left
        refine ⟨side_inl x, side_inl y, ?_⟩
        simpa only [label_inl] using avoid (halfIndex hq) x y
          (fun h => hxy (congrArg Sum.inl h)) he
    | inr y =>
      by_cases hd : x = y
      · exact Or.inl hd
      · exact Or.inr (hcross x y hd)
  | inr x =>
    cases y with
    | inl y =>
      by_cases hd : x = y
      · exact Or.inl hd
      · rcases hcross y x (fun h => hd h.symm) with hh | ⟨j, hj⟩
        · exact Or.inr (Or.inl (symmetric hq t hh))
        · right; right
          refine ⟨j, ?_⟩
          rw [← hj]
          exact hF j (Sum.inl y)
    | inr y =>
      by_cases he : P14DoubleConeSplit.E hq (Sum.inr x) (Sum.inr y)
      · exact Or.inl he
      · right; left; left; right
        refine ⟨side_inr x, side_inr y, ?_⟩
        simpa only [label_inr] using avoid (predHalfIndex hq) x y
          (fun h => hxy (congrArg Sum.inr h)) he

end P14QutritDenseCover
end
end

