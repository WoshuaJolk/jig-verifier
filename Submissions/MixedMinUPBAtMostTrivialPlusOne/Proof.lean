/-! Actual five-column Fourier kernel rows, including the layer swap and
conjugate Fourier index, inherit all four-row independence. -/

noncomputable section
open Matrix
namespace P14CubicKernelRows
open P14CubicPhysicalFrame P14CubicGridBranch P14CubicAllFour
open P14CubicSpectralCorrection P14CubicWaveRows P14CubicJetIndependence
open P14BalancedSpectralMatrix P14FourierSpectralWeights
open P14QuadraticKernelRows (inverseIndex inverseIndex_injective rowScale rowScale_nonzero)

def relabel {q : ℕ} (hq : 0 < q) : (Fin q ⊕ Fin q) → (Fin q ⊕ Fin q)
  | Sum.inl i => Sum.inr (inverseIndex hq i)
  | Sum.inr i => Sum.inl (inverseIndex hq i)

theorem relabel_injective {q : ℕ} (hq : 0 < q) : Function.Injective (relabel hq) := by
  intro i j h
  cases i <;> cases j <;> simp only [relabel, Sum.inl.injEq, Sum.inr.injEq,
    Sum.inl_ne_inr, Sum.inr_ne_inl] at h
  · exact congrArg Sum.inl (inverseIndex_injective hq h)
  · exact congrArg Sum.inr (inverseIndex_injective hq h)

theorem null_row {q : ℕ} (hq : 5 ≤ q) (e : ℝ) (b : Coeff)
    (i : Fin q ⊕ Fin q) (k : Fin 5) :
    nullMatrix q hq e b i k = rowScale q i *
      model e b (fourierRoot q) (node q) (relabel (by omega) i) k := by
  cases i with
  | inl i =>
    change -((fourierMatrix q)ᴴ i ⟨k.val, lt_of_lt_of_le k.isLt hq⟩ * spectral q e b k.val) = _
    rw [P14QuadraticKernelRows.dual_entry (by omega)]
    change -(fourierNormalization q * (node q (inverseIndex (by omega) i)) ^ k.val *
      spectral q e b k.val) =
      -fourierNormalization q * wave e b (fourierRoot q) (node q (inverseIndex (by omega) i)) k
    rw [wave_value]
    simp only [spectral,P14CubicJetIndependence.row]
    ring
  | inr i =>
    change (fourierMatrix q)ᴴ i ⟨k.val, lt_of_lt_of_le k.isLt hq⟩ = _
    rw [P14QuadraticKernelRows.dual_entry (by omega)]
    rfl

theorem null_independent {q : ℕ} (hq : 5 ≤ q) (e : ℝ) (b : Coeff)
    (ht : ∀ f : Fin 4 → Fin q ⊕ Fin q, Function.Injective f →
      LinearIndependent ℂ (fun i => model e b (fourierRoot q) (node q) (f i)))
    (f : Fin 4 → Fin q ⊕ Fin q) (hf : Function.Injective f) :
    LinearIndependent ℂ (fun i k => nullMatrix q hq e b (f i) k) := by
  have h := ht (relabel (by omega) ∘ f) ((relabel_injective (by omega)).comp hf)
  have hs := P14CubicRowOperations.row_scale _
    (fun i => rowScale q (f i)) (fun i => rowScale_nonzero (by omega) (f i)) h
  convert! hs using 1
  funext i k
  exact null_row hq e b (f i) k

end P14CubicKernelRows

end
end

