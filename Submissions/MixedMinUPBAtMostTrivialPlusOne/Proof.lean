/-! Actual translated-window and paired-circle witnesses in the common-label
local-factor interface. Global relation coverage and budgets are separate. -/

noncomputable section
namespace P14WindowCircleLocalFactors

open Submodule P14ComplexLocalCover
open P14FourierHalfMatchings.Circle
open P14CircleCommonLabels
open scoped BigOperators

def WindowRelation {n e : ℕ} (he : e ≤ n) (δ : Fin n)
    (i j : Fin n ⊕ Fin n) : Prop :=
  ∃ (a b : Fin n) (t : Fin e), b - a = δ + t.castLE he ∧
    ((i = Sum.inl a ∧ j = Sum.inr b) ∨
      (i = Sum.inr b ∧ j = Sum.inl a))

def RoundRelation {n r : ℕ} (E : Half r ≃ Fin n) (c : Index r)
    (i j : Fin n ⊕ Fin n) : Prop :=
  ∃ (side : Bool) (a : Fin n), i = halfIndex side a ∧
    j = halfIndex side (round E c a)

def PairedRoundRelation {n r : ℕ} (E : Half r ≃ Fin n) (c : Index r)
    (i j : Fin n ⊕ Fin n) : Prop :=
  RoundRelation E c i j ∨ RoundRelation E (c + 1) i j

private theorem span_finset_of_span_set {V : Type*} {k : ℕ}
    (v : V → Fin k → ℂ) (S : Finset V)
    (h : span ℂ (Set.range (fun i : ↥(S : Set V) => v i.val)) = ⊤) :
    span ℂ (Set.range (fun i : S => v i)) = ⊤ := by
  have hr : Set.range (fun i : S => v i) =
      Set.range (fun i : ↥(S : Set V) => v i.val) := by
    ext y
    constructor
    · rintro ⟨i, rfl⟩
      exact ⟨⟨i.val, i.property⟩, rfl⟩
    · rintro ⟨i, rfl⟩
      exact ⟨⟨i.val, i.property⟩, rfl⟩
  rw [hr]
  exact h

theorem window {n e : ℕ} [NeZero n] {ζ : ℂ}
    (hζ : IsPrimitiveRoot ζ n) (he : e < n) (δ : Fin n) :
    HasLocalFactor (Fin n ⊕ Fin n) (e + 1) e
      (WindowRelation (Nat.le_of_lt he) δ) := by
  obtain ⟨z, hz⟩ := P14CyclicWindowTranslated.exists_all_translated_factors hζ he
  obtain ⟨hnz, hspan, hp, hq⟩ := hz δ
  refine ⟨P14CyclicWindowTranslated.translatedFamily e (Nat.le_of_lt he) δ z,
    hnz, ?_, ?_⟩
  · intro S hS
    exact span_finset_of_span_set _ S (hspan S hS)
  · intro i j hij
    rcases hij with ⟨a, b, t, hab, hij⟩
    rcases hij with ⟨rfl, rfl⟩ | ⟨rfl, rfl⟩
    · exact hp a b t hab
    · exact hq a b t hab

theorem paired_rounds {n r : ℕ} (hr : 1 ≤ r)
    (E : Half r ≃ Fin n) (c : Index r) :
    HasLocalFactor (Fin n ⊕ Fin n) 3 2 (PairedRoundRelation E c) := by
  obtain ⟨z, x, hnz, hspan, hp, hq⟩ := P14CircleCommonLabels.exists_qutrit hr E c
  refine ⟨family E c z x, hnz, ?_, ?_⟩
  · intro S hS
    exact span_finset_of_span_set _ S (hspan S hS)
  · intro i j hij
    rcases hij with h | h
    · rcases h with ⟨side, a, rfl, rfl⟩
      exact hp side a
    · rcases h with ⟨side, a, rfl, rfl⟩
      exact hq side a

end P14WindowCircleLocalFactors

end
end

