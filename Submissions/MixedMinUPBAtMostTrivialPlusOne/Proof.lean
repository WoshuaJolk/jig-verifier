/-! Complete allocation dichotomy with no lower bound on partner size.
The sole extra case is a singleton balanced initial block, retained
explicitly for the proved cyclic construction. -/

noncomputable section
namespace P14AllPartnerAllocation
open P14PartnerCapacityAllocation
open scoped BigOperators

theorem construct {ι : Type*} (S : Finset ι) (r : ι → ℕ)
    (q m k : ℕ) (hq : 7 ≤ q) (ho : Odd q)
    (hr : ∀ i ∈ S, 2 ≤ r i)
    (htotal : (∑ i ∈ S, r i) + m + k = 2 * q - 6)
    (hroom : 2 * k ≤ q + 3 ∨ ∃ i ∈ S, k + 2 ≤ r i) :
    (∃ x t : ι → ℕ, ∃ N B : ℕ,
      (∀ i ∈ S, 2 * x i + t i = r i ∧ (2 * x i ≠ t i ∨ r i = 4)) ∧
      (∑ i ∈ S, x i) + N = (q - 5) / 2 ∧
      (∑ i ∈ S, t i) + B + k = q - 1 ∧
      N ≤ B ∧ 3 * N + (B - N) = m) ∨
      (∃ i, S = {i} ∧ r i = 4 * ((q - 5) / 2) ∧ m + k = 4) := by
  classical
  let L := (q - 5) / 2
  have hL : 2 * L + 5 = q := by
    obtain ⟨a, ha⟩ := ho
    dsimp only [L]
    omega
  obtain ⟨hkq, hcapacity⟩ := room_bounds S r q m k hq ho hr htotal hroom
  clear hroom
  by_cases hseed : S.Nonempty → ∃ i ∈ S, r i / 2 ≤ L + 1
  · left
    obtain ⟨x, t, N, B, hp, hN, hB, hNB, hm⟩ :=
      allocate_with_prisms_of_seed S r L (q - 1 - k) m
        hr hseed (by omega) hcapacity
    exact ⟨x, t, N, B, hp, hN, by omega, hNB, hm⟩
  · have hS : S.Nonempty := by
      by_contra hn
      exact hseed (fun h => False.elim (hn h))
    obtain ⟨i, hi⟩ := hS
    have hlarge : ∀ j ∈ S, L + 1 < r j / 2 := by
      intro j hj
      by_contra hn
      exact hseed (fun _ => ⟨j, hj, by omega⟩)
    have hsum := Finset.sum_erase_add S r hi
    have hli := hlarge i hi
    have hs : S = {i} := by
      ext j
      constructor
      · intro hj
        apply Finset.mem_singleton.mpr
        by_contra hji
        have hlj := hlarge j hj
        have hj' : j ∈ S.erase i := Finset.mem_erase.mpr ⟨hji, hj⟩
        have hle : r j ≤ ∑ a ∈ S.erase i, r a :=
          Finset.single_le_sum (fun a _ => Nat.zero_le (r a)) hj'
        omega
      · intro hj
        simpa only [Finset.mem_singleton.mp hj] using hi
    have htotal' : r i + m + k = 4 * L + 4 := by
      rw [hs, Finset.sum_singleton] at htotal
      omega
    by_cases heq : r i = 4 * L
    · exact Or.inr ⟨i, hs, heq, by omega⟩
    left
    refine ⟨fun _ => L, fun _ => r i - 2 * L, 0, m, ?_, ?_, ?_, by omega, by omega⟩
    · intro j hj
      have hji : j = i := Finset.mem_singleton.mp (hs ▸ hj)
      rw [hji]
      dsimp only
      exact ⟨by omega, Or.inl (by omega)⟩
    · simp [hs, L]
    · simp only [hs, Finset.sum_singleton]
      omega


end P14AllPartnerAllocation

end
end

section

/-! Actual matching remainder after reserving k cross offsets for a larger partner. -/

noncomputable section
namespace P14PartnerCapacityRemainder
open scoped BigOperators
open P14PrismRemainderCover

theorem construct {q p m k : ℕ} [NeZero q] (hq : 7 ≤ q) (ho : Odd q)
    (hk : 5 ≤ k)
    (r : Fin p → ℕ) (hr : ∀ i, 2 ≤ r i)
    (htotal : (∑ i, r i) + m + k = 2 * q - 6)
    (hroom : 2 * k ≤ q + 3 ∨ ∃ i, k + 2 ≤ r i) :
    ∃ x t : Fin p → ℕ, ∃ N B : ℕ,
      ∃ a : Fin N → Fin q, ∃ b : Fin B → Fin q,
      ∃ F : Fin m → (Fin q ⊕ Fin q) → (Fin q ⊕ Fin q),
      (∀ i, 2 * x i + t i = r i ∧ (2 * x i ≠ t i ∨ r i = 4)) ∧
      (∑ i, x i) + N = (q - 5) / 2 ∧ (∑ i, t i) + B + k = q - 1 ∧
      N ≤ B ∧
      (∀ i, (a i).val = (∑ j, x j) + 1 + i.val) ∧
      (∀ j, (b j).val = (∑ i, t i) + (k + 1) + j.val) ∧
      (∀ c, Function.Involutive (F c)) ∧ (∀ c v, F c v ≠ v) ∧
      (∀ u v, ((∃ i, Inside (a i) u v) ∨ (∃ j, Cross (b j) u v)) ↔
        ∃ c, F c u = v) := by
  classical
  obtain ⟨x, t, N, B, hpart, hN, hB, hNB, hm⟩ :=
    P14PartnerCapacityAllocation.construct Finset.univ r q m k hq ho hk
      (fun i _ => hr i) htotal (by
        rcases hroom with h | ⟨i, hi⟩
        · exact Or.inl h
        · exact Or.inr ⟨i, Finset.mem_univ i, hi⟩)
  let a : Fin N → Fin q := fun i =>
    ⟨(∑ j, x j) + 1 + i.val, by have hi := i.isLt; omega⟩
  let b : Fin B → Fin q := fun j =>
    ⟨(∑ i, t i) + (k + 1) + j.val, by have hj := j.isLt; omega⟩
  have ha : ∀ i, a i ≠ 0 := by
    intro i he
    have hv := congrArg Fin.val he
    change (∑ j, x j) + 1 + i.val = 0 at hv
    omega
  obtain ⟨G, hG, hGne, hGC⟩ := P14PrismRemainderCover.exists_cover (by omega) ho a b ha hNB
  let e : Fin (3 * N + (B - N)) ≃ Fin m := finCongr hm
  let F : Fin m → (Fin q ⊕ Fin q) → (Fin q ⊕ Fin q) := fun c => G (e.symm c)
  refine ⟨x, t, N, B, a, b, F, fun i => hpart i (Finset.mem_univ i),
    hN, hB, hNB, fun _ => rfl, fun _ => rfl, fun c => hG (e.symm c),
    fun c => hGne (e.symm c), ?_⟩
  intro u v
  rw [hGC]
  constructor
  · rintro ⟨c, hc⟩
    exact ⟨e c, by simpa only [F, Equiv.symm_apply_apply] using hc⟩
  · rintro ⟨c, hc⟩
    exact ⟨e.symm c, hc⟩

end P14PartnerCapacityRemainder

end
end

section

/-!
Elementary finite-set ingredients for the internal degree-four Cayley bound.
The mathematical input is Section 1 of TRIANGLE_GROUPING_FULL_DEGREE_FIVE.md.
This file neither imports a Jig statement nor asserts the full UPB conclusion.
The main theorem `three_by_three_small_sumset` identifies BOTH three-element
sets as cosets of the same three-element subgroup when all their sums lie in
a set of size at most four. `four_translate_rigid` excludes the K_(2,4) pattern.
-/

namespace P14OddFourCayley

open scoped BigOperators

variable {n : ℕ}

private def shiftSet (B : Finset (ZMod n)) (d : ZMod n) : Finset (ZMod n) :=
  B.filter (fun x => x + d ∈ B)

private theorem overlap_ge_two {T U C : Finset (ZMod n)}
    (hT : T.card = 3) (hU : U.card = 3) (hC : C.card ≤ 4)
    (hTC : T ⊆ C) (hUC : U ⊆ C) : 2 ≤ (T ∩ U).card := by
  have hUnion : (T ∪ U).card ≤ C.card :=
    Finset.card_le_card (Finset.union_subset hTC hUC)
  have hSum := Finset.card_union_add_card_inter T U
  omega

private theorem translate_card (a : ZMod n) (B : Finset (ZMod n)) :
    (B.image (fun x => a + x)).card = B.card :=
  Finset.card_image_of_injective B (fun _ _ h => add_left_cancel h)

private theorem intersection_eq_shift_image (a a' : ZMod n)
    (B : Finset (ZMod n)) :
    B.image (fun x => a + x) ∩ B.image (fun x => a' + x) =
      (shiftSet B (a - a')).image (fun x => a + x) := by
  ext z
  constructor
  · intro hz
    obtain ⟨x, hx, rfl⟩ := Finset.mem_image.mp (Finset.mem_inter.mp hz).1
    obtain ⟨y, hy, hxy⟩ := Finset.mem_image.mp (Finset.mem_inter.mp hz).2
    refine Finset.mem_image.mpr ⟨x, ?_, rfl⟩
    apply Finset.mem_filter.mpr
    refine ⟨hx, ?_⟩
    have h : x + (a - a') = y := by
      calc
        x + (a - a') = (a + x) - a' := by abel
        _ = (a' + y) - a' := by rw [hxy]
        _ = y := by abel
    simpa [h] using hy
  · intro hz
    obtain ⟨x, hx, rfl⟩ := Finset.mem_image.mp hz
    obtain ⟨hxB, hxShift⟩ := Finset.mem_filter.mp hx
    refine Finset.mem_inter.mpr ⟨Finset.mem_image.mpr ⟨x, hxB, rfl⟩, ?_⟩
    exact Finset.mem_image.mpr ⟨x + (a - a'), hxShift, by abel⟩

private theorem repeated_difference {A B C : Finset (ZMod n)}
    (hB : B.card = 3) (hC : C.card ≤ 4)
    (hSum : ∀ a ∈ A, ∀ b ∈ B, a + b ∈ C)
    {a a' : ZMod n} (ha : a ∈ A) (ha' : a' ∈ A) :
    2 ≤ (shiftSet B (a - a')).card := by
  have hSub (u : ZMod n) (hu : u ∈ A) : B.image (fun x => u + x) ⊆ C := by
    intro z hz
    obtain ⟨x, hx, rfl⟩ := Finset.mem_image.mp hz
    exact hSum u hu x hx
  have h := overlap_ge_two (by rw [translate_card, hB])
    (by rw [translate_card, hB]) hC (hSub a ha) (hSub a' ha')
  rwa [intersection_eq_shift_image, translate_card] at h

private theorem pair_map_injective (hn : Odd n) {d : ZMod n} (hd : d ≠ 0) :
    Function.Injective (fun x : ZMod n => ({x, x + d} : Finset (ZMod n))) := by
  intro x y h
  change ({x, x + d} : Finset (ZMod n)) = {y, y + d} at h
  have hx : x = y ∨ x = y + d := by
    have hm : x ∈ ({y, y + d} : Finset (ZMod n)) := by rw [← h]; simp
    simpa using hm
  rcases hx with hxy | hxy
  · exact hxy
  · have hxd : x + d = y ∨ x + d = y + d := by
      have hm : x + d ∈ ({y, y + d} : Finset (ZMod n)) := by rw [← h]; simp
      simpa using hm
    rcases hxd with hxd | hxd
    · exfalso
      apply ZMod.ne_neg_self hn hd
      calc
        d = (x + d) - x := by abel
        _ = y - (y + d) := by rw [hxd, hxy]
        _ = -d := by abel
    · exact add_right_cancel hxd

private theorem equal_pairs_signed {x y d e : ZMod n} (hd : d ≠ 0)
    (h : ({x, x + d} : Finset (ZMod n)) = {y, y + e}) : d = e ∨ d = -e := by
  have hx : x = y ∨ x = y + e := by
    have hm : x ∈ ({y, y + e} : Finset (ZMod n)) := by rw [← h]; simp
    simpa using hm
  have hxd : x + d = y ∨ x + d = y + e := by
    have hm : x + d ∈ ({y, y + e} : Finset (ZMod n)) := by rw [← h]; simp
    simpa using hm
  rcases hx with hxy | hxy
  · rcases hxd with hxd | hxd
    · exfalso
      apply hd
      have he : x + d = x + 0 := by simpa [hxy] using hxd
      exact add_left_cancel he
    · left
      simpa [hxy] using hxd
  · rcases hxd with hxd | hxd
    · right
      calc
        d = (x + d) - x := by abel
        _ = y - (y + e) := by rw [hxd, hxy]
        _ = -e := by abel
    · exfalso
      apply hd
      have he : x + d = x + 0 := by simpa [hxy] using hxd
      exact add_left_cancel he

private theorem repeated_signed_unique (hn : Odd n) {B : Finset (ZMod n)}
    (hB : B.card = 3) {d e : ZMod n} (hd : d ≠ 0) (he : e ≠ 0)
    (hD : 2 ≤ (shiftSet B d).card) (hE : 2 ≤ (shiftSet B e).card) :
    d = e ∨ d = -e := by
  let D := (shiftSet B d).image (fun x => ({x, x + d} : Finset (ZMod n)))
  let E := (shiftSet B e).image (fun x => ({x, x + e} : Finset (ZMod n)))
  have hDcard : 2 ≤ D.card := by
    simpa only [D, Finset.card_image_of_injective _ (pair_map_injective hn hd)] using hD
  have hEcard : 2 ≤ E.card := by
    simpa only [E, Finset.card_image_of_injective _ (pair_map_injective hn he)] using hE
  have hSub {u : ZMod n} (hu : u ≠ 0) :
      (shiftSet B u).image (fun x => ({x, x + u} : Finset (ZMod n))) ⊆
        B.powersetCard 2 := by
    intro P hP
    obtain ⟨x, hx, rfl⟩ := Finset.mem_image.mp hP
    obtain ⟨hxB, hxShift⟩ := Finset.mem_filter.mp hx
    apply Finset.mem_powersetCard.mpr
    refine ⟨?_, Finset.card_pair ?_⟩
    · intro y hy
      simp only [Finset.mem_insert, Finset.mem_singleton] at hy
      rcases hy with rfl | rfl
      · exact hxB
      · exact hxShift
    · intro h
      apply hu
      have heq : x + u = x + 0 := by simpa using h.symm
      exact add_left_cancel heq
  have hAll : (B.powersetCard 2).card = 3 := by
    rw [Finset.card_powersetCard, hB]
    rfl
  obtain ⟨P, hP⟩ :=
    Finset.inter_nonempty_of_card_lt_card_add_card (hSub hd) (hSub he)
      (by change (B.powersetCard 2).card < D.card + E.card; omega)
  obtain ⟨hPD, hPE⟩ := Finset.mem_inter.mp hP
  obtain ⟨x, hx, hxP⟩ := Finset.mem_image.mp hPD
  obtain ⟨y, hy, hyP⟩ := Finset.mem_image.mp hPE
  exact equal_pairs_signed hd (hxP.trans hyP.symm)

private theorem shape_of_signed_differences {A : Finset (ZMod n)}
    (hA : A.card = 3) {a d : ZMod n} (ha : a ∈ A)
    (hDiff : ∀ x ∈ A, ∀ y ∈ A, x ≠ y → x - y = d ∨ x - y = -d) :
    A = {a, a + d, a - d} := by
  have hSub : A ⊆ ({a, a + d, a - d} : Finset (ZMod n)) := by
    intro x hx
    by_cases hxa : x = a
    · simp [hxa]
    · rcases hDiff x hx a ha hxa with h | h
      · have hxEq : x = a + d := by
          calc
            x = a + (x - a) := by abel
            _ = a + d := by rw [h]
        simp [hxEq]
      · have hxEq : x = a - d := by
          calc
            x = a + (x - a) := by abel
            _ = a - d := by rw [h]; abel
        simp [hxEq]
  apply Finset.eq_of_subset_of_card_le hSub
  have h1 := Finset.card_insert_le a ({a + d, a - d} : Finset (ZMod n))
  have h2 := Finset.card_insert_le (a + d) ({a - d} : Finset (ZMod n))
  simp only [Finset.card_singleton] at h2
  omega

/-- Three-element sets whose mixed sumset has size at most four are cosets
of the same order-three subgroup of an odd cyclic group. The ambient set `C`
is allowed to contain an unused fourth element. -/
theorem three_by_three_small_sumset (hn : Odd n)
    {A B C : Finset (ZMod n)} (hA : A.card = 3) (hB : B.card = 3)
    (hC : C.card ≤ 4) (hSum : ∀ a ∈ A, ∀ b ∈ B, a + b ∈ C) :
    ∃ a b d : ZMod n, d ≠ 0 ∧ d + d + d = 0 ∧
      A = {a, a + d, a - d} ∧ B = {b, b + d, b - d} := by
  obtain ⟨a, a', ha, ha', haa'⟩ :=
    Finset.one_lt_card_iff.mp (show 1 < A.card by omega)
  let d := a' - a
  have hd : d ≠ 0 := by
    intro h
    apply haa'
    exact (sub_eq_zero.mp h).symm
  have hD : 2 ≤ (shiftSet B d).card := repeated_difference hB hC hSum ha' ha
  have hDiff : ∀ x ∈ A, ∀ y ∈ A, x ≠ y → x - y = d ∨ x - y = -d := by
    intro x hx y hy hxy
    apply repeated_signed_unique hn hB (sub_ne_zero.mpr hxy) hd
    · exact repeated_difference hB hC hSum hx hy
    · exact hD
  have hShapeA := shape_of_signed_differences hA ha hDiff
  have had : a + d ∈ A := by rw [hShapeA]; simp
  have hamd : a - d ∈ A := by rw [hShapeA]; simp
  have hDistinct : a + d ≠ a - d := by
    intro h
    apply ZMod.ne_neg_self hn hd
    apply add_left_cancel (a := a)
    simpa only [sub_eq_add_neg] using h
  have hDouble : d + d = d ∨ d + d = -d := by
    have h := hDiff (a + d) had (a - d) hamd hDistinct
    have heq : (a + d) - (a - d) = d + d := by abel
    simpa only [heq] using h
  have hThree : d + d + d = 0 := by
    rcases hDouble with h | h
    · exfalso
      apply hd
      exact add_left_cancel (show d + d = d + 0 by simpa using h)
    · exact add_eq_zero_iff_eq_neg.mpr h
  have hDiffB : ∀ x ∈ B, ∀ y ∈ B, x ≠ y → x - y = d ∨ x - y = -d := by
    intro x hx y hy hxy
    have hRepeat : 2 ≤ (shiftSet A (x - y)).card :=
      repeated_difference hA hC (fun b hb a ha => by simpa [add_comm] using hSum a ha b hb)
        hx hy
    obtain ⟨z, hz⟩ := Finset.card_pos.mp (show 0 < (shiftSet A (x - y)).card by omega)
    obtain ⟨hzA, hzShift⟩ := Finset.mem_filter.mp hz
    have hNe : z + (x - y) ≠ z := by
      intro h
      apply hxy
      exact sub_eq_zero.mp (add_left_cancel (show z + (x - y) = z + 0 by simpa using h))
    have h := hDiff (z + (x - y)) hzShift z hzA hNe
    have heq : (z + (x - y)) - z = x - y := by abel
    simpa only [heq] using h
  obtain ⟨b, hb⟩ := Finset.card_pos.mp (show 0 < B.card by omega)
  exact ⟨a, b, d, hd, hThree, hShapeA, shape_of_signed_differences hB hb hDiffB⟩

/-- A translate cannot fix a four-element set in an odd cyclic group unless
the translation is zero. Summing the four elements gives `4 • d = 0`. -/
theorem four_translate_rigid (hn : Odd n) {S : Finset (ZMod n)}
    (hS : S.card = 4) {d : ZMod n}
    (hImage : S.image (fun x => x + d) = S) : d = 0 := by
  have hsum : (∑ x ∈ S, x) + 4 • d = ∑ x ∈ S, x := by
    calc
      (∑ x ∈ S, x) + 4 • d = ∑ x ∈ S, (x + d) := by
        simp only [Finset.sum_add_distrib, Finset.sum_const, hS]
      _ = ∑ x ∈ S.image (fun x => x + d), x := by
        rw [Finset.sum_image (fun _ _ _ _ h => add_right_cancel h)]
      _ = ∑ x ∈ S, x := by rw [hImage]
  have hfour : 4 • d = 0 :=
    add_left_cancel (show (∑ x ∈ S, x) + 4 • d = (∑ x ∈ S, x) + 0 by simpa using hsum)
  have hdouble : (d + d) + (d + d) = 0 := by
    simpa only [show 4 = 2 * 2 by rfl, mul_nsmul, two_nsmul] using hfour
  exact (ZMod.add_self_eq_zero_iff_eq_zero hn).mp
    ((ZMod.add_self_eq_zero_iff_eq_zero hn).mp hdouble)

/-- Two distinct vertices cannot have four common neighbors when their
neighbors are translates of one fixed four-element set in an odd cyclic group.
This is the K_(2,4) exclusion; symmetry of the connection set is not needed. -/
theorem no_two_four (hn : Odd n) {S V : Finset (ZMod n)}
    (hS : S.card = 4) (hV : V.card = 4) {u u' : ZMod n} (hu : u ≠ u')
    (hAdj : ∀ v ∈ V, v - u ∈ S)
    (hAdj' : ∀ v ∈ V, v - u' ∈ S) : False := by
  have hImage (a : ZMod n) (hA : ∀ v ∈ V, v - a ∈ S) :
      V.image (fun v => v - a) = S := by
    apply Finset.eq_of_subset_of_card_le
    · intro z hz
      obtain ⟨v, hv, rfl⟩ := Finset.mem_image.mp hz
      exact hA v hv
    · rw [Finset.card_image_of_injective V
        (fun _ _ h => add_right_cancel (by simpa only [sub_eq_add_neg] using h)), hS, hV]
  have h1 := hImage u hAdj
  have h2 := hImage u' hAdj'
  have hInvariant : S.image (fun x => x + (u - u')) = S := by
    calc
      S.image (fun x => x + (u - u')) =
          (V.image (fun v => v - u)).image (fun x => x + (u - u')) := by rw [h1]
      _ = V.image (fun v => v - u') := by
        rw [Finset.image_image]
        congr 1
        funext v
        change (v - u) + (u - u') = v - u'
        abel
      _ = S := h2
  exact hu (sub_eq_zero.mp (four_translate_rigid hn hS hInvariant))

end P14OddFourCayley

end

section

/-!
The K_(3,3) exclusion and the full biclique bound for four-element symmetric
connection sets in odd cyclic groups. These are consequences of the elementary
three-set lemma in OddFourCayley. No UPB statement is imported or asserted.
-/

namespace P14OddFourCayleyBiclique

variable {n : ℕ}

private def InThree (d x : ZMod n) : Prop := x = 0 ∨ x = d ∨ x = -d

private theorem inThree_neg {d x : ZMod n} (hx : InThree d x) : InThree d (-x) := by
  rcases hx with rfl | rfl | rfl
  · exact Or.inl (by simp)
  · exact Or.inr (Or.inr rfl)
  · exact Or.inr (Or.inl (neg_neg _))

private theorem inThree_add {d x y : ZMod n} (hThree : d + d + d = 0)
    (hx : InThree d x) (hy : InThree d y) : InThree d (x + y) := by
  have hDouble : d + d = -d := add_eq_zero_iff_eq_neg.mp hThree
  have hNegDouble : -d + -d = d := by
    calc
      -d + -d = -(d + d) := by abel
      _ = d := by rw [hDouble, neg_neg]
  rcases hx with rfl | rfl | rfl <;> rcases hy with rfl | rfl | rfl <;>
    simp [InThree, hDouble, hNegDouble]

private theorem doubling_injective (hn : Odd n) :
    Function.Injective (fun x : ZMod n => x + x) := by
  intro x y h
  change x + x = y + y at h
  apply sub_eq_zero.mp
  apply (ZMod.add_self_eq_zero_iff_eq_zero hn).mp
  calc
    (x - y) + (x - y) = (x + x) - (y + y) := by abel
    _ = 0 := by rw [h]; simp

private theorem inThree_half (hn : Odd n) {d z : ZMod n}
    (hThree : d + d + d = 0) (hz : InThree d (z + z)) : InThree d z := by
  have hDouble : d + d = -d := add_eq_zero_iff_eq_neg.mp hThree
  have hNegDouble : -d + -d = d := by
    calc
      -d + -d = -(d + d) := by abel
      _ = d := by rw [hDouble, neg_neg]
  rcases hz with hz | hz | hz
  · exact Or.inl ((ZMod.add_self_eq_zero_iff_eq_zero hn).mp hz)
  · exact Or.inr (Or.inr (doubling_injective hn (hz.trans hNegDouble.symm)))
  · exact Or.inr (Or.inl (doubling_injective hn (hz.trans hDouble.symm)))

private theorem no_symmetric_small_sumset (hn : Odd n)
    {A B S : Finset (ZMod n)} (hA : A.card = 3) (hB : B.card = 3)
    (hS : S.card ≤ 4) (hZero : (0 : ZMod n) ∉ S)
    (hSymm : ∀ x ∈ S, -x ∈ S)
    (hSum : ∀ a ∈ A, ∀ b ∈ B, a + b ∈ S) : False := by
  obtain ⟨a, b, d, hd, hThree, hShapeA, hShapeB⟩ :=
    P14OddFourCayley.three_by_three_small_sumset hn hA hB hS hSum
  have hb : b ∈ B := by rw [hShapeB]; simp
  let z := a + b
  let T := A.image (fun x => x + b)
  let N := T.image (fun x => -x)
  have hT : T.card = 3 := by
    change (A.image (fun x => x + b)).card = 3
    rw [Finset.card_image_of_injective A (fun _ _ h => add_right_cancel h)]
    exact hA
  have hN : N.card = 3 := by
    change (T.image (fun x => -x)).card = 3
    rw [Finset.card_image_of_injective T neg_injective]
    exact hT
  have hTS : T ⊆ S := by
    intro x hx
    obtain ⟨u, hu, rfl⟩ := Finset.mem_image.mp hx
    exact hSum u hu b hb
  have hNS : N ⊆ S := by
    intro x hx
    obtain ⟨u, hu, rfl⟩ := Finset.mem_image.mp hx
    exact hSymm u (hTS hu)
  have hDev {x : ZMod n} (hx : x ∈ T) : InThree d (x - z) := by
    obtain ⟨u, hu, rfl⟩ := Finset.mem_image.mp hx
    rw [hShapeA] at hu
    simp only [Finset.mem_insert, Finset.mem_singleton] at hu
    rcases hu with rfl | rfl | rfl
    · exact Or.inl (by dsimp [z]; abel)
    · exact Or.inr (Or.inl (by dsimp [z]; abel))
    · exact Or.inr (Or.inr (by dsimp [z]; abel))
  obtain ⟨x, hx⟩ := Finset.inter_nonempty_of_card_lt_card_add_card hTS hNS
    (by omega)
  obtain ⟨hxT, hxN⟩ := Finset.mem_inter.mp hx
  obtain ⟨y, hyT, hyx⟩ := Finset.mem_image.mp hxN
  have hNegxT : -x ∈ T := by
    have hNegx : -x = y := by rw [← hyx, neg_neg]
    simpa only [hNegx] using hyT
  have hDevSum := inThree_add hThree (hDev hxT) (hDev hNegxT)
  have hzz : InThree d (z + z) := by
    have h := inThree_neg hDevSum
    have heq : -((x - z) + (-x - z)) = z + z := by abel
    simpa only [heq] using h
  have hz := inThree_half hn hThree hzz
  rcases hz with hz | hz | hz
  · have hMem := hSum a (by rw [hShapeA]; simp) b hb
    apply hZero
    have heq : a + b = 0 := hz
    simpa only [heq] using hMem
  · have hMem := hSum (a - d) (by rw [hShapeA]; simp) b hb
    apply hZero
    have heq : a - d + b = 0 := by
      calc
        a - d + b = z - d := by dsimp [z]; abel
        _ = 0 := by rw [hz]; simp
    simpa only [heq] using hMem
  · have hMem := hSum (a + d) (by rw [hShapeA]; simp) b hb
    apply hZero
    have heq : a + d + b = 0 := by
      calc
        a + d + b = z + d := by dsimp [z]; abel
        _ = 0 := by rw [hz]; simp
    simpa only [heq] using hMem

/-- A symmetric connection set of size at most four, excluding zero, cannot
contain the differences of a complete three-by-three bipartite configuration
in an odd cyclic group. -/
theorem no_three_three (hn : Odd n) {S U V : Finset (ZMod n)}
    (hS : S.card ≤ 4) (hZero : (0 : ZMod n) ∉ S)
    (hSymm : ∀ x ∈ S, -x ∈ S) (hU : U.card = 3) (hV : V.card = 3)
    (hAdj : ∀ u ∈ U, ∀ v ∈ V, v - u ∈ S) : False := by
  let A := U.image (fun u => -u)
  have hA : A.card = 3 := by
    change (U.image (fun u => -u)).card = 3
    rw [Finset.card_image_of_injective U neg_injective]
    exact hU
  apply no_symmetric_small_sumset hn hA hV hS hZero hSymm
  intro a ha v hv
  obtain ⟨u, hu, rfl⟩ := Finset.mem_image.mp ha
  simpa only [sub_eq_add_neg, add_comm] using hAdj u hu v hv

private theorem neighbors_card_le_four {S V : Finset (ZMod n)}
    (hS : S.card = 4) {a : ZMod n} (hAdj : ∀ v ∈ V, v - a ∈ S) :
    V.card ≤ 4 := by
  have hSub : V.image (fun v => v - a) ⊆ S := by
    intro z hz
    obtain ⟨v, hv, rfl⟩ := Finset.mem_image.mp hz
    exact hAdj v hv
  have hCard := Finset.card_le_card hSub
  rwa [Finset.card_image_of_injective V
    (fun _ _ h => add_right_cancel (by simpa only [sub_eq_add_neg] using h)), hS] at hCard

/-- Every nonempty complete biclique in the Cayley relation from a symmetric
four-element connection set excluding zero has total size at most five.
Disjointness is automatic from the stated zero exclusion and adjacency. -/
theorem biclique_card_le_five (hn : Odd n) {S U V : Finset (ZMod n)}
    (hS : S.card = 4) (hZero : (0 : ZMod n) ∉ S)
    (hSymm : ∀ x ∈ S, -x ∈ S) (hU : U.Nonempty) (hV : V.Nonempty)
    (hAdj : ∀ u ∈ U, ∀ v ∈ V, v - u ∈ S) : U.card + V.card ≤ 5 := by
  have hRev : ∀ v ∈ V, ∀ u ∈ U, u - v ∈ S := by
    intro v hv u hu
    have h := hSymm (v - u) (hAdj u hu v hv)
    simpa only [neg_sub] using h
  obtain ⟨u, hu⟩ := hU
  obtain ⟨v, hv⟩ := hV
  have hV4 : V.card ≤ 4 := neighbors_card_le_four hS (hAdj u hu)
  have hU4 : U.card ≤ 4 := neighbors_card_le_four hS (hRev v hv)
  by_contra hBig
  have hTotal : 6 ≤ U.card + V.card := by omega
  by_cases hVeq : V.card = 4
  · obtain ⟨u₁, u₂, hu₁, hu₂, hNe⟩ :=
      Finset.one_lt_card_iff.mp (show 1 < U.card by omega)
    exact P14OddFourCayley.no_two_four hn hS hVeq hNe (hAdj u₁ hu₁) (hAdj u₂ hu₂)
  · by_cases hUeq : U.card = 4
    · obtain ⟨v₁, v₂, hv₁, hv₂, hNe⟩ :=
        Finset.one_lt_card_iff.mp (show 1 < V.card by omega)
      exact P14OddFourCayley.no_two_four hn hS hUeq hNe (hRev v₁ hv₁) (hRev v₂ hv₂)
    · have hU3 : U.card = 3 := by omega
      have hV3 : V.card = 3 := by omega
      exact no_three_three hn hS.le hZero hSymm hU3 hV3 hAdj

end P14OddFourCayleyBiclique

end

section

/-! Transport a four-difference Cayley bound through layerwise labels.
Disjoint edge colors force label injectivity on each nonempty biclique side;
global injectivity of the two-layer labeling is not assumed. -/

noncomputable section
namespace P14ColoredCayleyBiclique
open P14BicliqueComplementConnection P14LayerBlockBiclique
variable {q : ℕ}

def Edge (C : ℕ → Prop) (f : ℕ → ZMod q) (U V : Finset (ZMod q))
    (i j : ℕ) : Prop :=
  ((C i ↔ C j) ∧ f j - f i ∈ U) ∨ (¬ (C i ↔ C j) ∧ f j - f i ∈ V)

theorem same_layer_of_equal {C : ℕ → Prop} {f : ℕ → ZMod q}
    {U V : Finset (ZMod q)} (hd : Disjoint U V) {i j k : ℕ}
    (hi : Edge C f U V i k) (hj : Edge C f U V j k) (he : f i = f j) :
    C i ↔ C j := by
  unfold Edge at hj
  rw [← he] at hj
  rcases hi with ⟨hiC, hiM⟩ | ⟨hiC, hiM⟩
  · rcases hj with ⟨hjC, hjM⟩ | ⟨hjC, hjM⟩
    · exact hiC.trans hjC.symm
    · exact False.elim (Finset.disjoint_left.mp hd hiM hjM)
  · rcases hj with ⟨hjC, hjM⟩ | ⟨hjC, hjM⟩
    · exact False.elim (Finset.disjoint_left.mp hd hjM hiM)
    · by_cases hI : C i <;> by_cases hJ : C j <;> by_cases hK : C k <;> simp_all

theorem symmetric {C : ℕ → Prop} {f : ℕ → ZMod q}
    {U V : Finset (ZMod q)} (hu : ∀ x ∈ U, -x ∈ U) (hv : ∀ x ∈ V, -x ∈ V)
    {i j : ℕ} (h : Edge C f U V i j) : Edge C f U V j i := by
  rcases h with ⟨hc, hm⟩ | ⟨hc, hm⟩
  · exact Or.inl ⟨hc.symm, by simpa only [neg_sub] using hu _ hm⟩
  · exact Or.inr ⟨fun h => hc h.symm, by simpa only [neg_sub] using hv _ hm⟩

theorem bound (C : ℕ → Prop) (S : Finset ℕ) (f : ℕ → ZMod q)
    (hf : LayerInjective C S f) (hq : Odd q) (U V : Finset (ZMod q))
    (hd : Disjoint U V) (hcard : (U ∪ V).card = 4) (hz : (0 : ZMod q) ∉ U ∪ V)
    (hu : ∀ x ∈ U, -x ∈ U) (hv : ∀ x ∈ V, -x ∈ V) :
    BicliqueBound (Edge C f U V) S 5 := by
  classical
  intro A hAS B hBS hA hB _ hedge
  obtain ⟨i₀, hi₀⟩ := hA
  obtain ⟨j₀, hj₀⟩ := hB
  have hia : Set.InjOn f A := by
    intro i hi j hj he
    exact hf i (hAS hi) j (hAS hj)
      (same_layer_of_equal hd (hedge i hi j₀ hj₀) (hedge j hj j₀ hj₀) he) he
  have hib : Set.InjOn f B := by
    intro i hi j hj he
    exact hf i (hBS hi) j (hBS hj)
      (same_layer_of_equal hd (symmetric hu hv (hedge i₀ hi₀ i hi))
        (symmetric hu hv (hedge i₀ hi₀ j hj)) he) he
  have hneg : ∀ x ∈ U ∪ V, -x ∈ U ∪ V := by
    intro x hx
    rcases Finset.mem_union.mp hx with hx | hx
    · exact Finset.mem_union_left _ (hu x hx)
    · exact Finset.mem_union_right _ (hv x hx)
  have hadj : ∀ x ∈ A.image f, ∀ y ∈ B.image f, y - x ∈ U ∪ V := by
    intro x hx y hy
    obtain ⟨i, hi, rfl⟩ := Finset.mem_image.mp hx
    obtain ⟨j, hj, rfl⟩ := Finset.mem_image.mp hy
    rcases hedge i hi j hj with ⟨_, hm⟩ | ⟨_, hm⟩
    · exact Finset.mem_union_left _ hm
    · exact Finset.mem_union_right _ hm
  have h := P14OddFourCayleyBiclique.biclique_card_le_five hq hcard hz hneg
    (Finset.Nonempty.image (f := f) ⟨i₀, hi₀⟩)
    (Finset.Nonempty.image (f := f) ⟨j₀, hj₀⟩) hadj
  rwa [Finset.card_image_of_injOn hia, Finset.card_image_of_injOn hib] at h

end P14ColoredCayleyBiclique

end
end

section

/-! A balanced ordinary dimension-five block: one internal positive step
and two consecutive cross offsets. The cyclic half-shift is constructed,
and the four colored differences are proved distinct. -/

noncomputable section
namespace P14BalancedFiveBlock
open P14LayerBlockBiclique P14BicliqueComplementConnection
variable {q : ℕ} [NeZero q]

theorem exists_half (hq : Odd q) : ∃ z : ZMod q, z + z = 1 := by
  obtain ⟨k, hk⟩ := hq
  refine ⟨((k + 1 : ℕ) : ZMod q), ?_⟩
  have he : k + 1 + (k + 1) = q + 1 := by omega
  rw [← Nat.cast_add, he, Nat.cast_add, ZMod.natCast_self, Nat.cast_one, zero_add]

theorem four_differences (hq : Odd q) (a : ℕ) (ha : 1 ≤ a)
    (hlimit : 2 * a + 2 ≤ q) (z : ZMod q) (hz : z + z = 1) :
    Disjoint ({(a : ZMod q), -(a : ZMod q)} : Finset (ZMod q)) {z, -z} ∧
    (({(a : ZMod q), -(a : ZMod q)} : Finset (ZMod q)) ∪ {z, -z}).card = 4 ∧
    (0 : ZMod q) ∉ ({(a : ZMod q), -(a : ZMod q)} : Finset (ZMod q)) ∪ {z, -z} := by
  classical
  letI : Fact (1 < q) := ⟨by omega⟩
  have hanz : (a : ZMod q) ≠ 0 :=
    P14OddCyclicAnnulus.cast_ne_zero (by omega) (by omega)
  have hone : (1 : ZMod q) ≠ 0 := by
    simpa using P14OddCyclicAnnulus.cast_ne_zero (q := q) (r := 1) (by omega) (by omega)
  have hznz : z ≠ 0 := by
    intro he
    rw [he, zero_add] at hz
    exact hone hz.symm
  have haneg := ZMod.ne_neg_self hq hanz
  have hzneg := ZMod.ne_neg_self hq hznz
  have haz : (a : ZMod q) ≠ z := by
    intro he
    have hd : ((2 * a : ℕ) : ZMod q) = 1 := by
      simp only [two_mul, Nat.cast_add, he, hz]
    have hv := congrArg ZMod.val hd
    rw [ZMod.val_natCast_of_lt (by omega), ZMod.val_one] at hv
    omega
  have hanz' : (a : ZMod q) ≠ -z := by
    intro he
    have hd : ((2 * a + 1 : ℕ) : ZMod q) = 0 := by
      simp only [two_mul, Nat.cast_add, Nat.cast_one, he]
      rw [← neg_add, hz]
      simp
    exact P14OddCyclicAnnulus.cast_ne_zero (by omega) (by omega) hd
  have hd : Disjoint ({(a : ZMod q), -(a : ZMod q)} : Finset (ZMod q)) {z, -z} := by
    apply Finset.disjoint_left.mpr
    intro x hx hy
    simp only [Finset.mem_insert, Finset.mem_singleton] at hx hy
    rcases hx with rfl | rfl
    · rcases hy with h | h
      · exact haz h
      · exact hanz' h
    · rcases hy with h | h
      · exact hanz' (by simpa using congrArg Neg.neg h)
      · exact haz (neg_injective h)
  refine ⟨hd, ?_, ?_⟩
  · rw [Finset.card_union_of_disjoint hd]
    simp [haneg, hzneg]
  · simp [hanz, hznz, Ne.symm hanz, Ne.symm hznz]

def shifted (C : ℕ → Prop) (g : ℕ → ZMod q) (b z : ZMod q) (i : ℕ) : ZMod q := by
  classical
  exact if C i then g i else g i - (b + z)

theorem shifted_injective (C : ℕ → Prop) (S : Finset ℕ) (g : ℕ → ZMod q)
    (hg : LayerInjective C S g) (b z : ZMod q) :
    LayerInjective C S (shifted C g b z) := by
  classical
  intro i hi j hj hc he
  apply hg i hi j hj hc
  by_cases hci : C i
  · have hcj := hc.mp hci
    simpa [shifted, hci, hcj] using he
  · have hcj : ¬ C j := fun h => hci (hc.mpr h)
    simpa [shifted, hci, hcj] using he

theorem cross_shift {C : ℕ → Prop} {g : ℕ → ZMod q} {b z : ZMod q}
    (hz : z + z = 1) {i j : ℕ} (hi : C i) (hj : ¬ C j)
    (hm : g j - g i ∈ P14CyclicArc.arc b 2) :
    shifted C g b z j - shifted C g b z i ∈ ({z, -z} : Finset (ZMod q)) := by
  classical
  obtain ⟨t, ht, hte⟩ := Finset.mem_image.mp hm
  have ht' : t < 2 := Finset.mem_range.mp ht
  have he : shifted C g b z j - shifted C g b z i = (g j - g i) - (b + z) := by
    simp only [shifted, if_pos hi, if_neg hj]
    abel
  rw [he, ← hte]
  have hzz : (1 : ZMod q) - z = z := by rw [← hz]; abel
  have ht : t = 0 ∨ t = 1 := by omega
  rcases ht with rfl | rfl <;> simp [sub_add_eq_sub_sub, hzz]

theorem map_edge (C : ℕ → Prop) (g : ℕ → ZMod q) (a : ℕ) (b z : ZMod q)
    (hz : z + z = 1) {i j : ℕ} (h : P14OddLayerBlockBiclique.Edge C g a 1 b 2 i j) :
    P14ColoredCayleyBiclique.Edge C (shifted C g b z)
      {(a : ZMod q), -(a : ZMod q)} {z, -z} i j := by
  classical
  rcases h with ⟨hw, hm⟩ | hc
  · have he : shifted C g b z j - shifted C g b z i = g j - g i := by
      rcases hw with ⟨hi, hj⟩ | ⟨hi, hj⟩ <;> simp [shifted, hi, hj]
    refine Or.inl ⟨same_layer hw, ?_⟩
    rw [he]
    obtain ⟨r, har, hrl, hr⟩ := (P14OddCyclicAnnulus.mem_iff a 1 _).mp hm
    have hra : r = a := by omega
    simpa [hra] using hr
  · rcases hc with ⟨hi, hj, hm⟩ | ⟨hi, hj, hm⟩
    · exact Or.inr ⟨fun he => hj (he.mp hi), cross_shift hz hi hj hm⟩
    · refine Or.inr ⟨fun he => hi (he.mpr hj), ?_⟩
      have h := cross_shift hz hj hi hm
      simp only [Finset.mem_insert, Finset.mem_singleton] at h ⊢
      rcases h with h | h
      · right
        rw [← neg_sub, h]
      · left
        rw [← neg_sub, h, neg_neg]

theorem bound (C : ℕ → Prop) (S : Finset ℕ) (g : ℕ → ZMod q)
    (hg : LayerInjective C S g) (hq : Odd q) (a : ℕ) (b : ZMod q)
    (ha : 1 ≤ a) (hlimit : 2 * a + 2 ≤ q) :
    BicliqueBound (P14OddLayerBlockBiclique.Edge C g a 1 b 2) S 5 := by
  classical
  obtain ⟨z, hz⟩ := exists_half hq
  obtain ⟨hd, hcard, hzero⟩ := four_differences hq a ha hlimit z hz
  have hu : ∀ x ∈ ({(a : ZMod q), -(a : ZMod q)} : Finset (ZMod q)),
      -x ∈ ({(a : ZMod q), -(a : ZMod q)} : Finset (ZMod q)) := by
    intro x hx
    simp only [Finset.mem_insert, Finset.mem_singleton] at hx ⊢
    rcases hx with rfl | rfl
    · exact Or.inr rfl
    · exact Or.inl (neg_neg _)
  have hv : ∀ x ∈ ({z, -z} : Finset (ZMod q)), -x ∈ ({z, -z} : Finset (ZMod q)) := by
    intro x hx
    simp only [Finset.mem_insert, Finset.mem_singleton] at hx ⊢
    rcases hx with rfl | rfl
    · exact Or.inr rfl
    · exact Or.inl (neg_neg _)
  have h := P14ColoredCayleyBiclique.bound C S (shifted C g b z)
    (shifted_injective C S g hg b z) hq _ _ hd hcard hzero hu hv
  intro A hAS B hBS hA hB hdis hedge
  exact h A hAS B hBS hA hB hdis (fun i hi j hj => map_edge C g a b z hz (hedge i hi j hj))

end P14BalancedFiveBlock

end
end

section

/-! The complete arithmetic and actual matching remainder for a
dimension-five exceptional factor. Ordinary non-qubit deficits are at least
four and include an odd deficit. No allocation, step list or matching is
supplied by the caller. Ordinary-vector assembly is still separate. -/

noncomputable section
namespace P14FiveRemainderAllocation
open scoped BigOperators
open P14PrismRemainderCover

theorem construct {q p m : ℕ} [NeZero q] (hq : 7 ≤ q) (ho : Odd q)
    (r : Fin p → ℕ) (hr : ∀ i, 4 ≤ r i) (hodd : ∃ i, Odd (r i))
    (htotal : (∑ i, r i) + m = 2 * q - 6) :
    ∃ x t : Fin p → ℕ, ∃ N B : ℕ,
      ∃ a : Fin N → Fin q, ∃ b : Fin B → Fin q,
      ∃ F : Fin m → (Fin q ⊕ Fin q) → (Fin q ⊕ Fin q),
      (∀ i, 2 * x i + t i = r i ∧ 2 * x i ≠ t i) ∧
      (∑ i, x i) + N = (q - 5) / 2 ∧ (∑ i, t i) + B = q - 1 ∧
      N ≤ B ∧
      (∀ i, (a i).val = (∑ j, x j) + 1 + i.val) ∧
      (∀ j, (b j).val = (∑ i, t i) + 1 + j.val) ∧
      (∀ c, Function.Involutive (F c)) ∧ (∀ c v, F c v ≠ v) ∧
      (∀ u v, ((∃ i, Inside (a i) u v) ∨ (∃ j, Cross (b j) u v)) ↔
        ∃ c, F c u = v) := by
  classical
  have hL : 2 * ((q - 5) / 2) + 5 = q := by
    obtain ⟨k, hk⟩ := ho
    omega
  have hc := P14OddLayerAllocation.five_capacity Finset.univ r q m hq ho
    (fun i _ => hr i) htotal
  have hodd' : ∃ i ∈ (Finset.univ : Finset (Fin p)), Odd (r i) := by
    obtain ⟨i, hi⟩ := hodd
    exact ⟨i, Finset.mem_univ i, hi⟩
  obtain ⟨x, t, N, B, hpart, hN, hB, hNB, hm⟩ :=
    P14OddLayerAllocation.allocate_with_prisms Finset.univ r ((q - 5) / 2) (q - 1) m
      (fun i _ => by have h := hr i; omega) hodd' (by omega) hc
  let a : Fin N → Fin q := fun i =>
    ⟨(∑ j, x j) + 1 + i.val, by have hi := i.isLt; omega⟩
  let b : Fin B → Fin q := fun j =>
    ⟨(∑ i, t i) + 1 + j.val, by have hj := j.isLt; omega⟩
  have ha : ∀ i, a i ≠ 0 := by
    intro i he
    have hv := congrArg Fin.val he
    change (∑ j, x j) + 1 + i.val = 0 at hv
    omega
  obtain ⟨G, hG, hGne, hGC⟩ := P14PrismRemainderCover.exists_cover (by omega) ho a b ha hNB
  let e : Fin (3 * N + (B - N)) ≃ Fin m := finCongr hm
  let F : Fin m → (Fin q ⊕ Fin q) → (Fin q ⊕ Fin q) := fun c => G (e.symm c)
  refine ⟨x, t, N, B, a, b, F, fun i => hpart i (Finset.mem_univ i),
    hN, hB, hNB, fun _ => rfl, fun _ => rfl, fun c => hG (e.symm c),
    fun c => hGne (e.symm c), ?_⟩
  intro u v
  rw [hGC]
  constructor
  · rintro ⟨c, hc⟩
    exact ⟨e c, by simpa only [F, Equiv.symm_apply_apply] using hc⟩
  · rintro ⟨c, hc⟩
    exact ⟨e.symm c, hc⟩

end P14FiveRemainderAllocation

end
end

section

/-! A complete common-label graph cover for dimension five, ordinary
non-qubit dimensions with an even member, and arbitrary remaining qubits.
The allocation, ordinary graphs and every qubit matching are constructed. -/

noncomputable section
namespace P14FiveMixedGraphCover
open P14OddLayerLabels P14FivePrescribedPairings P14BicliqueComplementConnection
open P14CyclicOffsetIntervalCover
open scoped BigOperators

def lengths {p : ℕ} (x : Fin p → ℕ) (i : ℕ) : ℕ :=
  if hi : i < p then x ⟨i, hi⟩ else 0

@[simp] theorem lengths_fin {p : ℕ} (x : Fin p → ℕ) (i : Fin p) :
    lengths x i.val = x i := by simp [lengths, i.isLt]

theorem prefix_lengths {p : ℕ} (x : Fin p → ℕ) : prefixSum (lengths x) p = ∑ i, x i := by
  unfold prefixSum
  rw [← Fin.sum_univ_eq_sum_range]
  apply Finset.sum_congr rfl
  intro i _
  exact lengths_fin x i

theorem construct {q p m : ℕ} [NeZero q] (hq : 7 ≤ q) (ho : Odd q)
    (r : Fin p → ℕ) (hr : ∀ i, 4 ≤ r i) (hu : ∀ i, r i ≤ q - 2)
    (hodd : ∃ i, Odd (r i)) (htotal : (∑ i, r i) + m = 2 * q - 6) :
    ∃ H : Fin p → ℕ → ℕ → Prop,
      ∃ F : Fin m → (Fin q ⊕ Fin q) → (Fin q ⊕ Fin q),
      (∀ i, (∀ {u v}, H i u v → H i v u) ∧ (∀ u, ¬ H i u u) ∧
        BicliqueBound (H i) (Finset.range (2 * q)) (r i + 1)) ∧
      (∀ c, Function.Involutive (F c)) ∧ (∀ c u, F c u ≠ u) ∧
      (∀ u v, u ≠ v → Prescribed hq u v ∨
        (∃ i, H i (encode u) (encode v)) ∨ (∃ c, F c u = v)) := by
  classical
  obtain ⟨x, t, N, B, a, b, F, hpart, hN, hB, _, ha, hb, hF, hFne, hFC⟩ :=
    P14FiveRemainderAllocation.construct hq ho r hr hodd htotal
  have hlimit : 2 * (1 + prefixSum (lengths x) p) ≤ q + 1 := by
    rw [prefix_lengths]
    omega
  have ht : ∀ i < p, lengths t i < q := by
    intro i hi
    have h := (hpart ⟨i, hi⟩).1
    have hu' := hu ⟨i, hi⟩
    simp only [lengths, dif_pos hi]
    omega
  have hne : ∀ i < p, 2 * lengths x i ≠ lengths t i := by
    intro i hi
    simpa only [lengths, dif_pos hi] using (hpart ⟨i, hi⟩).2
  obtain ⟨K, hK, hKC⟩ := P14OddAnnulusBlocks.exists_cover (Side q)
    (Finset.range (2 * q)) (label q) labels_injective ho (lengths x) (lengths t)
    p 1 1 (by decide) hlimit ht hne
  have hKC' (u v : Fin q ⊕ Fin q) :
      P14OddLayerBlockBiclique.Edge (Side q) (label q) 1 (∑ i, x i) 1 (∑ i, t i)
        (encode u) (encode v) ↔ ∃ i, i < p ∧ K i (encode u) (encode v) := by
    simpa only [prefix_lengths] using hKC (encode u) (encode v)
  refine ⟨fun i => K i.val, F, ?_, hF, hFne, ?_⟩
  · intro i
    have hk := hK i.val i.isLt
    refine ⟨hk.1, hk.2.1, ?_⟩
    have hbound := hk.2.2
    rw [lengths_fin, lengths_fin, (hpart i).1] at hbound
    exact hbound
  · intro u v huv
    rcases P14FiveComplementSplit.cover hq ho a b hN hB ha hb u v huv with
      he | hord | hinside | hcross
    · exact Or.inl he
    · obtain ⟨i, hi, hedge⟩ := (hKC' u v).mp hord
      exact Or.inr (Or.inl ⟨⟨i, hi⟩, hedge⟩)
    · exact Or.inr (Or.inr ((hFC u v).mp (Or.inl hinside)))
    · exact Or.inr (Or.inr ((hFC u v).mp (Or.inr hcross)))

end P14FiveMixedGraphCover

end
end

section

/-! Complete common-label graph cover for a qutrit and a larger partner, arbitrary additional non-qubit dimensions and qubits. -/

noncomputable section
namespace P14LargePartnerGraphCover
open P14OddLayerLabels P14FivePrescribedPairings P14BicliqueComplementConnection
open P14CyclicOffsetIntervalCover P14FiveMixedGraphCover
open scoped BigOperators

theorem construct {q p m k : ℕ} [NeZero q] (hq : 7 ≤ q) (ho : Odd q)
    (hk : 5 ≤ k)
    (r : Fin p → ℕ) (hr : ∀ i, 2 ≤ r i)
    (htotal : (∑ i, r i) + m + k = 2 * q - 6)
    (hroom : 2 * k ≤ q + 3 ∨ ∃ i, k + 2 ≤ r i) :
    ∃ H : Fin p → ℕ → ℕ → Prop,
      ∃ F : Fin m → (Fin q ⊕ Fin q) → (Fin q ⊕ Fin q),
      (∀ i, (∀ {u v}, H i u v → H i v u) ∧ (∀ u, ¬ H i u u) ∧
        BicliqueBound (H i) (Finset.range (2 * q)) (r i + 1)) ∧
      (∀ c, Function.Involutive (F c)) ∧ (∀ c u, F c u ≠ u) ∧
      (∀ u v, u ≠ v → P14DoubleConeSplit.E hq u v ∨ P14LargePartnerAbsorb.H q k (encode u) (encode v) ∨
        (∃ i, H i (encode u) (encode v)) ∨ (∃ c, F c u = v)) := by
  classical
  obtain ⟨x, t, N, B, a, b, F, hpart, hN, hB, _, ha, hb, hF, hFne, hFC⟩ :=
    P14PartnerCapacityRemainder.construct hq ho hk r hr htotal hroom
  let K := fun i => P14OddLayerBlockBiclique.Edge (Side q) (label q)
    (1 + prefixSum (lengths x) i) (lengths x i)
    (((k + 1 : ℕ) : ZMod q) + (prefixSum (lengths t) i : ZMod q)) (lengths t i)
  have hK : ∀ i, i < p →
      (∀ {u v}, K i u v → K i v u) ∧ (∀ u, ¬ K i u u) ∧
      BicliqueBound (K i) (Finset.range (2 * q))
        (2 * lengths x i + lengths t i + 1) := by
    intro i hi
    have hend := P14CyclicArcPartition.prefix_end (lengths x) hi
    rw [prefix_lengths] at hend
    have hxi : lengths x i = x ⟨i, hi⟩ := by simp [lengths, hi]
    have hti : lengths t i = t ⟨i, hi⟩ := by simp [lengths, hi]
    have hp := hpart ⟨i, hi⟩
    have htmax : t ⟨i, hi⟩ ≤ ∑ j, t j :=
      Finset.single_le_sum (fun j _ => Nat.zero_le (t j)) (Finset.mem_univ _)
    have hstart : 1 ≤ 1 + prefixSum (lengths x) i := by omega
    have hlimit : 2 * (1 + prefixSum (lengths x) i + lengths x i) ≤ q + 1 := by omega
    have htq : lengths t i < q := by omega
    refine ⟨P14OddLayerBlockBiclique.edge_symmetric (Side q) (label q) _ _ _ _,
      P14OddLayerBlockBiclique.edge_irreflexive (Side q) (label q) _ _ _ _ hstart hlimit, ?_⟩
    by_cases hne : 2 * lengths x i ≠ lengths t i
    · exact P14OddLayerBlockBiclique.bound (Side q) (Finset.range (2 * q))
        (label q) labels_injective ho _ _ _ _ hstart hlimit htq hne
    · have hx1 : lengths x i = 1 := by omega
      have ht2 : lengths t i = 2 := by omega
      have hbal : 2 * (1 + prefixSum (lengths x) i) + 2 ≤ q := by omega
      simpa only [K, hx1, ht2] using
        P14BalancedFiveBlock.bound (Side q) (Finset.range (2 * q)) (label q)
          labels_injective ho (1 + prefixSum (lengths x) i)
          (((k + 1 : ℕ) : ZMod q) + (prefixSum (lengths t) i : ZMod q)) hstart hbal
  have hKC (u v : ℕ) :
      P14OddLayerBlockBiclique.Edge (Side q) (label q) 1 (∑ i, x i) ((k + 1 : ℕ) : ZMod q) (∑ i, t i) u v ↔
        ∃ i, i < p ∧ K i u v := by
    simpa only [prefix_lengths] using P14OddAnnulusBlocks.edge_cover
      (Side q) (label q) (lengths x) (lengths t) p 1 ((k + 1 : ℕ) : ZMod q) u v
  refine ⟨fun i => K i.val, F, ?_, hF, hFne, ?_⟩
  · intro i
    have hk := hK i.val i.isLt
    refine ⟨hk.1, hk.2.1, ?_⟩
    have hbound := hk.2.2
    rw [lengths_fin, lengths_fin, (hpart i).1] at hbound
    exact hbound
  · intro u v huv
    rcases P14LargePartnerComplementSplit.cover hq ho a b hN hB ha hb u v huv with
      he | habs | hord | hinside | hcross
    · exact Or.inl he
    · exact Or.inr (Or.inl habs)
    · obtain ⟨i, hi, hedge⟩ := (hKC (encode u) (encode v)).mp hord
      exact Or.inr (Or.inr (Or.inl ⟨⟨i, hi⟩, hedge⟩))
    · exact Or.inr (Or.inr (Or.inr ((hFC u v).mp (Or.inl hinside))))
    · exact Or.inr (Or.inr (Or.inr ((hFC u v).mp (Or.inr hcross))))

end P14LargePartnerGraphCover

end
end

section

/-! Embed the two physical layers into one even cyclic group. Doubled
labels occupy even positions; shifted doubled labels plus one occupy odd
positions. The mapping is globally injective on the actual row range. -/

noncomputable section
namespace P14DoubleCyclicLabels
open P14OddLayerLabels P14TwoLayerBiclique
variable {q : ℕ} [NeZero q]

def dbl (x : ZMod q) : ZMod (2 * q) := ((2 * x.val : ℕ) : ZMod (2 * q))

theorem dbl_nat (n : ℕ) : dbl (n : ZMod q) = ((2 * n : ℕ) : ZMod (2 * q)) := by
  unfold dbl
  rw [ZMod.val_natCast, ← Nat.mul_mod_mul_left, ZMod.natCast_mod]

theorem dbl_add (x y : ZMod q) : dbl (x + y) = dbl x + dbl y := by
  calc
    dbl (x + y) = dbl ((x.val + y.val : ℕ) : ZMod q) := by
      rw [Nat.cast_add, ZMod.natCast_zmod_val, ZMod.natCast_zmod_val]
    _ = ((2 * (x.val + y.val) : ℕ) : ZMod (2 * q)) := dbl_nat _
    _ = dbl x + dbl y := by simp [dbl, Nat.mul_add, Nat.cast_add]

theorem dbl_neg (x : ZMod q) : dbl (-x) = -dbl x := by
  calc
    dbl (-x) = (dbl x + dbl (-x)) - dbl x := by abel
    _ = dbl (0 : ZMod q) - dbl x := by rw [← dbl_add, add_neg_cancel]
    _ = -dbl x := by simp [dbl]

theorem dbl_sub (x y : ZMod q) : dbl (x - y) = dbl x - dbl y := by
  simp only [sub_eq_add_neg, dbl_add, dbl_neg]

theorem dbl_injective : Function.Injective (dbl (q := q)) := by
  intro x y he
  have hx := ZMod.val_lt x
  have hy := ZMod.val_lt y
  have hv := congrArg ZMod.val he
  change ((2 * x.val : ℕ) : ZMod (2 * q)).val = ((2 * y.val : ℕ) : ZMod (2 * q)).val at hv
  rw [ZMod.val_natCast_of_lt (by omega), ZMod.val_natCast_of_lt (by omega)] at hv
  apply ZMod.val_injective q
  omega

theorem even_ne_odd (x y : ZMod q) : dbl x ≠ dbl y + 1 := by
  intro he
  have hx := ZMod.val_lt x
  have hy := ZMod.val_lt y
  have he' : ((2 * x.val : ℕ) : ZMod (2 * q)) = ((2 * y.val + 1 : ℕ) : ZMod (2 * q)) := by
    simpa only [dbl, Nat.cast_add, Nat.cast_one] using he
  have hv := congrArg ZMod.val he'
  rw [ZMod.val_natCast_of_lt (by omega), ZMod.val_natCast_of_lt (by omega)] at hv
  omega

def rowLabel (b : ZMod q) (l i : ℕ) : ZMod (2 * q) := by
  classical
  exact if Side q i then dbl (label q i) else dbl (label q i - (b + (l : ZMod q))) + 1

theorem rowLabel_injective (b : ZMod q) (l : ℕ) :
    Set.InjOn (rowLabel b l) (Finset.range (2 * q)) := by
  intro i hi j hj he
  by_cases hci : Side q i <;> by_cases hcj : Side q j
  · simp only [rowLabel, if_pos hci, if_pos hcj] at he
    exact labels_injective i hi j hj (by simp [hci, hcj]) (dbl_injective he)
  · simp only [rowLabel, if_pos hci, if_neg hcj] at he
    exact False.elim (even_ne_odd _ _ he)
  · simp only [rowLabel, if_neg hci, if_pos hcj] at he
    exact False.elim (even_ne_odd _ _ he.symm)
  · simp only [rowLabel, if_neg hci, if_neg hcj] at he
    have h := dbl_injective (add_right_cancel he)
    exact labels_injective i hi j hj (by simp [hci, hcj]) (by simpa using congrArg (fun z : ZMod q => z + (b + (l : ZMod q))) h)

theorem within_difference (b : ZMod q) (l : ℕ) {i j : ℕ}
    (h : Within (Side q) i j) :
    rowLabel b l j - rowLabel b l i = dbl (label q j - label q i) := by
  rcases h with ⟨hi, hj⟩ | ⟨hi, hj⟩
  · simp only [rowLabel, if_pos hi, if_pos hj, dbl_sub]
  · simp only [rowLabel, if_neg hi, if_neg hj]
    calc
      dbl (label q j - (b + (l : ZMod q))) + 1 -
          (dbl (label q i - (b + (l : ZMod q))) + 1) =
          dbl (label q j - (b + (l : ZMod q))) - dbl (label q i - (b + (l : ZMod q))) := by abel
      _ = dbl (label q j - label q i) := by
        rw [← dbl_sub]
        congr 1
        abel

theorem cross_difference (b : ZMod q) (l : ℕ) {i j : ℕ}
    (hi : Side q i) (hj : ¬ Side q j) :
    rowLabel b l j - rowLabel b l i = dbl ((label q j - label q i) - (b + (l : ZMod q))) + 1 := by
  simp only [rowLabel, if_pos hi, if_neg hj]
  calc
    dbl (label q j - (b + (l : ZMod q))) + 1 - dbl (label q i) =
        (dbl (label q j - (b + (l : ZMod q))) - dbl (label q i)) + 1 := by abel
    _ = dbl ((label q j - label q i) - (b + (l : ZMod q))) + 1 := by
      rw [← dbl_sub]
      congr 2
      abel

end P14DoubleCyclicLabels

end
end

section

/-! A symmetric connection set in any finite cyclic group has the required
expansion when its cardinality and a contained interval meet two explicit
lower bounds. The minimizing subgroup and its coset count are constructed
by the imported checked results. -/

namespace P14CyclicIntervalExpansion
open P14CayleyBoundary
open scoped Pointwise
variable {q : ℕ} [NeZero q]

theorem growth (C : Finset (ZMod q)) (h0 : 0 ∈ C)
    (hs : ∀ c ∈ C, -c ∈ C) (hp : C ≠ Finset.univ)
    (a : ZMod q) (L R : ℕ) (hI : ∀ t : ℕ, t < L → a + (t : ZMod q) ∈ C)
    (hR : R ≤ C.card) (hL : R + 1 ≤ 2 * L)
    (X : Finset (ZMod q)) (hX : Admissible C X) :
    X.card + R ≤ (X + C).card + 1 := by
  classical
  obtain ⟨H, A, hA, hAn, hpA, hmin⟩ :=
    P14SymmetricCayleyAtom.exists_minimizing_subgroup C h0 hs hp
  have hm := hmin X hX
  by_cases hc : A.card = 1
  · obtain ⟨a0, he⟩ := Finset.card_eq_one.mp hc
    have hz : (A + C).card = C.card := by
      rw [he, Finset.card_singleton_add]
    rw [hz, hc] at hm
    omega
  · have hc : 2 ≤ A.card := by
      have hpos := Finset.card_pos.mpr hAn
      omega
    have hl := P14CyclicSubgroupInterval.cardinal_lower_bound H A C hA a L hI hpA
    have hLp : 1 ≤ L := by omega
    have hmul := Nat.mul_le_mul_right (L - 1) hc
    have he : L - 1 + 1 = L := Nat.sub_add_cancel hLp
    have hnum : A.card + R ≤ L * A.card + 1 := by nlinarith
    omega

theorem disjoint_bound (C : Finset (ZMod q)) (h0 : 0 ∈ C)
    (hs : ∀ c ∈ C, -c ∈ C) (hp : C ≠ Finset.univ)
    (a : ZMod q) (L R : ℕ) (hI : ∀ t : ℕ, t < L → a + (t : ZMod q) ∈ C)
    (hR : R ≤ C.card) (hL : R + 1 ≤ 2 * L)
    (X Y : Finset (ZMod q)) (hX : X.Nonempty) (hY : Y.Nonempty)
    (hd : Disjoint (X + C) Y) : X.card + Y.card + R ≤ q + 1 := by
  have hpX : X + C ≠ Finset.univ := by
    intro he
    obtain ⟨y, hy⟩ := hY
    exact Finset.disjoint_left.mp hd (by rw [he]; exact Finset.mem_univ y) hy
  have hg := growth C h0 hs hp a L R hI hR hL X ⟨hX, hpX⟩
  have hu : (X + C).card + Y.card ≤ q := by
    rw [← Finset.card_union_of_disjoint hd]
    have h := Finset.card_le_univ ((X + C) ∪ Y)
    simpa using h
  omega

end P14CyclicIntervalExpansion

end

section

/-! The first l cyclic distances have bicliques of size at most2l+1
in any cyclic order with at least three spare positions. The complement
contains zero and one long opposite interval; no parity assumption is needed. -/

noncomputable section
namespace P14InitialCyclicBiclique
open P14OddCyclicAnnulus P14BicliqueComplementConnection
open scoped Pointwise
variable {q : ℕ} [NeZero q]

theorem biclique_card (l : ℕ) (hl : 1 ≤ l) (hq : 2 * l + 3 ≤ q)
    (X Y : Finset (ZMod q)) (hX : X.Nonempty) (hY : Y.Nonempty)
    (hpair : ∀ x ∈ X, ∀ y ∈ Y, y - x ∈ annulus 1 l) :
    X.card + Y.card ≤ 2 * l + 1 := by
  classical
  let C := Finset.univ \ annulus (q := q) 1 l
  have hlimit : 2 * (1 + l) ≤ q + 1 := by omega
  have h0 : (0 : ZMod q) ∈ C := Finset.mem_sdiff.mpr
    ⟨Finset.mem_univ _, zero_not_mem 1 l (by omega) hl hlimit⟩
  have hs : ∀ c ∈ C, -c ∈ C := by
    intro c hc
    refine Finset.mem_sdiff.mpr ⟨Finset.mem_univ _, ?_⟩
    intro hn
    have hh := neg_mem 1 l hn
    exact (Finset.mem_sdiff.mp hc).2 (by simpa using hh)
  have hp : C ≠ Finset.univ := by
    intro he
    have hc : (1 : ZMod q) ∈ C := by rw [he]; exact Finset.mem_univ _
    apply (Finset.mem_sdiff.mp hc).2
    exact (mem_iff 1 l _).mpr ⟨1, le_rfl, by omega, Or.inl (by simp)⟩
  have hR : q - 2 * l ≤ C.card := by
    dsimp [C]
    rw [Finset.card_sdiff_of_subset (Finset.subset_univ _), Finset.card_univ, ZMod.card]
    have hd := cardinal_upper (q := q) 1 l
    omega
  have hd : Disjoint (X + C) Y := by
    apply Finset.disjoint_left.mpr
    intro y hy hyY
    obtain ⟨x, hx, c, hc, he⟩ := Finset.mem_add.mp hy
    apply (Finset.mem_sdiff.mp hc).2
    have h := hpair x hx y hyY
    have he' : y - x = c := by rw [← he]; abel
    rwa [he'] at h
  have hmiddle : ∀ t : ℕ, t < q + 1 - 2 * (1 + l) →
      ((1 + l : ℕ) : ZMod q) + t ∈ C := by
    intro t ht
    exact Finset.mem_sdiff.mpr ⟨Finset.mem_univ _, middle_avoids 1 l (by omega) hl hlimit ht⟩
  have hb := P14CyclicIntervalExpansion.disjoint_bound C h0 hs hp
    ((1 + l : ℕ) : ZMod q) (q + 1 - 2 * (1 + l)) (q - 2 * l)
    hmiddle hR (by omega) X Y hX hY hd
  omega

theorem bound (S : Finset ℕ) (g : ℕ → ZMod q) (hg : Set.InjOn g S)
    (l : ℕ) (hl : 1 ≤ l) (hq : 2 * l + 3 ≤ q) :
    BicliqueBound (fun i j => g j - g i ∈ annulus 1 l) S (2 * l + 1) := by
  classical
  intro A hAS B hBS hA hB _ hedge
  have hia : Set.InjOn g A := hg.mono hAS
  have hib : Set.InjOn g B := hg.mono hBS
  have hp : ∀ x ∈ A.image g, ∀ y ∈ B.image g, y - x ∈ annulus 1 l := by
    intro x hx y hy
    obtain ⟨i, hi, rfl⟩ := Finset.mem_image.mp hx
    obtain ⟨j, hj, rfl⟩ := Finset.mem_image.mp hy
    exact hedge i hi j hj
  have h := biclique_card l hl hq (A.image g) (B.image g) (hA.image _) (hB.image _) hp
  rwa [Finset.card_image_of_injOn hia, Finset.card_image_of_injOn hib] at h

end P14InitialCyclicBiclique

end
end

section

/-! An initial balanced block is a subgraph of a power of an even cycle
under the explicit parity encoding. Its exact biclique bound holds for
all widths with two spare layer positions, not just width one. -/

noncomputable section
namespace P14BalancedInitialBlock
open P14DoubleCyclicLabels P14OddLayerLabels P14OddCyclicAnnulus
open P14LayerBlockBiclique P14BicliqueComplementConnection
variable {q : ℕ} [NeZero q]

theorem double_annulus {l : ℕ} {z : ZMod q} (h : z ∈ annulus 1 l) :
    dbl z ∈ annulus 1 (2 * l) := by
  obtain ⟨r, hr, hrl, he⟩ := (mem_iff 1 l z).mp h
  apply (mem_iff 1 (2 * l) _).mpr
  refine ⟨2 * r, by omega, by omega, ?_⟩
  rcases he with rfl | rfl
  · exact Or.inl (dbl_nat r)
  · exact Or.inr (by rw [dbl_neg, dbl_nat])

theorem cross_annulus (b : ZMod q) (l : ℕ) {i j : ℕ}
    (hi : Side q i) (hj : ¬ Side q j)
    (h : label q j - label q i ∈ P14CyclicArc.arc b (2 * l)) :
    rowLabel b l j - rowLabel b l i ∈ annulus 1 (2 * l) := by
  obtain ⟨t, ht, hte⟩ := Finset.mem_image.mp h
  have ht' := Finset.mem_range.mp ht
  rw [cross_difference b l hi hj, ← hte]
  have he : (b + (t : ZMod q)) - (b + (l : ZMod q)) = (t : ZMod q) - (l : ZMod q) := by abel
  rw [he, dbl_sub, dbl_nat, dbl_nat]
  by_cases hlt : l ≤ t
  · apply (mem_iff 1 (2 * l) _).mpr
    refine ⟨2 * (t - l) + 1, by omega, by omega, Or.inl ?_⟩
    simp only [Nat.cast_add, Nat.cast_mul, Nat.cast_ofNat, Nat.cast_one, Nat.cast_sub hlt]
    simp only [mul_sub] <;> abel
  · have htl : t ≤ l := by omega
    have hp : 1 ≤ 2 * (l - t) := by omega
    apply (mem_iff 1 (2 * l) _).mpr
    refine ⟨2 * (l - t) - 1, by omega, by omega, Or.inr ?_⟩
    simp only [Nat.cast_sub hp, Nat.cast_mul, Nat.cast_ofNat, Nat.cast_one, Nat.cast_sub htl]
    simp only [mul_sub] <;> abel

theorem map_edge (b : ZMod q) (l : ℕ) {i j : ℕ}
    (h : P14OddLayerBlockBiclique.Edge (Side q) (label q) 1 l b (2 * l) i j) :
    rowLabel b l j - rowLabel b l i ∈ annulus 1 (2 * l) := by
  rcases h with hw | hc
  · rw [within_difference b l hw.1]
    exact double_annulus hw.2
  · rcases hc with ⟨hi, hj, hm⟩ | ⟨hi, hj, hm⟩
    · exact cross_annulus b l hi hj hm
    · have h := cross_annulus b l hj hi hm
      simpa only [neg_sub] using neg_mem 1 (2 * l) h

theorem bound (b : ZMod q) (l : ℕ) (hl : 1 ≤ l) (hfit : 2 * l + 2 ≤ q) :
    BicliqueBound (P14OddLayerBlockBiclique.Edge (Side q) (label q) 1 l b (2 * l))
      (Finset.range (2 * q)) (4 * l + 1) := by
  letI : NeZero (2 * q) := ⟨Nat.mul_ne_zero (by omega) (NeZero.ne q)⟩
  have h := P14InitialCyclicBiclique.bound (Finset.range (2 * q)) (rowLabel b l)
    (rowLabel_injective b l) (2 * l) (by omega) (by omega)
  have he : 2 * (2 * l) + 1 = 4 * l + 1 := by omega
  rw [he] at h
  intro A hAS B hBS hA hB hdis hedge
  exact h A hAS B hBS hA hB hdis (fun i hi j hj => map_edge b l (hedge i hi j hj))

end P14BalancedInitialBlock

end
end

section

/-! Resolve the exceptional singleton balanced midpoint by its proved
initial cyclic block. The remaining cross offsets are actual qubit
matchings; this includes the dimension-six case with exactly one qubit. -/

noncomputable section
namespace P14MidpointPartnerGraphCover
open P14OddLayerLabels P14BicliqueComplementConnection P14PrismRemainderCover

theorem construct {q m k : ℕ} [NeZero q] (hq : 7 ≤ q) (ho : Odd q)
    (hkm : m + k = 4) :
    ∃ H : Fin 1 → ℕ → ℕ → Prop,
      ∃ F : Fin m → (Fin q ⊕ Fin q) → (Fin q ⊕ Fin q),
      (∀ i, (∀ {u v}, H i u v → H i v u) ∧ (∀ u, ¬ H i u u) ∧
        BicliqueBound (H i) (Finset.range (2 * q)) (4 * ((q - 5) / 2) + 1)) ∧
      (∀ c, Function.Involutive (F c)) ∧ (∀ c u, F c u ≠ u) ∧
      (∀ u v, u ≠ v → P14DoubleConeSplit.E hq u v ∨
        P14LargePartnerAbsorb.H q k (encode u) (encode v) ∨
        (∃ i, H i (encode u) (encode v)) ∨ (∃ c, F c u = v)) := by
  let L := (q - 5) / 2
  have hL : 2 * L + 5 = q := by
    obtain ⟨a, ha⟩ := ho
    dsimp only [L]
    omega
  let K := P14OddLayerBlockBiclique.Edge (Side q) (label q) 1 L
    ((k + 1 : ℕ) : ZMod q) (2 * L)
  let a : Fin 0 → Fin q := Fin.elim0
  let b : Fin m → Fin q := fun j => ⟨2 * L + (k + 1) + j.val, by have hj := j.isLt; omega⟩
  let F : Fin m → (Fin q ⊕ Fin q) → (Fin q ⊕ Fin q) := fun j => crossMatching (b j)
  refine ⟨fun _ => K, F, ?_, fun c => cross_involutive (b c), fun c => cross_ne (b c), ?_⟩
  · intro i
    exact ⟨P14OddLayerBlockBiclique.edge_symmetric _ _ _ _ _ _,
      P14OddLayerBlockBiclique.edge_irreflexive _ _ _ _ _ _ (by omega) (by omega),
      P14BalancedInitialBlock.bound _ L (by omega) (by omega)⟩
  · intro u v huv
    have ha : ∀ i, (a i).val = L + 1 + i.val := fun i => Fin.elim0 i
    have hb : ∀ j, (b j).val = 2 * L + (k + 1) + j.val := fun _ => rfl
    rcases P14LargePartnerComplementSplit.cover hq ho a b (by simp [L])
      (by omega) ha hb u v huv with he | habs | hord | hinside | hcross
    · exact Or.inl he
    · exact Or.inr (Or.inl habs)
    · exact Or.inr (Or.inr (Or.inl ⟨0, hord⟩))
    · obtain ⟨i, _⟩ := hinside
      exact Fin.elim0 i
    · obtain ⟨j, hj⟩ := hcross
      exact Or.inr (Or.inr (Or.inr ⟨j, (cross_iff _ u v).mp hj⟩))

end P14MidpointPartnerGraphCover

end
end

section

/-! Remove the partner-size restriction from the actual common-label cover.
An ordinary allocation uses explicit shifted prisms; its exceptional
singleton balanced case uses the checked initial cyclic graph. -/

noncomputable section
namespace P14AllPartnerGraphCover
open P14OddLayerLabels P14FivePrescribedPairings P14BicliqueComplementConnection
open P14CyclicOffsetIntervalCover P14FiveMixedGraphCover P14PrismRemainderCover
open scoped BigOperators

theorem of_allocation {q p m k : ℕ} [NeZero q] (hq : 7 ≤ q) (ho : Odd q)
    (r : Fin p → ℕ) (x t : Fin p → ℕ) (N B : ℕ)
    (hpart : ∀ i, 2 * x i + t i = r i ∧ (2 * x i ≠ t i ∨ r i = 4))
    (hN : (∑ i, x i) + N = (q - 5) / 2)
    (hB : (∑ i, t i) + B + k = q - 1)
    (hNB : N ≤ B) (hm : 3 * N + (B - N) = m) :
    ∃ H : Fin p → ℕ → ℕ → Prop,
      ∃ F : Fin m → (Fin q ⊕ Fin q) → (Fin q ⊕ Fin q),
      (∀ i, (∀ {u v}, H i u v → H i v u) ∧ (∀ u, ¬ H i u u) ∧
        BicliqueBound (H i) (Finset.range (2 * q)) (r i + 1)) ∧
      (∀ c, Function.Involutive (F c)) ∧ (∀ c u, F c u ≠ u) ∧
      (∀ u v, u ≠ v → P14DoubleConeSplit.E hq u v ∨ P14LargePartnerAbsorb.H q k (encode u) (encode v) ∨
        (∃ i, H i (encode u) (encode v)) ∨ (∃ c, F c u = v)) := by
  classical
  let a : Fin N → Fin q := fun i =>
    ⟨(∑ j, x j) + 1 + i.val, by have hi := i.isLt; omega⟩
  let b : Fin B → Fin q := fun j =>
    ⟨(∑ i, t i) + (k + 1) + j.val, by have hj := j.isLt; omega⟩
  have ha : ∀ i, a i ≠ 0 := by
    intro i he
    have hv := congrArg Fin.val he
    change (∑ j, x j) + 1 + i.val = 0 at hv
    omega
  obtain ⟨G, hG, hGne, hGC⟩ := P14PrismRemainderCover.exists_cover (by omega) ho a b ha hNB
  let e : Fin (3 * N + (B - N)) ≃ Fin m := finCongr hm
  let F : Fin m → (Fin q ⊕ Fin q) → (Fin q ⊕ Fin q) := fun c => G (e.symm c)
  have ha' : ∀ i, (a i).val = (∑ j, x j) + 1 + i.val := fun _ => rfl
  have hb : ∀ j, (b j).val = (∑ i, t i) + (k + 1) + j.val := fun _ => rfl
  have hF : ∀ c, Function.Involutive (F c) := fun c => hG (e.symm c)
  have hFne : ∀ c v, F c v ≠ v := fun c => hGne (e.symm c)
  have hFC : ∀ u v, ((∃ i, Inside (a i) u v) ∨ (∃ j, Cross (b j) u v)) ↔
      ∃ c, F c u = v := by
    intro u v
    rw [hGC]
    constructor
    · rintro ⟨c, hc⟩
      exact ⟨e c, by simpa only [F, Equiv.symm_apply_apply] using hc⟩
    · rintro ⟨c, hc⟩
      exact ⟨e.symm c, hc⟩
  let K := fun i => P14OddLayerBlockBiclique.Edge (Side q) (label q)
    (1 + prefixSum (lengths x) i) (lengths x i)
    (((k + 1 : ℕ) : ZMod q) + (prefixSum (lengths t) i : ZMod q)) (lengths t i)
  have hK : ∀ i, i < p →
      (∀ {u v}, K i u v → K i v u) ∧ (∀ u, ¬ K i u u) ∧
      BicliqueBound (K i) (Finset.range (2 * q))
        (2 * lengths x i + lengths t i + 1) := by
    intro i hi
    have hend := P14CyclicArcPartition.prefix_end (lengths x) hi
    rw [prefix_lengths] at hend
    have hxi : lengths x i = x ⟨i, hi⟩ := by simp [lengths, hi]
    have hti : lengths t i = t ⟨i, hi⟩ := by simp [lengths, hi]
    have hp := hpart ⟨i, hi⟩
    have htmax : t ⟨i, hi⟩ ≤ ∑ j, t j :=
      Finset.single_le_sum (fun j _ => Nat.zero_le (t j)) (Finset.mem_univ _)
    have hstart : 1 ≤ 1 + prefixSum (lengths x) i := by omega
    have hlimit : 2 * (1 + prefixSum (lengths x) i + lengths x i) ≤ q + 1 := by omega
    have htq : lengths t i < q := by omega
    refine ⟨P14OddLayerBlockBiclique.edge_symmetric (Side q) (label q) _ _ _ _,
      P14OddLayerBlockBiclique.edge_irreflexive (Side q) (label q) _ _ _ _ hstart hlimit, ?_⟩
    by_cases hne : 2 * lengths x i ≠ lengths t i
    · exact P14OddLayerBlockBiclique.bound (Side q) (Finset.range (2 * q))
        (label q) labels_injective ho _ _ _ _ hstart hlimit htq hne
    · have hx1 : lengths x i = 1 := by omega
      have ht2 : lengths t i = 2 := by omega
      have hbal : 2 * (1 + prefixSum (lengths x) i) + 2 ≤ q := by omega
      simpa only [K, hx1, ht2] using
        P14BalancedFiveBlock.bound (Side q) (Finset.range (2 * q)) (label q)
          labels_injective ho (1 + prefixSum (lengths x) i)
          (((k + 1 : ℕ) : ZMod q) + (prefixSum (lengths t) i : ZMod q)) hstart hbal
  have hKC (u v : ℕ) :
      P14OddLayerBlockBiclique.Edge (Side q) (label q) 1 (∑ i, x i) ((k + 1 : ℕ) : ZMod q) (∑ i, t i) u v ↔
        ∃ i, i < p ∧ K i u v := by
    simpa only [prefix_lengths] using P14OddAnnulusBlocks.edge_cover
      (Side q) (label q) (lengths x) (lengths t) p 1 ((k + 1 : ℕ) : ZMod q) u v
  refine ⟨fun i => K i.val, F, ?_, hF, hFne, ?_⟩
  · intro i
    have hk := hK i.val i.isLt
    refine ⟨hk.1, hk.2.1, ?_⟩
    have hbound := hk.2.2
    rw [lengths_fin, lengths_fin, (hpart i).1] at hbound
    exact hbound
  · intro u v huv
    rcases P14LargePartnerComplementSplit.cover hq ho a b hN hB ha' hb u v huv with
      he | habs | hord | hinside | hcross
    · exact Or.inl he
    · exact Or.inr (Or.inl habs)
    · obtain ⟨i, hi, hedge⟩ := (hKC (encode u) (encode v)).mp hord
      exact Or.inr (Or.inr (Or.inl ⟨⟨i, hi⟩, hedge⟩))
    · exact Or.inr (Or.inr (Or.inr ((hFC u v).mp (Or.inl hinside))))
    · exact Or.inr (Or.inr (Or.inr ((hFC u v).mp (Or.inr hcross))))

theorem construct {q p m k : ℕ} [NeZero q] (hq : 7 ≤ q) (ho : Odd q)
    (r : Fin p → ℕ) (hr : ∀ i, 2 ≤ r i)
    (htotal : (∑ i, r i) + m + k = 2 * q - 6)
    (hroom : 2 * k ≤ q + 3 ∨ ∃ i, k + 2 ≤ r i) :
    ∃ H : Fin p → ℕ → ℕ → Prop,
      ∃ F : Fin m → (Fin q ⊕ Fin q) → (Fin q ⊕ Fin q),
      (∀ i, (∀ {u v}, H i u v → H i v u) ∧ (∀ u, ¬ H i u u) ∧
        BicliqueBound (H i) (Finset.range (2 * q)) (r i + 1)) ∧
      (∀ c, Function.Involutive (F c)) ∧ (∀ c u, F c u ≠ u) ∧
      (∀ u v, u ≠ v → P14DoubleConeSplit.E hq u v ∨ P14LargePartnerAbsorb.H q k (encode u) (encode v) ∨
        (∃ i, H i (encode u) (encode v)) ∨ (∃ c, F c u = v)) := by
  classical
  rcases P14AllPartnerAllocation.construct Finset.univ r q m k hq ho
    (fun i _ => hr i) htotal (by
      rcases hroom with h | ⟨i, hi⟩
      · exact Or.inl h
      · exact Or.inr ⟨i, Finset.mem_univ i, hi⟩) with halloc | hmid
  · obtain ⟨x, t, N, B, hp, hN, hB, hNB, hm⟩ := halloc
    exact of_allocation hq ho r x t N B (fun i => hp i (Finset.mem_univ i)) hN hB hNB hm
  · obtain ⟨i, hs, hri, hkm⟩ := hmid
    have hp : p = 1 := by
      have hc := congrArg Finset.card hs
      simpa only [Finset.card_univ, Fintype.card_fin, Finset.card_singleton] using hc
    subst p
    have he : r = (fun _ : Fin 1 => 4 * ((q - 5) / 2)) := by
      funext j
      have hj : j = i := Subsingleton.elim _ _
      simpa only [hj] using hri
    simpa only [he] using P14MidpointPartnerGraphCover.construct hq ho hkm

end P14AllPartnerGraphCover

end
end

section

/-! Actual common-row graph cover for ququart endpoint absorption.
The complete allocation and balanced singleton use existing explicit
prism matchings; offset one transfers to the exceptional graph. -/
noncomputable section
namespace P14QuquartPartnerGraphCover
open P14OddLayerLabels P14BicliqueComplementConnection
open scoped BigOperators

theorem old_cover {q p m k : ℕ} [NeZero q] (hq : 7 ≤ q) (ho : Odd q)
    (r : Fin p → ℕ) (hr : ∀ i, 2 ≤ r i)
    (htotal : (∑ i, r i) + m + k = 2 * q - 7)
    (hroom : 2 * k ≤ q + 1 ∨ ∃ i, k + 2 ≤ r i) :
    ∃ H : Fin p → ℕ → ℕ → Prop,
      ∃ F : Fin m → (Fin q ⊕ Fin q) → (Fin q ⊕ Fin q),
      (∀ i, (∀ {u v}, H i u v → H i v u) ∧ (∀ u, ¬ H i u u) ∧
        BicliqueBound (H i) (Finset.range (2 * q)) (r i + 1)) ∧
      (∀ c, Function.Involutive (F c)) ∧ (∀ c u, F c u ≠ u) ∧
      (∀ u v, u ≠ v → P14DoubleConeSplit.E hq u v ∨ P14LargePartnerAbsorb.H q (k + 1) (encode u) (encode v) ∨
        (∃ i, H i (encode u) (encode v)) ∨ (∃ c, F c u = v)) := by
  classical
  rcases P14QuquartPartnerAllocation.construct Finset.univ r q m k hq ho
    (fun i _ => hr i) htotal (by
      rcases hroom with h | ⟨i, hi⟩
      · exact Or.inl h
      · exact Or.inr ⟨i, Finset.mem_univ i, hi⟩) with halloc | hmid
  · obtain ⟨x, t, N, B, hp, hN, hB, hNB, hm⟩ := halloc
    exact P14AllPartnerGraphCover.of_allocation hq ho r x t N B (fun i => hp i (Finset.mem_univ i)) hN hB hNB hm
  · obtain ⟨i, hs, hri, hkm⟩ := hmid
    have hp : p = 1 := by
      have hc := congrArg Finset.card hs
      simpa only [Finset.card_univ, Fintype.card_fin, Finset.card_singleton] using hc
    subst p
    have he : r = (fun _ : Fin 1 => 4 * ((q - 5) / 2)) := by
      funext j
      have hj : j = i := Subsingleton.elim _ _
      simpa only [hj] using hri
    simpa only [he] using P14MidpointPartnerGraphCover.construct (k := k + 1) hq ho (by omega : m + (k + 1) = 4)

theorem construct {q p m k : ℕ} [NeZero q] (hq : 7 ≤ q) (ho : Odd q)
    (r : Fin p → ℕ) (hr : ∀ i, 2 ≤ r i)
    (htotal : (∑ i, r i) + m + k = 2 * q - 7)
    (hroom : 2 * k ≤ q + 1 ∨ ∃ i, k + 2 ≤ r i) :
    ∃ H : Fin p → ℕ → ℕ → Prop,
      ∃ F : Fin m → (Fin q ⊕ Fin q) → (Fin q ⊕ Fin q),
      (∀ i, (∀ {u v}, H i u v → H i v u) ∧ (∀ u, ¬ H i u u) ∧
        BicliqueBound (H i) (Finset.range (2 * q)) (r i + 1)) ∧
      (∀ c, Function.Involutive (F c)) ∧ (∀ c u, F c u ≠ u) ∧
      (∀ u v, u ≠ v → P14QuquartGraphCover.E hq u v ∨
        P14QuquartPartnerAbsorb.H q k (encode u) (encode v) ∨
        (∃ i, H i (encode u) (encode v)) ∨ (∃ c, F c u = v)) := by
  obtain ⟨H, F, hH, hF, hFne, hcover⟩ := old_cover hq ho r hr htotal hroom
  refine ⟨H, F, hH, hF, hFne, ?_⟩
  intro u v huv
  rcases hcover u v huv with he | ha | hi | hf
  · exact Or.inl (P14QuquartPartnerAbsorb.old_exceptional hq u v he)
  · rcases P14QuquartPartnerAbsorb.split hq k u v ha with he | ha
    · exact Or.inl he
    · exact Or.inr (Or.inl ha)
  · exact Or.inr (Or.inr (Or.inl hi))
  · exact Or.inr (Or.inr (Or.inr hf))

end P14QuquartPartnerGraphCover
end
end

section

/-! The finite killing budget in literal complex coordinates, allowing a
direct cap for the exceptional factor alongside spanning-derived caps. -/

noncomputable section
namespace P14ComplexKillingBudget
open P14UPBAssembly
open scoped BigOperators

private lemma pair_eq_inner {k : ℕ} (x y : Space k) :
    (∑ r, star (x r) * y r) = inner ℂ x y := by
  simp only [PiLp.inner_apply, RCLike.inner_apply]
  apply Finset.sum_congr rfl
  intro r _
  exact mul_comm _ _

theorem of_spanning {V : Type*} [Fintype V] [DecidableEq V] {k c : ℕ}
    (x : V → Fin k → ℂ)
    (hs : ∀ S : Finset V, S.card = c + 1 →
      Submodule.span ℂ (Set.range (fun i : S => x i)) = ⊤)
    (a : Fin k → ℂ) (ha : a ≠ 0) (S : Finset V)
    (hS : ∀ i ∈ S, (∑ r, star (x i r) * a r) = 0) : S.card ≤ c := by
  let C : (Fin k → ℂ) ≃ₗ[ℂ] Space k := (WithLp.linearEquiv 2 ℂ (Fin k → ℂ)).symm
  have hs' : SpansEvery (fun i => C (x i)) (c + 1) := by
    intro T hT
    have hm := congrArg (Submodule.map C.toLinearMap) (hs T hT)
    simpa [Submodule.map_span, ← Set.range_comp, Function.comp_def,
      Submodule.map_top, LinearMap.range_eq_top.mpr C.surjective] using hm
  apply P14UPBAssembly.killing_bound (fun i => C (x i)) hs' (C a)
    (fun hz => ha (C.map_eq_zero_iff.mp hz)) S
  intro i hi
  rw [← pair_eq_inner]
  exact hS i hi

theorem survivor {V J : Type*} [Fintype V] [DecidableEq V] [Fintype J]
    (d c : J → ℕ) (x : V → (j : J) → Fin (d j) → ℂ)
    (hbudget : (∑ j, c j) < Fintype.card V)
    (hkill : ∀ j (a : Fin (d j) → ℂ), a ≠ 0 →
      ∀ S : Finset V, (∀ i ∈ S, (∑ r, star (x i j r) * a r) = 0) → S.card ≤ c j) :
    ∀ a : (j : J) → Fin (d j) → ℂ, (∀ j, a j ≠ 0) →
      ∃ i, ∀ j, (∑ r, star (x i j r) * a j r) ≠ 0 := by
  classical
  intro a ha
  by_contra hsurvivor
  push Not at hsurvivor
  choose f hf using hsurvivor
  let S : J → Finset V := fun j => Finset.univ.filter (fun i => f i = j)
  have hScap : ∀ j, (S j).card ≤ c j := by
    intro j
    apply hkill j (a j) (ha j)
    intro i hi
    have hfi : f i = j := (Finset.mem_filter.mp hi).2
    rw [← hfi]
    exact hf i
  have hcard : Fintype.card V = ∑ j, (S j).card := by
    have hc := Finset.card_eq_sum_card_fiberwise (f := f)
      (s := (Finset.univ : Finset V)) (t := (Finset.univ : Finset J))
      (fun _ _ => Finset.mem_univ _)
    simpa [S] using hc
  have hle : Fintype.card V ≤ ∑ j, c j := by
    rw [hcard]
    exact Finset.sum_le_sum (fun j _ => hScap j)
  omega

end P14ComplexKillingBudget


end
end

section

/-! Actual canonical complex UPBs with a qutrit and a larger partner, arbitrary additional non-qubit dimensions and qubits. The absorber and complete common-label cover are fully proved. -/

noncomputable section
namespace P14LargePartnerUPB
open P14ComplexLocalCover P14OddLayerLabels P14CanonicalUPBTransport
open scoped BigOperators

def dimensions {p : ℕ} (r : Fin p → ℕ) (m k : ℕ) : Fin (p + m + 2) → ℕ :=
  Fin.cons 3 (Fin.cons (k + 3) (Fin.append (fun i => r i + 1) (fun _ : Fin m => 2)))

def caps {p : ℕ} (r : Fin p → ℕ) (m k : ℕ) : Fin (p + m + 2) → ℕ :=
  Fin.cons 3 (Fin.cons (k + 2) (Fin.append r (fun _ : Fin m => 1)))

theorem sum_caps {p : ℕ} (r : Fin p → ℕ) (m k : ℕ) :
    (∑ j, caps r m k j) = (k + 5) + (∑ i, r i) + m := by
  simp [caps, Fin.sum_univ_succ, Fin.sum_univ_add, ← Nat.add_assoc] <;> omega

theorem sum_deficits {p : ℕ} (r : Fin p → ℕ) (m k : ℕ) :
    (∑ j, (dimensions r m k j - 1)) = (k + 4) + (∑ i, r i) + m := by
  simp [dimensions, Fin.sum_univ_succ, Fin.sum_univ_add, ← Nat.add_assoc] <;> omega

theorem canonical {q p m k : ℕ} [NeZero q] (hq : 7 ≤ q) (ho : Odd q)
    (hk : 5 ≤ k)
    (r : Fin p → ℕ) (hr : ∀ i, 2 ≤ r i)
    (htotal : (∑ i, r i) + m + k = 2 * q - 6)
    (hroom : 2 * k ≤ q + 3 ∨ ∃ i, k + 2 ≤ r i) :
    Conclusion (p + m + 2) (dimensions r m k) := by
  classical
  have hkq := (P14PartnerCapacityAllocation.room_bounds Finset.univ r q m k hq ho
    (fun i _ => hr i) htotal (by
      rcases hroom with h | ⟨i, hi⟩
      · exact Or.inl h
      · exact Or.inr ⟨i, Finset.mem_univ i, hi⟩)).1
  obtain ⟨H, F, hH, hF, hFne, hcover⟩ :=
    P14LargePartnerGraphCover.construct hq ho hk r hr htotal hroom
  clear hroom
  let R : Fin (p + m + 1) → (Fin q ⊕ Fin q) → (Fin q ⊕ Fin q) → Prop :=
    Fin.cons (fun u v => P14LargePartnerAbsorb.H q k (encode u) (encode v))
      (Fin.append (fun i u v => H i (encode u) (encode v)) (fun c u v => F c u = v))
  let d : Fin (p + m + 1) → ℕ :=
    Fin.cons (k + 3) (Fin.append (fun i => r i + 1) (fun _ : Fin m => 2))
  let c : Fin (p + m + 1) → ℕ := Fin.cons (k + 2) (Fin.append r (fun _ : Fin m => 1))
  have habs : HasLocalFactor (Fin q ⊕ Fin q) (k + 3) (k + 2) (R 0) := by
    obtain ⟨x, hnz, hpair, hspan⟩ := P14GenericExceptionalUPB.complex_rows
      (P14LargePartnerAbsorb.H q k) (P14LargePartnerAbsorb.symmetric k)
      (P14LargePartnerAbsorb.irreflexive hq ho k) (k + 3) (2 * q) (by omega)
      (P14LargePartnerAbsorb.bound hq ho k (by omega) hkq)
    have hx : HasLocalFactor (Fin (2 * q)) (k + 3) (k + 2)
        (fun u v => P14LargePartnerAbsorb.H q k u.val v.val) := ⟨x, hnz, hspan, hpair⟩
    exact reindex (rowEquiv q) hx
  have hord : ∀ i, HasLocalFactor (Fin q ⊕ Fin q) (r i + 1) (r i)
      (fun u v => H i (encode u) (encode v)) := by
    intro i
    obtain ⟨x, hnz, hpair, hspan⟩ := P14GenericExceptionalUPB.complex_rows
      (H i) (hH i).1 (hH i).2.1 (r i + 1) (2 * q) (by omega) (hH i).2.2
    have hx : HasLocalFactor (Fin (2 * q)) (r i + 1) (r i)
        (fun u v => H i u.val v.val) := ⟨x, hnz, hspan, hpair⟩
    exact reindex (rowEquiv q) hx
  have hlocal : ∀ j, HasLocalFactor (Fin q ⊕ Fin q) (d j) (c j) (R j) := by
    intro j
    refine Fin.cases habs (fun j => ?_) j
    refine Fin.addCases (fun i => ?_) (fun k => ?_) j
    · simpa only [d, c, R, Fin.cons_succ, Fin.append_left] using hord i
    · simpa only [d, c, R, Fin.cons_succ, Fin.append_right] using
        P14MatchingLocalFactor.on_finite (F k) (hF k) (hFne k)
  choose y hynz hyspan hypair using hlocal
  let w : (Fin q ⊕ Fin q) → (j : Fin (p + m + 2)) → Fin (dimensions r m k j) → ℂ :=
    fun u => Fin.cases (P14DoubleConeQutrit.row q u) (fun j => y j u)
  have hw : ∀ u j, w u j ≠ 0 := by
    intro u j
    refine Fin.cases ?_ (fun j => hynz j u) j
    exact P14DoubleConeQutrit.row_ne_zero hq u
  have hpair : ∀ u v : Fin q ⊕ Fin q, u ≠ v →
      ∃ j, (∑ k, star (w u j k) * w v j k) = 0 := by
    intro u v huv
    rcases hcover u v huv with he | ha | ⟨i, hi⟩ | ⟨k, hk⟩
    · exact ⟨0, P14DoubleConeSplit.orthogonal hq ho u v he⟩
    · exact ⟨(0 : Fin (p + m + 1)).succ, hypair 0 u v ha⟩
    · refine ⟨(Fin.castAdd m i).succ.succ, hypair (Fin.castAdd m i).succ u v ?_⟩
      simpa only [R, Fin.cons_succ, Fin.append_left] using hi
    · refine ⟨(Fin.natAdd p k).succ.succ, hypair (Fin.natAdd p k).succ u v ?_⟩
      simpa only [R, Fin.cons_succ, Fin.append_right] using hk
  have hcard : Fintype.card (Fin q ⊕ Fin q) = 2 * q := by simp [two_mul]
  have hbudget : (∑ j, caps r m k j) < Fintype.card (Fin q ⊕ Fin q) := by
    rw [sum_caps, hcard]
    omega
  have hkill : ∀ j (a : Fin (dimensions r m k j) → ℂ), a ≠ 0 →
      ∀ S : Finset (Fin q ⊕ Fin q),
        (∀ u ∈ S, (∑ k, star (w u j k) * a k) = 0) → S.card ≤ caps r m k j := by
    intro j
    refine Fin.cases ?_ (fun j => ?_) j
    · intro a ha S hS
      exact P14DoubleConeQutrit.killing_bound hq a ha S hS
    · intro a ha S hS
      exact P14ComplexKillingBudget.of_spanning (y j) (hyspan j) a ha S hS
  let e := (rowEquiv q).symm
  refine ⟨2 * q, ?_, fun i => w (e i), ?_, ?_, ?_⟩
  · rw [sum_deficits]
    omega
  · intro i j
    exact hw (e i) j
  · intro i j hij
    exact hpair (e i) (e j) (e.injective.ne hij)
  · intro a ha
    obtain ⟨u, hu⟩ := P14ComplexKillingBudget.survivor (dimensions r m k) (caps r m k)
      w hbudget hkill a ha
    refine ⟨rowEquiv q u, ?_⟩
    simpa only [e, Equiv.symm_apply_apply] using hu

theorem of_dimensions {q p m n k : ℕ} [NeZero q] (hq : 7 ≤ q) (ho : Odd q)
    (hk : 5 ≤ k)
    (r : Fin p → ℕ) (hr : ∀ i, 2 ≤ r i)
    (htotal : (∑ i, r i) + m + k = 2 * q - 6)
    (hroom : 2 * k ≤ q + 3 ∨ ∃ i, k + 2 ≤ r i)
    (d : Fin n → ℕ) (e : Fin n ≃ Fin (p + m + 2))
    (he : ∀ j, d j = dimensions r m k (e j)) : Conclusion n d :=
  P14CanonicalUPBTransport.of_dimensions (dimensions r m k) d e he
    (canonical hq ho hk r hr htotal hroom)

end P14LargePartnerUPB

end
end

