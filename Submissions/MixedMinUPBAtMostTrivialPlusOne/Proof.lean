/-! Complementary supported real kernels span the intersection of the two
complex constraint hyperplanes when each support has a common conjugation
phase. The actual real witnesses retain the original total constraint. -/

noncomputable section
open scoped BigOperators
namespace P14SplitKernelSpan
open P14PhaseKernelSpan

variable {ι : Type*} [Fintype ι]

def mask (p : ι → Prop) (a : ι → ℂ) : ι → ℂ :=
  fun i => by classical exact if p i then a i else 0

def Witness (a : ι → ℂ) (p : ι → Prop) :=
  {t : ι → ℝ // P14RealKernelCircuits.constraint a t=0 ∧ ∀ i, ¬ p i → t i=0}

def row (a : ι → ℂ) (p : ι → Prop) (t : Witness a p) : ι → ℂ :=
  fun i => (t.val i : ℂ)

def space (a : ι → ℂ) (p : ι → Prop) : Submodule ℂ (ι → ℂ) :=
  LinearMap.ker (cmap (mask p a)) ⊓ LinearMap.ker (cmap (mask (fun i => ¬ p i) a))

theorem cmap_mask (a h : ι → ℂ) (p : ι → Prop) :
    cmap a (mask p h)=cmap (mask p a) h := by
  classical
  simp only [cmap_apply]
  apply Finset.sum_congr rfl
  intro i _
  by_cases hi : p i <;> simp [mask,hi]

theorem supported_cmap (a h : ι → ℂ) (p : ι → Prop)
    (hs : ∀ i, ¬ p i → h i=0) :
    cmap a h=cmap (mask p a) h := by
  classical
  simp only [cmap_apply]
  apply Finset.sum_congr rfl
  intro i _
  by_cases hi : p i <;> simp [mask,hi,hs i]

theorem supported_real_constraint (a : ι → ℂ) (p : ι → Prop) (t : ι → ℝ)
    (hs : ∀ i, ¬ p i → t i=0) :
    P14RealKernelCircuits.constraint a t=
      P14RealKernelCircuits.constraint (mask p a) t := by
  simp only [P14RealKernelCircuits.constraint_apply]
  simpa only [cmap_apply] using (supported_cmap a (fun i => (t i : ℂ)) p
    (fun i hi => by rw [hs i hi]; rfl))

theorem real_mem_space (a : ι → ℂ) (p : ι → Prop) (t : Witness a p) :
    row a p t ∈ space a p := by
  classical
  constructor
  · apply LinearMap.mem_ker.mpr
    rw [←supported_cmap a (row a p t) p
      (fun i hi => by simp only [row,t.property.2 i hi,Complex.ofReal_zero]),cmap_apply]
    exact (P14RealKernelCircuits.constraint_apply a t.val).symm.trans t.property.1
  · apply LinearMap.mem_ker.mpr
    rw [cmap_apply]
    apply Finset.sum_eq_zero
    intro i _
    by_cases hi : p i
    · simp [mask,hi]
    · simp [row,t.property.2 i hi,mask,hi]

theorem space_compl (a : ι → ℂ) (p : ι → Prop) :
    space a (fun i => ¬ p i)=space a p := by
  classical
  simp only [space,mask,not_not]
  exact inf_comm _ _

theorem supported_mem_span (a h : ι → ℂ) (p : ι → Prop) (c : ℂ) (hc : c ≠ 0)
    (hphase : ∀ i, p i → star (a i)=c*a i)
    (hh : cmap a h=0) (hs : ∀ i, ¬ p i → h i=0) :
    h ∈ Submodule.span ℂ (Set.range (row a p)) := by
  classical
  have hp : ∀ i, star (mask p a i)=c*mask p a i := by
    intro i
    by_cases hi : p i <;> simp [mask,hi,hphase i]
  have hz : cmap (mask p a) h=0 := (supported_cmap a h p hs).symm.trans hh
  obtain ⟨hr,hi⟩ := P14PhaseKernelSpan.parts (mask p a) h c hc hp hz
  have hsr (i) (hi : ¬ p i) : (h i).re=0 := by rw [hs i hi]; rfl
  have hsi (i) (hi : ¬ p i) : (h i).im=0 := by rw [hs i hi]; rfl
  let tr : Witness a p := ⟨fun i => (h i).re,
    (supported_real_constraint a p _ hsr).trans hr,hsr⟩
  let ti : Witness a p := ⟨fun i => (h i).im,
    (supported_real_constraint a p _ hsi).trans hi,hsi⟩
  have he : h=row a p tr+Complex.I • row a p ti := by
    funext i
    simpa only [row,tr,ti,Pi.add_apply,Pi.smul_apply,smul_eq_mul,mul_comm] using
      (Complex.re_add_im (h i)).symm
  rw [he]
  exact Submodule.add_mem _ (Submodule.subset_span ⟨tr,rfl⟩)
    (Submodule.smul_mem _ _ (Submodule.subset_span ⟨ti,rfl⟩))

theorem span_union (a : ι → ℂ) (p : ι → Prop) (c d : ℂ) (hc : c ≠ 0) (hd : d ≠ 0)
    (he : ∀ i, p i → star (a i)=c*a i)
    (ho : ∀ i, ¬ p i → star (a i)=d*a i) :
    Submodule.span ℂ (Set.range (row a p) ∪ Set.range (row a (fun i => ¬ p i))) =
      space a p := by
  classical
  apply le_antisymm
  · apply Submodule.span_le.mpr
    rintro _ (⟨t,rfl⟩ | ⟨t,rfl⟩)
    · exact real_mem_space a p t
    · change row a (fun i => ¬ p i) t ∈ space a p
      rw [←space_compl a p]
      exact real_mem_space a (fun i => ¬ p i) t
  · intro h hh
    have hE : mask p h ∈ Submodule.span ℂ (Set.range (row a p)) := by
      apply supported_mem_span a _ p c hc he
      · rw [cmap_mask]
        exact LinearMap.mem_ker.mp hh.1
      · intro i hi
        simp [mask,hi]
    have hO : mask (fun i => ¬ p i) h ∈
        Submodule.span ℂ (Set.range (row a (fun i => ¬ p i))) := by
      apply supported_mem_span a _ (fun i => ¬ p i) d hd ho
      · rw [cmap_mask]
        exact LinearMap.mem_ker.mp hh.2
      · intro i hi
        simp [mask,hi]
    have heq : h=mask p h+mask (fun i => ¬ p i) h := by
      funext i
      by_cases hi : p i <;> simp [mask,hi]
    rw [heq]
    apply Submodule.add_mem
    · exact (Submodule.span_mono Set.subset_union_left) hE
    · exact (Submodule.span_mono Set.subset_union_right) hO

end P14SplitKernelSpan
end
end

section

/-! Two complex scalar constraints leave at least card(ι)-2 dimensions.
This lower bound needs no independence assumption on the constraints. -/

noncomputable section
namespace P14SplitKernelDimension
open P14PhaseKernelSpan P14SplitKernelSpan

def joint {ι : Type*} [Fintype ι] (a : ι → ℂ) (p : ι → Prop) :
    (ι → ℂ) →ₗ[ℂ] ℂ × ℂ :=
  (cmap (mask p a)).prod (cmap (mask (fun i => ¬ p i) a))

theorem kernel_joint {ι : Type*} [Fintype ι] (a : ι → ℂ) (p : ι → Prop) :
    LinearMap.ker (joint a p)=space a p := by
  exact LinearMap.ker_prod _ _

theorem finrank_lower {ι : Type*} [Fintype ι] (a : ι → ℂ) (p : ι → Prop) :
    Fintype.card ι-2 ≤ Module.finrank ℂ (space a p) := by
  have h := (joint a p).finrank_range_add_finrank_ker
  have hb := (LinearMap.range (joint a p)).finrank_le
  rw [kernel_joint,Module.finrank_pi] at h
  have hh : Module.finrank ℂ (ℂ × ℂ)=2 := by simp
  rw [hh] at hb
  omega

end P14SplitKernelDimension

end
end

section

/-! Three coefficient directions suffice for a real full-support kernel
vector. Conjugate ratios certify distinct real directions algebraically. -/

noncomputable section
open scoped BigOperators
namespace P14RealKernelThree
open P14RealKernelCircuits

theorem area_zero_iff (a b : ℂ) :
    area a b=0 ↔ a*star b=star a*b := by
  constructor
  · intro h
    apply Complex.ext <;>
      simp only [Complex.mul_re,Complex.mul_im,Complex.star_def,Complex.conj_re,Complex.conj_im]
    · ring
    · dsimp [area] at h
      linarith
  · intro h
    have hi := congrArg Complex.im h
    simp only [Complex.mul_im,Complex.star_def,Complex.conj_re,Complex.conj_im] at hi
    dsimp [area]
    linarith

theorem area_ne_of_ratios (a b c s t : ℂ) (ha : a ≠ 0) (hb : b ≠ 0) (hc : c ≠ 0)
    (hsa : star a=c*s*a) (hsb : star b=c*t*b) (hst : s ≠ t) :
    area a b ≠ 0 := by
  intro h
  have he := (area_zero_iff a b).mp h
  rw [hsa,hsb] at he
  have hz : c*a*b*(s-t)=0 := by linear_combination -he
  have hn : c*a*b ≠ 0 := mul_ne_zero (mul_ne_zero hc ha) hb
  exact hst (sub_eq_zero.mp ((mul_eq_zero.mp hz).resolve_left hn))

theorem exists_of_three {ι : Type*} [Fintype ι] (a : ι → ℂ)
    (i j k : ι) (hij : i ≠ j) (hik : i ≠ k) (hjk : j ≠ k)
    (haij : area (a i) (a j) ≠ 0) (haik : area (a i) (a k) ≠ 0)
    (hajk : area (a j) (a k) ≠ 0) :
    ∃ t : ι → ℝ, (∑ x, (t x : ℂ)*a x)=0 ∧ ∀ x, t x ≠ 0 := by
  classical
  apply exists_all_nonzero a
  intro x
  by_cases hx : x=i
  · subst x
    exact ⟨j,k,hij,hik,hajk⟩
  · by_cases hy : x=j
    · subst x
      exact ⟨i,k,hij.symm,hjk,haik⟩
    · exact ⟨i,j,hx,hy,haij⟩

theorem exists_of_geometric_ratios {n : ℕ} (hn : 3 ≤ n) (a : Fin n → ℂ)
    (c r : ℂ) (hc : c ≠ 0) (hr : r ≠ 0) (hr1 : r ≠ 1) (hr2 : r^2 ≠ 1)
    (ha : ∀ j, a j ≠ 0)
    (hstar : ∀ j, star (a j)=c*r^j.val*a j) :
    ∃ t : Fin n → ℝ, (∑ j, (t j : ℂ)*a j)=0 ∧ ∀ j, t j ≠ 0 := by
  let i : Fin n := ⟨0,by omega⟩
  let j : Fin n := ⟨1,by omega⟩
  let k : Fin n := ⟨2,by omega⟩
  apply exists_of_three a i j k (by intro h; have := congrArg Fin.val h; dsimp [i,j] at this; omega)
    (by intro h; have := congrArg Fin.val h; dsimp [i,k] at this; omega)
    (by intro h; have := congrArg Fin.val h; dsimp [j,k] at this; omega)
  · apply area_ne_of_ratios (a i) (a j) c (r^i.val) (r^j.val) (ha i) (ha j) hc (hstar i) (hstar j)
    simpa [i,j] using hr1.symm
  · apply area_ne_of_ratios (a i) (a k) c (r^i.val) (r^k.val) (ha i) (ha k) hc (hstar i) (hstar k)
    simpa [i,k] using hr2.symm
  · apply area_ne_of_ratios (a j) (a k) c (r^j.val) (r^k.val) (ha j) (ha k) hc (hstar j) (hstar k)
    change r^1 ≠ r^2
    rw [pow_one]
    intro h
    have he : r*1=r*r := by simpa [pow_two] using h
    exact hr1 (mul_left_cancel₀ hr he).symm

end P14RealKernelThree
end
end

section

/-! Exact conjugation law for barycentric weights at distinct unit-circle
nodes. This identifies the real coefficient directions without numerical
angles or an unproved q-binomial formula. -/

noncomputable section
open scoped BigOperators
namespace P14CircleLagrangeWeights

def weight {n : ℕ} (z : Fin (n+1) → ℂ) (i : Fin (n+1)) : ℂ :=
  ∏ j ∈ Finset.univ.erase i, (z i-z j)⁻¹

theorem weight_ne_zero {n : ℕ} (z : Fin (n+1) → ℂ) (hz : Function.Injective z)
    (i : Fin (n+1)) : weight z i ≠ 0 := by
  apply Finset.prod_ne_zero_iff.mpr
  intro j hj
  apply inv_ne_zero
  apply sub_ne_zero.mpr
  intro he
  exact (Finset.mem_erase.mp hj).1 (hz he).symm

theorem inverse_difference_star (x y : ℂ) (hx : star x*x=1) (hy : star y*y=1)
    (hxy : x ≠ y) : star ((x-y)⁻¹)=-(x*y)*(x-y)⁻¹ := by
  have hxn : x ≠ 0 := by intro h; simp [h] at hx
  have hyn : y ≠ 0 := by intro h; simp [h] at hy
  have hsx : star x=x⁻¹ := eq_inv_of_mul_eq_one_left hx
  have hsy : star y=y⁻¹ := eq_inv_of_mul_eq_one_left hy
  calc
    star ((x-y)⁻¹)=(star (x-y))⁻¹ := map_inv₀ (starRingEnd ℂ) _
    _ = (x⁻¹-y⁻¹)⁻¹ := by rw [star_sub,hsx,hsy]
    _ = -(x*y)*(x-y)⁻¹ := by
      field_simp
      <;> ring

theorem weight_star {n : ℕ} (hn : 1 ≤ n) (z : Fin (n+1) → ℂ)
    (hz : Function.Injective z) (hu : ∀ i, star (z i)*z i=1) (i : Fin (n+1)) :
    star (weight z i)=((-1 : ℂ)^n * ∏ j, z j)*z i^(n-1)*weight z i := by
  have hdiff (j : Fin (n+1)) (hj : j ∈ Finset.univ.erase i) : z i ≠ z j := by
    intro h
    exact (Finset.mem_erase.mp hj).1 (hz h).symm
  have hc : (Finset.univ.erase i).card=n := by simp
  have hp : z i^n=z i^(n-1)*z i := by
    rw [←pow_succ]
    congr 1
    omega
  have hprod : z i*(∏ j ∈ Finset.univ.erase i, z j)=∏ j, z j :=
    Finset.mul_prod_erase Finset.univ z (Finset.mem_univ i)
  calc
    star (weight z i) =
        (∏ j ∈ Finset.univ.erase i, (-z i)*z j)*weight z i := by
      simp only [weight,star_prod,←Finset.prod_mul_distrib]
      apply Finset.prod_congr rfl
      intro j hj
      rw [inverse_difference_star (z i) (z j) (hu i) (hu j) (hdiff j hj)]
      ring
    _ = (-z i)^n*(∏ j ∈ Finset.univ.erase i, z j)*weight z i := by
      rw [Finset.prod_mul_distrib,Finset.prod_const,hc]
    _ = ((-1 : ℂ)^n * ∏ j, z j)*z i^(n-1)*weight z i := by
      rw [neg_eq_neg_one_mul,mul_pow,hp]
      calc
        _ = (-1 : ℂ)^n*(z i^(n-1))*(z i*(∏ j ∈ Finset.univ.erase i,z j))*weight z i := by ring
        _ = _ := by rw [hprod]; ring

end P14CircleLagrangeWeights
end
end

section

/-! Explicit interpolation with the already defined barycentric weights.
The top coefficient is the single complex constraint used by the Fourier
jet construction. All nodes are distinct; no generic interpolation premise
or spectral-factor existence is assumed. -/

noncomputable section
open scoped BigOperators
namespace P14BarycentricInterpolation
open Polynomial P14CircleLagrangeWeights

def nodal {m : ℕ} (z : Fin (m+1) → ℂ) (i : Fin (m+1)) : ℂ[X] :=
  ∏ j ∈ Finset.univ.erase i, (X-C (z j))

def interpolate {m : ℕ} (z v : Fin (m+1) → ℂ) : ℂ[X] :=
  ∑ i, C (v i * weight z i) * nodal z i

theorem nodal_degree {m : ℕ} (z : Fin (m+1) → ℂ) (i : Fin (m+1)) :
    (nodal z i).natDegree=m := by
  classical
  simp [nodal]

theorem nodal_top {m : ℕ} (z : Fin (m+1) → ℂ) (i : Fin (m+1)) :
    (nodal z i).coeff m=1 := by
  classical
  have h := (monic_prod_X_sub_C z (Finset.univ.erase i)).coeff_natDegree
  change (nodal z i).coeff (nodal z i).natDegree=1 at h
  rwa [nodal_degree] at h

theorem nodal_eval_self {m : ℕ} (z : Fin (m+1) → ℂ) (hz : Function.Injective z)
    (i : Fin (m+1)) : weight z i * (nodal z i).eval (z i)=1 := by
  classical
  simp only [weight,nodal,eval_prod,eval_sub,eval_X,eval_C,←Finset.prod_mul_distrib]
  apply Finset.prod_eq_one
  intro j hj
  exact inv_mul_cancel₀ (sub_ne_zero.mpr (fun h => (Finset.mem_erase.mp hj).1 (hz h).symm))

theorem nodal_eval_other {m : ℕ} (z : Fin (m+1) → ℂ) (i j : Fin (m+1))
    (hij : i ≠ j) : (nodal z i).eval (z j)=0 := by
  classical
  simp only [nodal,eval_prod,eval_sub,eval_X,eval_C]
  exact Finset.prod_eq_zero (Finset.mem_erase.mpr ⟨hij.symm,Finset.mem_univ j⟩) (sub_self _)

theorem interpolate_eval {m : ℕ} (z v : Fin (m+1) → ℂ) (hz : Function.Injective z)
    (j : Fin (m+1)) : (interpolate z v).eval (z j)=v j := by
  classical
  simp only [interpolate,eval_finsetSum,eval_mul,eval_C]
  rw [Finset.sum_eq_single j]
  · rw [mul_assoc,nodal_eval_self z hz,mul_one]
  · intro i _ hij
    rw [nodal_eval_other z i j hij,mul_zero]
  · simp

theorem interpolate_degree {m : ℕ} (z v : Fin (m+1) → ℂ) :
    (interpolate z v).natDegree ≤ m := by
  classical
  apply natDegree_sum_le_of_forall_le
  intro i _
  exact (natDegree_C_mul_le _ _).trans (le_of_eq (nodal_degree z i))

theorem interpolate_top {m : ℕ} (z v : Fin (m+1) → ℂ) :
    (interpolate z v).coeff m = ∑ i, v i * weight z i := by
  classical
  simp only [interpolate,finsetSum_coeff,coeff_C_mul,nodal_top,mul_one]

theorem reconstruct {m : ℕ} (z : Fin (m+1) → ℂ) (hz : Function.Injective z)
    (P : ℂ[X]) (hP : P.natDegree ≤ m) : interpolate z (fun i => P.eval (z i))=P := by
  apply eq_of_natDegree_lt_card_of_eval_eq _ _ hz
  · exact interpolate_eval z _ hz
  · simp only [Fintype.card_fin]
    exact lt_of_le_of_lt (max_le (interpolate_degree z _) hP) (Nat.lt_succ_self m)

theorem coefficient_formula {m : ℕ} (z : Fin (m+1) → ℂ) (hz : Function.Injective z)
    (P : ℂ[X]) (hP : P.natDegree ≤ m) : P.coeff m=∑ i, P.eval (z i)*weight z i := by
  rw [←interpolate_top,reconstruct z hz P hP]

theorem moment_zero {m k : ℕ} (z : Fin (m+1) → ℂ) (hz : Function.Injective z)
    (hk : k < m) : (∑ i, weight z i * z i^k)=0 := by
  have h := coefficient_formula z hz (X^k) (by simp; omega)
  simpa [coeff_X_pow,Ne.symm (Nat.ne_of_lt hk),mul_comm] using h.symm

theorem interpolate_lower_degree {m : ℕ} (hm : 1 ≤ m) (z v : Fin (m+1) → ℂ)
    (hv : (∑ i, v i*weight z i)=0) : (interpolate z v).natDegree ≤ m-1 := by
  apply natDegree_le_iff_coeff_eq_zero.mpr
  intro k hk
  by_cases he : k=m
  · subst k
    exact (interpolate_top z v).trans hv
  · exact coeff_eq_zero_of_natDegree_lt ((interpolate_degree z v).trans_lt (by omega))

theorem imaginary_interpolation {m : ℕ} (hm : 1 ≤ m) (z : Fin (m+1) → ℂ)
    (hz : Function.Injective z) (t : Fin (m+1) → ℝ)
    (ht : (∑ i, (t i : ℂ)*weight z i)=0) :
    ∃ B : ℂ[X], B.natDegree ≤ m-1 ∧ ∀ i, B.eval (z i)=Complex.I*(t i : ℂ) := by
  refine ⟨interpolate z (fun i => Complex.I*(t i : ℂ)),?_,interpolate_eval z _ hz⟩
  apply interpolate_lower_degree hm
  simp only [mul_assoc,←Finset.mul_sum,ht,mul_zero]

end P14BarycentricInterpolation
end
end

section

/-! Exact obstruction to a single collision in the cubic spectral jet.
The coefficients are the upper three coefficients of
(z-1)^2 (z-w)(z-w^2)(z-w^3)(z-w^4).
Two annihilator equations cannot both hold at unit base nodes when
the unit shift w has real part strictly between 1/2 and 1. -/

noncomputable section
namespace P14CubicCollisionMoments

def t1 (w : ℂ) : ℂ := 1 + 2*w + 2*w^2 + 3*w^3 + 3*w^4 + 2*w^5 + w^6 + w^7
def t2 (w : ℂ) : ℂ := -2 - w - w^2 - w^3 - w^4
def moment (w : ℂ) (j : ℕ) : ℂ :=
  t1 w * (w-1) * w^j + t2 w * (w^2-1) * w^(2*j) + (w^3-1) * w^(3*j)
def denominator (w : ℂ) : ℂ := 1+w^2+w^3+2*w^4-w^5+2*w^6+w^7+w^8+w^10
def numerator (w : ℂ) : ℂ := 2*w^3+2*w^4+w^5+2*w^6+2*w^7
def factor (w : ℂ) : ℂ := w^2 * (w-1)^4 * (w+1)^2

theorem delta_identity (w : ℂ) :
    moment w 0 * moment w 2 - moment w 1 ^ 2 = -factor w * denominator w := by
  simp only [moment, t1, t2, factor, denominator]
  ring

theorem numerator_identity (w : ℂ) :
    moment w 1 * moment w 3 - moment w 2 ^ 2 = -factor w * numerator w := by
  simp only [moment, t1, t2, factor, numerator]
  ring

theorem denominator_reduction (w x : ℂ) (h : w^2 + 1 = x*w) :
    denominator w = w^5 * (x^5 - 4*x^3 + x^2 + 4*x - 3) := by
  dsimp [denominator]
  linear_combination
    (1 + x*w + x^2*w^2 + (1-x+x^3)*w^3 +
      (2+x-2*x^2+x^4)*w^4 + (1-x+x^3)*w^5 + x^2*w^6 + x*w^7 + w^8) * h

theorem numerator_reduction (w x : ℂ) (h : w^2 + 1 = x*w) :
    numerator w = w^5 * (2*x^2 + 2*x - 3) := by
  dsimp [numerator]
  linear_combination (2*w^3 + (2+2*x)*w^4 + 2*w^5) * h

theorem real_gap (x : ℝ) (hx : 1 < x) (hx2 : x < 2) :
    (x^5 - 4*x^3 + x^2 + 4*x - 3)^2 < (2*x^2 + 2*x - 3)^2 := by
  have ht : 0 < x-1 := sub_pos.mpr hx
  have hC : 0 < 5 + 16*(x-1) + 14*(x-1)^2 + 24*(x-1)^3 +
      22*(x-1)^4 + 8*(x-1)^5 + (x-1)^6 := by positivity
  have hp : 0 < (2-x)*x*(x-1)*(x+1)*
      (5 + 16*(x-1) + 14*(x-1)^2 + 24*(x-1)^3 +
        22*(x-1)^4 + 8*(x-1)^5 + (x-1)^6) := by
    exact mul_pos (mul_pos (mul_pos (mul_pos (sub_pos.mpr hx2) (by linarith)) ht)
      (by linarith)) hC
  have hid : (2*x^2+2*x-3)^2 - (x^5-4*x^3+x^2+4*x-3)^2 =
      (2-x)*x*(x-1)*(x+1)*
      (5 + 16*(x-1) + 14*(x-1)^2 + 24*(x-1)^3 +
        22*(x-1)^4 + 8*(x-1)^5 + (x-1)^6) := by ring
  linarith

theorem norm_gap (w : ℂ) (hu : Complex.normSq w = 1)
    (hr : 1/2 < w.re) (hr1 : w.re < 1) :
    Complex.normSq (denominator w) < Complex.normSq (numerator w) := by
  let x : ℝ := 2*w.re
  have h : w^2 + 1 = (x : ℂ)*w := by
    apply Complex.ext
    · simp only [pow_two, Complex.add_re, Complex.mul_re, Complex.one_re,
        Complex.ofReal_re, Complex.ofReal_im, zero_mul, sub_zero]
      dsimp [x]
      simp only [Complex.normSq_apply] at hu
      nlinarith
    · simp only [pow_two, Complex.add_im, Complex.mul_im, Complex.one_im,
        Complex.ofReal_re, Complex.ofReal_im, zero_mul, add_zero]
      dsimp [x]
      ring
  rw [denominator_reduction w x h, numerator_reduction w x h]
  have hd : (x:ℂ)^5 - 4*(x:ℂ)^3 + (x:ℂ)^2 + 4*(x:ℂ) - 3 =
      ((x^5 - 4*x^3 + x^2 + 4*x - 3 : ℝ) : ℂ) := by push_cast; rfl
  have hn : 2*(x:ℂ)^2 + 2*(x:ℂ) - 3 = ((2*x^2 + 2*x - 3 : ℝ) : ℂ) := by
    push_cast
    rfl
  rw [hd, hn]
  simp only [Complex.normSq_mul, map_pow, hu, one_pow, one_mul, Complex.normSq_ofReal]
  convert real_gap x (by dsimp [x]; linarith) (by dsimp [x]; linarith) using 1 <;> ring

theorem factor_ne_zero (w : ℂ) (hu : Complex.normSq w = 1)
    (hr : 1/2 < w.re) (hr1 : w.re < 1) : factor w ≠ 0 := by
  have hw : w ≠ 0 := by intro h; simp [h] at hu
  have hm : w-1 ≠ 0 := by
    intro h
    have := congrArg Complex.re (sub_eq_zero.mp h)
    simp only [Complex.one_re] at this
    linarith
  have hp : w+1 ≠ 0 := by
    intro h
    have := congrArg Complex.re h
    simp only [Complex.add_re, Complex.one_re, Complex.zero_re] at this
    linarith
  exact mul_ne_zero (mul_ne_zero (pow_ne_zero 2 hw) (pow_ne_zero 4 hm)) (pow_ne_zero 2 hp)

theorem no_unit_pair (w u v : ℂ) (hw : Complex.normSq w = 1)
    (hr : 1/2 < w.re) (hr1 : w.re < 1)
    (hu : Complex.normSq u = 1) (hv : Complex.normSq v = 1) :
    ¬ (moment w 2 - (u+v)*moment w 1 + u*v*moment w 0 = 0 ∧
       moment w 3 - (u+v)*moment w 2 + u*v*moment w 1 = 0) := by
  rintro ⟨h0,h1⟩
  have he : (moment w 1 * moment w 3 - moment w 2 ^ 2) -
      u*v*(moment w 0 * moment w 2 - moment w 1 ^ 2) = 0 := by
    linear_combination moment w 1 * h1 - moment w 2 * h0
  rw [delta_identity, numerator_identity] at he
  have hf : factor w * (numerator w - u*v*denominator w) = 0 := by
    linear_combination -he
  have hn : numerator w = u*v*denominator w :=
    sub_eq_zero.mp ((mul_eq_zero.mp hf).resolve_left (factor_ne_zero w hw hr hr1))
  have hnorm := congrArg Complex.normSq hn
  simp only [Complex.normSq_mul, hu, hv, one_mul] at hnorm
  exact (ne_of_gt (norm_gap w hw hr hr1)) hnorm

end P14CubicCollisionMoments
end
end

section

/-! The two first collision jets are independent modulo their two base rows.
This file proves the decisive nonvanishing of two annihilator minors, using
the exact common real form of four consecutive cubic moments. -/

noncomputable section
namespace P14CubicDoubleCollision
open P14CubicCollisionMoments

def a0 {R : Type*} [Ring R] (x : R) : R := x^2-1
def a1 {R : Type*} [Ring R] (x : R) : R := x^3-x^2-2*x+3
def a2 {R : Type*} [Ring R] (x : R) : R := x^2+x-3
def a3 {R : Type*} [Ring R] (x : R) : R := x+1
def phase (w : ℂ) : ℂ := w^4*(w^2-1)

theorem real_forms (w x : ℂ) (h : w^2+1=x*w) :
    moment w 0 = phase w * a0 x ∧ moment w 1 = phase w * a1 x ∧
    moment w 2 = phase w * a2 x ∧ moment w 3 = phase w * a3 x := by
  refine ⟨?_, ?_, ?_, ?_⟩
  · dsimp [moment, t1, t2, phase, a0]
    linear_combination (-w^2-x*w^3+x*w^5+w^6)*h
  · dsimp [moment, t1, t2, phase, a1]
    linear_combination (-w+(1-x)*w^2+(1+x-x^2)*w^3+
      (-1-x+x^2)*w^5+(-1+x)*w^6+w^7)*h
  · dsimp [moment, t1, t2, phase, a2]
    linear_combination (-w^2+(-1-x)*w^3+(1+x)*w^5+w^6)*h
  · dsimp [moment, t1, t2, phase, a3]
    linear_combination (-w^3+w^5)*h

theorem real_elimination (x : ℝ) (hx : 1 < x) (hx2 : x < 2) :
    0 < a1 x ^ 2 * a3 x * (a0 x + a1 x + a2 x) -
      a0 x * a2 x ^ 2 * (a1 x + a2 x + a3 x) := by
  have ht : 0 < x-1 := sub_pos.mpr hx
  have hs : 0 < (x-2)^2 := sq_pos_of_ne_zero (by linarith)
  have hp : 0 < x*(x-1)*(x+1)^2*(x-2)^2*
      (1+3*(x-1)+10*(x-1)^2+6*(x-1)^3+(x-1)^4) := by
    apply mul_pos
    · exact mul_pos (mul_pos (mul_pos (by linarith) ht) (sq_pos_of_pos (by linarith))) hs
    · positivity
  have he : a1 x ^ 2 * a3 x * (a0 x + a1 x + a2 x) -
      a0 x * a2 x ^ 2 * (a1 x + a2 x + a3 x) =
      x*(x-1)*(x+1)^2*(x-2)^2*
        (1+3*(x-1)+10*(x-1)^2+6*(x-1)^3+(x-1)^4) := by
    dsimp [a0,a1,a2,a3]
    ring
  rw [he]
  exact hp

def first (w y : ℂ) (j : ℕ) : ℂ := moment w (j+1)-y*moment w j
def second (w y : ℂ) (j : ℕ) : ℂ := y^(j+1)*(y*moment w (j+1)-moment w j)
def minor (w y : ℂ) (j : ℕ) : ℂ :=
  first w y j * second w y (j+1) - first w y (j+1) * second w y j

theorem minor_zero (w x y : ℂ) (h : w^2+1=x*w) :
    minor w y 0 = phase w ^ 2 * y * (y-1) *
      (y*a1 x*(a0 x+a1 x+a2 x) - (y^2+y+1)*a0 x*a2 x) := by
  obtain ⟨h0,h1,h2,h3⟩ := real_forms w x h
  simp only [minor, first, second, Nat.reduceAdd, h0, h1, h2]
  ring

theorem minor_one (w x y : ℂ) (h : w^2+1=x*w) :
    minor w y 1 = phase w ^ 2 * y^2 * (y-1) *
      (y*a2 x*(a1 x+a2 x+a3 x) - (y^2+y+1)*a1 x*a3 x) := by
  obtain ⟨h0,h1,h2,h3⟩ := real_forms w x h
  simp only [minor, first, second, Nat.reduceAdd, h1, h2, h3]
  ring

theorem some_minor (w y : ℂ) (x : ℝ) (h : w^2+1=(x:ℂ)*w)
    (hc : phase w ≠ 0) (hy : y ≠ 0) (hy1 : y ≠ 1)
    (hx : 1 < x) (hx2 : x < 2) : minor w y 0 ≠ 0 ∨ minor w y 1 ≠ 0 := by
  by_contra hh
  push Not at hh
  rw [minor_zero w x y h] at hh
  rw [minor_one w x y h] at hh
  have h0 : y*a1 (x:ℂ)*(a0 (x:ℂ)+a1 (x:ℂ)+a2 (x:ℂ)) -
      (y^2+y+1)*a0 (x:ℂ)*a2 (x:ℂ) = 0 :=
    (mul_eq_zero.mp hh.1).resolve_left
      (mul_ne_zero (mul_ne_zero (pow_ne_zero 2 hc) hy) (sub_ne_zero.mpr hy1))
  have h1 : y*a2 (x:ℂ)*(a1 (x:ℂ)+a2 (x:ℂ)+a3 (x:ℂ)) -
      (y^2+y+1)*a1 (x:ℂ)*a3 (x:ℂ) = 0 :=
    (mul_eq_zero.mp hh.2).resolve_left
      (mul_ne_zero (mul_ne_zero (pow_ne_zero 2 hc) (pow_ne_zero 2 hy)) (sub_ne_zero.mpr hy1))
  have he : y * (a1 (x:ℂ)^2*a3 (x:ℂ)*(a0 (x:ℂ)+a1 (x:ℂ)+a2 (x:ℂ)) -
      a0 (x:ℂ)*a2 (x:ℂ)^2*(a1 (x:ℂ)+a2 (x:ℂ)+a3 (x:ℂ))) = 0 := by
    linear_combination a1 (x:ℂ)*a3 (x:ℂ)*h0 - a0 (x:ℂ)*a2 (x:ℂ)*h1
  have hz := (mul_eq_zero.mp he).resolve_left hy
  have hn : a1 (x:ℂ)^2*a3 (x:ℂ)*(a0 (x:ℂ)+a1 (x:ℂ)+a2 (x:ℂ)) -
      a0 (x:ℂ)*a2 (x:ℂ)^2*(a1 (x:ℂ)+a2 (x:ℂ)+a3 (x:ℂ)) ≠ 0 := by
    have hp := ne_of_gt (real_elimination x hx hx2)
    dsimp [a0,a1,a2,a3] at hp ⊢
    exact_mod_cast hp
  exact hn hz

theorem unit_some_minor (w y : ℂ) (hw : Complex.normSq w = 1)
    (hr : 1/2 < w.re) (hr1 : w.re < 1) (hy : y ≠ 0) (hy1 : y ≠ 1) :
    minor w y 0 ≠ 0 ∨ minor w y 1 ≠ 0 := by
  have h : w^2+1 = ((2*w.re:ℝ):ℂ)*w := by
    apply Complex.ext
    · simp only [pow_two, Complex.add_re, Complex.mul_re, Complex.one_re,
        Complex.ofReal_re, Complex.ofReal_im, zero_mul, sub_zero]
      simp only [Complex.normSq_apply] at hw
      nlinarith
    · simp only [pow_two, Complex.add_im, Complex.mul_im, Complex.one_im,
        Complex.ofReal_re, Complex.ofReal_im, zero_mul, add_zero]
      ring
  have hc : phase w ≠ 0 := by
    have hf := factor_ne_zero w hw hr hr1
    have hz : w ≠ 0 := by intro hh; simp [hh] at hw
    have hm : w-1 ≠ 0 := by intro hh; simp [factor, hh] at hf
    have hp : w+1 ≠ 0 := by intro hh; simp [factor, hh] at hf
    have he : w^2-1 = (w-1)*(w+1) := by ring
    exact mul_ne_zero (pow_ne_zero 4 hz) (by rw [he]; exact mul_ne_zero hm hp)
  exact some_minor w y (2*w.re) h hc hy hy1 (by linarith) (by linarith)

end P14CubicDoubleCollision
end
end

section

/-! Actual five-coordinate row independence for both cubic collision patterns.
These are first-order jet rows, not yet the finite-parameter spectral frame. -/

noncomputable section
open scoped BigOperators
namespace P14CubicJetIndependence
open P14CubicCollisionMoments P14CubicDoubleCollision

def row (x : ℂ) : Fin 5 → ℂ := fun k => x^k.val
def jet (w x : ℂ) : Fin 5 → ℂ := fun k =>
  t1 w * (w*x)^k.val + t2 w * (w^2*x)^k.val + (w^3*x)^k.val

theorem single (w u v : ℂ) (hw : Complex.normSq w = 1)
    (hr : 1/2 < w.re) (hr1 : w.re < 1)
    (hu : Complex.normSq u = 1) (hv : Complex.normSq v = 1)
    (hu1 : u ≠ 1) (hv1 : v ≠ 1) (huv : v ≠ u) :
    LinearIndependent ℂ (![row 1, row u, row v, jet w 1]) := by
  rw [Fintype.linearIndependent_iff]
  intro g hg
  have he (k : Fin 5) := congrFun hg k
  simp only [Fin.sum_univ_succ, Fin.isValue, Matrix.cons_val_zero,
    Matrix.cons_val_succ, Matrix.cons_val_fin_one, Pi.add_apply,
    Pi.smul_apply, smul_eq_mul, Pi.zero_apply] at he
  have h0 := he 0
  have h1 := he 1
  have h2 := he 2
  have h3 := he 3
  have h4 := he 4
  have hs : (2 : Fin 3).succ = (3 : Fin 4) := rfl
  norm_num [row, jet, hs] at h0 h1 h2 h3 h4
  have hf0 : g 3 * (moment w 2 - (u+v)*moment w 1 + u*v*moment w 0) = 0 := by
    dsimp [moment]
    linear_combination h3 - (1+u+v)*h2 + (u+v+u*v)*h1 - u*v*h0
  have hf1 : g 3 * (moment w 3 - (u+v)*moment w 2 + u*v*moment w 1) = 0 := by
    dsimp [moment]
    linear_combination h4 - (1+u+v)*h3 + (u+v+u*v)*h2 - u*v*h1
  have hg3 : g 3 = 0 := by
    by_contra hh
    exact no_unit_pair w u v hw hr hr1 hu hv
      ⟨(mul_eq_zero.mp hf0).resolve_left hh, (mul_eq_zero.mp hf1).resolve_left hh⟩
  simp only [hg3, zero_mul, add_zero] at h0 h1 h2
  have hf2 : g 2 * (v-1)*(v-u) = 0 := by
    linear_combination h2 - (1+u)*h1 + u*h0
  have hg2 : g 2 = 0 := by
    have := (mul_eq_zero.mp hf2).resolve_right (sub_ne_zero.mpr huv)
    exact (mul_eq_zero.mp this).resolve_right (sub_ne_zero.mpr hv1)
  simp only [hg2, zero_mul, add_zero] at h0 h1
  have hf3 : g 1 * (u-1) = 0 := by linear_combination h1-h0
  have hg1 : g 1 = 0 := (mul_eq_zero.mp hf3).resolve_right (sub_ne_zero.mpr hu1)
  have hg0 : g 0 = 0 := by simpa [hg1] using h0
  intro i
  fin_cases i <;> assumption

theorem solve_two (a b c d x y : ℂ) (h : a*d-c*b ≠ 0)
    (h0 : x*a+y*b=0) (h1 : x*c+y*d=0) : x=0 ∧ y=0 := by
  have hx : x*(a*d-c*b)=0 := by linear_combination d*h0-b*h1
  have hy : y*(a*d-c*b)=0 := by linear_combination a*h1-c*h0
  exact ⟨(mul_eq_zero.mp hx).resolve_right h, (mul_eq_zero.mp hy).resolve_right h⟩

theorem double (w y : ℂ) (hw : Complex.normSq w = 1)
    (hr : 1/2 < w.re) (hr1 : w.re < 1) (hy : y ≠ 0) (hy1 : y ≠ 1) :
    LinearIndependent ℂ (![row 1, row y, jet w 1, jet w y]) := by
  rw [Fintype.linearIndependent_iff]
  intro g hg
  have he (k : Fin 5) := congrFun hg k
  simp only [Fin.sum_univ_succ, Fin.isValue, Matrix.cons_val_zero,
    Matrix.cons_val_succ, Matrix.cons_val_fin_one, Pi.add_apply,
    Pi.smul_apply, smul_eq_mul, Pi.zero_apply] at he
  have h0 := he 0
  have h1 := he 1
  have h2 := he 2
  have h3 := he 3
  have h4 := he 4
  have hs : (2 : Fin 3).succ = (3 : Fin 4) := rfl
  norm_num [row, jet, hs] at h0 h1 h2 h3 h4
  have hf0 : g 2 * first w y 0 + g 3 * second w y 0 = 0 := by
    dsimp [first, second, moment]
    linear_combination h2-(1+y)*h1+y*h0
  have hf1 : g 2 * first w y 1 + g 3 * second w y 1 = 0 := by
    dsimp [first, second, moment]
    linear_combination h3-(1+y)*h2+y*h1
  have hf2 : g 2 * first w y 2 + g 3 * second w y 2 = 0 := by
    dsimp [first, second, moment]
    linear_combination h4-(1+y)*h3+y*h2
  have hgg : g 2 = 0 ∧ g 3 = 0 := by
    rcases unit_some_minor w y hw hr hr1 hy hy1 with hh | hh
    · exact solve_two _ _ _ _ _ _ hh hf0 hf1
    · exact solve_two _ _ _ _ _ _ hh hf1 hf2
  obtain ⟨hg2,hg3⟩ := hgg
  have hz : g 1*(y-1)=0 := by
    rw [hg2,hg3] at h0 h1
    linear_combination h1-h0
  have hg1 : g 1=0 := (mul_eq_zero.mp hz).resolve_right (sub_ne_zero.mpr hy1)
  have hg0 : g 0=0 := by simpa [hg1,hg2,hg3] using h0
  intro i
  fin_cases i <;> assumption

end P14CubicJetIndependence
end
end

section

/-! Exact elementary row operations and the pure Vandermonde case used
to transfer cubic collision limits to actual spectral rows. -/

noncomputable section
open scoped BigOperators
namespace P14CubicRowOperations
open P14CubicJetIndependence

theorem row_scale {ι κ : Type*} [Fintype ι] (v : ι → κ → ℂ)
    (c : ι → ℂ) (hc : ∀ i, c i ≠ 0) (hv : LinearIndependent ℂ v) :
    LinearIndependent ℂ (fun i => c i • v i) := by
  rw [Fintype.linearIndependent_iff] at hv ⊢
  intro g hg
  have he : ∑ i, (g i*c i) • v i = 0 := by simpa only [mul_smul] using hg
  have hh := hv _ he
  intro i
  exact (mul_eq_zero.mp (hh i)).resolve_right (hc i)

theorem add_row {ι κ : Type*} [Fintype ι] [DecidableEq ι]
    (v : ι → κ → ℂ) (i j : ι) (hij : i ≠ j) (a : ℂ)
    (hv : LinearIndependent ℂ v) :
    LinearIndependent ℂ (fun k => if k=j then v k+a • v i else v k) := by
  let c : ι → ℂ := fun k => if k=j then a else 0
  have hc : c i=0 := if_neg hij
  have h := (linearIndependent_add_smul_iff (v:=v) hc).mpr hv
  convert! h using 1
  funext k
  by_cases hk : k=j <;> simp [c,hk]

theorem replace_row {ι κ : Type*} [Fintype ι] [DecidableEq ι]
    (v : ι → κ → ℂ) (i j : ι) (hij : i ≠ j) (a b : ℂ) (hb : b ≠ 0)
    (hv : LinearIndependent ℂ v) :
    LinearIndependent ℂ (fun k => if k=j then a • v i+b • v j else v k) := by
  let c : ι → ℂ := fun k => if k=j then b else 1
  have hc : ∀ k, c k ≠ 0 := by intro k; dsimp [c]; split_ifs <;> simp_all
  have h := add_row (fun k => c k • v k) i j hij a (row_scale v c hc hv)
  convert! h using 1
  funext k
  by_cases hk : k=j
  · subst k
    simp [c,hij,add_comm]
  · simp [c,hk]

theorem vandermonde_four (X : Fin 4 → ℂ) (hX : Function.Injective X) :
    LinearIndependent ℂ (fun i => row (X i)) := by
  let f : (Fin 5 → ℂ) →ₗ[ℂ] (Fin 4 → ℂ) :=
    { toFun := fun v j => v j.castSucc
      map_add' := fun _ _ => rfl
      map_smul' := fun _ _ => rfl }
  apply LinearIndependent.of_comp f
  change LinearIndependent ℂ (Matrix.vandermonde X).row
  apply Matrix.linearIndependent_rows_of_isUnit
  exact (Matrix.isUnit_iff_isUnit_det _).mpr
    (isUnit_iff_ne_zero.mpr (Matrix.det_vandermonde_ne_zero_iff.mpr hX))

end P14CubicRowOperations
end
end

section

/-!
The actual spectral product on a retained Fourier frequency is nonzero.
Its conjugate and squared norm therefore supply nonzero coefficient data
for the complementary blocks and the matching equation. This is only a
coefficient result; no rank, positive matching point, or seed is asserted.
-/

noncomputable section

namespace P14FourierSpectralWeights

open scoped BigOperators

def spectralWeight (ζ : ℂ) (d q : ℕ) : ℂ :=
  ∏ t : Fin d, (1 - ζ ^ (q - t.val))

variable {ζ : ℂ} {n d q : ℕ}

theorem spectralWeight_ne_zero (hζ : IsPrimitiveRoot ζ n)
    (hdq : d ≤ q) (hqn : q < n) :
    spectralWeight ζ d q ≠ 0 := by
  unfold spectralWeight
  apply Finset.prod_ne_zero_iff.mpr
  intro t _
  have hpositive : 0 < q - t.val :=
    Nat.sub_pos_of_lt (t.isLt.trans_le hdq)
  have hsmall : q - t.val < n := (Nat.sub_le q t.val).trans_lt hqn
  have hpower : ζ ^ (q - t.val) ≠ 1 :=
    hζ.pow_ne_one_of_pos_of_lt (Nat.ne_of_gt hpositive) hsmall
  exact sub_ne_zero.mpr hpower.symm

theorem star_spectralWeight_ne_zero (hζ : IsPrimitiveRoot ζ n)
    (hdq : d ≤ q) (hqn : q < n) :
    star (spectralWeight ζ d q) ≠ 0 := by
  exact star_ne_zero.mpr (spectralWeight_ne_zero hζ hdq hqn)

theorem normSq_spectralWeight_pos (hζ : IsPrimitiveRoot ζ n)
    (hdq : d ≤ q) (hqn : q < n) :
    0 < Complex.normSq (spectralWeight ζ d q) := by
  exact Complex.normSq_pos.mpr (spectralWeight_ne_zero hζ hdq hqn)

theorem ofReal_normSq_spectralWeight_ne_zero (hζ : IsPrimitiveRoot ζ n)
    (hdq : d ≤ q) (hqn : q < n) :
    (Complex.normSq (spectralWeight ζ d q) : ℂ) ≠ 0 := by
  exact Complex.ofReal_ne_zero.mpr
    (ne_of_gt (normSq_spectralWeight_pos hζ hdq hqn))

def fourierRoot (n : ℕ) : ℂ :=
  Complex.exp (2 * (Real.pi : ℂ) * Complex.I / (n : ℂ))

theorem fourierRoot_isPrimitiveRoot (n : ℕ) (hn : 0 < n) :
    IsPrimitiveRoot (fourierRoot n) n := by
  exact Complex.isPrimitiveRoot_exp n (Nat.ne_of_gt hn)

def fourierNormalization (n : ℕ) : ℂ :=
  ((Real.sqrt (n : ℝ) : ℂ))⁻¹

theorem fourierNormalization_ne_zero (n : ℕ) (hn : 0 < n) :
    fourierNormalization n ≠ 0 := by
  unfold fourierNormalization
  exact inv_ne_zero (Complex.ofReal_ne_zero.mpr
    (ne_of_gt (Real.sqrt_pos.mpr (Nat.cast_pos.mpr hn))))


end P14FourierSpectralWeights
end
end

section

/-! The cubic collision ranks hold at the actual primitive Fourier root
of every order q>=7 and at arbitrary nonzero rotations of the base nodes. -/

noncomputable section
open scoped BigOperators
namespace P14CubicFourierJets
open P14CubicJetIndependence P14FourierSpectralWeights

theorem root_arc {q : ℕ} (hq : 7 ≤ q) :
    Complex.normSq (fourierRoot q) = 1 ∧
      1/2 < (fourierRoot q).re ∧ (fourierRoot q).re < 1 := by
  let θ : ℝ := 2*Real.pi/q
  have hqr : (7:ℝ) ≤ q := by exact_mod_cast hq
  have hq0 : (0:ℝ) < q := by linarith
  have ht : 0 < θ := div_pos (mul_pos (by norm_num) Real.pi_pos) hq0
  have ht3 : θ < Real.pi/3 := by
    dsimp [θ]
    apply (div_lt_iff₀ hq0).mpr
    have := mul_le_mul_of_nonneg_left hqr Real.pi_pos.le
    nlinarith [Real.pi_pos]
  have he : fourierRoot q = Complex.exp ((θ:ℂ)*Complex.I) := by
    unfold fourierRoot
    congr 1
    dsimp [θ]
    push_cast
    ring
  rw [he, Complex.exp_ofReal_mul_I_re]
  refine ⟨?_, ?_, ?_⟩
  · rw [Complex.normSq_eq_norm_sq, Complex.norm_exp_ofReal_mul_I]
    norm_num
  · have h := Real.cos_lt_cos_of_nonneg_of_le_pi ht.le
      (show Real.pi/3 ≤ Real.pi by linarith [Real.pi_pos]) ht3
    simpa only [Real.cos_pi_div_three] using h
  · have h := Real.cos_lt_cos_of_nonneg_of_le_pi (show (0:ℝ) ≤ 0 by rfl)
      (show θ ≤ Real.pi by linarith [Real.pi_pos]) ht
    simpa only [Real.cos_zero] using h

theorem column_scale {ι κ : Type*} [Fintype ι] (v : ι → κ → ℂ)
    (c : κ → ℂ) (hc : ∀ k, c k ≠ 0) (hv : LinearIndependent ℂ v) :
    LinearIndependent ℂ (fun i k => v i k * c k) := by
  rw [Fintype.linearIndependent_iff] at hv ⊢
  intro g hg
  apply hv g
  funext k
  have hk := congrFun hg k
  simp only [Finset.sum_apply, Pi.smul_apply, smul_eq_mul, Pi.zero_apply] at hk ⊢
  have he : (∑ i, g i * v i k) * c k = 0 := by
    calc
      _ = ∑ i, g i * (v i k * c k) := by
        rw [Finset.sum_mul]
        apply Finset.sum_congr rfl
        intro i _
        ring
      _ = 0 := hk
  exact (mul_eq_zero.mp he).resolve_right (hc k)

theorem rotated_single (w x u v : ℂ) (hw : Complex.normSq w = 1)
    (hr : 1/2 < w.re) (hr1 : w.re < 1) (hx : x ≠ 0)
    (hu : Complex.normSq u = 1) (hv : Complex.normSq v = 1)
    (hu1 : u ≠ 1) (hv1 : v ≠ 1) (huv : v ≠ u) :
    LinearIndependent ℂ (![row x, row (x*u), row (x*v), jet w x]) := by
  have h := column_scale (![row 1, row u, row v, jet w 1])
    (fun k => x^k.val) (fun k => pow_ne_zero _ hx)
    (single w u v hw hr hr1 hu hv hu1 hv1 huv)
  convert h using 1
  funext i k
  fin_cases i <;> simp [row, jet, mul_pow] <;> ring

theorem rotated_double (w x y : ℂ) (hw : Complex.normSq w = 1)
    (hr : 1/2 < w.re) (hr1 : w.re < 1) (hx : x ≠ 0)
    (hy : y ≠ 0) (hy1 : y ≠ 1) :
    LinearIndependent ℂ (![row x, row (x*y), jet w x, jet w (x*y)]) := by
  have h := column_scale (![row 1, row y, jet w 1, jet w y])
    (fun k => x^k.val) (fun k => pow_ne_zero _ hx)
    (double w y hw hr hr1 hy hy1)
  convert h using 1
  funext i k
  fin_cases i <;> simp [row, jet, mul_pow] <;> ring

theorem fourier_single {q : ℕ} (hq : 7 ≤ q) (x u v : ℂ) (hx : x ≠ 0)
    (hu : Complex.normSq u = 1) (hv : Complex.normSq v = 1)
    (hu1 : u ≠ 1) (hv1 : v ≠ 1) (huv : v ≠ u) :
    LinearIndependent ℂ (![row x, row (x*u), row (x*v), jet (fourierRoot q) x]) := by
  obtain ⟨hw,hr,hr1⟩ := root_arc hq
  exact rotated_single _ _ _ _ hw hr hr1 hx hu hv hu1 hv1 huv

theorem fourier_double {q : ℕ} (hq : 7 ≤ q) (x y : ℂ) (hx : x ≠ 0)
    (hy : y ≠ 0) (hy1 : y ≠ 1) :
    LinearIndependent ℂ
      (![row x, row (x*y), jet (fourierRoot q) x, jet (fourierRoot q) (x*y)]) := by
  obtain ⟨hw,hr,hr1⟩ := root_arc hq
  exact rotated_double _ _ _ hw hr hr1 hx hy hy1

end P14CubicFourierJets
end
end

section

noncomputable section

open Filter
open scoped Topology

namespace P14ImplicitGraphInOpenSet

variable {W Y Z : Type*}
  [NormedAddCommGroup W] [NormedSpace ℝ W] [CompleteSpace W]
  [NormedAddCommGroup Y] [NormedSpace ℝ Y] [CompleteSpace Y]
  [NormedAddCommGroup Z] [NormedSpace ℝ Z] [CompleteSpace Z]

theorem exists_graph_in_open
    {f : W × Y → Z} {D : W × Y →L[ℝ] Z} {u : W × Y}
    (hf : HasStrictFDerivAt f D u)
    (hi : (D.comp (ContinuousLinearMap.inr ℝ W Y)).IsInvertible)
    {U : Set (W × Y)} (hU : IsOpen U) (hu : u ∈ U) :
    ∃ (ψ : W → Y) (V : Set W),
      IsOpen V ∧ u.1 ∈ V ∧ ψ u.1 = u.2 ∧
        Tendsto ψ (𝓝 u.1) (𝓝 u.2) ∧
          ∀ w ∈ V, f (w, ψ w) = f u ∧ (w, ψ w) ∈ U := by
  let ψ := hf.implicitFunctionOfProdDomain hi
  have hψ : Tendsto ψ (𝓝 u.1) (𝓝 u.2) :=
    hf.tendsto_implicitFunctionOfProdDomain hi
  have hcenter : ψ u.1 = u.2 :=
    (hf.eventually_apply_eq_iff_implicitFunctionOfProdDomain hi).self_of_nhds.mp rfl
  have hgraph : Tendsto (fun w => (w, ψ w)) (𝓝 u.1) (𝓝 u) :=
    tendsto_id.prodMk_nhds hψ
  have hin : ∀ᶠ w in 𝓝 u.1, (w, ψ w) ∈ U := hgraph (hU.mem_nhds hu)
  have heq : ∀ᶠ w in 𝓝 u.1, f (w, ψ w) = f u :=
    hf.eventually_apply_implicitFunctionOfProdDomain hi
  obtain ⟨V, hV, hVopen, hVu⟩ := eventually_nhds_iff.mp (heq.and hin)
  exact ⟨ψ, V, hVopen, hVu, hcenter, hψ, hV⟩

end P14ImplicitGraphInOpenSet

end
end

section

/-! A correction map whose zero-parameter slice is exactly the identity has
an invertible partial derivative. This supplies the local branch used for
the reciprocal parametrization of separated positive Fourier weights. -/

noncomputable section
open Filter
open scoped Topology
namespace P14IdentitySliceImplicit

variable {Y : Type*} [NormedAddCommGroup Y] [NormedSpace ℝ Y] [CompleteSpace Y]

theorem exists_graph {f : ℝ × Y → Y}
    (hf : ContDiffAt ℝ 1 f (0, 0)) (hslice : ∀ y, f (0, y) = y)
    {U : Set (ℝ × Y)} (hU : IsOpen U) (hu : (0, 0) ∈ U) :
    ∃ (ψ : ℝ → Y) (V : Set ℝ),
      IsOpen V ∧ 0 ∈ V ∧ ψ 0 = 0 ∧ Tendsto ψ (𝓝 0) (𝓝 0) ∧
        ∀ e ∈ V, f (e, ψ e) = 0 ∧ (e, ψ e) ∈ U := by
  have hstrict := hf.hasStrictFDerivAt one_ne_zero
  have hcomp := hstrict.hasFDerivAt.comp (0 : Y)
    (ContinuousLinearMap.inr ℝ ℝ Y).hasFDerivAt
  have hid : HasFDerivAt (fun y : Y => y)
      ((fderiv ℝ f (0, 0)).comp (ContinuousLinearMap.inr ℝ ℝ Y)) 0 := by
    simpa only [Function.comp_def, ContinuousLinearMap.inr_apply, hslice] using hcomp
  have heq := hid.unique (hasFDerivAt_id (0 : Y))
  have hinv : ((fderiv ℝ f (0, 0)).comp
      (ContinuousLinearMap.inr ℝ ℝ Y)).IsInvertible := by
    rw [heq]
    exact ContinuousLinearMap.IsInvertible.of_inverse
      (g := ContinuousLinearMap.id ℝ Y) (by ext; rfl) (by ext; rfl)
  obtain ⟨ψ, V, hV, hzero, hψ, hlim, hgraph⟩ :=
    P14ImplicitGraphInOpenSet.exists_graph_in_open hstrict hinv hU hu
  refine ⟨ψ, V, hV, hzero, hψ, hlim, ?_⟩
  intro e he
  obtain ⟨h, hUe⟩ := hgraph e he
  exact ⟨h.trans (hslice 0), hUe⟩

end P14IdentitySliceImplicit
end
end

section

/-! Two real corrections to the first two coefficients of a positive
three-term complex relation. Their weighted sum is exactly the chosen
complex correction; the positive coefficient chamber is open. -/

noncomputable section
open scoped BigOperators
namespace P14ComplexPairCoordinates

def left (z : ℂ) : ℂ →L[ℝ] ℝ :=
  Complex.reCLM - (z.re / z.im) • Complex.imCLM

def right (z : ℂ) : ℂ →L[ℝ] ℝ :=
  z.im⁻¹ • Complex.imCLM

theorem reconstruct (z c : ℂ) (hz : z.im ≠ 0) :
    (left z c : ℂ) + (right z c : ℂ) * z = c := by
  apply Complex.ext <;> simp [left, right, Complex.mul_re, Complex.mul_im]
  · field_simp
    <;> ring
  · field_simp

def triple (r : ℝ) (z c : ℂ) : Fin 3 → ℝ :=
  ![1 + left z c, r + right z c, 1]

theorem triple_zero (r : ℝ) (z : ℂ) : triple r z 0 = ![1, r, 1] := by
  simp [triple]

theorem triple_sum (r : ℝ) (z c : ℂ) (hz : z.im ≠ 0)
    (hr : 1 + (r : ℂ) * z + z ^ 2 = 0) :
    (∑ j : Fin 3, (triple r z c j : ℂ) * z ^ j.val) = c := by
  calc
    _ = (1 + (r : ℂ) * z + z ^ 2) +
        ((left z c : ℂ) + (right z c : ℂ) * z) := by
      simp [triple, Fin.sum_univ_succ]
      <;> ring
    _ = c := by rw [hr, zero_add, reconstruct z c hz]

theorem contDiff_triple (r : ℝ) (z : ℂ) (j : Fin 3) :
    ContDiff ℝ ⊤ (fun c => triple r z c j) := by
  fin_cases j <;> simp only [triple, Matrix.cons_val_zero, Matrix.cons_val_one,
    Matrix.cons_val_two]
  · exact contDiff_const.add (left z).contDiff
  · exact contDiff_const.add (right z).contDiff
  · exact contDiff_const

def positive (r : ℝ) (z : ℂ) : Set ℂ := {c | ∀ j, 0 < triple r z c j}

theorem isOpen_positive (r : ℝ) (z : ℂ) : IsOpen (positive r z) := by
  unfold positive
  rw [Set.ofPred_forall]
  apply isOpen_iInter_of_finite
  intro j
  exact isOpen_lt continuous_const (contDiff_triple r z j).continuous

theorem zero_mem_positive (r : ℝ) (hr : 0 < r) (z : ℂ) :
    0 ∈ positive r z := by
  intro j
  rw [triple_zero]
  fin_cases j <;> simp_all

end P14ComplexPairCoordinates
end
end

section

/-! An actual cubic spectral coefficient branch from an identity-slice
implicit equation. This does not assume spectral factorization or rank. -/

noncomputable section
open Filter
open scoped Topology
namespace P14CubicSpectralCorrection

abbrev Coeff := ℝ × (ℂ × (ℂ × ℂ))

def quadratic (v : Coeff) : Coeff :=
  ((v.1^2 + Complex.normSq v.2.1 + Complex.normSq v.2.2.1 + Complex.normSq v.2.2.2)/2,
   ((v.1:ℂ)*v.2.1 + v.2.2.1*star v.2.1 + v.2.2.2*star v.2.2.1,
    ((v.1:ℂ)*v.2.2.1 + v.2.2.2*star v.2.1, (v.1:ℂ)*v.2.2.2)))

def balance (t : Coeff) (p : ℝ × Coeff) : Coeff := p.2 + p.1 • quadratic (t+p.2)

theorem quadratic_smooth : ContDiff ℝ ⊤ quadratic := by
  have hr (f : Coeff → ℂ) (hf : ContDiff ℝ ⊤ f) :
      ContDiff ℝ ⊤ (fun v => (f v).re) := Complex.reCLM.contDiff.comp hf
  have hi (f : Coeff → ℂ) (hf : ContDiff ℝ ⊤ f) :
      ContDiff ℝ ⊤ (fun v => (f v).im) := Complex.imCLM.contDiff.comp hf
  have hc : ContDiff ℝ ⊤ (fun v : Coeff => (v.1:ℂ)) :=
    Complex.ofRealCLM.contDiff.comp contDiff_fst
  have h1 : ContDiff ℝ ⊤ (fun v : Coeff => v.2.1) := contDiff_snd.fst
  have h2 : ContDiff ℝ ⊤ (fun v : Coeff => v.2.2.1) := contDiff_snd.snd.fst
  have h3 : ContDiff ℝ ⊤ (fun v : Coeff => v.2.2.2) := contDiff_snd.snd.snd
  have hs1 := Complex.conjCLE.contDiff.comp h1
  have hs2 := Complex.conjCLE.contDiff.comp h2
  have hnorm (f : Coeff → ℂ) (hf : ContDiff ℝ ⊤ f) :
      ContDiff ℝ ⊤ (fun v => Complex.normSq (f v)) := by
    simp only [Complex.normSq_apply]
    exact ((hr f hf).mul (hr f hf)).add ((hi f hf).mul (hi f hf))
  exact ((((contDiff_fst.pow 2).add (hnorm _ h1)).add (hnorm _ h2)).add
    (hnorm _ h3)).div_const 2 |>.prodMk
      ((((hc.mul h1).add (h2.mul hs1)).add (h3.mul hs2)).prodMk
        (((hc.mul h2).add (h3.mul hs1)).prodMk (hc.mul h3)))

theorem balance_smooth (t : Coeff) : ContDiff ℝ ⊤ (balance t) := by
  unfold balance
  exact contDiff_snd.add (contDiff_fst.smul
    (quadratic_smooth.comp (contDiff_const.add contDiff_snd)))

theorem zero_slice (t v : Coeff) : balance t (0,v) = v := by simp [balance]

theorem exists_coefficients (t : Coeff) :
    ∃ b : ℝ → Coeff, b 0 = t ∧ Tendsto b (𝓝 0) (𝓝 t) ∧
      ∀ᶠ e in 𝓝 (0:ℝ), b e + e • quadratic (b e) = t := by
  obtain ⟨ψ,V,hV,hzero,hψ,hlim,hgraph⟩ :=
    P14IdentitySliceImplicit.exists_graph
      ((balance_smooth t).of_le le_top).contDiffAt (zero_slice t)
      isOpen_univ (Set.mem_univ (0,0))
  refine ⟨fun e => t+ψ e, by simp [hψ], ?_, ?_⟩
  · simpa only [add_zero] using tendsto_const_nhds.add hlim
  · filter_upwards [hV.mem_nhds hzero] with e he
    have h := (hgraph e he).1
    change ψ e + e • quadratic (t+ψ e) = 0 at h
    rw [add_assoc,h,add_zero]

theorem coefficient_equations (t b : Coeff) (e : ℝ) (h : b+e • quadratic b=t) :
    2*b.1+e*(b.1^2+Complex.normSq b.2.1+Complex.normSq b.2.2.1+
      Complex.normSq b.2.2.2)=2*t.1 ∧
    b.2.1+(e:ℂ)*((b.1:ℂ)*b.2.1+b.2.2.1*star b.2.1+b.2.2.2*star b.2.2.1)=t.2.1 ∧
    b.2.2.1+(e:ℂ)*((b.1:ℂ)*b.2.2.1+b.2.2.2*star b.2.1)=t.2.2.1 ∧
    b.2.2.2+(e:ℂ)*((b.1:ℂ)*b.2.2.2)=t.2.2.2 := by
  have h0 := congrArg Prod.fst h
  have h1 := congrArg (fun v : Coeff => v.2.1) h
  have h2 := congrArg (fun v : Coeff => v.2.2.1) h
  have h3 := congrArg (fun v : Coeff => v.2.2.2) h
  change b.1+e*((b.1^2+Complex.normSq b.2.1+Complex.normSq b.2.2.1+
    Complex.normSq b.2.2.2)/2)=t.1 at h0
  change b.2.1+e • ((b.1:ℂ)*b.2.1+b.2.2.1*star b.2.1+b.2.2.2*star b.2.2.1)=t.2.1 at h1
  change b.2.2.1+e • ((b.1:ℂ)*b.2.2.1+b.2.2.2*star b.2.1)=t.2.2.1 at h2
  change b.2.2.2+e • ((b.1:ℂ)*b.2.2.2)=t.2.2.2 at h3
  simp only [Complex.real_smul] at h1 h2 h3
  exact ⟨by linarith,h1,h2,h3⟩

end P14CubicSpectralCorrection
end
end

section

/-! Exact cubic spectral factorization on the full unit circle, derived
from the checked implicit coefficient branch rather than numerical roots. -/

noncomputable section
open Filter
open scoped Topology
namespace P14CubicSpectralFactor
open P14CubicSpectralCorrection

theorem norm_identity (x : ℝ) (a b c z : ℂ) (hz : Complex.normSq z=1) :
    Complex.normSq ((x:ℂ)+a*z+b*z^2+c*z^3) =
      x^2+Complex.normSq a+Complex.normSq b+Complex.normSq c+
        2*(((x:ℂ)*a+b*star a+c*star b)*z+
           ((x:ℂ)*b+c*star a)*z^2+(x:ℂ)*c*z^3).re := by
  have h : z.re^2+z.im^2=1 := by simpa [Complex.normSq_apply,pow_two] using hz
  simp only [pow_succ,pow_zero,Complex.one_re,Complex.one_im,Complex.normSq_apply,
    Complex.add_re,Complex.add_im,Complex.mul_re,Complex.mul_im,
    Complex.ofReal_re,Complex.ofReal_im,Complex.star_def,Complex.conj_re,Complex.conj_im]
  linear_combination
    (a.re^2+a.im^2+(b.re^2+b.im^2)*(z.re^2+z.im^2+1)+
      (c.re^2+c.im^2)*((z.re^2+z.im^2)^2+(z.re^2+z.im^2)+1)+
      2*((b.re*a.re+b.im*a.im)*z.re-(b.im*a.re-b.re*a.im)*z.im)+
      2*((c.re*a.re+c.im*a.im)*(z.re^2-z.im^2)-
        (c.im*a.re-c.re*a.im)*(2*z.re*z.im))+
      2*((c.re*b.re+c.im*b.im)*z.re-(c.im*b.re-c.re*b.im)*z.im)*
        (z.re^2+z.im^2+1))*h

def value (e : ℝ) (b : Coeff) (z : ℂ) : ℂ :=
  ((1+e*b.1:ℝ):ℂ)+(e:ℂ)*b.2.1*z+(e:ℂ)*b.2.2.1*z^2+(e:ℂ)*b.2.2.2*z^3

def target (t : Coeff) (z : ℂ) : ℝ :=
  2*t.1+2*(t.2.1*z+t.2.2.1*z^2+t.2.2.2*z^3).re

theorem factor_identity (t b : Coeff) (e : ℝ) (h : b+e • quadratic b=t)
    (z : ℂ) (hz : Complex.normSq z=1) :
    Complex.normSq (value e b z)=1+e*target t z := by
  obtain ⟨h0,h1,h2,h3⟩ := coefficient_equations t b e h
  have hc : (1+e*b.1)^2+Complex.normSq ((e:ℂ)*b.2.1)+
      Complex.normSq ((e:ℂ)*b.2.2.1)+Complex.normSq ((e:ℂ)*b.2.2.2)=1+2*e*t.1 := by
    simp only [map_mul,Complex.normSq_ofReal]
    linear_combination e*h0
  have hl : ((1+e*b.1:ℝ):ℂ)*((e:ℂ)*b.2.1)+
      ((e:ℂ)*b.2.2.1)*star ((e:ℂ)*b.2.1)+
      ((e:ℂ)*b.2.2.2)*star ((e:ℂ)*b.2.2.1)=(e:ℂ)*t.2.1 := by
    calc
      _ = (e:ℂ)*(b.2.1+(e:ℂ)*((b.1:ℂ)*b.2.1+
          b.2.2.1*star b.2.1+b.2.2.2*star b.2.2.1)) := by
        simp only [map_mul,Complex.star_def,Complex.conj_ofReal,
          Complex.ofReal_add,Complex.ofReal_mul,Complex.ofReal_one]
        ring
      _ = _ := by rw [h1]
  have hm : ((1+e*b.1:ℝ):ℂ)*((e:ℂ)*b.2.2.1)+
      ((e:ℂ)*b.2.2.2)*star ((e:ℂ)*b.2.1)=(e:ℂ)*t.2.2.1 := by
    calc
      _ = (e:ℂ)*(b.2.2.1+(e:ℂ)*((b.1:ℂ)*b.2.2.1+
          b.2.2.2*star b.2.1)) := by
        simp only [map_mul,Complex.star_def,Complex.conj_ofReal,
          Complex.ofReal_add,Complex.ofReal_mul,Complex.ofReal_one]
        ring
      _ = _ := by rw [h2]
  have hh : ((1+e*b.1:ℝ):ℂ)*((e:ℂ)*b.2.2.2)=(e:ℂ)*t.2.2.2 := by
    calc
      _ = (e:ℂ)*(b.2.2.2+(e:ℂ)*((b.1:ℂ)*b.2.2.2)) := by push_cast; ring
      _ = _ := by rw [h3]
  rw [value,norm_identity _ _ _ _ _ hz,hc,hl,hm,hh]
  simp only [target,Complex.add_re,Complex.mul_re,Complex.mul_im,
    Complex.ofReal_re,Complex.ofReal_im,zero_mul,sub_zero]
  ring

theorem exists_factor (t : Coeff) :
    ∃ b : ℝ → Coeff, b 0=t ∧ Tendsto b (𝓝 0) (𝓝 t) ∧
      ∀ᶠ e in 𝓝 (0:ℝ), ∀ z : ℂ, Complex.normSq z=1 →
        Complex.normSq (value e (b e) z)=1+e*target t z := by
  obtain ⟨b,hb,hlim,heq⟩ := exists_coefficients t
  refine ⟨b,hb,hlim,?_⟩
  filter_upwards [heq] with e he
  exact factor_identity t (b e) e he

end P14CubicSpectralFactor
end
end

section

/-! A quadratic trigonometric polynomial with exactly four consecutive
zeros on an arbitrary sufficiently large cyclic grid, and positive values
at every other grid node. Endpoint and wraparound cases are explicit. -/

noncomputable section
namespace P14ConsecutiveFourGridSigns

def angle (q : ℕ) : ℝ := Real.pi / q
def firstGap (q k : ℕ) : ℝ :=
  Real.cos (angle q) - Real.cos ((2 * (k : ℝ) - 1) * angle q)
def secondGap (q k : ℕ) : ℝ :=
  Real.cos (angle q) - Real.cos ((2 * (k : ℝ) - 5) * angle q)
def grid (q k : ℕ) : ℝ := firstGap q k * secondGap q k

theorem cos_lt_on_arc {a t : ℝ} (ha : 0 ≤ a) (hat : a < t)
    (hta : t < 2 * Real.pi - a) : Real.cos t < Real.cos a := by
  by_cases ht : t ≤ Real.pi
  · exact Real.cos_lt_cos_of_nonneg_of_le_pi ha ht hat
  · have h0 : 0 ≤ 2 * Real.pi - t := by linarith
    have hp : 2 * Real.pi - t ≤ Real.pi := by linarith
    have hh : a < 2 * Real.pi - t := by linarith
    have hc := Real.cos_lt_cos_of_nonneg_of_le_pi ha hp hh
    rwa [Real.cos_two_pi_sub] at hc

theorem gap_positive {q : ℕ} (hq : 0 < q) (s : ℝ)
    (hs : 1 < s) (hu : s + 1 < 2 * (q : ℝ)) :
    0 < Real.cos (angle q) - Real.cos (s * angle q) := by
  have hqR : (0 : ℝ) < q := by exact_mod_cast hq
  have ha : 0 < angle q := div_pos Real.pi_pos hqR
  have hqa : (q : ℝ) * angle q = Real.pi := by
    unfold angle
    field_simp [hqR.ne']
  have hl := mul_lt_mul_of_pos_right hs ha
  have hh := mul_lt_mul_of_pos_right hu ha
  apply sub_pos.mpr
  apply cos_lt_on_arc ha.le
  · nlinarith
  · nlinarith

theorem first_positive {q k : ℕ} (hk : 2 ≤ k) (hkq : k < q) :
    0 < firstGap q k := by
  have hkr : (2 : ℝ) ≤ k := by exact_mod_cast hk
  have hqr : (k : ℝ) < q := by exact_mod_cast hkq
  exact gap_positive (by omega) (2 * (k : ℝ) - 1) (by linarith) (by linarith)

theorem second_positive {q k : ℕ} (hk : 4 ≤ k) (hkq : k < q) :
    0 < secondGap q k := by
  have hkr : (4 : ℝ) ≤ k := by exact_mod_cast hk
  have hqr : (k : ℝ) < q := by exact_mod_cast hkq
  exact gap_positive (by omega) (2 * (k : ℝ) - 5) (by linarith) (by linarith)

theorem zero_first_four (q k : ℕ) (hk : k < 4) : grid q k = 0 := by
  interval_cases k <;> norm_num [grid, firstGap, secondGap, Real.cos_neg]

theorem grid_positive {q k : ℕ} (hk : 4 ≤ k) (hkq : k < q) :
    0 < grid q k := mul_pos (first_positive (by omega) hkq) (second_positive hk hkq)

theorem grid_nonnegative {q k : ℕ} (hkq : k < q) : 0 ≤ grid q k := by
  by_cases hk : k < 4
  · rw [zero_first_four q k hk]
  · exact (grid_positive (by omega) hkq).le

theorem grid_zero_iff {q k : ℕ} (hkq : k < q) : grid q k = 0 ↔ k < 4 := by
  constructor
  · intro h
    by_contra hn
    exact (grid_positive (by omega) hkq).ne' h
  · exact zero_first_four q k

end P14ConsecutiveFourGridSigns
end
end

section

/-! An actual local branch for quadratic spectral factorization. The
coefficient correction has an identity zero slice; no factorization,
spanning, or genericity hypothesis is assumed. -/

noncomputable section
open Filter
open scoped Topology
namespace P14QuadraticSpectralCorrection

abbrev Coeff := ℝ × (ℂ × ℂ)

def quadratic (v : Coeff) : Coeff :=
  ((v.1 ^ 2 + Complex.normSq v.2.1 + Complex.normSq v.2.2) / 2,
   ( (v.1 : ℂ) * v.2.1 + v.2.2 * star v.2.1,
     (v.1 : ℂ) * v.2.2))

def balance (t : Coeff) (p : ℝ × Coeff) : Coeff :=
  p.2 + p.1 • quadratic (t + p.2)

theorem quadratic_smooth : ContDiff ℝ ⊤ quadratic := by
  have hr (f : Coeff → ℂ) (hf : ContDiff ℝ ⊤ f) :
      ContDiff ℝ ⊤ (fun v => (f v).re) := Complex.reCLM.contDiff.comp hf
  have hi (f : Coeff → ℂ) (hf : ContDiff ℝ ⊤ f) :
      ContDiff ℝ ⊤ (fun v => (f v).im) := Complex.imCLM.contDiff.comp hf
  have hc : ContDiff ℝ ⊤ (fun v : Coeff => (v.1 : ℂ)) :=
    Complex.ofRealCLM.contDiff.comp contDiff_fst
  have hs : ContDiff ℝ ⊤ (fun v : Coeff => star v.2.1) :=
    Complex.conjCLE.contDiff.comp contDiff_snd.fst
  have hnorm (f : Coeff → ℂ) (hf : ContDiff ℝ ⊤ f) :
      ContDiff ℝ ⊤ (fun v => Complex.normSq (f v)) := by
    simp only [Complex.normSq_apply]
    exact ((hr f hf).mul (hr f hf)).add ((hi f hf).mul (hi f hf))
  exact (((contDiff_fst.pow 2).add (hnorm _ contDiff_snd.fst)).add
    (hnorm _ contDiff_snd.snd)).div_const 2 |>.prodMk
      (((hc.mul contDiff_snd.fst).add (contDiff_snd.snd.mul hs)).prodMk
        (hc.mul contDiff_snd.snd))

theorem balance_smooth (t : Coeff) : ContDiff ℝ ⊤ (balance t) := by
  unfold balance
  exact contDiff_snd.add (contDiff_fst.smul
    (quadratic_smooth.comp (contDiff_const.add contDiff_snd)))

theorem zero_slice (t v : Coeff) : balance t (0, v) = v := by
  simp [balance]

theorem exists_coefficients (t : Coeff) :
    ∃ b : ℝ → Coeff, b 0 = t ∧ Tendsto b (𝓝 0) (𝓝 t) ∧
      ∀ᶠ e in 𝓝 (0 : ℝ), b e + e • quadratic (b e) = t := by
  obtain ⟨ψ, V, hV, hzero, hψ, hlim, hgraph⟩ :=
    P14IdentitySliceImplicit.exists_graph
      ((balance_smooth t).of_le le_top).contDiffAt (zero_slice t)
      isOpen_univ (Set.mem_univ (0, 0))
  refine ⟨fun e => t + ψ e, by simp [hψ], ?_, ?_⟩
  · simpa only [add_zero] using tendsto_const_nhds.add hlim
  · filter_upwards [hV.mem_nhds hzero] with e he
    have h := (hgraph e he).1
    change ψ e + e • quadratic (t + ψ e) = 0 at h
    rw [add_assoc, h, add_zero]

theorem coefficient_equations (t b : Coeff) (e : ℝ)
    (h : b + e • quadratic b = t) :
    2 * b.1 + e * (b.1 ^ 2 + Complex.normSq b.2.1 + Complex.normSq b.2.2) =
      2 * t.1 ∧
    b.2.1 + (e : ℂ) * ((b.1 : ℂ) * b.2.1 + b.2.2 * star b.2.1) = t.2.1 ∧
    b.2.2 + (e : ℂ) * ((b.1 : ℂ) * b.2.2) = t.2.2 := by
  have h0 := congrArg Prod.fst h
  have h1 := congrArg (fun v : Coeff => v.2.1) h
  have h2 := congrArg (fun v : Coeff => v.2.2) h
  change b.1 + e * ((b.1 ^ 2 + Complex.normSq b.2.1 + Complex.normSq b.2.2) / 2) =
    t.1 at h0
  change b.2.1 + e • ((b.1 : ℂ) * b.2.1 + b.2.2 * star b.2.1) = t.2.1 at h1
  change b.2.2 + e • ((b.1 : ℂ) * b.2.2) = t.2.2 at h2
  simp only [Complex.real_smul] at h1 h2
  exact ⟨by linarith, h1, h2⟩

end P14QuadraticSpectralCorrection
end
end

section

/-! Exact quadratic spectral factorization near the constant polynomial.
The implicit branch is converted into an identity on the entire unit
circle. This is independent of the finite floating-point root solver. -/

noncomputable section
open Filter
open scoped Topology
namespace P14QuadraticSpectralFactor
open P14QuadraticSpectralCorrection

theorem norm_identity (x : ℝ) (a b z : ℂ) (hz : Complex.normSq z = 1) :
    Complex.normSq ((x : ℂ) + a * z + b * z ^ 2) =
      x ^ 2 + Complex.normSq a + Complex.normSq b +
        2 * (((x : ℂ) * a + b * star a) * z + (x : ℂ) * b * z ^ 2).re := by
  have h : z.re ^ 2 + z.im ^ 2 = 1 := by
    simpa [Complex.normSq_apply, pow_two] using hz
  simp only [Complex.normSq_apply, Complex.add_re, Complex.add_im,
    Complex.mul_re, Complex.mul_im, Complex.ofReal_re, Complex.ofReal_im,
    pow_two, Complex.star_def,
    Complex.conj_re, Complex.conj_im]
  linear_combination
    (a.re ^ 2 + a.im ^ 2 + (b.re ^ 2 + b.im ^ 2) *
      (z.re ^ 2 + z.im ^ 2 + 1) +
      2 * ((b.re * a.re + b.im * a.im) * z.re -
        (b.im * a.re - b.re * a.im) * z.im)) * h

def value (e : ℝ) (b : Coeff) (z : ℂ) : ℂ :=
  ((1 + e * b.1 : ℝ) : ℂ) + (e : ℂ) * b.2.1 * z +
    (e : ℂ) * b.2.2 * z ^ 2

def target (t : Coeff) (z : ℂ) : ℝ :=
  2 * t.1 + 2 * (t.2.1 * z + t.2.2 * z ^ 2).re

theorem factor_identity (t b : Coeff) (e : ℝ)
    (h : b + e • quadratic b = t) (z : ℂ) (hz : Complex.normSq z = 1) :
    Complex.normSq (value e b z) = 1 + e * target t z := by
  obtain ⟨h0, h1, h2⟩ := coefficient_equations t b e h
  have hc : (1 + e * b.1) ^ 2 + Complex.normSq ((e : ℂ) * b.2.1) +
      Complex.normSq ((e : ℂ) * b.2.2) = 1 + 2 * e * t.1 := by
    simp only [map_mul, Complex.normSq_ofReal]
    linear_combination e * h0
  have hl : ((1 + e * b.1 : ℝ) : ℂ) * ((e : ℂ) * b.2.1) +
      ((e : ℂ) * b.2.2) * star ((e : ℂ) * b.2.1) = (e : ℂ) * t.2.1 := by
    calc
      _ = (e : ℂ) * (b.2.1 + (e : ℂ) *
          ((b.1 : ℂ) * b.2.1 + b.2.2 * star b.2.1)) := by
        simp only [map_mul, Complex.star_def, Complex.conj_ofReal,
          Complex.ofReal_add, Complex.ofReal_mul, Complex.ofReal_one]
        ring
      _ = _ := by rw [h1]
  have hh : ((1 + e * b.1 : ℝ) : ℂ) * ((e : ℂ) * b.2.2) =
      (e : ℂ) * t.2.2 := by
    calc
      _ = (e : ℂ) * (b.2.2 + (e : ℂ) * ((b.1 : ℂ) * b.2.2)) := by
        push_cast
        ring
      _ = _ := by rw [h2]
  rw [value, norm_identity _ _ _ _ hz, hc, hl, hh]
  simp only [target, Complex.add_re, Complex.mul_re, Complex.mul_im, Complex.ofReal_re,
    Complex.ofReal_im, zero_mul, sub_zero]
  ring

theorem exists_factor (t : Coeff) :
    ∃ b : ℝ → Coeff, b 0 = t ∧ Tendsto b (𝓝 0) (𝓝 t) ∧
      ∀ᶠ e in 𝓝 (0 : ℝ), ∀ z : ℂ, Complex.normSq z = 1 →
        Complex.normSq (value e (b e) z) = 1 + e * target t z := by
  obtain ⟨b, hb, hlim, heq⟩ := exists_coefficients t
  refine ⟨b, hb, hlim, ?_⟩
  filter_upwards [heq] with e he
  exact factor_identity t (b e) e he

end P14QuadraticSpectralFactor
end
end

section

/-! Exact degree-two target for a product of two real-part gaps on the
unit circle. The coefficient nonvanishing tests are explicit algebra. -/

noncomputable section
namespace P14QuadraticGapTarget
open P14QuadraticSpectralCorrection P14QuadraticSpectralFactor

def coefficients (c : ℝ) (s t : ℂ) : Coeff :=
  (-c ^ 2 / 2 - (s * star t).re / 4,
   ((c : ℂ) * (s + t) / 2, -(s * t) / 4))

theorem target_identity (c : ℝ) (s t z : ℂ) (hz : Complex.normSq z = 1) :
    target (coefficients c s t) z = -(c - (s * z).re) * (c - (t * z).re) := by
  have h : z.re ^ 2 + z.im ^ 2 = 1 := by
    simpa [Complex.normSq_apply, pow_two] using hz
  norm_num [target, coefficients, Complex.mul_re, Complex.mul_im,
    Complex.star_def, pow_two]
  linear_combination ((s.re * t.re + s.im * t.im) / 2) * h

theorem first_ne_zero (c : ℝ) (s t : ℂ) (hc : c ≠ 0) (hst : s + t ≠ 0) :
    (coefficients c s t).2.1 ≠ 0 :=
  div_ne_zero (mul_ne_zero (Complex.ofReal_ne_zero.mpr hc) hst) (by norm_num)

theorem second_ne_zero (c : ℝ) (s t : ℂ) (hs : s ≠ 0) (ht : t ≠ 0) :
    (coefficients c s t).2.2 ≠ 0 :=
  div_ne_zero (neg_ne_zero.mpr (mul_ne_zero hs ht)) (by norm_num)

end P14QuadraticGapTarget
end
end

section

/-! The actual primitive Fourier root and the explicit quadratic target
whose defect is positive precisely outside four consecutive frequencies. -/

noncomputable section
namespace P14QuadraticFourierTarget
open P14ConsecutiveFourGridSigns P14QuadraticGapTarget
open P14QuadraticSpectralCorrection P14QuadraticSpectralFactor P14FourierSpectralWeights

def phase (x : ℝ) : ℂ := Complex.exp ((x : ℂ) * Complex.I)

theorem phase_ne_zero (x : ℝ) : phase x ≠ 0 := Complex.exp_ne_zero _

theorem phase_mul (x y : ℝ) : phase x * phase y = phase (x + y) := by
  simp only [phase, ← Complex.exp_add, Complex.ofReal_add, add_mul]

theorem phase_re (x : ℝ) : (phase x).re = Real.cos x :=
  Complex.exp_ofReal_mul_I_re x

theorem phase_normSq (x : ℝ) : Complex.normSq (phase x) = 1 := by
  rw [Complex.normSq_eq_norm_sq, phase, Complex.norm_exp_ofReal_mul_I]
  norm_num

theorem phase_sum (x : ℝ) : phase x + phase (-x) = ((2 * Real.cos x : ℝ) : ℂ) := by
  have hi (y : ℝ) : (phase y).im = Real.sin y :=
    Complex.exp_ofReal_mul_I_im y
  apply Complex.ext
  · simp only [Complex.add_re, phase_re, Complex.ofReal_re, Real.cos_neg]
    ring
  · simp only [Complex.add_im, hi, Complex.ofReal_im, Real.sin_neg]
    ring

theorem root_power (q k : ℕ) : fourierRoot q ^ k = phase (2 * (k : ℝ) * angle q) := by
  unfold fourierRoot phase angle
  rw [← Complex.exp_nat_mul]
  congr 1
  push_cast
  ring

def data (q : ℕ) : Coeff := coefficients (Real.cos (angle q))
  (phase (-angle q)) (phase (-5 * angle q))

theorem angle_bounds {q : ℕ} (hq : 7 ≤ q) :
    0 < angle q ∧ 2 * angle q < Real.pi / 2 := by
  have hqr : (7 : ℝ) ≤ q := by exact_mod_cast hq
  have hq0 : (0 : ℝ) < q := by linarith
  have ha : 0 < angle q := div_pos Real.pi_pos hq0
  have hqa : (q : ℝ) * angle q = Real.pi := by
    unfold angle
    field_simp [hq0.ne']
  refine ⟨ha, ?_⟩
  have hm := mul_le_mul_of_nonneg_right hqr ha.le
  nlinarith

theorem data_nonzero {q : ℕ} (hq : 7 ≤ q) :
    (data q).2.1 ≠ 0 ∧ (data q).2.2 ≠ 0 := by
  obtain ⟨ha, h2a⟩ := angle_bounds hq
  have hc : 0 < Real.cos (angle q) :=
    Real.cos_pos_of_mem_Ioo ⟨by linarith [Real.pi_pos], by linarith⟩
  have hc2 : 0 < Real.cos (2 * angle q) :=
    Real.cos_pos_of_mem_Ioo ⟨by linarith [Real.pi_pos], h2a⟩
  have hsum : phase (-angle q) + phase (-5 * angle q) =
      phase (-3 * angle q) * ((2 * Real.cos (2 * angle q) : ℝ) : ℂ) := by
    rw [← phase_sum, mul_add, phase_mul, phase_mul]
    congr 1 <;> congr 1 <;> ring
  have hsn : phase (-angle q) + phase (-5 * angle q) ≠ 0 := by
    rw [hsum]
    exact mul_ne_zero (phase_ne_zero _) (Complex.ofReal_ne_zero.mpr
      (mul_pos (by norm_num) hc2).ne')
  exact ⟨first_ne_zero _ _ _ hc.ne' hsn,
    second_ne_zero _ _ _ (phase_ne_zero _) (phase_ne_zero _)⟩

theorem target_grid (q k : ℕ) : target (data q) (fourierRoot q ^ k) = -grid q k := by
  have hz : Complex.normSq (fourierRoot q ^ k) = 1 := by
    rw [root_power]
    exact phase_normSq _
  rw [data, target_identity _ _ _ _ hz, root_power, phase_mul, phase_mul,
    phase_re, phase_re]
  rw [show -angle q + 2 * (k : ℝ) * angle q = (2 * (k : ℝ) - 1) * angle q by ring,
    show -5 * angle q + 2 * (k : ℝ) * angle q = (2 * (k : ℝ) - 5) * angle q by ring]
  simp only [grid, firstGap, secondGap]
  ring

end P14QuadraticFourierTarget
end
end

section

/-! A cubic trigonometric defect with exactly five consecutive zero grid
values and strict positivity at all other Fourier frequencies. -/

noncomputable section
namespace P14ConsecutiveFiveGridSigns
open P14ConsecutiveFourGridSigns

def grid (q k : ℕ) : ℝ :=
  (1-Real.cos (2*(k:ℝ)*angle q))*
    (Real.cos (angle q)-Real.cos ((2*(k:ℝ)-3)*angle q))*
    (Real.cos (angle q)-Real.cos ((2*(k:ℝ)-7)*angle q))

theorem zero_first_five (q k : ℕ) (hk : k < 5) : grid q k=0 := by
  interval_cases k <;> norm_num [grid,Real.cos_neg]

theorem first_positive {q k : ℕ} (hk : 0 < k) (hkq : k < q) :
    0 < 1-Real.cos (2*(k:ℝ)*angle q) := by
  have hkr : (0:ℝ) < k := by exact_mod_cast hk
  have hqr : (k:ℝ) < q := by exact_mod_cast hkq
  have hq0 : (0:ℝ) < q := lt_trans hkr hqr
  have ha : 0 < angle q := div_pos Real.pi_pos hq0
  have hqa : (q:ℝ)*angle q=Real.pi := by unfold angle; field_simp [hq0.ne']
  have hl : 0 < 2*(k:ℝ)*angle q := mul_pos (by linarith) ha
  have hh : 2*(k:ℝ)*angle q < 2*Real.pi := by
    have h := mul_lt_mul_of_pos_right hqr ha
    nlinarith
  have h := cos_lt_on_arc (show (0:ℝ) ≤ 0 by rfl) hl (by simpa using hh)
  simpa only [Real.cos_zero,sub_pos] using h

theorem grid_positive {q k : ℕ} (hk : 5 ≤ k) (hkq : k < q) : 0 < grid q k := by
  have hkr : (5:ℝ) ≤ k := by exact_mod_cast hk
  have hqr : (k:ℝ) < q := by exact_mod_cast hkq
  have h1 := first_positive (by omega) hkq
  have h2 := gap_positive (q:=q) (by omega) (2*(k:ℝ)-3) (by linarith) (by linarith)
  have h3 := gap_positive (q:=q) (by omega) (2*(k:ℝ)-7) (by linarith) (by linarith)
  exact mul_pos (mul_pos h1 h2) h3

theorem grid_nonnegative {q k : ℕ} (hkq : k < q) : 0 ≤ grid q k := by
  by_cases hk : k < 5
  · rw [zero_first_five q k hk]
  · exact (grid_positive (by omega) hkq).le

theorem grid_zero_iff {q k : ℕ} (hkq : k < q) : grid q k=0 ↔ k < 5 := by
  constructor
  · intro h
    by_contra hh
    exact (grid_positive (by omega) hkq).ne' h
  · exact zero_first_five q k

theorem successor (q k : ℕ) :
    grid q (k+1) = (1-Real.cos (2*((k:ℝ)+1)*angle q))*
      P14ConsecutiveFourGridSigns.grid q k := by
  unfold grid P14ConsecutiveFourGridSigns.grid firstGap secondGap
  push_cast
  rw [show (2*((k:ℝ)+1)-3)*angle q=(2*(k:ℝ)-1)*angle q by ring,
      show (2*((k:ℝ)+1)-7)*angle q=(2*(k:ℝ)-5)*angle q by ring]
  ring

end P14ConsecutiveFiveGridSigns
end
end

section

/-! A concrete cubic spectral target realizing the five-zero defect.
The normalized coefficient identity records the exact algebra needed to
connect this target to the already checked cubic collision jets. -/

noncomputable section
namespace P14CubicGapTarget
open P14QuadraticFourierTarget P14ConsecutiveFourGridSigns P14FourierSpectralWeights

def multiply (t : P14QuadraticSpectralCorrection.Coeff) : P14CubicSpectralCorrection.Coeff :=
  (t.1-t.2.1.re/2,
   (t.2.1-(t.1:ℂ)-t.2.2/2,(t.2.2-t.2.1/2,-t.2.2/2)))

theorem multiply_target (t : P14QuadraticSpectralCorrection.Coeff) (z : ℂ)
    (hz : Complex.normSq z=1) :
    P14CubicSpectralFactor.target (multiply t) z =
      (1-z.re)*P14QuadraticSpectralFactor.target t z := by
  have h : z.re^2+z.im^2=1 := by simpa [Complex.normSq_apply,pow_two] using hz
  simp only [multiply,P14CubicSpectralFactor.target,P14QuadraticSpectralFactor.target,
    Complex.add_re,Complex.sub_re,Complex.sub_im,
    Complex.div_ofNat_re,Complex.div_ofNat_im,Complex.neg_re,Complex.neg_im,
    pow_succ,pow_zero,Complex.one_re,Complex.one_im,
    Complex.mul_re,Complex.mul_im,Complex.ofReal_re,Complex.ofReal_im]
  linear_combination (t.2.1.re+t.2.2.re*z.re-t.2.2.im*z.im)*h

theorem normalized_coefficients (t : P14QuadraticSpectralCorrection.Coeff) (w scale : ℂ)
    (h0 : (t.1:ℂ) = -scale*(w^3+w^4+2*w^5+w^6+w^7))
    (h1 : t.2.1 = 2*scale*(w+w^2+w^3+w^4)) (h2 : t.2.2 = -2*scale) :
    (multiply t).2.1 = scale*P14CubicCollisionMoments.t1 w ∧
    (multiply t).2.2.1 = scale*P14CubicCollisionMoments.t2 w ∧
    (multiply t).2.2.2 = scale := by
  simp only [multiply,h0,h1,h2,P14CubicCollisionMoments.t1,P14CubicCollisionMoments.t2]
  constructor
  · ring
  constructor <;> ring

def data (q : ℕ) : P14CubicSpectralCorrection.Coeff :=
  multiply (P14QuadraticGapTarget.coefficients (Real.cos (angle q))
    (phase (-3*angle q)) (phase (-7*angle q)))

theorem target_grid (q k : ℕ) :
    P14CubicSpectralFactor.target (data q) (fourierRoot q ^ k) =
      -P14ConsecutiveFiveGridSigns.grid q k := by
  have hz : Complex.normSq (fourierRoot q ^ k)=1 := by
    rw [root_power]
    exact phase_normSq _
  rw [data,multiply_target _ _ hz,P14QuadraticGapTarget.target_identity _ _ _ _ hz,
    root_power,phase_mul,phase_mul,phase_re,phase_re,phase_re]
  rw [show -3*angle q+2*(k:ℝ)*angle q=(2*(k:ℝ)-3)*angle q by ring,
      show -7*angle q+2*(k:ℝ)*angle q=(2*(k:ℝ)-7)*angle q by ring]
  simp only [P14ConsecutiveFiveGridSigns.grid]
  ring

end P14CubicGapTarget
end
end

section

/-! The concrete trigonometric target has exactly the coefficient ratios
used by the cubic collision proof, with an explicit nonzero phase scale. -/

noncomputable section
namespace P14CubicPhaseCoefficients
open P14QuadraticFourierTarget P14ConsecutiveFourGridSigns P14FourierSpectralWeights

theorem phase_pow (a : ℝ) (k : ℕ) : phase a ^ k = phase ((k:ℝ)*a) := by
  unfold phase
  rw [← Complex.exp_nat_mul]
  congr 1
  push_cast
  ring

theorem quadratic_normalization (a : ℝ) :
    let t := P14QuadraticGapTarget.coefficients (Real.cos a) (phase (-3*a)) (phase (-7*a))
    let w := phase (2*a)
    let scale := phase (-10*a)/8
    (t.1:ℂ) = -scale*(w^3+w^4+2*w^5+w^6+w^7) ∧
      t.2.1 = 2*scale*(w+w^2+w^3+w^4) ∧ t.2.2 = -2*scale := by
  let u := phase a
  let r := phase (-a)
  have hu : u ≠ 0 := phase_ne_zero _
  have hr0 : r ≠ 0 := phase_ne_zero _
  have hr : u*r=1 := by
    dsimp [u,r]
    rw [phase_mul]
    simp [phase]
  have hinv : r=u⁻¹ := by
    apply mul_left_cancel₀ hu
    rw [hr,mul_inv_cancel₀ hu]
  have hconj : (starRingEnd ℂ) r=u := by
    have hunit : (starRingEnd ℂ) r*r=1 := by
      rw [← Complex.normSq_eq_conj_mul_self]
      have hh : Complex.normSq r=1 := phase_normSq _
      simp only [hh,Complex.ofReal_one]
    exact mul_right_cancel₀ hr0 (hunit.trans hr.symm)
  have hconju : (starRingEnd ℂ) u=r := by
    rw [← hconj]
    simp
  have hc : (Real.cos a:ℂ)=(u+r)/2 := by
    have hh := phase_sum a
    change u+r=((2*Real.cos a:ℝ):ℂ) at hh
    simp only [Complex.ofReal_mul, Complex.ofReal_ofNat] at hh
    linear_combination (-1/2:ℂ)*hh
  have h3 : phase (-3*a)=r^3 := by
    dsimp [r]
    rw [phase_pow]
    congr 1
    norm_num
  have h7 : phase (-7*a)=r^7 := by
    dsimp [r]
    rw [phase_pow]
    congr 1
    norm_num
  have h10 : phase (-10*a)=r^10 := by
    dsimp [r]
    rw [phase_pow]
    congr 1
    norm_num
  have hw : phase (2*a)=u^2 := by dsimp [u]; rw [phase_pow]; norm_num
  dsimp
  refine ⟨?_,?_,?_⟩
  · simp only [P14QuadraticGapTarget.coefficients]
    simp only [Complex.ofReal_sub, Complex.ofReal_neg, Complex.ofReal_div,
      Complex.ofReal_pow, Complex.ofReal_ofNat]
    rw [h3,h7,Complex.re_eq_add_conj]
    simp only [Complex.star_def,map_mul,map_pow,hconj,hconju]
    rw [hc,h10,hw,hinv]
    field_simp [hu]
    ring
  · simp only [P14QuadraticGapTarget.coefficients]
    rw [hc,h3,h7,h10,hw,hinv]
    field_simp [hu]
    ring
  · simp only [P14QuadraticGapTarget.coefficients]
    rw [h3,h7,h10]
    ring

def scale (q : ℕ) : ℂ := phase (-10*angle q)/8

theorem scale_ne_zero (q : ℕ) : scale q ≠ 0 := div_ne_zero (phase_ne_zero _) (by norm_num)

theorem data_coefficients (q : ℕ) :
    (P14CubicGapTarget.data q).2.1 = scale q * P14CubicCollisionMoments.t1 (fourierRoot q) ∧
    (P14CubicGapTarget.data q).2.2.1 = scale q * P14CubicCollisionMoments.t2 (fourierRoot q) ∧
    (P14CubicGapTarget.data q).2.2.2 = scale q := by
  obtain ⟨h0,h1,h2⟩ := quadratic_normalization (angle q)
  have hw : fourierRoot q=phase (2*angle q) := by
    simpa only [pow_one,Nat.cast_one,mul_one] using root_power q 1
  unfold P14CubicGapTarget.data
  rw [hw]
  exact P14CubicGapTarget.normalized_coefficients _ _ _ h0 h1 h2

end P14CubicPhaseCoefficients
end
end

section

/-! Actual cubic spectral rows, their continuous correction, and the
independence of the concrete target corrections in both collision patterns. -/

noncomputable section
namespace P14CubicWaveRows
open P14CubicSpectralCorrection P14CubicJetIndependence P14CubicRowOperations
open P14CubicFourierJets P14CubicPhaseCoefficients P14FourierSpectralWeights

def correction (b : Coeff) (w x : ℂ) : Fin 5 → ℂ := fun k =>
  (b.1:ℂ)*row x k + b.2.1*row (w*x) k +
    b.2.2.1*row (w^2*x) k + b.2.2.2*row (w^3*x) k

def wave (e : ℝ) (b : Coeff) (w x : ℂ) : Fin 5 → ℂ :=
  row x + (e:ℂ) • correction b w x

theorem wave_value (e : ℝ) (b : Coeff) (w x : ℂ) (k : Fin 5) :
    wave e b w x k = P14CubicSpectralFactor.value e b (w^k.val)*row x k := by
  simp only [wave,correction,P14CubicSpectralFactor.value,row,
    Pi.add_apply,Pi.smul_apply,smul_eq_mul,mul_pow,
    Complex.ofReal_add,Complex.ofReal_mul,Complex.ofReal_one]
  ring

theorem correction_data (q : ℕ) (x : ℂ) :
    correction (P14CubicGapTarget.data q) (fourierRoot q) x =
      ((P14CubicGapTarget.data q).1:ℂ) • row x + scale q • jet (fourierRoot q) x := by
  obtain ⟨h1,h2,h3⟩ := data_coefficients q
  funext k
  simp only [correction,Pi.add_apply,Pi.smul_apply,smul_eq_mul,h1,h2,h3,jet,row]
  ring

theorem correction_continuous (w x : ℂ) : Continuous (fun b : Coeff => correction b w x) := by
  apply continuous_pi
  intro k
  unfold correction
  fun_prop

theorem wave_continuous (w x : ℂ) :
    Continuous (fun p : ℝ × Coeff => wave p.1 p.2 w x) := by
  apply continuous_pi
  intro k
  simp only [wave,Pi.add_apply,Pi.smul_apply,smul_eq_mul,correction]
  fun_prop

theorem data_single {q : ℕ} (hq : 7 ≤ q) (x u v : ℂ) (hx : x ≠ 0)
    (hu : Complex.normSq u=1) (hv : Complex.normSq v=1)
    (hu1 : u ≠ 1) (hv1 : v ≠ 1) (huv : v ≠ u) :
    LinearIndependent ℂ (![row x,row (x*u),row (x*v),
      correction (P14CubicGapTarget.data q) (fourierRoot q) x]) := by
  have h := replace_row (![row x,row (x*u),row (x*v),jet (fourierRoot q) x])
    0 3 (by decide) ((P14CubicGapTarget.data q).1:ℂ) (scale q) (scale_ne_zero q)
    (fourier_single hq x u v hx hu hv hu1 hv1 huv)
  convert! h using 1
  funext i
  fin_cases i <;> simp [correction_data]

theorem data_double {q : ℕ} (hq : 7 ≤ q) (x y : ℂ) (hx : x ≠ 0)
    (hy : y ≠ 0) (hy1 : y ≠ 1) :
    LinearIndependent ℂ (![row x,row (x*y),
      correction (P14CubicGapTarget.data q) (fourierRoot q) x,
      correction (P14CubicGapTarget.data q) (fourierRoot q) (x*y)]) := by
  have h2 : LinearIndependent ℂ (![row x,row (x*y),
      correction (P14CubicGapTarget.data q) (fourierRoot q) x,jet (fourierRoot q) (x*y)]) := by
    have h := replace_row (![row x,row (x*y),jet (fourierRoot q) x,jet (fourierRoot q) (x*y)])
      0 2 (by decide) ((P14CubicGapTarget.data q).1:ℂ) (scale q) (scale_ne_zero q)
      (fourier_double hq x y hx hy hy1)
    convert! h using 1
    funext i
    fin_cases i <;> simp [correction_data]
  have h := replace_row (![row x,row (x*y),
      correction (P14CubicGapTarget.data q) (fourierRoot q) x,jet (fourierRoot q) (x*y)])
    1 3 (by decide) ((P14CubicGapTarget.data q).1:ℂ) (scale q) (scale_ne_zero q) h2
  convert! h using 1
  funext i
  fin_cases i <;> simp [correction_data]

end P14CubicWaveRows
end
end

section

/-! Explicit order and conjugation changes for four actual complex rows. -/

noncomputable section
open scoped BigOperators
namespace P14FourRowPermutations

theorem swap01 {κ : Type*} (a b c d : κ → ℂ)
    (h : LinearIndependent ℂ (![a,b,c,d])) : LinearIndependent ℂ (![b,a,c,d]) := by
  have hh := h.comp (Equiv.swap (0:Fin 4) 1) (Equiv.swap _ _).injective
  convert! hh using 1
  funext i
  fin_cases i <;> rfl

theorem swap12 {κ : Type*} (a b c d : κ → ℂ)
    (h : LinearIndependent ℂ (![a,b,c,d])) : LinearIndependent ℂ (![a,c,b,d]) := by
  have hh := h.comp (Equiv.swap (1:Fin 4) 2) (Equiv.swap _ _).injective
  convert! hh using 1
  funext i
  fin_cases i <;> rfl

theorem swap23 {κ : Type*} (a b c d : κ → ℂ)
    (h : LinearIndependent ℂ (![a,b,c,d])) : LinearIndependent ℂ (![a,b,d,c]) := by
  have hh := h.comp (Equiv.swap (2:Fin 4) 3) (Equiv.swap _ _).injective
  convert! hh using 1
  funext i
  fin_cases i <;> rfl

theorem rotate {κ : Type*} (a b c d : κ → ℂ)
    (h : LinearIndependent ℂ (![a,b,c,d])) : LinearIndependent ℂ (![b,c,d,a]) := by
  have hp : Function.Injective (fun i : Fin 4 => (![1,2,3,0] : Fin 4 → Fin 4) i) := by decide
  have hh := h.comp _ hp
  convert! hh using 1
  funext i
  fin_cases i <;> rfl

theorem conjugate {ι κ : Type*} [Fintype ι] (v : ι → κ → ℂ)
    (hv : LinearIndependent ℂ v) : LinearIndependent ℂ (fun i k => star (v i k)) := by
  rw [Fintype.linearIndependent_iff] at hv ⊢
  intro g hg
  have hh : ∑ i, star (g i) • v i = 0 := by
    funext k
    have hk := congrArg star (congrFun hg k)
    simpa only [Finset.sum_apply,Pi.smul_apply,smul_eq_mul,Pi.zero_apply,
      star_sum,star_mul,star_star,star_zero,mul_comm] using hk
  have hz := hv _ hh
  intro i
  have hi := congrArg star (hz i)
  simpa only [star_star,star_zero] using hi

end P14FourRowPermutations
end
end

section

/-! The checked cubic collision limits give neighborhoods of genuine
four-row independence for the actual spectral rows. -/

noncomputable section
open Filter
open scoped Topology
namespace P14CubicCollisionNeighborhoods
open P14CubicSpectralCorrection P14CubicJetIndependence P14CubicRowOperations
open P14CubicWaveRows P14FourRowPermutations P14FourierSpectralWeights

theorem data_single_nodes {q : ℕ} (hq : 7 ≤ q) (x y z : ℂ)
    (hx : Complex.normSq x=1) (hy : Complex.normSq y=1) (hz : Complex.normSq z=1)
    (hyx : y ≠ x) (hzx : z ≠ x) (hzy : z ≠ y) :
    LinearIndependent ℂ (![row x,row y,row z,
      correction (P14CubicGapTarget.data q) (fourierRoot q) x]) := by
  have hn : x ≠ 0 := by intro h; simp [h] at hx
  have huy : Complex.normSq (y/x)=1 := by rw [Complex.normSq_div,hy,hx]; norm_num
  have huz : Complex.normSq (z/x)=1 := by rw [Complex.normSq_div,hz,hx]; norm_num
  have hu1 : y/x ≠ 1 := by intro h; apply hyx; exact (div_eq_one_iff_eq hn).mp h
  have hv1 : z/x ≠ 1 := by intro h; apply hzx; exact (div_eq_one_iff_eq hn).mp h
  have huv : z/x ≠ y/x := by intro h; apply hzy; exact (div_left_inj' hn).mp h
  have h := data_single hq x (y/x) (z/x) hn huy huz hu1 hv1 huv
  have he1 : x*(y/x)=y := by field_simp
  have he2 : x*(z/x)=z := by field_simp
  rwa [he1,he2] at h

theorem data_double_nodes {q : ℕ} (hq : 7 ≤ q) (x y : ℂ)
    (hx : x ≠ 0) (hy : y ≠ 0) (hyx : y ≠ x) :
    LinearIndependent ℂ (![row x,row y,
      correction (P14CubicGapTarget.data q) (fourierRoot q) x,
      correction (P14CubicGapTarget.data q) (fourierRoot q) y]) := by
  have hdiv : y/x ≠ 1 := by intro h; apply hyx; exact (div_eq_one_iff_eq hx).mp h
  have h := data_double hq x (y/x) hx (div_ne_zero hy hx) hdiv
  have he : x*(y/x)=y := by field_simp
  rwa [he] at h

theorem eventually_single {q : ℕ} (hq : 7 ≤ q) (b : ℝ → Coeff)
    (hlim : Tendsto b (𝓝 0) (𝓝 (P14CubicGapTarget.data q))) (x y z : ℂ)
    (hx : Complex.normSq x=1) (hy : Complex.normSq y=1) (hz : Complex.normSq z=1)
    (hyx : y ≠ x) (hzx : z ≠ x) (hzy : z ≠ y) :
    ∀ᶠ e in 𝓝 (0:ℝ), e ≠ 0 →
      LinearIndependent ℂ (![row x,row y,row z,wave e (b e) (fourierRoot q) x]) := by
  have hi := data_single_nodes hq x y z hx hy hz hyx hzx hzy
  have hc : Continuous (fun c : Coeff =>
      ![row x,row y,row z,correction c (fourierRoot q) x]) := by
    apply continuous_pi
    intro i
    fin_cases i
    · exact continuous_const
    · exact continuous_const
    · exact continuous_const
    · exact correction_continuous _ _
  have he := ((hc.tendsto _).comp hlim).eventually hi.eventually
  filter_upwards [he] with e he
  intro he0
  have h := replace_row (![row x,row y,row z,correction (b e) (fourierRoot q) x])
    0 3 (by decide) 1 (e:ℂ) (Complex.ofReal_ne_zero.mpr he0) he
  convert! h using 1
  funext i
  fin_cases i <;> simp [wave]

theorem eventually_double {q : ℕ} (hq : 7 ≤ q) (b : ℝ → Coeff)
    (hlim : Tendsto b (𝓝 0) (𝓝 (P14CubicGapTarget.data q))) (x y : ℂ)
    (hx : x ≠ 0) (hy : y ≠ 0) (hyx : y ≠ x) :
    ∀ᶠ e in 𝓝 (0:ℝ), e ≠ 0 → LinearIndependent ℂ
      (![row x,row y,wave e (b e) (fourierRoot q) x,wave e (b e) (fourierRoot q) y]) := by
  have hi := data_double_nodes hq x y hx hy hyx
  have hc : Continuous (fun c : Coeff => ![row x,row y,
      correction c (fourierRoot q) x,correction c (fourierRoot q) y]) := by
    apply continuous_pi
    intro i
    fin_cases i
    · exact continuous_const
    · exact continuous_const
    · exact correction_continuous _ _
    · exact correction_continuous _ _
  have he := ((hc.tendsto _).comp hlim).eventually hi.eventually
  filter_upwards [he] with e he
  intro he0
  have h2 : LinearIndependent ℂ (![row x,row y,wave e (b e) (fourierRoot q) x,
      correction (b e) (fourierRoot q) y]) := by
    have h := replace_row (![row x,row y,correction (b e) (fourierRoot q) x,
        correction (b e) (fourierRoot q) y])
      0 2 (by decide) 1 (e:ℂ) (Complex.ofReal_ne_zero.mpr he0) he
    convert! h using 1
    funext i
    fin_cases i <;> simp [wave]
  have h := replace_row (![row x,row y,wave e (b e) (fourierRoot q) x,
      correction (b e) (fourierRoot q) y])
    1 3 (by decide) 1 (e:ℂ) (Complex.ofReal_ne_zero.mpr he0) h2
  convert! h using 1
  funext i
  fin_cases i <;> simp [wave]

theorem eventually_one_overlap {q : ℕ} (hq : 7 ≤ q) (b : ℝ → Coeff)
    (hlim : Tendsto b (𝓝 0) (𝓝 (P14CubicGapTarget.data q))) (x y z : ℂ)
    (hx : Complex.normSq x=1) (hy : Complex.normSq y=1) (hz : Complex.normSq z=1)
    (hyx : y ≠ x) (hzx : z ≠ x) (hzy : z ≠ y) :
    ∀ᶠ e in 𝓝 (0:ℝ), e ≠ 0 → LinearIndependent ℂ
      (![row x,row y,wave e (b e) (fourierRoot q) x,wave e (b e) (fourierRoot q) z]) := by
  have hi := swap23 _ _ _ _ (data_single_nodes hq x y z hx hy hz hyx hzx hzy)
  have hc : Continuous (fun p : ℝ × Coeff => ![row x,row y,
      correction p.2 (fourierRoot q) x,wave p.1 p.2 (fourierRoot q) z]) := by
    apply continuous_pi
    intro i
    fin_cases i
    · exact continuous_const
    · exact continuous_const
    · exact (correction_continuous _ _).comp continuous_snd
    · exact wave_continuous _ _
  have hp : Tendsto (fun e => (e,b e)) (𝓝 (0:ℝ)) (𝓝 (0,P14CubicGapTarget.data q)) :=
    tendsto_id.prodMk_nhds hlim
  have hl := (hc.tendsto _).comp hp
  simp only [wave,Complex.ofReal_zero,zero_smul,add_zero] at hl
  have he := hl.eventually hi.eventually
  filter_upwards [he] with e he
  intro he0
  have h := replace_row (![row x,row y,correction (b e) (fourierRoot q) x,
      wave e (b e) (fourierRoot q) z])
    0 2 (by decide) 1 (e:ℂ) (Complex.ofReal_ne_zero.mpr he0) he
  convert! h using 1
  funext i
  fin_cases i <;> simp [wave]

theorem eventually_distinct (t : Coeff) (b : ℝ → Coeff)
    (hlim : Tendsto b (𝓝 0) (𝓝 t)) (w : ℂ) (X : Fin 4 → ℂ)
    (hX : Function.Injective X) (s : Fin 4 → Bool) :
    ∀ᶠ e in 𝓝 (0:ℝ), LinearIndependent ℂ
      (fun i => if s i then wave e (b e) w (X i) else row (X i)) := by
  have hi := vandermonde_four X hX
  have hc : Continuous (fun p : ℝ × Coeff =>
      fun i => if s i then wave p.1 p.2 w (X i) else row (X i)) := by
    apply continuous_pi
    intro i
    cases hs : s i
    · exact continuous_const
    · exact wave_continuous _ _
  have hp : Tendsto (fun e => (e,b e)) (𝓝 (0:ℝ)) (𝓝 (0,t)) :=
    tendsto_id.prodMk_nhds hlim
  have hl := (hc.tendsto _).comp hp
  simp only [wave,Complex.ofReal_zero,zero_smul,add_zero,ite_self] at hl
  exact hl.eventually hi.eventually

end P14CubicCollisionNeighborhoods
end
end

section

/-! Every ordered three-base/one-spectral and two-base/two-spectral
selection is nondegenerate near zero, including every overlap case. -/

noncomputable section
open Filter
open scoped Topology
namespace P14CubicMixedNeighborhoods
open P14CubicSpectralCorrection P14CubicJetIndependence P14CubicWaveRows
open P14CubicCollisionNeighborhoods P14FourRowPermutations P14FourierSpectralWeights

theorem four_nodes_injective (x y z t : ℂ)
    (hyx : y ≠ x) (hzx : z ≠ x) (htx : t ≠ x)
    (hzy : z ≠ y) (hty : t ≠ y) (htz : t ≠ z) :
    Function.Injective (![x,y,z,t]) := by
  intro i j h
  fin_cases i <;> fin_cases j <;> simp_all

theorem three_one {q : ℕ} (hq : 7 ≤ q) (b : ℝ → Coeff)
    (hlim : Tendsto b (𝓝 0) (𝓝 (P14CubicGapTarget.data q))) (x y z t : ℂ)
    (hx : Complex.normSq x=1) (hy : Complex.normSq y=1)
    (hz : Complex.normSq z=1) (ht : Complex.normSq t=1)
    (hyx : y ≠ x) (hzx : z ≠ x) (hzy : z ≠ y) :
    ∀ᶠ e in 𝓝 (0:ℝ), e ≠ 0 → LinearIndependent ℂ
      (![row x,row y,row z,wave e (b e) (fourierRoot q) t]) := by
  by_cases htx : t=x
  · subst t
    exact eventually_single hq b hlim x y z hx hy hz hyx hzx hzy
  by_cases hty : t=y
  · subst t
    filter_upwards [eventually_single hq b hlim y x z hy hx hz hyx.symm hzy hzx] with e he
    intro he0
    exact swap01 _ _ _ _ (he he0)
  by_cases htz : t=z
  · subst t
    filter_upwards [eventually_single hq b hlim z x y hz hx hy hzx.symm hzy.symm hyx] with e he
    intro he0
    exact swap12 _ _ _ _ (swap01 _ _ _ _ (he he0))
  have hi := four_nodes_injective x y z t hyx hzx htx hzy hty htz
  have he := eventually_distinct (P14CubicGapTarget.data q) b hlim
    (fourierRoot q) (![x,y,z,t]) hi (![false,false,false,true])
  filter_upwards [he] with e he
  intro _
  convert! he using 1
  funext i
  fin_cases i <;> rfl

theorem two_two_first {q : ℕ} (hq : 7 ≤ q) (b : ℝ → Coeff)
    (hlim : Tendsto b (𝓝 0) (𝓝 (P14CubicGapTarget.data q))) (x y t : ℂ)
    (hx : Complex.normSq x=1) (hy : Complex.normSq y=1) (ht : Complex.normSq t=1)
    (hyx : y ≠ x) (htx : t ≠ x) :
    ∀ᶠ e in 𝓝 (0:ℝ), e ≠ 0 → LinearIndependent ℂ
      (![row x,row y,wave e (b e) (fourierRoot q) x,wave e (b e) (fourierRoot q) t]) := by
  by_cases hty : t=y
  · subst t
    have hxn : x ≠ 0 := by intro h; simp [h] at hx
    have hyn : y ≠ 0 := by intro h; simp [h] at hy
    exact eventually_double hq b hlim x y hxn hyn hyx
  · exact eventually_one_overlap hq b hlim x y t hx hy ht hyx htx hty

theorem two_two {q : ℕ} (hq : 7 ≤ q) (b : ℝ → Coeff)
    (hlim : Tendsto b (𝓝 0) (𝓝 (P14CubicGapTarget.data q))) (x y z t : ℂ)
    (hx : Complex.normSq x=1) (hy : Complex.normSq y=1)
    (hz : Complex.normSq z=1) (ht : Complex.normSq t=1)
    (hyx : y ≠ x) (htz : t ≠ z) :
    ∀ᶠ e in 𝓝 (0:ℝ), e ≠ 0 → LinearIndependent ℂ
      (![row x,row y,wave e (b e) (fourierRoot q) z,wave e (b e) (fourierRoot q) t]) := by
  by_cases hzx : z=x
  · subst z
    exact two_two_first hq b hlim x y t hx hy ht hyx htz
  by_cases hzy : z=y
  · subst z
    filter_upwards [two_two_first hq b hlim y x t hy hx ht hyx.symm htz] with e he
    intro he0
    exact swap01 _ _ _ _ (he he0)
  by_cases htx : t=x
  · subst t
    filter_upwards [two_two_first hq b hlim x y z hx hy hz hyx hzx] with e he
    intro he0
    exact swap23 _ _ _ _ (he he0)
  by_cases hty : t=y
  · subst t
    filter_upwards [two_two_first hq b hlim y x z hy hx hz hyx.symm hzy] with e he
    intro he0
    exact swap23 _ _ _ _ (swap01 _ _ _ _ (he he0))
  have hi := four_nodes_injective x y z t hyx hzx htx hzy hty htz
  have he := eventually_distinct (P14CubicGapTarget.data q) b hlim
    (fourierRoot q) (![x,y,z,t]) hi (![false,false,true,true])
  filter_upwards [he] with e he
  intro _
  convert! he using 1
  funext i
  fin_cases i <;> rfl

end P14CubicMixedNeighborhoods
end
end

section

/-! Unit spectral coordinates reverse the two layers by conjugation and
invertible column scaling. This gives the opposite mixed orientation. -/

noncomputable section
open Filter
open scoped Topology
namespace P14CubicWaveReverse
open P14CubicSpectralCorrection P14CubicJetIndependence P14CubicWaveRows
open P14FourRowPermutations P14FourierSpectralWeights

def UnitValues (e : ℝ) (b : Coeff) (w : ℂ) : Prop :=
  ∀ k : Fin 5, star (P14CubicSpectralFactor.value e b (w^k.val))*
    P14CubicSpectralFactor.value e b (w^k.val)=1

theorem values_ne_zero (e : ℝ) (b : Coeff) (w : ℂ) (h : UnitValues e b w) (k : Fin 5) :
    P14CubicSpectralFactor.value e b (w^k.val) ≠ 0 := by
  intro hz
  have hh := h k
  rw [hz,mul_zero] at hh
  exact zero_ne_one hh

theorem reverse_three (e : ℝ) (b : Coeff) (w x y z t : ℂ) (hu : UnitValues e b w)
    (h : LinearIndependent ℂ (![row (star x),row (star y),row (star z),wave e b w (star t)])) :
    LinearIndependent ℂ (![wave e b w x,wave e b w y,wave e b w z,row t]) := by
  have hc := conjugate _ h
  have hs := P14CubicFourierJets.column_scale _
    (fun k : Fin 5 => P14CubicSpectralFactor.value e b (w^k.val))
    (values_ne_zero e b w hu) hc
  convert! hs using 1
  funext i k
  fin_cases i
  · change wave e b w x k = star (row (star x) k) *
      P14CubicSpectralFactor.value e b (w^k.val)
    rw [wave_value]
    simp only [row,star_pow,star_star]
    ring
  · change wave e b w y k = star (row (star y) k) *
      P14CubicSpectralFactor.value e b (w^k.val)
    rw [wave_value]
    simp only [row,star_pow,star_star]
    ring
  · change wave e b w z k = star (row (star z) k) *
      P14CubicSpectralFactor.value e b (w^k.val)
    rw [wave_value]
    simp only [row,star_pow,star_star]
    ring
  · change t^k.val = star (wave e b w (star t) k) *
      P14CubicSpectralFactor.value e b (w^k.val)
    rw [wave_value]
    simp only [row,star_mul,star_pow,star_star]
    have hh := hu k
    change star (P14CubicSpectralFactor.value e b (w^k.val))*
      P14CubicSpectralFactor.value e b (w^k.val)=1 at hh
    linear_combination -(t^k.val)*hh

theorem pure_spectral (e : ℝ) (b : Coeff) (w : ℂ) (hu : UnitValues e b w)
    (X : Fin 4 → ℂ) (hX : Function.Injective X) :
    LinearIndependent ℂ (fun i => wave e b w (X i)) := by
  have h := P14CubicFourierJets.column_scale (fun i => row (X i))
    (fun k : Fin 5 => P14CubicSpectralFactor.value e b (w^k.val))
    (values_ne_zero e b w hu) (P14CubicRowOperations.vandermonde_four X hX)
  convert! h using 1
  funext i k
  rw [wave_value]
  ring

end P14CubicWaveReverse
end
end

section

/-! One neighborhood handles every ordered finite mixed selection, in
both layer orientations. The unit-coordinate condition is explicit. -/

noncomputable section
open Filter
open scoped Topology
namespace P14CubicOrderedRanks
open P14CubicSpectralCorrection P14CubicJetIndependence P14CubicWaveRows
open P14CubicMixedNeighborhoods P14CubicWaveReverse P14FourierSpectralWeights

def ThreeOne {ι : Type*} (e : ℝ) (b : Coeff) (w : ℂ) (X : ι → ℂ) : Prop :=
  ∀ i j k l, j ≠ i → k ≠ i → k ≠ j →
    LinearIndependent ℂ (![row (X i),row (X j),row (X k),wave e b w (X l)])

def TwoTwo {ι : Type*} (e : ℝ) (b : Coeff) (w : ℂ) (X : ι → ℂ) : Prop :=
  ∀ i j k l, j ≠ i → l ≠ k →
    LinearIndependent ℂ (![row (X i),row (X j),wave e b w (X k),wave e b w (X l)])

def OneThree {ι : Type*} (e : ℝ) (b : Coeff) (w : ℂ) (X : ι → ℂ) : Prop :=
  ∀ i j k l, j ≠ i → k ≠ i → k ≠ j →
    LinearIndependent ℂ (![wave e b w (X i),wave e b w (X j),wave e b w (X k),row (X l)])

theorem eventually_three_one {ι : Type*} [Finite ι] {q : ℕ} (hq : 7 ≤ q)
    (b : ℝ → Coeff) (hlim : Tendsto b (𝓝 0) (𝓝 (P14CubicGapTarget.data q)))
    (X : ι → ℂ) (hX : Function.Injective X) (hU : ∀ i, Complex.normSq (X i)=1) :
    ∀ᶠ e in 𝓝 (0:ℝ), e ≠ 0 → ThreeOne e (b e) (fourierRoot q) X := by
  have hh : ∀ᶠ e in 𝓝 (0:ℝ), ∀ i j k l : ι, j ≠ i → k ≠ i → k ≠ j → e ≠ 0 →
      LinearIndependent ℂ (![row (X i),row (X j),row (X k),wave e (b e) (fourierRoot q) (X l)]) := by
    apply Filter.eventually_all.mpr
    intro i
    apply Filter.eventually_all.mpr
    intro j
    apply Filter.eventually_all.mpr
    intro k
    apply Filter.eventually_all.mpr
    intro l
    by_cases hji : j=i
    · exact Filter.Eventually.of_forall (by intro e h; exact False.elim (h hji))
    by_cases hki : k=i
    · exact Filter.Eventually.of_forall (by intro e _ h; exact False.elim (h hki))
    by_cases hkj : k=j
    · exact Filter.Eventually.of_forall (by intro e _ _ h; exact False.elim (h hkj))
    filter_upwards [three_one hq b hlim (X i) (X j) (X k) (X l)
      (hU i) (hU j) (hU k) (hU l)
      (fun h => hji (hX h)) (fun h => hki (hX h)) (fun h => hkj (hX h))] with e he
    exact fun _ _ _ => he
  filter_upwards [hh] with e he
  exact fun he0 i j k l hji hki hkj => he i j k l hji hki hkj he0

theorem eventually_two_two {ι : Type*} [Finite ι] {q : ℕ} (hq : 7 ≤ q)
    (b : ℝ → Coeff) (hlim : Tendsto b (𝓝 0) (𝓝 (P14CubicGapTarget.data q)))
    (X : ι → ℂ) (hX : Function.Injective X) (hU : ∀ i, Complex.normSq (X i)=1) :
    ∀ᶠ e in 𝓝 (0:ℝ), e ≠ 0 → TwoTwo e (b e) (fourierRoot q) X := by
  have hh : ∀ᶠ e in 𝓝 (0:ℝ), ∀ i j k l : ι, j ≠ i → l ≠ k → e ≠ 0 →
      LinearIndependent ℂ (![row (X i),row (X j),wave e (b e) (fourierRoot q) (X k),
        wave e (b e) (fourierRoot q) (X l)]) := by
    apply Filter.eventually_all.mpr
    intro i
    apply Filter.eventually_all.mpr
    intro j
    apply Filter.eventually_all.mpr
    intro k
    apply Filter.eventually_all.mpr
    intro l
    by_cases hji : j=i
    · exact Filter.Eventually.of_forall (by intro e h; exact False.elim (h hji))
    by_cases hlk : l=k
    · exact Filter.Eventually.of_forall (by intro e _ h; exact False.elim (h hlk))
    filter_upwards [two_two hq b hlim (X i) (X j) (X k) (X l)
      (hU i) (hU j) (hU k) (hU l)
      (fun h => hji (hX h)) (fun h => hlk (hX h))] with e he
    exact fun _ _ => he
  filter_upwards [hh] with e he
  exact fun he0 i j k l hji hlk => he i j k l hji hlk he0

theorem eventually_ordered {ι : Type*} [Finite ι] {q : ℕ} (hq : 7 ≤ q)
    (b : ℝ → Coeff) (hlim : Tendsto b (𝓝 0) (𝓝 (P14CubicGapTarget.data q)))
    (X : ι → ℂ) (hX : Function.Injective X) (hU : ∀ i, Complex.normSq (X i)=1) :
    ∀ᶠ e in 𝓝 (0:ℝ), e ≠ 0 → UnitValues e (b e) (fourierRoot q) →
      ThreeOne e (b e) (fourierRoot q) X ∧ TwoTwo e (b e) (fourierRoot q) X ∧
        OneThree e (b e) (fourierRoot q) X := by
  have hs : Function.Injective (fun i => star (X i)) := by
    intro i j h
    exact hX (star_injective h)
  have hUs : ∀ i, Complex.normSq (star (X i))=1 := by
    intro i
    simpa only [Complex.star_def,Complex.normSq_conj] using hU i
  filter_upwards [eventually_three_one hq b hlim X hX hU,
    eventually_two_two hq b hlim X hX hU,
    eventually_three_one hq b hlim (fun i => star (X i)) hs hUs] with e h31 h22 h13
  intro he hu
  refine ⟨h31 he,h22 he,?_⟩
  intro i j k l hji hki hkj
  exact reverse_three e (b e) (fourierRoot q) (X i) (X j) (X k) (X l) hu
    (h13 he i j k l hji hki hkj)

end P14CubicOrderedRanks
end
end

section

/-! One actual positive parameter satisfies the five-zero Fourier defect,
nonzero spectral values and all three ordered mixed-rank conditions. -/

noncomputable section
open Filter
open scoped Topology
namespace P14CubicGridBranch
open P14CubicSpectralCorrection P14CubicSpectralFactor P14CubicGapTarget
open P14CubicOrderedRanks P14CubicWaveReverse P14FourierSpectralWeights
open P14QuadraticFourierTarget

def node (q : ℕ) (i : Fin q) : ℂ := fourierRoot q ^ i.val
def spectral (q : ℕ) (e : ℝ) (b : Coeff) (k : ℕ) : ℂ := value e b (fourierRoot q ^ k)

theorem node_injective {q : ℕ} (hq : 0 < q) : Function.Injective (node q) := by
  have hp := fourierRoot_isPrimitiveRoot q hq
  intro i j h
  exact Fin.ext (hp.pow_inj i.isLt j.isLt h)

theorem node_unit (q : ℕ) (i : Fin q) : Complex.normSq (node q i)=1 := by
  rw [node,root_power]
  exact phase_normSq _

theorem exists_data {q : ℕ} (hq : 7 ≤ q) :
    ∃ e : ℝ, ∃ b : Coeff, 0 < e ∧
      (∀ k : Fin q, Complex.normSq (spectral q e b k.val)=
        1-e*P14ConsecutiveFiveGridSigns.grid q k.val) ∧
      (∀ k : Fin q, spectral q e b k.val ≠ 0) ∧
      UnitValues e b (fourierRoot q) ∧ ThreeOne e b (fourierRoot q) (node q) ∧
      TwoTwo e b (fourierRoot q) (node q) ∧ OneThree e b (fourierRoot q) (node q) := by
  obtain ⟨b,_,hlim,hf⟩ := exists_factor (P14CubicGapTarget.data q)
  have hm := eventually_ordered hq b hlim (node q) (node_injective (by omega)) (node_unit q)
  have hpos : ∀ᶠ e in 𝓝 (0:ℝ), ∀ k : Fin q, 0 < 1-e*P14ConsecutiveFiveGridSigns.grid q k.val := by
    apply Filter.eventually_all.mpr
    intro k
    have ht : Tendsto (fun e : ℝ => 1-e*P14ConsecutiveFiveGridSigns.grid q k.val)
        (𝓝 0) (𝓝 1) := by
      simpa using tendsto_const_nhds.sub (tendsto_id.mul
        (tendsto_const_nhds : Tendsto (fun _ : ℝ => P14ConsecutiveFiveGridSigns.grid q k.val)
          (𝓝 0) (𝓝 (P14ConsecutiveFiveGridSigns.grid q k.val))))
    exact ht.eventually (lt_mem_nhds zero_lt_one)
  have hepos : ∀ᶠ e in 𝓝[>] (0:ℝ), 0 < e := self_mem_nhdsWithin
  have hall := ((hf.and hm).and hpos).filter_mono
    (nhdsWithin_le_nhds : 𝓝[>] (0:ℝ) ≤ 𝓝 0)
  obtain ⟨e,⟨⟨hfe,hme⟩,hpe⟩,he⟩ := (hall.and hepos).exists
  have hnorm (k : ℕ) : Complex.normSq (spectral q e (b e) k)=
      1-e*P14ConsecutiveFiveGridSigns.grid q k := by
    have hu : Complex.normSq (fourierRoot q ^ k)=1 := by
      rw [root_power]
      exact phase_normSq _
    have h := hfe (fourierRoot q ^ k) hu
    rw [P14CubicGapTarget.target_grid] at h
    simpa only [spectral,mul_neg,← sub_eq_add_neg] using h
  have hunit : UnitValues e (b e) (fourierRoot q) := by
    intro k
    have hz : Complex.normSq (spectral q e (b e) k.val)=1 := by
      rw [hnorm,P14ConsecutiveFiveGridSigns.zero_first_five q k.val k.isLt]
      ring
    change (starRingEnd ℂ) (spectral q e (b e) k.val)*spectral q e (b e) k.val=1
    rw [← Complex.normSq_eq_conj_mul_self,hz]
    rfl
  obtain ⟨h31,h22,h13⟩ := hme he.ne' hunit
  refine ⟨e,b e,he,fun k => hnorm k.val,?_,hunit,h31,h22,h13⟩
  intro k
  apply Complex.normSq_pos.mp
  rw [hnorm]
  exact hpe k

end P14CubicGridBranch
end
end

section

/-! A real full-support constraint kernel on every final window of at
least three consecutive coordinates, at any admissible odd Fourier order. -/

noncomputable section
open scoped BigOperators
namespace P14FourierWeightWindow
open P14CircleLagrangeWeights P14FourierSpectralWeights

def sample (q m : ℕ) (i : Fin (m+1)) : ℂ := fourierRoot q ^ i.val

theorem sample_injective {q m : ℕ} (hq : m < q) :
    Function.Injective (sample q m) := by
  intro i j h
  apply Fin.ext
  exact (fourierRoot_isPrimitiveRoot q (by omega)).pow_inj
    (by have := i.isLt; omega) (by have := j.isLt; omega) h

theorem sample_unit {q m : ℕ} (hq : m < q) (i : Fin (m+1)) :
    star (sample q m i)*sample q m i=1 := by
  have hn : Complex.normSq (sample q m i)=1 := by
    exact P14CubicGridBranch.node_unit q ⟨i.val,by have := i.isLt; omega⟩
  change (starRingEnd ℂ) (sample q m i)*sample q m i=1
  rw [←Complex.normSq_eq_conj_mul_self,hn]
  rfl

theorem exists_window {q a b : ℕ} (hb : 2 ≤ b) (hq : a+b+1 < q) (hodd : Odd q) :
    ∃ t : Fin (b+1) → ℝ,
      (∑ j, (t j : ℂ)*weight (sample q (a+b)) (Fin.natAdd a j))=0 ∧
      ∀ j, t j ≠ 0 := by
  let z := sample q (a+b)
  let w := fourierRoot q
  let r := w^(a+b-1)
  let C : ℂ := (-1 : ℂ)^(a+b)*∏ j, z j
  have hz : Function.Injective z := sample_injective (by omega)
  have hu : ∀ i, star (z i)*z i=1 := sample_unit (by omega)
  have hp := fourierRoot_isPrimitiveRoot q (by omega)
  have hw : w ≠ 0 := hp.ne_zero (by omega)
  have hr : r ≠ 0 := pow_ne_zero _ hw
  have hr1 : r ≠ 1 := hp.pow_ne_one_of_pos_of_lt (by omega : a+b-1 ≠ 0) (by omega)
  have hr2 : r^2 ≠ 1 := by
    intro he
    have hd : q ∣ (a+b-1)*2 := hp.dvd_of_pow_eq_one _ (by simpa only [r,←pow_mul] using he)
    have hd' : q ∣ a+b-1 := hodd.coprime_two_right.dvd_mul_right.mp hd
    have hh := Nat.le_of_dvd (by omega : 0 < a+b-1) hd'
    omega
  have hC : C ≠ 0 := by
    apply mul_ne_zero (pow_ne_zero _ (by norm_num : (-1 : ℂ) ≠ 0))
    apply Finset.prod_ne_zero_iff.mpr
    intro i _
    exact pow_ne_zero _ hw
  have hs (j : Fin (b+1)) :
      star (weight z (Fin.natAdd a j)) =
        (C*r^a)*r^j.val*weight z (Fin.natAdd a j) := by
    rw [weight_star (by omega) z hz hu]
    change C*(w^(a+j.val))^(a+b-1)*weight z (Fin.natAdd a j)=_
    rw [←pow_mul,Nat.mul_comm (a+j.val) (a+b-1),pow_mul,pow_add]
    dsimp [r]
    ring
  exact P14RealKernelThree.exists_of_geometric_ratios (n := b+1) (by omega)
    (fun j => weight z (Fin.natAdd a j)) (C*r^a) r
    (mul_ne_zero hC (pow_ne_zero _ hr)) hr hr1 hr2
    (fun j => weight_ne_zero z hz _) hs

end P14FourierWeightWindow
end
end

section

/-! Exact interpolation by a prescribed leading coefficient and distinct roots.
The coefficient may be zero. Degree cancellation is proved before applying
the strict root-count bound; no matrix rank or UPB conclusion is assumed. -/

noncomputable section
namespace P14PolynomialRootInterpolation
open Polynomial
open scoped BigOperators

variable {K : Type*} [Field K]

def rootPolynomial {r : ℕ} (x : Fin r → K) : K[X] :=
  ∏ i, (X - C (x i))

theorem rootPolynomial_monic {r : ℕ} (x : Fin r → K) :
    (rootPolynomial x).Monic := by
  exact monic_prod_of_monic _ _ (fun _ _ => monic_X_sub_C _)

theorem rootPolynomial_natDegree {r : ℕ} (x : Fin r → K) :
    (rootPolynomial x).natDegree = r := by
  simp [rootPolynomial]

theorem rootPolynomial_coeff_top {r : ℕ} (x : Fin r → K) :
    (rootPolynomial x).coeff r = 1 := by
  have h := (rootPolynomial_monic x).coeff_natDegree
  simpa only [rootPolynomial_natDegree] using h

theorem rootPolynomial_eval {r : ℕ} (x : Fin r → K) (z : K) :
    (rootPolynomial x).eval z = ∏ i, (z - x i) := by
  simp [rootPolynomial, eval_prod]

theorem rootPolynomial_eval_root {r : ℕ} (x : Fin r → K) (i : Fin r) :
    (rootPolynomial x).eval (x i) = 0 := by
  rw [rootPolynomial_eval]
  exact Finset.prod_eq_zero (Finset.mem_univ i) (sub_self _)

theorem zero_of_eval {r : ℕ} (x : Fin r → K) (hx : Function.Injective x)
    (P : K[X]) (hdegree : P.natDegree < r) (heval : ∀ i, P.eval (x i) = 0) :
    P = 0 := by
  exact eq_zero_of_natDegree_lt_card_of_eval_eq_zero P hx heval
    (by simpa using hdegree)

theorem eq_C_mul_rootPolynomial {r : ℕ} (x : Fin r → K)
    (hx : Function.Injective x) (hr : 0 < r) (P : K[X]) (a : K)
    (hdegree : P.natDegree ≤ r) (hcoeff : P.coeff r = a)
    (heval : ∀ i, P.eval (x i) = 0) :
    P = C a * rootPolynomial x := by
  let D : K[X] := P - C a * rootPolynomial x
  have hDdegree : D.natDegree ≤ r := by
    apply (natDegree_sub_le _ _).trans
    apply max_le hdegree
    exact (natDegree_C_mul_le _ _).trans (by rw [rootPolynomial_natDegree])
  have hDcoeff : D.coeff r = 0 := by
    simp only [D, coeff_sub, coeff_C_mul, rootPolynomial_coeff_top, mul_one, hcoeff,
      sub_self]
  have hDlt : D.natDegree < r := by
    by_cases hD : D = 0
    · simpa only [hD, natDegree_zero] using hr
    · have htop : D.coeff D.natDegree ≠ 0 := by
        rw [coeff_natDegree]
        exact leadingCoeff_ne_zero.mpr hD
      by_contra hnot
      have hEq : D.natDegree = r := by omega
      exact htop (by simpa only [hEq] using hDcoeff)
  have hzero : D = 0 := zero_of_eval x hx D hDlt (by
    intro i
    simp only [D, eval_sub, eval_mul, eval_C, rootPolynomial_eval_root, heval,
      mul_zero, sub_zero])
  exact sub_eq_zero.mp hzero

end P14PolynomialRootInterpolation

end
end

section

/-! The polynomial whose coefficients are Fourier barycentric weights
has precisely the first m Fourier nodes as roots. At q=2(m-1),
its roots shared with the reflected polynomial are confined to ±1. -/

noncomputable section
open scoped BigOperators
namespace P14FourierWeightPolynomial
open Polynomial P14CircleLagrangeWeights P14FourierWeightWindow P14FourierSpectralWeights
open P14PolynomialRootInterpolation

def poly (q m : ℕ) : ℂ[X] :=
  ∑ k : Fin (m+1), monomial k.val (weight (sample q m) k)

theorem coeff (q m : ℕ) (j : Fin (m+1)) :
    (poly q m).coeff j.val=weight (sample q m) j := by
  classical
  simp only [poly,finsetSum_coeff,coeff_monomial]
  rw [Finset.sum_eq_single j]
  · simp
  · intro k _ hkj
    exact if_neg (fun h => hkj (Fin.ext h))
  · simp

theorem degree (q m : ℕ) : (poly q m).natDegree ≤ m := by
  apply natDegree_sum_le_of_forall_le
  intro k _
  exact (natDegree_monomial_le _).trans (by have := k.isLt; omega)

theorem eval (q m : ℕ) (x : ℂ) :
    (poly q m).eval x=∑ k : Fin (m+1), weight (sample q m) k*x^k.val := by
  simp only [poly,eval_finsetSum,eval_monomial]

theorem eval_node {q m : ℕ} (hq : m < q) (j : Fin m) :
    (poly q m).eval (fourierRoot q^j.val)=0 := by
  rw [eval]
  convert! P14BarycentricInterpolation.moment_zero (sample q m)
    (sample_injective hq) j.isLt using 1
  apply Finset.sum_congr rfl
  intro k _
  congr 1
  simp only [sample,←pow_mul,Nat.mul_comm]

theorem factor {q m : ℕ} (hm : 0 < m) (hq : m < q) :
    poly q m = C (weight (sample q m) (Fin.last m)) *
      rootPolynomial (fun j : Fin m => fourierRoot q^j.val) := by
  apply eq_C_mul_rootPolynomial _ _ hm _ _ (degree q m)
  · exact coeff q m (Fin.last m)
  · exact eval_node hq
  · intro i j h
    apply Fin.ext
    exact (fourierRoot_isPrimitiveRoot q (by omega)).pow_inj
      (by have := i.isLt; omega) (by have := j.isLt; omega) h

theorem root_iff {q m : ℕ} (hm : 0 < m) (hq : m < q) (x : ℂ) :
    (poly q m).eval x=0 ↔ ∃ j : Fin m, x=fourierRoot q^j.val := by
  classical
  rw [factor hm hq,eval_mul,eval_C,rootPolynomial_eval,mul_eq_zero]
  simp only [weight_ne_zero _ (sample_injective hq) _,false_or]
  rw [Finset.prod_eq_zero_iff]
  simp only [Finset.mem_univ,true_and,sub_eq_zero]

theorem half_power {q m : ℕ} (hm : 2 ≤ m) (hq : q=2*(m-1)) :
    fourierRoot q^(m-1)=(-1 : ℂ) := by
  have hp := fourierRoot_isPrimitiveRoot q (by omega)
  have hs : (fourierRoot q^(m-1))^2=1 := by
    rw [←pow_mul,show (m-1)*2=q by omega]
    exact hp.pow_eq_one
  rcases sq_eq_one_iff.mp hs with h | h
  · exact (hp.pow_ne_one_of_pos_of_lt (by omega) (by omega) h).elim
  · exact h

theorem common_root {q m : ℕ} (hm : 3 ≤ m) (hsize : m < q) (hq : q=2*(m-1))
    (x : ℂ) (hx : (poly q m).eval x=0) (hnx : (poly q m).eval (-x)=0) :
    x=1 ∨ x=-1 := by
  obtain ⟨i,hi⟩ := (root_iff (by omega) hsize x).mp hx
  obtain ⟨j,hj⟩ := (root_iff (by omega) hsize (-x)).mp hnx
  have hn := half_power (by omega : 2 ≤ m) hq
  by_cases hi0 : i.val=0
  · left
    simpa [hi0] using hi
  by_cases hilast : i.val=m-1
  · right
    simpa [hilast,hn] using hi
  have hp := fourierRoot_isPrimitiveRoot q (by omega)
  have he : fourierRoot q^(i.val+(m-1))=fourierRoot q^j.val := by
    rw [pow_add,hn,←hi]
    simpa only [mul_neg_one] using hj
  have hv := hp.pow_inj (by have := i.isLt; omega) (by have := j.isLt; omega) he
  have := i.isLt
  have := j.isLt
  omega

end P14FourierWeightPolynomial
end
end

section

/-! A sparse final coordinate window proves mixed Vandermonde-jet
independence for arbitrary row counts. All restrictions used below are
consecutive power columns; arbitrary Fourier minors are not assumed. -/

noncomputable section
open scoped BigOperators
namespace P14SparseVandermondeJets

def first {a b : ℕ} (k : Fin a) : Fin (a+b+1) := ⟨k.val,by omega⟩
def last {a b : ℕ} (k : Fin b) : Fin (a+b+1) := ⟨a+k.val,by omega⟩

theorem square_independent {n : ℕ} (X : Fin n → ℂ) (hX : Function.Injective X) :
    LinearIndependent ℂ (fun i => fun k : Fin n => X i ^ k.val) := by
  change LinearIndependent ℂ (Matrix.vandermonde X).row
  apply Matrix.linearIndependent_rows_of_isUnit
  exact (Matrix.isUnit_iff_isUnit_det _).mpr
    (isUnit_iff_ne_zero.mpr (Matrix.det_vandermonde_ne_zero_iff.mpr hX))

theorem block_independent {a b : ℕ}
    (v : Fin a → Fin (a+b+1) → ℂ) (w : Fin b → Fin (a+b+1) → ℂ)
    (hv : LinearIndependent ℂ (fun i k => v i (first k)))
    (hw : LinearIndependent ℂ (fun i k => w i (last k)))
    (hz : ∀ i k, w i (first k)=0) :
    LinearIndependent ℂ (Sum.elim v w) := by
  rw [Fintype.linearIndependent_iff] at hv hw ⊢
  intro c hc
  have hb : ∑ i, c (Sum.inl i) • (fun k => v i (first k))=0 := by
    funext k
    have hk := congrFun hc (first k)
    simpa only [Fintype.sum_sum_type,Finset.sum_apply,Pi.smul_apply,smul_eq_mul,
      Sum.elim_inl,Sum.elim_inr,hz,mul_zero,Finset.sum_const_zero,add_zero,Pi.zero_apply] using hk
  have hcb := hv _ hb
  have ht : ∑ i, c (Sum.inr i) • (fun k => w i (last k))=0 := by
    funext k
    have hk := congrFun hc (last k)
    simpa only [Fintype.sum_sum_type,Finset.sum_apply,Pi.smul_apply,smul_eq_mul,
      Sum.elim_inl,Sum.elim_inr,hcb,zero_mul,Finset.sum_const_zero,zero_add,Pi.zero_apply] using hk
  have hct := hw _ ht
  intro i
  cases i with
  | inl i => exact hcb i
  | inr i => exact hct i

theorem sparse_independent {a b : ℕ} (X : Fin a → ℂ) (Y : Fin b → ℂ)
    (hX : Function.Injective X) (hY : Function.Injective Y) (hYn : ∀ i, Y i ≠ 0)
    (t : Fin (a+b+1) → ℂ) (ht0 : ∀ k, t (first k)=0)
    (htn : ∀ k, t (last k) ≠ 0) :
    LinearIndependent ℂ
      (Sum.elim (fun i k => X i ^ k.val) (fun i k => t k * Y i ^ k.val)) := by
  apply block_independent
  · exact square_independent X hX
  · have hy := P14CubicRowOperations.row_scale
      (fun i => fun k : Fin b => Y i ^ k.val) (fun i => Y i ^ a)
      (fun i => pow_ne_zero _ (hYn i)) (square_independent Y hY)
    have hs := P14CubicFourierJets.column_scale _ (fun k => t (last k)) htn hy
    convert! hs using 1
    funext i k
    change t (last k) * Y i ^ (a+k.val) = (Y i ^ a * Y i ^ k.val) * t (last k)
    rw [pow_add]
    ring
  · intro i k
    rw [ht0 k,zero_mul]

end P14SparseVandermondeJets

end
end

section

/-! The actual resonant Fourier parity space has sufficient dimension,
is spanned by real supported witnesses, and cannot contain a Vandermonde
base with at least three distinct nodes. -/

noncomputable section
open scoped BigOperators
namespace P14FourierParitySpace
open P14CircleLagrangeWeights P14FourierWeightWindow P14FourierSpectralWeights
open P14PhaseKernelSpan P14SplitKernelSpan

def weights (q m : ℕ) : Fin (m+1) → ℂ := weight (sample q m)
def evenCoord (m : ℕ) (k : Fin (m+1)) : Prop := Even k.val
def H (q m : ℕ) : Submodule ℂ (Fin (m+1) → ℂ) := space (weights q m) (evenCoord m)
def phase (q m : ℕ) : ℂ := (-1 : ℂ)^m*∏ j, sample q m j

theorem weights_ne_zero {q m : ℕ} (hq : m < q) (k : Fin (m+1)) :
    weights q m k ≠ 0 := weight_ne_zero _ (sample_injective hq) k

theorem phase_ne_zero {q m : ℕ} (hq : m < q) : phase q m ≠ 0 := by
  apply mul_ne_zero (pow_ne_zero _ (by norm_num : (-1 : ℂ) ≠ 0))
  apply Finset.prod_ne_zero_iff.mpr
  intro k _
  have hp := fourierRoot_isPrimitiveRoot q (by omega)
  exact pow_ne_zero _ (hp.ne_zero (by omega))

theorem conjugation {q m : ℕ} (hm : 2 ≤ m) (hsize : m < q) (hq : q=2*(m-1))
    (k : Fin (m+1)) :
    star (weights q m k)=phase q m*(-1 : ℂ)^k.val*weights q m k := by
  rw [weights,weight_star (by omega) _ (sample_injective hsize) (sample_unit hsize)]
  change phase q m*(fourierRoot q^k.val)^(m-1)*weights q m k=_
  rw [←pow_mul,Nat.mul_comm k.val (m-1),pow_mul,
    P14FourierWeightPolynomial.half_power hm hq]
  rfl

theorem real_span {q m : ℕ} (hm : 2 ≤ m) (hsize : m < q) (hq : q=2*(m-1)) :
    Submodule.span ℂ
      (Set.range (row (weights q m) (evenCoord m)) ∪
       Set.range (row (weights q m) (fun k => ¬ evenCoord m k)))=H q m := by
  apply span_union _ _ (phase q m) (-phase q m) (phase_ne_zero hsize)
    (neg_ne_zero.mpr (phase_ne_zero hsize))
  · intro k hk
    rw [conjugation hm hsize hq]
    change phase q m*(-1 : ℂ)^k.val*weights q m k=_
    rw [hk.neg_one_pow,mul_one]
  · intro k hk
    rw [conjugation hm hsize hq,neg_one_pow_eq_ite]
    change phase q m*(if Even k.val then 1 else (-1 : ℂ))*weights q m k=_
    change ¬ Even k.val at hk
    rw [if_neg hk]
    ring

theorem dimension_lower (q m : ℕ) : m-1 ≤ Module.finrank ℂ (H q m) := by
  have h := P14SplitKernelDimension.finrank_lower (weights q m) (evenCoord m)
  change m-1 ≤ Module.finrank ℂ (space (weights q m) (evenCoord m))
  simp only [Fintype.card_fin] at h
  omega

theorem power_mem_roots {q m : ℕ} (hm : 3 ≤ m) (hsize : m < q) (hq : q=2*(m-1))
    (x : ℂ) (hx : (fun k : Fin (m+1) => x^k.val) ∈ H q m) : x=1 ∨ x=-1 := by
  classical
  have he := LinearMap.mem_ker.mp hx.1
  have ho := LinearMap.mem_ker.mp hx.2
  have hf : (P14FourierWeightPolynomial.poly q m).eval x=0 := by
    calc
      _ = cmap (mask (evenCoord m) (weights q m)) (fun k => x^k.val)+
          cmap (mask (fun k => ¬ evenCoord m k) (weights q m)) (fun k => x^k.val) := by
        rw [P14FourierWeightPolynomial.eval,cmap_apply,cmap_apply,←Finset.sum_add_distrib]
        apply Finset.sum_congr rfl
        intro k _
        by_cases hk : Even k.val <;> simp [mask,evenCoord,weights,hk,mul_comm]
      _ = 0 := by rw [he,ho,add_zero]
  have hnf : (P14FourierWeightPolynomial.poly q m).eval (-x)=0 := by
    calc
      _ = cmap (mask (evenCoord m) (weights q m)) (fun k => x^k.val)-
          cmap (mask (fun k => ¬ evenCoord m k) (weights q m)) (fun k => x^k.val) := by
        rw [P14FourierWeightPolynomial.eval,cmap_apply,cmap_apply,←Finset.sum_sub_distrib]
        apply Finset.sum_congr rfl
        intro k _
        rw [neg_pow]
        by_cases hk : Even k.val <;>
          simp [mask,evenCoord,weights,hk,neg_one_pow_eq_ite,mul_comm]
      _ = 0 := by rw [he,ho,sub_self]
  exact P14FourierWeightPolynomial.common_root hm hsize hq x hf hnf

def baseSpan {a m : ℕ} (X : Fin a → ℂ) : Submodule ℂ (Fin (m+1) → ℂ) :=
  Submodule.span ℂ (Set.range (fun i => fun k : Fin (m+1) => X i^k.val))

theorem base_independent {a m : ℕ} (ha : a ≤ m+1)
    (X : Fin a → ℂ) (hX : Function.Injective X) :
    LinearIndependent ℂ (fun i => fun k : Fin (m+1) => X i^k.val) := by
  have hv := P14SparseVandermondeJets.square_independent X hX
  rw [Fintype.linearIndependent_iff] at hv ⊢
  intro c hc
  apply hv c
  funext k
  have hk := congrFun hc (⟨k.val,by have := k.isLt; omega⟩ : Fin (m+1))
  simpa only [Finset.sum_apply,Pi.smul_apply,Pi.zero_apply] using hk

theorem base_dimension {a m : ℕ} (ha : a ≤ m+1)
    (X : Fin a → ℂ) (hX : Function.Injective X) :
    Module.finrank ℂ (baseSpan (m := m) X)=a := by
  have h : Module.finrank ℂ (baseSpan (m := m) X)=Fintype.card (Fin a) := by
    unfold baseSpan
    apply finrank_span_eq_card
    exact base_independent (m := m) ha X hX
  simpa only [Fintype.card_fin] using h

theorem base_not_le {q m a : ℕ} (hm : 3 ≤ m) (ha : 3 ≤ a)
    (hsize : m < q) (hq : q=2*(m-1)) (X : Fin a → ℂ) (hX : Function.Injective X) :
    ¬ baseSpan (m := m) X ≤ H q m := by
  intro hle
  have hv (i) : X i=1 ∨ X i=-1 :=
    power_mem_roots hm hsize hq (X i) (hle (Submodule.subset_span ⟨i,rfl⟩))
  let i : Fin a := ⟨0,by omega⟩
  let j : Fin a := ⟨1,by omega⟩
  let k : Fin a := ⟨2,by omega⟩
  have hij : X i ≠ X j := by
    intro h
    have hh := congrArg Fin.val (hX h)
    change 0=1 at hh
    omega
  have hik : X i ≠ X k := by
    intro h
    have hh := congrArg Fin.val (hX h)
    change 0=2 at hh
    omega
  have hjk : X j ≠ X k := by
    intro h
    have hh := congrArg Fin.val (hX h)
    change 1=2 at hh
    omega
  rcases hv i with hi | hi <;> rcases hv j with hj | hj <;>
    rcases hv k with hk | hk <;> aesop

end P14FourierParitySpace
end
end

section

/-! Parallel coefficient directions supply two-coordinate real kernel
circuits. Four geometric coefficients handle the order-two resonance. -/

noncomputable section
open scoped BigOperators
namespace P14ParallelRealKernel
open P14RealKernelCircuits

theorem pair_cancel (a b : ℂ) (h : area a b=0) :
    (Complex.normSq b : ℂ)*a-((a.re*b.re+a.im*b.im : ℝ) : ℂ)*b=0 := by
  apply Complex.ext <;>
    simp only [Complex.sub_re,Complex.sub_im,Complex.mul_re,Complex.mul_im,
      Complex.ofReal_re,Complex.ofReal_im,Complex.zero_re,Complex.zero_im,Complex.normSq_apply]
  · dsimp [area] at h
    linear_combination b.im*h
  · dsimp [area] at h
    linear_combination -b.re*h

theorem of_coordinate_witnesses {ι : Type*} [Fintype ι] (a : ι → ℂ)
    (h : ∀ i, ∃ t : ι → ℝ, constraint a t=0 ∧ t i ≠ 0) :
    ∃ t : ι → ℝ, (∑ i, (t i : ℂ)*a i)=0 ∧ ∀ i, t i ≠ 0 := by
  classical
  choose w hw hwn using h
  let P (i : ι) : MvPolynomial ι ℝ := ∑ j, MvPolynomial.C (w j i)*MvPolynomial.X j
  have heval (i : ι) (z : ι → ℝ) : MvPolynomial.eval z (P i)=∑ j, w j i*z j := by simp [P]
  have hp (i : ι) : P i ≠ 0 := by
    intro hh
    have hz : MvPolynomial.eval (Pi.single i 1) (P i)=0 := by rw [hh]; simp
    rw [heval] at hz
    exact hwn i (by simpa [Pi.single_apply] using hz)
  obtain ⟨z,hz⟩ := P14PolynomialThreeRows.exists_common_nonzero P hp
  let t : ι → ℝ := ∑ j, z j • w j
  refine ⟨t,?_,?_⟩
  · rw [←constraint_apply]
    simp only [t,map_sum,map_smul,hw,smul_zero,Finset.sum_const_zero]
  · intro i
    have hi := hz i
    rw [heval] at hi
    simpa [t,Finset.sum_apply,Pi.smul_apply,smul_eq_mul,mul_comm] using hi

theorem of_peers {ι : Type*} [Fintype ι] (a : ι → ℂ) (ha : ∀ i, a i ≠ 0)
    (h : ∀ i, ∃ j, i ≠ j ∧ area (a i) (a j)=0) :
    ∃ t : ι → ℝ, (∑ i, (t i : ℂ)*a i)=0 ∧ ∀ i, t i ≠ 0 := by
  classical
  apply of_coordinate_witnesses a
  intro i
  obtain ⟨j,hij,harea⟩ := h i
  let d : ℝ := (a i).re*(a j).re+(a i).im*(a j).im
  refine ⟨Pi.single i (Complex.normSq (a j))-Pi.single j d,?_,?_⟩
  · simp only [map_sub,constraint_single]
    exact pair_cancel (a i) (a j) harea
  · have hn : Complex.normSq (a j) ≠ 0 := fun hh => ha j (Complex.normSq_eq_zero.mp hh)
    simpa [Pi.single_apply,hij] using hn

theorem geometric_four {n : ℕ} (hn : 4 ≤ n) (a : Fin n → ℂ)
    (c r : ℂ) (hc : c ≠ 0) (hr : r ≠ 0) (hr1 : r ≠ 1)
    (ha : ∀ j, a j ≠ 0) (hstar : ∀ j, star (a j)=c*r^j.val*a j) :
    ∃ t : Fin n → ℝ, (∑ j, (t j : ℂ)*a j)=0 ∧ ∀ j, t j ≠ 0 := by
  by_cases h2 : r^2=1
  · apply of_peers a ha
    intro i
    have peer : ∃ j : Fin n, i ≠ j ∧ r^j.val=r^i.val := by
      by_cases hi : i.val < 2
      · let j : Fin n := ⟨i.val+2,by omega⟩
        refine ⟨j,?_,?_⟩
        · intro he
          have hh := congrArg Fin.val he
          change i.val=i.val+2 at hh
          omega
        · change r^(i.val+2)=r^i.val
          rw [pow_add,h2,mul_one]
      · let j : Fin n := ⟨i.val-2,by have := i.isLt; omega⟩
        refine ⟨j,?_,?_⟩
        · intro he
          have hh := congrArg Fin.val he
          change i.val=i.val-2 at hh
          omega
        · have he : i.val=(i.val-2)+2 := by omega
          change r^(i.val-2)=r^i.val
          conv_rhs => rw [he,pow_add,h2,mul_one]
    obtain ⟨j,hij,hpow⟩ := peer
    refine ⟨j,hij,?_⟩
    apply (P14RealKernelThree.area_zero_iff (a i) (a j)).mpr
    rw [hstar i,hstar j,hpow]
    ring
  · exact P14RealKernelThree.exists_of_geometric_ratios (by omega) a c r hc hr hr1 h2 ha hstar

end P14ParallelRealKernel
end
end

section

/-! A real two-coordinate constraint circuit separates a base subspace
whenever a known annihilator vanishes at one endpoint but not the other.
Both endpoints are kept inside the required support. -/

noncomputable section
open scoped BigOperators
namespace P14SupportedCircuitSeparation
open P14PhaseKernelSpan P14SplitKernelSpan P14RealKernelCircuits

theorem cmap_single {ι : Type*} [Fintype ι] [DecidableEq ι]
    (b : ι → ℂ) (i : ι) (z : ℂ) : cmap b (Pi.single i z)=z*b i := by
  rw [cmap_apply]
  simp [Pi.single_apply,apply_ite]

theorem exists_outside {ι : Type*} [Fintype ι]
    (a b : ι → ℂ) (p : ι → Prop) (S : Submodule ℂ (ι → ℂ))
    (hS : S ≤ LinearMap.ker (cmap b)) (i j : ι) (hi : p i) (hj : p j)
    (haj : a j ≠ 0) (hp : area (a i) (a j)=0) (hbi : b i ≠ 0) (hbj : b j=0) :
    ∃ t : Witness a p, row a p t ∉ S := by
  classical
  let d : ℝ := (a i).re*(a j).re+(a i).im*(a j).im
  let t : ι → ℝ := Pi.single i (Complex.normSq (a j))-Pi.single j d
  have ht : constraint a t=0 := by
    simp only [t,map_sub,constraint_single]
    exact P14ParallelRealKernel.pair_cancel (a i) (a j) hp
  have hs (k) (hk : ¬ p k) : t k=0 := by
    have hki : k ≠ i := by intro h; apply hk; simpa only [h] using hi
    have hkj : k ≠ j := by intro h; apply hk; simpa only [h] using hj
    simp [t,Pi.single_apply,hki,hkj]
  let w : Witness a p := ⟨t,ht,hs⟩
  have hw : row a p w =
      Pi.single i (Complex.normSq (a j) : ℂ)-Pi.single j (d : ℂ) := by
    funext k
    simp only [row,w,t,Pi.sub_apply,Pi.single_apply,Complex.ofReal_sub]
    split_ifs <;> rfl
  have hn : Complex.normSq (a j) ≠ 0 := fun h => haj (Complex.normSq_eq_zero.mp h)
  have hval : cmap b (row a p w) ≠ 0 := by
    rw [hw,map_sub,cmap_single,cmap_single,hbj,mul_zero,sub_zero]
    exact mul_ne_zero (Complex.ofReal_ne_zero.mpr hn) hbi
  exact ⟨w,fun h => hval (LinearMap.mem_ker.mp (hS h))⟩

end P14SupportedCircuitSeparation
end
end

section

/-!
An ordinary complex polynomial represents the existing spectral product at
retained frequencies. The original natural subtraction is kept unchanged.
Only a degree bound and the constant coefficient are asserted.
-/

noncomputable section

namespace P14FourierSpectralPolynomial

open P14FourierSpectralWeights
open scoped BigOperators

theorem spectralWeight_eq_zero_of_lt (ζ : ℂ) (d q : ℕ) (hq : q < d) :
    spectralWeight ζ d q = 0 := by
  unfold spectralWeight
  apply Finset.prod_eq_zero (Finset.mem_univ (⟨q, hq⟩ : Fin d))
  simp only [Nat.sub_self, pow_zero, sub_self]

def spectralPolynomial (ζ : ℂ) (d : ℕ) : Polynomial ℂ :=
  ∏ t : Fin d, (1 - Polynomial.C ((ζ ^ t.val)⁻¹) * Polynomial.X)

theorem eval_spectralPolynomial (ζ : ℂ) (d q : ℕ)
    (hdq : d ≤ q) (hζ : ζ ≠ 0) :
    (spectralPolynomial ζ d).eval (ζ ^ q) = spectralWeight ζ d q := by
  unfold spectralPolynomial spectralWeight
  rw [Polynomial.eval_prod]
  apply Finset.prod_congr rfl
  intro t _
  rw [Polynomial.eval_sub, Polynomial.eval_one, Polynomial.eval_C_mul, Polynomial.eval_X,
    pow_sub₀ ζ hζ ((Nat.le_of_lt t.isLt).trans hdq), mul_comm]

theorem natDegree_spectralPolynomial_le (ζ : ℂ) (d : ℕ) :
    (spectralPolynomial ζ d).natDegree ≤ d := by
  have hf (t : Fin d) :
      (1 - Polynomial.C ((ζ ^ t.val)⁻¹) * Polynomial.X : Polynomial ℂ).natDegree ≤ 1 := by
    apply (Polynomial.natDegree_sub_le _ _).trans
    apply max_le
    · simpa only [Polynomial.natDegree_one] using (Nat.zero_le 1)
    · simpa only [pow_one] using Polynomial.natDegree_C_mul_X_pow_le ((ζ ^ t.val)⁻¹) 1
  unfold spectralPolynomial
  calc
    _ ≤ ∑ t : Fin d,
        (1 - Polynomial.C ((ζ ^ t.val)⁻¹) * Polynomial.X : Polynomial ℂ).natDegree :=
      Polynomial.natDegree_prod_le Finset.univ _
    _ ≤ ∑ _t : Fin d, (1 : ℕ) := Finset.sum_le_sum (fun t _ => hf t)
    _ = d := by simp

theorem spectralPolynomial_coeff_zero (ζ : ℂ) (d : ℕ) :
    (spectralPolynomial ζ d).coeff 0 = 1 := by
  rw [Polynomial.coeff_zero_eq_eval_zero]
  simp only [spectralPolynomial, Polynomial.eval_prod, Polynomial.eval_sub,
    Polynomial.eval_one, Polynomial.eval_C_mul, Polynomial.eval_X,
    mul_zero, sub_zero, Finset.prod_const_one]


end P14FourierSpectralPolynomial
end
end

section

/-!
Finite coefficient expansion of a weighted conjugated polynomial evaluation.
This identity does not assume root orthogonality or any coefficient support.
-/

namespace P14FourierPolynomialExpansion

open scoped BigOperators

theorem eval_eq_sum_fin {n : ℕ} (P : Polynomial ℂ)
    (hdeg : P.natDegree < n) (z : ℂ) :
    P.eval z = ∑ j : Fin n, P.coeff j.val * z ^ j.val := by
  rw [Polynomial.eval_eq_sum_range' hdeg]
  exact (Fin.sum_univ_eq_sum_range (fun j => P.coeff j * z ^ j) n).symm

theorem weighted_star_eval_sum {n : ℕ} (P : Polynomial ℂ)
    (hdeg : P.natDegree < n) (w z : Fin n → ℂ) :
    (∑ q : Fin n, w q * star (P.eval (z q))) =
      ∑ j : Fin n, star (P.coeff j.val) *
        ∑ q : Fin n, w q * star ((z q) ^ j.val) := by
  simp_rw [eval_eq_sum_fin P hdeg, star_sum, star_mul, Finset.mul_sum]
  rw [Finset.sum_comm]
  apply Finset.sum_congr rfl
  intro j _
  apply Finset.sum_congr rfl
  intro q _
  ring


end P14FourierPolynomialExpansion
end

section

/-! Explicit even and odd real Fourier circuits have nonzero images
modulo the base Vandermonde span. Polynomial coefficient functionals
prove separation, with no assumed generic-rank condition. -/

noncomputable section
open scoped BigOperators
namespace P14PolynomialParityCircuits
open Polynomial P14PhaseKernelSpan P14SplitKernelSpan P14FourierParitySpace
open P14PolynomialRootInterpolation

theorem base_le_ker {a m : ℕ} (Z : Fin a → ℂ) (Q : ℂ[X])
    (hQ : Q.natDegree ≤ m) (hz : ∀ i, Q.eval (Z i)=0) :
    baseSpan (m := m) Z ≤ LinearMap.ker (cmap (fun k : Fin (m+1) => Q.coeff k.val)) := by
  apply Submodule.span_le.mpr
  rintro _ ⟨i,rfl⟩
  apply LinearMap.mem_ker.mpr
  have he := P14FourierPolynomialExpansion.eval_eq_sum_fin Q
    (lt_of_le_of_lt hQ (Nat.lt_succ_self m)) (Z i)
  simpa only [cmap_apply,mul_comm,hz i] using he.symm

theorem parallel {q m : ℕ} (hm : 2 ≤ m) (hsize : m < q) (hq : q=2*(m-1))
    (i j : Fin (m+1)) (hp : Even i.val ↔ Even j.val) :
    P14RealKernelCircuits.area (weights q m i) (weights q m j)=0 := by
  apply (P14RealKernelThree.area_zero_iff _ _).mpr
  rw [conjugation hm hsize hq i,conjugation hm hsize hq j,
    neg_one_pow_congr hp]
  ring

theorem even_witness {q a : ℕ} (ha : 3 ≤ a) (hodd : Odd a)
    (hsize : a+2 < q) (hq : q=2*(a+1)) (Z : Fin a → ℂ) :
    ∃ t : Witness (weights q (a+2)) (evenCoord (a+2)),
      row _ _ t ∉ baseSpan (m := a+2) Z := by
  classical
  let P : ℂ[X] := rootPolynomial Z
  let Q : ℂ[X] := Polynomial.X*P
  let i : Fin (a+2+1) := ⟨a+1,by omega⟩
  let j : Fin (a+2+1) := 0
  have hi : evenCoord (a+2) i := hodd.add_odd odd_one
  have hj : evenCoord (a+2) j := by norm_num [evenCoord,j]
  have hQ : Q.natDegree ≤ a+2 := by
    calc
      _ ≤ (Polynomial.X : ℂ[X]).natDegree+P.natDegree := natDegree_mul_le
      _ = 1+a := by simp [P,rootPolynomial_natDegree]
      _ ≤ a+2 := by omega
  have hroot (k) : Q.eval (Z k)=0 := by
    simp [Q,P,rootPolynomial_eval_root]
  have hbi : Q.coeff i.val ≠ 0 := by
    change (Polynomial.X*P).coeff (a+1) ≠ 0
    rw [coeff_X_mul]
    change (rootPolynomial Z).coeff a ≠ 0
    rw [rootPolynomial_coeff_top]
    exact one_ne_zero
  have hbj : Q.coeff j.val=0 := by
    change (Polynomial.X*P).coeff 0=0
    exact coeff_X_mul_zero P
  have hp : P14RealKernelCircuits.area (weights q (a+2) i) (weights q (a+2) j)=0 :=
    parallel (by omega) hsize (by omega) i j (by change evenCoord (a+2) i ↔ evenCoord (a+2) j; tauto)
  exact P14SupportedCircuitSeparation.exists_outside (weights q (a+2))
    (fun k => Q.coeff k.val) (evenCoord (a+2)) (baseSpan Z)
    (base_le_ker Z Q hQ hroot) i j hi hj (weights_ne_zero hsize j) hp hbi hbj

theorem odd_witness {q a : ℕ} (ha : 3 ≤ a) (hodd : Odd a)
    (hsize : a+2 < q) (hq : q=2*(a+1)) (Z : Fin a → ℂ) :
    ∃ t : Witness (weights q (a+2)) (fun k => ¬ evenCoord (a+2) k),
      row _ _ t ∉ baseSpan (m := a+2) Z := by
  classical
  let P : ℂ[X] := rootPolynomial Z
  let i : Fin (a+2+1) := ⟨a,by omega⟩
  let j : Fin (a+2+1) := ⟨a+2,by omega⟩
  have hi : ¬ evenCoord (a+2) i := Nat.not_even_iff_odd.mpr hodd
  have hj : ¬ evenCoord (a+2) j :=
    Nat.not_even_iff_odd.mpr (hodd.add_even (by decide : Even 2))
  have hP : P.natDegree ≤ a+2 := by dsimp [P]; rw [rootPolynomial_natDegree]; omega
  have hroot (k) : P.eval (Z k)=0 := rootPolynomial_eval_root Z k
  have hbi : P.coeff i.val ≠ 0 := by
    change (rootPolynomial Z).coeff a ≠ 0
    rw [rootPolynomial_coeff_top]
    exact one_ne_zero
  have hbj : P.coeff j.val=0 := by
    apply coeff_eq_zero_of_natDegree_lt
    change P.natDegree < a+2
    dsimp [P]
    rw [rootPolynomial_natDegree]
    omega
  have hp : P14RealKernelCircuits.area (weights q (a+2) i) (weights q (a+2) j)=0 :=
    parallel (by omega) hsize (by omega) i j (by change evenCoord (a+2) i ↔ evenCoord (a+2) j; tauto)
  exact P14SupportedCircuitSeparation.exists_outside (weights q (a+2))
    (fun k => P.coeff k.val) (fun k => ¬ evenCoord (a+2) k) (baseSpan Z)
    (base_le_ker Z P hP hroot) i j hi hj (weights_ne_zero hsize j) hp hbi hbj

end P14PolynomialParityCircuits
end
end

section

/-! Spaced final columns handle two collision rows with distinct squared
nodes. The real kernel circuit is supported on the two endpoints of
a three-coordinate window; no full-support middle coordinate is assumed. -/

noncomputable section
open scoped BigOperators
namespace P14SparseSquaredJets
open P14SparseVandermondeJets P14RealKernelCircuits

theorem block_columns {a b : ℕ} {κ : Type*}
    (v : Fin a → κ → ℂ) (w : Fin b → κ → ℂ)
    (l : Fin a → κ) (r : Fin b → κ)
    (hv : LinearIndependent ℂ (fun i k => v i (l k)))
    (hw : LinearIndependent ℂ (fun i k => w i (r k)))
    (hz : ∀ i k, w i (l k)=0) :
    LinearIndependent ℂ (Sum.elim v w) := by
  rw [Fintype.linearIndependent_iff] at hv hw ⊢
  intro c hc
  have hb : ∑ i, c (Sum.inl i) • (fun k => v i (l k))=0 := by
    funext k
    have hk := congrFun hc (l k)
    simpa only [Fintype.sum_sum_type,Finset.sum_apply,Pi.smul_apply,smul_eq_mul,
      Sum.elim_inl,Sum.elim_inr,hz,mul_zero,Finset.sum_const_zero,add_zero,Pi.zero_apply] using hk
  have hcb := hv _ hb
  have ht : ∑ i, c (Sum.inr i) • (fun k => w i (r k))=0 := by
    funext k
    have hk := congrFun hc (r k)
    simpa only [Fintype.sum_sum_type,Finset.sum_apply,Pi.smul_apply,smul_eq_mul,
      Sum.elim_inl,Sum.elim_inr,hcb,zero_mul,Finset.sum_const_zero,zero_add,Pi.zero_apply] using hk
  have hct := hw _ ht
  intro i
  cases i with
  | inl i => exact hcb i
  | inr i => exact hct i

def spaced {a : ℕ} (k : Fin 2) : Fin (a+2+1) := ⟨a+2*k.val,by omega⟩

theorem sparse_independent {a : ℕ} (X : Fin a → ℂ) (Y : Fin 2 → ℂ)
    (hX : Function.Injective X) (hY : Function.Injective (fun i => Y i ^ 2))
    (hYn : ∀ i, Y i ≠ 0) (t : Fin (a+2+1) → ℂ)
    (ht0 : ∀ k, t (first k)=0) (htn : ∀ k, t (spaced k) ≠ 0) :
    LinearIndependent ℂ
      (Sum.elim (fun i k => X i ^ k.val) (fun i k => t k * Y i ^ k.val)) := by
  apply block_columns _ _ first spaced
  · exact square_independent X hX
  · have hy := P14CubicRowOperations.row_scale
      (fun i => fun k : Fin 2 => (Y i ^ 2) ^ k.val) (fun i => Y i ^ a)
      (fun i => pow_ne_zero _ (hYn i)) (square_independent (fun i => Y i ^ 2) hY)
    have hs := P14CubicFourierJets.column_scale _ (fun k => t (spaced k)) htn hy
    convert! hs using 1
    funext i k
    change t (spaced k) * Y i ^ (a+2*k.val) =
      (Y i ^ a * (Y i ^ 2) ^ k.val) * t (spaced k)
    rw [pow_add,pow_mul]
    ring
  · intro i k
    rw [ht0 k,zero_mul]

theorem endpoint_kernel (A : Fin 3 → ℂ) (hA : ∀ i, A i ≠ 0)
    (harea : area (A 0) (A 2)=0) :
    ∃ t : Fin 3 → ℝ, (∑ i, (t i : ℂ)*A i)=0 ∧ t 0 ≠ 0 ∧ t 2 ≠ 0 := by
  let d : ℝ := (A 0).re*(A 2).re+(A 0).im*(A 2).im
  have hn : Complex.normSq (A 2) ≠ 0 :=
    fun hh => hA 2 (Complex.normSq_eq_zero.mp hh)
  have hd : d ≠ 0 := by
    intro hz
    have hc := P14ParallelRealKernel.pair_cancel (A 0) (A 2) harea
    change (Complex.normSq (A 2) : ℂ)*A 0-(d : ℂ)*A 2=0 at hc
    rw [hz,Complex.ofReal_zero,zero_mul,sub_zero] at hc
    exact (mul_ne_zero (Complex.ofReal_ne_zero.mpr hn) (hA 0)) hc
  refine ⟨![Complex.normSq (A 2),0,-d],?_,by simpa using hn,by simpa using hd⟩
  convert! P14ParallelRealKernel.pair_cancel (A 0) (A 2) harea using 1 <;>
    simp [Fin.sum_univ_succ,d,sub_eq_add_neg] <;> ring

end P14SparseSquaredJets

end
end

section

/-! A two-family independent-transversal lemma, and a direct quotient
criterion for extending a finite independent family. These are linear
algebra tools for the remaining antipodal circuit argument. -/

noncomputable section
open scoped BigOperators
namespace P14CrossCircuitPairs
open Submodule

variable {V : Type*} [AddCommGroup V] [Module ℂ V]

theorem dependent_mem_line {x y : V} (hx : x ≠ 0)
    (h : ¬ LinearIndependent ℂ ![x,y]) : y ∈ span ℂ {x} := by
  rw [LinearIndependent.pair_iff' hx] at h
  push Not at h
  obtain ⟨a,ha⟩ := h
  rw [←ha]
  exact (span ℂ {x}).smul_mem a (subset_span (by simp))

theorem exists_cross_pair {ι κ : Type*} (E : ι → V) (F : κ → V)
    (he : ∃ i, E i ≠ 0) (hf : ∃ j, F j ≠ 0)
    (hwide : ∀ z : V, z ≠ 0 →
      ¬ span ℂ (Set.range E ∪ Set.range F) ≤ span ℂ {z}) :
    ∃ i j, LinearIndependent ℂ ![E i,F j] := by
  classical
  by_contra hn
  push Not at hn
  obtain ⟨i0,hi0⟩ := he
  obtain ⟨j0,hj0⟩ := hf
  have hF (j) : F j ∈ span ℂ {E i0} := dependent_mem_line hi0 (hn i0 j)
  have hE (i) : E i ∈ span ℂ {E i0} := by
    have h : E i ∈ span ℂ {F j0} := dependent_mem_line hj0
      (fun he => hn i j0 (LinearIndependent.pair_symm_iff.mp he))
    exact (span_le.mpr (by simpa using hF j0)) h
  apply hwide (E i0) hi0
  apply span_le.mpr
  rintro v (⟨i,rfl⟩ | ⟨j,rfl⟩)
  · exact hE i
  · exact hF j

theorem sum_of_quotient {ι κ : Type*} [Fintype ι] [Fintype κ]
    (S : Submodule ℂ V) (v : ι → V) (w : κ → V)
    (hv : LinearIndependent ℂ v) (hmem : ∀ i, v i ∈ S)
    (hw : LinearIndependent ℂ (fun j => S.mkQ (w j))) :
    LinearIndependent ℂ (Sum.elim v w) := by
  have hz (i) : S.mkQ (v i)=0 := by
    apply LinearMap.mem_ker.mp
    simpa only [Submodule.ker_mkQ] using hmem i
  rw [Fintype.linearIndependent_iff] at hv hw ⊢
  intro c hc
  have hq := congrArg S.mkQ hc
  simp only [map_sum,map_smul,map_zero,map_add,Fintype.sum_sum_type,
    Sum.elim_inl,Sum.elim_inr,hz,smul_zero,Finset.sum_const_zero,zero_add] at hq
  have hcw := hw _ hq
  have hb : ∑ i, c (Sum.inl i) • v i=0 := by
    simpa only [Fintype.sum_sum_type,Sum.elim_inl,Sum.elim_inr,hcw,
      zero_smul,Finset.sum_const_zero,add_zero] using hc
  have hcv := hv _ hb
  intro i
  cases i with
  | inl i => exact hcv i
  | inr i => exact hcw i

end P14CrossCircuitPairs
end
end

section

/-! A subspace at least one dimension larger than S, but not containing
S, has quotient image wider than a line. This discharges the width
premise for cross-family circuit selection from concrete dimension data. -/

noncomputable section
namespace P14QuotientCircuitWidth
open Submodule
variable {V : Type*} [AddCommGroup V] [Module ℂ V] [FiniteDimensional ℂ V]

theorem quotient_not_line (S H : Submodule ℂ V)
    (hd : Module.finrank ℂ S+1 ≤ Module.finrank ℂ H) (hnot : ¬ S ≤ H)
    (z : V ⧸ S) (hz : z ≠ 0) :
    ¬ H.map S.mkQ ≤ span ℂ {z} := by
  intro hline
  obtain ⟨v,hv⟩ := (LinearMap.range_eq_top.mp S.range_mkQ) z
  have hvS : v ∉ S := by
    intro h
    have hzero : S.mkQ v=0 := LinearMap.mem_ker.mp (by simpa only [ker_mkQ] using h)
    exact hz (hv.symm.trans hzero)
  have hHT : H ≤ S ⊔ span ℂ {v} := by
    intro x hx
    have hm : S.mkQ x ∈ H.map S.mkQ := ⟨x,hx,rfl⟩
    obtain ⟨c,hc⟩ := mem_span_singleton.mp (hline hm)
    have hs : x-c • v ∈ S := by
      have hk : x-c • v ∈ LinearMap.ker S.mkQ := by
        apply LinearMap.mem_ker.mpr
        rw [map_sub,map_smul,hv,←hc,sub_self]
      simpa only [ker_mkQ] using hk
    have hw : c • v ∈ S ⊔ span ℂ {v} :=
      (S ⊔ span ℂ {v}).smul_mem c ((show span ℂ {v} ≤ S ⊔ span ℂ {v} from le_sup_right) (subset_span (by simp)))
    have hh := (S ⊔ span ℂ {v}).add_mem ((show S ≤ S ⊔ span ℂ {v} from le_sup_left) hs) hw
    simpa only [sub_add_cancel] using hh
  have heq : H=S ⊔ span ℂ {v} := by
    apply Submodule.eq_of_le_of_finrank_le hHT
    rw [Submodule.finrank_sup_span_singleton hvS]
    exact hd
  apply hnot
  rw [heq]
  exact le_sup_left

theorem cross_pair {ι κ : Type*} (S H : Submodule ℂ V) (E : ι → V) (F : κ → V)
    (hspan : span ℂ (Set.range E ∪ Set.range F)=H)
    (hd : Module.finrank ℂ S+1 ≤ Module.finrank ℂ H) (hnot : ¬ S ≤ H)
    (he : ∃ i, S.mkQ (E i) ≠ 0) (hf : ∃ j, S.mkQ (F j) ≠ 0) :
    ∃ i j, LinearIndependent ℂ ![S.mkQ (E i),S.mkQ (F j)] := by
  apply P14CrossCircuitPairs.exists_cross_pair _ _ he hf
  intro z hz h
  apply quotient_not_line S H hd hnot z hz
  apply map_le_iff_le_comap.mpr
  rw [←hspan]
  apply span_le.mpr
  rintro _ (⟨i,rfl⟩ | ⟨j,rfl⟩)
  · change S.mkQ (E i) ∈ span ℂ {z}
    exact h (subset_span (Or.inl ⟨i,rfl⟩))
  · change S.mkQ (F j) ∈ span ℂ {z}
    exact h (subset_span (Or.inr ⟨j,rfl⟩))

end P14QuotientCircuitWidth
end
end

section

/-! Actual antipodal collision rank at the normalized nodes 1 and -1.
Supported real Fourier kernels, their proved dimension/noncontainment,
and explicit polynomial-separated witnesses discharge every width premise. -/

noncomputable section
open scoped BigOperators
namespace P14AntipodalNormalizedJets
open P14PhaseKernelSpan P14SplitKernelSpan P14FourierParitySpace

theorem sum_diff {V : Type*} [AddCommGroup V] [Module ℂ V] {u v : V}
    (h : LinearIndependent ℂ ![u,v]) :
    LinearIndependent ℂ ![u+v,u-v] := by
  rw [LinearIndependent.pair_iff] at h ⊢
  intro s t hst
  have hh : (s+t) • u+(s-t) • v=0 := by
    calc
      _ = s • (u+v)+t • (u-v) := by
        simp only [add_smul,sub_smul,smul_add,smul_sub]
        abel
      _ = 0 := hst
  obtain ⟨h1,h2⟩ := h (s+t) (s-t) hh
  constructor
  · linear_combination (1/2 : ℂ)*h1+(1/2 : ℂ)*h2
  · linear_combination (1/2 : ℂ)*h1-(1/2 : ℂ)*h2

theorem normalized {q a : ℕ} (ha : 3 ≤ a) (hodd : Odd a)
    (hsize : a+2 < q) (hq : q=2*(a+1)) (Z : Fin a → ℂ)
    (hZ : Function.Injective Z) :
    ∃ t : Fin (a+2+1) → ℝ,
      (∑ k, (t k : ℂ)*weights q (a+2) k)=0 ∧
      LinearIndependent ℂ (Sum.elim
        (fun i => fun k : Fin (a+2+1) => Z i^k.val)
        (fun j : Fin 2 => fun k => (t k : ℂ)*(![(1 : ℂ),-1] j)^k.val)) := by
  classical
  let S := baseSpan (m := a+2) Z
  let E := row (weights q (a+2)) (evenCoord (a+2))
  let O := row (weights q (a+2)) (fun k => ¬ evenCoord (a+2) k)
  have hE : ∃ u, S.mkQ (E u) ≠ 0 := by
    obtain ⟨u,hu⟩ := P14PolynomialParityCircuits.even_witness ha hodd hsize hq Z
    refine ⟨u,?_⟩
    intro hz
    apply hu
    have hm := LinearMap.mem_ker.mpr hz
    simpa only [Submodule.ker_mkQ] using hm
  have hO : ∃ v, S.mkQ (O v) ≠ 0 := by
    obtain ⟨v,hv⟩ := P14PolynomialParityCircuits.odd_witness ha hodd hsize hq Z
    refine ⟨v,?_⟩
    intro hz
    apply hv
    have hm := LinearMap.mem_ker.mpr hz
    simpa only [Submodule.ker_mkQ] using hm
  have hdim : Module.finrank ℂ S+1 ≤ Module.finrank ℂ (H q (a+2)) := by
    rw [show Module.finrank ℂ S=a from base_dimension (by omega) Z hZ]
    have hd := dimension_lower q (a+2)
    omega
  have hspan : Submodule.span ℂ (Set.range E ∪ Set.range O)=H q (a+2) :=
    real_span (by omega) hsize (by omega)
  have hnot : ¬ S ≤ H q (a+2) := base_not_le (by omega) ha hsize (by omega) Z hZ
  obtain ⟨u,v,huv⟩ := P14QuotientCircuitWidth.cross_pair S (H q (a+2)) E O
    hspan hdim hnot hE hO
  let t : Fin (a+2+1) → ℝ := u.val+v.val
  have ht : P14RealKernelCircuits.constraint (weights q (a+2)) t=0 := by
    rw [map_add,u.property.1,v.property.1,add_zero]
  let J : Fin 2 → Fin (a+2+1) → ℂ :=
    fun j k => (t k : ℂ)*(![(1 : ℂ),-1] j)^k.val
  have hJ : J=![E u+O v,E u-O v] := by
    funext j k
    fin_cases j
    · simp [J,t,E,O,row,Pi.add_apply]
    · by_cases hk : Even k.val
      · have hv : v.val k=0 := v.property.2 k (by simpa only [evenCoord,not_not] using hk)
        simp [J,t,E,O,row,Pi.add_apply,Pi.sub_apply,neg_one_pow_eq_ite,hk,hv]
      · have hu : u.val k=0 := u.property.2 k hk
        simp [J,t,E,O,row,Pi.add_apply,Pi.sub_apply,neg_one_pow_eq_ite,hk,hu]
  have hqJ : LinearIndependent ℂ (fun j => S.mkQ (J j)) := by
    rw [hJ]
    convert! sum_diff huv using 1
    funext j
    fin_cases j <;> simp [map_add,map_sub]
  refine ⟨t,(P14RealKernelCircuits.constraint_apply _ t).symm.trans ht,?_⟩
  exact P14CrossCircuitPairs.sum_of_quotient S _ J
    (base_independent (by omega) Z hZ)
    (fun i => Submodule.subset_span ⟨i,rfl⟩) hqJ

end P14AntipodalNormalizedJets

end
end

section

/-! Arbitrarily many consecutive zeros on a finite Fourier grid, with
strictly positive values at all remaining grid nodes. -/

noncomputable section
open scoped BigOperators
namespace P14ConsecutiveGridProducts
open P14ConsecutiveFourGridSigns

def pairGap (q v k : ℕ) : ℝ :=
  Real.cos (angle q)-Real.cos ((2*(k:ℝ)-2*(v:ℝ)-1)*angle q)

def evenGrid (q r k : ℕ) : ℝ := ∏ j : Fin r, pairGap q (2*j.val) k
def oddGrid (q r k : ℕ) : ℝ :=
  (1-Real.cos (2*(k:ℝ)*angle q))*∏ j : Fin r, pairGap q (2*j.val+1) k
def grid (q n k : ℕ) : ℝ :=
  if n%2=0 then evenGrid q (n/2) k else oddGrid q (n/2) k

theorem pair_left (q v : ℕ) : pairGap q v v=0 := by
  simp [pairGap,Real.cos_neg]

theorem pair_right (q v : ℕ) : pairGap q v (v+1)=0 := by
  unfold pairGap
  push_cast
  rw [show (2*((v:ℝ)+1)-2*(v:ℝ)-1)*angle q=angle q by ring]
  exact sub_self _

theorem pair_positive {q v k : ℕ} (hv : v+1 < k) (hk : k < q) :
    0 < pairGap q v k := by
  have hvR : (v:ℝ)+1 < k := by exact_mod_cast hv
  have hkR : (k:ℝ) < q := by exact_mod_cast hk
  have h0 : (0:ℝ) ≤ v := Nat.cast_nonneg _
  exact gap_positive (by omega) (2*(k:ℝ)-2*(v:ℝ)-1) (by linarith) (by linarith)

theorem even_zero {q r k : ℕ} (hk : k < 2*r) : evenGrid q r k=0 := by
  let j : Fin r := ⟨k/2,by omega⟩
  apply Finset.prod_eq_zero (Finset.mem_univ j)
  have h : k=2*j.val ∨ k=2*j.val+1 := by dsimp [j]; omega
  rcases h with h|h
  · rw [h]
    exact pair_left _ _
  · rw [h]
    exact pair_right _ _

theorem odd_zero {q r k : ℕ} (hk : k < 2*r+1) : oddGrid q r k=0 := by
  by_cases h0 : k=0
  · simp [oddGrid,h0]
  · have hz : (∏ j : Fin r, pairGap q (2*j.val+1) k)=0 := by
      let j : Fin r := ⟨(k-1)/2,by omega⟩
      apply Finset.prod_eq_zero (Finset.mem_univ j)
      have h : k=2*j.val+1 ∨ k=(2*j.val+1)+1 := by dsimp [j]; omega
      rcases h with h|h
      · rw [h]
        exact pair_left _ _
      · rw [h]
        exact pair_right _ _
    rw [oddGrid,hz,mul_zero]

theorem even_positive {q r k : ℕ} (hr : 2*r ≤ k) (hk : k < q) :
    0 < evenGrid q r k := by
  apply Finset.prod_pos
  intro j _
  exact pair_positive (by have := j.isLt; omega) hk

theorem odd_positive {q r k : ℕ} (hr : 2*r+1 ≤ k) (hk : k < q) :
    0 < oddGrid q r k := by
  apply mul_pos (P14ConsecutiveFiveGridSigns.first_positive (by omega) hk)
  apply Finset.prod_pos
  intro j _
  exact pair_positive (by have := j.isLt; omega) hk

theorem grid_zero {q n k : ℕ} (hk : k < n) : grid q n k=0 := by
  unfold grid
  split_ifs with h
  · apply even_zero
    omega
  · apply odd_zero
    omega

theorem grid_positive {q n k : ℕ} (hn : n ≤ k) (hk : k < q) : 0 < grid q n k := by
  unfold grid
  split_ifs with h
  · exact even_positive (by omega) hk
  · exact odd_positive (by omega) hk

theorem grid_zero_iff {q n k : ℕ} (hk : k < q) : grid q n k=0 ↔ k < n := by
  constructor
  · intro h
    by_contra hn
    exact (grid_positive (by omega) hk).ne' h
  · exact grid_zero

theorem grid_nonnegative {q n k : ℕ} (hk : k < q) : 0 ≤ grid q n k := by
  by_cases h : k < n
  · rw [grid_zero h]
  · exact (grid_positive (by omega) hk).le

end P14ConsecutiveGridProducts
end
end

section

/-! A product of r affine real-part gaps on the unit circle is the real
part of an ordinary complex polynomial of degree at most r. The explicit
one-step construction folds the only negative frequency into a conjugate
positive frequency; no spectral factorization is assumed. -/

noncomputable section
open scoped BigOperators
namespace P14RealPartPolynomialProduct
open Polynomial

def multiply (c : ℝ) (d : ℂ) (P : ℂ[X]) : ℂ[X] :=
  C (c : ℂ)*P-C (1/2 : ℂ)*
    (C d*(P*X)+C (star d)*P.divX+C (d*star (P.coeff 0))*X)

theorem real_identity (d u p z : ℂ) (hz : star z*z=1) :
    (d*((u*z+p)*z)+star d*u+(d*star p)*z).re =
      2*(d*z).re*(u*z+p).re := by
  have h : star (d*z)*(u*z+p)=star d*u+star ((d*star p)*z) := by
    simp only [star_mul,star_star]
    calc
      _ = star d*u*(star z*z)+star z*p*star d := by ring
      _ = _ := by rw [hz]; ring
  have hr (a b : ℂ) : (a*b+star a*b).re=2*a.re*b.re := by
    simp only [Complex.add_re,Complex.mul_re,Complex.star_def,Complex.conj_re,Complex.conj_im]
    ring
  have hh := hr (d*z) (u*z+p)
  rw [h] at hh
  simpa only [Complex.add_re,Complex.star_def,Complex.conj_re,
    mul_assoc,mul_comm,mul_left_comm,add_assoc] using hh

theorem multiply_eval (c : ℝ) (d : ℂ) (P : ℂ[X]) (z : ℂ) (hz : star z*z=1) :
    ((multiply c d P).eval z).re=(c-(d*z).re)*(P.eval z).re := by
  have he : P.divX.eval z*z+P.coeff 0=P.eval z := by
    have hh := congrArg (fun Q : ℂ[X] => Q.eval z) (divX_mul_X_add P)
    simpa only [eval_add,eval_mul,eval_X,eval_C] using hh
  have h := real_identity d (P.divX.eval z) (P.coeff 0) z hz
  rw [he] at h
  simp only [multiply,eval_sub,eval_add,eval_mul,eval_C,eval_X]
  change ((c : ℂ)*P.eval z-(1/2:ℂ)*
    (d*(P.eval z*z)+star d*P.divX.eval z+(d*star (P.coeff 0))*z)).re=_
  rw [Complex.sub_re,Complex.mul_re,Complex.mul_re,h]
  norm_num
  ring

theorem multiply_degree (c : ℝ) (d : ℂ) (P : ℂ[X]) :
    (multiply c d P).natDegree ≤ P.natDegree+1 := by
  have hp : (P*X).natDegree ≤ P.natDegree+1 := by simpa using (natDegree_mul_le (p := P) (q := X))
  have h1 : (C d*(P*X)).natDegree ≤ P.natDegree+1 := (natDegree_C_mul_le _ _).trans hp
  have h2 : (C (star d)*P.divX).natDegree ≤ P.natDegree+1 :=
    (natDegree_C_mul_le _ _).trans (natDegree_divX_le.trans (Nat.le_succ _))
  have h3 : (C (d*star (P.coeff 0))*X).natDegree ≤ P.natDegree+1 :=
    (natDegree_C_mul_le _ _).trans (by simp)
  exact (natDegree_sub_le _ _).trans (max_le
    ((natDegree_C_mul_le _ _).trans (Nat.le_succ _))
    ((natDegree_C_mul_le _ _).trans ((natDegree_add_le _ _).trans
      (max_le ((natDegree_add_le _ _).trans (max_le h1 h2)) h3))))

theorem exists_product (r : ℕ) (c : Fin r → ℝ) (d : Fin r → ℂ) :
    ∃ P : ℂ[X], P.natDegree ≤ r ∧ ∀ z : ℂ, star z*z=1 →
      (P.eval z).re=∏ j, (c j-(d j*z).re) := by
  induction r with
  | zero =>
      exact ⟨1,by simp,by intro z hz; simp⟩
  | succ r ih =>
      obtain ⟨P,hP,hval⟩ := ih (fun j => c j.castSucc) (fun j => d j.castSucc)
      refine ⟨multiply (c (Fin.last r)) (d (Fin.last r)) P,
        (multiply_degree _ _ _).trans (by omega),?_⟩
      intro z hz
      rw [multiply_eval _ _ _ _ hz,hval z hz,Fin.prod_univ_castSucc]
      ring

end P14RealPartPolynomialProduct
end
end

section

/-! A genuine low-degree polynomial with zero real part on every retained
Fourier frequency and negative real part at every remaining frequency. -/

noncomputable section
open scoped BigOperators
namespace P14ConsecutiveGridPolynomial
open Polynomial P14ConsecutiveFourGridSigns P14ConsecutiveGridProducts
open P14QuadraticFourierTarget P14FourierSpectralWeights

def pairPhase (q v : ℕ) : ℂ := phase (-(2*(v:ℝ)+1)*angle q)

theorem pair_eval (q v k : ℕ) :
    Real.cos (angle q)-(pairPhase q v*fourierRoot q^k).re=pairGap q v k := by
  rw [pairPhase,root_power,phase_mul,phase_re]
  unfold pairGap
  congr 2
  ring

theorem root_unit (q k : ℕ) : star (fourierRoot q^k)*fourierRoot q^k=1 := by
  have hn : Complex.normSq (fourierRoot q^k)=1 := by rw [root_power,phase_normSq]
  change (starRingEnd ℂ) (fourierRoot q^k)*fourierRoot q^k=1
  rw [←Complex.normSq_eq_conj_mul_self,hn]
  rfl

theorem even_polynomial (q r : ℕ) : ∃ P : ℂ[X], P.natDegree ≤ r ∧
    ∀ k, (P.eval (fourierRoot q^k)).re=evenGrid q r k := by
  obtain ⟨P,hP,hval⟩ := P14RealPartPolynomialProduct.exists_product r
    (fun _ => Real.cos (angle q)) (fun j => pairPhase q (2*j.val))
  refine ⟨P,hP,?_⟩
  intro k
  rw [hval _ (root_unit q k)]
  exact Finset.prod_congr rfl (fun j _ => pair_eval q (2*j.val) k)

theorem odd_polynomial (q r : ℕ) : ∃ P : ℂ[X], P.natDegree ≤ r+1 ∧
    ∀ k, (P.eval (fourierRoot q^k)).re=oddGrid q r k := by
  obtain ⟨P,hP,hval⟩ := P14RealPartPolynomialProduct.exists_product r
    (fun _ => Real.cos (angle q)) (fun j => pairPhase q (2*j.val+1))
  refine ⟨P14RealPartPolynomialProduct.multiply 1 1 P,
    (P14RealPartPolynomialProduct.multiply_degree _ _ _).trans (by omega),?_⟩
  intro k
  rw [P14RealPartPolynomialProduct.multiply_eval _ _ _ _ (root_unit q k),hval _ (root_unit q k)]
  have hg : (∏ j : Fin r, (Real.cos (angle q)-(pairPhase q (2*j.val+1)*fourierRoot q^k).re))=
      ∏ j : Fin r, pairGap q (2*j.val+1) k :=
    Finset.prod_congr rfl (fun j _ => pair_eval q (2*j.val+1) k)
  rw [hg]
  simp only [one_mul,root_power,phase_re,oddGrid]

theorem grid_polynomial (q n : ℕ) : ∃ P : ℂ[X], P.natDegree ≤ (n+1)/2 ∧
    ∀ k, (P.eval (fourierRoot q^k)).re=P14ConsecutiveGridProducts.grid q n k := by
  by_cases h : n%2=0
  · obtain ⟨P,hP,hval⟩ := even_polynomial q (n/2)
    exact ⟨P,hP.trans (by omega),by intro k; simpa only [P14ConsecutiveGridProducts.grid,if_pos h] using hval k⟩
  · obtain ⟨P,hP,hval⟩ := odd_polynomial q (n/2)
    exact ⟨P,hP.trans (by omega),by intro k; simpa only [P14ConsecutiveGridProducts.grid,if_neg h] using hval k⟩

theorem normalized_defect (q n : ℕ) : ∃ B : ℂ[X], B.natDegree ≤ (n+1)/2 ∧
    (B.coeff 0).im=0 ∧ ∀ k,
      (B.eval (fourierRoot q^k)).re= -P14ConsecutiveGridProducts.grid q n k/2 := by
  obtain ⟨P,hP,hval⟩ := grid_polynomial q n
  let R := C (-1/2 : ℂ)*P
  let B := R-C (Complex.I*((R.coeff 0).im : ℂ))
  have hR : R.natDegree ≤ (n+1)/2 := (natDegree_C_mul_le _ _).trans hP
  refine ⟨B,?_,?_,?_⟩
  · exact (natDegree_sub_le _ _).trans (max_le hR (by rw [natDegree_C]; exact Nat.zero_le _))
  · simp [B,coeff_sub,Complex.mul_im]
  · intro k
    simp only [B,eval_sub,eval_C,Complex.sub_re,Complex.mul_re,Complex.I_re,Complex.I_im,
      Complex.ofReal_re,Complex.ofReal_im,zero_mul,mul_zero,sub_zero]
    change ((C (-1/2 : ℂ)*P).eval (fourierRoot q^k)).re=_
    rw [eval_mul,eval_C,Complex.mul_re,hval]
    norm_num
    ring

theorem exists_positive_defect {q m : ℕ} (hm : 3 ≤ m) (hq : m+1 < q) :
    ∃ B : ℂ[X], B.natDegree ≤ m-1 ∧ (B.coeff 0).im=0 ∧
      (∀ k : Fin (m+1), (B.eval (fourierRoot q^k.val)).re=0) ∧
      (∀ k : Fin q, m < k.val → (B.eval (fourierRoot q^k.val)).re < 0) := by
  obtain ⟨B,hB,hreal,hval⟩ := normalized_defect q (m+1)
  refine ⟨B,hB.trans (by omega),hreal,?_,?_⟩
  · intro k
    rw [hval,P14ConsecutiveGridProducts.grid_zero k.isLt]
    norm_num
  · intro k hk
    rw [hval]
    exact div_neg_of_neg_of_pos (neg_neg_of_pos (P14ConsecutiveGridProducts.grid_positive (by omega) k.isLt)) (by norm_num)

end P14ConsecutiveGridPolynomial
end
end

section

/-! One fixed interpolation map on the real constraint space. It recovers
every admissible low-degree polynomial, and each of its evaluations depends
continuously on the real coordinate vector. -/

noncomputable section
open scoped BigOperators
namespace P14GaugedInterpolation
open Polynomial P14BarycentricInterpolation P14CircleLagrangeWeights

def gauge {m : ℕ} (z : Fin (m+1) → ℂ) (t : Fin (m+1) → ℝ) : ℂ[X] :=
  let P := interpolate z (fun i => Complex.I*(t i : ℂ))
  P-C (Complex.I*((P.coeff 0).im : ℂ))

theorem good {m : ℕ} (hm : 1 ≤ m) (z : Fin (m+1) → ℂ) (hz : Function.Injective z)
    (t : Fin (m+1) → ℝ) (ht : (∑ i, (t i : ℂ)*weight z i)=0) :
    (gauge z t).natDegree ≤ m-1 ∧ ((gauge z t).coeff 0).im=0 ∧
      ∀ i, ((gauge z t).eval (z i)).re=0 := by
  let P := interpolate z (fun i => Complex.I*(t i : ℂ))
  have hd : P.natDegree ≤ m-1 := by
    apply interpolate_lower_degree hm
    simp only [mul_assoc,←Finset.mul_sum,ht,mul_zero]
  refine ⟨?_,?_,?_⟩
  · exact (natDegree_sub_le _ _).trans (max_le hd (by rw [natDegree_C]; exact Nat.zero_le _))
  · simp [gauge,coeff_sub,Complex.mul_im]
  · intro i
    simp only [gauge,eval_sub,eval_C,interpolate_eval z _ hz,Complex.sub_re,
      Complex.mul_re,Complex.I_re,Complex.I_im,Complex.ofReal_re,Complex.ofReal_im,
      mul_zero,zero_mul,sub_zero]

theorem recover {m : ℕ} (hm : 1 ≤ m) (z : Fin (m+1) → ℂ) (hz : Function.Injective z)
    (B : ℂ[X]) (hB : B.natDegree ≤ m-1) (hc : (B.coeff 0).im=0)
    (hv : ∀ i, (B.eval (z i)).re=0) :
    ∃ t : Fin (m+1) → ℝ, (∑ i, (t i : ℂ)*weight z i)=0 ∧ gauge z t=B := by
  let t : Fin (m+1) → ℝ := fun i => (B.eval (z i)).im
  have he (i : Fin (m+1)) : B.eval (z i)=Complex.I*(t i : ℂ) := by
    apply Complex.ext
    · simp [Complex.mul_re,hv]
    · simp [Complex.mul_im,t]
  have hf := coefficient_formula z hz B (hB.trans (by omega))
  have h0 : B.coeff m=0 := coeff_eq_zero_of_natDegree_lt (hB.trans_lt (by omega))
  have hs : Complex.I*(∑ i, (t i : ℂ)*weight z i)=0 := by
    rw [Finset.mul_sum]
    simpa only [he,mul_assoc] using hf.symm.trans h0
  have ht : (∑ i, (t i : ℂ)*weight z i)=0 :=
    (mul_eq_zero.mp hs).resolve_left Complex.I_ne_zero
  have hi : interpolate z (fun i => Complex.I*(t i : ℂ))=B := by
    have hfun : (fun i => Complex.I*(t i : ℂ))=(fun i => B.eval (z i)) := funext (fun i => (he i).symm)
    rw [hfun,reconstruct z hz B (hB.trans (by omega))]
  refine ⟨t,ht,?_⟩
  simp only [gauge,hi,hc,Complex.ofReal_zero,mul_zero,C_0,sub_zero]

theorem continuous_eval {m : ℕ} (z : Fin (m+1) → ℂ) (x : ℂ) :
    Continuous (fun t : Fin (m+1) → ℝ => (gauge z t).eval x) := by
  simp only [gauge,interpolate,eval_sub,eval_finsetSum,eval_mul,eval_C,
    finsetSum_coeff,coeff_C_mul]
  fun_prop

end P14GaugedInterpolation
end
end

section

/-! The two annihilating coefficient polynomials have precisely the
positive and negative Fourier root arcs. Root completeness follows from
the polynomial degree and the m distinct verified moments. -/

noncomputable section
open scoped BigOperators
namespace P14FourierMomentRoots
open Polynomial P14CircleLagrangeWeights P14FourierWeightWindow P14FourierSpectralWeights

def poly {m : ℕ} (a : Fin (m+1) → ℂ) : ℂ[X] :=
  ∑ j, C (a j)*X^j.val

theorem poly_eval {m : ℕ} (a : Fin (m+1) → ℂ) (x : ℂ) :
    (poly a).eval x=∑ j, a j*x^j.val := by
  simp [poly,eval_finsetSum]

theorem poly_top {m : ℕ} (a : Fin (m+1) → ℂ) :
    (poly a).coeff m=a (Fin.last m) := by
  classical
  simp only [poly,finsetSum_coeff,coeff_C_mul,coeff_X_pow]
  rw [Finset.sum_eq_single (Fin.last m)]
  · simp
  · intro j _ hj
    have h : j.val ≠ m := by intro h; apply hj; exact Fin.ext h
    simp [Ne.symm h]
  · simp

theorem poly_degree {m : ℕ} (a : Fin (m+1) → ℂ) : (poly a).natDegree ≤ m := by
  apply natDegree_sum_le_of_forall_le
  intro j _
  exact (natDegree_C_mul_le _ _).trans ((natDegree_X_pow_le _).trans (by have := j.isLt; omega))

theorem moment_at_root {q m : ℕ} (hq : m < q) (k : Fin m) :
    (poly (weight (sample q m))).eval (fourierRoot q ^ k.val)=0 := by
  rw [poly_eval]
  have h := P14BarycentricInterpolation.moment_zero (sample q m)
    (sample_injective hq) k.isLt
  convert h using 1
  apply Finset.sum_congr rfl
  intro j _
  simp only [sample,←pow_mul,Nat.mul_comm]

theorem root_iff {q m : ℕ} (hq : m < q) (s : ℂ) :
    (∑ j, weight (sample q m) j*s^j.val)=0 ↔
      ∃ k : Fin m, s=fourierRoot q ^ k.val := by
  classical
  let z : Fin m → ℂ := fun k => fourierRoot q ^ k.val
  let P := poly (weight (sample q m))
  have hz : Function.Injective z := by
    intro i j h
    apply Fin.ext
    exact (fourierRoot_isPrimitiveRoot q (by omega)).pow_inj
      (by have := i.isLt; omega) (by have := j.isLt; omega) h
  have hp : P ≠ 0 := by
    intro he
    have hc := congrArg (fun Q : ℂ[X] => Q.coeff m) he
    rw [poly_top] at hc
    exact weight_ne_zero _ (sample_injective hq) _ hc
  have hr : P.roots=(Finset.univ.image z).val := by
    apply roots_eq_of_natDegree_le_card_of_ne_zero
    · intro x hx
      obtain ⟨k,_,rfl⟩ := Finset.mem_image.mp hx
      exact moment_at_root hq k
    · rw [Finset.card_image_of_injective _ hz,Finset.card_univ,Fintype.card_fin]
      exact poly_degree _
    · exact hp
  constructor
  · intro hs
    have hh : s ∈ P.roots := (mem_roots hp).mpr ((poly_eval _ s).trans hs)
    rw [hr] at hh
    obtain ⟨k,_,hk⟩ := Finset.mem_image.mp (show s ∈ Finset.univ.image z from hh)
    exact ⟨k,hk.symm⟩
  · rintro ⟨k,rfl⟩
    exact (poly_eval _ _).symm.trans (moment_at_root hq k)

theorem conjugate_root {q m : ℕ} (hq : m < q) (s : ℂ)
    (hs : (∑ j, star (weight (sample q m) j)*s^j.val)=0) :
    ∃ k : Fin m, s*fourierRoot q ^ k.val=1 := by
  have hc := congrArg star hs
  have hc' : (∑ j, weight (sample q m) j*(star s)^j.val)=0 := by
    simpa only [star_sum,star_mul,star_star,star_pow,star_zero,mul_comm] using hc
  obtain ⟨k,hk⟩ := (root_iff hq (star s)).mp hc'
  refine ⟨k,?_⟩
  have hu := sample_unit hq (⟨k.val,by have := k.isLt; omega⟩ : Fin (m+1))
  change star (fourierRoot q ^ k.val)*fourierRoot q ^ k.val=1 at hu
  have he : s=star (fourierRoot q ^ k.val) := by simpa using congrArg star hk
  rw [he]
  exact hu

end P14FourierMomentRoots
end
end

section

/-! Complexification of one complex constraint on real coordinates.
The common complex kernel of a and its conjugate is generated by the
real kernel. A dimension bound then gives a useful rigidity statement. -/

noncomputable section
open scoped BigOperators
namespace P14RealKernelComplexification

def form {ι : Type*} [Fintype ι] (a : ι → ℂ) : (ι → ℂ) →ₗ[ℂ] ℂ :=
  ∑ i, (LinearMap.proj i).smulRight (a i)

theorem form_apply {ι : Type*} [Fintype ι] (a u : ι → ℂ) :
    form a u=∑ i, u i*a i := by
  simp [form]

def joint {ι : Type*} [Fintype ι] (a : ι → ℂ) : (ι → ℂ) →ₗ[ℂ] ℂ × ℂ :=
  (form a).prod (form (fun i => star (a i)))

theorem joint_ker_iff {ι : Type*} [Fintype ι] (a u : ι → ℂ) :
    u ∈ LinearMap.ker (joint a) ↔
      (∑ i, u i*a i)=0 ∧ (∑ i, u i*star (a i))=0 := by
  simp [LinearMap.mem_ker,joint,form_apply]

theorem real_imag_constraints {ι : Type*} [Fintype ι] (a u : ι → ℂ)
    (ha : (∑ i, u i*a i)=0) (hb : (∑ i, u i*star (a i))=0) :
    (∑ i, (u i |>.re : ℂ)*a i)=0 ∧ (∑ i, (u i |>.im : ℂ)*a i)=0 := by
  have hc : (∑ i, star (u i)*a i)=0 := by
    have h := congrArg star hb
    simpa only [star_sum,star_mul,star_star,star_zero,mul_comm] using h
  constructor
  · calc
      _ = ((∑ i, u i*a i)+(∑ i, star (u i)*a i))/2 := by
        rw [←Finset.sum_add_distrib,Finset.sum_div]
        apply Finset.sum_congr rfl
        intro i _
        rw [Complex.re_eq_add_conj]
        simp only [Complex.star_def]
        ring
      _ = 0 := by rw [ha,hc]; norm_num
  · calc
      _ = ((∑ i, u i*a i)-(∑ i, star (u i)*a i))/(2*Complex.I) := by
        rw [←Finset.sum_sub_distrib,Finset.sum_div]
        apply Finset.sum_congr rfl
        intro i _
        rw [Complex.im_eq_sub_conj]
        simp only [Complex.star_def]
        ring
      _ = 0 := by rw [ha,hc]; simp

theorem complexify_mem {ι : Type*} [Fintype ι] (a : ι → ℂ)
    (V : Submodule ℂ (ι → ℂ))
    (hV : ∀ t : ι → ℝ, (∑ i, (t i : ℂ)*a i)=0 → (fun i => (t i : ℂ)) ∈ V)
    (u : ι → ℂ) (hu : u ∈ LinearMap.ker (joint a)) : u ∈ V := by
  obtain ⟨ha,hb⟩ := (joint_ker_iff a u).mp hu
  obtain ⟨hr,hi⟩ := real_imag_constraints a u ha hb
  have hv := V.add_mem (hV (fun i => (u i).re) hr)
    (V.smul_mem Complex.I (hV (fun i => (u i).im) hi))
  convert hv using 1
  funext i
  simpa only [Pi.add_apply,Pi.smul_apply,smul_eq_mul,mul_comm] using (Complex.re_add_im (u i)).symm

theorem kernel_finrank_lower {ι : Type*} [Fintype ι] (a : ι → ℂ) :
    Fintype.card ι-2 ≤ Module.finrank ℂ (LinearMap.ker (joint a)) := by
  have h := (joint a).finrank_range_add_finrank_ker
  have hb := (LinearMap.range (joint a)).finrank_le
  simp only [Module.finrank_fintype_fun_eq_card] at h
  have hh : Module.finrank ℂ (ℂ × ℂ)=2 := by simp
  rw [hh] at hb
  omega

theorem kernel_rigidity {ι : Type*} [Fintype ι] (a : ι → ℂ)
    (V : Submodule ℂ (ι → ℂ))
    (hV : ∀ t : ι → ℝ, (∑ i, (t i : ℂ)*a i)=0 → (fun i => (t i : ℂ)) ∈ V)
    (hd : Module.finrank ℂ V ≤ Fintype.card ι-2) : LinearMap.ker (joint a)=V := by
  apply Submodule.eq_of_le_of_finrank_le
  · intro u hu
    exact complexify_mem a V hV u hu
  · exact hd.trans (kernel_finrank_lower a)

end P14RealKernelComplexification
end
end

section

/-! The two opposite length-m Fourier root arcs cannot have m-1
distinct common members when q>m+1. The positive powers 1 and 2 are
explicitly excluded from their intersection. -/

noncomputable section
open scoped BigOperators
namespace P14OppositeRootArcs

theorem no_large_common_family {q m : ℕ} (hm : 3 ≤ m) (hq : m+1 < q)
    (w : ℂ) (hw : IsPrimitiveRoot w q) (f : Fin (m-1) → ℂ)
    (hf : Function.Injective f)
    (hpos : ∀ i, ∃ j : Fin m, f i=w^j.val)
    (hneg : ∀ i, ∃ j : Fin m, f i*w^j.val=1) : False := by
  classical
  choose g hg using hpos
  have hgI : Function.Injective g := by
    intro i j h
    apply hf
    rw [hg i,hg j,h]
  let one : Fin m := ⟨1,by omega⟩
  let two : Fin m := ⟨2,by omega⟩
  have hone (i : Fin (m-1)) : g i ≠ one := by
    intro hi
    obtain ⟨j,hj⟩ := hneg i
    rw [hg i,hi,←pow_add] at hj
    have he : w^(1+j.val)=1 := hj
    exact (hw.pow_ne_one_of_pos_of_lt (by omega : 1+j.val ≠ 0)
      (by have := j.isLt; omega)) he
  have htwo (i : Fin (m-1)) : g i ≠ two := by
    intro hi
    obtain ⟨j,hj⟩ := hneg i
    rw [hg i,hi,←pow_add] at hj
    have he : w^(2+j.val)=1 := hj
    exact (hw.pow_ne_one_of_pos_of_lt (by omega : 2+j.val ≠ 0)
      (by have := j.isLt; omega)) he
  have hsub : Finset.univ.image g ⊆ (Finset.univ.erase one).erase two := by
    intro j hj
    obtain ⟨i,_,rfl⟩ := Finset.mem_image.mp hj
    exact Finset.mem_erase.mpr ⟨htwo i,Finset.mem_erase.mpr ⟨hone i,Finset.mem_univ _⟩⟩
  have hc := Finset.card_le_card hsub
  have hne : two ≠ one := by intro h; have := congrArg Fin.val h; dsimp [one,two] at this; omega
  have hmem : two ∈ Finset.univ.erase one := Finset.mem_erase.mpr ⟨hne,Finset.mem_univ _⟩
  rw [Finset.card_image_of_injective _ hgI,Finset.card_univ,Fintype.card_fin,
    Finset.card_erase_of_mem hmem,Finset.card_erase_of_mem (Finset.mem_univ one),
    Finset.card_univ,Fintype.card_fin] at hc
  omega

end P14OppositeRootArcs

end
end

section

/-! Every single-overlap Vandermonde selection admits a witness in the
actual real barycentric constraint space. The proof uses complex kernel
rigidity and complete Fourier root arcs, not an assumed minor estimate. -/

noncomputable section
open scoped BigOperators
namespace P14SingleFourierConstraint
open P14CircleLagrangeWeights P14FourierWeightWindow P14FourierSpectralWeights

theorem exists_outside {q m : ℕ} (hm : 3 ≤ m) (hq : m+1 < q)
    (X : Fin (m-1) → ℂ) (hX : Function.Injective X) :
    ∃ t : Fin (m+1) → ℝ, (∑ j, (t j : ℂ)*weight (sample q m) j)=0 ∧
      (fun j => (t j : ℂ)) ∉ Submodule.span ℂ (Set.range (fun i : Fin (m-1) => fun j : Fin (m+1) => X i^j.val)) := by
  classical
  let a := weight (sample q m)
  let v : Fin (m-1) → Fin (m+1) → ℂ := fun i j => X i^j.val
  let V := Submodule.span ℂ (Set.range v)
  by_contra h
  push Not at h
  have hd : Module.finrank ℂ V ≤ Fintype.card (Fin (m+1))-2 := by
    have hh := finrank_range_le_card (R := ℂ) v
    simp only [Fintype.card_fin] at hh ⊢
    exact hh.trans (by omega)
  have he : LinearMap.ker (P14RealKernelComplexification.joint a)=V :=
    P14RealKernelComplexification.kernel_rigidity a V h hd
  have hc (i : Fin (m-1)) :
      (∑ j, v i j*a j)=0 ∧ (∑ j, v i j*star (a j))=0 := by
    apply (P14RealKernelComplexification.joint_ker_iff a (v i)).mp
    rw [he]
    exact Submodule.subset_span ⟨i,rfl⟩
  apply P14OppositeRootArcs.no_large_common_family hm hq (fourierRoot q)
    (fourierRoot_isPrimitiveRoot q (by omega)) X hX
  · intro i
    apply (P14FourierMomentRoots.root_iff (by omega : m < q) (X i)).mp
    simpa only [v,a,mul_comm] using (hc i).1
  · intro i
    apply P14FourierMomentRoots.conjugate_root (by omega : m < q) (X i)
    simpa only [v,a,mul_comm] using (hc i).2

theorem powers_independent {m : ℕ} (X : Fin (m-1) → ℂ) (hX : Function.Injective X) :
    LinearIndependent ℂ (fun i => fun j : Fin (m+1) => X i^j.val) := by
  let f : (Fin (m+1) → ℂ) →ₗ[ℂ] (Fin (m-1) → ℂ) :=
    { toFun := fun u k => u ⟨k.val,by have := k.isLt; omega⟩
      map_add' := fun _ _ => rfl
      map_smul' := fun _ _ => rfl }
  apply LinearIndependent.of_comp f
  exact P14SparseVandermondeJets.square_independent X hX

theorem exists_single_jet {q m : ℕ} (hm : 3 ≤ m) (hq : m+1 < q)
    (X : Fin (m-1) → ℂ) (hX : Function.Injective X) (y : ℂ) (hy : y ≠ 0) :
    ∃ t : Fin (m+1) → ℝ, (∑ j, (t j : ℂ)*weight (sample q m) j)=0 ∧
      LinearIndependent ℂ (fun o : Option (Fin (m-1)) =>
        Option.casesOn' o (fun j : Fin (m+1) => (t j : ℂ)*y^j.val)
          (fun i => fun j : Fin (m+1) => X i^j.val)) := by
  let R : Fin (m-1) → ℂ := fun i => X i/y
  have hR : Function.Injective R := by
    intro i j h
    apply hX
    exact (div_left_inj' hy).mp h
  obtain ⟨t,ht,hn⟩ := exists_outside hm hq R hR
  have hv := (powers_independent R hR).option hn
  have hs := P14CubicFourierJets.column_scale _ (fun j : Fin (m+1) => y^j.val)
    (fun j => pow_ne_zero _ hy) hv
  refine ⟨t,ht,?_⟩
  convert! hs using 1
  funext o j
  cases o with
  | none => rfl
  | some i =>
      change X i^j.val=(X i/y)^j.val*y^j.val
      rw [div_pow,div_mul_cancel₀ _ (pow_ne_zero _ hy)]

end P14SingleFourierConstraint
end
end

section

/-! Arbitrary-size multiple-collision witnesses in the actual real
barycentric constraint space. A final window supplies the sparse jet,
and consecutive Vandermonde blocks prove the rank directly. -/

noncomputable section
open scoped BigOperators
namespace P14SparseFourierConstraint
open P14FourierWeightWindow P14CircleLagrangeWeights P14SparseVandermondeJets

theorem exists_sparse_jet {q a b : ℕ} (hb : 2 ≤ b) (hq : a+b+1 < q) (hodd : Odd q)
    (X : Fin a → ℂ) (Y : Fin b → ℂ) (hX : Function.Injective X)
    (hY : Function.Injective Y) (hYn : ∀ i, Y i ≠ 0) :
    ∃ t : Fin (a+b+1) → ℝ,
      (∑ k, (t k : ℂ)*weight (sample q (a+b)) k)=0 ∧
      (∀ k : Fin a, t (first k)=0) ∧
      LinearIndependent ℂ
        (Sum.elim (fun i k => X i ^ k.val) (fun i k => (t k : ℂ)*Y i ^ k.val)) := by
  obtain ⟨u,hu,hun⟩ := exists_window hb hq hodd
  let t : Fin (a+b+1) → ℝ := Fin.append (m := a) (n := b+1) (fun _ : Fin a => 0) u
  have hl (k : Fin a) : t (first k)=0 := by
    change Fin.append (m := a) (n := b+1) (fun _ : Fin a => (0 : ℝ)) u (Fin.castAdd (b+1) k)=0
    rw [Fin.append_left]
  have hr (k : Fin b) : t (last k)=u k.castSucc := by
    change Fin.append (m := a) (n := b+1) (fun _ : Fin a => (0 : ℝ)) u (Fin.natAdd a k.castSucc)=_
    rw [Fin.append_right]
  refine ⟨t,?_,hl,?_⟩
  · change (∑ k : Fin (a+(b+1)), (t k : ℂ)*weight (sample q (a+b)) k)=0
    rw [Fin.sum_univ_add]
    simpa only [t,Fin.append_left,Fin.append_right,Complex.ofReal_zero,zero_mul,
      Finset.sum_const_zero,zero_add] using hu
  · apply sparse_independent X Y hX hY hYn (fun k => (t k : ℂ))
    · intro k
      rw [hl k,Complex.ofReal_zero]
    · intro k
      rw [hr k]
      exact Complex.ofReal_ne_zero.mpr (hun k.castSucc)

end P14SparseFourierConstraint
end
end

section

/-! Adding arbitrary combinations of the unchanged base block to jet rows
preserves independence. This makes the imaginary constant gauge legitimate
exactly when every jet node belongs to the base-node union. -/

noncomputable section
open scoped BigOperators
namespace P14RowBlockShear

theorem shear {α β κ : Type*} [Fintype α] [Fintype β]
    (v : α → κ → ℂ) (w : β → κ → ℂ) (B : β → α → ℂ)
    (h : LinearIndependent ℂ (Sum.elim v w)) :
    LinearIndependent ℂ (Sum.elim v (fun j => w j+∑ i, B j i • v i)) := by
  classical
  rw [Fintype.linearIndependent_iff] at h ⊢
  intro c hc
  let d : α ⊕ β → ℂ := Sum.elim
    (fun i => c (Sum.inl i)+∑ j, c (Sum.inr j)*B j i) (fun j => c (Sum.inr j))
  have he : (∑ i, c (Sum.inl i) • v i)+
      (∑ j, c (Sum.inr j) • (w j+∑ i, B j i • v i)) =
      (∑ i, (c (Sum.inl i)+∑ j, c (Sum.inr j)*B j i) • v i)+
      (∑ j, c (Sum.inr j) • w j) := by
    simp only [smul_add,Finset.sum_add_distrib,Finset.smul_sum,smul_smul,
      add_smul,Finset.sum_smul]
    rw [Finset.sum_comm]
    abel
  have hd : ∑ k, d k • Sum.elim v w k=0 := by
    rw [Fintype.sum_sum_type]
    change (∑ i, (c (Sum.inl i)+∑ j, c (Sum.inr j)*B j i) • v i)+
      (∑ j, c (Sum.inr j) • w j)=0
    rw [←he]
    simpa only [Fintype.sum_sum_type,Sum.elim_inl,Sum.elim_inr] using hc
  have hz := h d hd
  have hj (j : β) : c (Sum.inr j)=0 := hz (Sum.inr j)
  intro k
  cases k with
  | inl i => simpa only [d,Sum.elim_inl,hj,zero_mul,Finset.sum_const_zero,add_zero] using hz (Sum.inl i)
  | inr j => exact hj j

theorem node_gauge {a b n : ℕ} (X : Fin a → ℂ) (Y : Fin b → ℂ)
    (hsub : ∀ j, ∃ i, X i=Y j) (t : Fin n → ℂ) (c : ℂ)
    (h : LinearIndependent ℂ
      (Sum.elim (fun i : Fin a => fun k : Fin n => X i^k.val) (fun j k => t k*Y j^k.val))) :
    LinearIndependent ℂ
      (Sum.elim (fun i : Fin a => fun k : Fin n => X i^k.val) (fun j k => (t k+c)*Y j^k.val)) := by
  classical
  choose f hf using hsub
  have hs := shear (fun i : Fin a => fun k : Fin n => X i^k.val) (fun j k => t k*Y j^k.val)
    (fun j i => if i=f j then c else 0) h
  convert! hs using 1
  funext o k
  cases o with
  | inl i => rfl
  | inr j =>
      simp only [Sum.elim_inr,Pi.add_apply,Finset.sum_apply,Pi.smul_apply,smul_eq_mul]
      simp [hf,add_mul]

end P14RowBlockShear
end
end

section

/-! Actual low-degree polynomial witnesses for each nontrivial collision
pattern. Their constant coefficient is real, their grid values are purely
imaginary, and the required mixed row family is independent. These are
individual witnesses; no common positive-defect choice is claimed here. -/

noncomputable section
open scoped BigOperators
namespace P14InterpolatedJetWitnesses
open Polynomial P14CircleLagrangeWeights P14FourierWeightWindow

theorem normalize {m : ℕ} (hm : 1 ≤ m) (z : Fin (m+1) → ℂ)
    (hz : Function.Injective z) (t : Fin (m+1) → ℝ)
    (ht : (∑ k, (t k : ℂ)*weight z k)=0) :
    ∃ B : ℂ[X], B.natDegree ≤ m-1 ∧ (B.coeff 0).im=0 ∧
      ∃ c : ℝ, ∀ k, B.eval (z k)=Complex.I*((t k : ℂ)-(c : ℂ)) := by
  obtain ⟨P,hP,hval⟩ := P14BarycentricInterpolation.imaginary_interpolation hm z hz t ht
  let c := (P.coeff 0).im
  let B := P-C (Complex.I*(c : ℂ))
  refine ⟨B,?_,?_,c,?_⟩
  · exact (natDegree_sub_le P (C (Complex.I*(c : ℂ)))).trans (max_le hP (by rw [natDegree_C]; exact Nat.zero_le _))
  · simp [B,c,coeff_sub,Complex.mul_im]
  · intro k
    simp only [B,eval_sub,eval_C,hval,mul_sub]

theorem interpolate_rank {a b m : ℕ} (hm : 1 ≤ m) (z : Fin (m+1) → ℂ)
    (hz : Function.Injective z) (X : Fin a → ℂ) (Y : Fin b → ℂ)
    (hsub : ∀ j, ∃ i, X i=Y j) (t : Fin (m+1) → ℝ)
    (ht : (∑ k, (t k : ℂ)*weight z k)=0)
    (hLI : LinearIndependent ℂ (Sum.elim
      (fun i => fun k : Fin (m+1) => X i^k.val) (fun j k => (t k : ℂ)*Y j^k.val))) :
    ∃ B : ℂ[X], B.natDegree ≤ m-1 ∧ (B.coeff 0).im=0 ∧
      (∀ k, (B.eval (z k)).re=0) ∧
      LinearIndependent ℂ (Sum.elim
        (fun i => fun k : Fin (m+1) => X i^k.val) (fun j k => B.eval (z k)*Y j^k.val)) := by
  obtain ⟨B,hB,hreal,c,hval⟩ := normalize hm z hz t ht
  have hscale := P14CubicRowOperations.row_scale _
    (Sum.elim (fun _ : Fin a => (1 : ℂ)) (fun _ : Fin b => Complex.I))
    (by intro o; cases o <;> simp) hLI
  have hi : LinearIndependent ℂ (Sum.elim
      (fun i => fun k : Fin (m+1) => X i^k.val)
      (fun j k => (Complex.I*(t k : ℂ))*Y j^k.val)) := by
    convert! hscale using 1
    funext o k
    cases o <;> simp [mul_assoc]
  have hg := P14RowBlockShear.node_gauge X Y hsub
    (fun k => Complex.I*(t k : ℂ)) (-Complex.I*(c : ℂ)) hi
  refine ⟨B,hB,hreal,?_,?_⟩
  · intro k
    rw [hval]
    simp [Complex.mul_re]
  · convert! hg using 1
    funext o k
    cases o with
    | inl i => rfl
    | inr j =>
        change B.eval (z k)*Y j^k.val=(Complex.I*(t k : ℂ)+ -Complex.I*(c : ℂ))*Y j^k.val
        rw [hval]
        ring

theorem multiple {q a b : ℕ} (hb : 2 ≤ b) (hq : a+b+1 < q) (hodd : Odd q)
    (X : Fin a → ℂ) (Y : Fin b → ℂ) (hX : Function.Injective X)
    (hY : Function.Injective Y) (hYn : ∀ j, Y j ≠ 0)
    (hsub : ∀ j, ∃ i, X i=Y j) :
    ∃ B : ℂ[X], B.natDegree ≤ a+b-1 ∧ (B.coeff 0).im=0 ∧
      (∀ k, (B.eval (sample q (a+b) k)).re=0) ∧
      LinearIndependent ℂ (Sum.elim
        (fun i => fun k : Fin (a+b+1) => X i^k.val)
        (fun j k => B.eval (sample q (a+b) k)*Y j^k.val)) := by
  obtain ⟨t,ht,_,hLI⟩ := P14SparseFourierConstraint.exists_sparse_jet hb hq hodd X Y hX hY hYn
  exact interpolate_rank (by omega) (sample q (a+b)) (sample_injective (by omega))
    X Y hsub t ht hLI

theorem single {q m : ℕ} (hm : 3 ≤ m) (hq : m+1 < q)
    (X : Fin (m-1) → ℂ) (hX : Function.Injective X) (y : ℂ) (hy : y ≠ 0)
    (hsub : ∃ i, X i=y) :
    ∃ B : ℂ[X], B.natDegree ≤ m-1 ∧ (B.coeff 0).im=0 ∧
      (∀ k, (B.eval (sample q m k)).re=0) ∧
      LinearIndependent ℂ (Sum.elim
        (fun i => fun k : Fin (m+1) => X i^k.val)
        (fun _ : Fin 1 => fun k => B.eval (sample q m k)*y^k.val)) := by
  obtain ⟨t,ht,hLI⟩ := P14SingleFourierConstraint.exists_single_jet hm hq X hX y hy
  let e : Fin (m-1) ⊕ Fin 1 → Option (Fin (m-1)) :=
    Sum.elim some (fun _ => none)
  have he : Function.Injective e := by
    intro i j h
    cases i <;> cases j <;> simp_all [e]
    exact Subsingleton.elim _ _
  have hi : LinearIndependent ℂ (Sum.elim
      (fun i => fun k : Fin (m+1) => X i^k.val)
      (fun _ : Fin 1 => fun k => (t k : ℂ)*y^k.val)) := by
    convert! hLI.comp e he using 1
    funext o k
    cases o <;> rfl
  exact interpolate_rank (by omega) (sample q m) (sample_injective (by omega))
    X (fun _ : Fin 1 => y) (fun _ => hsub) t ht hi

end P14InterpolatedJetWitnesses
end
end

section

/-! The actual real Fourier constraint space has a nonempty open region
of positive defects. The same fixed interpolation map realizes every
individual collision-rank witness in this space. -/

noncomputable section
open scoped BigOperators
namespace P14FourierDefectSpace
open Polynomial P14CircleLagrangeWeights P14FourierWeightWindow
open P14FourierSpectralWeights P14GaugedInterpolation

def space (q m : ℕ) : Submodule ℝ (Fin (m+1) → ℝ) :=
  LinearMap.ker (P14RealKernelCircuits.constraint (weight (sample q m)))

theorem mem_space {q m : ℕ} (t : Fin (m+1) → ℝ) :
    t ∈ space q m ↔ (∑ k, (t k : ℂ)*weight (sample q m) k)=0 := by
  rw [space,LinearMap.mem_ker,P14RealKernelCircuits.constraint_apply]

def positive (q m : ℕ) : Set (space q m) :=
  {t | ∀ k : Fin q, m < k.val → ((gauge (sample q m) t.val).eval (fourierRoot q^k.val)).re < 0}

theorem positive_open (q m : ℕ) : IsOpen (positive q m) := by
  unfold positive
  rw [Set.ofPred_forall]
  apply isOpen_iInter_of_finite
  intro k
  by_cases hk : m < k.val
  · simp only [hk,forall_true_left]
    exact isOpen_lt (Complex.continuous_re.comp
      ((continuous_eval (sample q m) (fourierRoot q^k.val)).comp continuous_subtype_val)) continuous_const
  · simp [hk]

theorem good {q m : ℕ} (hm : 1 ≤ m) (hq : m < q) (t : space q m) :
    (gauge (sample q m) t.val).natDegree ≤ m-1 ∧
      ((gauge (sample q m) t.val).coeff 0).im=0 ∧
      ∀ k, ((gauge (sample q m) t.val).eval (sample q m k)).re=0 :=
  P14GaugedInterpolation.good hm _ (sample_injective hq) _ ((mem_space t.val).mp t.property)

theorem positive_nonempty {q m : ℕ} (hm : 3 ≤ m) (hq : m+1 < q) :
    (positive q m).Nonempty := by
  obtain ⟨B,hB,hc,hzero,hnegative⟩ := P14ConsecutiveGridPolynomial.exists_positive_defect hm hq
  obtain ⟨t,ht,he⟩ := recover (by omega) (sample q m) (sample_injective (by omega)) B hB hc hzero
  refine ⟨⟨t,(mem_space t).mpr ht⟩,?_⟩
  change ∀ k : Fin q, m < k.val → ((gauge (sample q m) t).eval (fourierRoot q^k.val)).re < 0
  rw [he]
  exact hnegative

theorem multiple {q a b : ℕ} (hb : 2 ≤ b) (hq : a+b+1 < q) (hodd : Odd q)
    (X : Fin a → ℂ) (Y : Fin b → ℂ) (hX : Function.Injective X)
    (hY : Function.Injective Y) (hYn : ∀ j, Y j ≠ 0)
    (hsub : ∀ j, ∃ i, X i=Y j) :
    ∃ t : space q (a+b), LinearIndependent ℂ (Sum.elim
      (fun i => fun k : Fin (a+b+1) => X i^k.val)
      (fun j k => (gauge (sample q (a+b)) t.val).eval (sample q (a+b) k)*Y j^k.val)) := by
  obtain ⟨B,hB,hc,hzero,hLI⟩ := P14InterpolatedJetWitnesses.multiple hb hq hodd X Y hX hY hYn hsub
  obtain ⟨t,ht,he⟩ := recover (by omega) (sample q (a+b)) (sample_injective (by omega)) B hB hc hzero
  refine ⟨⟨t,(mem_space t).mpr ht⟩,?_⟩
  change LinearIndependent ℂ (Sum.elim
    (fun i => fun k : Fin (a+b+1) => X i^k.val)
    (fun j k => (gauge (sample q (a+b)) t).eval (sample q (a+b) k)*Y j^k.val))
  rw [he]
  exact hLI

theorem single {q m : ℕ} (hm : 3 ≤ m) (hq : m+1 < q)
    (X : Fin (m-1) → ℂ) (hX : Function.Injective X) (y : ℂ) (hy : y ≠ 0)
    (hsub : ∃ i, X i=y) :
    ∃ t : space q m, LinearIndependent ℂ (Sum.elim
      (fun i => fun k : Fin (m+1) => X i^k.val)
      (fun _ : Fin 1 => fun k => (gauge (sample q m) t.val).eval (sample q m k)*y^k.val)) := by
  obtain ⟨B,hB,hc,hzero,hLI⟩ := P14InterpolatedJetWitnesses.single hm hq X hX y hy hsub
  obtain ⟨t,ht,he⟩ := recover (by omega) (sample q m) (sample_injective (by omega)) B hB hc hzero
  refine ⟨⟨t,(mem_space t).mpr ht⟩,?_⟩
  change LinearIndependent ℂ (Sum.elim
    (fun i => fun k : Fin (m+1) => X i^k.val)
    (fun _ : Fin 1 => fun k => (gauge (sample q m) t).eval (sample q m k)*y^k.val))
  rw [he]
  exact hLI

end P14FourierDefectSpace
end
end

section

/-! Each evaluation of the fixed gauged interpolant is a real linear
functional of its real coordinates. -/

noncomputable section
open scoped BigOperators
namespace P14GaugedLinearEvaluation
open Polynomial P14BarycentricInterpolation P14CircleLagrangeWeights
open P14GaugedInterpolation

def raw {m : ℕ} (z : Fin (m+1) → ℂ) (f : Fin (m+1) → ℂ) :
    (Fin (m+1) → ℝ) →ₗ[ℝ] ℂ :=
  P14RealKernelCircuits.constraint (fun i => Complex.I*weight z i*f i)

theorem raw_apply {m : ℕ} (z : Fin (m+1) → ℂ) (f : Fin (m+1) → ℂ)
    (t : Fin (m+1) → ℝ) :
    raw z f t=∑ i, (Complex.I*(t i : ℂ)*weight z i)*f i := by
  rw [raw,P14RealKernelCircuits.constraint_apply]
  apply Finset.sum_congr rfl
  intro i _
  ring

def evaluation {m : ℕ} (z : Fin (m+1) → ℂ) (x : ℂ) :
    (Fin (m+1) → ℝ) →ₗ[ℝ] ℂ :=
  raw z (fun i => (nodal z i).eval x)-
    (Complex.imLm.comp (raw z (fun i => (nodal z i).coeff 0))).smulRight Complex.I

theorem evaluation_apply {m : ℕ} (z : Fin (m+1) → ℂ) (x : ℂ)
    (t : Fin (m+1) → ℝ) :
    evaluation z x t=(gauge z t).eval x := by
  simp only [evaluation,LinearMap.sub_apply,LinearMap.smulRight_apply,
    LinearMap.comp_apply,raw_apply,P14GaugedInterpolation.gauge,P14BarycentricInterpolation.interpolate,eval_sub,eval_finsetSum,
    eval_mul,eval_C,finsetSum_coeff,coeff_C_mul]
  simp [Algebra.smul_def,mul_comm]

end P14GaugedLinearEvaluation
end
end

section

/-!
Polynomial identity and nonvanishing on a product of nonempty real open
intervals, evaluated inside the complex numbers. The index type need not be
finite: a multivariate polynomial still involves only finitely many variables.
No complex-open set, holomorphic continuation, or density premise is used.
-/

namespace P14ComplexPolynomialRealBox

variable {σ : Type*}

/-- Vanishing on every real assignment in a nonempty open interval box forces
a complex multivariate polynomial to be zero. -/
theorem eq_zero_of_eval_ofReal_eq_zero_on_box
    (p : MvPolynomial σ ℂ) (a b : σ → ℝ) (hIntervals : ∀ i, a i < b i)
    (hVanishing : ∀ x : σ → ℝ, (∀ i, a i < x i ∧ x i < b i) →
      MvPolynomial.eval (fun i => (x i : ℂ)) p = 0) :
    p = 0 := by
  let s : σ → Set ℂ := fun i =>
    (fun r : ℝ => (r : ℂ)) '' Set.Ioo (a i) (b i)
  have hInfinite : ∀ i, (s i).Infinite := by
    intro i
    exact (Set.Ioo_infinite (hIntervals i)).image Complex.ofReal_injective.injOn
  apply MvPolynomial.funext_set s hInfinite
  intro z hz
  have hLift : ∀ i, (a i < (z i).re ∧ (z i).re < b i) ∧
      ((z i).re : ℂ) = z i := by
    intro i
    have hzi : z i ∈ (fun r : ℝ => (r : ℂ)) '' Set.Ioo (a i) (b i) :=
      hz i (Set.mem_univ i)
    obtain ⟨r, hr, hrz⟩ := hzi
    refine ⟨?_, ?_⟩
    · simpa only [← hrz, Complex.ofReal_re, Set.mem_Ioo] using hr
    · rw [← hrz, Complex.ofReal_re]
  have hCast : (fun i => ((z i).re : ℂ)) = z := funext (fun i => (hLift i).2)
  simpa only [hCast, map_zero] using
    hVanishing (fun i => (z i).re) (fun i => (hLift i).1)

/-- A nonzero complex polynomial has a nonzero evaluation at some real point
of every box of nonempty open intervals. -/
theorem exists_eval_ofReal_ne_zero_in_box
    (p : MvPolynomial σ ℂ) (hp : p ≠ 0)
    (a b : σ → ℝ) (hIntervals : ∀ i, a i < b i) :
    ∃ x : σ → ℝ, (∀ i, a i < x i ∧ x i < b i) ∧
      MvPolynomial.eval (fun i => (x i : ℂ)) p ≠ 0 := by
  classical
  by_contra hNoPoint
  apply hp
  apply eq_zero_of_eval_ofReal_eq_zero_on_box p a b hIntervals
  intro x hx
  by_contra hNonzero
  exact hNoPoint ⟨x, hx, hNonzero⟩


end P14ComplexPolynomialRealBox
end

section

namespace P14RealOpenSetBox

theorem exists_box_subset {ι : Type*} [Fintype ι]
    {U : Set (ι → ℝ)} (hU : IsOpen U) {x : ι → ℝ} (hx : x ∈ U) :
    ∃ δ : ℝ, 0 < δ ∧ ∀ y : ι → ℝ,
      (∀ i, x i - δ < y i ∧ y i < x i + δ) → y ∈ U := by
  obtain ⟨δ, hδ, hball⟩ := Metric.mem_nhds_iff.mp (hU.mem_nhds hx)
  refine ⟨δ, hδ, ?_⟩
  intro y hy
  apply hball
  apply Metric.mem_ball.mpr
  apply (dist_pi_lt_iff hδ).mpr
  intro i
  rw [Real.dist_eq, abs_lt]
  constructor <;> linarith [(hy i).1, (hy i).2]

end P14RealOpenSetBox

end

section

/-! Finite avoidance for actual rectangular polynomial columns over complex
coordinates. Each selection may have its own initial spanning specialization.
A chosen nonzero minor bounds its bad parameters by a finite polynomial root
set, and one unit-modulus parameter works for the entire finite family.
This does not supply a physical matrix or its individual rank witnesses. -/

noncomputable section
namespace P14PolynomialSpanAvoidance
open Submodule
open scoped BigOperators

variable {d : ℕ}

def columnsAt {κ : Type*} (P : Fin d → κ → Polynomial ℂ) (z : ℂ) :
    κ → Fin d → ℂ := fun j i => (P i j).eval z

def minorPolynomial {κ : Type*} (P : Fin d → κ → Polynomial ℂ)
    (C : Fin d → κ) : Polynomial ℂ := Matrix.det (fun i j => P i (C j))

theorem eval_minorPolynomial {κ : Type*} (P : Fin d → κ → Polynomial ℂ)
    (C : Fin d → κ) (z : ℂ) :
    (minorPolynomial P C).eval z =
      Matrix.det (fun i j => (P i (C j)).eval z) := by
  change (Polynomial.evalRingHom z) (Matrix.det (fun i j => P i (C j))) = _
  exact (Polynomial.evalRingHom z).map_det (fun i j => P i (C j))

theorem unit_circle_infinite : Set.Infinite {z : ℂ | ‖z‖ = 1} := by
  have hI : Infinite (Set.Ioc (-Real.pi) Real.pi) :=
    Set.Ioc.infinite (by linarith [Real.pi_pos])
  letI : Infinite Circle := Circle.argEquiv.infinite_iff.mpr hI
  have hR : Set.Infinite (Set.range (fun z : Circle => (z : ℂ))) :=
    Set.infinite_range_of_injective Circle.coe_injective
  apply hR.mono
  rintro _ ⟨z, rfl⟩
  exact Circle.norm_coe z

theorem finite_eval_zero (p : Polynomial ℂ) (hp : p ≠ 0) :
    Set.Finite {z : ℂ | p.eval z = 0} :=
  Polynomial.finite_setOfPred_isRoot hp

/-- Avoid finitely many nonzero polynomials on the actual unit circle. -/
theorem exists_unit_nonzero {T : Type*} [Fintype T]
    (p : T → Polynomial ℂ) (hp : ∀ a, p a ≠ 0) :
    ∃ z : ℂ, ‖z‖ = 1 ∧ ∀ a, (p a).eval z ≠ 0 := by
  classical
  let Q : Polynomial ℂ := ∏ a, p a
  have hQ : Q ≠ 0 := Finset.prod_ne_zero_iff.mpr (fun a _ => hp a)
  obtain ⟨z, hz, hnot⟩ := unit_circle_infinite.exists_notMem_finite
    (finite_eval_zero Q hQ)
  have hQz : Q.eval z ≠ 0 := hnot
  have hprod : (∏ a, (p a).eval z) ≠ 0 := by
    simpa only [Q, Polynomial.eval_prod] using hQz
  exact ⟨z, hz, fun a => Finset.prod_ne_zero_iff.mp hprod a (Finset.mem_univ a)⟩

/-- A finite spanning family contains an actual d-column nonsingular minor.
The chosen columns are distinct; their coordinate order is unchanged. -/
theorem exists_minor_of_span {κ : Type*} [Fintype κ]
    (U : Fin d → κ → ℂ)
    (hU : span ℂ (Set.range (fun j => fun i => U i j)) = ⊤) :
    ∃ C : Fin d → κ, Function.Injective C ∧
      Matrix.det (fun i j => U i (C j)) ≠ 0 := by
  classical
  obtain ⟨ι, a, ha, hspan, hli⟩ :=
    exists_linearIndependent' ℂ (fun j => fun i => U i j)
  letI : Finite ι := Finite.of_injective a ha
  letI : Fintype ι := Fintype.ofFinite ι
  have hcard : Fintype.card ι = d := by
    rw [← finrank_span_eq_card hli, hspan, hU]
    simp
  let e : Fin d ≃ ι := (Fintype.equivFinOfCardEq hcard).symm
  have hli' : LinearIndependent ℂ (fun j : Fin d => fun i => U i (a (e j))) :=
    hli.comp e e.injective
  have hunit := Matrix.linearIndependent_cols_iff_isUnit.mp hli'
  refine ⟨a ∘ e, ha.comp e.injective, ?_⟩
  exact isUnit_iff_ne_zero.mp ((Matrix.isUnit_iff_isUnit_det _).mp hunit)

theorem span_of_minor {κ : Type*} (P : Fin d → κ → Polynomial ℂ)
    (C : Fin d → κ) (z : ℂ)
    (hdet : Matrix.det (fun i j => (P i (C j)).eval z) ≠ 0) :
    span ℂ (Set.range (columnsAt P z)) = ⊤ := by
  let M : Matrix (Fin d) (Fin d) ℂ := fun i j => (P i (C j)).eval z
  have hli : LinearIndependent ℂ M.col := Matrix.linearIndependent_cols_of_det_ne_zero hdet
  have hspan : span ℂ (Set.range M.col) = ⊤ :=
    hli.span_eq_top_of_card_eq_finrank' (by simp)
  apply top_unique
  rw [← hspan]
  exact span_mono (fun v ⟨j, hj⟩ => ⟨C j, hj⟩)

/-- One spanning specialization gives a finite bad set, via one actual
chosen minor. It need not lie on the unit circle. -/
theorem finite_nonspanning {κ : Type*} [Fintype κ]
    (P : Fin d → κ → Polynomial ℂ)
    (hwitness : ∃ z : ℂ, span ℂ (Set.range (columnsAt P z)) = ⊤) :
    Set.Finite {z : ℂ | span ℂ (Set.range (columnsAt P z)) ≠ ⊤} := by
  obtain ⟨z, hz⟩ := hwitness
  obtain ⟨C, _, hC⟩ := exists_minor_of_span (fun i j => (P i j).eval z) hz
  have hminor : minorPolynomial P C ≠ 0 := by
    intro hzero
    have heval : (minorPolynomial P C).eval z ≠ 0 := by
      simpa only [eval_minorPolynomial] using hC
    exact heval (by rw [hzero, Polynomial.eval_zero])
  apply (finite_eval_zero (minorPolynomial P C) hminor).subset
  intro t ht
  by_contra hnot
  change (minorPolynomial P C).eval t ≠ 0 at hnot
  exact ht (span_of_minor P C t (by simpa only [eval_minorPolynomial] using hnot))

/-- The explicit-minor form allows a different initial complex witness and
a different column selection for each member of the finite family. -/
theorem exists_unit_span_of_minors {T : Type*} [Fintype T]
    {κ : T → Type*} (P : (a : T) → Fin d → κ a → Polynomial ℂ)
    (hwitness : ∀ a, ∃ (z : ℂ) (C : Fin d → κ a),
      Matrix.det (fun i j => (P a i (C j)).eval z) ≠ 0) :
    ∃ z : ℂ, ‖z‖ = 1 ∧ ∀ a, span ℂ (Set.range (columnsAt (P a) z)) = ⊤ := by
  classical
  choose z C hC using hwitness
  have hminor : ∀ a, minorPolynomial (P a) (C a) ≠ 0 := by
    intro a hzero
    have heval : (minorPolynomial (P a) (C a)).eval (z a) ≠ 0 := by
      simpa only [eval_minorPolynomial] using hC a
    exact heval (by rw [hzero, Polynomial.eval_zero])
  obtain ⟨t, ht, hgood⟩ := exists_unit_nonzero
    (fun a => minorPolynomial (P a) (C a)) hminor
  refine ⟨t, ht, fun a => span_of_minor (P a) (C a) t ?_⟩
  simpa only [eval_minorPolynomial] using hgood a

/-- A single unit-modulus parameter preserves every selected spanning family.
Callers provide each individual spanning specialization; a simultaneous
witness is not assumed. -/
theorem exists_unit_span {T : Type*} [Fintype T]
    {κ : T → Type*} [∀ a, Fintype (κ a)]
    (P : (a : T) → Fin d → κ a → Polynomial ℂ)
    (hwitness : ∀ a, ∃ z : ℂ, span ℂ (Set.range (columnsAt (P a) z)) = ⊤) :
    ∃ z : ℂ, ‖z‖ = 1 ∧ ∀ a, span ℂ (Set.range (columnsAt (P a) z)) = ⊤ := by
  apply exists_unit_span_of_minors P
  intro a
  obtain ⟨z, hz⟩ := hwitness a
  obtain ⟨C, _, hC⟩ := exists_minor_of_span (fun i j => (P a i j).eval z) hz
  exact ⟨z, C, hC⟩

end P14PolynomialSpanAvoidance

end
end

section

/-! A nonsingular restriction of actual kernel vectors can cancel
prescribed coefficient coordinates without changing the represented vector.
No completeness or dimension formula for the kernel is assumed. -/

noncomputable section
open Matrix
open scoped BigOperators
namespace P14KernelCoefficientCorrection

variable {𝕜 ι κ δ τ : Type*} [Field 𝕜] [Fintype ι] [Fintype τ] [DecidableEq τ]

theorem correct (A : Matrix δ ι 𝕜) (K : Matrix ι κ 𝕜)
    (hker : ∀ k, A *ᵥ (fun i => K i k) = 0)
    (r : τ → ι) (c : τ → κ)
    (hdet : (Matrix.of (fun i j => K (r i) (c j))).det ≠ 0)
    (a : ι → 𝕜) :
    ∃ b : ι → 𝕜, A *ᵥ b = A *ᵥ a ∧ ∀ i, b (r i) = 0 := by
  let M : Matrix τ τ 𝕜 := fun i j => K (r i) (c j)
  let R : Matrix ι τ 𝕜 := fun i j => K i (c j)
  have hu : IsUnit M := (Matrix.isUnit_iff_isUnit_det M).mpr
    (isUnit_iff_ne_zero.mpr hdet)
  obtain ⟨z, hz⟩ := Matrix.mulVec_surjective_iff_isUnit.mpr hu (fun i => a (r i))
  have hAR : A * R = 0 := by
    ext d j
    exact congrFun (hker (c j)) d
  refine ⟨a - R *ᵥ z, ?_, ?_⟩
  · rw [Matrix.mulVec_sub, Matrix.mulVec_mulVec, hAR, Matrix.zero_mulVec, sub_zero]
  · intro i
    have hi := congrFun hz i
    change a (r i) - (M *ᵥ z) i = 0
    rw [hi, sub_self]

theorem supported_preimage [DecidableEq ι]
    (A : Matrix δ ι 𝕜) (K : Matrix ι κ 𝕜)
    (hker : ∀ k, A *ᵥ (fun i => K i k) = 0)
    (S : Finset ι) (r : τ → ι) (c : τ → κ)
    (hcover : ∀ i, i ∉ S → ∃ j, r j = i)
    (hdet : (Matrix.of (fun i j => K (r i) (c j))).det ≠ 0)
    (hA : Function.Surjective (fun a => A *ᵥ a)) (v : δ → 𝕜) :
    ∃ b : ι → 𝕜, A *ᵥ b = v ∧ ∀ i, i ∉ S → b i = 0 := by
  obtain ⟨a, ha⟩ := hA v
  obtain ⟨b, hb, hz⟩ := correct A K hker r c hdet a
  refine ⟨b, hb.trans ha, ?_⟩
  intro i hi
  obtain ⟨j, rfl⟩ := hcover i hi
  exact hz j

end P14KernelCoefficientCorrection
end
end

section

/-! Independent rows of a rectangular kernel restriction suffice to cancel
all omitted coordinates. No chosen square minor or completeness of the
displayed kernel family is required. -/

noncomputable section
open Matrix
namespace P14RectangularKernelCorrection

variable {𝕜 ι κ δ τ : Type*} [Field 𝕜] [Fintype ι] [Fintype κ] [Fintype τ]

theorem row_surjective (M : Matrix τ κ 𝕜)
    (h : LinearIndependent 𝕜 (fun i => M i)) :
    Function.Surjective (fun z => M *ᵥ z) := by
  classical
  have hr : M.rank = Fintype.card τ := h.rank_matrix
  change Function.Surjective M.mulVecLin
  apply LinearMap.range_eq_top.mp
  apply Submodule.eq_top_of_finrank_eq
  simpa only [Matrix.rank, Module.finrank_fintype_fun_eq_card] using hr

theorem correct (A : Matrix δ ι 𝕜) (K : Matrix ι κ 𝕜)
    (hker : ∀ k, A *ᵥ (fun i => K i k) = 0)
    (r : τ → ι) (hrows : LinearIndependent 𝕜 (fun j k => K (r j) k))
    (a : ι → 𝕜) :
    ∃ b : ι → 𝕜, A *ᵥ b = A *ᵥ a ∧ ∀ i, b (r i) = 0 := by
  let M : Matrix τ κ 𝕜 := fun i k => K (r i) k
  obtain ⟨z,hz⟩ := row_surjective M hrows (fun i => a (r i))
  have hAK : A * K = 0 := by
    ext d k
    exact congrFun (hker k) d
  refine ⟨a - K *ᵥ z, ?_, ?_⟩
  · rw [Matrix.mulVec_sub, Matrix.mulVec_mulVec, hAK, Matrix.zero_mulVec, sub_zero]
  · intro i
    have hi := congrFun hz i
    change (M *ᵥ z) i = a (r i) at hi
    change a (r i) - (M *ᵥ z) i = 0
    rw [hi,sub_self]

theorem supported_preimage [DecidableEq ι]
    (A : Matrix δ ι 𝕜) (K : Matrix ι κ 𝕜)
    (hker : ∀ k, A *ᵥ (fun i => K i k) = 0)
    (S : Finset ι) (r : τ → ι)
    (hcover : ∀ i, i ∉ S → ∃ j, r j = i)
    (hrows : LinearIndependent 𝕜 (fun j k => K (r j) k))
    (hA : Function.Surjective (fun a => A *ᵥ a)) (v : δ → 𝕜) :
    ∃ b : ι → 𝕜, A *ᵥ b = v ∧ ∀ i, i ∉ S → b i = 0 := by
  obtain ⟨a,ha⟩ := hA v
  obtain ⟨b,hb,hz⟩ := correct A K hker r hrows a
  refine ⟨b,hb.trans ha,?_⟩
  intro i hi
  obtain ⟨j,rfl⟩ := hcover i hi
  exact hz j

end P14RectangularKernelCorrection
end
end

section

/-! Individual polynomial row-rank witnesses can be combined inside any
nonempty open real parameter region. The proof selects actual nonzero
minors and uses a finite product; no irreducible-variety assertion occurs. -/

noncomputable section
open scoped BigOperators
namespace P14OpenPolynomialRanks

theorem common_nonzero {σ T : Type*} [Fintype σ] [Fintype T]
    (P : T → MvPolynomial σ ℂ) (hP : ∀ t, P t ≠ 0)
    (U : Set (σ → ℝ)) (hU : IsOpen U) (hne : U.Nonempty) :
    ∃ z ∈ U, ∀ t, MvPolynomial.eval (fun i => (z i : ℂ)) (P t) ≠ 0 := by
  classical
  obtain ⟨x,hx⟩ := hne
  obtain ⟨δ,hδ,hbox⟩ := P14RealOpenSetBox.exists_box_subset hU hx
  let Q := ∏ t, P t
  have hQ : Q ≠ 0 := Finset.prod_ne_zero_iff.mpr (fun t _ => hP t)
  obtain ⟨z,hz,hzQ⟩ := P14ComplexPolynomialRealBox.exists_eval_ofReal_ne_zero_in_box
    Q hQ (fun i => x i-δ) (fun i => x i+δ) (by intro i; linarith)
  refine ⟨z,hbox z hz,?_⟩
  have hh : (∏ t, MvPolynomial.eval (fun i => (z i : ℂ)) (P t)) ≠ 0 := by
    simpa only [Q,map_prod] using hzQ
  exact fun t => Finset.prod_ne_zero_iff.mp hh t (Finset.mem_univ t)

theorem row_minor {r c : ℕ} (v : Fin r → Fin c → ℂ)
    (hv : LinearIndependent ℂ v) :
    ∃ C : Fin r → Fin c, Matrix.det (fun i j => v i (C j)) ≠ 0 := by
  have hs : Submodule.span ℂ (Set.range (fun j => fun i => v i j))=⊤ := by
    let M : Matrix (Fin r) (Fin c) ℂ := fun i j => v i j
    have hh : Function.Surjective M.mulVecLin :=
      P14RectangularKernelCorrection.row_surjective M hv
    have hr := LinearMap.range_eq_top.mpr hh
    rw [Matrix.range_mulVecLin] at hr
    exact hr
  obtain ⟨C,_,hC⟩ := P14PolynomialSpanAvoidance.exists_minor_of_span v hs
  exact ⟨C,hC⟩

theorem rows_of_minor {r c : ℕ} (v : Fin r → Fin c → ℂ)
    (C : Fin r → Fin c) (hC : Matrix.det (fun i j => v i (C j)) ≠ 0) :
    LinearIndependent ℂ v := by
  let f : (Fin c → ℂ) →ₗ[ℂ] (Fin r → ℂ) :=
    { toFun := fun u j => u (C j)
      map_add' := fun _ _ => rfl
      map_smul' := fun _ _ => rfl }
  apply LinearIndependent.of_comp f
  exact Matrix.linearIndependent_rows_of_det_ne_zero hC

theorem common_rows {σ T : Type*} [Fintype σ] [Fintype T]
    (r c : T → ℕ) (P : ∀ t, Fin (r t) → Fin (c t) → MvPolynomial σ ℂ)
    (hw : ∀ t, ∃ z : σ → ℝ, LinearIndependent ℂ
      (fun i j => MvPolynomial.eval (fun k => (z k : ℂ)) (P t i j)))
    (U : Set (σ → ℝ)) (hU : IsOpen U) (hne : U.Nonempty) :
    ∃ z ∈ U, ∀ t, LinearIndependent ℂ
      (fun i j => MvPolynomial.eval (fun k => (z k : ℂ)) (P t i j)) := by
  classical
  choose x hx using hw
  have hminor (t : T) : ∃ C : Fin (r t) → Fin (c t),
      Matrix.det (fun i j => MvPolynomial.eval (fun k => (x t k : ℂ)) (P t i (C j))) ≠ 0 :=
    row_minor _ (hx t)
  choose C hC using hminor
  let Q : T → MvPolynomial σ ℂ := fun t => Matrix.det (fun i j => P t i (C t j))
  have heval (t : T) (z : σ → ℝ) :
      MvPolynomial.eval (fun k => (z k : ℂ)) (Q t)=
      Matrix.det (fun i j => MvPolynomial.eval (fun k => (z k : ℂ)) (P t i (C t j))) :=
    (MvPolynomial.eval (fun k => (z k : ℂ))).map_det _
  have hQ (t : T) : Q t ≠ 0 := by
    intro hh
    apply hC t
    rw [←heval,hh,map_zero]
  obtain ⟨z,hz,hzQ⟩ := common_nonzero Q hQ U hU hne
  refine ⟨z,hz,?_⟩
  intro t
  apply rows_of_minor _ (C t)
  rw [←heval]
  exact hzQ t

end P14OpenPolynomialRanks
end
end

section

/-! Finitely many individually achievable affine row-rank conditions can
be attained together in any nonempty open subset of a real normed space.
The finite parameterization uses actual witness directions, so no choice
of a basis or finite-dimensionality assumption on the ambient space is
required. -/

noncomputable section
open scoped BigOperators
namespace P14OpenAffineRanks

theorem common_rows {E T : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E]
    [Fintype T] (r c : T → ℕ)
    (A : ∀ t, Fin (r t) → Fin (c t) → ℂ)
    (L : ∀ t, Fin (r t) → Fin (c t) → E →ₗ[ℝ] ℂ)
    (hw : ∀ t, ∃ x : E, LinearIndependent ℂ (fun i j => A t i j+L t i j x))
    (U : Set E) (hU : IsOpen U) (hne : U.Nonempty) :
    ∃ x ∈ U, ∀ t, LinearIndependent ℂ (fun i j => A t i j+L t i j x) := by
  classical
  obtain ⟨x₀,hx₀⟩ := hne
  choose x hx using hw
  let ψ : (T → ℝ) → E := fun z => x₀+∑ t, z t • (x t-x₀)
  have hc : Continuous ψ := by unfold ψ; fun_prop
  have hzero : ψ 0=x₀ := by simp [ψ]
  have hsingle (t : T) : ψ (Pi.single t 1)=x t := by
    simp [ψ,Pi.single_apply,ite_smul]
  let P (t : T) (i : Fin (r t)) (j : Fin (c t)) : MvPolynomial T ℂ :=
    MvPolynomial.C (A t i j+L t i j x₀)+
      ∑ s, MvPolynomial.C (L t i j (x s-x₀))*MvPolynomial.X s
  have heval (t : T) (i : Fin (r t)) (j : Fin (c t)) (z : T → ℝ) :
      MvPolynomial.eval (fun s => (z s : ℂ)) (P t i j)=A t i j+L t i j (ψ z) := by
    simp [P,ψ,map_sum,Algebra.smul_def,mul_comm,add_assoc]
  have hwP : ∀ t, ∃ z : T → ℝ, LinearIndependent ℂ
      (fun i j => MvPolynomial.eval (fun s => (z s : ℂ)) (P t i j)) := by
    intro t
    refine ⟨Pi.single t 1,?_⟩
    simpa only [heval,hsingle] using hx t
  have hV : IsOpen (ψ ⁻¹' U) := hU.preimage hc
  have hVne : (ψ ⁻¹' U).Nonempty := ⟨0,by simpa only [Set.mem_preimage,hzero] using hx₀⟩
  obtain ⟨z,hz,hLI⟩ := P14OpenPolynomialRanks.common_rows r c P hwP (ψ ⁻¹' U) hV hVne
  refine ⟨ψ z,hz,?_⟩
  intro t
  simpa only [heval] using hLI t

end P14OpenAffineRanks
end
end

section

/-! A single genuine positive-defect polynomial can satisfy any finite
collection of individually achievable mixed Fourier jet-rank conditions.
The open region and common parameterization are constructed here; only
the individual rank hypotheses remain inputs. -/

noncomputable section
open scoped BigOperators
namespace P14PositiveCommonJets
open Polynomial P14FourierWeightWindow P14FourierSpectralWeights
open P14GaugedInterpolation P14FourierDefectSpace

theorem common {T : Type*} [Fintype T] {q m : ℕ} (hm : 3 ≤ m) (hq : m+1 < q)
    (a b : T → ℕ) (X : ∀ t, Fin (a t) → ℂ) (Y : ∀ t, Fin (b t) → ℂ)
    (hw : ∀ t, ∃ u : space q m, LinearIndependent ℂ (Sum.elim
      (fun i => fun k : Fin (m+1) => X t i^k.val)
      (fun j k => (gauge (sample q m) u.val).eval (sample q m k)*Y t j^k.val))) :
    ∃ B : ℂ[X], B.natDegree ≤ m-1 ∧ (B.coeff 0).im=0 ∧
      (∀ k : Fin (m+1), (B.eval (sample q m k)).re=0) ∧
      (∀ k : Fin q, m < k.val → (B.eval (fourierRoot q^k.val)).re < 0) ∧
      ∀ t, LinearIndependent ℂ (Sum.elim
        (fun i => fun k : Fin (m+1) => X t i^k.val)
        (fun j k => B.eval (sample q m k)*Y t j^k.val)) := by
  classical
  let e (t : T) : Fin (a t+b t) ≃ (Fin (a t) ⊕ Fin (b t)) := finSumFinEquiv.symm
  let A (t : T) (i : Fin (a t+b t)) (k : Fin (m+1)) : ℂ :=
    Sum.elim (fun r => X t r^k.val) (fun _ => 0) (e t i)
  let L (t : T) (i : Fin (a t+b t)) (k : Fin (m+1)) : space q m →ₗ[ℝ] ℂ :=
    Sum.elim (fun _ => 0)
      (fun r => (Y t r^k.val) •
        ((P14GaugedLinearEvaluation.evaluation (sample q m) (sample q m k)).comp (space q m).subtype)) (e t i)
  have hrow (t : T) (i : Fin (a t+b t)) (k : Fin (m+1)) (u : space q m) :
      A t i k+L t i k u=Sum.elim
        (fun r => X t r^k.val)
        (fun r => (gauge (sample q m) u.val).eval (sample q m k)*Y t r^k.val) (e t i) := by
    cases h : e t i with
    | inl r => simp [A,L,h]
    | inr r => simp [A,L,h,P14GaugedLinearEvaluation.evaluation_apply,mul_comm]
  have hw' : ∀ t, ∃ u : space q m, LinearIndependent ℂ (fun i k => A t i k+L t i k u) := by
    intro t
    obtain ⟨u,hu⟩ := hw t
    refine ⟨u,?_⟩
    convert! hu.comp (e t) (e t).injective using 1
    funext i k
    rw [hrow]
    simp only [Function.comp_def]
    cases e t i <;> rfl
  obtain ⟨u,hu,hLI⟩ := P14OpenAffineRanks.common_rows
    (fun t => a t+b t) (fun _ => m+1) A L hw' (positive q m)
    (positive_open q m) (positive_nonempty hm hq)
  obtain ⟨hdegree,hconstant,hzero⟩ := P14FourierDefectSpace.good (by omega) (by omega) u
  refine ⟨gauge (sample q m) u.val,hdegree,hconstant,hzero,hu,?_⟩
  intro t
  have hh := (hLI t).comp (e t).symm (e t).symm.injective
  convert! hh using 1
  funext o k
  simp only [Function.comp_def,hrow,Equiv.apply_symm_apply]
  cases o <;> rfl

end P14PositiveCommonJets
end
end

section

/-! A single normalized positive-defect polynomial works for every pattern
in an arbitrary finite family of nonempty collision patterns. Distinct
overlap nodes are selected from the distinct base nodes. All individual
rank hypotheses are discharged by the proved single/multiple witnesses. -/

noncomputable section
open scoped BigOperators
namespace P14PositiveFourierJetFamily
open Polynomial P14FourierWeightWindow P14FourierSpectralWeights
open P14GaugedInterpolation P14FourierDefectSpace

theorem individual {q m a b : ℕ} (hm : 3 ≤ m) (hq : m+1 < q) (hodd : Odd q)
    (hb : 1 ≤ b) (hcount : a+b=m) (X : Fin a → ℂ) (Y : Fin b → ℂ)
    (hX : Function.Injective X) (hY : Function.Injective Y)
    (hYn : ∀ j, Y j ≠ 0) (hsub : ∀ j, ∃ i, X i=Y j) :
    ∃ u : space q m, LinearIndependent ℂ (Sum.elim
      (fun i => fun k : Fin (m+1) => X i^k.val)
      (fun j k => (gauge (sample q m) u.val).eval (sample q m k)*Y j^k.val)) := by
  subst m
  rcases Nat.eq_or_lt_of_le hb with hb | hb
  · subst b
    have hs := P14FourierDefectSpace.single (m := a+1) hm hq
    have hconst : Y=(fun _ : Fin 1 => Y 0) := funext (fun j => congrArg Y (Subsingleton.elim j 0))
    rw [hconst]
    exact hs X hX (Y 0) (hYn 0) (hsub 0)
  · exact P14FourierDefectSpace.multiple (by omega) hq hodd X Y hX hY hYn hsub

theorem common {T : Type*} [Fintype T] {q m : ℕ} (hm : 3 ≤ m) (hq : m+1 < q)
    (hodd : Odd q) (a b : T → ℕ) (hb : ∀ t, 1 ≤ b t) (hcount : ∀ t, a t+b t=m)
    (X : ∀ t, Fin (a t) → ℂ) (Y : ∀ t, Fin (b t) → ℂ)
    (hX : ∀ t, Function.Injective (X t)) (hY : ∀ t, Function.Injective (Y t))
    (hYn : ∀ t j, Y t j ≠ 0) (hsub : ∀ t j, ∃ i, X t i=Y t j) :
    ∃ B : ℂ[X], B.natDegree ≤ m-1 ∧ (B.coeff 0).im=0 ∧
      (∀ k : Fin (m+1), (B.eval (sample q m k)).re=0) ∧
      (∀ k : Fin q, m < k.val → (B.eval (fourierRoot q^k.val)).re < 0) ∧
      ∀ t, LinearIndependent ℂ (Sum.elim
        (fun i => fun k : Fin (m+1) => X t i^k.val)
        (fun j k => B.eval (sample q m k)*Y t j^k.val)) := by
  apply P14PositiveCommonJets.common hm hq a b X Y
  intro t
  exact individual hm hq hodd (hb t) (hcount t) (X t) (Y t) (hX t) (hY t) (hYn t) (hsub t)

end P14PositiveFourierJetFamily
end
end

section

/-! The Fourier collision construction needs nonresonance, not odd
order. Keep the exact condition q not dividing 2(m-1) explicit. -/

noncomputable section
open scoped BigOperators
namespace P14NonresonantFourierJets
open Polynomial P14CircleLagrangeWeights P14FourierWeightWindow P14FourierSpectralWeights
open P14SparseVandermondeJets P14GaugedInterpolation P14FourierDefectSpace

theorem window {q a b : ℕ} (hb : 2 ≤ b) (hq : a+b+1 < q) (hnr : ¬ q ∣ (a+b-1)*2) :
    ∃ t : Fin (b+1) → ℝ,
      (∑ j, (t j : ℂ)*weight (sample q (a+b)) (Fin.natAdd a j))=0 ∧
      ∀ j, t j ≠ 0 := by
  let z := sample q (a+b)
  let w := fourierRoot q
  let r := w^(a+b-1)
  let C : ℂ := (-1 : ℂ)^(a+b)*∏ j, z j
  have hz : Function.Injective z := sample_injective (by omega)
  have hu : ∀ i, star (z i)*z i=1 := sample_unit (by omega)
  have hp := fourierRoot_isPrimitiveRoot q (by omega)
  have hw : w ≠ 0 := hp.ne_zero (by omega)
  have hr : r ≠ 0 := pow_ne_zero _ hw
  have hr1 : r ≠ 1 := hp.pow_ne_one_of_pos_of_lt (by omega : a+b-1 ≠ 0) (by omega)
  have hr2 : r^2 ≠ 1 := by
    intro he
    have hd : q ∣ (a+b-1)*2 := hp.dvd_of_pow_eq_one _ (by simpa only [r,←pow_mul] using he)
    exact hnr hd
  have hC : C ≠ 0 := by
    apply mul_ne_zero (pow_ne_zero _ (by norm_num : (-1 : ℂ) ≠ 0))
    apply Finset.prod_ne_zero_iff.mpr
    intro i _
    exact pow_ne_zero _ hw
  have hs (j : Fin (b+1)) :
      star (weight z (Fin.natAdd a j)) =
        (C*r^a)*r^j.val*weight z (Fin.natAdd a j) := by
    rw [weight_star (by omega) z hz hu]
    change C*(w^(a+j.val))^(a+b-1)*weight z (Fin.natAdd a j)=_
    rw [←pow_mul,Nat.mul_comm (a+j.val) (a+b-1),pow_mul,pow_add]
    dsimp [r]
    ring
  exact P14RealKernelThree.exists_of_geometric_ratios (n := b+1) (by omega)
    (fun j => weight z (Fin.natAdd a j)) (C*r^a) r
    (mul_ne_zero hC (pow_ne_zero _ hr)) hr hr1 hr2
    (fun j => weight_ne_zero z hz _) hs

theorem sparse {q a b : ℕ} (hb : 2 ≤ b) (hq : a+b+1 < q) (hnr : ¬ q ∣ (a+b-1)*2)
    (X : Fin a → ℂ) (Y : Fin b → ℂ) (hX : Function.Injective X)
    (hY : Function.Injective Y) (hYn : ∀ i, Y i ≠ 0) :
    ∃ t : Fin (a+b+1) → ℝ,
      (∑ k, (t k : ℂ)*weight (sample q (a+b)) k)=0 ∧
      (∀ k : Fin a, t (first k)=0) ∧
      LinearIndependent ℂ
        (Sum.elim (fun i k => X i ^ k.val) (fun i k => (t k : ℂ)*Y i ^ k.val)) := by
  obtain ⟨u,hu,hun⟩ := window hb hq hnr
  let t : Fin (a+b+1) → ℝ := Fin.append (m := a) (n := b+1) (fun _ : Fin a => 0) u
  have hl (k : Fin a) : t (first k)=0 := by
    change Fin.append (m := a) (n := b+1) (fun _ : Fin a => (0 : ℝ)) u (Fin.castAdd (b+1) k)=0
    rw [Fin.append_left]
  have hr (k : Fin b) : t (last k)=u k.castSucc := by
    change Fin.append (m := a) (n := b+1) (fun _ : Fin a => (0 : ℝ)) u (Fin.natAdd a k.castSucc)=_
    rw [Fin.append_right]
  refine ⟨t,?_,hl,?_⟩
  · change (∑ k : Fin (a+(b+1)), (t k : ℂ)*weight (sample q (a+b)) k)=0
    rw [Fin.sum_univ_add]
    simpa only [t,Fin.append_left,Fin.append_right,Complex.ofReal_zero,zero_mul,
      Finset.sum_const_zero,zero_add] using hu
  · apply sparse_independent X Y hX hY hYn (fun k => (t k : ℂ))
    · intro k
      rw [hl k,Complex.ofReal_zero]
    · intro k
      rw [hr k]
      exact Complex.ofReal_ne_zero.mpr (hun k.castSucc)

theorem polynomial {q a b : ℕ} (hb : 2 ≤ b) (hq : a+b+1 < q) (hnr : ¬ q ∣ (a+b-1)*2)
    (X : Fin a → ℂ) (Y : Fin b → ℂ) (hX : Function.Injective X)
    (hY : Function.Injective Y) (hYn : ∀ j, Y j ≠ 0)
    (hsub : ∀ j, ∃ i, X i=Y j) :
    ∃ B : ℂ[X], B.natDegree ≤ a+b-1 ∧ (B.coeff 0).im=0 ∧
      (∀ k, (B.eval (sample q (a+b) k)).re=0) ∧
      LinearIndependent ℂ (Sum.elim
        (fun i => fun k : Fin (a+b+1) => X i^k.val)
        (fun j k => B.eval (sample q (a+b) k)*Y j^k.val)) := by
  obtain ⟨t,ht,_,hLI⟩ := sparse hb hq hnr X Y hX hY hYn
  exact P14InterpolatedJetWitnesses.interpolate_rank (by omega) (sample q (a+b)) (sample_injective (by omega))
    X Y hsub t ht hLI

theorem in_space {q a b : ℕ} (hb : 2 ≤ b) (hq : a+b+1 < q) (hnr : ¬ q ∣ (a+b-1)*2)
    (X : Fin a → ℂ) (Y : Fin b → ℂ) (hX : Function.Injective X)
    (hY : Function.Injective Y) (hYn : ∀ j, Y j ≠ 0)
    (hsub : ∀ j, ∃ i, X i=Y j) :
    ∃ t : space q (a+b), LinearIndependent ℂ (Sum.elim
      (fun i => fun k : Fin (a+b+1) => X i^k.val)
      (fun j k => (gauge (sample q (a+b)) t.val).eval (sample q (a+b) k)*Y j^k.val)) := by
  obtain ⟨B,hB,hc,hzero,hLI⟩ := polynomial hb hq hnr X Y hX hY hYn hsub
  obtain ⟨t,ht,he⟩ := recover (by omega) (sample q (a+b)) (sample_injective (by omega)) B hB hc hzero
  refine ⟨⟨t,(mem_space t).mpr ht⟩,?_⟩
  change LinearIndependent ℂ (Sum.elim
    (fun i => fun k : Fin (a+b+1) => X i^k.val)
    (fun j k => (gauge (sample q (a+b)) t).eval (sample q (a+b) k)*Y j^k.val))
  rw [he]
  exact hLI

theorem individual {q m a b : ℕ} (hm : 3 ≤ m) (hq : m+1 < q) (hnr : ¬ q ∣ (m-1)*2)
    (hb : 1 ≤ b) (hcount : a+b=m) (X : Fin a → ℂ) (Y : Fin b → ℂ)
    (hX : Function.Injective X) (hY : Function.Injective Y)
    (hYn : ∀ j, Y j ≠ 0) (hsub : ∀ j, ∃ i, X i=Y j) :
    ∃ u : space q m, LinearIndependent ℂ (Sum.elim
      (fun i => fun k : Fin (m+1) => X i^k.val)
      (fun j k => (gauge (sample q m) u.val).eval (sample q m k)*Y j^k.val)) := by
  subst m
  rcases Nat.eq_or_lt_of_le hb with hb | hb
  · subst b
    have hs := P14FourierDefectSpace.single (m := a+1) hm hq
    have hconst : Y=(fun _ : Fin 1 => Y 0) := funext (fun j => congrArg Y (Subsingleton.elim j 0))
    rw [hconst]
    exact hs X hX (Y 0) (hYn 0) (hsub 0)
  · exact in_space (by omega) hq hnr X Y hX hY hYn hsub

theorem common {T : Type*} [Fintype T] {q m : ℕ} (hm : 3 ≤ m) (hq : m+1 < q)
    (hnr : ¬ q ∣ (m-1)*2) (a b : T → ℕ) (hb : ∀ t, 1 ≤ b t) (hcount : ∀ t, a t+b t=m)
    (X : ∀ t, Fin (a t) → ℂ) (Y : ∀ t, Fin (b t) → ℂ)
    (hX : ∀ t, Function.Injective (X t)) (hY : ∀ t, Function.Injective (Y t))
    (hYn : ∀ t j, Y t j ≠ 0) (hsub : ∀ t j, ∃ i, X t i=Y t j) :
    ∃ B : ℂ[X], B.natDegree ≤ m-1 ∧ (B.coeff 0).im=0 ∧
      (∀ k : Fin (m+1), (B.eval (sample q m k)).re=0) ∧
      (∀ k : Fin q, m < k.val → (B.eval (fourierRoot q^k.val)).re < 0) ∧
      ∀ t, LinearIndependent ℂ (Sum.elim
        (fun i => fun k : Fin (m+1) => X t i^k.val)
        (fun j k => B.eval (sample q m k)*Y t j^k.val)) := by
  apply P14PositiveCommonJets.common hm hq a b X Y
  intro t
  exact individual hm hq hnr (hb t) (hcount t) (X t) (Y t) (hX t) (hY t) (hYn t) (hsub t)

end P14NonresonantFourierJets
end
end

section

/-! Normalize an arbitrary nonzero antipodal pair, scale the checked
normalized rank witness back, and perform the actual interpolation/gauge
transport into the Fourier defect space. -/

noncomputable section
open scoped BigOperators
namespace P14AntipodalFourierJets
open Polynomial P14CircleLagrangeWeights P14FourierWeightWindow
open P14GaugedInterpolation P14FourierDefectSpace

theorem sparse {q a : ℕ} (ha : 3 ≤ a) (hodd : Odd a)
    (hsize : a+2 < q) (hq : q=2*(a+1)) (X : Fin a → ℂ)
    (hX : Function.Injective X) (y : ℂ) (hy : y ≠ 0) :
    ∃ t : Fin (a+2+1) → ℝ,
      (∑ k, (t k : ℂ)*weight (sample q (a+2)) k)=0 ∧
      LinearIndependent ℂ (Sum.elim
        (fun i => fun k : Fin (a+2+1) => X i^k.val)
        (fun j : Fin 2 => fun k => (t k : ℂ)*(![y,-y] j)^k.val)) := by
  let Z : Fin a → ℂ := fun i => X i/y
  have hZ : Function.Injective Z := by
    intro i j hh
    apply hX
    have he := congrArg (fun z : ℂ => z*y) hh
    simpa [Z,hy] using he
  obtain ⟨t,ht,hLI⟩ := P14AntipodalNormalizedJets.normalized ha hodd hsize hq Z hZ
  refine ⟨t,ht,?_⟩
  have hs := P14CubicFourierJets.column_scale _ (fun k => y^k.val)
    (fun k => pow_ne_zero _ hy) hLI
  convert! hs using 1
  funext i k
  cases i with
  | inl i =>
    change X i^k.val=(X i/y)^k.val*y^k.val
    rw [div_pow,div_mul_cancel₀ _ (pow_ne_zero _ hy)]
  | inr j =>
    fin_cases j
    · simp
    · change (t k : ℂ)*(-y)^k.val=((t k : ℂ)*(-1 : ℂ)^k.val)*y^k.val
      rw [neg_pow]
      ring

theorem polynomial {q a : ℕ} (ha : 3 ≤ a) (hodd : Odd a)
    (hsize : a+2 < q) (hq : q=2*(a+1)) (X : Fin a → ℂ)
    (hX : Function.Injective X) (y : ℂ) (hy : y ≠ 0)
    (hsub : ∀ j : Fin 2, ∃ i, X i=(![y,-y] j)) :
    ∃ B : ℂ[X], B.natDegree ≤ a+2-1 ∧ (B.coeff 0).im=0 ∧
      (∀ k, (B.eval (sample q (a+2) k)).re=0) ∧
      LinearIndependent ℂ (Sum.elim
        (fun i => fun k : Fin (a+2+1) => X i^k.val)
        (fun j : Fin 2 => fun k => B.eval (sample q (a+2) k)*(![y,-y] j)^k.val)) := by
  obtain ⟨t,ht,hLI⟩ := sparse ha hodd hsize hq X hX y hy
  exact P14InterpolatedJetWitnesses.interpolate_rank (by omega) (sample q (a+2))
    (sample_injective hsize) X ![y,-y] hsub t ht hLI

theorem in_space {q a : ℕ} (ha : 3 ≤ a) (hodd : Odd a)
    (hsize : a+2 < q) (hq : q=2*(a+1)) (X : Fin a → ℂ)
    (hX : Function.Injective X) (y : ℂ) (hy : y ≠ 0)
    (hsub : ∀ j : Fin 2, ∃ i, X i=(![y,-y] j)) :
    ∃ t : space q (a+2), LinearIndependent ℂ (Sum.elim
      (fun i => fun k : Fin (a+2+1) => X i^k.val)
      (fun j : Fin 2 => fun k =>
        (gauge (sample q (a+2)) t.val).eval (sample q (a+2) k)*(![y,-y] j)^k.val)) := by
  obtain ⟨B,hB,hc,hzero,hLI⟩ := polynomial ha hodd hsize hq X hX y hy hsub
  obtain ⟨t,ht,he⟩ := recover (by omega) (sample q (a+2)) (sample_injective hsize) B hB hc hzero
  refine ⟨⟨t,(mem_space t).mpr ht⟩,?_⟩
  change LinearIndependent ℂ (Sum.elim
    (fun i => fun k : Fin (a+2+1) => X i^k.val)
    (fun j : Fin 2 => fun k =>
      (gauge (sample q (a+2)) t).eval (sample q (a+2) k)*(![y,-y] j)^k.val))
  rw [he]
  exact hLI

end P14AntipodalFourierJets
end
end

section

/-! The two-overlap Fourier rank witness at order-two resonance,
provided the overlap nodes have distinct squares. The antipodal case
is explicitly excluded here and remains separate. -/

noncomputable section
open scoped BigOperators
namespace P14ResonantSquaredJets
open Polynomial P14CircleLagrangeWeights P14FourierWeightWindow P14FourierSpectralWeights
open P14SparseVandermondeJets P14GaugedInterpolation P14FourierDefectSpace

theorem window {q a : ℕ} (hq : a+2+1 < q) (hres : q ∣ (a+1)*2) :
    ∃ t : Fin 3 → ℝ,
      (∑ j, (t j : ℂ)*weight (sample q (a+2)) (Fin.natAdd a j))=0 ∧
      t 0 ≠ 0 ∧ t 2 ≠ 0 := by
  let z := sample q (a+2)
  let w := fourierRoot q
  let r := w^(a+1)
  let C : ℂ := (-1 : ℂ)^(a+2)*∏ j, z j
  have hz : Function.Injective z := sample_injective (by omega)
  have hu : ∀ i, star (z i)*z i=1 := sample_unit (by omega)
  have hp := fourierRoot_isPrimitiveRoot q (by omega)
  have hr2 : r^2=1 := by
    simpa only [r,←pow_mul] using (hp.pow_eq_one_iff_dvd ((a+1)*2)).mpr hres
  have hs (j : Fin 3) :
      star (weight z (Fin.natAdd a j)) =
        (C*r^a)*r^j.val*weight z (Fin.natAdd a j) := by
    rw [weight_star (by omega) z hz hu]
    change C*(w^(a+j.val))^(a+1)*weight z (Fin.natAdd a j)=_
    rw [←pow_mul,Nat.mul_comm (a+j.val) (a+1),pow_mul,pow_add]
    dsimp [r]
    ring
  apply P14SparseSquaredJets.endpoint_kernel
    (fun j => weight z (Fin.natAdd a j)) (fun j => weight_ne_zero z hz _)
  apply (P14RealKernelThree.area_zero_iff _ _).mpr
  rw [hs 0,hs 2]
  simp only [Fin.val_zero,Fin.val_two,pow_zero,hr2,mul_one]
  ring

theorem sparse {q a : ℕ} (hq : a+2+1 < q) (hres : q ∣ (a+1)*2)
    (X : Fin a → ℂ) (Y : Fin 2 → ℂ) (hX : Function.Injective X)
    (hY : Function.Injective (fun i => Y i^2)) (hYn : ∀ i, Y i ≠ 0) :
    ∃ t : Fin (a+2+1) → ℝ,
      (∑ k, (t k : ℂ)*weight (sample q (a+2)) k)=0 ∧
      LinearIndependent ℂ
        (Sum.elim (fun i k => X i ^ k.val) (fun i k => (t k : ℂ)*Y i ^ k.val)) := by
  obtain ⟨u,hu,hu0,hu2⟩ := window hq hres
  let t : Fin (a+2+1) → ℝ := Fin.append (m := a) (n := 3) (fun _ : Fin a => 0) u
  have hl (k : Fin a) : t (first k)=0 := by
    change Fin.append (m := a) (n := 3) (fun _ : Fin a => (0 : ℝ)) u (Fin.castAdd 3 k)=0
    rw [Fin.append_left]
  have hr (k : Fin 2) : t (P14SparseSquaredJets.spaced k)=u ⟨2*k.val,by omega⟩ := by
    change Fin.append (m := a) (n := 3) (fun _ : Fin a => (0 : ℝ)) u
      (Fin.natAdd a ⟨2*k.val,by omega⟩)=_
    rw [Fin.append_right]
  refine ⟨t,?_,?_⟩
  · change (∑ k : Fin (a+3), (t k : ℂ)*weight (sample q (a+2)) k)=0
    rw [Fin.sum_univ_add]
    simpa only [t,Fin.append_left,Fin.append_right,Complex.ofReal_zero,zero_mul,
      Finset.sum_const_zero,zero_add] using hu
  · apply P14SparseSquaredJets.sparse_independent X Y hX hY hYn (fun k => (t k : ℂ))
    · intro k
      rw [hl k,Complex.ofReal_zero]
    · intro k
      rw [hr k]
      apply Complex.ofReal_ne_zero.mpr
      fin_cases k
      · exact hu0
      · exact hu2

theorem polynomial {q a : ℕ} (hq : a+2+1 < q) (hres : q ∣ (a+1)*2)
    (X : Fin a → ℂ) (Y : Fin 2 → ℂ) (hX : Function.Injective X)
    (hY : Function.Injective (fun i => Y i^2)) (hYn : ∀ j, Y j ≠ 0)
    (hsub : ∀ j, ∃ i, X i=Y j) :
    ∃ B : ℂ[X], B.natDegree ≤ a+2-1 ∧ (B.coeff 0).im=0 ∧
      (∀ k, (B.eval (sample q (a+2) k)).re=0) ∧
      LinearIndependent ℂ (Sum.elim
        (fun i => fun k : Fin (a+2+1) => X i^k.val)
        (fun j k => B.eval (sample q (a+2) k)*Y j^k.val)) := by
  obtain ⟨t,ht,hLI⟩ := sparse hq hres X Y hX hY hYn
  exact P14InterpolatedJetWitnesses.interpolate_rank (by omega) (sample q (a+2))
    (sample_injective (by omega)) X Y hsub t ht hLI

theorem in_space {q a : ℕ} (hq : a+2+1 < q) (hres : q ∣ (a+1)*2)
    (X : Fin a → ℂ) (Y : Fin 2 → ℂ) (hX : Function.Injective X)
    (hY : Function.Injective (fun i => Y i^2)) (hYn : ∀ j, Y j ≠ 0)
    (hsub : ∀ j, ∃ i, X i=Y j) :
    ∃ t : space q (a+2), LinearIndependent ℂ (Sum.elim
      (fun i => fun k : Fin (a+2+1) => X i^k.val)
      (fun j k => (gauge (sample q (a+2)) t.val).eval (sample q (a+2) k)*Y j^k.val)) := by
  obtain ⟨B,hB,hc,hzero,hLI⟩ := polynomial hq hres X Y hX hY hYn hsub
  obtain ⟨t,ht,he⟩ := recover (by omega) (sample q (a+2)) (sample_injective (by omega)) B hB hc hzero
  refine ⟨⟨t,(mem_space t).mpr ht⟩,?_⟩
  change LinearIndependent ℂ (Sum.elim
    (fun i => fun k : Fin (a+2+1) => X i^k.val)
    (fun j k => (gauge (sample q (a+2)) t).eval (sample q (a+2) k)*Y j^k.val))
  rw [he]
  exact hLI

end P14ResonantSquaredJets

end
end

section

/-! Every collision pattern with at least three overlaps has an actual
real-constraint polynomial rank witness at arbitrary Fourier order.
The unresolved resonance issue is confined to exactly two overlaps. -/

noncomputable section
open scoped BigOperators
namespace P14ResonantMultipleJets
open Polynomial P14CircleLagrangeWeights P14FourierWeightWindow P14FourierSpectralWeights
open P14SparseVandermondeJets P14GaugedInterpolation P14FourierDefectSpace

theorem window {q a b : ℕ} (hb : 3 ≤ b) (hq : a+b+1 < q) :
    ∃ t : Fin (b+1) → ℝ,
      (∑ j, (t j : ℂ)*weight (sample q (a+b)) (Fin.natAdd a j))=0 ∧
      ∀ j, t j ≠ 0 := by
  let z := sample q (a+b)
  let w := fourierRoot q
  let r := w^(a+b-1)
  let C : ℂ := (-1 : ℂ)^(a+b)*∏ j, z j
  have hz : Function.Injective z := sample_injective (by omega)
  have hu : ∀ i, star (z i)*z i=1 := sample_unit (by omega)
  have hp := fourierRoot_isPrimitiveRoot q (by omega)
  have hw : w ≠ 0 := hp.ne_zero (by omega)
  have hr : r ≠ 0 := pow_ne_zero _ hw
  have hr1 : r ≠ 1 := hp.pow_ne_one_of_pos_of_lt (by omega : a+b-1 ≠ 0) (by omega)
  have hC : C ≠ 0 := by
    apply mul_ne_zero (pow_ne_zero _ (by norm_num : (-1 : ℂ) ≠ 0))
    apply Finset.prod_ne_zero_iff.mpr
    intro i _
    exact pow_ne_zero _ hw
  have hs (j : Fin (b+1)) :
      star (weight z (Fin.natAdd a j)) =
        (C*r^a)*r^j.val*weight z (Fin.natAdd a j) := by
    rw [weight_star (by omega) z hz hu]
    change C*(w^(a+j.val))^(a+b-1)*weight z (Fin.natAdd a j)=_
    rw [←pow_mul,Nat.mul_comm (a+j.val) (a+b-1),pow_mul,pow_add]
    dsimp [r]
    ring
  exact P14ParallelRealKernel.geometric_four (n := b+1) (by omega)
    (fun j => weight z (Fin.natAdd a j)) (C*r^a) r
    (mul_ne_zero hC (pow_ne_zero _ hr)) hr hr1
    (fun j => weight_ne_zero z hz _) hs

theorem sparse {q a b : ℕ} (hb : 3 ≤ b) (hq : a+b+1 < q)
    (X : Fin a → ℂ) (Y : Fin b → ℂ) (hX : Function.Injective X)
    (hY : Function.Injective Y) (hYn : ∀ i, Y i ≠ 0) :
    ∃ t : Fin (a+b+1) → ℝ,
      (∑ k, (t k : ℂ)*weight (sample q (a+b)) k)=0 ∧
      (∀ k : Fin a, t (first k)=0) ∧
      LinearIndependent ℂ
        (Sum.elim (fun i k => X i ^ k.val) (fun i k => (t k : ℂ)*Y i ^ k.val)) := by
  obtain ⟨u,hu,hun⟩ := window hb hq
  let t : Fin (a+b+1) → ℝ := Fin.append (m := a) (n := b+1) (fun _ : Fin a => 0) u
  have hl (k : Fin a) : t (first k)=0 := by
    change Fin.append (m := a) (n := b+1) (fun _ : Fin a => (0 : ℝ)) u (Fin.castAdd (b+1) k)=0
    rw [Fin.append_left]
  have hr (k : Fin b) : t (last k)=u k.castSucc := by
    change Fin.append (m := a) (n := b+1) (fun _ : Fin a => (0 : ℝ)) u (Fin.natAdd a k.castSucc)=_
    rw [Fin.append_right]
  refine ⟨t,?_,hl,?_⟩
  · change (∑ k : Fin (a+(b+1)), (t k : ℂ)*weight (sample q (a+b)) k)=0
    rw [Fin.sum_univ_add]
    simpa only [t,Fin.append_left,Fin.append_right,Complex.ofReal_zero,zero_mul,
      Finset.sum_const_zero,zero_add] using hu
  · apply sparse_independent X Y hX hY hYn (fun k => (t k : ℂ))
    · intro k
      rw [hl k,Complex.ofReal_zero]
    · intro k
      rw [hr k]
      exact Complex.ofReal_ne_zero.mpr (hun k.castSucc)

theorem polynomial {q a b : ℕ} (hb : 3 ≤ b) (hq : a+b+1 < q)
    (X : Fin a → ℂ) (Y : Fin b → ℂ) (hX : Function.Injective X)
    (hY : Function.Injective Y) (hYn : ∀ j, Y j ≠ 0)
    (hsub : ∀ j, ∃ i, X i=Y j) :
    ∃ B : ℂ[X], B.natDegree ≤ a+b-1 ∧ (B.coeff 0).im=0 ∧
      (∀ k, (B.eval (sample q (a+b) k)).re=0) ∧
      LinearIndependent ℂ (Sum.elim
        (fun i => fun k : Fin (a+b+1) => X i^k.val)
        (fun j k => B.eval (sample q (a+b) k)*Y j^k.val)) := by
  obtain ⟨t,ht,_,hLI⟩ := sparse hb hq X Y hX hY hYn
  exact P14InterpolatedJetWitnesses.interpolate_rank (by omega) (sample q (a+b)) (sample_injective (by omega))
    X Y hsub t ht hLI

theorem in_space {q a b : ℕ} (hb : 3 ≤ b) (hq : a+b+1 < q)
    (X : Fin a → ℂ) (Y : Fin b → ℂ) (hX : Function.Injective X)
    (hY : Function.Injective Y) (hYn : ∀ j, Y j ≠ 0)
    (hsub : ∀ j, ∃ i, X i=Y j) :
    ∃ t : space q (a+b), LinearIndependent ℂ (Sum.elim
      (fun i => fun k : Fin (a+b+1) => X i^k.val)
      (fun j k => (gauge (sample q (a+b)) t.val).eval (sample q (a+b) k)*Y j^k.val)) := by
  obtain ⟨B,hB,hc,hzero,hLI⟩ := polynomial hb hq X Y hX hY hYn hsub
  obtain ⟨t,ht,he⟩ := recover (by omega) (sample q (a+b)) (sample_injective (by omega)) B hB hc hzero
  refine ⟨⟨t,(mem_space t).mpr ht⟩,?_⟩
  change LinearIndependent ℂ (Sum.elim
    (fun i => fun k : Fin (a+b+1) => X i^k.val)
    (fun j k => (gauge (sample q (a+b)) t).eval (sample q (a+b) k)*Y j^k.val))
  rw [he]
  exact hLI

end P14ResonantMultipleJets
end
end

section

/-! Assemble all collision patterns at order-two resonance. Two
overlaps split into distinct-square and antipodal cases, each using
an actual polynomial rank witness. -/

noncomputable section
open scoped BigOperators
namespace P14ResonantFourierJets
open Polynomial P14CircleLagrangeWeights P14FourierWeightWindow
open P14GaugedInterpolation P14FourierDefectSpace P14FourierSpectralWeights

theorem individual {q m a b : ℕ} (hm : 5 ≤ m) (hq : m+1 < q)
    (hodd : Odd m) (hres : q=2*(m-1))
    (hb : 1 ≤ b) (hcount : a+b=m) (X : Fin a → ℂ) (Y : Fin b → ℂ)
    (hX : Function.Injective X) (hY : Function.Injective Y)
    (hYn : ∀ j, Y j ≠ 0) (hsub : ∀ j, ∃ i, X i=Y j) :
    ∃ u : space q m, LinearIndependent ℂ (Sum.elim
      (fun i => fun k : Fin (m+1) => X i^k.val)
      (fun j k => (gauge (sample q m) u.val).eval (sample q m k)*Y j^k.val)) := by
  classical
  subst m
  by_cases hb1 : b=1
  · subst b
    have hs := P14FourierDefectSpace.single (m := a+1) (by omega : 3 ≤ a+1) hq
    have hconst : Y=(fun _ : Fin 1 => Y 0) := funext (fun j => congrArg Y (Subsingleton.elim j 0))
    rw [hconst]
    exact hs X hX (Y 0) (hYn 0) (hsub 0)
  by_cases hb2 : b=2
  · subst b
    by_cases hsq : Function.Injective (fun i => Y i^2)
    · apply P14ResonantSquaredJets.in_space hq ?_ X Y hX hsq hYn hsub
      have he : q=(a+1)*2 := by omega
      rw [he]
    · have heq : Y 1^2=Y 0^2 := by
        by_contra hn
        apply hsq
        intro i j hij
        fin_cases i <;> fin_cases j
        · rfl
        · exact False.elim (hn hij.symm)
        · exact False.elim (hn hij)
        · rfl
      have hneg : Y 1 = -Y 0 := by
        rcases sq_eq_sq_iff_eq_or_eq_neg.mp heq with he | he
        · have hf := hY he
          norm_num at hf
        · exact he
      have hvec : Y=![Y 0,-Y 0] := by
        funext j
        fin_cases j
        · rfl
        · exact hneg
      have haodd : Odd a := by
        obtain ⟨k,hk⟩ := hodd
        exact ⟨k-1,by omega⟩
      rw [hvec]
      exact P14AntipodalFourierJets.in_space (by omega) haodd (by omega) (by omega)
        X hX (Y 0) (hYn 0) (by simpa only [←hvec] using hsub)
  · exact P14ResonantMultipleJets.in_space (by omega) hq X Y hX hY hYn hsub

theorem common {T : Type*} [Fintype T] {q m : ℕ} (hm : 5 ≤ m) (hq : m+1 < q)
    (hodd : Odd m) (hres : q=2*(m-1))
    (a b : T → ℕ) (hb : ∀ t, 1 ≤ b t) (hcount : ∀ t, a t+b t=m)
    (X : ∀ t, Fin (a t) → ℂ) (Y : ∀ t, Fin (b t) → ℂ)
    (hX : ∀ t, Function.Injective (X t)) (hY : ∀ t, Function.Injective (Y t))
    (hYn : ∀ t j, Y t j ≠ 0) (hsub : ∀ t j, ∃ i, X t i=Y t j) :
    ∃ B : ℂ[X], B.natDegree ≤ m-1 ∧ (B.coeff 0).im=0 ∧
      (∀ k : Fin (m+1), (B.eval (sample q m k)).re=0) ∧
      (∀ k : Fin q, m < k.val → (B.eval (fourierRoot q^k.val)).re < 0) ∧
      ∀ t, LinearIndependent ℂ (Sum.elim
        (fun i => fun k : Fin (m+1) => X t i^k.val)
        (fun j k => B.eval (sample q m k)*Y t j^k.val)) := by
  apply P14PositiveCommonJets.common (by omega) hq a b X Y
  intro t
  exact individual hm hq hodd hres (hb t) (hcount t) (X t) (Y t) (hX t) (hY t) (hYn t) (hsub t)

end P14ResonantFourierJets

end
end

section

/-! Every finite injective two-layer selection partitions into one base
representative per node and the remaining right-layer overlap rows. -/

noncomputable section
namespace P14TwoLayerPartition

def node {ι : Type*} : (ι ⊕ ι) → ι := Sum.elim id id
def flag {ι : Type*} : (ι ⊕ ι) → Bool := Sum.elim (fun _ => false) (fun _ => true)

def Extra {ι : Type*} {m : ℕ} (f : Fin m → ι ⊕ ι) (i : Fin m) : Prop :=
  ∃ x, f i=Sum.inr x ∧ ∃ j, f j=Sum.inl x

abbrev Base {ι : Type*} {m : ℕ} (f : Fin m → ι ⊕ ι) := {i : Fin m // ¬Extra f i}
abbrev Overlap {ι : Type*} {m : ℕ} (f : Fin m → ι ⊕ ι) := {i : Fin m // Extra f i}

instance baseFintype {ι : Type*} {m : ℕ} (f : Fin m → ι ⊕ ι) : Fintype (Base f) :=
  Fintype.ofFinite _
instance overlapFintype {ι : Type*} {m : ℕ} (f : Fin m → ι ⊕ ι) : Fintype (Overlap f) :=
  Fintype.ofFinite _

def splitEquiv {ι : Type*} {m : ℕ} (f : Fin m → ι ⊕ ι) : (Base f ⊕ Overlap f) ≃ Fin m := by
  classical
  exact
    { toFun := Sum.elim Subtype.val Subtype.val
      invFun := fun i => if h : Extra f i then Sum.inr ⟨i,h⟩ else Sum.inl ⟨i,h⟩
      left_inv := by
        intro o
        cases o with
        | inl i => simp [i.property]
        | inr i => simp [i.property]
      right_inv := by intro i; by_cases h : Extra f i <;> simp [h] }

theorem card_split {ι : Type*} {m : ℕ} (f : Fin m → ι ⊕ ι) :
    Fintype.card (Base f)+Fintype.card (Overlap f)=m := by
  simpa only [Fintype.card_sum,Fintype.card_fin] using Fintype.card_congr (splitEquiv f)

theorem not_extra_left {ι : Type*} {m : ℕ} (f : Fin m → ι ⊕ ι)
    {i : Fin m} {x : ι} (hi : f i=Sum.inl x) : ¬Extra f i := by
  rintro ⟨y,hy,_⟩
  rw [hi] at hy
  cases hy

theorem base_node_injective {ι : Type*} {m : ℕ} (f : Fin m → ι ⊕ ι)
    (hf : Function.Injective f) : Function.Injective (fun i : Base f => node (f i.val)) := by
  intro i j h
  cases hi : f i.val with
  | inl x =>
      cases hj : f j.val with
      | inl y =>
          have hxy : x=y := by simpa [node,hi,hj] using h
          apply Subtype.ext
          apply hf
          rw [hi,hj,hxy]
      | inr y =>
          have hxy : x=y := by simpa [node,hi,hj] using h
          exact False.elim (j.property ⟨y,hj,i.val,by rw [hi,hxy]⟩)
  | inr x =>
      cases hj : f j.val with
      | inl y =>
          have hxy : x=y := by simpa [node,hi,hj] using h
          exact False.elim (i.property ⟨x,hi,j.val,by rw [hj,hxy]⟩)
      | inr y =>
          have hxy : x=y := by simpa [node,hi,hj] using h
          apply Subtype.ext
          apply hf
          rw [hi,hj,hxy]

theorem overlap_node_injective {ι : Type*} {m : ℕ} (f : Fin m → ι ⊕ ι)
    (hf : Function.Injective f) : Function.Injective (fun i : Overlap f => node (f i.val)) := by
  intro i j h
  obtain ⟨x,hx,_⟩ := i.property
  obtain ⟨y,hy,_⟩ := j.property
  have hxy : x=y := by simpa [node,hx,hy] using h
  apply Subtype.ext
  apply hf
  rw [hx,hy,hxy]

theorem overlap_base {ι : Type*} {m : ℕ} (f : Fin m → ι ⊕ ι) (j : Overlap f) :
    ∃ i : Base f, node (f i.val)=node (f j.val) ∧ flag (f i.val)=false := by
  obtain ⟨x,hx,i,hi⟩ := j.property
  refine ⟨⟨i,not_extra_left f hi⟩,?_,?_⟩ <;> simp [node,flag,hi,hx]

theorem no_overlap_node_injective {ι : Type*} {m : ℕ} (f : Fin m → ι ⊕ ι)
    (hf : Function.Injective f) (hn : ∀ i, ¬Extra f i) : Function.Injective (node ∘ f) := by
  intro i j h
  have hh := base_node_injective f hf (a₁ := ⟨i,hn i⟩) (a₂ := ⟨j,hn j⟩) h
  exact congrArg Subtype.val hh

end P14TwoLayerPartition
end
end

section

/-! Finitely many full row-rank conditions persist under entrywise
convergence. Actual nonzero minors witness every condition. -/

noncomputable section
open Filter
open scoped Topology
namespace P14FiniteRankPersistence

theorem rows {α : Type*} {l : Filter α} {r c : ℕ}
    (v : α → Fin r → Fin c → ℂ) (w : Fin r → Fin c → ℂ)
    (hlim : ∀ i j, Tendsto (fun x => v x i j) l (𝓝 (w i j)))
    (hw : LinearIndependent ℂ w) :
    ∀ᶠ x in l, LinearIndependent ℂ (v x) := by
  classical
  obtain ⟨C,hC⟩ := P14OpenPolynomialRanks.row_minor w hw
  have hm : Tendsto (fun x => (fun i j => v x i (C j) : Matrix (Fin r) (Fin r) ℂ))
      l (𝓝 (fun i j => w i (C j))) := by
    apply tendsto_pi_nhds.mpr
    intro i
    exact tendsto_pi_nhds.mpr (fun j => hlim i (C j))
  have hd := (continuous_id.matrix_det.tendsto (fun i j => w i (C j))).comp hm
  have hn := hd.eventually (isOpen_compl_singleton.mem_nhds hC)
  filter_upwards [hn] with x hx
  exact P14OpenPolynomialRanks.rows_of_minor (v x) C hx

theorem family {α T : Type*} [Fintype T] {l : Filter α} (r c : T → ℕ)
    (v : ∀ t, α → Fin (r t) → Fin (c t) → ℂ)
    (w : ∀ t, Fin (r t) → Fin (c t) → ℂ)
    (hlim : ∀ t i j, Tendsto (fun x => v t x i j) l (𝓝 (w t i j)))
    (hw : ∀ t, LinearIndependent ℂ (w t)) :
    ∀ᶠ x in l, ∀ t, LinearIndependent ℂ (v t x) := by
  exact Filter.eventually_all.mpr (fun t => rows (v t) (w t) (hlim t) (hw t))

end P14FiniteRankPersistence
end
end

section

/-! Nonzero limiting collision jets imply independence of the actual
two-layer rows for sufficiently small nonzero real parameters. Each
overlap node must have an unweighted base representative. -/

noncomputable section
open Filter
open scoped Topology BigOperators
namespace P14CollisionRowDeformation

def base {a c : ℕ} (e : ℝ) (F : Fin c → ℂ) (X : Fin a → ℂ)
    (flag : Fin a → Bool) : Fin a → Fin c → ℂ :=
  fun i k => if flag i then (1+(e:ℂ)*F k)*X i^k.val else X i^k.val

def normalized {a b c : ℕ} (e : ℝ) (F : Fin c → ℂ) (X : Fin a → ℂ)
    (Y : Fin b → ℂ) (flag : Fin a → Bool) : (Fin a ⊕ Fin b) → Fin c → ℂ :=
  Sum.elim (base e F X flag) (fun j k => F k*Y j^k.val)

def actual {a b c : ℕ} (e : ℝ) (F : Fin c → ℂ) (X : Fin a → ℂ)
    (Y : Fin b → ℂ) (flag : Fin a → Bool) : (Fin a ⊕ Fin b) → Fin c → ℂ :=
  Sum.elim (base e F X flag) (fun j k => (1+(e:ℂ)*F k)*Y j^k.val)

theorem eventually_normalized {a b c : ℕ} (F : ℝ → Fin c → ℂ) (B : Fin c → ℂ)
    (hF : ∀ k, Tendsto (fun e => F e k) (𝓝 0) (𝓝 (B k)))
    (X : Fin a → ℂ) (Y : Fin b → ℂ) (flag : Fin a → Bool)
    (hLI : LinearIndependent ℂ (Sum.elim
      (fun i => fun k : Fin c => X i^k.val) (fun j k => B k*Y j^k.val))) :
    ∀ᶠ (e : ℝ) in 𝓝 0, LinearIndependent ℂ (normalized e (F e) X Y flag) := by
  classical
  let v := Sum.elim (fun i => fun k : Fin c => X i^k.val) (fun j k => B k*Y j^k.val)
  have hc : Tendsto (fun e : ℝ => (e:ℂ)) (𝓝 0) (𝓝 0) := Complex.ofRealCLM.continuous.tendsto 0
  have hl (o : Fin a ⊕ Fin b) (k : Fin c) :
      Tendsto (fun e => normalized e (F e) X Y flag o k) (𝓝 0) (𝓝 (v o k)) := by
    cases o with
    | inl i =>
        cases hf : flag i
        · simpa only [normalized,Sum.elim_inl,base,hf,Bool.false_eq_true,if_false,v] using
            (tendsto_const_nhds : Tendsto (fun _ : ℝ => X i^k.val) (𝓝 0) (𝓝 (X i^k.val)))
        · have h := ((tendsto_const_nhds (x := (1:ℂ))).add (hc.mul (hF k))).mul
            (tendsto_const_nhds (x := X i^k.val))
          simpa [normalized,base,hf,v] using h
    | inr j => exact (hF k).mul_const _
  let E : Fin (a+b) ≃ (Fin a ⊕ Fin b) := finSumFinEquiv.symm
  have hv := P14FiniteRankPersistence.rows
    (fun e i => normalized e (F e) X Y flag (E i)) (fun i => v (E i))
    (fun i k => hl (E i) k) (hLI.comp E E.injective)
  filter_upwards [hv] with e he
  have hh := he.comp E.symm E.symm.injective
  simpa only [Function.comp_def,Equiv.apply_symm_apply] using hh

theorem actual_of_normalized {a b c : ℕ} (e : ℝ) (he : e ≠ 0) (F : Fin c → ℂ)
    (X : Fin a → ℂ) (Y : Fin b → ℂ) (flag : Fin a → Bool)
    (hsub : ∀ j, ∃ i, X i=Y j ∧ flag i=false)
    (hLI : LinearIndependent ℂ (normalized e F X Y flag)) :
    LinearIndependent ℂ (actual e F X Y flag) := by
  classical
  choose f hf hflag using hsub
  have hbase (j : Fin b) (k : Fin c) : base e F X flag (f j) k=Y j^k.val := by
    simp [base,hflag,hf]
  have hs := P14CubicRowOperations.row_scale _
    (Sum.elim (fun _ : Fin a => (1:ℂ)) (fun _ : Fin b => (e:ℂ)))
    (by intro o; cases o <;> simp [he]) hLI
  have hs' : LinearIndependent ℂ (Sum.elim (base e F X flag)
      (fun j k => (e:ℂ)*F k*Y j^k.val)) := by
    convert! hs using 1
    funext o k
    cases o <;> simp [normalized,mul_assoc]
  have hh := P14RowBlockShear.shear (base e F X flag)
    (fun j k => (e:ℂ)*F k*Y j^k.val) (fun j i => if i=f j then 1 else 0) hs'
  convert! hh using 1
  funext o k
  cases o with
  | inl i => rfl
  | inr j =>
      simp [actual,hbase]
      ring

theorem eventually_actual {a b c : ℕ} (F : ℝ → Fin c → ℂ) (B : Fin c → ℂ)
    (hF : ∀ k, Tendsto (fun e => F e k) (𝓝 0) (𝓝 (B k)))
    (X : Fin a → ℂ) (Y : Fin b → ℂ) (flag : Fin a → Bool)
    (hsub : ∀ j, ∃ i, X i=Y j ∧ flag i=false)
    (hLI : LinearIndependent ℂ (Sum.elim
      (fun i => fun k : Fin c => X i^k.val) (fun j k => B k*Y j^k.val))) :
    ∀ᶠ (e : ℝ) in 𝓝 0, e ≠ 0 → LinearIndependent ℂ (actual e (F e) X Y flag) := by
  filter_upwards [eventually_normalized F B hF X Y flag hLI] with e he
  exact fun he0 => actual_of_normalized e he0 (F e) X Y flag hsub he

end P14CollisionRowDeformation
end
end

section

/-! Exact finite coordinates and row relabeling for every two-layer
selection. These are structural identities, with no rank assumption
except the explicit input to the final transport lemma. -/

noncomputable section
namespace P14TwoLayerSelectionRows
open P14TwoLayerPartition

abbrev a {ι : Type*} {m : ℕ} (f : Fin m → ι ⊕ ι) := Fintype.card (Base f)
abbrev b {ι : Type*} {m : ℕ} (f : Fin m → ι ⊕ ι) := Fintype.card (Overlap f)

def baseEnum {ι : Type*} {m : ℕ} (f : Fin m → ι ⊕ ι) : Fin (a f) ≃ Base f :=
  (Fintype.equivFin (Base f)).symm
def overEnum {ι : Type*} {m : ℕ} (f : Fin m → ι ⊕ ι) : Fin (b f) ≃ Overlap f :=
  (Fintype.equivFin (Overlap f)).symm

def labelIndex {ι : Type*} {m : ℕ} (f : Fin m → ι ⊕ ι) : (Fin (a f) ⊕ Fin (b f)) → Fin m :=
  Sum.elim (fun i => (baseEnum f i).val) (fun j => (overEnum f j).val)

def indexEquiv {ι : Type*} {m : ℕ} (f : Fin m → ι ⊕ ι) : (Fin (a f) ⊕ Fin (b f)) ≃ Fin m :=
  (Equiv.sumCongr (baseEnum f) (overEnum f)).trans (splitEquiv f)

theorem indexEquiv_apply {ι : Type*} {m : ℕ} (f : Fin m → ι ⊕ ι)
    (s : Fin (a f) ⊕ Fin (b f)) : indexEquiv f s=labelIndex f s := by cases s <;> rfl

def baseNode {ι : Type*} {m : ℕ} (f : Fin m → ι ⊕ ι) (Z : ι → ℂ) : Fin (a f) → ℂ :=
  fun i => Z (node (f (baseEnum f i).val))
def overNode {ι : Type*} {m : ℕ} (f : Fin m → ι ⊕ ι) (Z : ι → ℂ) : Fin (b f) → ℂ :=
  fun j => Z (node (f (overEnum f j).val))
def baseFlag {ι : Type*} {m : ℕ} (f : Fin m → ι ⊕ ι) : Fin (a f) → Bool :=
  fun i => flag (f (baseEnum f i).val)

theorem nodes {ι : Type*} {m : ℕ} (f : Fin m → ι ⊕ ι) (hf : Function.Injective f)
    (Z : ι → ℂ) (hZ : Function.Injective Z) :
    Function.Injective (baseNode f Z) ∧ Function.Injective (overNode f Z) := by
  exact ⟨hZ.comp ((base_node_injective f hf).comp (baseEnum f).injective),
    hZ.comp ((overlap_node_injective f hf).comp (overEnum f).injective)⟩

theorem overlap_representative {ι : Type*} {m : ℕ} (f : Fin m → ι ⊕ ι) (Z : ι → ℂ)
    (j : Fin (b f)) : ∃ i, baseNode f Z i=overNode f Z j ∧ baseFlag f i=false := by
  obtain ⟨i,hi,hflag⟩ := overlap_base f (overEnum f j)
  refine ⟨(baseEnum f).symm i,?_,?_⟩
  · simpa only [baseNode,overNode,Equiv.apply_symm_apply] using congrArg Z hi
  · simpa only [baseFlag,Equiv.apply_symm_apply] using hflag

def model {ι : Type*} {c : ℕ} (e : ℝ) (F : Fin c → ℂ) (Z : ι → ℂ) :
    (ι ⊕ ι) → Fin c → ℂ :=
  Sum.elim (fun i k => Z i^k.val) (fun i k => (1+(e:ℂ)*F k)*Z i^k.val)

theorem row_identity {ι : Type*} {m c : ℕ} (f : Fin m → ι ⊕ ι) (Z : ι → ℂ)
    (e : ℝ) (F : Fin c → ℂ) (s : Fin (a f) ⊕ Fin (b f)) (k : Fin c) :
    P14CollisionRowDeformation.actual e F (baseNode f Z) (overNode f Z) (baseFlag f) s k=
      model e F Z (f (labelIndex f s)) k := by
  cases s with
  | inl i =>
      cases h : f (baseEnum f i).val <;>
        simp [P14CollisionRowDeformation.actual,P14CollisionRowDeformation.base,
          baseNode,baseFlag,labelIndex,model,node,flag,h]
  | inr j =>
      obtain ⟨x,hx,_⟩ := (overEnum f j).property
      simp [P14CollisionRowDeformation.actual,overNode,labelIndex,model,node,hx]

theorem independent {ι : Type*} {m c : ℕ} (f : Fin m → ι ⊕ ι) (Z : ι → ℂ)
    (e : ℝ) (F : Fin c → ℂ)
    (h : LinearIndependent ℂ
      (P14CollisionRowDeformation.actual e F (baseNode f Z) (overNode f Z) (baseFlag f))) :
    LinearIndependent ℂ (fun i => model e F Z (f i)) := by
  have hh : LinearIndependent ℂ (fun s => model e F Z (f (labelIndex f s))) := by
    convert! h using 1
    funext s k
    exact (row_identity f Z e F s k).symm
  have hi := hh.comp (indexEquiv f).symm (indexEquiv f).symm.injective
  simpa only [Function.comp_def,←indexEquiv_apply,Equiv.apply_symm_apply] using hi

end P14TwoLayerSelectionRows
end
end

section

/-! The zero-overlap case: distinct nodes give Vandermonde row rank at
zero, and every layer choice preserves that rank near zero. -/

noncomputable section
open Filter
open scoped Topology
namespace P14DistinctNodeDeformation
open P14TwoLayerSelectionRows P14TwoLayerPartition

theorem powers_independent {m : ℕ} (Z : Fin m → ℂ) (hZ : Function.Injective Z) :
    LinearIndependent ℂ (fun i => fun k : Fin (m+1) => Z i^k.val) := by
  let L : (Fin (m+1) → ℂ) →ₗ[ℂ] (Fin m → ℂ) :=
    { toFun := fun v j => v j.castSucc
      map_add' := fun _ _ => rfl
      map_smul' := fun _ _ => rfl }
  apply LinearIndependent.of_comp L
  change LinearIndependent ℂ (Matrix.vandermonde Z).row
  apply Matrix.linearIndependent_rows_of_isUnit
  exact (Matrix.isUnit_iff_isUnit_det _).mpr
    (isUnit_iff_ne_zero.mpr (Matrix.det_vandermonde_ne_zero_iff.mpr hZ))

theorem eventually_rows {ι : Type*} {m : ℕ} (Z : ι → ℂ) (f : Fin m → ι ⊕ ι)
    (hn : Function.Injective (fun i => Z (node (f i))))
    (F : ℝ → Fin (m+1) → ℂ) (hF : ∀ k, ContinuousAt (fun e => F e k) 0) :
    ∀ᶠ (e : ℝ) in 𝓝 0, LinearIndependent ℂ (fun i => model e (F e) Z (f i)) := by
  have hc : Tendsto (fun e : ℝ => (e:ℂ)) (𝓝 0) (𝓝 0) := Complex.ofRealCLM.continuous.tendsto 0
  apply P14FiniteRankPersistence.rows _ (fun i => fun k : Fin (m+1) => Z (node (f i))^k.val)
  · intro i k
    cases h : f i with
    | inl j => simpa [model,node,h] using
        (tendsto_const_nhds : Tendsto (fun _ : ℝ => Z j^k.val) (𝓝 0) (𝓝 (Z j^k.val)))
    | inr j =>
        have hl := ((tendsto_const_nhds (x := (1:ℂ))).add (hc.mul (hF k))).mul
          (tendsto_const_nhds (x := Z j^k.val))
        simpa [model,node,h] using hl
  · exact powers_independent _ hn

end P14DistinctNodeDeformation
end
end

section

/-! The squared norm of a finite analytic sum on the unit circle is its
diagonal coefficient energy plus twice the real part of the strictly
positive-frequency correlations. -/

noncomputable section
open scoped BigOperators
namespace P14CircleNormSum

theorem norm_add (a b : ℂ) :
    Complex.normSq (a+b)=Complex.normSq a+Complex.normSq b+2*(b*star a).re := by
  simp only [Complex.normSq_apply,Complex.add_re,Complex.add_im,Complex.mul_re,
    Complex.star_def,Complex.conj_re,Complex.conj_im]
  ring

theorem unit_power_cross (z : ℂ) (hz : Complex.normSq z=1) {i j : ℕ} (hij : i ≤ j) :
    star (z^i)*z^j=z^(j-i) := by
  have hu : star z*z=1 := by
    change (starRingEnd ℂ) z*z=1
    rw [←Complex.normSq_eq_conj_mul_self,hz]
    rfl
  calc
    _ = star (z^i)*(z^i*z^(j-i)) := by rw [←pow_add,Nat.add_sub_of_le hij]
    _ = (star z*z)^i*z^(j-i) := by rw [star_pow,mul_pow]; ring
    _ = _ := by rw [hu,one_pow,one_mul]

theorem cross_sum (c : ℕ → ℂ) (n : ℕ) (z : ℂ) (hz : Complex.normSq z=1) :
    c n*z^n*star (∑ i ∈ Finset.range n, c i*z^i)=
      ∑ i ∈ Finset.range n, (c n*star (c i))*z^(n-i) := by
  rw [star_sum,Finset.mul_sum]
  apply Finset.sum_congr rfl
  intro i hi
  rw [star_mul]
  calc
    _ = (c n*star (c i))*(star (z^i)*z^n) := by ring
    _ = _ := by rw [unit_power_cross z hz (Nat.le_of_lt (Finset.mem_range.mp hi))]

theorem norm_sum (c : ℕ → ℂ) (n : ℕ) (z : ℂ) (hz : Complex.normSq z=1) :
    Complex.normSq (∑ i ∈ Finset.range n, c i*z^i)=
      (∑ i ∈ Finset.range n, Complex.normSq (c i))+
      2*(∑ j ∈ Finset.range n, ∑ i ∈ Finset.range j, (c j*star (c i))*z^(j-i)).re := by
  induction n with
  | zero => simp
  | succ n ih =>
      rw [Finset.sum_range_succ,norm_add,ih,cross_sum c n z hz]
      simp only [Complex.normSq_mul,map_pow,hz,one_pow,mul_one,
        Finset.sum_range_succ,Complex.add_re]
      ring

end P14CircleNormSum
end
end

section

/-! An explicit degree-preserving analytic polynomial whose doubled real
part on the unit circle is the squared norm of a finite analytic sum. -/

noncomputable section
open scoped BigOperators
namespace P14AnalyticNormPolynomial
open Polynomial

def normPoly (c : ℕ → ℂ) (n : ℕ) : ℂ[X] :=
  C (((∑ i ∈ Finset.range n, Complex.normSq (c i))/2 : ℝ) : ℂ)+
    ∑ j ∈ Finset.range n, ∑ i ∈ Finset.range j, C (c j*star (c i))*X^(j-i)

theorem degree (c : ℕ → ℂ) (n : ℕ) : (normPoly c n).natDegree ≤ n-1 := by
  apply (natDegree_add_le _ _).trans
  apply max_le
  · rw [natDegree_C]
    exact Nat.zero_le _
  · apply natDegree_sum_le_of_forall_le
    intro j hj
    apply natDegree_sum_le_of_forall_le
    intro i hi
    exact (natDegree_C_mul_X_pow_le _ _).trans (by have h := Finset.mem_range.mp hj; omega)

theorem constant (c : ℕ → ℂ) (n : ℕ) :
    (normPoly c n).coeff 0=(((∑ i ∈ Finset.range n, Complex.normSq (c i))/2 : ℝ) : ℂ) := by
  simp only [normPoly,coeff_add,coeff_C,ite_true,finsetSum_coeff,coeff_C_mul]
  have hzero : (∑ j ∈ Finset.range n, ∑ i ∈ Finset.range j,
      (c j*star (c i))*(X^(j-i) : ℂ[X]).coeff 0)=0 := by
    apply Finset.sum_eq_zero
    intro j hj
    apply Finset.sum_eq_zero
    intro i hi
    have h : j-i ≠ 0 := by have h := Finset.mem_range.mp hi; omega
    simp [coeff_X_pow,Ne.symm h]
  rw [hzero,add_zero]

theorem eval_real (c : ℕ → ℂ) (n : ℕ) (z : ℂ) (hz : Complex.normSq z=1) :
    2*((normPoly c n).eval z).re=Complex.normSq (∑ i ∈ Finset.range n, c i*z^i) := by
  rw [P14CircleNormSum.norm_sum c n z hz]
  simp only [normPoly,eval_add,eval_C,eval_finsetSum,eval_mul,eval_pow,eval_X,
    Complex.add_re,Complex.ofReal_re]
  ring

end P14AnalyticNormPolynomial
end
end

section

/-! Finite complex coefficients give exact coordinates for every bounded
degree complex polynomial and continuous evaluation maps. -/

noncomputable section
open scoped BigOperators
namespace P14PolynomialCoefficientSpace
open Polynomial

abbrev Coeff (n : ℕ) := Fin (n+1) → ℂ

def poly {n : ℕ} (b : Coeff n) : ℂ[X] := ∑ i, C (b i)*X^i.val

def extend {n : ℕ} (b : Coeff n) (i : ℕ) : ℂ := if h : i < n+1 then b ⟨i,h⟩ else 0

theorem degree {n : ℕ} (b : Coeff n) : (poly b).natDegree ≤ n := by
  apply natDegree_sum_le_of_forall_le
  intro i _
  exact (natDegree_C_mul_X_pow_le _ _).trans (by omega)

theorem coefficient {n : ℕ} (b : Coeff n) (i : Fin (n+1)) : (poly b).coeff i.val=b i := by
  classical
  simp only [poly,finsetSum_coeff,coeff_C_mul]
  rw [Finset.sum_eq_single i]
  · simp
  · intro j _ hji
    have h : i.val ≠ j.val := fun h => hji (Fin.ext h.symm)
    simp [coeff_X_pow,h]
  · simp

theorem reconstruct {n : ℕ} (P : ℂ[X]) (hP : P.natDegree ≤ n) :
    poly (fun i : Fin (n+1) => P.coeff i.val)=P := by
  ext k
  by_cases hk : k < n+1
  · exact coefficient _ ⟨k,hk⟩
  · rw [coeff_eq_zero_of_natDegree_lt ((degree _).trans_lt (by omega)),
      coeff_eq_zero_of_natDegree_lt (hP.trans_lt (by omega))]

theorem eval_eq {n : ℕ} (b : Coeff n) (z : ℂ) :
    (poly b).eval z=∑ i : Fin (n+1), b i*z^i.val := by
  simp only [poly,eval_finsetSum,eval_mul,eval_C,eval_pow,eval_X]

theorem eval_range {n : ℕ} (b : Coeff n) (z : ℂ) :
    (poly b).eval z=∑ i ∈ Finset.range (n+1), extend b i*z^i := by
  rw [eval_eq,←Fin.sum_univ_eq_sum_range]
  simp only [extend,dif_pos (Fin.isLt _)]

theorem eval_add {n : ℕ} (a b : Coeff n) (z : ℂ) :
    (poly (a+b)).eval z=(poly a).eval z+(poly b).eval z := by
  simp only [eval_eq,Pi.add_apply,add_mul,Finset.sum_add_distrib]

theorem eval_smul {n : ℕ} (e : ℝ) (b : Coeff n) (z : ℂ) :
    (poly (e • b)).eval z=(e:ℂ)*(poly b).eval z := by
  simp only [eval_eq,Pi.smul_apply,Complex.real_smul,mul_assoc,Finset.mul_sum]

theorem continuous_eval {n : ℕ} (z : ℂ) : Continuous (fun b : Coeff n => (poly b).eval z) := by
  simp only [eval_eq]
  fun_prop

end P14PolynomialCoefficientSpace
end
end

section

/-! For every degree, the explicitly constructed positive-frequency norm
polynomial gives a smooth finite coefficient correction. Its identity
slice yields an actual local spectral coefficient branch. -/

noncomputable section
open Filter
open scoped BigOperators Topology
namespace P14GeneralSpectralCorrection
open Polynomial P14PolynomialCoefficientSpace P14AnalyticNormPolynomial

def quadratic {n : ℕ} (b : Coeff n) : Coeff n :=
  fun k => (normPoly (extend b) (n+1)).coeff k.val

theorem quadratic_poly {n : ℕ} (b : Coeff n) :
    poly (quadratic b)=normPoly (extend b) (n+1) := by
  apply reconstruct
  simpa only [Nat.add_sub_cancel] using P14AnalyticNormPolynomial.degree (extend b) (n+1)

theorem quadratic_norm {n : ℕ} (b : Coeff n) (z : ℂ) (hz : Complex.normSq z=1) :
    2*((poly (quadratic b)).eval z).re=Complex.normSq ((poly b).eval z) := by
  rw [quadratic_poly,P14AnalyticNormPolynomial.eval_real _ _ z hz,eval_range]

theorem quadratic_smooth (n : ℕ) : ContDiff ℝ ⊤ (quadratic (n := n)) := by
  have hc (i : ℕ) : ContDiff ℝ ⊤ (fun b : Coeff n => extend b i) := by
    unfold extend
    split_ifs <;> fun_prop
  have hs (i : ℕ) : ContDiff ℝ ⊤ (fun b : Coeff n => star (extend b i)) :=
    Complex.conjCLE.contDiff.comp (hc i)
  have hn (i : ℕ) : ContDiff ℝ ⊤ (fun b : Coeff n => Complex.normSq (extend b i)) := by
    simp only [Complex.normSq_apply]
    exact ((Complex.reCLM.contDiff.comp (hc i)).mul (Complex.reCLM.contDiff.comp (hc i))).add
      ((Complex.imCLM.contDiff.comp (hc i)).mul (Complex.imCLM.contDiff.comp (hc i)))
  rw [contDiff_pi]
  intro k
  simp only [quadratic,normPoly,coeff_add,coeff_C,finsetSum_coeff,coeff_C_mul]
  split_ifs
  · apply ContDiff.add
    · exact Complex.ofRealCLM.contDiff.comp
        ((show ContDiff ℝ ⊤ (fun b : Coeff n => ∑ i ∈ Finset.range (n+1), Complex.normSq (extend b i)) by fun_prop).div_const 2)
    · fun_prop
  · fun_prop

def balance {n : ℕ} (t : Coeff n) (p : ℝ × Coeff n) : Coeff n :=
  p.2+p.1 • quadratic (t+p.2)

theorem balance_smooth {n : ℕ} (t : Coeff n) : ContDiff ℝ ⊤ (balance t) := by
  unfold balance
  exact contDiff_snd.add (contDiff_fst.smul
    ((quadratic_smooth n).comp (contDiff_const.add contDiff_snd)))

theorem exists_coefficients {n : ℕ} (t : Coeff n) :
    ∃ b : ℝ → Coeff n, b 0=t ∧ Tendsto b (𝓝 0) (𝓝 t) ∧
      ∀ᶠ e in 𝓝 (0:ℝ), b e+e • quadratic (b e)=t := by
  obtain ⟨ψ,V,hV,hzero,hψ,hlim,hgraph⟩ :=
    P14IdentitySliceImplicit.exists_graph
      ((balance_smooth t).of_le le_top).contDiffAt (by intro v; simp [balance])
      isOpen_univ (Set.mem_univ (0,0))
  refine ⟨fun e => t+ψ e,by simp [hψ],?_,?_⟩
  · simpa only [add_zero] using tendsto_const_nhds.add hlim
  · filter_upwards [hV.mem_nhds hzero] with e he
    have h := (hgraph e he).1
    change ψ e+e • quadratic (t+ψ e)=0 at h
    rw [add_assoc,h,add_zero]

end P14GeneralSpectralCorrection
end
end

section

/-! An actual local spectral factor in every degree, with an explicit
continuous first-order polynomial. The identity holds on the whole unit
circle, not only at a sampled grid. -/

noncomputable section
open Filter
open scoped Topology
namespace P14GeneralSpectralFactor
open Polynomial P14PolynomialCoefficientSpace P14GeneralSpectralCorrection

theorem norm_step (e : ℝ) (x : ℂ) :
    Complex.normSq (1+(e:ℂ)*x)=1+2*e*x.re+e^2*Complex.normSq x := by
  simp only [Complex.normSq_apply,Complex.add_re,Complex.add_im,Complex.mul_re,
    Complex.mul_im,Complex.one_re,Complex.one_im,Complex.ofReal_re,Complex.ofReal_im]
  ring

theorem factor_identity {n : ℕ} (t b : Coeff n) (e : ℝ)
    (h : b+e • quadratic b=t) (z : ℂ) (hz : Complex.normSq z=1) :
    Complex.normSq (1+(e:ℂ)*(poly b).eval z)=1+2*e*((poly t).eval z).re := by
  have he := congrArg (fun c : Coeff n => ((poly c).eval z).re) h
  simp only [P14PolynomialCoefficientSpace.eval_add,P14PolynomialCoefficientSpace.eval_smul,
    Complex.add_re,Complex.mul_re,Complex.ofReal_re,Complex.ofReal_im,zero_mul,sub_zero] at he
  rw [norm_step,←quadratic_norm b z hz]
  linear_combination 2*e*he

theorem exists_coefficients {n : ℕ} (t : Coeff n) :
    ∃ b : ℝ → Coeff n, b 0=t ∧ Tendsto b (𝓝 0) (𝓝 t) ∧
      ∀ᶠ (e : ℝ) in 𝓝 (0:ℝ), ∀ z : ℂ, Complex.normSq z=1 →
        Complex.normSq (1+(e:ℂ)*(poly (b e)).eval z)=1+2*e*((poly t).eval z).re := by
  obtain ⟨b,hb,hlim,heq⟩ := P14GeneralSpectralCorrection.exists_coefficients t
  refine ⟨b,hb,hlim,?_⟩
  filter_upwards [heq] with e he
  exact factor_identity t (b e) e he

theorem exists_path {n : ℕ} (B : ℂ[X]) (hB : B.natDegree ≤ n) :
    ∃ R : ℝ → ℂ[X], R 0=B ∧ (∀ e, (R e).natDegree ≤ n) ∧
      (∀ z : ℂ, Tendsto (fun e => (R e).eval z) (𝓝 0) (𝓝 (B.eval z))) ∧
      ∀ᶠ (e : ℝ) in 𝓝 (0:ℝ), ∀ z : ℂ, Complex.normSq z=1 →
        Complex.normSq (1+(e:ℂ)*(R e).eval z)=1+2*e*(B.eval z).re := by
  let t : Coeff n := fun i => B.coeff i.val
  have ht : poly t=B := reconstruct B hB
  obtain ⟨b,hb,hlim,hfactor⟩ := exists_coefficients t
  refine ⟨fun e => poly (b e),by change poly (b 0)=B; rw [hb,ht],fun e => degree (b e),?_,?_⟩
  · intro z
    have h := ((continuous_eval z).tendsto t).comp hlim
    simpa only [Function.comp_def,ht] using h
  · simpa only [ht] using hfactor

theorem factor_degree {n : ℕ} (P : ℂ[X]) (hP : P.natDegree ≤ n) (e : ℝ) :
    (1+C (e:ℂ)*P).natDegree ≤ n := by
  apply (natDegree_add_le _ _).trans
  apply max_le
  · rw [natDegree_one]
    exact Nat.zero_le _
  · exact (natDegree_C_mul_le _ _).trans hP

end P14GeneralSpectralFactor
end
end

section

/-! The common positive collision-jet polynomial is the actual first
order term of a bounded-degree spectral path. Near zero, positive
parameters give exactly unit retained Fourier values and strictly
smaller squared norms at every discarded frequency. -/

noncomputable section
open Filter
open scoped Topology
namespace P14CommonFourierSpectralPath
open Polynomial P14FourierWeightWindow P14FourierSpectralWeights

theorem common {T : Type*} [Fintype T] {q m : ℕ} (hm : 3 ≤ m) (hq : m+1 < q)
    (hodd : Odd q) (a b : T → ℕ) (hb : ∀ t, 1 ≤ b t) (hcount : ∀ t, a t+b t=m)
    (X : ∀ t, Fin (a t) → ℂ) (Y : ∀ t, Fin (b t) → ℂ)
    (hX : ∀ t, Function.Injective (X t)) (hY : ∀ t, Function.Injective (Y t))
    (hYn : ∀ t j, Y t j ≠ 0) (hsub : ∀ t j, ∃ i, X t i=Y t j) :
    ∃ (B : ℂ[X]) (R : ℝ → ℂ[X]), B.natDegree ≤ m-1 ∧ (B.coeff 0).im=0 ∧
      R 0=B ∧ (∀ e, (R e).natDegree ≤ m-1) ∧
      (∀ z : ℂ, Tendsto (fun e => (R e).eval z) (𝓝 0) (𝓝 (B.eval z))) ∧
      (∀ t, LinearIndependent ℂ (Sum.elim
        (fun i => fun k : Fin (m+1) => X t i^k.val)
        (fun j k => B.eval (sample q m k)*Y t j^k.val))) ∧
      ∀ᶠ (e : ℝ) in 𝓝 (0:ℝ), 0 < e →
        (∀ k : Fin (m+1), Complex.normSq (1+(e:ℂ)*(R e).eval (sample q m k))=1) ∧
        (∀ k : Fin q, m < k.val → Complex.normSq (1+(e:ℂ)*(R e).eval (fourierRoot q^k.val)) < 1) := by
  obtain ⟨B,hB,hconstant,hzero,hnegative,hLI⟩ :=
    P14PositiveFourierJetFamily.common hm hq hodd a b hb hcount X Y hX hY hYn hsub
  obtain ⟨R,hR,hdegree,hlim,hfactor⟩ := P14GeneralSpectralFactor.exists_path B hB
  refine ⟨B,R,hB,hconstant,hR,hdegree,hlim,hLI,?_⟩
  have hunit (k : ℕ) : Complex.normSq (fourierRoot q^k)=1 := by
    rw [P14QuadraticFourierTarget.root_power,P14QuadraticFourierTarget.phase_normSq]
  filter_upwards [hfactor] with e he
  intro hepos
  constructor
  · intro k
    rw [he (sample q m k) (by exact hunit k.val),hzero k]
    ring
  · intro k hk
    rw [he _ (hunit k.val)]
    have hneg : 2*e*(B.eval (fourierRoot q^k.val)).re < 0 :=
      mul_neg_of_pos_of_neg (mul_pos (by norm_num) hepos) (hnegative k hk)
    linarith

end P14CommonFourierSpectralPath
end
