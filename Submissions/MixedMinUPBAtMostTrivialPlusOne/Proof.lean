/-! The actual ququart factor and exactly 2q-5 qubits, for odd q>=11.
One parameter witnesses both every-five-row spanning and graph orthogonality.
The complement matchings and killing budget discharge the full UPB interface.
This is a subfamily of problem14, not a resolution of its unrestricted root. -/
noncomputable section
namespace P14QuquartExceptionalUPB
open P14ComplexLocalCover P14QuquartRootGrid
open P14FivePrescribedPairings (rootNode rootNode_injective)
open P14QuquartLargeOrder (rho)
open scoped BigOperators

theorem exists_local_factor {q : ℕ} [NeZero q] (hq : 11 ≤ q) (ho : Odd q) :
    HasLocalFactor (Fin q ⊕ Fin q) 4 4
      (P14QuquartGraphCover.E (show 7 ≤ q by omega)) := by
  have hn : 0 < q := by omega
  obtain ⟨a, z, had, hnz, hspan⟩ :=
    P14QuquartPhysicalRows.exists_physical_spanning q hq (phase q) (phase_norm q)
      (rootNode q) (rootNode_injective hn) (node_norm hn)
  refine ⟨fixedFamily q a z, hnz, ?_, ?_⟩
  · intro S hS
    exact hspan S hS
  · intro i j hij
    exact prescribed_pairing (by omega) ho a z had i j hij

def dimensions (q : ℕ) : Fin ((2 * q - 5) + 1) → ℕ :=
  Fin.cons 4 (fun _ : Fin (2 * q - 5) => 2)

def caps (q : ℕ) : Fin ((2 * q - 5) + 1) → ℕ :=
  Fin.cons 4 (fun _ : Fin (2 * q - 5) => 1)

theorem sum_caps (q : ℕ) : (∑ j, caps q j) = 4 + (2 * q - 5) := by
  simp [caps, Fin.sum_univ_succ]

theorem sum_dimensions_sub_one (q : ℕ) :
    (∑ j, (dimensions q j - 1)) = 3 + (2 * q - 5) := by
  simp [dimensions, Fin.sum_univ_succ]

theorem ceiling {q : ℕ} (hq : 11 ≤ q) :
    2 + ∑ j, (dimensions q j - 1) = 2 * q := by
  rw [sum_dimensions_sub_one]
  omega

theorem canonical {q : ℕ} (hq : 11 ≤ q) (ho : Odd q) :
    ∃ m : ℕ, m ≤ 2 + ∑ j, (dimensions q j - 1) ∧
      ∃ v : Fin m → (j : Fin ((2 * q - 5) + 1)) → Fin (dimensions q j) → ℂ,
        (∀ i j, v i j ≠ 0) ∧
        (∀ i i', i ≠ i' →
          ∃ j, (∑ r, star (v i j r) * v i' j r) = 0) ∧
        (∀ a : (j : Fin ((2 * q - 5) + 1)) → Fin (dimensions q j) → ℂ,
          (∀ j, a j ≠ 0) → ∃ i, ∀ j, (∑ r, star (v i j r) * a j r) ≠ 0) := by
  classical
  letI : NeZero q := ⟨by omega⟩
  have h7 : 7 ≤ q := by omega
  obtain ⟨F, hF, hfix, hcover⟩ := P14QuquartGraphCover.construct h7 ho
  let R : Fin ((2 * q - 5) + 1) → (Fin q ⊕ Fin q) →
      (Fin q ⊕ Fin q) → Prop :=
    Fin.cons (P14QuquartGraphCover.E h7) (fun c i j => F c i = j)
  have hlocal : ∀ j, HasLocalFactor (Fin q ⊕ Fin q)
      (dimensions q j) (caps q j) (R j) := by
    intro j
    refine Fin.cases ?_ (fun c => ?_) j
    · exact exists_local_factor hq ho
    · exact P14MatchingLocalFactor.on_finite (F c) (hF c) (hfix c)
  have hcomplete : ∀ i i' : Fin q ⊕ Fin q, i ≠ i' → ∃ j, R j i i' := by
    intro i i' hii'
    rcases hcover i i' hii' with h | ⟨c, hc⟩
    · exact ⟨0, h⟩
    · exact ⟨c.succ, hc⟩
  have hcard : Fintype.card (Fin q ⊕ Fin q) = 2 * q := by simp [two_mul]
  have hbudget : (∑ j, caps q j) < Fintype.card (Fin q ⊕ Fin q) := by
    rw [sum_caps, hcard]
    omega
  have hbound : Fintype.card (Fin q ⊕ Fin q) ≤
      2 + ∑ j, (dimensions q j - 1) := by
    rw [hcard, ceiling hq]
  exact P14ComplexLocalCover.canonical (dimensions q) (caps q) R
    hlocal hcomplete hbudget hbound

end P14QuquartExceptionalUPB

end
end

