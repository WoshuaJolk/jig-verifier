theorem certificates_checked : ∀ i, Check 2 rowsC (chosen i) (inverses i) (scale i) := by
  intro i
  fin_cases i <;> decide

set_option maxRecDepth 8192 in
set_option maxHeartbeats 2000000 in
theorem coverage_checked : ((List.finRange 10).sublistsLen 7).all (Covers chosen) = true := by
  decide

theorem killing_bound (a : Fin 6 → ℂ) (ha : a ≠ 0) (S : Finset (Fin 10))
    (hS : ∀ i ∈ S, (∑ j, star (row i j) * a j) = 0) : S.card ≤ 6 := by
  exact P14QuadraticFiniteCertificate.killing_bound 2 rowsC chosen inverses scale
    certificates_checked coverage_checked a ha S hS

end P14TenRowQuadraticSix

