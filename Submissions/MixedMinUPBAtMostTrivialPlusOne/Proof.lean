/-! Exhaustive exact seventh-root triple norms and the complete exceptional
ququart family for every odd q>=7. The finite reduction is proved in Lean. -/
noncomputable section
namespace P14QuquartSevenUPB
open P14QuquartSevenTrig P14QuquartLargeOrder
open P14FivePrescribedPairings P14QuquartRootGrid P14QuquartGridMinors
open P14QuquartExceptionalUPB (dimensions)

theorem table_sum_cases (a b : Fin 7) (ha : a ≠ 0) (hb : b ≠ 0) (hab : a ≠ b) :
    realTable a + realTable b + realTable (b - a) = 2 * c₁ + c₂ ∨
    realTable a + realTable b + realTable (b - a) = c₁ + c₂ + c₃ ∨
    realTable a + realTable b + realTable (b - a) = c₁ + 2 * c₃ ∨
    realTable a + realTable b + realTable (b - a) = 2 * c₂ + c₃ := by
  fin_cases a <;> fin_cases b <;>
    norm_num [realTable, Fin.ext_iff, Fin.sub_def] at *
  all_goals first
    | (left; ring; done)
    | (right; left; ring; done)
    | (right; right; left; ring; done)
    | (right; right; right; ring; done)

theorem triple_norm_ne (y : Fin 3 → Fin 7) (hy : Function.Injective y) :
    ‖rootNode 7 (y 0) + rootNode 7 (y 1) + rootNode 7 (y 2)‖ ≠
      rho 7 * sigma 7 + 1 := by
  let a : Fin 7 := y 1 - y 0
  let b : Fin 7 := y 2 - y 0
  have ha : a ≠ 0 :=
    sub_ne_zero.mpr (fun he => (by decide : (1 : Fin 3) ≠ 0) (hy he))
  have hb : b ≠ 0 :=
    sub_ne_zero.mpr (fun he => (by decide : (2 : Fin 3) ≠ 0) (hy he))
  have hab : a ≠ b := by
    intro he
    have he' := congrArg (fun t : Fin 7 => t + y 0) he
    dsimp [a, b] at he'
    simp only [sub_add_cancel] at he'
    exact (by decide : (1 : Fin 3) ≠ 2) (hy he')
  have hdelta : y 2 - y 1 = b - a := by dsimp [a, b]; abel
  have hn (i : Fin 7) : Complex.normSq (rootNode 7 i) = 1 := by
    rw [Complex.normSq_eq_norm_sq, node_norm (by decide : 0 < 7) i]
    norm_num
  have hform : Complex.normSq (rootNode 7 (y 0) + rootNode 7 (y 1) + rootNode 7 (y 2)) =
      3 + 2 * (realTable a + realTable b + realTable (b - a)) := by
    rw [P14QuquartNineBounds.three_normSq, hn, hn, hn,
      rootNode_ratio (by decide : 0 < 7), rootNode_ratio (by decide : 0 < 7),
      rootNode_ratio (by decide : 0 < 7), hdelta, root_real, root_real, root_real]
    change 1 + 1 + 1 + 2 * realTable a + 2 * realTable b + 2 * realTable (b - a) = _
    ring
  intro he
  have he2 : Complex.normSq (rootNode 7 (y 0) + rootNode 7 (y 1) + rootNode 7 (y 2)) =
      rho 7 ^ 2 := by
    rw [Complex.normSq_eq_norm_sq, he, coefficient]
  rw [he2, rho_square] at hform
  obtain ⟨h1, h2, h3⟩ := cosine_signs
  have hs := cosine_sum
  rcases table_sum_cases a b ha hb hab with hc | hc | hc | hc <;> linarith

theorem canonical_ge_seven (q : ℕ) (hq : 7 ≤ q) (ho : Odd q) :
    ∃ m : ℕ, m ≤ 2 + ∑ j, (dimensions q j - 1) ∧
      ∃ v : Fin m → (j : Fin ((2 * q - 5) + 1)) → Fin (dimensions q j) → ℂ,
        (∀ i j, v i j ≠ 0) ∧
        (∀ i i', i ≠ i' →
          ∃ j, (∑ r, star (v i j r) * v i' j r) = 0) ∧
        (∀ a : (j : Fin ((2 * q - 5) + 1)) → Fin (dimensions q j) → ℂ,
