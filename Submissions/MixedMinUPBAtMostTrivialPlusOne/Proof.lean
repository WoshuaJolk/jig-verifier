/-! The literal corrected UPB conclusion and its domain under arbitrary factor
equivalences. The reindexing proof follows the already checked
UPBFactorPermutation.reindex without importing its unrelated Cyclic example.
These transport lemmas do not supply an unrestricted existence theorem. -/

namespace P14CanonicalUPBTransport
open scoped BigOperators

def Conclusion (p : ℕ) (d : Fin p → ℕ) : Prop :=
  ∃ m : ℕ, m ≤ 2 + ∑ j, (d j - 1) ∧
    ∃ v : Fin m → (j : Fin p) → Fin (d j) → ℂ,
      (∀ i j, v i j ≠ 0) ∧
      (∀ i i', i ≠ i' → ∃ j, (∑ r, star (v i j r) * v i' j r) = 0) ∧
      (∀ a : (j : Fin p) → Fin (d j) → ℂ, (∀ j, a j ≠ 0) →
        ∃ i, ∀ j, (∑ r, star (v i j r) * a j r) ≠ 0)

def Admissible (p : ℕ) (d : Fin p → ℕ) : Prop :=
  2 ≤ p ∧ (∀ j, 2 ≤ d j) ∧
    ¬ (p = 2 ∧ ∃ j, d j = 2) ∧ ¬ (∀ j, d j = 2)

theorem reindex {p q : ℕ} (d : Fin p → ℕ) (e : Fin q ≃ Fin p)
    (h : Conclusion p d) : Conclusion q (fun j => d (e j)) := by
  obtain ⟨m, hBound, v, hNonzero, hOrth, hSurvivor⟩ := h
  refine ⟨m, ?_, (fun i j => v i (e j)), ?_, ?_, ?_⟩
  · have hSum : (∑ j : Fin q, (d (e j) - 1)) = ∑ j : Fin p, (d j - 1) :=
      e.sum_comp (fun j => d j - 1)
    simpa only [hSum] using hBound
  · intro i j
    exact hNonzero i (e j)
  · intro i i' hDifferent
    obtain ⟨j, hj⟩ := hOrth i i' hDifferent
    obtain ⟨l, rfl⟩ := e.surjective j
    exact ⟨l, hj⟩
  · intro a ha
    let b : (j : Fin p) → Fin (d j) → ℂ :=
      Equiv.piCongrLeft (fun j => Fin (d j) → ℂ) e a
    have hb : ∀ j, b j ≠ 0 := by
      intro j
      obtain ⟨l, rfl⟩ := e.surjective j
      simpa only [b, Equiv.piCongrLeft_apply_apply] using ha l
    obtain ⟨i, hi⟩ := hSurvivor b hb
    refine ⟨i, ?_⟩
    intro j
    simpa only [b, Equiv.piCongrLeft_apply_apply] using hi (e j)

theorem of_dimensions {p q : ℕ} (d : Fin p → ℕ) (D : Fin q → ℕ)
    (e : Fin q ≃ Fin p) (hDimensions : ∀ j, D j = d (e j))
    (h : Conclusion p d) : Conclusion q D := by
  have hEq : D = fun j => d (e j) := funext hDimensions
  rw [hEq]
  exact reindex d e h

theorem admissible_reindex {p q : ℕ} (d : Fin p → ℕ) (e : Fin q ≃ Fin p)
    (h : Admissible p d) : Admissible q (fun j => d (e j)) := by
  have hcard : q = p := by simpa using Fintype.card_congr e
  refine ⟨by simpa only [hcard] using h.1, (fun j => h.2.1 (e j)), ?_, ?_⟩
  · rintro ⟨hq, j, hj⟩
    exact h.2.2.1 ⟨by omega, e j, hj⟩
  · intro hAll
    apply h.2.2.2
    intro j
    obtain ⟨l, rfl⟩ := e.surjective j
    exact hAll l

theorem admissible_of_dimensions {p q : ℕ} (d : Fin p → ℕ) (D : Fin q → ℕ)
    (e : Fin q ≃ Fin p) (hDimensions : ∀ j, D j = d (e j))
    (h : Admissible p d) : Admissible q D := by
  have hEq : D = fun j => d (e j) := funext hDimensions
  rw [hEq]
  exact admissible_reindex d e h

end P14CanonicalUPBTransport

end

