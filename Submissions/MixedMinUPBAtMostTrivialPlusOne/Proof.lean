/-! Pair the general frame with one cyclic-window factor. Reflection
aligns the uncovered Fourier shifts with the unshifted window. -/

noncomputable section
open scoped BigOperators
namespace P14BipartiteFrameCover
open P14GeneralFrameLocalFactor P14WindowCircleLocalFactors
open P14ComplexLocalCover P14CanonicalUPBTransport P14FourierSpectralWeights

def negIndex (q : ℕ) [NeZero q] : Fin q ≃ Fin q where
  toFun := Neg.neg
  invFun := Neg.neg
  left_inv := neg_neg
  right_inv := neg_neg

def reflect (q : ℕ) [NeZero q] : (Fin q ⊕ Fin q) ≃ (Fin q ⊕ Fin q) :=
  Equiv.sumCongr (negIndex q) (negIndex q)

theorem cover {q m : ℕ} [NeZero q] (hm : m ≤ q)
    (x y : Fin q ⊕ Fin q) (hxy : x ≠ y) :
    Prescribed m (reflect q x) (reflect q y) ∨ WindowRelation hm 0 x y := by
  cases x with
  | inl i =>
    cases y with
    | inl j =>
      apply Or.inl
      change -i ≠ -j
      exact neg_injective.ne (fun h => hxy (congrArg Sum.inl h))
    | inr j =>
      by_cases h : m ≤ (j-i).val
      · apply Or.inl
        change m ≤ (-i - -j).val
        have he : -i - -j=j-i := by abel
        rwa [he]
      · apply Or.inr
        refine ⟨i,j,⟨(j-i).val,by omega⟩,?_,Or.inl ⟨rfl,rfl⟩⟩
        simpa only [zero_add] using (Fin.ext rfl : j-i=(⟨(j-i).val,by omega⟩ : Fin m).castLE hm)
  | inr i =>
    cases y with
    | inl j =>
      by_cases h : m ≤ (i-j).val
      · apply Or.inl
        change m ≤ (-j - -i).val
        have he : -j - -i=i-j := by abel
        rwa [he]
      · apply Or.inr
        refine ⟨j,i,⟨(i-j).val,by omega⟩,?_,Or.inr ⟨rfl,rfl⟩⟩
        simpa only [zero_add] using (Fin.ext rfl : i-j=(⟨(i-j).val,by omega⟩ : Fin m).castLE hm)
    | inr j =>
      apply Or.inl
      change -i ≠ -j
      exact neg_injective.ne (fun h => hxy (congrArg Sum.inr h))

def dimensions (q m : ℕ) : Fin 2 → ℕ := ![2*q-m-1,m+1]
def caps (q m : ℕ) : Fin 2 → ℕ := ![2*q-m-1,m]

theorem canonical_of_factor {q m : ℕ} (hq : m+1 < q)
    (hf : HasLocalFactor (Fin q ⊕ Fin q) (2*q-m-1) (2*q-m-1) (Prescribed m)) :
    Conclusion 2 (dimensions q m) := by
  letI : NeZero q := ⟨by omega⟩
  let R : Fin 2 → (Fin q ⊕ Fin q) → (Fin q ⊕ Fin q) → Prop :=
    ![fun i j => Prescribed m (reflect q i) (reflect q j),WindowRelation (by omega : m ≤ q) 0]
  have hl : ∀ j, HasLocalFactor (Fin q ⊕ Fin q) (dimensions q m j) (caps q m j) (R j) := by
    intro j
    fin_cases j
    · exact P14ComplexLocalCover.reindex (reflect q) hf
    · exact window (fourierRoot_isPrimitiveRoot q (by omega)) (by omega) 0
  have hc : ∀ x y : Fin q ⊕ Fin q, x ≠ y → ∃ j, R j x y := by
    intro x y hxy
    rcases cover (by omega : m ≤ q) x y hxy with h | h
    · exact ⟨0,h⟩
    · exact ⟨1,h⟩
  apply P14ComplexLocalCover.canonical (dimensions q m) (caps q m) R hl hc
  · simp [caps,Fin.sum_univ_two,Fintype.card_sum]
    omega
  · simp [dimensions,Fin.sum_univ_two,Fintype.card_sum]
    omega

theorem odd_half {q m : ℕ} (hm : 3 ≤ m) (hq : m+1 < q) (hodd : Odd q) :
    Conclusion 2 (dimensions q m) :=
  canonical_of_factor hq (exists_factor hm hq hodd)

end P14BipartiteFrameCover
end
end

