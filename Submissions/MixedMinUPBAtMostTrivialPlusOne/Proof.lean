/-! A real vector with every coordinate nonzero can satisfy one complex
linear constraint whenever, after removing any coordinate, two coefficient
directions are independent over the reals. Explicit three-coordinate
circuits provide the witnesses; finite subspace avoidance combines them. -/

noncomputable section
open scoped BigOperators
namespace P14RealKernelCircuits

def area (a b : ℂ) : ℝ := a.re*b.im-a.im*b.re

theorem circuit_cancel (a b c : ℂ) :
    (area b c : ℂ)*a+(area c a : ℂ)*b+(area a b : ℂ)*c=0 := by
  apply Complex.ext <;>
    simp only [area,Complex.add_re,Complex.add_im,Complex.mul_re,Complex.mul_im,
      Complex.ofReal_re,Complex.ofReal_im,Complex.zero_re,Complex.zero_im] <;> ring

def constraint {ι : Type*} [Fintype ι] (a : ι → ℂ) : (ι → ℝ) →ₗ[ℝ] ℂ :=
  ∑ i, (LinearMap.proj i).smulRight (a i)

theorem constraint_apply {ι : Type*} [Fintype ι] (a : ι → ℂ) (t : ι → ℝ) :
    constraint a t=∑ i, (t i : ℂ)*a i := by
  simp [constraint,Algebra.smul_def]

theorem constraint_single {ι : Type*} [Fintype ι] [DecidableEq ι]
    (a : ι → ℂ) (i : ι) (t : ℝ) :
    constraint a (Pi.single i t)=(t : ℂ)*a i := by
  rw [constraint_apply]
  simp [Pi.single_apply,apply_ite]

theorem exists_all_nonzero {ι : Type*} [Fintype ι] (a : ι → ℂ)
    (h : ∀ i, ∃ j k, i ≠ j ∧ i ≠ k ∧ area (a j) (a k) ≠ 0) :
    ∃ t : ι → ℝ, (∑ i, (t i : ℂ)*a i)=0 ∧ ∀ i, t i ≠ 0 := by
  classical
  let p := LinearMap.ker (constraint a)
  have hw : ∀ i, ∃ t ∈ p, (LinearMap.proj i : (ι → ℝ) →ₗ[ℝ] ℝ) t ≠ 0 := by
    intro i
    obtain ⟨j,k,hij,hik,hn⟩ := h i
    let t : ι → ℝ := Pi.single i (area (a j) (a k))+
      Pi.single j (area (a k) (a i))+Pi.single k (area (a i) (a j))
    refine ⟨t,?_,?_⟩
    · apply LinearMap.mem_ker.mpr
      simp only [t,map_add,constraint_single]
      exact circuit_cancel (a i) (a j) (a k)
    · simpa [t,Pi.single_apply,hij,hik] using hn
  choose w hwmem hwn using hw
  let P (i : ι) : MvPolynomial ι ℝ := ∑ j, MvPolynomial.C (w j i)*MvPolynomial.X j
  have heval (i : ι) (z : ι → ℝ) :
      MvPolynomial.eval z (P i)=∑ j, w j i*z j := by
    simp [P]
  have hp (i : ι) : P i ≠ 0 := by
    intro hh
    have hz : MvPolynomial.eval (Pi.single i 1) (P i)=0 := by rw [hh]; simp
    rw [heval] at hz
    have hz' : w i i=0 := by simpa [Pi.single_apply] using hz
    exact hwn i hz'
  obtain ⟨z,hz⟩ := P14PolynomialThreeRows.exists_common_nonzero P hp
  let t : ι → ℝ := ∑ j, z j • w j
  have ht : t ∈ p := Submodule.sum_mem p (fun j _ => Submodule.smul_mem p _ (hwmem j))
  refine ⟨t,(constraint_apply a t).symm.trans (LinearMap.mem_ker.mp ht),?_⟩
  intro i
  have hi := hz i
  rw [heval] at hi
  simpa [t,Finset.sum_apply,Pi.smul_apply,smul_eq_mul,mul_comm] using hi

end P14RealKernelCircuits
end
end

