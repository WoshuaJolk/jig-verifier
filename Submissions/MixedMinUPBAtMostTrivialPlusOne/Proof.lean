open P14QuadraticFrameLocalFactor P14ComplexLocalCover
open P14PrismRemainderCover P14CanonicalUPBTransport

def matching {q : ℕ} [NeZero q] (hq : 3 ≤ q) (c : Fin 3) :
    (Fin q ⊕ Fin q) → (Fin q ⊕ Fin q) :=
  crossMatching (-⟨c.val, lt_of_lt_of_le c.isLt hq⟩)

theorem cover {q : ℕ} [NeZero q] (hq : 3 ≤ q)
    (x y : Fin q ⊕ Fin q) (hxy : x ≠ y) :
    Prescribed x y ∨ ∃ c : Fin 3, matching hq c x = y := by
  cases x with
  | inl x =>
    cases y with
    | inl y => exact Or.inl (by simpa [Prescribed] using hxy)
    | inr y =>
      by_cases hh : 3 ≤ (x - y).val
      · exact Or.inl hh
      · let c : Fin 3 := ⟨(x - y).val, by omega⟩
        have hc : (⟨c.val, lt_of_lt_of_le c.isLt hq⟩ : Fin q) = x - y := Fin.ext rfl
        refine Or.inr ⟨c, ?_⟩
        change Sum.inr (x + -⟨c.val, lt_of_lt_of_le c.isLt hq⟩) = Sum.inr y
        rw [hc]
        congr 1
        abel
  | inr x =>
    cases y with
    | inl y =>
      by_cases hh : 3 ≤ (y - x).val
      · exact Or.inl hh
      · let c : Fin 3 := ⟨(y - x).val, by omega⟩
        have hc : (⟨c.val, lt_of_lt_of_le c.isLt hq⟩ : Fin q) = y - x := Fin.ext rfl
        refine Or.inr ⟨c, ?_⟩
        change Sum.inl (x - -⟨c.val, lt_of_lt_of_le c.isLt hq⟩) = Sum.inl y
        rw [hc]
        congr 1
        abel
    | inr y => exact Or.inl (by simpa [Prescribed] using hxy)

def dimensions (q : ℕ) : Fin 4 → ℕ := Fin.cons (2 * q - 4) (fun _ => 2)
def caps (q : ℕ) : Fin 4 → ℕ := Fin.cons (2 * q - 4) (fun _ => 1)

theorem canonical {q : ℕ} (hq : 7 ≤ q) : Conclusion 4 (dimensions q) := by
  letI : NeZero q := ⟨by omega⟩
  let R : Fin 4 → (Fin q ⊕ Fin q) → (Fin q ⊕ Fin q) → Prop :=
    Fin.cons Prescribed (fun c x y => matching (by omega) c x = y)
  have hl : ∀ j, HasLocalFactor (Fin q ⊕ Fin q) (dimensions q j) (caps q j) (R j) := by
    intro j
    refine Fin.cases ?_ (fun c => ?_) j
    · exact exists_factor hq
    · exact P14MatchingLocalFactor.on_finite _ (cross_involutive _) (cross_ne _)
  have hc : ∀ x y : Fin q ⊕ Fin q, x ≠ y → ∃ j, R j x y := by
    intro x y hxy
    rcases cover (by omega : 3 ≤ q) x y hxy with h | ⟨c, hh⟩
    · exact ⟨0, h⟩
    · exact ⟨c.succ, hh⟩
  apply P14ComplexLocalCover.canonical (dimensions q) (caps q) R hl hc
  · simp only [caps, Fin.sum_univ_succ, Fin.cons_zero, Fin.cons_succ,
      Finset.sum_const, Finset.card_univ, Fintype.card_fin, nsmul_eq_mul,
      Fintype.card_sum]
    omega
  · simp only [dimensions, Fin.sum_univ_succ, Fin.cons_zero, Fin.cons_succ,
      Nat.reduceSub, Finset.sum_const, Finset.card_univ, Fintype.card_fin,
      nsmul_eq_mul, Fintype.card_sum]
    omega

end P14QuadraticThreeQubitUPB
end
end

section

/-! Explicit matchings for two cyclic layers with their cycle edges removed,
completed by three consecutive cross shifts. A reflection switches layers
exactly at its fixed point and at the endpoints of its removed cycle edge.
The proof needs neither a factorization theorem nor a coprimality premise. -/

namespace P14ReflectionThreeShift
variable {q : ℕ} [NeZero q]

def Hole (c a : Fin q) : Prop :=
  c - a = a ∨ c - a = a + 1 ∨ a = (c - a) + 1

instance (c : Fin q) : DecidablePred (Hole c) := fun a =>
  inferInstanceAs (Decidable (c - a = a ∨ c - a = a + 1 ∨ a = (c - a) + 1))

theorem hole_reflection (c a : Fin q) : Hole c (c - a) ↔ Hole c a := by
  simp only [Hole, sub_sub_cancel]
  constructor
  · rintro (h | h | h)
    · exact Or.inl h.symm
    · exact Or.inr (Or.inr h)
    · exact Or.inr (Or.inl h)
  · rintro (h | h | h)
    · exact Or.inl h.symm
    · exact Or.inr (Or.inr h)
    · exact Or.inr (Or.inl h)

def matching (c : Fin q) : (Fin q ⊕ Fin q) → (Fin q ⊕ Fin q)
  | .inl a => if Hole c a then .inr (c - a) else .inl (c - a)
  | .inr a => if Hole c a then .inl (c - a) else .inr (c - a)

theorem involutive (c : Fin q) : Function.Involutive (matching c) := by
  rintro (a | a)
  · by_cases h : Hole c a
    · simp [matching, h, (hole_reflection c a).mpr h]
    · have h' : ¬ Hole c (c - a) := fun hh => h ((hole_reflection c a).mp hh)
      simp [matching, h, h']
  · by_cases h : Hole c a
    · simp [matching, h, (hole_reflection c a).mpr h]
    · have h' : ¬ Hole c (c - a) := fun hh => h ((hole_reflection c a).mp hh)
      simp [matching, h, h']

theorem fixedPointFree (c : Fin q) (x : Fin q ⊕ Fin q) : matching c x ≠ x := by
  have hne (a : Fin q) (h : ¬ Hole c a) : c - a ≠ a :=
    fun he => h (Or.inl he)
  cases x with
  | inl a => by_cases h : Hole c a <;> simp [matching, h, hne a]
  | inr a => by_cases h : Hole c a <;> simp [matching, h, hne a]

theorem within_cover (a b : Fin q) (hne : a ≠ b)
    (hnext : b ≠ a + 1) (hprev : a ≠ b + 1) :
    ∃ c, matching c (.inl a) = .inl b ∧ matching c (.inr a) = .inr b := by
  have he : (a + b) - a = b := by abel
  have hh : ¬ Hole (a + b) a := by
    rw [Hole, he]
    rintro (h | h | h)
    · exact hne h.symm
    · exact hnext h
    · exact hprev h
  exact ⟨a + b, by simp [matching, hh, he]⟩

theorem cross_cover (a b : Fin q) (h : b = a ∨ b = a + 1 ∨ a = b + 1) :
    ∃ c, matching c (.inl a) = .inr b := by
  have he : (a + b) - a = b := by abel
  have hh : Hole (a + b) a := by simpa only [Hole, he] using h
  exact ⟨a + b, by simp [matching, hh, he]⟩

def shift (b : Fin q) : (Fin q ⊕ Fin q) ≃ (Fin q ⊕ Fin q) where
  toFun := Sum.elim Sum.inl (fun a => Sum.inr (a + b))
  invFun := Sum.elim Sum.inl (fun a => Sum.inr (a - b))
  left_inv := by rintro (a | a) <;> simp
  right_inv := by rintro (a | a) <;> simp

def shifted (b c : Fin q) (x : Fin q ⊕ Fin q) : Fin q ⊕ Fin q :=
  shift b (matching c ((shift b).symm x))

theorem shifted_involutive (b c : Fin q) : Function.Involutive (shifted b c) := by
  intro x
  simp only [shifted, Equiv.symm_apply_apply, involutive c ((shift b).symm x), Equiv.apply_symm_apply]

theorem shifted_fixedPointFree (b c : Fin q) (x : Fin q ⊕ Fin q) :
    shifted b c x ≠ x := by
  intro h
  apply fixedPointFree c ((shift b).symm x)
  exact (shift b).injective (h.trans ((shift b).apply_symm_apply x).symm)

theorem shifted_within (b a z : Fin q) (hne : a ≠ z)
    (hnext : z ≠ a + 1) (hprev : a ≠ z + 1) :
    (∃ c, shifted b c (.inl a) = .inl z) ∧
    (∃ c, shifted b c (.inr a) = .inr z) := by
  constructor
  · obtain ⟨c, hc, _⟩ := within_cover a z hne hnext hprev
    refine ⟨c, ?_⟩
    change shift b (matching c (.inl a)) = .inl z
    rw [hc]
    rfl
  · have hn : a - b ≠ z - b := by
      intro h
      apply hne
      have ht := congrArg (fun w : Fin q => w + b) h
      simpa only [sub_add_cancel] using ht
    have hx : z - b ≠ (a - b) + 1 := by
      intro h
      apply hnext
      calc
        z = (z - b) + b := (sub_add_cancel _ _).symm
        _ = (a - b + 1) + b := by rw [h]
        _ = a + 1 := by abel
    have hp : a - b ≠ (z - b) + 1 := by
      intro h
      apply hprev
      calc
        a = (a - b) + b := (sub_add_cancel _ _).symm
        _ = (z - b + 1) + b := by rw [h]
        _ = z + 1 := by abel
    obtain ⟨c, _, hc⟩ := within_cover (a - b) (z - b) hn hx hp
    refine ⟨c, ?_⟩
    change shift b (matching c (.inr (a - b))) = .inr z
    rw [hc]
    change Sum.inr (z - b + b) = Sum.inr z
    rw [sub_add_cancel]

theorem shifted_cross (b a z : Fin q)
    (h : z - b = a ∨ z - b = a + 1 ∨ a = (z - b) + 1) :
    ∃ c, shifted b c (.inl a) = .inr z := by
  obtain ⟨c, hc⟩ := cross_cover a (z - b) h
  refine ⟨c, ?_⟩
  change shift b (matching c (.inl a)) = .inr z
  rw [hc]
  change Sum.inr (z - b + b) = Sum.inr z
  rw [sub_add_cancel]

end P14ReflectionThreeShift
end

section

/-! A polynomial vanishing exactly at the removed Fourier nodes suffices
for the prescribed cross edges. No assertion about all coefficients is needed. -/

noncomputable section
namespace P14TailRootPolynomial
open Polynomial
open scoped BigOperators

def tail (z : ℂ) (q d : ℕ) : Polynomial ℂ :=
  ∏ k : Fin (q - d), (X - C (z ^ (d + k.val)))

def extended (z : ℂ) (q d : ℕ) (eta : ℂ) : Polynomial ℂ :=
  tail z q d * (X - C eta)

theorem eval_tail (z : ℂ) (q d : ℕ) (w : ℂ) :
    (tail z q d).eval w = ∏ k : Fin (q - d), (w - z ^ (d + k.val)) := by
  simp [tail, eval_prod]

theorem retained_ne_zero {q d : ℕ} (hd : d ≤ q) (z : ℂ)
    (hz : IsPrimitiveRoot z q) (j : Fin d) : (tail z q d).eval (z ^ j.val) ≠ 0 := by
  rw [eval_tail]
  apply Finset.prod_ne_zero_iff.mpr
  intro k _
  apply sub_ne_zero.mpr
  intro h
  have he := hz.pow_inj (j.isLt.trans_le hd) (show d + k.val < q by omega) h
  omega

theorem removed_zero {q d j : ℕ} (z : ℂ) (hdj : d ≤ j) (hjq : j < q) :
    (tail z q d).eval (z ^ j) = 0 := by
  rw [eval_tail]
  let k : Fin (q - d) := ⟨j - d, by omega⟩
  apply Finset.prod_eq_zero (Finset.mem_univ k)
  have he : d + k.val = j := by dsimp [k]; omega
  rw [he, sub_self]

theorem degree_tail (z : ℂ) (q d : ℕ) : (tail z q d).natDegree ≤ q - d := by
  calc
    _ ≤ ∑ k : Fin (q - d), (X - C (z ^ (d + k.val)) : Polynomial ℂ).natDegree :=
      natDegree_prod_le Finset.univ _
    _ = q - d := by simp only [natDegree_X_sub_C]; simp

theorem degree_extended (z : ℂ) (q d : ℕ) (eta : ℂ) :
    (extended z q d eta).natDegree ≤ q - d + 1 := by
  exact (natDegree_mul_le).trans (by simpa using Nat.add_le_add_right (degree_tail z q d) 1)

theorem eval_extended (z : ℂ) (q d : ℕ) (eta w : ℂ) :
    (extended z q d eta).eval w = (tail z q d).eval w * (w - eta) := by
  simp [extended]

theorem extended_removed_zero {q d j : ℕ} (z eta : ℂ) (hdj : d ≤ j) (hjq : j < q) :
    (extended z q d eta).eval (z ^ j) = 0 := by
  rw [eval_extended, removed_zero z hdj hjq, zero_mul]

theorem sum_truncate {q d : ℕ} (hd : d ≤ q) (f : ℕ → ℂ)
    (hf : ∀ k, d ≤ k → k < q → f k = 0) :
    (∑ j : Fin d, f j.val) = ∑ j : Fin q, f j.val := by
  rw [Fin.sum_univ_eq_sum_range, Fin.sum_univ_eq_sum_range]
  apply Finset.sum_subset (Finset.range_mono hd)
  intro k hk hkd
  apply hf k
  · exact Nat.le_of_not_gt (fun h => hkd (Finset.mem_range.mpr h))
  · exact Finset.mem_range.mp hk

end P14TailRootPolynomial
end
end

section

/-! A nonsingular extension of the two reciprocal complex moment equations.
The middle block has n entries, and the small block has order n+1. The
zero-parameter slice is the identity, including the empty-middle case n=0. -/

noncomputable section
open Filter
open scoped BigOperators Topology
namespace P14SeparatedReciprocalMap
open P14ComplexPairCoordinates

def reciprocal (r : ℝ) (z : ℂ) (A : Fin 3 → ℝ) (c : ℂ) : ℂ :=
  ∑ j : Fin 3, (A j / triple r z c j : ℂ) * z ^ j.val

def firstMiddle {n : ℕ} (t : Fin n → ℂ) (e : ℝ) : ℂ :=
  ∑ i : Fin n, e ^ (i.val + 1) • t i

def secondMiddle {n : ℕ} (C : Fin n → ℝ) (t : Fin n → ℂ) (e : ℝ) : ℂ :=
  ∑ i : Fin n, (C i * e ^ (n - i.val)) • t i

def balance {n : ℕ} (r : ℝ) (z w : ℂ) (A B : Fin 3 → ℝ)
    (C : Fin n → ℝ) (t : Fin n → ℂ) (p : ℝ × (ℂ × ℂ)) : ℂ × ℂ :=
  (p.2.1 + firstMiddle t p.1 +
      p.1 ^ (n + 1) • (w * reciprocal r z B (p.2.2 / w)),
    p.2.2 + secondMiddle C t p.1 +
      p.1 ^ (n + 1) • reciprocal r z A p.2.1)

theorem zero_slice {n : ℕ} (r : ℝ) (z w : ℂ) (A B : Fin 3 → ℝ)
    (C : Fin n → ℝ) (t : Fin n → ℂ) (v : ℂ × ℂ) :
    balance r z w A B C t (0, v) = v := by
  have hi : ∀ i : Fin n, n - i.val ≠ 0 := fun i => by omega
  simp [balance, firstMiddle, secondMiddle, hi]

theorem reciprocal_smooth (r : ℝ) (hr : 0 < r) (z : ℂ) (A : Fin 3 → ℝ) :
    ContDiffAt ℝ 1 (reciprocal r z A) 0 := by
  unfold reciprocal
  apply ContDiffAt.sum
  intro j _
  have ht : ContDiffAt ℝ 1 (fun c => triple r z c j) 0 :=
    ((contDiff_triple r z j).of_le le_top).contDiffAt
  have hn : triple r z 0 j ≠ 0 := (zero_mem_positive r hr z j).ne'
  have hq : ContDiffAt ℝ 1 (fun c => A j / triple r z c j) 0 :=
    contDiffAt_const.div ht hn
  have hc := Complex.ofRealCLM.contDiff.contDiffAt.comp (0 : ℂ) hq
  simpa only [Function.comp_def, Complex.ofRealCLM_apply, Complex.ofReal_div] using
    hc.mul (contDiffAt_const (c := z ^ j.val))

theorem balance_smooth {n : ℕ} (r : ℝ) (hr : 0 < r) (z w : ℂ)
    (A B : Fin 3 → ℝ) (C : Fin n → ℝ) (t : Fin n → ℂ) :
    ContDiffAt ℝ 1 (balance r z w A B C t) (0, 0) := by
  have hlow : ContDiffAt ℝ 1
      (fun p : ℝ × (ℂ × ℂ) => reciprocal r z A p.2.1) (0, 0) :=
    ContDiffAt.comp (f := fun p : ℝ × (ℂ × ℂ) => p.2.1)
      (g := reciprocal r z A) (0, 0) (reciprocal_smooth r hr z A) contDiffAt_snd.fst
  have hhigh : ContDiffAt ℝ 1
      (fun p : ℝ × (ℂ × ℂ) => reciprocal r z B (p.2.2 / w)) (0, 0) := by
    have h := (contDiffAt_snd.snd.div_const w : ContDiffAt ℝ 1
      (fun p : ℝ × (ℂ × ℂ) => p.2.2 / w) (0, 0))
    have hb : ContDiffAt ℝ 1 (reciprocal r z B) ((0 : ℂ) / w) := by
      simpa using reciprocal_smooth r hr z B
    exact ContDiffAt.comp (f := fun p : ℝ × (ℂ × ℂ) => p.2.2 / w)
      (g := reciprocal r z B) (0, 0) hb h
  have hfirst : ContDiffAt ℝ 1
      (fun p : ℝ × (ℂ × ℂ) => firstMiddle t p.1) (0, 0) := by
    unfold firstMiddle
    apply ContDiffAt.sum
    intro i _
    exact (contDiffAt_fst.pow (i.val + 1)).smul contDiffAt_const
  have hsecond : ContDiffAt ℝ 1
      (fun p : ℝ × (ℂ × ℂ) => secondMiddle C t p.1) (0, 0) := by
    unfold secondMiddle
    apply ContDiffAt.sum
    intro i _
    exact (contDiffAt_const.mul (contDiffAt_fst.pow (n - i.val))).smul contDiffAt_const
  exact ((contDiffAt_snd.fst.add hfirst).add
      ((contDiffAt_fst.pow (n + 1)).smul (contDiffAt_const.mul hhigh))).prodMk
    ((contDiffAt_snd.snd.add hsecond).add
      ((contDiffAt_fst.pow (n + 1)).smul hlow))

theorem exists_positive_branch {n : ℕ} (r : ℝ) (hr : 0 < r) (z w : ℂ)
    (A B : Fin 3 → ℝ) (C : Fin n → ℝ) (t : Fin n → ℂ) :
    ∃ (ψ : ℝ → ℂ × ℂ) (V : Set ℝ), IsOpen V ∧ 0 ∈ V ∧
      ψ 0 = 0 ∧ Tendsto ψ (𝓝 0) (𝓝 0) ∧
      ∀ e ∈ V, balance r z w A B C t (e, ψ e) = 0 ∧
        (∀ j, 0 < triple r z (ψ e).1 j) ∧
        (∀ j, 0 < triple r z ((ψ e).2 / w) j) := by
  let U : Set (ℝ × (ℂ × ℂ)) :=
    {p | p.2.1 ∈ positive r z ∧ p.2.2 / w ∈ positive r z}
  have hU : IsOpen U :=
    ((isOpen_positive r z).preimage continuous_snd.fst).inter
      ((isOpen_positive r z).preimage (continuous_snd.snd.div_const w))
  have hu : (0, 0) ∈ U := by
    exact ⟨zero_mem_positive r hr z, by simpa using zero_mem_positive r hr z⟩
  obtain ⟨ψ, V, hV, hzero, hψ, hlim, hgraph⟩ :=
    P14IdentitySliceImplicit.exists_graph (balance_smooth r hr z w A B C t)
      (zero_slice r z w A B C t) hU hu
  exact ⟨ψ, V, hV, hzero, hψ, hlim, hgraph⟩

end P14SeparatedReciprocalMap
end
end

section

/-! Exact conversion from the nonsingular correction map to positive weights
and the two original complex moments. No spanning condition is assumed or
concluded in this conversion. -/

noncomputable section
open scoped BigOperators
namespace P14SeparatedWeightMoments
open P14ComplexPairCoordinates P14SeparatedReciprocalMap

def upper {n : ℕ} (r : ℝ) (z w : ℂ) (B : Fin 3 → ℝ)
    (e : ℝ) (v : ℂ × ℂ) (j : Fin 3) : ℝ :=
  e ^ (n + 1) * B j / triple r z (v.2 / w) j

def firstMoment {n : ℕ} (r : ℝ) (z w : ℂ) (B : Fin 3 → ℝ)
    (t : Fin n → ℂ) (e : ℝ) (v : ℂ × ℂ) : ℂ :=
  (∑ j : Fin 3, (triple r z v.1 j : ℂ) * z ^ j.val) + firstMiddle t e +
    ∑ j : Fin 3, (upper (n := n) r z w B e v j : ℂ) * (w * z ^ j.val)

def secondMoment {n : ℕ} (r : ℝ) (z w : ℂ) (A B : Fin 3 → ℝ)
    (C : Fin n → ℝ) (t : Fin n → ℂ) (e : ℝ) (v : ℂ × ℂ) : ℂ :=
  reciprocal r z A v.1 +
    (∑ i : Fin n, (C i / e ^ (i.val + 1) : ℂ) * t i) +
    ∑ j : Fin 3, (B j / upper (n := n) r z w B e v j : ℂ) * (w * z ^ j.val)

theorem upper_positive {n : ℕ} (r : ℝ) (z w : ℂ) (B : Fin 3 → ℝ)
    (e : ℝ) (v : ℂ × ℂ) (he : 0 < e) (hB : ∀ j, 0 < B j)
    (hv : ∀ j, 0 < triple r z (v.2 / w) j) :
    ∀ j, 0 < upper (n := n) r z w B e v j := by
  intro j
  exact div_pos (mul_pos (pow_pos he _) (hB j)) (hv j)

theorem first_eq {n : ℕ} (r : ℝ) (z w : ℂ) (A B : Fin 3 → ℝ)
    (C : Fin n → ℝ) (t : Fin n → ℂ) (e : ℝ) (v : ℂ × ℂ)
    (hz : z.im ≠ 0) (hr : 1 + (r : ℂ) * z + z ^ 2 = 0) :
    firstMoment r z w B t e v = (balance r z w A B C t (e, v)).1 := by
  have hu : (∑ j : Fin 3, (upper (n := n) r z w B e v j : ℂ) * (w * z ^ j.val)) =
      e ^ (n + 1) • (w * reciprocal r z B (v.2 / w)) := by
    simp only [upper, reciprocal, Complex.real_smul, Complex.ofReal_mul,
      Complex.ofReal_div, Finset.mul_sum]
    apply Finset.sum_congr rfl
    intro j _
    ring
  simp only [firstMoment, triple_sum r z v.1 hz hr, hu, balance]

theorem middle_cancel {n : ℕ} (e c : ℝ) (he : e ≠ 0) (i : Fin n) :
    e ^ (n + 1) * (c / e ^ (i.val + 1)) = c * e ^ (n - i.val) := by
  have hp : n + 1 = (n - i.val) + (i.val + 1) := by omega
  rw [hp, pow_add]
  field_simp

theorem upper_cancel (M : ℕ) (e b h : ℝ) (he : e ≠ 0) (hb : b ≠ 0) :
    e ^ M * (b / (e ^ M * b / h)) = h := by
  field_simp

theorem second_scaled_eq {n : ℕ} (r : ℝ) (z w : ℂ) (A B : Fin 3 → ℝ)
    (C : Fin n → ℝ) (t : Fin n → ℂ) (e : ℝ) (v : ℂ × ℂ)
    (he : e ≠ 0) (hB : ∀ j, B j ≠ 0) (hw : w ≠ 0)
    (hz : z.im ≠ 0) (hr : 1 + (r : ℂ) * z + z ^ 2 = 0) :
    e ^ (n + 1) • secondMoment r z w A B C t e v =
      (balance r z w A B C t (e, v)).2 := by
  have hm : e ^ (n + 1) •
      (∑ i : Fin n, (C i / e ^ (i.val + 1) : ℂ) * t i) = secondMiddle C t e := by
    rw [Finset.smul_sum]
    apply Finset.sum_congr rfl
    intro i _
    have hc := congrArg Complex.ofReal (middle_cancel e (C i) he i)
    simp only [Complex.ofReal_mul, Complex.ofReal_div] at hc
    simp only [Complex.real_smul, secondMiddle]
    calc
      _ = ((e ^ (n + 1) : ℝ) : ℂ) *
          ((C i : ℂ) / ((e ^ (i.val + 1) : ℝ) : ℂ)) * t i := by
            push_cast
            ring
      _ = _ := by rw [hc]; push_cast; rfl
  have hu : e ^ (n + 1) •
      (∑ j : Fin 3, (B j / upper (n := n) r z w B e v j : ℂ) *
        (w * z ^ j.val)) = v.2 := by
    rw [Finset.smul_sum]
    calc
      _ = w * (∑ j : Fin 3, (triple r z (v.2 / w) j : ℂ) * z ^ j.val) := by
        rw [Finset.mul_sum]
        apply Finset.sum_congr rfl
        intro j _
        have hc := congrArg Complex.ofReal
          (upper_cancel (n + 1) e (B j) (triple r z (v.2 / w) j) he (hB j))
        simp only [Complex.ofReal_mul, Complex.ofReal_div] at hc
        simp only [Complex.real_smul, upper]
        calc
          _ = (((e ^ (n + 1) : ℝ) : ℂ) * ((B j : ℂ) /
              (((e ^ (n + 1) * B j / triple r z (v.2 / w) j : ℝ) : ℂ)))) *
              (w * z ^ j.val) := by push_cast; ring
          _ = _ := by rw [show ((e ^ (n + 1) * B j /
              triple r z (v.2 / w) j : ℝ) : ℂ) =
              (((e ^ (n + 1) : ℝ) : ℂ) * B j / triple r z (v.2 / w) j) by
                push_cast; rfl, hc]; ring
      _ = v.2 := by rw [triple_sum r z (v.2 / w) hz hr]; field_simp
  simp only [secondMoment, smul_add, hm, hu, balance]
  abel

theorem moments_zero {n : ℕ} (r : ℝ) (z w : ℂ) (A B : Fin 3 → ℝ)
    (C : Fin n → ℝ) (t : Fin n → ℂ) (e : ℝ) (v : ℂ × ℂ)
    (he : 0 < e) (hB : ∀ j, 0 < B j) (hw : w ≠ 0)
    (hz : z.im ≠ 0) (hr : 1 + (r : ℂ) * z + z ^ 2 = 0)
    (h : balance r z w A B C t (e, v) = 0) :
    firstMoment r z w B t e v = 0 ∧ secondMoment r z w A B C t e v = 0 := by
  refine ⟨(first_eq r z w A B C t e v hz hr).trans (congrArg Prod.fst h), ?_⟩
  have hs := (second_scaled_eq r z w A B C t e v he.ne'
    (fun j => (hB j).ne') hw hz hr).trans (congrArg Prod.snd h)
  exact (smul_eq_zero.mp hs).resolve_left (pow_ne_zero _ he.ne')

end P14SeparatedWeightMoments
end
end

section

/-! Actual positive weights on n+6 coordinates, satisfying both complex
moment equations. Each weight is a prescribed power times a coefficient
with a positive limit. This is not yet a mixed-minor or spanning theorem. -/

noncomputable section
open Filter
open scoped BigOperators Topology
namespace P14SeparatedPositiveWeights
open P14ComplexPairCoordinates P14SeparatedReciprocalMap P14SeparatedWeightMoments

abbrev Coord (n : ℕ) := Fin 3 ⊕ (Fin n ⊕ Fin 3)

def order {n : ℕ} : Coord n → ℕ :=
  Sum.elim (fun _ => 0) (Sum.elim (fun i => i.val + 1) (fun _ => n + 1))

def direction {n : ℕ} (z w : ℂ) (t : Fin n → ℂ) : Coord n → ℂ :=
  Sum.elim (fun j => z ^ j.val) (Sum.elim t (fun j => w * z ^ j.val))

def intensity {n : ℕ} (A B : Fin 3 → ℝ) (C : Fin n → ℝ) : Coord n → ℝ :=
  Sum.elim A (Sum.elim C B)

def coefficient {n : ℕ} (r : ℝ) (z w : ℂ) (B : Fin 3 → ℝ)
    (v : ℂ × ℂ) : Coord n → ℝ :=
  Sum.elim (triple r z v.1)
    (Sum.elim (fun _ => 1) (fun j => B j / triple r z (v.2 / w) j))

def weights {n : ℕ} (r : ℝ) (z w : ℂ) (B : Fin 3 → ℝ)
    (e : ℝ) (v : ℂ × ℂ) (i : Coord n) : ℝ :=
  e ^ order i * coefficient r z w B v i

theorem card_coord (n : ℕ) : Fintype.card (Coord n) = n + 6 := by
  simp [Coord]
  omega

theorem coefficient_positive {n : ℕ} (r : ℝ) (z w : ℂ) (B : Fin 3 → ℝ)
    (v : ℂ × ℂ) (hB : ∀ j, 0 < B j)
    (hl : ∀ j, 0 < triple r z v.1 j)
    (hh : ∀ j, 0 < triple r z (v.2 / w) j) :
    ∀ i : Coord n, 0 < coefficient r z w B v i := by
  intro i
  rcases i with j | (j | j)
  · exact hl j
  · exact zero_lt_one
  · exact div_pos (hB j) (hh j)

theorem coefficient_continuousAt_zero {n : ℕ} (r : ℝ) (hr : 0 < r)
    (z w : ℂ) (B : Fin 3 → ℝ) (i : Coord n) :
    ContinuousAt (fun v => coefficient r z w B v i) 0 := by
  rcases i with j | (j | j)
  · exact (contDiff_triple r z j).continuous.continuousAt.comp continuousAt_fst
  · exact continuousAt_const
  · have hd : ContinuousAt (fun v : ℂ × ℂ => triple r z (v.2 / w) j) 0 :=
      (contDiff_triple r z j).continuous.continuousAt.comp
        (continuousAt_snd.div_const w)
    apply continuousAt_const.div hd
    simpa using (zero_mem_positive r hr z j).ne'

theorem first_sum {n : ℕ} (r : ℝ) (z w : ℂ) (B : Fin 3 → ℝ)
    (t : Fin n → ℂ) (e : ℝ) (v : ℂ × ℂ) :
    (∑ i : Coord n, (weights r z w B e v i : ℂ) * direction z w t i) =
      firstMoment r z w B t e v := by
  simp [weights, order, coefficient, direction, firstMoment, firstMiddle,
    Fintype.sum_sum_type, upper, Complex.real_smul, mul_div_assoc, add_assoc]

theorem second_sum {n : ℕ} (r : ℝ) (z w : ℂ) (A B : Fin 3 → ℝ)
    (C : Fin n → ℝ) (t : Fin n → ℂ) (e : ℝ) (v : ℂ × ℂ) :
    (∑ i : Coord n, ((intensity A B C i / weights r z w B e v i : ℝ) : ℂ) *
      direction z w t i) = secondMoment r z w A B C t e v := by
  simp [weights, order, coefficient, direction, intensity, secondMoment, reciprocal,
    Fintype.sum_sum_type, upper, mul_div_assoc, add_assoc]

theorem exists_weights {n : ℕ} (r : ℝ) (hr : 0 < r) (z w : ℂ)
    (hw : w ≠ 0) (hz : z.im ≠ 0) (hrel : 1 + (r : ℂ) * z + z ^ 2 = 0)
    (A B : Fin 3 → ℝ) (hB : ∀ j, 0 < B j)
    (C : Fin n → ℝ) (t : Fin n → ℂ) :
    ∃ (a : ℝ → Coord n → ℝ),
      (∀ i, Tendsto (fun e => a e i) (𝓝 0)
        (𝓝 (coefficient r z w B 0 i))) ∧
      (∀ i : Coord n, 0 < coefficient r z w B 0 i) ∧
      ∀ᶠ e in 𝓝 (0 : ℝ), 0 < e →
        (∀ i, 0 < e ^ order i * a e i) ∧
        (∑ i, ((e ^ order i * a e i : ℝ) : ℂ) * direction z w t i) = 0 ∧
        (∑ i, ((intensity A B C i / (e ^ order i * a e i) : ℝ) : ℂ) *
          direction z w t i) = 0 := by
  obtain ⟨ψ, V, hV, hzero, hψ, hlim, hgraph⟩ :=
    exists_positive_branch r hr z w A B C t
  refine ⟨fun e => coefficient r z w B (ψ e), ?_, ?_, ?_⟩
  · intro i
    exact (coefficient_continuousAt_zero r hr z w B i).tendsto.comp hlim
  · exact coefficient_positive r z w B 0 hB (zero_mem_positive r hr z)
      (by simpa [positive] using zero_mem_positive r hr z)
  · filter_upwards [hV.mem_nhds hzero] with e heV
    intro he
    obtain ⟨hb, hl, hh⟩ := hgraph e heV
    obtain ⟨hfirst, hsecond⟩ := moments_zero r z w A B C t e (ψ e)
      he hB hw hz hrel hb
    refine ⟨fun i => mul_pos (pow_pos he _) (coefficient_positive r z w B (ψ e) hB hl hh i), ?_, ?_⟩
    · exact (first_sum r z w B t e (ψ e)).trans hfirst
    · exact (second_sum r z w A B C t e (ψ e)).trans hsecond

end P14SeparatedPositiveWeights
end
end

section

/-! The actual dimension-five monomial family from Wang, Appendix D.3.
Here a and b are real square-root weights, not the paper's raw coefficients.
Pairing identities hold for the same coordinate vectors at every parameter.
This module does not supply the spectral weights or simultaneous spanning. -/

noncomputable section
namespace P14FiveMonomialFamily
open scoped BigOperators

def pair (x y : Fin 5 → ℂ) : ℂ := ∑ i, star (x i) * y i

def u (a b : ℝ) (z : ℂ) : Fin 5 → ℂ :=
  ![1, (a : ℂ) * z, (b : ℂ) * z ^ 2, (a : ℂ) * z ^ 3, z ^ 4]

def monomial (c t : ℂ) (x : Fin 5 → ℂ) : Fin 5 → ℂ :=
  ![t * x 3, -(t * x 4), c * x 0, -x 1, star c * x 2]

def v (a b : ℝ) (c t z : ℂ) : Fin 5 → ℂ :=
  ![t * ((a : ℂ) * z ^ 3), -(t * z ^ 4), c,
    -((a : ℂ) * z), star c * ((b : ℂ) * z ^ 2)]

theorem v_eq_monomial (a b : ℝ) (c t z : ℂ) :
    v a b c t z = monomial c t (u a b z) := by
  simp [v, monomial, u]

theorem u_ne_zero (a b : ℝ) (z : ℂ) : u a b z ≠ 0 := by
  intro h
  have h0 := congrFun h (0 : Fin 5)
  simp [u] at h0

theorem v_ne_zero (a b : ℝ) {c : ℂ} (hc : c ≠ 0) (t z : ℂ) :
    v a b c t z ≠ 0 := by
  intro h
  have h2 := congrFun h (2 : Fin 5)
  have : c = 0 := by simpa [v] using h2
  exact hc this

theorem monomial_pair (c t : ℂ)
    (hc : star c * c = 1) (ht : star t * t = 1)
    (x y : Fin 5 → ℂ) :
    pair (monomial c t x) (monomial c t y) = pair x y := by
  have hc' : c * star c = 1 := by simpa only [mul_comm] using hc
  calc
    _ = (star t * t) * (star (x 3) * y 3 + star (x 4) * y 4) +
        (star c * c) * (star (x 0) * y 0) +
        star (x 1) * y 1 + (c * star c) * (star (x 2) * y 2) := by
      simp [pair, monomial, Fin.sum_univ_succ, star_mul]
      ring
    _ = pair x y := by
      rw [hc, hc', ht]
      simp [pair, Fin.sum_univ_succ]
      ring

theorem v_pair (a b : ℝ) (c t : ℂ)
    (hc : star c * c = 1) (ht : star t * t = 1) (z w : ℂ) :
    pair (v a b c t z) (v a b c t w) = pair (u a b z) (u a b w) := by
  rw [v_eq_monomial, v_eq_monomial]
  exact monomial_pair c t hc ht _ _

def kernel (a b : ℝ) (x : ℂ) : ℂ :=
  1 + (a : ℂ) ^ 2 * x + (b : ℂ) ^ 2 * x ^ 2 +
    (a : ℂ) ^ 2 * x ^ 3 + x ^ 4

theorem u_pair (a b : ℝ) (z w : ℂ) :
    pair (u a b z) (u a b w) = kernel a b (star z * w) := by
  simp [pair, u, kernel, Fin.sum_univ_succ, star_mul, star_pow]
  ring

def crossConstant (a b : ℝ) (c z w : ℂ) : ℂ :=
  star z ^ 2 * ((b : ℂ) * c - (a : ℂ) ^ 2 * (star z * w) +
    (b : ℂ) * star c * (star z * w) ^ 2)

def crossSlope (a : ℝ) (z w : ℂ) : ℂ :=
  (a : ℂ) * w ^ 3 * (1 - star z * w)

theorem cross_pair (a b : ℝ) (c t z w : ℂ) :
    pair (u a b z) (v a b c t w) =
      crossConstant a b c z w + t * crossSlope a z w := by
  simp [pair, u, v, crossConstant, crossSlope, Fin.sum_univ_succ,
    star_mul, star_pow]
  ring

theorem matching_pair_zero (a b : ℝ) (c t z : ℂ)
    (hz : star z * z = 1)
    (hphase : (b : ℂ) * (c + star c) = (a : ℂ) ^ 2) :
    pair (u a b z) (v a b c t z) = 0 := by
  rw [cross_pair]
  unfold crossConstant crossSlope
  rw [hz]
  have hconstant : (b : ℂ) * c - (a : ℂ) ^ 2 + (b : ℂ) * star c = 0 := by
    rw [← hphase]
    ring
  simpa only [one_pow, mul_one, sub_self, mul_zero, add_zero, hconstant] using
    (mul_zero (star z ^ 2))

theorem crossSlope_ne_zero {a : ℝ} (ha : a ≠ 0) {z w : ℂ}
    (hz : star z * z = 1) (hw : w ≠ 0) (hzw : z ≠ w) :
    crossSlope a z w ≠ 0 := by
  have hz' : star z ≠ 0 := by
    intro h
    rw [h, zero_mul] at hz
    exact zero_ne_one hz
  have hd : 1 - star z * w ≠ 0 := by
    intro h
    have heq : star z * z = star z * w := hz.trans (sub_eq_zero.mp h)
    exact hzw (mul_left_cancel₀ hz' heq)
  exact mul_ne_zero (mul_ne_zero (Complex.ofReal_ne_zero.mpr ha) (pow_ne_zero _ hw)) hd

theorem cross_bad_parameter_unique {a b : ℝ} (ha : a ≠ 0)
    {c z w t s : ℂ} (hz : star z * z = 1) (hw : w ≠ 0) (hzw : z ≠ w)
    (ht : pair (u a b z) (v a b c t w) = 0)
    (hs : pair (u a b z) (v a b c s w) = 0) : t = s := by
  rw [cross_pair] at ht hs
  have hmul : t * crossSlope a z w = s * crossSlope a z w :=
    add_left_cancel (ht.trans hs.symm)
  exact mul_right_cancel₀ (crossSlope_ne_zero ha hz hw hzw) hmul

end P14FiveMonomialFamily


end
end

section

/-! Actual positive weights and a unit phase for the dimension-five family.
The square-root phase realizes the paper's phase without choosing an angle.
The explicit spectral kernel factorization is retained; root-grid coverage
and simultaneous spanning are separate obligations. -/

noncomputable section
namespace P14FivePositiveWeights
open P14FiveMonomialFamily

def phase (A B : ℝ) : ℂ :=
  ⟨A / (2 * Real.sqrt B), Real.sqrt (4 * B - A ^ 2) / (2 * Real.sqrt B)⟩

theorem phase_unit {A B : ℝ} (hB : 0 < B) (hgap : 0 ≤ 4 * B - A ^ 2) :
    star (phase A B) * phase A B = 1 := by
  have hb : Real.sqrt B ≠ 0 := ne_of_gt (Real.sqrt_pos.mpr hB)
  have hb2 := Real.sq_sqrt hB.le
  have hg2 := Real.sq_sqrt hgap
  apply Complex.ext
  · simp [phase, Complex.star_def, Complex.mul_re]
    field_simp [hb]
    nlinarith
  · simp [phase, Complex.star_def, Complex.mul_im]
    ring

theorem phase_balance {A B : ℝ} (hB : 0 < B) :
    (Real.sqrt B : ℂ) * (phase A B + star (phase A B)) = (A : ℂ) := by
  have hb : Real.sqrt B ≠ 0 := ne_of_gt (Real.sqrt_pos.mpr hB)
  apply Complex.ext
  · simp [phase, Complex.star_def, Complex.mul_re]
    field_simp [hb]
    ring
  · simp [phase, Complex.star_def, Complex.mul_im]

def theta (q : ℕ) : ℝ := Real.pi / q
def rawA (q : ℕ) : ℝ := 2 * (Real.cos (theta q) + Real.cos (3 * theta q))
def rawB (q : ℕ) : ℝ := 2 + 4 * Real.cos (theta q) * Real.cos (3 * theta q)
def weightA (q : ℕ) : ℝ := Real.sqrt (rawA q)
def weightB (q : ℕ) : ℝ := Real.sqrt (rawB q)
def unitPhase (q : ℕ) : ℂ := phase (rawA q) (rawB q)

theorem raw_positive {q : ℕ} (hq : 7 ≤ q) :
    0 < rawA q ∧ 0 < rawB q ∧ 0 < 4 * rawB q - (rawA q) ^ 2 := by
  have hq7 : (7 : ℝ) ≤ q := by exact_mod_cast hq
  have hqpos : (0 : ℝ) < q := by linarith
  have ht0 : 0 < theta q := div_pos Real.pi_pos hqpos
  have ht6 : theta q < Real.pi / 6 := by
    apply (div_lt_div_iff₀ hqpos (by norm_num : (0 : ℝ) < 6)).mpr
    nlinarith [Real.pi_pos]
  have hx : 0 < Real.cos (theta q) :=
    Real.cos_pos_of_mem_Ioo ⟨by linarith [Real.pi_pos], by linarith⟩
  have hy : 0 < Real.cos (3 * theta q) :=
    Real.cos_pos_of_mem_Ioo ⟨by linarith [Real.pi_pos], by linarith⟩
  have hxy := mul_pos hx hy
  have hx1 := Real.cos_le_one (theta q)
  have hy1 := Real.cos_le_one (3 * theta q)
  have hdiff : (Real.cos (theta q) - Real.cos (3 * theta q)) ^ 2 < 1 := by
    have hprod := mul_pos
      (by linarith : 0 < 1 - (Real.cos (theta q) - Real.cos (3 * theta q)))
      (by linarith : 0 < 1 + (Real.cos (theta q) - Real.cos (3 * theta q)))
    nlinarith
  dsimp only [rawA, rawB]
  refine ⟨by linarith, by nlinarith, ?_⟩
  nlinarith

theorem weights_and_phase {q : ℕ} (hq : 7 ≤ q) :
    0 < weightA q ∧ 0 < weightB q ∧
      star (unitPhase q) * unitPhase q = 1 ∧
      (weightB q : ℂ) * (unitPhase q + star (unitPhase q)) =
        (weightA q : ℂ) ^ 2 := by
  obtain ⟨hA, hB, hgap⟩ := raw_positive hq
  refine ⟨Real.sqrt_pos.mpr hA, Real.sqrt_pos.mpr hB,
    phase_unit hB hgap.le, ?_⟩
  have hA2 : (weightA q : ℂ) ^ 2 = (rawA q : ℂ) := by
    exact_mod_cast (Real.sq_sqrt hA.le)
  rw [hA2]
  exact phase_balance hB

theorem kernel_factorization {q : ℕ} (hq : 7 ≤ q) (z : ℂ) :
    kernel (weightA q) (weightB q) z =
      (z ^ 2 + 2 * (Real.cos (theta q) : ℂ) * z + 1) *
      (z ^ 2 + 2 * (Real.cos (3 * theta q) : ℂ) * z + 1) := by
  obtain ⟨hA, hB, _⟩ := raw_positive hq
  have hA2 : (weightA q : ℂ) ^ 2 = (rawA q : ℂ) := by
    exact_mod_cast (Real.sq_sqrt hA.le)
  have hB2 : (weightB q : ℂ) ^ 2 = (rawB q : ℂ) := by
    exact_mod_cast (Real.sq_sqrt hB.le)
  simp only [kernel, hA2, hB2, rawA, rawB, Complex.ofReal_add,
    Complex.ofReal_mul, Complex.ofReal_ofNat]
  ring

end P14FivePositiveWeights


end
end

section

/-! Exact root-grid factorization for the dimension-five spectral kernel.
The Fourier root and square-root weights are the existing actual definitions.
For odd q >= 7 the four exponents are h, q-h, h-1, q-(h-1), where
h=(q-1)/2. These are the natural representatives of the two signed pairs.
No graph, spanning, or simultaneous parameter-avoidance premise is used. -/

noncomputable section
namespace P14FiveRootGrid

open P14FiveMonomialFamily P14FivePositiveWeights P14FourierSpectralWeights

def half (q : ℕ) : ℕ := (q - 1) / 2

theorem half_spec {q : ℕ} (ho : Odd q) : 2 * half q + 1 = q := by
  obtain ⟨m, hm⟩ := ho
  dsimp only [half]
  omega

theorem root_pow_exp (q m : ℕ) :
    fourierRoot q ^ m =
      Complex.exp (((2 * Real.pi * (m : ℝ) / (q : ℝ) : ℝ) : ℂ) * Complex.I) := by
  unfold fourierRoot
  rw [← Complex.exp_nat_mul]
  congr 1
  simp only [Complex.ofReal_div, Complex.ofReal_mul, Complex.ofReal_ofNat,
    Complex.ofReal_natCast]
  ring

theorem root_pow_re (q m : ℕ) :
    (fourierRoot q ^ m).re = Real.cos (2 * Real.pi * (m : ℝ) / (q : ℝ)) := by
  rw [root_pow_exp, Complex.exp_ofReal_mul_I_re]

theorem root_pow_unit {q : ℕ} (hq : 0 < q) (m : ℕ) :
    star (fourierRoot q ^ m) * fourierRoot q ^ m = 1 := by
  have hζ := fourierRoot_isPrimitiveRoot q hq
  have hunit : star (fourierRoot q) * fourierRoot q = 1 := by
    change (starRingEnd ℂ) (fourierRoot q) * fourierRoot q = 1
    simpa only [hζ.norm'_eq_one (Nat.ne_of_gt hq), one_pow, Complex.ofReal_one]
      using Complex.conj_mul' (fourierRoot q)
  rw [star_pow, ← mul_pow, hunit, one_pow]

theorem root_pow_star {q m : ℕ} (hq : 0 < q) (hm : m ≤ q) :
    star (fourierRoot q ^ m) = fourierRoot q ^ (q - m) := by
  have hζ := fourierRoot_isPrimitiveRoot q hq
  apply mul_right_cancel₀ (pow_ne_zero m (hζ.ne_zero (Nat.ne_of_gt hq)))
  calc
    star (fourierRoot q ^ m) * fourierRoot q ^ m = 1 := root_pow_unit hq m
    _ = fourierRoot q ^ (q - m) * fourierRoot q ^ m := by
      rw [← pow_add, Nat.sub_add_cancel hm, hζ.pow_eq_one]

/-- The arithmetic relation identifies a Fourier power's complementary angle.
The two final uses have s=1 and s=3 and discharge this relation from oddness. -/
theorem root_pow_re_complement_angle {q m s : ℕ} (hq : 0 < q)
    (hms : 2 * m + s = q) :
    (fourierRoot q ^ m).re = -Real.cos ((s : ℝ) * theta q) := by
  have hq0 : (q : ℝ) ≠ 0 := ne_of_gt (Nat.cast_pos.mpr hq)
  have hr : 2 * (m : ℝ) + (s : ℝ) = (q : ℝ) := by exact_mod_cast hms
  have hmul := congrArg (fun x : ℝ => Real.pi * x) hr
  have hangle : 2 * Real.pi * (m : ℝ) / (q : ℝ) =
      Real.pi - (s : ℝ) * theta q := by
    calc
      2 * Real.pi * (m : ℝ) / (q : ℝ) =
          (Real.pi * (q : ℝ) - Real.pi * (s : ℝ)) / (q : ℝ) := by
        congr 1
        nlinarith [hmul]
      _ = Real.pi - (s : ℝ) * theta q := by
        unfold theta
        field_simp [hq0]
  rw [root_pow_re, hangle, Real.cos_pi_sub]

theorem root_half_re {q : ℕ} (hq : 7 ≤ q) (ho : Odd q) :
    (fourierRoot q ^ half q).re = -Real.cos (theta q) := by
  simpa only [Nat.cast_one, one_mul] using
    root_pow_re_complement_angle (by omega : 0 < q) (half_spec ho)

theorem root_pred_half_re {q : ℕ} (hq : 7 ≤ q) (ho : Odd q) :
    (fourierRoot q ^ (half q - 1)).re = -Real.cos (3 * theta q) := by
  have hh := half_spec ho
  have hrel : 2 * (half q - 1) + 3 = q := by omega
  simpa only [Nat.cast_ofNat] using
    root_pow_re_complement_angle (by omega : 0 < q) hrel

/-- A unit complex number with prescribed real part gives both linear factors. -/
theorem quadratic_factorization (c : ℝ) (z : ℂ)
    (hunit : star z * z = 1) (hre : z.re = -c) (w : ℂ) :
    w ^ 2 + 2 * (c : ℂ) * w + 1 = (w - z) * (w - star z) := by
  have hsum : z + star z = -(2 * (c : ℂ)) := by
    rw [Complex.star_def, Complex.add_conj, hre]
    simp only [Complex.ofReal_mul, Complex.ofReal_neg, Complex.ofReal_ofNat, mul_neg]
  calc
    w ^ 2 + 2 * (c : ℂ) * w + 1 =
        w ^ 2 - (z + star z) * w + star z * z := by rw [hsum, hunit]; ring
    _ = (w - z) * (w - star z) := by ring

theorem kernel_factorization_grid {q : ℕ} (hq : 7 ≤ q) (ho : Odd q) (z : ℂ) :
    kernel (weightA q) (weightB q) z =
      ((z - fourierRoot q ^ half q) * (z - fourierRoot q ^ (q - half q))) *
      ((z - fourierRoot q ^ (half q - 1)) *
        (z - fourierRoot q ^ (q - (half q - 1)))) := by
  have hh := half_spec ho
  have hqpos : 0 < q := by omega
  rw [kernel_factorization hq,
    quadratic_factorization (Real.cos (theta q)) (fourierRoot q ^ half q)
      (root_pow_unit hqpos (half q)) (root_half_re hq ho),
    quadratic_factorization (Real.cos (3 * theta q)) (fourierRoot q ^ (half q - 1))
      (root_pow_unit hqpos (half q - 1)) (root_pred_half_re hq ho),
    root_pow_star hqpos (by omega : half q ≤ q),
    root_pow_star hqpos (by omega : half q - 1 ≤ q)]

theorem kernel_eq_zero_iff {q : ℕ} (hq : 7 ≤ q) (ho : Odd q) (z : ℂ) :
    kernel (weightA q) (weightB q) z = 0 ↔
      z = fourierRoot q ^ half q ∨ z = fourierRoot q ^ (q - half q) ∨
      z = fourierRoot q ^ (half q - 1) ∨
      z = fourierRoot q ^ (q - (half q - 1)) := by
  rw [kernel_factorization_grid hq ho]
  simp only [mul_eq_zero, sub_eq_zero, or_assoc]

theorem kernel_root_grid {q : ℕ} (hq : 7 ≤ q) (ho : Odd q) :
    kernel (weightA q) (weightB q) (fourierRoot q ^ half q) = 0 ∧
    kernel (weightA q) (weightB q) (fourierRoot q ^ (q - half q)) = 0 ∧
    kernel (weightA q) (weightB q) (fourierRoot q ^ (half q - 1)) = 0 ∧
    kernel (weightA q) (weightB q) (fourierRoot q ^ (q - (half q - 1))) = 0 := by
  refine ⟨(kernel_eq_zero_iff hq ho _).mpr (Or.inl rfl),
    (kernel_eq_zero_iff hq ho _).mpr (Or.inr (Or.inl rfl)),
    (kernel_eq_zero_iff hq ho _).mpr (Or.inr (Or.inr (Or.inl rfl))),
    (kernel_eq_zero_iff hq ho _).mpr (Or.inr (Or.inr (Or.inr rfl)))⟩

theorem kernel_pow_eq_zero_iff {q : ℕ} (hq : 7 ≤ q) (ho : Odd q) (j : Fin q) :
    kernel (weightA q) (weightB q) (fourierRoot q ^ j.val) = 0 ↔
      j.val = half q ∨ j.val = q - half q ∨
      j.val = half q - 1 ∨ j.val = q - (half q - 1) := by
  have hh := half_spec ho
  have hζ := fourierRoot_isPrimitiveRoot q (by omega : 0 < q)
  have heq (m : ℕ) (hm : m < q) :
      fourierRoot q ^ j.val = fourierRoot q ^ m ↔ j.val = m :=
    ⟨hζ.pow_inj j.isLt hm, fun h => congrArg (fun a : ℕ => fourierRoot q ^ a) h⟩
  rw [kernel_eq_zero_iff hq ho,
    heq (half q) (by omega), heq (q - half q) (by omega),
    heq (half q - 1) (by omega), heq (q - (half q - 1)) (by omega)]

end P14FiveRootGrid

end
end

section

/-! The actual primitive odd-order Fourier root used by the separated
high-dimensional weights, with its positive quadratic relation. -/

noncomputable section
namespace P14HighDimensionPhase
open P14FiveRootGrid P14FivePositiveWeights P14FourierSpectralWeights

def node (q : ℕ) : ℂ := fourierRoot q ^ half q
def rho (q : ℕ) : ℝ := 2 * Real.cos (theta q)

theorem primitive {q : ℕ} (hq : 7 ≤ q) (ho : Odd q) :
    IsPrimitiveRoot (node q) q := by
  have hh := half_spec ho
  have hc : Nat.Coprime (half q) (1 + 2 * half q) :=
    (Nat.coprime_add_mul_right_right (half q) 1 2).mpr (by simp)
  have hcq : Nat.Coprime (half q) q := by
    convert hc using 1 <;> omega
  exact (fourierRoot_isPrimitiveRoot q (by omega)).pow_of_coprime (half q) hcq

theorem im_ne_zero {q : ℕ} (hq : 7 ≤ q) (ho : Odd q) : (node q).im ≠ 0 := by
  intro h
  have hstar : star (node q) = node q := by
    apply Complex.ext <;> simp [Complex.star_def, h]
  have hu : star (node q) * node q = 1 := root_pow_unit (by omega) _
  rw [hstar, ← pow_two] at hu
  exact (primitive hq ho).pow_ne_one_of_pos_of_lt (by decide : 2 ≠ 0) (by omega) hu

theorem rho_positive {q : ℕ} (hq : 7 ≤ q) : 0 < rho q := by
  have hqR : (7 : ℝ) ≤ q := by exact_mod_cast hq
  have hqpos : (0 : ℝ) < q := by linarith
  have ht0 : 0 < theta q := div_pos Real.pi_pos hqpos
  have ht2 : theta q < Real.pi / 2 := by
    apply (div_lt_div_iff₀ hqpos (by norm_num : (0 : ℝ) < 2)).mpr
    nlinarith [Real.pi_pos]
  exact mul_pos (by norm_num)
    (Real.cos_pos_of_mem_Ioo ⟨by linarith [Real.pi_pos], ht2⟩)

theorem relation {q : ℕ} (hq : 7 ≤ q) (ho : Odd q) :
    1 + (rho q : ℂ) * node q + node q ^ 2 = 0 := by
  have h := quadratic_factorization (Real.cos (theta q)) (node q)
    (root_pow_unit (by omega) _) (root_half_re hq ho) (node q)
  simp only [sub_self, zero_mul] at h
  simpa only [rho, Complex.ofReal_mul, Complex.ofReal_ofNat,
    add_comm, add_left_comm, add_assoc] using h

end P14HighDimensionPhase
end
end

section

/-! Consecutive Fourier frequencies in dimension n+6, with the actual
primitive root at odd order q. Both moments vanish for positive weights
of controlled asymptotic orders and arbitrary positive spectral intensities. -/

noncomputable section
open Filter
open scoped BigOperators Topology
namespace P14ConsecutiveReciprocalWeights
open P14SeparatedPositiveWeights P14HighDimensionPhase

def index (n : ℕ) : Coord n ≃ Fin (n + 6) :=
  (Equiv.sumCongr (Equiv.refl (Fin 3))
    (finSumFinEquiv : Fin n ⊕ Fin 3 ≃ Fin (n + 3))).trans
      ((finSumFinEquiv : Fin 3 ⊕ Fin (n + 3) ≃ Fin (3 + (n + 3))).trans
        (finCongr (by omega)))

@[simp] theorem index_left (n : ℕ) (j : Fin 3) :
    (index n (.inl j)).val = j.val := rfl

@[simp] theorem index_middle (n : ℕ) (j : Fin n) :
    (index n (.inr (.inl j))).val = 3 + j.val := rfl

@[simp] theorem index_right (n : ℕ) (j : Fin 3) :
    (index n (.inr (.inr j))).val = n + 3 + j.val := by
  change 3 + (n + j.val) = n + 3 + j.val
  omega

def power (n : ℕ) (i : Fin (n + 6)) : ℕ := order ((index n).symm i)

theorem direction_index (n : ℕ) (z : ℂ) (i : Coord n) :
    direction z (z ^ (n + 3)) (fun j : Fin n => z ^ (3 + j.val)) i =
      z ^ (index n i).val := by
  rcases i with j | (j | j)
  · simp [direction]
  · simp [direction]
  · simp [direction, pow_add]

def leading (n q : ℕ) (D : Fin (n + 6) → ℝ) (i : Fin (n + 6)) : ℝ :=
  coefficient (rho q) (node q) (node q ^ (n + 3))
    (fun j => D (index n (.inr (.inr j)))) 0 ((index n).symm i)

theorem exists_weights {n q : ℕ} (hq : 7 ≤ q) (ho : Odd q)
    (D : Fin (n + 6) → ℝ) (hD : ∀ i, 0 < D i) :
    ∃ a : ℝ → Fin (n + 6) → ℝ,
      (∀ i, Tendsto (fun e => a e i) (𝓝 0) (𝓝 (leading n q D i))) ∧
      (∀ i : Fin (n + 6), 0 < leading n q D i) ∧
      ∀ᶠ e in 𝓝 (0 : ℝ), 0 < e →
        (∀ i, 0 < e ^ power n i * a e i) ∧
        (∑ i, ((e ^ power n i * a e i : ℝ) : ℂ) * node q ^ i.val) = 0 ∧
        (∑ i, ((D i / (e ^ power n i * a e i) : ℝ) : ℂ) * node q ^ i.val) = 0 := by
  let A : Fin 3 → ℝ := fun j => D (index n (.inl j))
  let B : Fin 3 → ℝ := fun j => D (index n (.inr (.inr j)))
  let C : Fin n → ℝ := fun j => D (index n (.inr (.inl j)))
  let t : Fin n → ℂ := fun j => node q ^ (3 + j.val)
  have hn : node q ≠ 0 := (primitive hq ho).ne_zero (by omega)
  obtain ⟨a, hlim, hpos, hnear⟩ := P14SeparatedPositiveWeights.exists_weights
    (rho q) (rho_positive hq) (node q) (node q ^ (n + 3))
    (pow_ne_zero _ hn) (im_ne_zero hq ho) (relation hq ho)
    A B (fun j => hD _) C t
  refine ⟨fun e i => a e ((index n).symm i), ?_, ?_, ?_⟩
  · exact fun i => hlim ((index n).symm i)
  · exact fun i => hpos ((index n).symm i)
  · filter_upwards [hnear] with e he
    intro hepos
    obtain ⟨hp, hfirst, hsecond⟩ := he hepos
    refine ⟨fun i => hp ((index n).symm i), ?_, ?_⟩
    · rw [← (index n).sum_comp (fun i : Fin (n + 6) =>
        ((e ^ power n i * a e ((index n).symm i) : ℝ) : ℂ) * node q ^ i.val)]
      simpa only [power, Equiv.symm_apply_apply, t, direction_index] using hfirst
    · rw [← (index n).sum_comp (fun i : Fin (n + 6) =>
        ((D i / (e ^ power n i * a e ((index n).symm i)) : ℝ) : ℂ) * node q ^ i.val)]
      have hi : ∀ i : Coord n, intensity A B C i = D (index n i) := by
        intro i
        rcases i with j | (j | j) <;> rfl
      simpa only [power, Equiv.symm_apply_apply, t, direction_index, hi] using hsecond

end P14ConsecutiveReciprocalWeights
end
end

section

/-! The actual positive reciprocal weights have a strict exponent gap
at every split with at least three coordinates on each side, including
the empty middle block in dimension six. -/

namespace P14HighDimensionPowerCut
open P14ConsecutiveReciprocalWeights P14SeparatedPositiveWeights

theorem power_formula (n : ℕ) (i : Fin (n + 6)) :
    power n i = min (i.val - 2) (n + 1) := by
  obtain ⟨j, rfl⟩ := (index n).surjective i
  simp only [power, Equiv.symm_apply_apply]
  rcases j with j | (j | j)
  · simp only [order, Sum.elim_inl, index_left]
    have hj := j.isLt
    omega
  · simp only [order, Sum.elim_inr, Sum.elim_inl, index_middle]
    have hj := j.isLt
    omega
  · simp only [order, Sum.elim_inr, index_right]
    omega

theorem cut_left {n r : ℕ} (hr : 3 ≤ r) (i : Fin (n + 6)) (hi : i.val < r) :
    power n i ≤ r - 3 := by
  rw [power_formula]
  omega

theorem cut_right {n r : ℕ} (hr : 3 ≤ r) (hru : r ≤ n + 3)
    (i : Fin (n + 6)) (hi : r ≤ i.val) : r - 3 < power n i := by
  rw [power_formula]
  omega

end P14HighDimensionPowerCut
end

section

/-! A continuous weighted mixed matrix with a strict exponent gap has
nonzero determinant near zero when its two consecutive blocks do.
The lower-left limiting block is allowed to be nonzero. -/

noncomputable section
namespace P14ContinuousWeightedBlock
open Matrix Filter
open scoped Topology BigOperators

variable {r s : ℕ}

def weighted (A : Matrix (Fin r) (Fin r ⊕ Fin s) ℂ)
    (B : Matrix (Fin s) (Fin r ⊕ Fin s) ℂ)
    (C : (Fin r ⊕ Fin s) → ℝ → ℂ) (w : (Fin r ⊕ Fin s) → ℕ) (e : ℝ) :
    Matrix (Fin r ⊕ Fin s) (Fin r ⊕ Fin s) ℂ :=
  fun i j => Sum.elim (fun a => (A a j * C j e) * (e : ℂ) ^ w j) (fun b => B b j) i

def normalized (A : Matrix (Fin r) (Fin r ⊕ Fin s) ℂ)
    (B : Matrix (Fin s) (Fin r ⊕ Fin s) ℂ)
    (C : (Fin r ⊕ Fin s) → ℝ → ℂ) (w : (Fin r ⊕ Fin s) → ℕ) (W : ℕ) (e : ℝ) :
    Matrix (Fin r ⊕ Fin s) (Fin r ⊕ Fin s) ℂ :=
  fun i j => match i, j with
    | .inl a, .inl u => A a (.inl u) * C (.inl u) e
    | .inl a, .inr v => (A a (.inr v) * C (.inr v) e) * (e : ℂ) ^ (w (.inr v) - W)
    | .inr b, .inl u => B b (.inl u) * (e : ℂ) ^ (W - w (.inl u))
    | .inr b, .inr v => B b (.inr v)

def columnScale (w : (Fin r ⊕ Fin s) → ℕ) (W : ℕ) (e : ℝ) : (Fin r ⊕ Fin s) → ℂ :=
  Sum.elim (fun u => (e : ℂ) ^ (W - w (.inl u))) (fun _ => 1)

def rowScale (W : ℕ) (e : ℝ) : (Fin r ⊕ Fin s) → ℂ :=
  Sum.elim (fun _ => (e : ℂ) ^ W) (fun _ => 1)

private theorem mul_powers_scale (x c : ℂ) (a b u v : ℕ) (h : a + b = u + v) :
    (c * x ^ a) * x ^ b = x ^ u * (c * x ^ v) := by
  rw [mul_assoc, ← pow_add, h, pow_add, mul_left_comm]

theorem scaling (A : Matrix (Fin r) (Fin r ⊕ Fin s) ℂ)
    (B : Matrix (Fin s) (Fin r ⊕ Fin s) ℂ)
    (C : (Fin r ⊕ Fin s) → ℝ → ℂ) (w : (Fin r ⊕ Fin s) → ℕ) (W : ℕ)
    (hl : ∀ j, w (.inl j) ≤ W) (hr : ∀ j, W ≤ w (.inr j)) (e : ℝ) :
    weighted A B C w e * diagonal (columnScale w W e) =
      diagonal (rowScale (r := r) (s := s) W e) * normalized A B C w W e := by
  ext i j
  rw [Matrix.mul_diagonal, Matrix.diagonal_mul]
  rcases i with a | b <;> rcases j with u | v
  · change ((A a (.inl u) * C (.inl u) e) * (e : ℂ) ^ w (.inl u)) *
        (e : ℂ) ^ (W - w (.inl u)) = (e : ℂ) ^ W * (A a (.inl u) * C (.inl u) e)
    simpa only [pow_zero, mul_one] using mul_powers_scale (e : ℂ)
      (A a (.inl u) * C (.inl u) e) (w (.inl u)) (W - w (.inl u)) W 0 (by have h := hl u; omega)
  · change ((A a (.inr v) * C (.inr v) e) * (e : ℂ) ^ w (.inr v)) * 1 =
        (e : ℂ) ^ W * ((A a (.inr v) * C (.inr v) e) * (e : ℂ) ^ (w (.inr v) - W))
    simpa only [pow_zero] using mul_powers_scale (e : ℂ)
      (A a (.inr v) * C (.inr v) e) (w (.inr v)) 0 W (w (.inr v) - W) (by have h := hr v; omega)
  · simp [weighted, normalized, columnScale, rowScale]
  · simp [weighted, normalized, columnScale, rowScale]

theorem normalized_continuous (A : Matrix (Fin r) (Fin r ⊕ Fin s) ℂ)
    (B : Matrix (Fin s) (Fin r ⊕ Fin s) ℂ)
    (C : (Fin r ⊕ Fin s) → ℝ → ℂ) (w : (Fin r ⊕ Fin s) → ℕ) (W : ℕ)
    (hC : ∀ j, ContinuousAt (C j) 0) :
    ContinuousAt (normalized A B C w W) 0 := by
  apply continuousAt_pi.mpr
  intro i
  apply continuousAt_pi.mpr
  intro j
  rcases i with a | b <;> rcases j with u | v
  · exact continuousAt_const.mul (hC _)
  · exact (continuousAt_const.mul (hC _)).mul (by fun_prop)
  · exact continuousAt_const.mul (by fun_prop)
  · exact continuousAt_const

theorem normalized_det_zero (A : Matrix (Fin r) (Fin r ⊕ Fin s) ℂ)
    (B : Matrix (Fin s) (Fin r ⊕ Fin s) ℂ)
    (C : (Fin r ⊕ Fin s) → ℝ → ℂ) (w : (Fin r ⊕ Fin s) → ℕ) (W : ℕ)
    (hr : ∀ j, W < w (.inr j)) :
    (normalized A B C w W 0).det =
      (A.submatrix id Sum.inl).det * (∏ j, C (.inl j) 0) * (B.submatrix id Sum.inr).det := by
  let L : Matrix (Fin s) (Fin r) ℂ := Matrix.of
    (fun (i : Fin s) (j : Fin r) => B i (.inl j) * (0 : ℂ) ^ (W - w (.inl j)))
  have hN : normalized A B C w W 0 =
      fromBlocks ((A.submatrix id Sum.inl) * diagonal (fun j => C (.inl j) 0)) 0
        L (B.submatrix id Sum.inr) := by
    ext i j
    rcases i with a | b <;> rcases j with u | v
    · simp [normalized, Matrix.mul_diagonal, Matrix.submatrix]
    · have hp : w (.inr v) - W ≠ 0 := by have h := hr v; omega
      simp [normalized, hp]
    · simp [normalized, L]
    · rfl
  rw [hN, Matrix.det_fromBlocks_zero₁₂, Matrix.det_mul, Matrix.det_diagonal]

theorem eventually_det_ne_zero (A : Matrix (Fin r) (Fin r ⊕ Fin s) ℂ)
    (B : Matrix (Fin s) (Fin r ⊕ Fin s) ℂ)
    (C : (Fin r ⊕ Fin s) → ℝ → ℂ) (w : (Fin r ⊕ Fin s) → ℕ) (W : ℕ)
    (hl : ∀ j, w (.inl j) ≤ W) (hr : ∀ j, W < w (.inr j))
    (hC : ∀ j, ContinuousAt (C j) 0) (hC0 : ∀ j, C (.inl j) 0 ≠ 0)
    (hA : (A.submatrix id Sum.inl).det ≠ 0) (hB : (B.submatrix id Sum.inr).det ≠ 0) :
    ∀ᶠ e in 𝓝[>] (0 : ℝ), (weighted A B C w e).det ≠ 0 := by
  have hN0 : (normalized A B C w W 0).det ≠ 0 := by
    rw [normalized_det_zero A B C w W hr]
    exact mul_ne_zero (mul_ne_zero hA (Finset.prod_ne_zero_iff.mpr (fun j _ => hC0 j))) hB
  have hd : ContinuousAt (fun e => (normalized A B C w W e).det) 0 :=
    continuous_id.matrix_det.continuousAt.comp (normalized_continuous A B C w W hC)
  have hev : ∀ᶠ e in 𝓝 0, (normalized A B C w W e).det ≠ 0 :=
    hd.eventually (eventually_ne_nhds hN0)
  have hp : ∀ᶠ e in 𝓝[>] (0 : ℝ), 0 < e := self_mem_nhdsWithin
  filter_upwards [hev.filter_mono nhdsWithin_le_nhds, hp] with e he hepos
  have heC : (e : ℂ) ≠ 0 := by exact_mod_cast (ne_of_gt hepos)
  have hrow : (diagonal (rowScale (r := r) (s := s) W e)).det ≠ 0 := by
    rw [Matrix.det_diagonal]
    apply Finset.prod_ne_zero_iff.mpr
    rintro (i | i) _
    · exact pow_ne_zero _ heC
    · exact one_ne_zero
  have hdet := congrArg Matrix.det (scaling A B C w W hl (fun j => (hr j).le) e)
  rw [Matrix.det_mul, Matrix.det_mul] at hdet
  intro hz
  rw [hz, zero_mul] at hdet
  exact mul_ne_zero hrow he hdet.symm

end P14ContinuousWeightedBlock


end
end

section

/-! Physical square-root-weighted complex Fourier rows. The two reciprocal
moments give actual cyclic orthogonality in both layers. Each pure layer
has all full-size minors nonzero; mixed spanning remains a separate task. -/

noncomputable section
open scoped BigOperators
namespace P14ReciprocalFourierRows
open P14HighDimensionPhase P14FourierConsecutiveBlock

def u {q d : ℕ} (H : Fin d → ℝ) (i : Fin q) (j : Fin d) : ℂ :=
  node q ^ (i.val * j.val) * (Real.sqrt (H j) : ℂ)

def v {q d : ℕ} (H : Fin d → ℝ) (P : Fin d → ℂ) (i : Fin q) (j : Fin d) : ℂ :=
  node q ^ (i.val * j.val) * star (P j) / (Real.sqrt (H j) : ℂ)

def pair {d : ℕ} (x y : Fin d → ℂ) : ℂ := ∑ j, star (x j) * y j

theorem u_nonzero {q d : ℕ} (hd : 0 < d) (H : Fin d → ℝ)
    (hH : ∀ j, 0 < H j) (i : Fin q) : u H i ≠ 0 := by
  intro he
  let j : Fin d := ⟨0, hd⟩
  have hj := congrFun he j
  have hn : (Real.sqrt (H j) : ℂ) ≠ 0 :=
    Complex.ofReal_ne_zero.mpr (Real.sqrt_pos.mpr (hH j)).ne'
  exact hn (by simpa [u, j] using hj)

theorem v_nonzero {q d : ℕ} (hd : 0 < d) (H : Fin d → ℝ)
    (hH : ∀ j, 0 < H j) (P : Fin d → ℂ) (hP : ∀ j, P j ≠ 0)
    (i : Fin q) : v H P i ≠ 0 := by
  intro he
  let j : Fin d := ⟨0, hd⟩
  have hj := congrFun he j
  have hn : star (P j) / (Real.sqrt (H j) : ℂ) ≠ 0 :=
    div_ne_zero (star_ne_zero.mpr (hP j))
      (Complex.ofReal_ne_zero.mpr (Real.sqrt_pos.mpr (hH j)).ne')
  exact hn (by simpa [v, j] using hj)

theorem pure_u {q d : ℕ} (hq : 7 ≤ q) (ho : Odd q) (H : Fin d → ℝ)
    (hH : ∀ j, 0 < H j) (I : Fin d → Fin q) (hI : Function.Injective I) :
    LinearIndependent ℂ (fun i => u H (I i)) := by
  have h := consecutiveBlock_det_ne_zero (node q) 1 0 I
    (fun j => (Real.sqrt (H j) : ℂ)) (by omega) (primitive hq ho) one_ne_zero hI
    (fun j => Complex.ofReal_ne_zero.mpr (Real.sqrt_pos.mpr (hH j)).ne')
  have he : (fun i => u H (I i)) =
      consecutiveBlock (node q) 1 0 I (fun j => (Real.sqrt (H j) : ℂ)) := by
    funext i j
    simp [u, consecutiveBlock]
  rw [he]
  exact Matrix.linearIndependent_rows_of_det_ne_zero h

theorem pure_v {q d : ℕ} (hq : 7 ≤ q) (ho : Odd q) (H : Fin d → ℝ)
    (hH : ∀ j, 0 < H j) (P : Fin d → ℂ) (hP : ∀ j, P j ≠ 0)
    (I : Fin d → Fin q) (hI : Function.Injective I) :
    LinearIndependent ℂ (fun i => v H P (I i)) := by
  have h := consecutiveBlock_det_ne_zero (node q) 1 0 I
    (fun j => star (P j) / (Real.sqrt (H j) : ℂ))
    (by omega) (primitive hq ho) one_ne_zero hI
    (fun j => div_ne_zero (star_ne_zero.mpr (hP j))
      (Complex.ofReal_ne_zero.mpr (Real.sqrt_pos.mpr (hH j)).ne'))
  have he : (fun i => v H P (I i)) = consecutiveBlock (node q) 1 0 I
      (fun j => star (P j) / (Real.sqrt (H j) : ℂ)) := by
    funext i j
    simp [v, consecutiveBlock, mul_div_assoc]
  rw [he]
  exact Matrix.linearIndependent_rows_of_det_ne_zero h

theorem cross {q d : ℕ} (H : Fin d → ℝ) (hH : ∀ j, 0 < H j)
    (P : Fin d → ℂ) (a b : Fin q) :
    pair (u H a) (v H P b) = ∑ j,
      (star (node q ^ (a.val * j.val)) * node q ^ (b.val * j.val)) * star (P j) := by
  apply Finset.sum_congr rfl
  intro j _
  simpa only [u, v, one_mul, star_one] using
    P14ComplexSqrtPairEntries.cross_entry 1 (node q ^ (a.val * j.val))
      (node q ^ (b.val * j.val)) (P j) (H j) (hH j)

theorem next_phase {q : ℕ} [NeZero q] (hq : 7 ≤ q) (ho : Odd q) (i : Fin q)
    (k : ℕ) :
    star (node q ^ (i.val * k)) * node q ^ ((i + 1).val * k) = node q ^ k := by
  have hnext : node q ^ (i + 1).val = node q ^ i.val * node q := by
    rw [Fin.val_add, Fin.val_one', Nat.mod_eq_of_lt (by omega : 1 < q)]
    exact (pow_eq_pow_mod (i.val + 1) (primitive hq ho).pow_eq_one).symm.trans
      (by rw [pow_add, pow_one])
  have hu : star (node q ^ i.val) * node q ^ i.val = 1 := by
    simpa only [node, pow_mul] using
      P14FiveRootGrid.root_pow_unit (q := q) (by omega) (P14FiveRootGrid.half q * i.val)
  rw [pow_mul, pow_mul, star_pow, ← mul_pow, hnext, ← mul_assoc, hu, one_mul]

theorem u_cycle {q d : ℕ} [NeZero q] (hq : 7 ≤ q) (ho : Odd q)
    (H : Fin d → ℝ) (hH : ∀ j, 0 < H j)
    (hm : (∑ j, (H j : ℂ) * node q ^ j.val) = 0) (i : Fin q) :
    pair (u H i) (u H (i + 1)) = 0 := by
  calc
    _ = ∑ j, node q ^ j.val * (H j : ℂ) := by
      apply Finset.sum_congr rfl
      intro j _
      simpa only [u, one_mul, star_one, next_phase hq ho] using
        P14ComplexSqrtPairEntries.a_entry 1 (node q ^ (i.val * j.val))
          (node q ^ ((i + 1).val * j.val)) (H j) (hH j).le
    _ = 0 := by simpa only [mul_comm] using hm

theorem v_cycle {q d : ℕ} [NeZero q] (hq : 7 ≤ q) (ho : Odd q)
    (H : Fin d → ℝ) (hH : ∀ j, 0 < H j) (P : Fin d → ℂ)
    (hm : (∑ j, ((Complex.normSq (P j) / H j : ℝ) : ℂ) * node q ^ j.val) = 0)
    (i : Fin q) : pair (v H P i) (v H P (i + 1)) = 0 := by
  calc
    _ = ∑ j, node q ^ j.val * (Complex.normSq (P j) : ℂ) / (H j : ℂ) := by
      apply Finset.sum_congr rfl
      intro j _
      simpa only [v, one_mul, star_one, next_phase hq ho] using
        P14ComplexSqrtPairEntries.b_entry 1 (node q ^ (i.val * j.val))
          (node q ^ ((i + 1).val * j.val)) (P j) (H j) (hH j).le
    _ = 0 := by simpa only [Complex.ofReal_div, mul_div_assoc, mul_comm] using hm

end P14ReciprocalFourierRows
end
end

section

/-! Mixed determinants of the actual higher-dimensional Fourier rows.
For every split with at least three rows in each layer, the strict
exponent gap produces a block-triangular limit with invertible Fourier
diagonal blocks. The physical v rows retain the conjugated P convention. -/

noncomputable section
open Matrix Filter
open scoped Topology BigOperators
namespace P14HighDimensionMiddleMinors
open P14ConsecutiveReciprocalWeights P14HighDimensionPhase
open P14HighDimensionPowerCut P14ReciprocalFourierRows

def coordinate {n r s : ℕ} (h : r + s = n + 6) :
    (Fin r ⊕ Fin s) ≃ Fin (n + 6) :=
  finSumFinEquiv.trans (finCongr h)

@[simp] theorem coordinate_left_val {n r s : ℕ} (h : r + s = n + 6) (j : Fin r) :
    (coordinate h (.inl j)).val = j.val := rfl

@[simp] theorem coordinate_right_val {n r s : ℕ} (h : r + s = n + 6) (j : Fin s) :
    (coordinate h (.inr j)).val = r + j.val := rfl

def weight (n : ℕ) (a : ℝ → Fin (n + 6) → ℝ) (e : ℝ) (j : Fin (n + 6)) : ℝ :=
  e ^ power n j * a e j

def transformed {n r s q : ℕ} (h : r + s = n + 6)
    (H : Fin (n + 6) → ℝ) (P : Fin (n + 6) → ℂ)
    (U : Fin r → Fin q) (V : Fin s → Fin q) :
    Matrix (Fin r ⊕ Fin s) (Fin r ⊕ Fin s) ℂ :=
  fun i j => Sum.elim
    (fun b => node q ^ ((U b).val * (coordinate h j).val) *
      (H (coordinate h j) : ℂ) / star (P (coordinate h j)))
    (fun b => node q ^ ((V b).val * (coordinate h j).val)) i

def mixed {n r s q : ℕ} (h : r + s = n + 6)
    (H : Fin (n + 6) → ℝ) (P : Fin (n + 6) → ℂ)
    (U : Fin r → Fin q) (V : Fin s → Fin q) :
    Matrix (Fin r ⊕ Fin s) (Fin r ⊕ Fin s) ℂ :=
  fun i j => Sum.elim (fun b => u H (U b) (coordinate h j))
    (fun b => v H P (V b) (coordinate h j)) i

theorem eventually_transformed {n r s q : ℕ} (h : r + s = n + 6)
    (hr : 3 ≤ r) (hs : 3 ≤ s) (hq : 7 ≤ q) (ho : Odd q)
    (a : ℝ → Fin (n + 6) → ℝ)
    (ha : ∀ j, ContinuousAt (fun e => a e j) 0) (ha0 : ∀ j, a 0 j ≠ 0)
    (P : Fin (n + 6) → ℂ) (hP : ∀ j, P j ≠ 0)
    (U : Fin r → Fin q) (V : Fin s → Fin q)
    (hU : Function.Injective U) (hV : Function.Injective V) :
    ∀ᶠ e in 𝓝[>] (0 : ℝ), (transformed h (weight n a e) P U V).det ≠ 0 := by
  let A : Matrix (Fin r) (Fin r ⊕ Fin s) ℂ :=
    fun i j => node q ^ ((U i).val * (coordinate h j).val)
  let B : Matrix (Fin s) (Fin r ⊕ Fin s) ℂ :=
    fun i j => node q ^ ((V i).val * (coordinate h j).val)
  let C : (Fin r ⊕ Fin s) → ℝ → ℂ :=
    fun j e => (a e (coordinate h j) : ℂ) / star (P (coordinate h j))
  let w : (Fin r ⊕ Fin s) → ℕ := fun j => power n (coordinate h j)
  have hl : ∀ j, w (.inl j) ≤ r - 3 := by
    intro j
    exact cut_left hr _ (by simpa using j.isLt)
  have hu : ∀ j, r - 3 < w (.inr j) := by
    intro j
    exact cut_right hr (by omega) _ (by simp)
  have hc : ∀ j, ContinuousAt (C j) 0 := by
    intro j
    exact (Complex.continuous_ofReal.continuousAt.comp (ha _)).div
      continuousAt_const (star_ne_zero.mpr (hP _))
  have hc0 : ∀ j, C (.inl j) 0 ≠ 0 := by
    intro j
    exact div_ne_zero (Complex.ofReal_ne_zero.mpr (ha0 _)) (star_ne_zero.mpr (hP _))
  have hA : (A.submatrix id Sum.inl).det ≠ 0 := by
    have he : A.submatrix id Sum.inl =
        P14FourierConsecutiveBlock.consecutiveBlock (node q) 1 0 U (fun _ => 1) := by
      ext i j
      simp [A, Matrix.submatrix, P14FourierConsecutiveBlock.consecutiveBlock]
    rw [he]
    exact P14FourierConsecutiveBlock.consecutiveBlock_det_ne_zero (node q) 1 0 U
      (fun _ => 1) (by omega) (primitive hq ho) one_ne_zero hU (fun _ => one_ne_zero)
  have hB : (B.submatrix id Sum.inr).det ≠ 0 := by
    have he : B.submatrix id Sum.inr =
        P14FourierConsecutiveBlock.consecutiveBlock (node q) 1 r V (fun _ => 1) := by
      ext i j
      simp [B, Matrix.submatrix, P14FourierConsecutiveBlock.consecutiveBlock]
    rw [he]
    exact P14FourierConsecutiveBlock.consecutiveBlock_det_ne_zero (node q) 1 r V
      (fun _ => 1) (by omega) (primitive hq ho) one_ne_zero hV (fun _ => one_ne_zero)
  have hd := P14ContinuousWeightedBlock.eventually_det_ne_zero A B C w (r - 3)
    hl hu hc hc0 hA hB
  filter_upwards [hd] with e he
  have hm : P14ContinuousWeightedBlock.weighted A B C w e =
      transformed h (weight n a e) P U V := by
    ext i j
    rcases i with b | b
    · change (node q ^ ((U b).val * (coordinate h j).val) *
          ((a e (coordinate h j) : ℂ) / star (P (coordinate h j)))) *
          (e : ℂ) ^ power n (coordinate h j) =
        node q ^ ((U b).val * (coordinate h j).val) *
          (weight n a e (coordinate h j) : ℂ) / star (P (coordinate h j))
      simp only [weight, Complex.ofReal_mul, Complex.ofReal_pow]
      ring
    · rfl
  rwa [hm] at he

theorem scaling {n r s q : ℕ} (h : r + s = n + 6)
    (H : Fin (n + 6) → ℝ) (hH : ∀ j, 0 < H j)
    (P : Fin (n + 6) → ℂ) (hP : ∀ j, P j ≠ 0)
    (U : Fin r → Fin q) (V : Fin s → Fin q) :
    mixed h H P U V * Matrix.diagonal (fun j =>
      (Real.sqrt (H (coordinate h j)) : ℂ) / star (P (coordinate h j))) =
        transformed h H P U V := by
  ext i j
  rw [Matrix.mul_diagonal]
  have hs : (Real.sqrt (H (coordinate h j)) : ℂ) ≠ 0 :=
    Complex.ofReal_ne_zero.mpr (Real.sqrt_pos.mpr (hH _)).ne'
  have hp : star (P (coordinate h j)) ≠ 0 := star_ne_zero.mpr (hP _)
  have hsq : (Real.sqrt (H (coordinate h j)) : ℂ) ^ 2 =
      (H (coordinate h j) : ℂ) := by exact_mod_cast Real.sq_sqrt (hH _).le
  rcases i with b | b
  · change (node q ^ ((U b).val * (coordinate h j).val) *
        (Real.sqrt (H (coordinate h j)) : ℂ)) *
        ((Real.sqrt (H (coordinate h j)) : ℂ) / star (P (coordinate h j))) = _
    change _ = node q ^ ((U b).val * (coordinate h j).val) *
      (H (coordinate h j) : ℂ) / star (P (coordinate h j))
    rw [← hsq]
    ring
  · change (node q ^ ((V b).val * (coordinate h j).val) *
        star (P (coordinate h j)) / (Real.sqrt (H (coordinate h j)) : ℂ)) *
        ((Real.sqrt (H (coordinate h j)) : ℂ) / star (P (coordinate h j))) =
      node q ^ ((V b).val * (coordinate h j).val)
    field_simp

theorem eventually_mixed {n r s q : ℕ} (h : r + s = n + 6)
    (hr : 3 ≤ r) (hs : 3 ≤ s) (hq : 7 ≤ q) (ho : Odd q)
    (a : ℝ → Fin (n + 6) → ℝ)
    (ha : ∀ j, ContinuousAt (fun e => a e j) 0) (ha0 : ∀ j, a 0 j ≠ 0)
    (hpos : ∀ᶠ e in 𝓝[>] (0 : ℝ), ∀ j, 0 < weight n a e j)
    (P : Fin (n + 6) → ℂ) (hP : ∀ j, P j ≠ 0)
    (U : Fin r → Fin q) (V : Fin s → Fin q)
    (hU : Function.Injective U) (hV : Function.Injective V) :
    ∀ᶠ e in 𝓝[>] (0 : ℝ), (mixed h (weight n a e) P U V).det ≠ 0 := by
  have hd := eventually_transformed h hr hs hq ho a ha ha0 P hP U V hU hV
  filter_upwards [hd, hpos] with e he hp
  intro hz
  apply he
  rw [← scaling h (weight n a e) hp P hP U V, Matrix.det_mul, hz, zero_mul]

end P14HighDimensionMiddleMinors
end
end

section

/-! One positive weight vector satisfies both actual complex moment
equations and every middle-count mixed determinant simultaneously.
Singleton-side mixed minors remain separate obligations. -/

noncomputable section
open Filter
open scoped Topology BigOperators
namespace P14HighDimensionMiddleFamily
open P14HighDimensionPhase P14ConsecutiveReciprocalWeights
open P14HighDimensionMiddleMinors P14ReciprocalFourierRows

def MiddleMinors {n q : ℕ} (P : Fin (n + 6) → ℂ) (H : Fin (n + 6) → ℝ) : Prop :=
  ∀ (r : Fin (n + 7)) (U : Fin r.val → Fin q)
    (V : Fin (n + 6 - r.val) → Fin q),
    3 ≤ r.val → r.val ≤ n + 3 →
    Function.Injective U → Function.Injective V →
      (mixed (by have hr := r.isLt; omega) H P U V).det ≠ 0

theorem eventually_all {n q : ℕ} (hq : 7 ≤ q) (ho : Odd q)
    (a : ℝ → Fin (n + 6) → ℝ)
    (ha : ∀ j, ContinuousAt (fun e => a e j) 0) (ha0 : ∀ j, a 0 j ≠ 0)
    (hpos : ∀ᶠ e in 𝓝[>] (0 : ℝ), ∀ j, 0 < weight n a e j)
    (P : Fin (n + 6) → ℂ) (hP : ∀ j, P j ≠ 0) :
    ∀ᶠ e in 𝓝[>] (0 : ℝ), MiddleMinors (q := q) P (weight n a e) := by
  classical
  unfold MiddleMinors
  apply Filter.eventually_all.mpr
  intro r
  apply Filter.eventually_all.mpr
  intro U
  apply Filter.eventually_all.mpr
  intro V
  by_cases hh : 3 ≤ r.val ∧ r.val ≤ n + 3 ∧
      Function.Injective U ∧ Function.Injective V
  · have hd := eventually_mixed
      (n := n) (r := r.val) (s := n + 6 - r.val) (by have hr := r.isLt; omega)
      hh.1 (by omega) hq ho a ha ha0 hpos P hP U V hh.2.2.1 hh.2.2.2
    exact hd.mono (fun _ h _ _ _ _ => h)
  · exact Filter.Eventually.of_forall
      (fun _ h1 h2 h3 h4 => False.elim (hh ⟨h1, h2, h3, h4⟩))

theorem exists_balanced_middle {n q : ℕ} (hq : 7 ≤ q) (ho : Odd q)
    (P : Fin (n + 6) → ℂ) (hP : ∀ j, P j ≠ 0) :
    ∃ H : Fin (n + 6) → ℝ, (∀ j, 0 < H j) ∧
      (∑ j, (H j : ℂ) * node q ^ j.val) = 0 ∧
      (∑ j, ((Complex.normSq (P j) / H j : ℝ) : ℂ) * node q ^ j.val) = 0 ∧
      MiddleMinors (q := q) P H := by
  obtain ⟨a, hlim, hlead, hnear⟩ := exists_weights hq ho
    (fun j => Complex.normSq (P j)) (fun j => Complex.normSq_pos.mpr (hP j))
  have ha : ∀ j, ContinuousAt (fun e => a e j) 0 :=
    fun j => continuousAt_of_tendsto_nhds (hlim j)
  have ha0 : ∀ j, a 0 j ≠ 0 := by
    intro j
    rw [eq_of_tendsto_nhds (hlim j)]
    exact (hlead j).ne'
  have hp : ∀ᶠ e in 𝓝[>] (0 : ℝ), 0 < e := self_mem_nhdsWithin
  have hb := (hnear.filter_mono nhdsWithin_le_nhds).and hp
  have hb' : ∀ᶠ e in 𝓝[>] (0 : ℝ),
      (∀ j, 0 < weight n a e j) ∧
      (∑ j, (weight n a e j : ℂ) * node q ^ j.val) = 0 ∧
      (∑ j, ((Complex.normSq (P j) / weight n a e j : ℝ) : ℂ) * node q ^ j.val) = 0 :=
    hb.mono (fun _ h => h.1 h.2)
  have hm := eventually_all hq ho a ha ha0 (hb'.mono (fun _ h => h.1)) P hP
  obtain ⟨e, he, hme⟩ := (hb'.and hm).exists
  exact ⟨weight n a e, he.1, he.2.1, he.2.2, hme⟩

theorem exists_family {n q : ℕ} [NeZero q] (hq : 7 ≤ q) (ho : Odd q)
    (P : Fin (n + 6) → ℂ) (hP : ∀ j, P j ≠ 0) :
    ∃ H : Fin (n + 6) → ℝ, (∀ j, 0 < H j) ∧
      MiddleMinors (q := q) P H ∧
      (∀ i : Fin q, u H i ≠ 0 ∧ v H P i ≠ 0) ∧
      (∀ I : Fin (n + 6) → Fin q, Function.Injective I →
        LinearIndependent ℂ (fun i => u H (I i)) ∧
        LinearIndependent ℂ (fun i => v H P (I i))) ∧
      (∀ i : Fin q, pair (u H i) (u H (i + 1)) = 0 ∧
        pair (v H P i) (v H P (i + 1)) = 0) := by
  obtain ⟨H, hpos, hfirst, hsecond, hmiddle⟩ := exists_balanced_middle hq ho P hP
  refine ⟨H, hpos, hmiddle, ?_, ?_, ?_⟩
  · exact fun i => ⟨u_nonzero (by omega) H hpos i, v_nonzero (by omega) H hpos P hP i⟩
  · exact fun I hI => ⟨pure_u hq ho H hpos I hI, pure_v hq ho H hpos P hP I hI⟩
  · exact fun i => ⟨u_cycle hq ho H hpos hfirst i, v_cycle hq ho H hpos P hsecond i⟩

end P14HighDimensionMiddleFamily
end
end

section

/-! Finite denominator and numerator polynomials for the balanced Cauchy
kernel argument. Column parameters are separately injective; no disjointness
from a future row list is imposed. All clearing hypotheses are explicit. -/

noncomputable section
namespace P14CauchyKernelPolynomial

open Polynomial
open scoped BigOperators

variable {K : Type*} [Field K] {t : ℕ}

def sigma (v : Fin t → K) : K := ∑ j, v j

def Q (c : K) (y : Fin t → K) : K[X] :=
  ∏ j, (X - C (c * y j))

def Qomit (c : K) (y : Fin t → K) (j : Fin t) : K[X] :=
  ∏ l ∈ Finset.univ.erase j, (X - C (c * y l))

def N (c : K) (y v : Fin t → K) : K[X] :=
  ∑ j, C (y j * v j) * Qomit c y j

theorem Q_monic (c : K) (y : Fin t → K) : (Q c y).Monic :=
  monic_prod_of_monic _ _ (fun j _ => monic_X_sub_C (c * y j))

theorem Q_natDegree (c : K) (y : Fin t → K) : (Q c y).natDegree = t := by
  unfold Q
  rw [natDegree_prod_of_monic _ _ (fun j _ => monic_X_sub_C (c * y j))]
  simp only [natDegree_X_sub_C, Finset.sum_const, Finset.card_univ,
    Fintype.card_fin, smul_eq_mul, mul_one]

theorem Q_coeff_top (c : K) (y : Fin t → K) : (Q c y).coeff t = 1 := by
  have h := (Q_monic c y).coeff_natDegree
  simpa only [Q_natDegree] using h

theorem Qomit_natDegree (c : K) (y : Fin t → K) (j : Fin t) :
    (Qomit c y j).natDegree = t - 1 := by
  unfold Qomit
  rw [natDegree_prod_of_monic _ _ (fun l _ => monic_X_sub_C (c * y l))]
  simp only [natDegree_X_sub_C, Finset.sum_const,
    Finset.card_erase_of_mem (Finset.mem_univ j), Finset.card_univ,
    Fintype.card_fin, smul_eq_mul, mul_one]

theorem N_natDegree_le (c : K) (y v : Fin t → K) :
    (N c y v).natDegree ≤ t - 1 := by
  unfold N
  apply natDegree_sum_le_of_forall_le
  intro j _
  exact (natDegree_C_mul_le _ _).trans (le_of_eq (Qomit_natDegree c y j))

theorem N_coeff_eq_zero (c : K) (y v : Fin t → K) (ht : 1 ≤ t)
    {m : ℕ} (hm : t ≤ m) : (N c y v).coeff m = 0 := by
  apply coeff_eq_zero_of_natDegree_lt
  have hN := N_natDegree_le c y v
  omega

theorem factor_mul_Qomit (c : K) (y : Fin t → K) (j : Fin t) :
    (X - C (c * y j)) * Qomit c y j = Q c y := by
  unfold Qomit Q
  exact Finset.mul_prod_erase (Finset.univ : Finset (Fin t))
    (fun l : Fin t => (X - C (c * y l) : K[X])) (Finset.mem_univ j)

theorem eval_factor_mul_Qomit (c : K) (y : Fin t → K) (x : K) (j : Fin t) :
    (x - c * y j) * (Qomit c y j).eval x = (Q c y).eval x := by
  have h := congrArg (Polynomial.eval x) (factor_mul_Qomit c y j)
  simpa only [eval_mul, eval_sub, eval_X, eval_C] using h

theorem eval_Q (c : K) (y : Fin t → K) (x : K) :
    (Q c y).eval x = ∏ j, (x - c * y j) := by
  simp only [Q, eval_prod, eval_sub, eval_X, eval_C]

theorem eval_Q_ne_zero (c : K) (y : Fin t → K) (x : K)
    (hd : ∀ j, x - c * y j ≠ 0) : (Q c y).eval x ≠ 0 := by
  rw [eval_Q]
  exact Finset.prod_ne_zero_iff.mpr (fun j _ => hd j)

theorem eval_Q_pole (c : K) (y : Fin t → K) (j : Fin t) :
    (Q c y).eval (c * y j) = 0 := by
  rw [eval_Q]
  exact Finset.prod_eq_zero (Finset.mem_univ j) (sub_self _)

theorem eval_Q_zero (c : K) (y : Fin t → K) :
    (Q c y).eval 0 = (-c) ^ t * ∏ j, y j := by
  rw [eval_Q]
  simp only [zero_sub, ← neg_mul, Finset.prod_mul_distrib]
  simp

theorem eval_Qomit_zero (c : K) (y : Fin t → K) (j : Fin t) :
    (Qomit c y j).eval 0 = (-c) ^ (t - 1) * ∏ l ∈ Finset.univ.erase j, y l := by
  simp only [Qomit, eval_prod, eval_sub, eval_X, eval_C, zero_sub,
    ← neg_mul, Finset.prod_mul_distrib]
  simp [Finset.card_erase_of_mem]

theorem eval_N_zero (c : K) (y v : Fin t → K) :
    (N c y v).eval 0 = (-c) ^ (t - 1) * (∏ j, y j) * sigma v := by
  rw [N, eval_finsetSum]
  simp only [eval_C_mul]
  calc
    _ = ∑ j, ((-c) ^ (t - 1) * (∏ l, y l)) * v j := by
      apply Finset.sum_congr rfl
      intro j _
      rw [eval_Qomit_zero]
      have hy : y j * (∏ l ∈ Finset.univ.erase j, y l) = ∏ l, y l :=
        Finset.mul_prod_erase _ _ (Finset.mem_univ j)
      calc
        _ = (-c) ^ (t - 1) * (y j * (∏ l ∈ Finset.univ.erase j, y l)) * v j := by ring
        _ = _ := by rw [hy]
    _ = _ := by rw [← Finset.mul_sum]; rfl

theorem eval_N_pole (c : K) (y v : Fin t → K) (j : Fin t) :
    (N c y v).eval (c * y j) =
      y j * v j * ∏ l ∈ Finset.univ.erase j, (c * y j - c * y l) := by
  rw [N, eval_finsetSum]
  simp only [eval_C_mul]
  rw [Finset.sum_eq_single j]
  · simp only [Qomit, eval_prod, eval_sub, eval_X, eval_C]
  · intro l _ hlj
    have hj : j ∈ (Finset.univ : Finset (Fin t)).erase l :=
      Finset.mem_erase.mpr ⟨Ne.symm hlj, Finset.mem_univ j⟩
    have hz : (Qomit c y l).eval (c * y j) = 0 := by
      simp only [Qomit, eval_prod, eval_sub, eval_X, eval_C]
      exact Finset.prod_eq_zero hj (sub_self _)
    rw [hz, mul_zero]
  · intro h
    exact (h (Finset.mem_univ j)).elim

theorem N_eq_zero_imp (c : K) (y v : Fin t → K) (hc : c ≠ 0)
    (hy : ∀ j, y j ≠ 0) (hinj : Function.Injective y)
    (hN : N c y v = 0) : ∀ j, v j = 0 := by
  intro j
  have hp : (∏ l ∈ Finset.univ.erase j, (c * y j - c * y l)) ≠ 0 := by
    apply Finset.prod_ne_zero_iff.mpr
    intro l hl
    apply sub_ne_zero.mpr
    intro h
    have hjl : j = l := hinj (mul_left_cancel₀ hc h)
    exact (Finset.mem_erase.mp hl).1 hjl.symm
  have hz : y j * v j * (∏ l ∈ Finset.univ.erase j, (c * y j - c * y l)) = 0 := by
    rw [← eval_N_pole, hN, eval_zero]
  exact (mul_eq_zero.mp ((mul_eq_zero.mp hz).resolve_right hp)).resolve_left (hy j)

theorem eval_N_eq_mul_sum (c : K) (y v : Fin t → K) (x : K)
    (hd : ∀ j, x - c * y j ≠ 0) :
    (N c y v).eval x = (Q c y).eval x * ∑ j, (y j * v j) / (x - c * y j) := by
  rw [N, eval_finsetSum, Finset.mul_sum]
  simp only [eval_C_mul]
  apply Finset.sum_congr rfl
  intro j _
  rw [← eval_factor_mul_Qomit c y x j, ← mul_div_assoc]
  apply (eq_div_iff (hd j)).2
  ring

theorem row_decomposition (c : K) (y v : Fin t → K) (x : K)
    (hd : ∀ j, x - c * y j ≠ 0) :
    (∑ j, ((y j - x) / (x - c * y j)) * v j) =
      (1 - c) * (∑ j, (y j * v j) / (x - c * y j)) - sigma v := by
  rw [Finset.mul_sum, sigma, ← Finset.sum_sub_distrib]
  apply Finset.sum_congr rfl
  intro j _
  rw [div_mul_eq_mul_div, ← mul_div_assoc, div_sub' (hd j)]
  congr 1
  ring

theorem row_clear (c : K) (y v : Fin t → K) (x : K)
    (hd : ∀ j, x - c * y j ≠ 0) :
    (Q c y).eval x * (∑ j, ((y j - x) / (x - c * y j)) * v j) =
      (1 - c) * (N c y v).eval x - sigma v * (Q c y).eval x := by
  rw [row_decomposition c y v x hd, eval_N_eq_mul_sum c y v x hd]
  ring

theorem row_zero_imp (c : K) (y v : Fin t → K) (x : K)
    (hd : ∀ j, x - c * y j ≠ 0)
    (hrow : (∑ j, ((y j - x) / (x - c * y j)) * v j) = 0) :
    (C (1 - c) * N c y v - C (sigma v) * Q c y).eval x = 0 := by
  rw [eval_sub, eval_C_mul, eval_C_mul, ← row_clear c y v x hd, hrow, mul_zero]

end P14CauchyKernelPolynomial

end
end

section

/-! A reciprocal sum with distinct nonzero poles and one nonzero residue
has only finitely many zeros. The conjugated-parameter variant is proved
separately, so anti-rational endpoint coefficients are not treated as
holomorphic functions of the original parameter. -/

noncomputable section
open scoped BigOperators
namespace P14FiniteReciprocalAvoidance
open P14CauchyKernelPolynomial

theorem finite_zeros {t : ℕ} (z c : Fin t → ℂ)
    (hz : Function.Injective z) (hz0 : ∀ j, z j ≠ 0)
    (hc : ∃ j, c j ≠ 0) :
    Set.Finite {x : ℂ | (∑ j, c j / (z j - x)) = 0} := by
  classical
  let v : Fin t → ℂ := fun j => c j / z j
  have hv : ∃ j, v j ≠ 0 := by
    obtain ⟨j, hj⟩ := hc
    exact ⟨j, div_ne_zero hj (hz0 j)⟩
  have hN : N 1 z v ≠ 0 := by
    intro hzero
    have hall := N_eq_zero_imp 1 z v one_ne_zero hz0 hz hzero
    obtain ⟨j, hj⟩ := hv
    exact hj (hall j)
  have hf : Set.Finite {x : ℂ | (N 1 z v).eval x = 0} :=
    Polynomial.finite_setOfPred_isRoot hN
  apply (hf.union (Set.finite_range z)).subset
  intro x hx
  change (∑ j, c j / (z j - x)) = 0 at hx
  by_cases hp : x ∈ Set.range z
  · exact Or.inr hp
  · left
    have hd : ∀ j, x - 1 * z j ≠ 0 := by
      intro j
      simp only [one_mul, sub_ne_zero]
      exact fun he => hp ⟨j, he.symm⟩
    change (N 1 z v).eval x = 0
    rw [eval_N_eq_mul_sum 1 z v x hd]
    have hsum : (∑ j, z j * v j / (x - 1 * z j)) = 0 := by
      have hterm : ∀ j, z j * v j / (x - 1 * z j) = -(c j / (z j - x)) := by
        intro j
        have hnum : z j * v j = c j := by
          dsimp [v]
          field_simp [hz0 j]
        rw [hnum, one_mul, ← neg_sub (z j) x, div_neg]
      simpa only [hterm, Finset.sum_neg_distrib, hx, neg_zero]
    rw [hsum, mul_zero]

theorem finite_star_zeros {t : ℕ} (z c : Fin t → ℂ)
    (hz : Function.Injective z) (hz0 : ∀ j, z j ≠ 0)
    (hc : ∃ j, c j ≠ 0) :
    Set.Finite {x : ℂ | (∑ j, c j / star (z j - x)) = 0} := by
  have hz' : Function.Injective (fun j => star (z j)) := star_injective.comp hz
  have hf := finite_zeros (fun j => star (z j)) c hz'
    (fun j => star_ne_zero.mpr (hz0 j)) hc
  have hp := hf.preimage (star_injective.injOn)
  simpa only [Set.preimage_ofPred_eq, star_sub] using hp

theorem exists_common {T S : Type*} [Fintype T] [Fintype S] {t u : ℕ}
    (z : Fin t → ℂ) (w : Fin u → ℂ)
    (hz : Function.Injective z) (hw : Function.Injective w)
    (hz0 : ∀ j, z j ≠ 0) (hw0 : ∀ j, w j ≠ 0)
    (c : T → Fin t → ℂ) (b : S → Fin u → ℂ)
    (hc : ∀ a, ∃ j, c a j ≠ 0) (hb : ∀ a, ∃ j, b a j ≠ 0)
    (E : Set ℂ) (hE : E.Finite) :
    ∃ x : ℂ, x ∉ E ∧
      (∀ a, (∑ j, c a j / (z j - x)) ≠ 0) ∧
      (∀ a, (∑ j, b a j / star (w j - x)) ≠ 0) := by
  classical
  let : Infinite ℂ := Infinite.of_injective (fun n : ℕ => (n : ℂ)) Nat.cast_injective
  let A : Set ℂ := ⋃ a, {x | (∑ j, c a j / (z j - x)) = 0}
  let B : Set ℂ := ⋃ a, {x | (∑ j, b a j / star (w j - x)) = 0}
  have hA : A.Finite := Set.finite_iUnion (fun a => finite_zeros z (c a) hz hz0 (hc a))
  have hB : B.Finite := Set.finite_iUnion (fun a => finite_star_zeros w (b a) hw hw0 (hb a))
  obtain ⟨x, _, hx⟩ := Set.infinite_univ.exists_notMem_finite ((hE.union hA).union hB)
  refine ⟨x, ?_, ?_, ?_⟩
  · exact fun he => hx (Or.inl (Or.inl he))
  · intro a he
    exact hx (Or.inl (Or.inr (Set.mem_iUnion.mpr ⟨a, he⟩)))
  · intro a he
    exact hx (Or.inr (Set.mem_iUnion.mpr ⟨a, he⟩))

end P14FiniteReciprocalAvoidance
end
end

section

/-! The two endpoint cofactors in a singleton Fourier row expansion are
nonzero. Consequently the rational and anti-rational coefficient sums
with three-coordinate endpoint weights each have only finitely many zeros.
Identification with the actual small-epsilon determinant limits is separate. -/

noncomputable section
open Matrix
open scoped BigOperators
namespace P14FourierEndpointCofactors

def cofactor {d q : ℕ} (z : ℂ) (a : Fin q) (V : Fin d → Fin q)
    (j : Fin (d + 1)) : ℂ :=
  (-1 : ℂ) ^ j.val * z ^ (a.val * j.val) *
    Matrix.det (fun i k : Fin d => z ^ ((V i).val * (j.succAbove k).val))

theorem first_ne_zero {d q : ℕ} (z : ℂ) (hq : q ≠ 0) (hz : IsPrimitiveRoot z q)
    (a : Fin q) (V : Fin d → Fin q) (hV : Function.Injective V) :
    cofactor z a V 0 ≠ 0 := by
  have hd := P14FourierConsecutiveBlock.consecutiveBlock_det_ne_zero z 1 1 V
    (fun _ => 1) hq hz one_ne_zero hV (fun _ => one_ne_zero)
  have he : P14FourierConsecutiveBlock.consecutiveBlock z 1 1 V (fun _ => 1) =
      (fun i k : Fin d => z ^ ((V i).val * (k.val + 1))) := by
    ext i k
    simp [P14FourierConsecutiveBlock.consecutiveBlock, Nat.add_comm]
  rw [he] at hd
  simpa [cofactor] using hd

theorem last_ne_zero {d q : ℕ} (z : ℂ) (hq : q ≠ 0) (hz : IsPrimitiveRoot z q)
    (a : Fin q) (V : Fin d → Fin q) (hV : Function.Injective V) :
    cofactor z a V (Fin.last d) ≠ 0 := by
  have hd := P14FourierConsecutiveBlock.consecutiveBlock_det_ne_zero z 1 0 V
    (fun _ => 1) hq hz one_ne_zero hV (fun _ => one_ne_zero)
  have hminor : Matrix.det (fun i k : Fin d => z ^ ((V i).val * k.val)) ≠ 0 := by
    have he : P14FourierConsecutiveBlock.consecutiveBlock z 1 0 V (fun _ => 1) =
        (fun i k : Fin d => z ^ ((V i).val * k.val)) := by
      ext i k
      simp [P14FourierConsecutiveBlock.consecutiveBlock]
    rwa [he] at hd
  simp only [cofactor, Fin.val_last, Fin.succAbove_last, Fin.val_castSucc]
  exact mul_ne_zero (mul_ne_zero (pow_ne_zero _ (neg_ne_zero.mpr one_ne_zero))
    (pow_ne_zero _ (hz.ne_zero hq))) hminor

def lowerWeight {d : ℕ} (rho : ℂ) (j : Fin (d + 1)) : ℂ :=
  if j.val < 3 then if j.val = 1 then rho else 1 else 0

def upperWeight {d : ℕ} (rho : ℂ) (j : Fin (d + 1)) : ℂ :=
  if d - 2 ≤ j.val then if j.val + 1 = d then rho else 1 else 0

def lowerCoefficient {d q : ℕ} (z rho : ℂ) (base : Fin (d + 1) → ℂ)
    (a : Fin q) (V : Fin d → Fin q) (eta : ℂ) : ℂ :=
  ∑ j, cofactor z a V j * lowerWeight rho j / (base j * (z ^ j.val - eta))

def upperCoefficient {d q : ℕ} (z rho : ℂ) (base : Fin (d + 1) → ℂ)
    (a : Fin q) (V : Fin d → Fin q) (eta : ℂ) : ℂ :=
  ∑ j, cofactor z a V j * upperWeight rho j / star (base j * (z ^ j.val - eta))

theorem finite_lower_zeros {d q : ℕ} (z rho : ℂ) (hq : q ≠ 0)
    (hz : IsPrimitiveRoot z q) (hdq : d + 1 ≤ q)
    (base : Fin (d + 1) → ℂ) (hbase : ∀ j, base j ≠ 0)
    (a : Fin q) (V : Fin d → Fin q) (hV : Function.Injective V) :
    Set.Finite {eta : ℂ | lowerCoefficient z rho base a V eta = 0} := by
  have hinj : Function.Injective (fun j : Fin (d + 1) => z ^ j.val) := by
    intro i j he
    apply Fin.val_injective
    exact hz.pow_inj (by have h := i.isLt; omega) (by have h := j.isLt; omega) he
  have hc : ∃ j : Fin (d + 1),
      cofactor z a V j * lowerWeight rho j / base j ≠ 0 := by
    refine ⟨0, ?_⟩
    simpa [lowerWeight] using div_ne_zero (first_ne_zero z hq hz a V hV) (hbase 0)
  have hf := P14FiniteReciprocalAvoidance.finite_zeros (fun j : Fin (d + 1) => z ^ j.val)
    (fun j => cofactor z a V j * lowerWeight rho j / base j) hinj
    (fun j => pow_ne_zero _ (hz.ne_zero hq)) hc
  simpa only [lowerCoefficient, div_div] using hf

theorem finite_upper_zeros {d q : ℕ} (z rho : ℂ) (hq : q ≠ 0)
    (hz : IsPrimitiveRoot z q) (hdq : d + 1 ≤ q)
    (base : Fin (d + 1) → ℂ) (hbase : ∀ j, base j ≠ 0)
    (a : Fin q) (V : Fin d → Fin q) (hV : Function.Injective V) :
    Set.Finite {eta : ℂ | upperCoefficient z rho base a V eta = 0} := by
  have hinj : Function.Injective (fun j : Fin (d + 1) => z ^ j.val) := by
    intro i j he
    apply Fin.val_injective
    exact hz.pow_inj (by have h := i.isLt; omega) (by have h := j.isLt; omega) he
  have hc : ∃ j : Fin (d + 1),
      cofactor z a V j * upperWeight rho j / star (base j) ≠ 0 := by
    refine ⟨Fin.last d, ?_⟩
    simpa [upperWeight] using div_ne_zero (last_ne_zero z hq hz a V hV)
      (star_ne_zero.mpr (hbase (Fin.last d)))
  have hf := P14FiniteReciprocalAvoidance.finite_star_zeros (fun j : Fin (d + 1) => z ^ j.val)
    (fun j => cofactor z a V j * upperWeight rho j / star (base j)) hinj
    (fun j => pow_ne_zero _ (hz.ne_zero hq)) hc
  simpa only [upperCoefficient, div_div, star_mul, mul_comm] using hf

end P14FourierEndpointCofactors
end
end

section

/-! Exact endpoint values of the actual weight profile and of its
reciprocal profile after multiplying by epsilon^(n+1). These use the
same positive leading coefficients obtained from the moment equations. -/

noncomputable section
namespace P14HighDimensionEndpointWeights
open P14ConsecutiveReciprocalWeights P14SeparatedPositiveWeights
open P14ComplexPairCoordinates P14HighDimensionPhase P14FourierEndpointCofactors

theorem power_le (n : ℕ) (i : Fin (n + 6)) : power n i ≤ n + 1 := by
  rw [P14HighDimensionPowerCut.power_formula]
  exact min_le_right _ _

theorem lower_value (n q : ℕ) (D : Fin (n + 6) → ℝ) (i : Fin (n + 6)) :
    (((0 : ℝ) ^ power n i * leading n q D i : ℝ) : ℂ) =
      lowerWeight (rho q : ℂ) i := by
  obtain ⟨j, rfl⟩ := (index n).surjective i
  rcases j with j | (j | j)
  · fin_cases j <;> simp [power, leading, coefficient, order, triple_zero, lowerWeight]
  · have hj : ¬ 3 + j.val < 3 := by omega
    simp [power, leading, coefficient, order, lowerWeight, hj]
  · have hj : ¬ n + 3 + j.val < 3 := by omega
    simp [power, leading, coefficient, order, lowerWeight, hj]

theorem upper_value (n q : ℕ) (D : Fin (n + 6) → ℝ) (i : Fin (n + 6)) :
    (((0 : ℝ) ^ (n + 1 - power n i) / leading n q D i : ℝ) : ℂ) =
      upperWeight (rho q : ℂ) i / (D i : ℂ) := by
  obtain ⟨j, rfl⟩ := (index n).surjective i
  rcases j with j | (j | j)
  · have hj : ¬ n + 3 ≤ j.val := by have h := j.isLt; omega
    simp [power, leading, coefficient, order, upperWeight, hj]
  · have hj : ¬ n + 3 ≤ 3 + j.val := by have h := j.isLt; omega
    have he : n - j.val ≠ 0 := by have h := j.isLt; omega
    simp [power, leading, coefficient, order, upperWeight, hj, he]
  · fin_cases j <;>
      simp [power, leading, coefficient, order, triple_zero, upperWeight,
        Nat.add_assoc]

end P14HighDimensionEndpointWeights
end
end

section

/-! The actual cofactor expansion and continuity of a singleton Fourier
row with arbitrary coordinate multipliers over the opposite Fourier block. -/

noncomputable section
open Matrix Filter
open scoped BigOperators Topology
namespace P14SingletonFourierDeterminant
open P14FourierEndpointCofactors

def rows {d q : ℕ} (z : ℂ) (F : Fin (d + 1) → ℂ)
    (a : Fin q) (V : Fin d → Fin q) : Matrix (Fin (d + 1)) (Fin (d + 1)) ℂ :=
  Fin.cons (fun j => z ^ (a.val * j.val) * F j)
    (fun i j => z ^ ((V i).val * j.val))

theorem det_formula {d q : ℕ} (z : ℂ) (F : Fin (d + 1) → ℂ)
    (a : Fin q) (V : Fin d → Fin q) :
    (rows z F a V).det = ∑ j, cofactor z a V j * F j := by
  rw [Matrix.det_succ_row_zero]
  apply Finset.sum_congr rfl
  intro j _
  have hm : (rows z F a V).submatrix Fin.succ j.succAbove =
      (fun i k : Fin d => z ^ ((V i).val * (j.succAbove k).val)) := by
    ext i k
    simp [rows, Matrix.submatrix]
  rw [hm]
  simp only [rows, Fin.cons_zero, cofactor]
  ring

theorem continuous {d q : ℕ} (z : ℂ) (F : ℝ → Fin (d + 1) → ℂ)
    (hF : ∀ j, ContinuousAt (fun e => F e j) 0)
    (a : Fin q) (V : Fin d → Fin q) :
    ContinuousAt (fun e => rows z (F e) a V) 0 := by
  apply continuousAt_pi.mpr
  intro i
  apply continuousAt_pi.mpr
  intro j
  refine Fin.cases ?_ (fun k => ?_) i
  · exact continuousAt_const.mul (hF j)
  · exact continuousAt_const

theorem eventually_nonzero {d q : ℕ} (z : ℂ) (F : ℝ → Fin (d + 1) → ℂ)
    (hF : ∀ j, ContinuousAt (fun e => F e j) 0)
    (a : Fin q) (V : Fin d → Fin q)
    (hzero : (∑ j, cofactor z a V j * F 0 j) ≠ 0) :
    ∀ᶠ e in 𝓝 (0 : ℝ), (rows z (F e) a V).det ≠ 0 := by
  have hd : ContinuousAt (fun e => (rows z (F e) a V).det) 0 :=
    continuous_id.matrix_det.continuousAt.comp (continuous z F hF a V)
  have hn : (rows z (F 0) a V).det ≠ 0 := by rwa [det_formula]
  exact hd.eventually (eventually_ne_nhds hn)

end P14SingletonFourierDeterminant
end
end

section

/-! The rational and anti-rational endpoint coefficient sums are the
actual limits for the same moment-branch coefficients. The upper singleton
uses epsilon^(n+1) times the reciprocal weights, with conjugation retained. -/

noncomputable section
open Filter
open scoped Topology BigOperators
namespace P14HighDimensionSingletonLimits
open P14HighDimensionPhase P14ConsecutiveReciprocalWeights
open P14FourierEndpointCofactors P14HighDimensionEndpointWeights

def data {n q : ℕ} (base : Fin (n + 6) → ℂ) (eta : ℂ) (j : Fin (n + 6)) : ℂ :=
  star (base j * (node q ^ j.val - eta))

def lowerMultiplier {n : ℕ} (a : ℝ → Fin (n + 6) → ℝ)
    (P : Fin (n + 6) → ℂ) (e : ℝ) (j : Fin (n + 6)) : ℂ :=
  ((e ^ power n j * a e j : ℝ) : ℂ) / star (P j)

def upperMultiplier {n : ℕ} (a : ℝ → Fin (n + 6) → ℝ)
    (P : Fin (n + 6) → ℂ) (e : ℝ) (j : Fin (n + 6)) : ℂ :=
  star (P j) * ((e ^ (n + 1 - power n j) / a e j : ℝ) : ℂ)

theorem lower_continuous {n : ℕ} (a : ℝ → Fin (n + 6) → ℝ)
    (ha : ∀ j, ContinuousAt (fun e => a e j) 0)
    (P : Fin (n + 6) → ℂ) (hP : ∀ j, P j ≠ 0) (j : Fin (n + 6)) :
    ContinuousAt (fun e => lowerMultiplier a P e j) 0 := by
  exact (Complex.continuous_ofReal.continuousAt.comp
    ((continuousAt_id.pow _).mul (ha j))).div continuousAt_const
      (star_ne_zero.mpr (hP j))

theorem upper_continuous {n : ℕ} (a : ℝ → Fin (n + 6) → ℝ)
    (ha : ∀ j, ContinuousAt (fun e => a e j) 0) (ha0 : ∀ j, a 0 j ≠ 0)
    (P : Fin (n + 6) → ℂ) (j : Fin (n + 6)) :
    ContinuousAt (fun e => upperMultiplier a P e j) 0 := by
  exact continuousAt_const.mul (Complex.continuous_ofReal.continuousAt.comp
    ((continuousAt_id.pow _).div (ha j) (ha0 j)))

theorem lower_zero {n q : ℕ} (base : Fin (n + 6) → ℂ) (eta : ℂ)
    (a : ℝ → Fin (n + 6) → ℝ)
    (ha0 : ∀ j, a 0 j = leading n q (fun i => Complex.normSq (data (q := q) base eta i)) j)
    (j : Fin (n + 6)) :
    lowerMultiplier a (data (q := q) base eta) 0 j =
      lowerWeight (rho q : ℂ) j / (base j * (node q ^ j.val - eta)) := by
  simp only [lowerMultiplier, ha0, lower_value, data, star_star]

theorem upper_zero {n q : ℕ} (base : Fin (n + 6) → ℂ) (eta : ℂ)
    (a : ℝ → Fin (n + 6) → ℝ)
    (ha0 : ∀ j, a 0 j = leading n q (fun i => Complex.normSq (data (q := q) base eta i)) j)
    (hP : ∀ j, data (q := q) base eta j ≠ 0) (j : Fin (n + 6)) :
    upperMultiplier a (data (q := q) base eta) 0 j =
      upperWeight (rho q : ℂ) j / star (base j * (node q ^ j.val - eta)) := by
  let P := data (q := q) base eta
  have hn : (Complex.normSq (P j) : ℂ) = star (P j) * P j :=
    Complex.normSq_eq_conj_mul_self
  change star (P j) * (((0 : ℝ) ^ (n + 1 - power n j) / a 0 j : ℝ) : ℂ) =
    upperWeight (rho q : ℂ) j / P j
  rw [ha0, upper_value]
  change star (P j) * (upperWeight (rho q : ℂ) j / (Complex.normSq (P j) : ℂ)) = _
  rw [hn]
  have hp : P j ≠ 0 := hP j
  have hsp : star (P j) ≠ 0 := star_ne_zero.mpr hp
  field_simp

theorem eventually_endpoints {n q : ℕ} (base : Fin (n + 6) → ℂ) (eta : ℂ)
    (a : ℝ → Fin (n + 6) → ℝ)
    (hlim : ∀ j, Tendsto (fun e => a e j) (𝓝 0)
      (𝓝 (leading n q (fun i => Complex.normSq (data (q := q) base eta i)) j)))
    (hlead : ∀ j, 0 < leading n q (fun i => Complex.normSq (data (q := q) base eta i)) j)
    (hP : ∀ j, data (q := q) base eta j ≠ 0)
    (b : Fin q) (V : Fin (n + 5) → Fin q)
    (hl : lowerCoefficient (node q) (rho q : ℂ) base b V eta ≠ 0)
    (hu : upperCoefficient (node q) (rho q : ℂ) base b V eta ≠ 0) :
    ∀ᶠ e in 𝓝 (0 : ℝ),
      (P14SingletonFourierDeterminant.rows (node q)
        (lowerMultiplier a (data (q := q) base eta) e) b V).det ≠ 0 ∧
      (P14SingletonFourierDeterminant.rows (node q)
        (upperMultiplier a (data (q := q) base eta) e) b V).det ≠ 0 := by
  have ha : ∀ j, ContinuousAt (fun e => a e j) 0 :=
    fun j => continuousAt_of_tendsto_nhds (hlim j)
  have ha0 := fun j => eq_of_tendsto_nhds (hlim j)
  have hapos : ∀ j, a 0 j ≠ 0 := by
    intro j
    rw [ha0]
    exact (hlead j).ne'
  have hl0 : (∑ j, cofactor (node q) b V j *
      lowerMultiplier a (data (q := q) base eta) 0 j) ≠ 0 := by
    simpa only [lower_zero base eta a ha0, mul_div_assoc, lowerCoefficient] using hl
  have hu0 : (∑ j, cofactor (node q) b V j *
      upperMultiplier a (data (q := q) base eta) 0 j) ≠ 0 := by
    simpa only [upper_zero base eta a ha0 hP, mul_div_assoc, upperCoefficient] using hu
  exact (P14SingletonFourierDeterminant.eventually_nonzero (node q)
    (lowerMultiplier a (data (q := q) base eta)) (lower_continuous a ha _ hP) b V hl0).and
      (P14SingletonFourierDeterminant.eventually_nonzero (node q)
        (upperMultiplier a (data (q := q) base eta)) (upper_continuous a ha hapos _) b V hu0)

end P14HighDimensionSingletonLimits
end
end

section

/-! Exact diagonal scalings connect both endpoint limit matrices to the
original square-root Fourier rows. The same positive weight vector is used. -/

noncomputable section
open Matrix Filter
open scoped Topology BigOperators
namespace P14HighDimensionSingletonPhysical
open P14HighDimensionPhase P14ConsecutiveReciprocalWeights P14ReciprocalFourierRows
open P14HighDimensionSingletonLimits P14SingletonFourierDeterminant

def lowerRows {n q : ℕ} (H : Fin (n + 6) → ℝ) (P : Fin (n + 6) → ℂ)
    (b : Fin q) (V : Fin (n + 5) → Fin q) : Matrix (Fin (n + 6)) (Fin (n + 6)) ℂ :=
  Fin.cons (u H b) (fun i => v H P (V i))

def upperRows {n q : ℕ} (H : Fin (n + 6) → ℝ) (P : Fin (n + 6) → ℂ)
    (b : Fin q) (V : Fin (n + 5) → Fin q) : Matrix (Fin (n + 6)) (Fin (n + 6)) ℂ :=
  Fin.cons (v H P b) (fun i => u H (V i))

theorem power_ratio (e a : ℂ) (M k : ℕ) (hk : k ≤ M) (he : e ≠ 0) :
    e ^ M / (e ^ k * a) = e ^ (M - k) / a := by
  have hpow : e ^ M = e ^ k * e ^ (M - k) := by rw [← pow_add, Nat.add_sub_of_le hk]
  rw [hpow]
  exact mul_div_mul_left _ _ (pow_ne_zero k he)

theorem lower_scaling {n q : ℕ} (a : ℝ → Fin (n + 6) → ℝ) (e : ℝ)
    (P : Fin (n + 6) → ℂ) (hP : ∀ j, P j ≠ 0)
    (hH : ∀ j, 0 < e ^ power n j * a e j)
    (b : Fin q) (V : Fin (n + 5) → Fin q) :
    lowerRows (fun j => e ^ power n j * a e j) P b V *
      diagonal (fun j => (Real.sqrt (e ^ power n j * a e j) : ℂ) / star (P j)) =
        rows (node q) (lowerMultiplier a P e) b V := by
  ext i j
  rw [Matrix.mul_diagonal]
  have hs : (Real.sqrt (e ^ power n j * a e j) : ℂ) ≠ 0 :=
    Complex.ofReal_ne_zero.mpr (Real.sqrt_pos.mpr (hH j)).ne'
  have hp : star (P j) ≠ 0 := star_ne_zero.mpr (hP j)
  have hsq : (Real.sqrt (e ^ power n j * a e j) : ℂ) ^ 2 =
      (e ^ power n j * a e j : ℝ) := by exact_mod_cast Real.sq_sqrt (hH j).le
  refine Fin.cases ?_ (fun k => ?_) i
  · change (node q ^ (b.val * j.val) * (Real.sqrt (e ^ power n j * a e j) : ℂ)) *
        ((Real.sqrt (e ^ power n j * a e j) : ℂ) / star (P j)) =
      node q ^ (b.val * j.val) * (((e ^ power n j * a e j : ℝ) : ℂ) / star (P j))
    rw [← hsq]
    ring
  · change (node q ^ ((V k).val * j.val) * star (P j) /
        (Real.sqrt (e ^ power n j * a e j) : ℂ)) *
        ((Real.sqrt (e ^ power n j * a e j) : ℂ) / star (P j)) = _
    change _ = node q ^ ((V k).val * j.val)
    field_simp

theorem upper_scaling {n q : ℕ} (a : ℝ → Fin (n + 6) → ℝ) (e : ℝ) (he : 0 < e)
    (P : Fin (n + 6) → ℂ) (hH : ∀ j, 0 < e ^ power n j * a e j)
    (b : Fin q) (V : Fin (n + 5) → Fin q) :
    diagonal (Fin.cons ((e : ℂ) ^ (n + 1)) (fun _ : Fin (n + 5) => 1)) *
      (upperRows (fun j => e ^ power n j * a e j) P b V *
        diagonal (fun j => ((Real.sqrt (e ^ power n j * a e j) : ℂ))⁻¹)) =
      rows (node q) (upperMultiplier a P e) b V := by
  ext i j
  rw [Matrix.diagonal_mul, Matrix.mul_diagonal]
  have hs : (Real.sqrt (e ^ power n j * a e j) : ℂ) ≠ 0 :=
    Complex.ofReal_ne_zero.mpr (Real.sqrt_pos.mpr (hH j)).ne'
  have hsq : (Real.sqrt (e ^ power n j * a e j) : ℂ) ^ 2 =
      (e ^ power n j * a e j : ℝ) := by exact_mod_cast Real.sq_sqrt (hH j).le
  have hec : (e : ℂ) ≠ 0 := Complex.ofReal_ne_zero.mpr he.ne'
  refine Fin.cases ?_ (fun k => ?_) i
  · change (e : ℂ) ^ (n + 1) * ((node q ^ (b.val * j.val) * star (P j) /
        (Real.sqrt (e ^ power n j * a e j) : ℂ)) *
        (Real.sqrt (e ^ power n j * a e j) : ℂ)⁻¹) =
      node q ^ (b.val * j.val) *
        (star (P j) * ((e ^ (n + 1 - power n j) / a e j : ℝ) : ℂ))
    calc
      _ = (node q ^ (b.val * j.val) * star (P j)) *
          ((e : ℂ) ^ (n + 1) / (Real.sqrt (e ^ power n j * a e j) : ℂ) ^ 2) := by ring
      _ = _ := by
        rw [hsq, Complex.ofReal_mul, Complex.ofReal_pow,
          power_ratio (e : ℂ) (a e j : ℂ) (n + 1) (power n j)
            (P14HighDimensionEndpointWeights.power_le n j) hec]
        push_cast
        ring
  · change 1 * ((node q ^ ((V k).val * j.val) *
        (Real.sqrt (e ^ power n j * a e j) : ℂ)) *
        (Real.sqrt (e ^ power n j * a e j) : ℂ)⁻¹) =
      node q ^ ((V k).val * j.val)
    field_simp

theorem physical_nonzero {n q : ℕ} (a : ℝ → Fin (n + 6) → ℝ) (e : ℝ) (he : 0 < e)
    (P : Fin (n + 6) → ℂ) (hP : ∀ j, P j ≠ 0)
    (hH : ∀ j, 0 < e ^ power n j * a e j)
    (b : Fin q) (V : Fin (n + 5) → Fin q)
    (hl : (rows (node q) (lowerMultiplier a P e) b V).det ≠ 0)
    (hu : (rows (node q) (upperMultiplier a P e) b V).det ≠ 0) :
    (lowerRows (fun j => e ^ power n j * a e j) P b V).det ≠ 0 ∧
      (upperRows (fun j => e ^ power n j * a e j) P b V).det ≠ 0 := by
  constructor
  · intro hz
    apply hl
    rw [← lower_scaling a e P hP hH b V, Matrix.det_mul, hz, zero_mul]
  · intro hz
    apply hu
    rw [← upper_scaling a e he P hH b V, Matrix.det_mul, Matrix.det_mul, hz, zero_mul, mul_zero]

end P14HighDimensionSingletonPhysical
end
end

section

/-! One spectral parameter simultaneously avoids all lower and upper
singleton Fourier coefficient zeros, all spectral nodes, and any supplied
finite exclusions. This does not yet identify the coefficients with the
physical determinant limits or assert a UPB. -/

noncomputable section
namespace P14FourierEndpointParameter
open P14FourierEndpointCofactors

theorem exists_common_parameter {d q : ℕ} (z rho : ℂ) (hq : q ≠ 0)
    (hz : IsPrimitiveRoot z q) (hdq : d + 1 ≤ q)
    (base : Fin (d + 1) → ℂ) (hbase : ∀ j, base j ≠ 0)
    (E : Set ℂ) (hE : E.Finite) :
    ∃ eta : ℂ, eta ∉ E ∧
      (∀ j, base j * (z ^ j.val - eta) ≠ 0) ∧
      ∀ (a : Fin q) (V : Fin d → Fin q), Function.Injective V →
        lowerCoefficient z rho base a V eta ≠ 0 ∧
        upperCoefficient z rho base a V eta ≠ 0 := by
  classical
  let I := Fin q × {V : Fin d → Fin q // Function.Injective V}
  let A : Set ℂ := ⋃ i : I, {eta | lowerCoefficient z rho base i.1 i.2.val eta = 0}
  let B : Set ℂ := ⋃ i : I, {eta | upperCoefficient z rho base i.1 i.2.val eta = 0}
  have hA : A.Finite := Set.finite_iUnion
    (fun i => finite_lower_zeros z rho hq hz hdq base hbase i.1 i.2.val i.2.property)
  have hB : B.Finite := Set.finite_iUnion
    (fun i => finite_upper_zeros z rho hq hz hdq base hbase i.1 i.2.val i.2.property)
  have hNodes : (Set.range (fun j : Fin (d + 1) => z ^ j.val)).Finite := Set.finite_range _
  let : Infinite ℂ := Infinite.of_injective (fun n : ℕ => (n : ℂ)) Nat.cast_injective
  obtain ⟨eta, _, he⟩ := Set.infinite_univ.exists_notMem_finite
    (((hE.union hNodes).union hA).union hB)
  refine ⟨eta, ?_, ?_, ?_⟩
  · exact fun h => he (Or.inl (Or.inl (Or.inl h)))
  · intro j
    apply mul_ne_zero (hbase j)
    intro hz0
    have hj : eta ∈ Set.range (fun j : Fin (d + 1) => z ^ j.val) :=
      ⟨j, sub_eq_zero.mp hz0⟩
    exact he (Or.inl (Or.inl (Or.inr hj)))
  · intro a V hV
    constructor
    · intro hzero
      exact he (Or.inl (Or.inr (Set.mem_iUnion.mpr ⟨(a, ⟨V, hV⟩), hzero⟩)))
    · intro hzero
      exact he (Or.inr (Set.mem_iUnion.mpr ⟨(a, ⟨V, hV⟩), hzero⟩))

end P14FourierEndpointParameter
end
end

section

/-! One spectral parameter and one positive weight vector simultaneously
give the two complex moments and all required middle and endpoint minors
of the original square-root Fourier families. -/

noncomputable section
open Filter
open scoped Topology BigOperators
namespace P14HighDimensionAllMinors
open P14HighDimensionPhase P14ConsecutiveReciprocalWeights
open P14HighDimensionMiddleMinors P14HighDimensionMiddleFamily
open P14HighDimensionSingletonLimits P14HighDimensionSingletonPhysical
open P14FourierEndpointCofactors P14ReciprocalFourierRows

def EndpointMinors {n q : ℕ} (P : Fin (n + 6) → ℂ) (H : Fin (n + 6) → ℝ) : Prop :=
  ∀ (b : Fin q) (V : Fin (n + 5) → Fin q), Function.Injective V →
    (lowerRows H P b V).det ≠ 0 ∧ (upperRows H P b V).det ≠ 0

theorem exists_all {n q : ℕ} (hq : 7 ≤ q) (ho : Odd q) (hdq : n + 6 ≤ q)
    (base : Fin (n + 6) → ℂ) (hbase : ∀ j, base j ≠ 0)
    (E : Set ℂ) (hE : E.Finite) :
    ∃ (eta : ℂ) (H : Fin (n + 6) → ℝ), eta ∉ E ∧
      (∀ j, data (q := q) base eta j ≠ 0) ∧ (∀ j, 0 < H j) ∧
      (∑ j, (H j : ℂ) * node q ^ j.val) = 0 ∧
      (∑ j, ((Complex.normSq (data (q := q) base eta j) / H j : ℝ) : ℂ) *
        node q ^ j.val) = 0 ∧
      MiddleMinors (q := q) (data (q := q) base eta) H ∧
      EndpointMinors (q := q) (data (q := q) base eta) H := by
  classical
  obtain ⟨eta, hEeta, hvalues, hcoeff⟩ := P14FourierEndpointParameter.exists_common_parameter
    (d := n + 5) (node q) (rho q : ℂ) (by omega) (primitive hq ho) hdq base hbase E hE
  let P := data (q := q) base eta
  have hP : ∀ j, P j ≠ 0 := fun j => star_ne_zero.mpr (hvalues j)
  obtain ⟨a, hlim, hlead, hnear⟩ := exists_weights hq ho
    (fun j => Complex.normSq (P j)) (fun j => Complex.normSq_pos.mpr (hP j))
  have ha : ∀ j, ContinuousAt (fun e => a e j) 0 :=
    fun j => continuousAt_of_tendsto_nhds (hlim j)
  have ha0 : ∀ j, a 0 j ≠ 0 := by
    intro j
    rw [eq_of_tendsto_nhds (hlim j)]
    exact (hlead j).ne'
  have hepos : ∀ᶠ e in 𝓝[>] (0 : ℝ), 0 < e := self_mem_nhdsWithin
  have hb := (hnear.filter_mono nhdsWithin_le_nhds).and hepos
  have hb' : ∀ᶠ e in 𝓝[>] (0 : ℝ),
      (∀ j, 0 < weight n a e j) ∧
      (∑ j, (weight n a e j : ℂ) * node q ^ j.val) = 0 ∧
      (∑ j, ((Complex.normSq (P j) / weight n a e j : ℝ) : ℂ) * node q ^ j.val) = 0 :=
    hb.mono (fun _ h => h.1 h.2)
  have hm := eventually_all hq ho a ha ha0 (hb'.mono (fun _ h => h.1)) P hP
  have hend : ∀ᶠ e in 𝓝[>] (0 : ℝ), EndpointMinors (q := q) P (weight n a e) := by
    unfold EndpointMinors
    apply Filter.eventually_all.mpr
    intro b
    apply Filter.eventually_all.mpr
    intro V
    by_cases hV : Function.Injective V
    · have hl := eventually_endpoints base eta a hlim hlead hP b V
        (hcoeff b V hV).1 (hcoeff b V hV).2
      filter_upwards [hl.filter_mono nhdsWithin_le_nhds, hb', hepos] with e he hbal hp
      intro _
      exact physical_nonzero a e hp P hP hbal.1 b V he.1 he.2
    · exact Filter.Eventually.of_forall (fun _ hi => False.elim (hV hi))
  obtain ⟨e, he, hme, hene⟩ := (hb'.and (hm.and hend)).exists
  exact ⟨eta, weight n a e, hEeta, hP, he.1, he.2.1, he.2.2, hme, hene⟩

theorem exists_family {n q : ℕ} [NeZero q] (hq : 7 ≤ q) (ho : Odd q) (hdq : n + 6 ≤ q)
    (base : Fin (n + 6) → ℂ) (hbase : ∀ j, base j ≠ 0)
    (E : Set ℂ) (hE : E.Finite) :
    ∃ (eta : ℂ) (H : Fin (n + 6) → ℝ), eta ∉ E ∧ (∀ j, 0 < H j) ∧
      MiddleMinors (q := q) (data (q := q) base eta) H ∧
      EndpointMinors (q := q) (data (q := q) base eta) H ∧
      (∀ i : Fin q, u H i ≠ 0 ∧ v H (data (q := q) base eta) i ≠ 0) ∧
      (∀ I : Fin (n + 6) → Fin q, Function.Injective I →
        LinearIndependent ℂ (fun i => u H (I i)) ∧
        LinearIndependent ℂ (fun i => v H (data (q := q) base eta) (I i))) ∧
      (∀ i : Fin q, pair (u H i) (u H (i + 1)) = 0 ∧
        pair (v H (data (q := q) base eta) i)
          (v H (data (q := q) base eta) (i + 1)) = 0) := by
  obtain ⟨eta, H, heta, hP, hpos, hfirst, hsecond, hmiddle, hends⟩ :=
    exists_all hq ho hdq base hbase E hE
  refine ⟨eta, H, heta, hpos, hmiddle, hends, ?_, ?_, ?_⟩
  · exact fun i => ⟨u_nonzero (by omega) H hpos i,
      v_nonzero (by omega) H hpos _ hP i⟩
  · exact fun I hI => ⟨pure_u hq ho H hpos I hI, pure_v hq ho H hpos _ hP I hI⟩
  · exact fun i => ⟨u_cycle hq ho H hpos hfirst i, v_cycle hq ho H hpos _ hsecond i⟩

end P14HighDimensionAllMinors
end
end

section

/-! Finite subset extraction for two-layer spanning. A pure d-tuple or
a mixed tuple with at least two entries per layer occurs inside every
(d+1)-element set, provided d>=4. -/

noncomputable section
namespace P14TwoLayerSpanExtraction
open Submodule

theorem select {α : Type*} [DecidableEq α] (A : Finset α) (n : ℕ) (hn : n ≤ A.card) :
    ∃ U : Fin n → α, Function.Injective U ∧ ∀ i, U i ∈ A := by
  obtain ⟨S, hS, hc⟩ := Finset.exists_subset_card_eq hn
  let e : Fin n ≃ S := (Finset.equivFinOfCardEq hc).symm
  exact ⟨fun i => (e i).val, Subtype.val_injective.comp e.injective,
    fun i => hS (e i).property⟩

theorem of_included {K M α ι : Type*} [Semiring K] [AddCommMonoid M] [Module K M]
    (x : α → M) (A : Finset α) (f : ι → M)
    (hf : span K (Set.range f) = ⊤)
    (hmem : ∀ i, ∃ a : A, x a = f i) :
    span K (Set.range (fun a : A => x a)) = ⊤ := by
  apply top_unique
  rw [← hf]
  apply span_mono
  rintro _ ⟨i, rfl⟩
  exact hmem i

theorem every_plus_one {K M α β : Type*} [Semiring K]
    [AddCommMonoid M] [Module K M] [DecidableEq α] [DecidableEq β]
    (d : ℕ) (hd : 4 ≤ d) (x : α ⊕ β → M)
    (hu : ∀ U : Fin d → α, Function.Injective U →
      span K (Set.range (fun i => x (.inl (U i)))) = ⊤)
    (hv : ∀ V : Fin d → β, Function.Injective V →
      span K (Set.range (fun i => x (.inr (V i)))) = ⊤)
    (hm : ∀ (r s : ℕ), r + s = d → 2 ≤ r → 2 ≤ s →
      ∀ (U : Fin r → α) (V : Fin s → β), Function.Injective U → Function.Injective V →
      span K (Set.range (fun i : Fin r ⊕ Fin s =>
        Sum.elim (fun a => x (.inl (U a))) (fun b => x (.inr (V b))) i)) = ⊤)
    (A : Finset (α ⊕ β)) (hA : A.card = d + 1) :
    span K (Set.range (fun a : A => x a)) = ⊤ := by
  classical
  have hcount := A.card_toLeft_add_card_toRight
  by_cases hU : d ≤ A.toLeft.card
  · obtain ⟨U, hi, hmem⟩ := select A.toLeft d hU
    apply of_included x A _ (hu U hi)
    intro i
    exact ⟨⟨.inl (U i), Finset.mem_toLeft.mp (hmem i)⟩, rfl⟩
  by_cases hV : d ≤ A.toRight.card
  · obtain ⟨V, hi, hmem⟩ := select A.toRight d hV
    apply of_included x A _ (hv V hi)
    intro i
    exact ⟨⟨.inr (V i), Finset.mem_toRight.mp (hmem i)⟩, rfl⟩
  let r := min A.toLeft.card (d - 2)
  let s := d - r
  have hr : 2 ≤ r := by dsimp [r]; omega
  have hs : 2 ≤ s := by dsimp [s, r]; omega
  have hrs : r + s = d := by dsimp [s, r]; omega
  have hru : r ≤ A.toLeft.card := min_le_left _ _
  have hsv : s ≤ A.toRight.card := by dsimp [s, r]; omega
  obtain ⟨U, hiU, hmemU⟩ := select A.toLeft r hru
  obtain ⟨V, hiV, hmemV⟩ := select A.toRight s hsv
  apply of_included x A _ (hm r s hrs hr hs U V hiU hiV)
  intro i
  rcases i with a | b
  · exact ⟨⟨.inl (U a), Finset.mem_toLeft.mp (hmemU a)⟩, rfl⟩
  · exact ⟨⟨.inr (V b), Finset.mem_toRight.mp (hmemV b)⟩, rfl⟩

end P14TwoLayerSpanExtraction

end
end

section

/-! Pure, singleton-side, and middle selections suffice for every d+1
rows to span when d>=6. Applied to the same checked high-dimensional
moment construction, this gives the required local spanning condition. -/

noncomputable section
open Submodule
namespace P14HighDimensionSpanning
open P14TwoLayerSpanExtraction P14ReciprocalFourierRows P14HighDimensionMiddleMinors
open P14HighDimensionMiddleFamily P14HighDimensionAllMinors P14HighDimensionSingletonLimits
open P14HighDimensionSingletonPhysical

theorem extract {q d : ℕ} (hd : 6 ≤ d) (x : Fin q ⊕ Fin q → Fin d → ℂ)
    (hu : ∀ U : Fin d → Fin q, Function.Injective U →
      span ℂ (Set.range (fun i => x (.inl (U i)))) = ⊤)
    (hv : ∀ V : Fin d → Fin q, Function.Injective V →
      span ℂ (Set.range (fun i => x (.inr (V i)))) = ⊤)
    (hl : ∀ b (V : Fin (d - 1) → Fin q), Function.Injective V →
      span ℂ (Set.range (Fin.cons (x (.inl b)) (fun i => x (.inr (V i))))) = ⊤)
    (hr : ∀ b (V : Fin (d - 1) → Fin q), Function.Injective V →
      span ℂ (Set.range (Fin.cons (x (.inr b)) (fun i => x (.inl (V i))))) = ⊤)
    (hm : ∀ r s, r + s = d → 3 ≤ r → 3 ≤ s →
      ∀ (U : Fin r → Fin q) (V : Fin s → Fin q), Function.Injective U → Function.Injective V →
      span ℂ (Set.range (fun i : Fin r ⊕ Fin s =>
        Sum.elim (fun a => x (.inl (U a))) (fun b => x (.inr (V b))) i)) = ⊤)
    (A : Finset (Fin q ⊕ Fin q)) (hA : A.card = d + 1) :
    span ℂ (Set.range (fun i : A => x i)) = ⊤ := by
  classical
  have hcount := A.card_toLeft_add_card_toRight
  by_cases hU : d ≤ A.toLeft.card
  · obtain ⟨U, hi, hmem⟩ := select A.toLeft d hU
    apply of_included x A _ (hu U hi)
    exact fun i => ⟨⟨.inl (U i), Finset.mem_toLeft.mp (hmem i)⟩, rfl⟩
  by_cases hV : d ≤ A.toRight.card
  · obtain ⟨V, hi, hmem⟩ := select A.toRight d hV
    apply of_included x A _ (hv V hi)
    exact fun i => ⟨⟨.inr (V i), Finset.mem_toRight.mp (hmem i)⟩, rfl⟩
  by_cases hL2 : A.toLeft.card = 2
  · obtain ⟨U, _, hmemU⟩ := select A.toLeft 1 (by omega)
    obtain ⟨V, hiV, hmemV⟩ := select A.toRight (d - 1) (by omega)
    apply of_included x A _ (hl (U 0) V hiV)
    intro i
    refine Fin.cases ?_ (fun j => ?_) i
    · exact ⟨⟨.inl (U 0), Finset.mem_toLeft.mp (hmemU 0)⟩, rfl⟩
    · exact ⟨⟨.inr (V j), Finset.mem_toRight.mp (hmemV j)⟩, rfl⟩
  by_cases hR2 : A.toRight.card = 2
  · obtain ⟨U, _, hmemU⟩ := select A.toRight 1 (by omega)
    obtain ⟨V, hiV, hmemV⟩ := select A.toLeft (d - 1) (by omega)
    apply of_included x A _ (hr (U 0) V hiV)
    intro i
    refine Fin.cases ?_ (fun j => ?_) i
    · exact ⟨⟨.inr (U 0), Finset.mem_toRight.mp (hmemU 0)⟩, rfl⟩
    · exact ⟨⟨.inl (V j), Finset.mem_toLeft.mp (hmemV j)⟩, rfl⟩
  let r := min A.toLeft.card (d - 3)
  let s := d - r
  have hrl : 3 ≤ r := by dsimp [r]; omega
  have hsl : 3 ≤ s := by dsimp [s, r]; omega
  have hrs : r + s = d := by dsimp [s, r]; omega
  obtain ⟨U, hiU, hmemU⟩ := select A.toLeft r (min_le_left _ _)
  obtain ⟨V, hiV, hmemV⟩ := select A.toRight s (by dsimp [s, r]; omega)
  apply of_included x A _ (hm r s hrs hrl hsl U V hiU hiV)
  intro i
  rcases i with a | b
  · exact ⟨⟨.inl (U a), Finset.mem_toLeft.mp (hmemU a)⟩, rfl⟩
  · exact ⟨⟨.inr (V b), Finset.mem_toRight.mp (hmemV b)⟩, rfl⟩

def family {n q : ℕ} (H : Fin (n + 6) → ℝ) (P : Fin (n + 6) → ℂ) :
    Fin q ⊕ Fin q → Fin (n + 6) → ℂ := Sum.elim (u H) (v H P)

theorem middle_independent {n q r s : ℕ} (H : Fin (n + 6) → ℝ)
    (P : Fin (n + 6) → ℂ) (hm : MiddleMinors (q := q) P H)
    (h : r + s = n + 6) (hr : 3 ≤ r) (hs : 3 ≤ s)
    (U : Fin r → Fin q) (V : Fin s → Fin q)
    (hU : Function.Injective U) (hV : Function.Injective V) :
    LinearIndependent ℂ (fun i : Fin r ⊕ Fin s =>
      Sum.elim (fun a => u H (U a)) (fun b => v H P (V b)) i) := by
  have hdet : (mixed h H P U V).det ≠ 0 := by
    have hsEq : s = n + 6 - r := by omega
    subst s
    exact hm ⟨r, by omega⟩ U V hr (by change r ≤ n + 3; omega) hU hV
  let f : (Fin (n + 6) → ℂ) →ₗ[ℂ] ((Fin r ⊕ Fin s) → ℂ) :=
    LinearMap.pi (fun j => LinearMap.proj (coordinate h j))
  apply LinearIndependent.of_comp f
  have he : (fun i : Fin r ⊕ Fin s =>
      f (Sum.elim (fun a => u H (U a)) (fun b => v H P (V b)) i)) =
        mixed h H P U V := by
    funext i j
    cases i <;> rfl
  change LinearIndependent ℂ (fun i => f (Sum.elim (fun a => u H (U a)) (fun b => v H P (V b)) i))
  rw [he]
  exact Matrix.linearIndependent_rows_of_det_ne_zero hdet

theorem spanning_of_minors {n q : ℕ} (H : Fin (n + 6) → ℝ) (P : Fin (n + 6) → ℂ)
    (hm : MiddleMinors (q := q) P H) (he : EndpointMinors (q := q) P H)
    (hpure : ∀ I : Fin (n + 6) → Fin q, Function.Injective I →
      LinearIndependent ℂ (fun i => u H (I i)) ∧
      LinearIndependent ℂ (fun i => v H P (I i)))
    (A : Finset (Fin q ⊕ Fin q)) (hA : A.card = n + 7) :
    span ℂ (Set.range (fun i : A => family (q := q) H P i)) = ⊤ := by
  apply extract (by omega) (family (q := q) H P) ?_ ?_ ?_ ?_ ?_ A hA
  · intro U hU
    exact (hpure U hU).1.span_eq_top_of_card_eq_finrank' (by simp)
  · intro V hV
    exact (hpure V hV).2.span_eq_top_of_card_eq_finrank' (by simp)
  · intro b V hV
    exact (Matrix.linearIndependent_rows_of_det_ne_zero (he b V hV).1).span_eq_top_of_card_eq_finrank' (by simp)
  · intro b V hV
    exact (Matrix.linearIndependent_rows_of_det_ne_zero (he b V hV).2).span_eq_top_of_card_eq_finrank' (by simp)
  · intro r s h hr hs U V hU hV
    exact (middle_independent H P hm h hr hs U V hU hV).span_eq_top_of_card_eq_finrank' (by simp [h])

theorem exists_spanning {n q : ℕ} [NeZero q] (hq : 7 ≤ q) (ho : Odd q) (hdq : n + 6 ≤ q)
    (base : Fin (n + 6) → ℂ) (hbase : ∀ j, base j ≠ 0)
    (E : Set ℂ) (hE : E.Finite) :
    ∃ (eta : ℂ) (H : Fin (n + 6) → ℝ), eta ∉ E ∧ (∀ j, 0 < H j) ∧
      (∀ i : Fin q, u H i ≠ 0 ∧ v H (data (q := q) base eta) i ≠ 0) ∧
      (∀ i : Fin q, pair (u H i) (u H (i + 1)) = 0 ∧
        pair (v H (data (q := q) base eta) i)
          (v H (data (q := q) base eta) (i + 1)) = 0) ∧
      ∀ A : Finset (Fin q ⊕ Fin q), A.card = n + 7 →
        span ℂ (Set.range (fun i : A => family (q := q) H (data (q := q) base eta) i)) = ⊤ := by
  obtain ⟨eta, H, heta, hH, hm, he, hn, hpure, hcyc⟩ :=
    P14HighDimensionAllMinors.exists_family hq ho hdq base hbase E hE
  exact ⟨eta, H, heta, hH, hn, hcyc, spanning_of_minors H _ hm he hpure⟩

end P14HighDimensionSpanning
end
end

section

/-! The same high-dimensional physical rows now have their required cross
edges. Only orthogonality on the prescribed interval is asserted. -/

noncomputable section
namespace P14HighDimensionCrossSupport
open P14HighDimensionPhase P14HighDimensionSingletonLimits
open P14ReciprocalFourierRows P14TailRootPolynomial
open scoped BigOperators

def base {n q : ℕ} (j : Fin (n + 6)) : ℂ :=
  (tail (node q) q (n + 6)).eval (node q ^ j.val)

theorem base_ne_zero {n q : ℕ} (hq : 7 ≤ q) (ho : Odd q) (hdq : n + 6 ≤ q)
    (j : Fin (n + 6)) : base (q := q) j ≠ 0 :=
  retained_ne_zero hdq (node q) (primitive hq ho) j

theorem exact_cross {n q : ℕ} (hq : 7 ≤ q) (ho : Odd q) (hdq : n + 6 ≤ q)
    (H : Fin (n + 6) → ℝ) (hH : ∀ j, 0 < H j) (eta : ℂ) (a b : Fin q) :
    pair (u H a) (v H (data (q := q) (base (q := q)) eta) b) =
      (q : ℂ) * (extended (node q) q (n + 6) eta).coeff (a - b).val := by
  rw [cross H hH]
  simp only [data, star_star]
  have hev (j : Fin (n + 6)) :
      base (q := q) j * (node q ^ j.val - eta) =
        (extended (node q) q (n + 6) eta).eval (node q ^ j.val) :=
    (eval_extended _ _ _ _ _).symm
  simp_rw [hev]
  rw [sum_truncate hdq
    (fun k => (star (node q ^ (a.val * k)) * node q ^ (b.val * k)) *
      (extended (node q) q (n + 6) eta).eval (node q ^ k))
    (fun k hk hkq => by rw [extended_removed_zero _ _ hk hkq, mul_zero])]
  apply P14PrimitiveFourierExtraction.extract (by omega) _ (primitive hq ho)
  have hdeg := degree_extended (node q) q (n + 6) eta
  omega

theorem opposite_difference {q : ℕ} [NeZero q] (a b : Fin q)
    (h : 0 < (b - a).val) : (a - b).val = q - (b - a).val := by
  have hn : b - a ≠ 0 := by intro he; simp [he] at h
  rw [show a - b = -(b - a) by abel, Fin.val_neg, if_neg hn]

theorem cross_zero {n q : ℕ} [NeZero q] (hq : 7 ≤ q) (ho : Odd q) (hdq : n + 6 ≤ q)
    (H : Fin (n + 6) → ℝ) (hH : ∀ j, 0 < H j) (eta : ℂ) (a b : Fin q)
    (hlo : 1 ≤ (b - a).val) (hhi : (b - a).val ≤ n + 4) :
    pair (u H a) (v H (data (q := q) (base (q := q)) eta) b) = 0 := by
  rw [exact_cross hq ho hdq H hH]
  have hd := degree_extended (node q) q (n + 6) eta
  have hf := opposite_difference a b (by omega)
  rw [Polynomial.coeff_eq_zero_of_natDegree_lt (by omega), mul_zero]

theorem exists_rows {n q : ℕ} [NeZero q] (hq : 7 ≤ q) (ho : Odd q) (hdq : n + 6 ≤ q)
    (E : Set ℂ) (hE : E.Finite) :
    ∃ (eta : ℂ) (H : Fin (n + 6) → ℝ), eta ∉ E ∧ (∀ j, 0 < H j) ∧
      (∀ i : Fin q, u H i ≠ 0 ∧ v H (data (q := q) (base (q := q)) eta) i ≠ 0) ∧
      (∀ i : Fin q, pair (u H i) (u H (i + 1)) = 0 ∧
        pair (v H (data (q := q) (base (q := q)) eta) i)
          (v H (data (q := q) (base (q := q)) eta) (i + 1)) = 0) ∧
      (∀ A : Finset (Fin q ⊕ Fin q), A.card = n + 7 →
        Submodule.span ℂ (Set.range (fun i : A =>
          P14HighDimensionSpanning.family (q := q) H (data (q := q) (base (q := q)) eta) i)) = ⊤) ∧
      ∀ a b : Fin q, 1 ≤ (b - a).val → (b - a).val ≤ n + 4 →
        pair (u H a) (v H (data (q := q) (base (q := q)) eta) b) = 0 := by
  obtain ⟨eta, H, he, hH, hn, hc, hs⟩ :=
    P14HighDimensionSpanning.exists_spanning hq ho hdq (base (q := q)) (base_ne_zero hq ho hdq) E hE
  exact ⟨eta, H, he, hH, hn, hc, hs, cross_zero hq ho hdq H hH eta⟩

end P14HighDimensionCrossSupport
end
end

section

/-! One actual higher-dimensional local factor has the cyclic layer edges,
the prescribed cross interval, and the common every-d+1 spanning property. -/

noncomputable section
namespace P14HighDimensionLocalFactor
open P14ReciprocalFourierRows P14HighDimensionCrossSupport
open P14HighDimensionSingletonLimits P14HighDimensionSpanning
open scoped BigOperators

def Prescribed {q : ℕ} [NeZero q] (d : ℕ) :
    (Fin q ⊕ Fin q) → (Fin q ⊕ Fin q) → Prop
  | .inl a, .inl b => b = a + 1 ∨ a = b + 1
  | .inr a, .inr b => b = a + 1 ∨ a = b + 1
  | .inl a, .inr b => 1 ≤ (b - a).val ∧ (b - a).val ≤ d - 2
  | .inr a, .inl b => 1 ≤ (a - b).val ∧ (a - b).val ≤ d - 2

theorem reverse_zero {d : ℕ} (x y : Fin d → ℂ) (h : pair x y = 0) : pair y x = 0 := by
  have he : pair y x = star (pair x y) := by
    simp only [pair, star_sum, star_mul, star_star]
  rw [he, h, star_zero]

theorem symmetric {q : ℕ} [NeZero q] (d : ℕ) :
    Symmetric (Prescribed (q := q) d) := by
  intro x y h
  cases x <;> cases y <;> simp only [Prescribed] at *
  · exact h.elim Or.inr Or.inl
  · exact h
  · exact h
  · exact h.elim Or.inr Or.inl

theorem exists_factor {n q : ℕ} [NeZero q] (hq : 7 ≤ q) (ho : Odd q) (hdq : n + 6 ≤ q) :
    P14ComplexLocalCover.HasLocalFactor (Fin q ⊕ Fin q) (n + 6) (n + 6)
      (Prescribed (n + 6)) := by
  obtain ⟨eta, H, _, hH, hn, hc, hs, hx⟩ := exists_rows hq ho hdq ∅ Set.finite_empty
  let P : Fin (n + 6) → ℂ := data (q := q) (base (q := q)) eta
  refine ⟨family (q := q) H P, ?_, hs, ?_⟩
  · rintro (i | i)
    · exact (hn i).1
    · exact (hn i).2
  · intro x y h
    cases x with
    | inl a =>
      cases y with
      | inl b =>
        change pair (u H a) (u H b) = 0
        rcases h with rfl | rfl
        · exact (hc a).1
        · exact reverse_zero _ _ (hc b).1
      | inr b =>
        exact hx a b h.1 (by have hh := h.2; omega)
    | inr a =>
      cases y with
      | inl b =>
        exact reverse_zero _ _ (hx b a h.1 (by have hh := h.2; omega))
      | inr b =>
        change pair (v H P a) (v H P b) = 0
        rcases h with rfl | rfl
        · exact (hc a).2
        · exact reverse_zero _ _ (hc b).2

end P14HighDimensionLocalFactor
end
end

section

/-! A complete qubit matching complement when the unused cross offsets
are numerous enough to pair with the unused layer steps. -/

noncomputable section
namespace P14HighDimensionQubitCover
open P14HighDimensionLocalFactor P14PrismRemainderCover

def layerCount (q : ℕ) : ℕ := (q - 3) / 2

theorem layer_count {q : ℕ} (hq : 7 ≤ q) (ho : Odd q) :
    2 * layerCount q + 3 = q := by
  have h := P14FiveRootGrid.half_spec ho
  dsimp [layerCount, P14FiveRootGrid.half] at *
  omega

def step {q : ℕ} (hq : 7 ≤ q) (i : Fin (layerCount q)) : Fin q :=
  ⟨i.val + 2, by have hi := i.isLt; dsimp [layerCount] at hi; omega⟩

def offset {q d : ℕ} [NeZero q] (hd : 2 ≤ d) (hdq : d ≤ q)
    (j : Fin (q - d + 2)) : Fin q :=
  if h : j.val = 0 then 0 else ⟨d + j.val - 2, by have hj := j.isLt; omega⟩

theorem internal_cover {q : ℕ} [NeZero q] (hq : 7 ≤ q) (ho : Odd q)
    (x y : Fin q) (hxy : x ≠ y) :
    (y = x + 1 ∨ x = y + 1) ∨ ∃ i : Fin (layerCount q),
      y = x + step hq i ∨ x = y + step hq i := by
  have hd : y - x ≠ 0 := sub_ne_zero.mpr hxy.symm
  have he : x - y ≠ 0 := sub_ne_zero.mpr hxy
  have hp : 0 < (y - x).val := Nat.pos_of_ne_zero (Fin.val_ne_zero_iff.mpr hd)
  have hr : 0 < (x - y).val := Nat.pos_of_ne_zero (Fin.val_ne_zero_iff.mpr he)
  have hsum : (x - y).val + (y - x).val = q := by
    rw [show x - y = -(y - x) by abel, Fin.val_neg, if_neg hd]
    have hlt := (y - x).isLt
    omega
  have hN := layer_count hq ho
  by_cases h1 : (y - x).val = 1
  · have heq : y - x = 1 := Fin.ext (by simpa only [Fin.val_one', Nat.mod_eq_of_lt (by omega : 1 < q)] using h1)
    exact Or.inl (Or.inl (by rw [← heq, add_sub_cancel]))
  by_cases h2 : (x - y).val = 1
  · have heq : x - y = 1 := Fin.ext (by simpa only [Fin.val_one', Nat.mod_eq_of_lt (by omega : 1 < q)] using h2)
    exact Or.inl (Or.inr (by rw [← heq, add_sub_cancel]))
  by_cases hs : (y - x).val ≤ layerCount q + 1
  · let i : Fin (layerCount q) := ⟨(y - x).val - 2, by omega⟩
    have hi : step hq i = y - x := by apply Fin.ext; change _ - 2 + 2 = _; omega
    exact Or.inr ⟨i, Or.inl (by rw [hi, add_sub_cancel])⟩
  · let i : Fin (layerCount q) := ⟨(x - y).val - 2, by omega⟩
    have hi : step hq i = x - y := by apply Fin.ext; change _ - 2 + 2 = _; omega
    exact Or.inr ⟨i, Or.inr (by rw [hi, add_sub_cancel])⟩

theorem offset_cover {q d : ℕ} [NeZero q] (hd : 2 ≤ d) (hdq : d ≤ q) (k : Fin q) :
    (1 ≤ k.val ∧ k.val ≤ d - 2) ∨ ∃ j, offset hd hdq j = k := by
  by_cases hk : k.val = 0
  · right
    refine ⟨⟨0, by omega⟩, ?_⟩
    simp only [offset]
    exact Fin.ext hk.symm
  by_cases hi : k.val ≤ d - 2
  · exact Or.inl ⟨by omega, hi⟩
  · right
    let j : Fin (q - d + 2) := ⟨k.val + 2 - d, by have h := k.isLt; omega⟩
    refine ⟨j, ?_⟩
    have hj : j.val ≠ 0 := by dsimp [j]; omega
    rw [offset, dif_neg hj]
    apply Fin.ext
    change d + (k.val + 2 - d) - 2 = k.val
    omega

theorem exists_cover {q d : ℕ} [NeZero q] (hq : 7 ≤ q) (ho : Odd q)
    (hd : 6 ≤ d) (hdq : d ≤ q) (hbalance : 2 * d ≤ q + 7) :
    ∃ F : Fin (2 * q - d - 1) → (Fin q ⊕ Fin q) → (Fin q ⊕ Fin q),
      (∀ c, Function.Involutive (F c)) ∧ (∀ c x, F c x ≠ x) ∧
      ∀ x y, x ≠ y → Prescribed d x y ∨ ∃ c, F c x = y := by
  classical
  let a := step hq
  let b := offset (by omega : 2 ≤ d) hdq
  have ha (i : Fin (layerCount q)) : a i ≠ 0 := by
    intro he
    have hv := congrArg Fin.val he
    change i.val + 2 = 0 at hv
    omega
  have hN := layer_count hq ho
  have hNB : layerCount q ≤ q - d + 2 := by omega
  obtain ⟨F, hF, hn, hc⟩ := P14PrismRemainderCover.exists_cover (by omega) ho a b ha hNB
  have hK : 3 * layerCount q + (q - d + 2 - layerCount q) = 2 * q - d - 1 := by omega
  have cover (x y : Fin q ⊕ Fin q) (hxy : x ≠ y) :
      Prescribed d x y ∨ ∃ c, F c x = y := by
    cases x with
    | inl x =>
      cases y with
      | inl y =>
        rcases internal_cover hq ho x y (fun h => hxy (congrArg Sum.inl h)) with h | ⟨i, hi⟩
        · exact Or.inl h
        · exact Or.inr ((hc _ _).mp (Or.inl ⟨i, hi⟩))
      | inr y =>
        rcases offset_cover (by omega : 2 ≤ d) hdq (y - x) with h | ⟨i, hi⟩
        · exact Or.inl h
        · apply Or.inr
          apply (hc _ _).mp
          right
          refine ⟨i, ?_⟩
          change y = x + b i
          change b i = y - x at hi
          rw [hi, add_sub_cancel]
    | inr x =>
      cases y with
      | inl y =>
        rcases offset_cover (by omega : 2 ≤ d) hdq (x - y) with h | ⟨i, hi⟩
        · exact Or.inl h
        · apply Or.inr
          apply (hc _ _).mp
          right
          refine ⟨i, ?_⟩
          change x = y + b i
          change b i = x - y at hi
          rw [hi, add_sub_cancel]
      | inr y =>
        rcases internal_cover hq ho x y (fun h => hxy (congrArg Sum.inr h)) with h | ⟨i, hi⟩
        · exact Or.inl h
        · exact Or.inr ((hc _ _).mp (Or.inl ⟨i, hi⟩))
  let e := finCongr hK.symm
  refine ⟨fun c => F (e c), fun c => hF (e c), fun c => hn (e c), ?_⟩
  intro x y hxy
  rcases cover x y hxy with h | ⟨c, hc⟩
  · exact Or.inl h
  · exact Or.inr ⟨e.symm c, by simpa only [Equiv.apply_symm_apply] using hc⟩

end P14HighDimensionQubitCover
end
end

section

/-! Finite symmetric Cayley boundary minimization and the atom intersection
argument. These are proved directly; no Kneser theorem is assumed. -/

noncomputable section
namespace P14CayleyBoundary
open scoped Pointwise
variable {G : Type*} [AddCommGroup G] [Fintype G] [DecidableEq G]

def Admissible (C X : Finset G) : Prop :=
  X.Nonempty ∧ X + C ≠ Finset.univ

def Fragment (C : Finset G) (k : ℕ) (X : Finset G) : Prop :=
  Admissible C X ∧ (X + C).card = X.card + k

def Minimum (C : Finset G) (k : ℕ) : Prop :=
  ∀ X, Admissible C X → X.card + k ≤ (X + C).card

def Atom (C : Finset G) (k : ℕ) (A : Finset G) : Prop :=
  Fragment C k A ∧ ∀ X, Fragment C k X → A.card ≤ X.card

def shift (a : G) (X : Finset G) : Finset G := X.image (fun x => a + x)

theorem subset_add (C X : Finset G) (h0 : 0 ∈ C) : X ⊆ X + C := by
  intro x hx
  exact Finset.mem_add.mpr ⟨x, hx, 0, h0, by simp⟩

theorem exists_atom (C : Finset G) (h0 : 0 ∈ C) (hp : C ≠ Finset.univ) :
    ∃ k A, Minimum C k ∧ Atom C k A := by
  classical
  have hz : ({0} : Finset G) + C = C := by
    ext x
    simp [Finset.mem_add]
  have hex : ∃ k : ℕ, ∃ X : Finset G, Fragment C k X := by
    refine ⟨C.card - 1, {0}, ?_⟩
    have hc : 1 ≤ C.card := Finset.one_le_card.mpr ⟨0, h0⟩
    refine ⟨⟨by simp, by simpa only [hz] using hp⟩, ?_⟩
    rw [hz, Finset.card_singleton]
    omega
  let k := Nat.find hex
  have hk : ∃ X, Fragment C k X := Nat.find_spec hex
  have hm : Minimum C k := by
    intro X hX
    have hs := Finset.card_le_card (subset_add C X h0)
    have hf : Fragment C ((X + C).card - X.card) X :=
      ⟨hX, by omega⟩
    have hle : k ≤ (X + C).card - X.card := Nat.find_min' hex ⟨X, hf⟩
    omega
  have hea : ∃ n : ℕ, ∃ A : Finset G, Fragment C k A ∧ A.card = n := by
    obtain ⟨A, hA⟩ := hk
    exact ⟨A.card, A, hA, rfl⟩
  obtain ⟨A, hA, hc⟩ := Nat.find_spec hea
  refine ⟨k, A, hm, hA, ?_⟩
  intro X hX
  rw [hc]
  exact Nat.find_min' hea ⟨X, hX, rfl⟩

theorem shift_card (a : G) (X : Finset G) : (shift a X).card = X.card :=
  Finset.card_image_of_injective _ (fun _ _ h => add_left_cancel h)

theorem shift_add (a : G) (X C : Finset G) : shift a X + C = shift a (X + C) := by
  ext z
  constructor
  · intro hz
    obtain ⟨u, hu, c, hc, rfl⟩ := Finset.mem_add.mp hz
    obtain ⟨x, hx, rfl⟩ := Finset.mem_image.mp hu
    exact Finset.mem_image.mpr ⟨x + c, Finset.mem_add.mpr ⟨x, hx, c, hc, rfl⟩,
      by abel⟩
  · intro hz
    obtain ⟨u, hu, rfl⟩ := Finset.mem_image.mp hz
    obtain ⟨x, hx, c, hc, rfl⟩ := Finset.mem_add.mp hu
    exact Finset.mem_add.mpr ⟨a + x, Finset.mem_image.mpr ⟨x, hx, rfl⟩, c, hc,
      by abel⟩

theorem shift_fragment (C : Finset G) {k : ℕ} {A : Finset G}
    (hA : Fragment C k A) (a : G) : Fragment C k (shift a A) := by
  refine ⟨⟨hA.1.1.image _, ?_⟩, ?_⟩
  · intro he
    apply hA.1.2
    apply Finset.eq_univ_of_card
    have hc := congrArg Finset.card he
    simpa only [shift_add, shift_card, Finset.card_univ] using hc
  · rw [shift_add, shift_card, shift_card]
    exact hA.2

theorem shift_atom (C : Finset G) {k : ℕ} {A : Finset G}
    (hA : Atom C k A) (a : G) : Atom C k (shift a A) := by
  refine ⟨shift_fragment C hA.1 a, ?_⟩
  intro X hX
  rw [shift_card]
  exact hA.2 X hX

theorem add_mono_left (C : Finset G) {A B : Finset G} (h : A ⊆ B) :
    A + C ⊆ B + C := by
  intro z hz
  obtain ⟨a, ha, c, hc, rfl⟩ := Finset.mem_add.mp hz
  exact Finset.mem_add.mpr ⟨a, h ha, c, hc, rfl⟩

theorem submodular (C A B : Finset G) :
    ((A ∩ B) + C).card + ((A ∪ B) + C).card ≤
      (A + C).card + (B + C).card := by
  have hi : (A ∩ B) + C ⊆ (A + C) ∩ (B + C) := by
    intro z hz
    exact Finset.mem_inter.mpr ⟨add_mono_left C Finset.inter_subset_left hz,
      add_mono_left C Finset.inter_subset_right hz⟩
  have hu : (A ∪ B) + C = (A + C) ∪ (B + C) := by
    ext z
    simp only [Finset.mem_add, Finset.mem_union]
    constructor
    · rintro ⟨a, ha | ha, c, hc, he⟩
      · exact Or.inl ⟨a, ha, c, hc, he⟩
      · exact Or.inr ⟨a, ha, c, hc, he⟩
    · rintro (⟨a, ha, c, hc, he⟩ | ⟨a, ha, c, hc, he⟩)
      · exact ⟨a, Or.inl ha, c, hc, he⟩
      · exact ⟨a, Or.inr ha, c, hc, he⟩
  rw [hu]
  have hcard := Finset.card_le_card hi
  have he := Finset.card_union_add_card_inter (A + C) (B + C)
  omega

theorem exterior_fragment (C : Finset G) (hs : ∀ c ∈ C, -c ∈ C)
    {k : ℕ} (hm : Minimum C k) {A : Finset G} (hA : Fragment C k A) :
    Fragment C k (Finset.univ \ (A + C)) := by
  let E := Finset.univ \ (A + C)
  have he : E.Nonempty := by
    by_contra hn
    apply hA.1.2
    apply Finset.eq_univ_iff_forall.mpr
    intro x
    by_contra hx
    exact hn ⟨x, Finset.mem_sdiff.mpr ⟨Finset.mem_univ x, hx⟩⟩
  have hd : Disjoint (E + C) A := by
    apply Finset.disjoint_left.mpr
    intro a ha haA
    obtain ⟨e, he, c, hc, hec⟩ := Finset.mem_add.mp ha
    apply (Finset.mem_sdiff.mp he).2
    exact Finset.mem_add.mpr ⟨a, haA, -c, hs c hc, by rw [← hec]; abel⟩
  have hp : E + C ≠ Finset.univ := by
    intro h
    obtain ⟨a, ha⟩ := hA.1.1
    exact Finset.disjoint_left.mp hd (by rw [h]; exact Finset.mem_univ a) ha
  have hlow := hm E ⟨he, hp⟩
  have hu : (E + C).card + A.card ≤ Fintype.card G := by
    rw [← Finset.card_union_of_disjoint hd]
    exact Finset.card_le_univ _
  have hec : E.card + (A + C).card = Fintype.card G := by
    dsimp [E]
    rw [Finset.card_sdiff_of_subset (Finset.subset_univ _), Finset.card_univ]
    have hc := Finset.card_le_univ (A + C)
    omega
  refine ⟨⟨he, hp⟩, ?_⟩
  have hcard := hA.2
  change (E + C).card = E.card + k
  omega

theorem atom_size_bound (C : Finset G) (hs : ∀ c ∈ C, -c ∈ C)
    {k : ℕ} (hm : Minimum C k) {A : Finset G} (hA : Atom C k A) :
    2 * A.card + k ≤ Fintype.card G := by
  have he := hA.2 _ (exterior_fragment C hs hm hA.1)
  have hc : (Finset.univ \ (A + C)).card + (A + C).card = Fintype.card G := by
    rw [Finset.card_sdiff_of_subset (Finset.subset_univ _), Finset.card_univ]
    have h := Finset.card_le_univ (A + C)
    omega
  have ha := hA.1.2
  omega

theorem intersecting_atoms_equal (C : Finset G) (hs : ∀ c ∈ C, -c ∈ C)
    {k : ℕ} (hm : Minimum C k) {A B : Finset G}
    (hA : Atom C k A) (hB : Atom C k B) (hi : (A ∩ B).Nonempty) : A = B := by
  have hab : A.card = B.card := Nat.le_antisymm (hA.2 B hB.1) (hB.2 A hA.1)
  have hn := atom_size_bound C hs hm hA
  have hsub := submodular C A B
  have hpi : (A ∩ B) + C ≠ Finset.univ := by
    intro he
    apply hA.1.1.2
    apply Finset.eq_univ_iff_forall.mpr
    intro x
    apply add_mono_left C Finset.inter_subset_left
    rw [he]
    exact Finset.mem_univ x
  have hmi := hm (A ∩ B) ⟨hi, hpi⟩
  have hci : 1 ≤ (A ∩ B).card := Finset.one_le_card.mpr hi
  have hca := hA.1.2
  have hcb := hB.1.2
  have hpu : (A ∪ B) + C ≠ Finset.univ := by
    intro he
    rw [he, Finset.card_univ] at hsub
    omega
  have hmu := hm (A ∪ B) ⟨hA.1.1.1.mono Finset.subset_union_left, hpu⟩
  have hcu := Finset.card_union_add_card_inter A B
  have hfi : Fragment C k (A ∩ B) := ⟨⟨hi, hpi⟩, by omega⟩
  have hmin := hA.2 (A ∩ B) hfi
  have he : A ∩ B = A := Finset.eq_of_subset_of_card_le Finset.inter_subset_left hmin
  apply Finset.eq_of_subset_of_card_le
  · rw [← he]
    exact Finset.inter_subset_right
  · omega

end P14CayleyBoundary

end
end

section

/-! A subgroup attains the minimum boundary for every proper symmetric
connection set containing zero in a finite abelian group. This is the
isoperimetric statement needed for the cyclic-annulus bound. -/

noncomputable section
namespace P14SymmetricCayleyAtom
open P14CayleyBoundary
open scoped Pointwise
variable {G : Type*} [AddCommGroup G] [Fintype G] [DecidableEq G]

theorem exists_zero_atom (C : Finset G) (h0 : 0 ∈ C) (hp : C ≠ Finset.univ) :
    ∃ k A, Minimum C k ∧ Atom C k A ∧ (0 : G) ∈ A := by
  obtain ⟨k, A, hm, hA⟩ := exists_atom C h0 hp
  obtain ⟨a, ha⟩ := hA.1.1.1
  refine ⟨k, shift (-a) A, hm, shift_atom C hA (-a), ?_⟩
  exact Finset.mem_image.mpr ⟨a, ha, neg_add_cancel a⟩

theorem atom_shift_eq (C : Finset G) (hs : ∀ c ∈ C, -c ∈ C)
    {k : ℕ} (hm : Minimum C k) {A : Finset G} (hA : Atom C k A)
    (h0 : (0 : G) ∈ A) {a : G} (ha : a ∈ A) : shift a A = A := by
  apply (intersecting_atoms_equal C hs hm hA (shift_atom C hA a) _).symm
  refine ⟨a, Finset.mem_inter.mpr ⟨ha, ?_⟩⟩
  exact Finset.mem_image.mpr ⟨0, h0, add_zero a⟩

theorem atom_subgroup (C : Finset G) (hs : ∀ c ∈ C, -c ∈ C)
    {k : ℕ} (hm : Minimum C k) {A : Finset G} (hA : Atom C k A)
    (h0 : (0 : G) ∈ A) : ∃ H : AddSubgroup G, ∀ x, x ∈ H ↔ x ∈ A := by
  have hadd : ∀ a ∈ A, ∀ b ∈ A, a + b ∈ A := by
    intro a ha b hb
    rw [← atom_shift_eq C hs hm hA h0 ha]
    exact Finset.mem_image.mpr ⟨b, hb, rfl⟩
  have hneg : ∀ a ∈ A, -a ∈ A := by
    intro a ha
    have hz : (0 : G) ∈ shift a A := by rwa [atom_shift_eq C hs hm hA h0 ha]
    obtain ⟨b, hb, he⟩ := Finset.mem_image.mp hz
    have he' : b = -a := by
      apply add_left_cancel (a := a)
      simpa using he
    rwa [← he']
  let H : AddSubgroup G := {
    carrier := {x | x ∈ A}
    zero_mem' := h0
    add_mem' := fun ha hb => hadd _ ha _ hb
    neg_mem' := fun ha => hneg _ ha }
  exact ⟨H, fun _ => Iff.rfl⟩

theorem exists_minimizing_subgroup (C : Finset G) (h0 : 0 ∈ C)
    (hs : ∀ c ∈ C, -c ∈ C) (hp : C ≠ Finset.univ) :
    ∃ H : AddSubgroup G, ∃ A : Finset G,
      (∀ x, x ∈ H ↔ x ∈ A) ∧ A.Nonempty ∧ A + C ≠ Finset.univ ∧
      ∀ X, Admissible C X → (A + C).card + X.card ≤ (X + C).card + A.card := by
  obtain ⟨k, A, hm, hA, ha0⟩ := exists_zero_atom C h0 hp
  obtain ⟨H, hH⟩ := atom_subgroup C hs hm hA ha0
  refine ⟨H, A, hH, hA.1.1.1, hA.1.1.2, ?_⟩
  intro X hX
  have hl := hm X hX
  have he := hA.1.2
  omega

end P14SymmetricCayleyAtom

end
end

section

/-! Consecutive cosets of a cyclic subgroup remain disjoint until they
cover the whole group. The proof uses division with remainder, avoiding
any unproved subgroup classification or additive-combinatorics theorem. -/

noncomputable section
namespace P14CyclicSubgroupInterval
open scoped Pointwise
variable {q : ℕ} [NeZero q]

theorem full_of_small_period (H : AddSubgroup (ZMod q)) (A C : Finset (ZMod q))
    (hA : ∀ x, x ∈ H ↔ x ∈ A) (a : ZMod q) (L : ℕ)
    (hI : ∀ t : ℕ, t < L → a + (t : ZMod q) ∈ C)
    (r : ℕ) (hr : 0 < r) (hrL : r ≤ L) (hrH : (r : ZMod q) ∈ H) :
    A + C = Finset.univ := by
  apply Finset.eq_univ_iff_forall.mpr
  intro z
  let v := (z - a).val
  have hm : v % r < L := lt_of_lt_of_le (Nat.mod_lt v hr) hrL
  have hh : ((r : ZMod q) * (v / r : ℕ)) ∈ H := by
    simpa only [nsmul_eq_mul, mul_comm] using H.nsmul_mem hrH (v / r)
  refine Finset.mem_add.mpr ⟨(r : ZMod q) * (v / r : ℕ), (hA _).mp hh,
    a + (v % r : ℕ), hI _ hm, ?_⟩
  calc
    (r : ZMod q) * (v / r : ℕ) + (a + (v % r : ℕ)) =
        a + ((v % r + r * (v / r) : ℕ) : ZMod q) := by
          simp only [Nat.cast_add, Nat.cast_mul]
          abel
    _ = a + (v : ZMod q) := by rw [Nat.mod_add_div]
    _ = z := by dsimp [v]; rw [ZMod.natCast_zmod_val]; abel

theorem different_cosets (H : AddSubgroup (ZMod q)) (A C : Finset (ZMod q))
    (hA : ∀ x, x ∈ H ↔ x ∈ A) (a : ZMod q) (L : ℕ)
    (hI : ∀ t : ℕ, t < L → a + (t : ZMod q) ∈ C)
    (hp : A + C ≠ Finset.univ) {i j : ℕ} (hij : i < j) (hj : j < L)
    {x y : ZMod q} (hx : x ∈ H) (hy : y ∈ H) :
    x + a + (i : ZMod q) ≠ y + a + (j : ZMod q) := by
  intro he
  have he' : x + (i : ZMod q) = y + (j : ZMod q) := by
    have ht : (x + (i : ZMod q)) + a = (y + (j : ZMod q)) + a := by
      simpa only [add_assoc, add_comm, add_left_comm] using he
    exact add_right_cancel ht
  have hd : ((j - i : ℕ) : ZMod q) = x - y := by
    rw [Nat.cast_sub (by omega)]
    calc
      (j : ZMod q) - i = (y + j) - y - i := by abel
      _ = (x + i) - y - i := by rw [← he']
      _ = x - y := by abel
  apply hp
  apply full_of_small_period H A C hA a L hI (j - i) (by omega) (by omega)
  rw [hd]
  exact H.sub_mem hx hy

theorem cardinal_lower_bound (H : AddSubgroup (ZMod q)) (A C : Finset (ZMod q))
    (hA : ∀ x, x ∈ H ↔ x ∈ A) (a : ZMod q) (L : ℕ)
    (hI : ∀ t : ℕ, t < L → a + (t : ZMod q) ∈ C)
    (hp : A + C ≠ Finset.univ) : L * A.card ≤ (A + C).card := by
  classical
  let f : Fin L × A → ZMod q := fun v => v.2.val + a + (v.1.val : ZMod q)
  have hf : Function.Injective f := by
    rintro ⟨i, x⟩ ⟨j, y⟩ he
    have hij : i = j := by
      apply Fin.ext
      by_contra hne
      rcases lt_or_gt_of_ne hne with hlt | hlt
      · exact different_cosets H A C hA a L hI hp hlt j.isLt
          ((hA _).mpr x.property) ((hA _).mpr y.property) he
      · exact different_cosets H A C hA a L hI hp hlt i.isLt
          ((hA _).mpr y.property) ((hA _).mpr x.property) he.symm
    subst j
    have hxy : x = y := by
      apply Subtype.ext
      exact add_right_cancel (add_right_cancel he)
    exact Prod.ext rfl hxy
  let F := (Finset.univ : Finset (Fin L × A)).image f
  have hs : F ⊆ A + C := by
    intro z hz
    obtain ⟨⟨i, x⟩, _, rfl⟩ := Finset.mem_image.mp hz
    exact Finset.mem_add.mpr ⟨x.val, x.property, a + (i.val : ZMod q),
      hI i.val i.isLt, by dsimp [f]; abel⟩
  have hc : F.card = L * A.card := by
    dsimp [F]
    rw [Finset.card_image_of_injective _ hf]
    simp
  rw [← hc]
  exact Finset.card_le_card hs

theorem odd_subgroup_size (hq : Odd q) (H : AddSubgroup (ZMod q)) (A : Finset (ZMod q))
    (hA : ∀ x, x ∈ H ↔ x ∈ A) : A.card = 1 ∨ 3 ≤ A.card := by
  classical
  have h0 : (0 : ZMod q) ∈ A := (hA 0).mp H.zero_mem
  by_cases hall : ∀ x ∈ A, x = 0
  · left
    have he : A = {0} := by
      ext x
      simp only [Finset.mem_singleton]
      exact ⟨hall x, fun h => h ▸ h0⟩
    rw [he, Finset.card_singleton]
  · right
    have hex : ∃ x ∈ A, x ≠ 0 := by
      by_contra hn
      apply hall
      intro x hx
      by_contra hx0
      exact hn ⟨x, hx, hx0⟩
    obtain ⟨x, hx, hx0⟩ := hex
    have hnx : -x ∈ A := (hA _).mp (H.neg_mem ((hA _).mpr hx))
    have hxn : x ≠ -x := by
      intro he
      apply hx0
      apply (ZMod.add_self_eq_zero_iff_eq_zero hq).mp
      calc
        x + x = x + -x := congrArg (fun z => x + z) he
        _ = 0 := add_neg_cancel x
    have hs : ({0, x, -x} : Finset (ZMod q)) ⊆ A := by
      intro z hz
      simp only [Finset.mem_insert, Finset.mem_singleton] at hz
      rcases hz with rfl | rfl | rfl
      · exact h0
      · exact hx
      · exact hnx
    have hc : ({0, x, -x} : Finset (ZMod q)).card = 3 := by
      simp [hx0, Ne.symm hx0, hxn, Ne.symm hxn]
    rw [← hc]
    exact Finset.card_le_card hs

end P14CyclicSubgroupInterval

end
end

section

/-! A symmetric connection set in an odd cyclic group has the required
expansion when its cardinality and a contained interval meet two explicit
lower bounds. The minimizing subgroup and its coset count are constructed
by the imported checked results. -/

namespace P14OddCyclicIntervalGrowth
open P14CayleyBoundary
open scoped Pointwise
variable {q : ℕ} [NeZero q]

theorem growth (hq : Odd q) (C : Finset (ZMod q)) (h0 : 0 ∈ C)
    (hs : ∀ c ∈ C, -c ∈ C) (hp : C ≠ Finset.univ)
    (a : ZMod q) (L R : ℕ) (hI : ∀ t : ℕ, t < L → a + (t : ZMod q) ∈ C)
    (hR : R ≤ C.card) (hL : R + 1 ≤ 2 * L)
    (X : Finset (ZMod q)) (hX : Admissible C X) :
    X.card + R ≤ (X + C).card + 1 := by
  classical
  obtain ⟨H, A, hA, _, hpA, hmin⟩ :=
    P14SymmetricCayleyAtom.exists_minimizing_subgroup C h0 hs hp
  have hm := hmin X hX
  rcases P14CyclicSubgroupInterval.odd_subgroup_size hq H A hA with hc | hc
  · obtain ⟨a0, he⟩ := Finset.card_eq_one.mp hc
    have hz : (A + C).card = C.card := by
      rw [he, Finset.card_singleton_add]
    rw [hz, hc] at hm
    omega
  · have hl := P14CyclicSubgroupInterval.cardinal_lower_bound H A C hA a L hI hpA
    have hLp : 1 ≤ L := by omega
    have hmul := Nat.mul_le_mul_right (L - 1) hc
    have he : L - 1 + 1 = L := Nat.sub_add_cancel hLp
    have hnum : A.card + R ≤ L * A.card + 1 := by nlinarith
    omega

theorem disjoint_bound (hq : Odd q) (C : Finset (ZMod q)) (h0 : 0 ∈ C)
    (hs : ∀ c ∈ C, -c ∈ C) (hp : C ≠ Finset.univ)
    (a : ZMod q) (L R : ℕ) (hI : ∀ t : ℕ, t < L → a + (t : ZMod q) ∈ C)
    (hR : R ≤ C.card) (hL : R + 1 ≤ 2 * L)
    (X Y : Finset (ZMod q)) (hX : X.Nonempty) (hY : Y.Nonempty)
    (hd : Disjoint (X + C) Y) : X.card + Y.card + R ≤ q + 1 := by
  have hpX : X + C ≠ Finset.univ := by
    intro he
    obtain ⟨y, hy⟩ := hY
    exact Finset.disjoint_left.mp hd (by rw [he]; exact Finset.mem_univ y) hy
  have hg := growth hq C h0 hs hp a L R hI hR hL X ⟨hX, hpX⟩
  have hu : (X + C).card + Y.card ≤ q := by
    rw [← Finset.card_union_of_disjoint hd]
    have h := Finset.card_le_univ ((X + C) ∪ Y)
    simpa using h
  omega

end P14OddCyclicIntervalGrowth

end

section

/-! The unrestricted biclique bound for actual symmetric cyclic annuli in
odd order. All complement intervals and cardinal estimates are discharged;
the proof does not assume Kneser's theorem or the desired bound. -/

noncomputable section
namespace P14OddCyclicAnnulus
open scoped Pointwise
variable {q : ℕ} [NeZero q]

def positive (a l : ℕ) : Finset (ZMod q) :=
  (Finset.range l).image (fun t : ℕ => ((a + t : ℕ) : ZMod q))

def annulus (a l : ℕ) : Finset (ZMod q) :=
  positive a l ∪ (positive a l).image (fun x => -x)

theorem mem_iff (a l : ℕ) (x : ZMod q) :
    x ∈ annulus a l ↔ ∃ r : ℕ, a ≤ r ∧ r < a + l ∧
      (x = (r : ZMod q) ∨ x = -(r : ZMod q)) := by
  constructor
  · intro hx
    rcases Finset.mem_union.mp hx with hx | hx
    · obtain ⟨t, ht, he⟩ := Finset.mem_image.mp hx
      have ht' := Finset.mem_range.mp ht
      exact ⟨a + t, by omega, by omega, Or.inl he.symm⟩
    · obtain ⟨y, hy, rfl⟩ := Finset.mem_image.mp hx
      obtain ⟨t, ht, he⟩ := Finset.mem_image.mp hy
      have ht' := Finset.mem_range.mp ht
      exact ⟨a + t, by omega, by omega, Or.inr (congrArg (fun z => -z) he).symm⟩
  · rintro ⟨r, har, hrl, he⟩
    have hp : (r : ZMod q) ∈ positive a l := by
      exact Finset.mem_image.mpr ⟨r - a, Finset.mem_range.mpr (by omega), by
        have hr : a + (r - a) = r := by omega
        rw [hr]⟩
    rcases he with rfl | rfl
    · exact Finset.mem_union_left _ hp
    · exact Finset.mem_union_right _ (Finset.mem_image.mpr ⟨_, hp, rfl⟩)

theorem neg_mem (a l : ℕ) {x : ZMod q} (hx : x ∈ annulus a l) :
    -x ∈ annulus a l := by
  obtain ⟨r, har, hrl, he⟩ := (mem_iff a l x).mp hx
  apply (mem_iff a l (-x)).mpr
  refine ⟨r, har, hrl, ?_⟩
  rcases he with rfl | rfl
  · exact Or.inr rfl
  · exact Or.inl (neg_neg _)

theorem cardinal_upper (a l : ℕ) : (annulus (q := q) a l).card ≤ 2 * l := by
  have hp : (positive (q := q) a l).card ≤ l := by
    have h := Finset.card_image_le (s := Finset.range l)
      (f := fun t : ℕ => ((a + t : ℕ) : ZMod q))
    simpa only [positive, Finset.card_range] using h
  have hn := Finset.card_image_le (s := positive (q := q) a l) (f := fun x => -x)
  have hu := Finset.card_union_le (positive (q := q) a l)
    ((positive (q := q) a l).image (fun x => -x))
  change (positive a l ∪ (positive a l).image (fun x => -x)).card ≤ 2 * l
  omega

theorem cast_ne_zero {r : ℕ} (hr : 0 < r) (hrq : r < q) : (r : ZMod q) ≠ 0 := by
  intro he
  have hv := congrArg ZMod.val he
  simp only [ZMod.val_natCast_of_lt hrq, ZMod.val_zero] at hv
  omega

theorem zero_not_mem (a l : ℕ) (ha : 1 ≤ a) (hl : 1 ≤ l)
    (hq : 2 * (a + l) ≤ q + 1) : (0 : ZMod q) ∉ annulus a l := by
  intro hx
  obtain ⟨r, har, hrl, he⟩ := (mem_iff a l 0).mp hx
  have hr : 0 < r := by omega
  have hrq : r < q := by omega
  rcases he with he | he
  · exact cast_ne_zero hr hrq he.symm
  · have hz : (r : ZMod q) = 0 := by simpa using congrArg (fun z => -z) he.symm
    exact cast_ne_zero hr hrq hz

theorem middle_avoids (a l : ℕ) (ha : 1 ≤ a) (hl : 1 ≤ l)
    (hq : 2 * (a + l) ≤ q + 1) {t : ℕ} (ht : t < q + 1 - 2 * (a + l)) :
    ((a + l : ℕ) : ZMod q) + (t : ZMod q) ∉ annulus a l := by
  intro hx
  obtain ⟨r, har, hrl, he⟩ := (mem_iff a l _).mp hx
  have hrq : r < q := by omega
  have hxt : a + l + t < q := by omega
  rcases he with he | he
  · have hv := congrArg ZMod.val he
    rw [← Nat.cast_add, ZMod.val_natCast_of_lt hxt, ZMod.val_natCast_of_lt hrq] at hv
    omega
  · have hz : ((a + l + t + r : ℕ) : ZMod q) = 0 := by
      rw [Nat.cast_add, Nat.cast_add, he]
      simp
    exact cast_ne_zero (by omega) (by omega) hz

theorem outside_avoids (a l : ℕ) (ha : 1 ≤ a) (hl : 1 ≤ l)
    (hq : 2 * (a + l) ≤ q + 1) {t : ℕ} (ht : t < 2 * a - 1) :
    -((a - 1 : ℕ) : ZMod q) + (t : ZMod q) ∉ annulus a l := by
  intro hx
  obtain ⟨r, har, hrl, he⟩ := (mem_iff a l _).mp hx
  rcases he with he | he
  · have hz : (t : ZMod q) = ((a - 1 + r : ℕ) : ZMod q) := by
      calc
        (t : ZMod q) = (-((a - 1 : ℕ) : ZMod q) + t) + (a - 1 : ℕ) := by abel
        _ = (r : ZMod q) + (a - 1 : ℕ) := by rw [he]
        _ = ((a - 1 + r : ℕ) : ZMod q) := by rw [Nat.cast_add]; abel
    have hv := congrArg ZMod.val hz
    rw [ZMod.val_natCast_of_lt (by omega), ZMod.val_natCast_of_lt (by omega)] at hv
    omega
  · have hsub : a - 1 ≤ t + r := by omega
    have hz : ((t + r - (a - 1) : ℕ) : ZMod q) = 0 := by
      calc
        ((t + r - (a - 1) : ℕ) : ZMod q) =
            (-((a - 1 : ℕ) : ZMod q) + t) + r := by
          rw [Nat.cast_sub hsub, Nat.cast_add]
          abel
        _ = 0 := by rw [he]; simp
    exact cast_ne_zero (by omega) (by omega) hz

theorem biclique_bound (hq : Odd q) (a l : ℕ) (ha : 1 ≤ a) (hl : 1 ≤ l)
    (hlimit : 2 * (a + l) ≤ q + 1) (X Y : Finset (ZMod q))
    (hX : X.Nonempty) (hY : Y.Nonempty)
    (hpair : ∀ x ∈ X, ∀ y ∈ Y, y - x ∈ annulus a l) :
    X.card + Y.card ≤ 2 * l + 1 := by
  classical
  let C := Finset.univ \ annulus (q := q) a l
  have h0 : (0 : ZMod q) ∈ C := Finset.mem_sdiff.mpr
    ⟨Finset.mem_univ _, zero_not_mem a l ha hl hlimit⟩
  have hs : ∀ c ∈ C, -c ∈ C := by
    intro c hc
    refine Finset.mem_sdiff.mpr ⟨Finset.mem_univ _, ?_⟩
    intro hn
    have hh := neg_mem a l hn
    exact (Finset.mem_sdiff.mp hc).2 (by simpa using hh)
  have hp : C ≠ Finset.univ := by
    intro he
    have hc : (a : ZMod q) ∈ C := by rw [he]; exact Finset.mem_univ _
    apply (Finset.mem_sdiff.mp hc).2
    exact (mem_iff a l _).mpr ⟨a, le_rfl, by omega, Or.inl rfl⟩
  have hR : q - 2 * l ≤ C.card := by
    dsimp [C]
    rw [Finset.card_sdiff_of_subset (Finset.subset_univ _), Finset.card_univ, ZMod.card]
    have hd := cardinal_upper (q := q) a l
    omega
  have hd : Disjoint (X + C) Y := by
    apply Finset.disjoint_left.mpr
    intro y hy hyY
    obtain ⟨x, hx, c, hc, he⟩ := Finset.mem_add.mp hy
    apply (Finset.mem_sdiff.mp hc).2
    have hp := hpair x hx y hyY
    have he' : y - x = c := by rw [← he]; abel
    rwa [he'] at hp
  have hmiddle : ∀ t : ℕ, t < q + 1 - 2 * (a + l) →
      ((a + l : ℕ) : ZMod q) + t ∈ C := by
    intro t ht
    exact Finset.mem_sdiff.mpr ⟨Finset.mem_univ _, middle_avoids a l ha hl hlimit ht⟩
  have houtside : ∀ t : ℕ, t < 2 * a - 1 → -((a - 1 : ℕ) : ZMod q) + t ∈ C := by
    intro t ht
    exact Finset.mem_sdiff.mpr ⟨Finset.mem_univ _, outside_avoids a l ha hl hlimit ht⟩
  obtain ⟨v, hv⟩ := hq
  by_cases hcmp : 2 * a - 1 ≤ q + 1 - 2 * (a + l)
  · have hlen : q - 2 * l + 1 ≤ 2 * (q + 1 - 2 * (a + l)) := by omega
    have hb := P14OddCyclicIntervalGrowth.disjoint_bound ⟨v, hv⟩ C h0 hs hp
      ((a + l : ℕ) : ZMod q) (q + 1 - 2 * (a + l)) (q - 2 * l)
      hmiddle hR hlen X Y hX hY hd
    omega
  · have hlen : q - 2 * l + 1 ≤ 2 * (2 * a - 1) := by omega
    have hb := P14OddCyclicIntervalGrowth.disjoint_bound ⟨v, hv⟩ C h0 hs hp
      (-((a - 1 : ℕ) : ZMod q)) (2 * a - 1) (q - 2 * l)
      houtside hR hlen X Y hX hY hd
    omega

end P14OddCyclicAnnulus

end
end

section

/-! An elementary cyclic-interval biclique bound. Successor expansion of
a nonempty proper set gains a point at every step. Expanding through the
complement of the permitted difference interval stays disjoint from the
other side. No additive-combinatorics structure theorem is assumed. -/

noncomputable section
namespace P14CyclicIntervalBiclique
variable {q : ℕ} [NeZero q]

def step (A : Finset (ZMod q)) : Finset (ZMod q) :=
  A ∪ A.image (fun x => x + 1)

def expand (A : Finset (ZMod q)) : ℕ → Finset (ZMod q)
  | 0 => A
  | k + 1 => step (expand A k)

theorem successor_closed (A : Finset (ZMod q)) (ha : A.Nonempty)
    (hc : ∀ a ∈ A, a + 1 ∈ A) : A = Finset.univ := by
  obtain ⟨a, ha⟩ := ha
  have hn (k : ℕ) : a + (k : ZMod q) ∈ A := by
    induction k with
    | zero => simpa using ha
    | succ k ih => simpa [Nat.cast_add, Nat.cast_one, add_assoc] using hc _ ih
  apply Finset.eq_univ_iff_forall.mpr
  intro b
  have h := hn (b - a).val
  have he : a + ((b - a).val : ZMod q) = b := by
    rw [ZMod.natCast_zmod_val]
    abel
  rwa [he] at h

theorem step_grows (A : Finset (ZMod q)) (ha : A.Nonempty)
    (hp : A ≠ Finset.univ) : A.card < (step A).card := by
  have hs : A ⊆ step A := Finset.subset_union_left
  by_contra h
  have he : A = step A := Finset.eq_of_subset_of_card_le hs (by omega)
  apply hp
  apply successor_closed A ha
  intro a ha
  have hm : a + 1 ∈ step A := Finset.mem_union_right _ (Finset.mem_image.mpr ⟨a, ha, rfl⟩)
  rwa [← he] at hm

theorem expand_nonempty (A : Finset (ZMod q)) (ha : A.Nonempty) (k : ℕ) :
    (expand A k).Nonempty := by
  induction k with
  | zero => exact ha
  | succ k ih => exact ih.mono Finset.subset_union_left

theorem expand_card (A : Finset (ZMod q)) (ha : A.Nonempty) (k : ℕ)
    (hp : expand A k ≠ Finset.univ) : A.card + k ≤ (expand A k).card := by
  induction k with
  | zero => simp [expand]
  | succ k ih =>
      have hprev : expand A k ≠ Finset.univ := by
        intro h
        apply hp
        simp [expand, h, step]
      have hb := ih hprev
      have hg := step_grows (expand A k) (expand_nonempty A ha k) hprev
      change A.card + (k + 1) ≤ (step (expand A k)).card
      omega

theorem expand_witness (A : Finset (ZMod q)) (k : ℕ) (x : ZMod q)
    (hx : x ∈ expand A k) : ∃ a ∈ A, ∃ t : ℕ, t ≤ k ∧ x = a + (t : ZMod q) := by
  induction k generalizing x with
  | zero => exact ⟨x, hx, 0, le_rfl, by simp⟩
  | succ k ih =>
      rcases Finset.mem_union.mp hx with hx | hx
      · obtain ⟨a, ha, t, ht, hxt⟩ := ih x hx
        exact ⟨a, ha, t, by omega, hxt⟩
      · obtain ⟨y, hy, rfl⟩ := Finset.mem_image.mp hx
        obtain ⟨a, ha, t, ht, rfl⟩ := ih y hy
        exact ⟨a, ha, t + 1, by omega, by simp [Nat.cast_add, Nat.cast_one, add_assoc]⟩

theorem forbidden_run_bound (X Y : Finset (ZMod q)) (hX : X.Nonempty)
    (hY : Y.Nonempty) (k : ℕ)
    (havoid : ∀ x ∈ X, ∀ y ∈ Y, ∀ t : ℕ, t ≤ k → x + (t : ZMod q) ≠ y) :
    X.card + k + Y.card ≤ q := by
  have hdis : Disjoint (expand X k) Y := by
    apply Finset.disjoint_left.mpr
    intro y hy hyY
    obtain ⟨x, hx, t, ht, he⟩ := expand_witness X k y hy
    exact havoid x hx y hyY t ht he.symm
  have hp : expand X k ≠ Finset.univ := by
    intro h
    obtain ⟨y, hy⟩ := hY
    exact Finset.disjoint_left.mp hdis (by rw [h]; exact Finset.mem_univ y) hy
  have hcard : (expand X k).card + Y.card ≤ q := by
    rw [← Finset.card_union_of_disjoint hdis]
    have h := Finset.card_le_card (Finset.subset_univ (expand X k ∪ Y))
    simpa using h
  have hg := expand_card X hX k hp
  omega

theorem interval_bound (X Y : Finset (ZMod q)) (hX : X.Nonempty)
    (hY : Y.Nonempty) (a : ZMod q) (l : ℕ) (hl : l < q)
    (hinterval : ∀ x ∈ X, ∀ y ∈ Y, ((y - x) - a).val < l) :
    X.card + Y.card ≤ l + 1 := by
  let X' := X.image (fun x => x + (a + (l : ZMod q)))
  have hx' : X'.Nonempty := hX.image _
  have hc : X'.card = X.card := Finset.card_image_of_injective _ (fun _ _ h => add_right_cancel h)
  have hrun : ∀ x ∈ X', ∀ y ∈ Y, ∀ t : ℕ, t ≤ q - l - 1 → x + (t : ZMod q) ≠ y := by
    intro u hu y hy t ht he
    obtain ⟨x, hx, rfl⟩ := Finset.mem_image.mp hu
    have hv := hinterval x hx y hy
    have he' : (y - x) - a = ((l + t : ℕ) : ZMod q) := by
      rw [← he, Nat.cast_add]
      abel
    rw [he', ZMod.val_natCast_of_lt (by omega)] at hv
    omega
  have h := forbidden_run_bound X' Y hx' hY (q - l - 1) hrun
  rw [hc] at h
  omega

end P14CyclicIntervalBiclique

end
end

section

/-! Literal finite cyclic intervals, with their exact membership and
cardinality for lengths no greater than the modulus. -/

noncomputable section
namespace P14CyclicArc
variable {q : ℕ} [NeZero q]

def arc (a : ZMod q) (l : ℕ) : Finset (ZMod q) :=
  (Finset.range l).image (fun t : ℕ => a + (t : ZMod q))

theorem mem_arc_iff (a x : ZMod q) (l : ℕ) (hl : l ≤ q) :
    x ∈ arc a l ↔ (x - a).val < l := by
  constructor
  · intro hx
    obtain ⟨t, ht, rfl⟩ := Finset.mem_image.mp hx
    have ht' := Finset.mem_range.mp ht
    have he : (a + (t : ZMod q)) - a = (t : ZMod q) := by abel
    rw [he, ZMod.val_natCast_of_lt (by omega)]
    exact ht'
  · intro hx
    apply Finset.mem_image.mpr
    refine ⟨(x - a).val, Finset.mem_range.mpr hx, ?_⟩
    rw [ZMod.natCast_zmod_val]
    abel

theorem card_arc (a : ZMod q) (l : ℕ) (hl : l ≤ q) : (arc a l).card = l := by
  have hi : Set.InjOn (fun t : ℕ => a + (t : ZMod q)) (Finset.range l) := by
    intro t ht u hu he
    have he' := congrArg ZMod.val (add_left_cancel he)
    have ht' := Finset.mem_range.mp ht
    have hu' := Finset.mem_range.mp hu
    rwa [ZMod.val_natCast_of_lt (by omega), ZMod.val_natCast_of_lt (by omega)] at he'
  rw [arc, Finset.card_image_of_injOn hi, Finset.card_range]

theorem translate (a b : ZMod q) (l : ℕ) :
    (arc a l).image (fun x => x + b) = arc (a + b) l := by
  ext x
  simp only [arc, Finset.mem_image]
  constructor
  · rintro ⟨y, ⟨t, ht, rfl⟩, rfl⟩
    exact ⟨t, ht, by abel⟩
  · rintro ⟨t, ht, rfl⟩
    exact ⟨a + (t : ZMod q), ⟨t, ht, rfl⟩, by abel⟩

end P14CyclicArc

end
end

section

/-! A cyclic set whose successor expansion adds exactly one point is a
literal cyclic interval. The proof cuts at the unique missing successor
and fills the suffix from its least member. -/

noncomputable section
namespace P14CyclicSingleBoundary
open P14CyclicArc P14CyclicIntervalBiclique
variable {q : ℕ} [NeZero q]

theorem unique_exit (A : Finset (ZMod q)) (hg : (step A).card = A.card + 1) :
    ∃ b : ZMod q, b ∉ A ∧ ∀ x ∈ A, x + 1 ∉ A → x + 1 = b := by
  have hd : (step A \ A).card = 1 := by
    have h := Finset.card_sdiff_add_card_eq_card (show A ⊆ step A from Finset.subset_union_left)
    omega
  obtain ⟨b, hb⟩ := Finset.card_eq_one.mp hd
  have hbD : b ∈ step A \ A := by rw [hb]; simp
  refine ⟨b, (Finset.mem_sdiff.mp hbD).2, ?_⟩
  intro x hx hn
  have hxD : x + 1 ∈ step A \ A := by
    apply Finset.mem_sdiff.mpr
    exact ⟨Finset.mem_union_right _ (Finset.mem_image.mpr ⟨x, hx, rfl⟩), hn⟩
  rw [hb] at hxD
  exact Finset.mem_singleton.mp hxD

theorem zero_boundary_suffix (T : Finset (ZMod q)) (hT : T.Nonempty)
    (hzero : 0 ∉ T) (hnext : ∀ x ∈ T, x + 1 ≠ 0 → x + 1 ∈ T) :
    ∃ k : ℕ, 1 ≤ k ∧ k < q ∧ ∀ x : ZMod q, x ∈ T ↔ k ≤ x.val := by
  have hex : ∃ k : ℕ, k < q ∧ (k : ZMod q) ∈ T := by
    obtain ⟨x, hx⟩ := hT
    exact ⟨x.val, ZMod.val_lt x, by simpa using hx⟩
  let k := Nat.find hex
  have hk : k < q ∧ (k : ZMod q) ∈ T := Nat.find_spec hex
  have hkpos : 1 ≤ k := by
    by_contra hn
    have he : k = 0 := by omega
    apply hzero
    simpa [he] using hk.2
  have hfill (j : ℕ) : k + j < q → ((k + j : ℕ) : ZMod q) ∈ T := by
    induction j with
    | zero => intro _; simpa using hk.2
    | succ j ih =>
        intro hlt
        have hp := ih (by omega)
        have hn : ((k + (j + 1) : ℕ) : ZMod q) ≠ 0 := by
          intro he
          have hv := congrArg ZMod.val he
          rw [ZMod.val_natCast_of_lt hlt, ZMod.val_zero] at hv
          omega
        have h := hnext _ hp (by simpa [Nat.cast_add, Nat.cast_one, add_assoc] using hn)
        simpa [Nat.cast_add, Nat.cast_one, add_assoc] using h
  refine ⟨k, hkpos, hk.1, ?_⟩
  intro x
  constructor
  · intro hx
    exact Nat.find_min' hex ⟨ZMod.val_lt x, by simpa using hx⟩
  · intro hx
    have he : k + (x.val - k) = x.val := by omega
    have h := hfill (x.val - k) (by rw [he]; exact ZMod.val_lt x)
    simpa [he] using h

theorem arc_of_unique_exit (A : Finset (ZMod q)) (hA : A.Nonempty)
    (b : ZMod q) (hb : b ∉ A)
    (hexit : ∀ x ∈ A, x + 1 ∉ A → x + 1 = b) :
    ∃ a : ZMod q, A = arc a A.card := by
  let T := A.image (fun x => x - b)
  have hT : T.Nonempty := hA.image _
  have hzero : (0 : ZMod q) ∉ T := by
    intro h
    obtain ⟨x, hx, he⟩ := Finset.mem_image.mp h
    have hxb : x = b := sub_eq_zero.mp he
    exact hb (hxb ▸ hx)
  have hmem (x : ZMod q) : x ∈ A ↔ x - b ∈ T := by
    constructor
    · intro hx
      exact Finset.mem_image.mpr ⟨x, hx, rfl⟩
    · intro hx
      obtain ⟨y, hy, he⟩ := Finset.mem_image.mp hx
      have hyx : y = x := sub_left_inj.mp he
      exact hyx ▸ hy
  have hnext : ∀ z ∈ T, z + 1 ≠ 0 → z + 1 ∈ T := by
    intro z hz hn
    obtain ⟨x, hx, rfl⟩ := Finset.mem_image.mp hz
    have hxb : x + 1 ≠ b := by
      intro he
      apply hn
      calc
        x - b + 1 = x + 1 - b := by abel
        _ = 0 := by rw [he]; simp
    have hxnext : x + 1 ∈ A := by
      by_contra h
      exact hxb (hexit x hx h)
    exact Finset.mem_image.mpr ⟨x + 1, hxnext, by abel⟩
  obtain ⟨k, hkpos, hkq, hsuffix⟩ := zero_boundary_suffix T hT hzero hnext
  have hshape : A = arc (b + (k : ZMod q)) (q - k) := by
    ext x
    constructor
    · intro hx
      have hlo : k ≤ (x - b).val := (hsuffix _).mp ((hmem x).mp hx)
      have hv := ZMod.val_lt (x - b)
      have he : k + ((x - b).val - k) = (x - b).val := by omega
      apply Finset.mem_image.mpr
      refine ⟨(x - b).val - k, Finset.mem_range.mpr (by omega), ?_⟩
      calc
        (b + (k : ZMod q)) + (((x - b).val - k : ℕ) : ZMod q) =
            b + ((k + ((x - b).val - k) : ℕ) : ZMod q) := by simp [Nat.cast_add, add_assoc]
        _ = b + ((x - b).val : ZMod q) := by rw [he]
        _ = x := by rw [ZMod.natCast_zmod_val]; abel
    · intro hx
      obtain ⟨t, ht, rfl⟩ := Finset.mem_image.mp hx
      have ht' := Finset.mem_range.mp ht
      apply (hmem _).mpr
      apply (hsuffix _).mpr
      have he : (b + (k : ZMod q)) + (t : ZMod q) - b = ((k + t : ℕ) : ZMod q) := by
        rw [Nat.cast_add]
        abel
      rw [he, ZMod.val_natCast_of_lt (by omega)]
      omega
  have hc : A.card = q - k := by rw [hshape, card_arc _ _ (by omega)]
  exact ⟨b + (k : ZMod q), by rw [hc]; exact hshape⟩

theorem arc_of_step_card (A : Finset (ZMod q)) (hA : A.Nonempty)
    (hg : (step A).card = A.card + 1) : ∃ a : ZMod q, A = arc a A.card := by
  obtain ⟨b, hb, hexit⟩ := unique_exit A hg
  exact arc_of_unique_exit A hA b hb hexit

end P14CyclicSingleBoundary

end
end

section

/-! Equality in the cyclic-interval biclique bound forces actual cyclic
intervals on both sides when at least two residues are excluded. The
proof uses exact successor growth, not a structural sumset theorem. -/

noncomputable section
namespace P14CyclicCriticalPair
open P14CyclicArc P14CyclicIntervalBiclique P14CyclicSingleBoundary
variable {q : ℕ} [NeZero q]

theorem expand_add (A : Finset (ZMod q)) (k l : ℕ) :
    expand A (k + l) = expand (expand A k) l := by
  induction l with
  | zero => rfl
  | succ l ih =>
    change step (expand A (k + l)) = step (expand (expand A k) l)
    exact congrArg step ih

theorem subset_expand (A : Finset (ZMod q)) (k : ℕ) : A ⊆ expand A k := by
  induction k with
  | zero => exact subset_rfl
  | succ k ih => exact ih.trans Finset.subset_union_left

theorem arc_of_minimal_expansion (A : Finset (ZMod q)) (hA : A.Nonempty)
    (k : ℕ) (hk : 1 ≤ k) (hp : expand A k ≠ Finset.univ)
    (hg : (expand A k).card = A.card + k) :
    ∃ a : ZMod q, A = arc a A.card := by
  have hAp : A ≠ Finset.univ := by
    intro he
    apply hp
    apply Finset.eq_univ_iff_forall.mpr
    intro x
    exact subset_expand A k (by rw [he]; exact Finset.mem_univ x)
  have he : expand A k = expand (step A) (k - 1) := by
    calc
      expand A k = expand A (1 + (k - 1)) := by congr 1; omega
      _ = expand (expand A 1) (k - 1) := expand_add A 1 (k - 1)
      _ = expand (step A) (k - 1) := rfl
  have hstep : (step A).Nonempty := hA.mono Finset.subset_union_left
  have hupper := expand_card (step A) hstep (k - 1) (by rwa [← he])
  have hlower := step_grows A hA hAp
  have hcard : (step A).card = A.card + 1 := by rw [← he] at hupper; omega
  exact arc_of_step_card A hA hcard

theorem arc_of_forbidden_equality (X Y : Finset (ZMod q)) (hX : X.Nonempty)
    (hY : Y.Nonempty) (k : ℕ) (hk : 1 ≤ k)
    (havoid : ∀ x ∈ X, ∀ y ∈ Y, ∀ t : ℕ, t ≤ k → x + (t : ZMod q) ≠ y)
    (heq : X.card + k + Y.card = q) :
    ∃ a : ZMod q, X = arc a X.card := by
  have hdis : Disjoint (expand X k) Y := by
    apply Finset.disjoint_left.mpr
    intro y hy hyY
    obtain ⟨x, hx, t, ht, he⟩ := expand_witness X k y hy
    exact havoid x hx y hyY t ht he.symm
  have hp : expand X k ≠ Finset.univ := by
    intro h
    obtain ⟨y, hy⟩ := hY
    exact Finset.disjoint_left.mp hdis (by rw [h]; exact Finset.mem_univ y) hy
  have hu : (expand X k).card + Y.card ≤ q := by
    rw [← Finset.card_union_of_disjoint hdis]
    have h := Finset.card_le_card (Finset.subset_univ (expand X k ∪ Y))
    simpa using h
  have hl := expand_card X hX k hp
  apply arc_of_minimal_expansion X hX k hk hp
  omega

theorem interval_equality_left (X Y : Finset (ZMod q)) (hX : X.Nonempty)
    (hY : Y.Nonempty) (a : ZMod q) (l : ℕ) (hl : l + 2 ≤ q)
    (hinterval : ∀ x ∈ X, ∀ y ∈ Y, ((y - x) - a).val < l)
    (heq : X.card + Y.card = l + 1) :
    ∃ b : ZMod q, X = arc b X.card := by
  let c : ZMod q := a + (l : ZMod q)
  let X' := X.image (fun x => x + c)
  have hX' : X'.Nonempty := hX.image _
  have hc : X'.card = X.card := Finset.card_image_of_injective _ (fun _ _ h => add_right_cancel h)
  have hrun : ∀ x ∈ X', ∀ y ∈ Y, ∀ t : ℕ, t ≤ q - l - 1 → x + (t : ZMod q) ≠ y := by
    intro u hu y hy t ht he
    obtain ⟨x, hx, rfl⟩ := Finset.mem_image.mp hu
    have hv := hinterval x hx y hy
    have he' : (y - x) - a = ((l + t : ℕ) : ZMod q) := by
      rw [← he, Nat.cast_add]
      dsimp only [c]
      abel
    rw [he', ZMod.val_natCast_of_lt (by omega)] at hv
    omega
  obtain ⟨b, hb⟩ := arc_of_forbidden_equality X' Y hX' hY (q - l - 1)
    (by omega) hrun (by rw [hc]; omega)
  have himage : X'.image (fun x => x + -c) = X := by
    change (X.image (fun x => x + c)).image (fun x => x + -c) = X
    ext z
    constructor
    · intro hz
      obtain ⟨u, hu, huz⟩ := Finset.mem_image.mp hz
      obtain ⟨x, hx, hxu⟩ := Finset.mem_image.mp hu
      rw [←huz, ←hxu]
      simpa only [add_assoc, add_neg_cancel, add_zero] using hx
    · intro hz
      exact Finset.mem_image.mpr ⟨z + c, Finset.mem_image.mpr ⟨z, hz, rfl⟩,
        by simp only [add_assoc, add_neg_cancel, add_zero]⟩
  have h := congrArg (fun Z : Finset (ZMod q) => Z.image (fun x => x + -c)) hb
  rw [himage, P14CyclicArc.translate, hc] at h
  exact ⟨b + -c, h⟩

theorem reverse_interval (a x y : ZMod q) (l : ℕ) (hl : l ≤ q)
    (h : ((y - x) - a).val < l) :
    ((x - y) - (-a - ((l - 1 : ℕ) : ZMod q))).val < l := by
  have he : (x - y) - (-a - ((l - 1 : ℕ) : ZMod q)) =
      (((l - 1) - ((y - x) - a).val : ℕ) : ZMod q) := by
    have hs : (((l - 1) - ((y - x) - a).val : ℕ) : ZMod q) =
        ((l - 1 : ℕ) : ZMod q) - (((y - x) - a).val : ZMod q) :=
      Nat.cast_sub (by omega)
    rw [hs, ZMod.natCast_zmod_val]
    abel
  rw [he, ZMod.val_natCast_of_lt (by omega)]
  omega

theorem interval_equality_shapes (X Y : Finset (ZMod q)) (hX : X.Nonempty)
    (hY : Y.Nonempty) (a : ZMod q) (l : ℕ) (hl : l + 2 ≤ q)
    (hinterval : ∀ x ∈ X, ∀ y ∈ Y, ((y - x) - a).val < l)
    (heq : X.card + Y.card = l + 1) :
    (∃ b : ZMod q, X = arc b X.card) ∧ (∃ c : ZMod q, Y = arc c Y.card) := by
  refine ⟨interval_equality_left X Y hX hY a l hl hinterval heq, ?_⟩
  apply interval_equality_left Y X hY hX (-a - ((l - 1 : ℕ) : ZMod q)) l hl
  · intro y hy x hx
    exact reverse_interval a x y l (by omega) (hinterval x hx y hy)
  · omega

end P14CyclicCriticalPair

end
end

section

/-! Endpoints of proper cyclic arcs and an exact no-wrap bound for doubled
points in an interval omitting at least two residues. -/

noncomputable section
namespace P14CyclicArcArithmetic
open P14CyclicArc
variable {q : ℕ} [NeZero q]

theorem start_mem (a : ZMod q) (l : ℕ) (hl : 0 < l) : a ∈ arc a l := by
  exact Finset.mem_image.mpr ⟨0, Finset.mem_range.mpr hl, by simp⟩

theorem start_unique (a x : ZMod q) (l : ℕ) (hx : x ∈ arc a l)
    (hprev : x - 1 ∉ arc a l) : x = a := by
  obtain ⟨t, ht, rfl⟩ := Finset.mem_image.mp hx
  cases t with
  | zero => simp
  | succ t =>
    exfalso
    apply hprev
    refine Finset.mem_image.mpr ⟨t, Finset.mem_range.mpr (by
      have h := Finset.mem_range.mp ht
      omega), ?_⟩
    simp only [Nat.cast_succ]
    abel

theorem predecessor_not_mem (a : ZMod q) (l : ℕ) (hl : l < q) :
    a - 1 ∉ arc a l := by
  intro hx
  obtain ⟨t, ht, he⟩ := Finset.mem_image.mp hx
  have ht' := Finset.mem_range.mp ht
  have hz : ((t + 1 : ℕ) : ZMod q) = 0 := by
    rw [Nat.cast_add, Nat.cast_one]
    have h : (t : ZMod q) = -1 := by
      calc
        (t : ZMod q) = (a + (t : ZMod q)) - a := by abel
        _ = (a - 1) - a := by rw [he]
        _ = -1 := by abel
    rw [h]
    simp
  have hv := congrArg ZMod.val hz
  rw [ZMod.val_natCast_of_lt (by omega), ZMod.val_zero] at hv
  omega

theorem equal_arc_starts (a b : ZMod q) (l : ℕ) (hpos : 0 < l)
    (hl : l < q) (he : arc a l = arc b l) : a = b := by
  have hb : b ∈ arc a l := by rw [he]; exact start_mem b l hpos
  have hp : b - 1 ∉ arc a l := by rw [he]; exact predecessor_not_mem b l hl
  exact (start_unique a b l hb hp).symm

theorem sum_starts (a b c : ZMod q) (r s l : ℕ) (hr : 0 < r) (hs : 0 < s)
    (hrs : r + s = l + 1) (hl : l < q)
    (hpair : ∀ x ∈ arc a r, ∀ y ∈ arc b s, x + y ∈ arc c l) : a + b = c := by
  have hsub : arc (a + b) l ⊆ arc c l := by
    intro z hz
    obtain ⟨n, hn, rfl⟩ := Finset.mem_image.mp hz
    have hn' := Finset.mem_range.mp hn
    have hsplit : ∃ u v : ℕ, u < r ∧ v < s ∧ u + v = n := by
      by_cases hnr : n < r
      · exact ⟨n, 0, hnr, hs, by omega⟩
      · exact ⟨r - 1, n - (r - 1), by omega, by omega, by omega⟩
    obtain ⟨u, v, hu, hv, huv⟩ := hsplit
    have h := hpair (a + (u : ZMod q))
      (Finset.mem_image.mpr ⟨u, Finset.mem_range.mpr hu, rfl⟩)
      (b + (v : ZMod q)) (Finset.mem_image.mpr ⟨v, Finset.mem_range.mpr hv, rfl⟩)
    have he : (a + b) + (n : ZMod q) = (a + (u : ZMod q)) + (b + (v : ZMod q)) := by
      rw [← huv, Nat.cast_add]
      abel
    rwa [he]
  have he : arc (a + b) l = arc c l := Finset.eq_of_subset_of_card_le hsub (by
    rw [card_arc _ _ (by omega), card_arc _ _ (by omega)])
  exact equal_arc_starts (a + b) c l (by omega) hl he

theorem doubled_arc_no_wrap (b : ZMod q) (s l : ℕ) (hs : 0 < s) (hl : l + 2 ≤ q)
    (hdouble : ∀ t : ℕ, t < s → (2 * (b + (t : ZMod q))).val < l) :
    (2 * b).val + 2 * (s - 1) < l := by
  have he (t : ℕ) : 2 * (b + (t : ZMod q)) =
      (((2 * b).val + 2 * t : ℕ) : ZMod q) := by
    rw [Nat.cast_add, Nat.cast_mul, ZMod.natCast_zmod_val, Nat.cast_ofNat, mul_add]
  have hbound : ∀ t : ℕ, t < s → (2 * b).val + 2 * t < l := by
    intro t
    induction t with
    | zero => simpa using hdouble 0
    | succ t ih =>
      intro ht
      have hp := ih (by omega)
      have h := hdouble (t + 1) ht
      rw [he, ZMod.val_natCast_of_lt (by omega)] at h
      exact h
  exact hbound (s - 1) (by omega)

theorem arcs_intersect (a b : ZMod q) (r s l : ℕ) (hr : 0 < r) (hs : 0 < s)
    (hrs : r + s = l + 1) (hl : l + 2 ≤ q)
    (hpair : ∀ x ∈ arc a r, ∀ y ∈ arc b s, x + y ∈ arc 0 l)
    (hdouble : ∀ y ∈ arc b s, 2 * y ∈ arc 0 l) :
    ∃ z : ZMod q, z ∈ arc a r ∧ z ∈ arc b s := by
  have hab := sum_starts a b 0 r s l hr hs hrs (by omega) hpair
  have hd : ∀ t : ℕ, t < s → (2 * (b + (t : ZMod q))).val < l := by
    intro t ht
    have h := hdouble (b + (t : ZMod q))
      (Finset.mem_image.mpr ⟨t, Finset.mem_range.mpr ht, rfl⟩)
    have hm := (mem_arc_iff 0 _ l (by omega)).mp h
    simpa using hm
  have hbound := doubled_arc_no_wrap b s l hs hl hd
  have hc : (2 * b).val < r := by omega
  refine ⟨b, ?_, start_mem b s hs⟩
  apply Finset.mem_image.mpr
  refine ⟨(2 * b).val, Finset.mem_range.mpr hc, ?_⟩
  rw [ZMod.natCast_zmod_val, two_mul]
  calc
    a + (b + b) = (a + b) + b := by abel
    _ = b := by rw [hab, zero_add]

end P14CyclicArcArithmetic

end
end

section

/-! The extra point is excluded when disjoint sets have all cross-sums
and all doubled points of the second set inside a proper cyclic interval.
The stronger bound is the finite part of the distinguished-vertex case
for a consecutive block of round-robin matchings. -/

noncomputable section
namespace P14CyclicMatchingObstruction
open P14CyclicArc P14CyclicIntervalBiclique P14CyclicCriticalPair P14CyclicArcArithmetic
variable {q : ℕ} [NeZero q]

theorem sum_bound (X Y : Finset (ZMod q)) (hX : X.Nonempty) (hY : Y.Nonempty)
    (a : ZMod q) (l : ℕ) (hl : l < q)
    (hsum : ∀ x ∈ X, ∀ y ∈ Y, ((x + y) - a).val < l) :
    X.card + Y.card ≤ l + 1 := by
  let N := X.image (fun x => -x)
  have hc : N.card = X.card := Finset.card_image_of_injective _ neg_injective
  have hi : ∀ n ∈ N, ∀ y ∈ Y, ((y - n) - a).val < l := by
    intro n hn y hy
    obtain ⟨x, hx, rfl⟩ := Finset.mem_image.mp hn
    have he : (y - -x) - a = (x + y) - a := by abel
    rw [he]
    exact hsum x hx y hy
  have h := interval_bound N Y (hX.image _) hY a l hl hi
  rwa [hc] at h

theorem sum_equality_shapes (X Y : Finset (ZMod q)) (hX : X.Nonempty) (hY : Y.Nonempty)
    (a : ZMod q) (l : ℕ) (hl : l + 2 ≤ q)
    (hsum : ∀ x ∈ X, ∀ y ∈ Y, ((x + y) - a).val < l)
    (heq : X.card + Y.card = l + 1) :
    (∃ b : ZMod q, X = arc b X.card) ∧ (∃ c : ZMod q, Y = arc c Y.card) := by
  have one_side (U V : Finset (ZMod q)) (hU : U.Nonempty) (hV : V.Nonempty)
      (hUV : ∀ u ∈ U, ∀ v ∈ V, ((u + v) - a).val < l)
      (hcard : U.card + V.card = l + 1) : ∃ c : ZMod q, V = arc c V.card := by
    let N := U.image (fun u => -u)
    have hc : N.card = U.card := Finset.card_image_of_injective _ neg_injective
    have hi : ∀ n ∈ N, ∀ v ∈ V, ((v - n) - a).val < l := by
      intro n hn v hv
      obtain ⟨u, hu, rfl⟩ := Finset.mem_image.mp hn
      have he : (v - -u) - a = (u + v) - a := by abel
      rw [he]
      exact hUV u hu v hv
    exact (interval_equality_shapes N V (hU.image _) hV a l hl hi (by rwa [hc])).2
  refine ⟨one_side Y X hY hX ?_ (by omega), one_side X Y hX hY hsum heq⟩
  intro y hy x hx
  simpa only [add_comm] using hsum x hx y hy

theorem normalized_bound (X Y : Finset (ZMod q)) (hX : X.Nonempty) (hY : Y.Nonempty)
    (l : ℕ) (hl : l + 2 ≤ q) (hdis : Disjoint X Y)
    (hsum : ∀ x ∈ X, ∀ y ∈ Y, x + y ∈ arc 0 l)
    (hdouble : ∀ y ∈ Y, 2 * y ∈ arc 0 l) : X.card + Y.card ≤ l := by
  have hi : ∀ x ∈ X, ∀ y ∈ Y, ((x + y) - 0).val < l := by
    intro x hx y hy
    exact (mem_arc_iff 0 _ l (by omega)).mp (hsum x hx y hy)
  have hb := sum_bound X Y hX hY 0 l (by omega) hi
  by_contra hn
  have heq : X.card + Y.card = l + 1 := by omega
  obtain ⟨⟨a, ha⟩, ⟨b, hb'⟩⟩ := sum_equality_shapes X Y hX hY 0 l hl hi heq
  have hpair : ∀ x ∈ arc a X.card, ∀ y ∈ arc b Y.card, x + y ∈ arc 0 l := by
    rw [← ha, ← hb']
    exact hsum
  have hd : ∀ y ∈ arc b Y.card, 2 * y ∈ arc 0 l := by
    rw [← hb']
    exact hdouble
  obtain ⟨z, hx, hy⟩ := arcs_intersect a b X.card Y.card l
    (Finset.card_pos.mpr hX) (Finset.card_pos.mpr hY) heq hl hpair hd
  rw [← ha] at hx
  rw [← hb'] at hy
  exact Finset.disjoint_left.mp hdis hx hy

theorem translated_bound (X Y : Finset (ZMod q)) (hX : X.Nonempty) (hY : Y.Nonempty)
    (b : ZMod q) (l : ℕ) (hl : l + 2 ≤ q) (hdis : Disjoint X Y)
    (hsum : ∀ x ∈ X, ∀ y ∈ Y, x + y ∈ arc (b + b) l)
    (hdouble : ∀ y ∈ Y, 2 * y ∈ arc (b + b) l) : X.card + Y.card ≤ l := by
  let U := X.image (fun x => x - b)
  let V := Y.image (fun y => y - b)
  have hcU : U.card = X.card := Finset.card_image_of_injective _ (fun _ _ h => sub_left_inj.mp h)
  have hcV : V.card = Y.card := Finset.card_image_of_injective _ (fun _ _ h => sub_left_inj.mp h)
  have hd : Disjoint U V := by
    apply Finset.disjoint_left.mpr
    intro z hzU hzV
    obtain ⟨x, hx, hxz⟩ := Finset.mem_image.mp hzU
    obtain ⟨y, hy, hyz⟩ := Finset.mem_image.mp hzV
    have he : x = y := sub_left_inj.mp (hxz.trans hyz.symm)
    exact Finset.disjoint_left.mp hdis (he ▸ hx) hy
  have hs : ∀ u ∈ U, ∀ v ∈ V, u + v ∈ arc 0 l := by
    intro u hu v hv
    obtain ⟨x, hx, rfl⟩ := Finset.mem_image.mp hu
    obtain ⟨y, hy, rfl⟩ := Finset.mem_image.mp hv
    apply (mem_arc_iff 0 _ l (by omega)).mpr
    have h := (mem_arc_iff (b + b) _ l (by omega)).mp (hsum x hx y hy)
    have he : ((x - b) + (y - b)) - 0 = (x + y) - (b + b) := by abel
    rwa [he]
  have hv : ∀ v ∈ V, 2 * v ∈ arc 0 l := by
    intro v hv
    obtain ⟨y, hy, rfl⟩ := Finset.mem_image.mp hv
    apply (mem_arc_iff 0 _ l (by omega)).mpr
    have h := (mem_arc_iff (b + b) _ l (by omega)).mp (hdouble y hy)
    have he : 2 * (y - b) - 0 = 2 * y - (b + b) := by simp only [two_mul]; abel
    rwa [he]
  have h := normalized_bound U V (hX.image _) (hY.image _) l hl hd hs hv
  rwa [hcU, hcV] at h

end P14CyclicMatchingObstruction

end
end

section

/-! Actual round-robin block graph on infinity and an odd cyclic group.
Round t joins infinity to t and joins distinct finite x,y with x+y=t+t.
Every biclique in l consecutive rounds has at most l+1 vertices when
at least two centers are omitted. -/

noncomputable section
namespace P14CyclicRoundBlock
open P14CyclicArc P14CyclicMatchingObstruction
variable {q : ℕ} [NeZero q]

theorem doubling_injective (hn : Odd q) :
    Function.Injective (fun x : ZMod q => x + x) := by
  intro x y h
  change x + x = y + y at h
  apply sub_eq_zero.mp
  apply (ZMod.add_self_eq_zero_iff_eq_zero hn).mp
  calc
    (x - y) + (x - y) = (x + x) - (y + y) := by abel
    _ = 0 := by rw [h]; simp

def half (hn : Odd q) (x : ZMod q) : ZMod q :=
  Classical.choose (Finite.surjective_of_injective (doubling_injective hn) x)

theorem half_spec (hn : Odd q) (x : ZMod q) : half hn x + half hn x = x :=
  Classical.choose_spec (Finite.surjective_of_injective (doubling_injective hn) x)

theorem half_injective (hn : Odd q) : Function.Injective (half hn) := by
  intro x y he
  calc
    x = half hn x + half hn x := (half_spec hn x).symm
    _ = half hn y + half hn y := by rw [he]
    _ = y := half_spec hn y

def Edge (a : ZMod q) (l : ℕ) : Option (ZMod q) → Option (ZMod q) → Prop
  | none, none => False
  | none, some y => y ∈ arc a l
  | some x, none => x ∈ arc a l
  | some x, some y => x ≠ y ∧ ∃ t ∈ arc a l, x + y = t + t

theorem edge_symmetric (a : ZMod q) (l : ℕ) : Symmetric (Edge a l) := by
  intro x y h
  cases x with
  | none => cases y <;> exact h
  | some x =>
    cases y with
    | none => exact h
    | some y =>
      obtain ⟨hne, t, ht, he⟩ := h
      exact ⟨Ne.symm hne, t, ht, by rw [add_comm]; exact he⟩

theorem edge_irreflexive (a : ZMod q) (l : ℕ) : Irreflexive (Edge a l) := by
  intro x h
  cases x with
  | none => exact h
  | some x => exact h.1 rfl

theorem finite_sums (hn : Odd q) (a : ZMod q) (l : ℕ)
    (X Y : Finset (ZMod q))
    (he : ∀ x ∈ X, ∀ y ∈ Y, Edge a l (some x) (some y)) :
    ∀ u ∈ X.image (half hn), ∀ v ∈ Y.image (half hn), u + v ∈ arc a l := by
  intro u hu v hv
  obtain ⟨x, hx, rfl⟩ := Finset.mem_image.mp hu
  obtain ⟨y, hy, rfl⟩ := Finset.mem_image.mp hv
  obtain ⟨_, t, ht, hxy⟩ := he x hx y hy
  have hh : half hn x + half hn y = t := by
    apply doubling_injective hn
    calc
      (half hn x + half hn y) + (half hn x + half hn y) =
          (half hn x + half hn x) + (half hn y + half hn y) := by abel
      _ = x + y := by rw [half_spec, half_spec]
      _ = t + t := hxy
  rwa [hh]

theorem finite_bound (hn : Odd q) (a : ZMod q) (l : ℕ) (hl : l < q)
    (X Y : Finset (ZMod q)) (hX : X.Nonempty) (hY : Y.Nonempty)
    (he : ∀ x ∈ X, ∀ y ∈ Y, Edge a l (some x) (some y)) :
    X.card + Y.card ≤ l + 1 := by
  have hcX := Finset.card_image_of_injective X (half_injective hn)
  have hcY := Finset.card_image_of_injective Y (half_injective hn)
  have hs := finite_sums hn a l X Y he
  have hb := sum_bound (X.image (half hn)) (Y.image (half hn)) (hX.image _) (hY.image _)
    a l hl (fun u hu v hv => (mem_arc_iff a _ l (by omega)).mp (hs u hu v hv))
  rwa [hcX, hcY] at hb

theorem finite_infinity_bound (hn : Odd q) (a : ZMod q) (l : ℕ) (hl : l + 2 ≤ q)
    (X Y : Finset (ZMod q)) (hX : X.Nonempty) (hY : Y.Nonempty)
    (hdis : Disjoint X Y) (hcenters : Y ⊆ arc a l)
    (he : ∀ x ∈ X, ∀ y ∈ Y, Edge a l (some x) (some y)) :
    X.card + Y.card ≤ l := by
  let U := X.image (half hn)
  let V := Y.image (half hn)
  have hcX : U.card = X.card := Finset.card_image_of_injective X (half_injective hn)
  have hcY : V.card = Y.card := Finset.card_image_of_injective Y (half_injective hn)
  have hd : Disjoint U V := by
    apply Finset.disjoint_left.mpr
    intro z hzU hzV
    obtain ⟨x, hx, hxz⟩ := Finset.mem_image.mp hzU
    obtain ⟨y, hy, hyz⟩ := Finset.mem_image.mp hzV
    have hxy := half_injective hn (hxz.trans hyz.symm)
    exact Finset.disjoint_left.mp hdis (hxy ▸ hx) hy
  have hs : ∀ u ∈ U, ∀ v ∈ V, u + v ∈ arc (half hn a + half hn a) l := by
    rw [half_spec]
    exact finite_sums hn a l X Y he
  have hv : ∀ v ∈ V, 2 * v ∈ arc (half hn a + half hn a) l := by
    intro v hv
    obtain ⟨y, hy, rfl⟩ := Finset.mem_image.mp hv
    rw [two_mul, half_spec, half_spec]
    exact hcenters hy
  have hb := translated_bound U V (hX.image _) (hY.image _) (half hn a) l hl hd hs hv
  rwa [hcX, hcY] at hb

theorem biclique_bound (hn : Odd q) (a : ZMod q) (l : ℕ) (hl : l + 2 ≤ q)
    (A B : Finset (Option (ZMod q))) (hA : A.Nonempty) (hB : B.Nonempty)
    (hdis : Disjoint A B) (he : ∀ x ∈ A, ∀ y ∈ B, Edge a l x y) :
    A.card + B.card ≤ l + 1 := by
  have erased_nonempty (C : Finset (Option (ZMod q))) (hC : C.Nonempty) (hnone : none ∉ C) :
      C.eraseNone.Nonempty := by
    obtain ⟨x, hx⟩ := hC
    cases x with
    | none => exact False.elim (hnone hx)
    | some x => exact ⟨x, Finset.mem_eraseNone.mpr hx⟩
  have with_infinity (C D : Finset (Option (ZMod q))) (hC : C.Nonempty) (hD : D.Nonempty)
      (hd : Disjoint C D) (hCD : ∀ x ∈ C, ∀ y ∈ D, Edge a l x y)
      (hCnone : none ∈ C) : C.card + D.card ≤ l + 1 := by
    have hDnone : none ∉ D := fun h => Finset.disjoint_left.mp hd hCnone h
    have hc := Finset.card_eraseNone_of_mem hCnone
    have hdcard := Finset.card_eraseNone_of_not_mem hDnone
    have hcpos := Finset.card_pos.mpr hC
    have hcenters : D.eraseNone ⊆ arc a l := by
      intro y hy
      exact hCD none hCnone (some y) (Finset.mem_eraseNone.mp hy)
    by_cases hempty : C.eraseNone = ∅
    · have hzero : C.eraseNone.card = 0 := by rw [hempty]; rfl
      have hbound := Finset.card_le_card hcenters
      rw [card_arc _ _ (by omega)] at hbound
      omega
    · have hne := Finset.nonempty_iff_ne_empty.mpr hempty
      have hde : Disjoint C.eraseNone D.eraseNone := by
        apply Finset.disjoint_left.mpr
        intro x hx hy
        exact Finset.disjoint_left.mp hd (Finset.mem_eraseNone.mp hx) (Finset.mem_eraseNone.mp hy)
      have hbound := finite_infinity_bound hn a l hl C.eraseNone D.eraseNone hne
        (erased_nonempty D hD hDnone) hde hcenters
        (fun x hx y hy => hCD (some x) (Finset.mem_eraseNone.mp hx) (some y) (Finset.mem_eraseNone.mp hy))
      omega
  by_cases hAnone : none ∈ A
  · exact with_infinity A B hA hB hdis he hAnone
  by_cases hBnone : none ∈ B
  · have h := with_infinity B A hB hA hdis.symm
      (fun y hy x hx => edge_symmetric a l (he x hx y hy)) hBnone
    omega
  have hcA := Finset.card_eraseNone_of_not_mem hAnone
  have hcB := Finset.card_eraseNone_of_not_mem hBnone
  have h := finite_bound hn a l (by omega) A.eraseNone B.eraseNone
    (erased_nonempty A hA hAnone) (erased_nonempty B hB hBnone)
    (fun x hx y hy => he (some x) (Finset.mem_eraseNone.mp hx) (some y) (Finset.mem_eraseNone.mp hy))
  rwa [hcA, hcB] at h

end P14CyclicRoundBlock

end
end

section

/-! The biclique bound makes every induced set larger than d connected
through distinct nonedges. Connectivity is expressed as the generated
equivalence relation, directly suitable for transporting an invariant. -/

noncomputable section
namespace P14BicliqueComplementConnection

def Link (H : ℕ → ℕ → Prop) (S : Finset ℕ) (a b : ℕ) : Prop :=
  a ∈ S ∧ b ∈ S ∧ a ≠ b ∧ ¬ H a b ∧ ¬ H b a

def BicliqueBound (H : ℕ → ℕ → Prop) (S : Finset ℕ) (d : ℕ) : Prop :=
  ∀ A ⊆ S, ∀ B ⊆ S, A.Nonempty → B.Nonempty → Disjoint A B →
    (∀ i ∈ A, ∀ j ∈ B, H i j) → A.card + B.card ≤ d

theorem bound_subset (H : ℕ → ℕ → Prop) (S T : Finset ℕ) (d : ℕ)
    (h : BicliqueBound H S d) (hT : T ⊆ S) : BicliqueBound H T d := by
  intro A hA B hB hAn hBn hdis hedge
  exact h A (hA.trans hT) B (hB.trans hT) hAn hBn hdis hedge

theorem connected_of_large (H : ℕ → ℕ → Prop) (hs : ∀ {i j}, H i j → H j i)
    (S : Finset ℕ) (d : ℕ) (hbound : BicliqueBound H S d) (hd : d < S.card)
    (a b : ℕ) (ha : a ∈ S) (hb : b ∈ S) : Relation.EqvGen (Link H S) a b := by
  classical
  by_contra hnot
  let A := S.filter (fun i => Relation.EqvGen (Link H S) a i)
  let B := S \ A
  have hAS : A ⊆ S := Finset.filter_subset _ _
  have hBS : B ⊆ S := Finset.sdiff_subset
  have haA : a ∈ A := Finset.mem_filter.mpr ⟨ha, Relation.EqvGen.refl a⟩
  have hbB : b ∈ B := by
    apply Finset.mem_sdiff.mpr
    exact ⟨hb, fun h => hnot (Finset.mem_filter.mp h).2⟩
  have hdis : Disjoint A B := by
    apply Finset.disjoint_left.mpr
    intro i hi hiB
    exact (Finset.mem_sdiff.mp hiB).2 hi
  have hedge : ∀ i ∈ A, ∀ j ∈ B, H i j := by
    intro i hi j hj
    have hjnot : j ∉ A := (Finset.mem_sdiff.mp hj).2
    by_contra hij
    have hji : ¬ H j i := fun h => hij (hs h)
    have hne : i ≠ j := fun h => hjnot (h ▸ hi)
    have hlink : Link H S i j := ⟨hAS hi, hBS hj, hne, hij, hji⟩
    have hreach : Relation.EqvGen (Link H S) a j :=
      Relation.EqvGen.trans a i j (Finset.mem_filter.mp hi).2 (Relation.EqvGen.rel i j hlink)
    exact hjnot (Finset.mem_filter.mpr ⟨hBS hj, hreach⟩)
  have hc := hbound A hAS B hBS ⟨a, haA⟩ ⟨b, hbB⟩ hdis hedge
  have he : B.card + A.card = S.card := Finset.card_sdiff_add_card_eq_card hAS
  omega

end P14BicliqueComplementConnection

end
end

section

/-! Join within-layer and cross-layer biclique bounds. The layers may
have different internal graphs, and zero block sizes are allowed. This
is the finite four-cell argument used in the ordinary graph partitions. -/

noncomputable section
namespace P14TwoLayerBiclique
open P14BicliqueComplementConnection

def Within (C : ℕ → Prop) (i j : ℕ) : Prop :=
  (C i ∧ C j) ∨ (¬ C i ∧ ¬ C j)

def Across (C : ℕ → Prop) (i j : ℕ) : Prop :=
  (C i ∧ ¬ C j) ∨ (¬ C i ∧ C j)

theorem four_cells (a b c d s t : ℕ)
    (hA : 0 < a + b) (hB : 0 < c + d) (hne : s ≠ t)
    (hac : 0 < a → 0 < c → a + c ≤ s + 1)
    (hbd : 0 < b → 0 < d → b + d ≤ s + 1)
    (had : 0 < a → 0 < d → a + d ≤ t + 1)
    (hbc : 0 < b → 0 < c → b + c ≤ t + 1) :
    a + b + (c + d) ≤ s + t + 1 := by
  by_cases ha : a = 0 <;> by_cases hb : b = 0 <;>
    by_cases hc : c = 0 <;> by_cases hd : d = 0 <;> omega

theorem combine (H : ℕ → ℕ → Prop) (C : ℕ → Prop)
    (S : Finset ℕ) (s t : ℕ) (hne : s ≠ t)
    (hw : BicliqueBound (fun i j => H i j ∧ Within C i j) S (s + 1))
    (hx : BicliqueBound (fun i j => H i j ∧ Across C i j) S (t + 1)) :
    BicliqueBound H S (s + t + 1) := by
  classical
  intro A hAS B hBS hA hB hdis hedge
  have part_bound (P Q : ℕ → Prop) [DecidablePred P] [DecidablePred Q]
      (K : ℕ → ℕ → Prop) (k : ℕ)
      (hk : BicliqueBound K S k)
      (hK : ∀ i ∈ A.filter P, ∀ j ∈ B.filter Q, K i j)
      (hp : 0 < (A.filter P).card) (hq : 0 < (B.filter Q).card) :
      (A.filter P).card + (B.filter Q).card ≤ k := by
    apply hk (A.filter P) ((Finset.filter_subset _ _).trans hAS)
      (B.filter Q) ((Finset.filter_subset _ _).trans hBS)
      (Finset.card_pos.mp hp) (Finset.card_pos.mp hq)
    · exact hdis.mono (Finset.filter_subset _ _) (Finset.filter_subset _ _)
    · exact hK
  have h00 : 0 < (A.filter C).card → 0 < (B.filter C).card →
      (A.filter C).card + (B.filter C).card ≤ s + 1 := by
    apply part_bound C C _ _ hw
    intro i hi j hj
    have hi' := Finset.mem_filter.mp hi
    have hj' := Finset.mem_filter.mp hj
    exact ⟨hedge i hi'.1 j hj'.1, Or.inl ⟨hi'.2, hj'.2⟩⟩
  have h11 : 0 < (A.filter (fun i => ¬ C i)).card →
      0 < (B.filter (fun i => ¬ C i)).card →
      (A.filter (fun i => ¬ C i)).card + (B.filter (fun i => ¬ C i)).card ≤ s + 1 := by
    apply part_bound (fun i => ¬ C i) (fun i => ¬ C i) _ _ hw
    intro i hi j hj
    have hi' := Finset.mem_filter.mp hi
    have hj' := Finset.mem_filter.mp hj
    exact ⟨hedge i hi'.1 j hj'.1, Or.inr ⟨hi'.2, hj'.2⟩⟩
  have h01 : 0 < (A.filter C).card → 0 < (B.filter (fun i => ¬ C i)).card →
      (A.filter C).card + (B.filter (fun i => ¬ C i)).card ≤ t + 1 := by
    apply part_bound C (fun i => ¬ C i) _ _ hx
    intro i hi j hj
    have hi' := Finset.mem_filter.mp hi
    have hj' := Finset.mem_filter.mp hj
    exact ⟨hedge i hi'.1 j hj'.1, Or.inl ⟨hi'.2, hj'.2⟩⟩
  have h10 : 0 < (A.filter (fun i => ¬ C i)).card → 0 < (B.filter C).card →
      (A.filter (fun i => ¬ C i)).card + (B.filter C).card ≤ t + 1 := by
    apply part_bound (fun i => ¬ C i) C _ _ hx
    intro i hi j hj
    have hi' := Finset.mem_filter.mp hi
    have hj' := Finset.mem_filter.mp hj
    exact ⟨hedge i hi'.1 j hj'.1, Or.inr ⟨hi'.2, hj'.2⟩⟩
  have hAc := Finset.card_filter_add_card_filter_not (s := A) C
  have hBc := Finset.card_filter_add_card_filter_not (s := B) C
  have hAp := Finset.card_pos.mpr hA
  have hBp := Finset.card_pos.mpr hB
  have h := four_cells (A.filter C).card (A.filter (fun i => ¬ C i)).card
    (B.filter C).card (B.filter (fun i => ¬ C i)).card s t
    (by omega) (by omega) hne h00 h11 h01 h10
  omega

end P14TwoLayerBiclique

end
end

section

/-! Actual within-layer round blocks and oriented cross-layer interval
blocks, transported through labels that are injective on each layer. -/

noncomputable section
namespace P14LayerBlockBiclique
open P14BicliqueComplementConnection P14TwoLayerBiclique P14CyclicArc
variable {r q : ℕ} [NeZero r] [NeZero q]

def LayerInjective {α : Type*} (C : ℕ → Prop) (S : Finset ℕ) (f : ℕ → α) : Prop :=
  ∀ i ∈ S, ∀ j ∈ S, (C i ↔ C j) → f i = f j → i = j

def WithinEdge (C : ℕ → Prop) (f : ℕ → Option (ZMod r)) (a : ZMod r) (s : ℕ)
    (i j : ℕ) : Prop := Within C i j ∧ P14CyclicRoundBlock.Edge a s (f i) (f j)

def CrossEdge (C : ℕ → Prop) (g : ℕ → ZMod q) (b : ZMod q) (t : ℕ)
    (i j : ℕ) : Prop :=
  (C i ∧ ¬ C j ∧ g j - g i ∈ arc b t) ∨ (¬ C i ∧ C j ∧ g i - g j ∈ arc b t)

def Edge (C : ℕ → Prop) (f : ℕ → Option (ZMod r)) (g : ℕ → ZMod q)
    (a : ZMod r) (b : ZMod q) (s t : ℕ) (i j : ℕ) : Prop :=
  WithinEdge C f a s i j ∨ CrossEdge C g b t i j

theorem same_layer {C : ℕ → Prop} {i j : ℕ} (h : Within C i j) : C i ↔ C j := by
  rcases h with ⟨hi, hj⟩ | ⟨hi, hj⟩
  · exact ⟨fun _ => hj, fun _ => hi⟩
  · exact ⟨fun h => False.elim (hi h), fun h => False.elim (hj h)⟩

theorem cross_across {C : ℕ → Prop} {g : ℕ → ZMod q} {b : ZMod q} {t i j : ℕ}
    (h : CrossEdge C g b t i j) : Across C i j := by
  rcases h with ⟨hi, hj, _⟩ | ⟨hi, hj, _⟩
  · exact Or.inl ⟨hi, hj⟩
  · exact Or.inr ⟨hi, hj⟩

theorem within_not_across {C : ℕ → Prop} {i j : ℕ} (h : Within C i j) : ¬ Across C i j := by
  intro h'
  have he := same_layer h
  rcases h' with ⟨hi, hj⟩ | ⟨hi, hj⟩
  · exact hj (he.mp hi)
  · exact hi (he.mpr hj)

theorem cross_symmetric (C : ℕ → Prop) (g : ℕ → ZMod q) (b : ZMod q) (t : ℕ)
    {i j : ℕ} (h : CrossEdge C g b t i j) : CrossEdge C g b t j i := by
  rcases h with ⟨hi, hj, he⟩ | ⟨hi, hj, he⟩
  · exact Or.inr ⟨hj, hi, he⟩
  · exact Or.inl ⟨hj, hi, he⟩

theorem edge_symmetric (C : ℕ → Prop) (f : ℕ → Option (ZMod r)) (g : ℕ → ZMod q)
    (a : ZMod r) (b : ZMod q) (s t : ℕ) {i j : ℕ}
    (h : Edge C f g a b s t i j) : Edge C f g a b s t j i := by
  rcases h with ⟨hw, he⟩ | hc
  · apply Or.inl
    constructor
    · rcases hw with ⟨hi, hj⟩ | ⟨hi, hj⟩
      · exact Or.inl ⟨hj, hi⟩
      · exact Or.inr ⟨hj, hi⟩
    · exact P14CyclicRoundBlock.edge_symmetric a s he
  · exact Or.inr (cross_symmetric C g b t hc)

theorem edge_irreflexive (C : ℕ → Prop) (f : ℕ → Option (ZMod r)) (g : ℕ → ZMod q)
    (a : ZMod r) (b : ZMod q) (s t i : ℕ) : ¬ Edge C f g a b s t i i := by
  rintro (⟨_, he⟩ | hc)
  · exact P14CyclicRoundBlock.edge_irreflexive a s (f i) he
  · rcases hc with ⟨hi, hni, _⟩ | ⟨hni, hi, _⟩ <;> exact hni hi

theorem within_bound (C : ℕ → Prop) (S : Finset ℕ) (f : ℕ → Option (ZMod r))
    (hf : LayerInjective C S f) (hr : Odd r) (a : ZMod r) (s : ℕ) (hs : s + 2 ≤ r) :
    BicliqueBound (WithinEdge C f a s) S (s + 1) := by
  classical
  intro A hAS B hBS hA hB hdis hedge
  obtain ⟨i₀, hi₀⟩ := hA
  obtain ⟨j₀, hj₀⟩ := hB
  have hA : A.Nonempty := ⟨i₀, hi₀⟩
  have hB : B.Nonempty := ⟨j₀, hj₀⟩
  have hia : Set.InjOn f A := by
    intro i hi j hj he
    exact hf i (hAS hi) j (hAS hj)
      ((same_layer (hedge i hi j₀ hj₀).1).trans (same_layer (hedge j hj j₀ hj₀).1).symm) he
  have hib : Set.InjOn f B := by
    intro i hi j hj he
    exact hf i (hBS hi) j (hBS hj)
      ((same_layer (hedge i₀ hi₀ i hi).1).symm.trans (same_layer (hedge i₀ hi₀ j hj).1)) he
  have hd : Disjoint (A.image f) (B.image f) := by
    apply Finset.disjoint_left.mpr
    intro z hzA hzB
    obtain ⟨i, hi, hiz⟩ := Finset.mem_image.mp hzA
    obtain ⟨j, hj, hjz⟩ := Finset.mem_image.mp hzB
    have he := hf i (hAS hi) j (hBS hj) (same_layer (hedge i hi j hj).1) (hiz.trans hjz.symm)
    exact Finset.disjoint_left.mp hdis (he ▸ hi) hj
  have he : ∀ x ∈ A.image f, ∀ y ∈ B.image f, P14CyclicRoundBlock.Edge a s x y := by
    intro x hx y hy
    obtain ⟨i, hi, rfl⟩ := Finset.mem_image.mp hx
    obtain ⟨j, hj, rfl⟩ := Finset.mem_image.mp hy
    exact (hedge i hi j hj).2
  have h := P14CyclicRoundBlock.biclique_bound hr a s hs (A.image f) (B.image f)
    (hA.image _) (hB.image _) hd he
  rwa [Finset.card_image_of_injOn hia, Finset.card_image_of_injOn hib] at h

theorem cross_bound (C : ℕ → Prop) (S : Finset ℕ) (g : ℕ → ZMod q)
    (hg : LayerInjective C S g) (b : ZMod q) (t : ℕ) (ht : t < q) :
    BicliqueBound (CrossEdge C g b t) S (t + 1) := by
  classical
  have directed (A B : Finset ℕ) (hAS : A ⊆ S) (hBS : B ⊆ S)
      (hA : A.Nonempty) (hB : B.Nonempty)
      (htrue : ∀ i ∈ A, C i) (hfalse : ∀ j ∈ B, ¬ C j)
      (hedge : ∀ i ∈ A, ∀ j ∈ B, CrossEdge C g b t i j) : A.card + B.card ≤ t + 1 := by
    have hia : Set.InjOn g A := by
      intro i hi j hj he
      exact hg i (hAS hi) j (hAS hj) ⟨fun _ => htrue j hj, fun _ => htrue i hi⟩ he
    have hib : Set.InjOn g B := by
      intro i hi j hj he
      exact hg i (hBS hi) j (hBS hj)
        ⟨fun h => False.elim (hfalse i hi h), fun h => False.elim (hfalse j hj h)⟩ he
    have hinterval : ∀ x ∈ A.image g, ∀ y ∈ B.image g, ((y - x) - b).val < t := by
      intro x hx y hy
      obtain ⟨i, hi, rfl⟩ := Finset.mem_image.mp hx
      obtain ⟨j, hj, rfl⟩ := Finset.mem_image.mp hy
      rcases hedge i hi j hj with ⟨_, _, hm⟩ | ⟨hni, _, _⟩
      · exact (mem_arc_iff b _ t (by omega)).mp hm
      · exact False.elim (hni (htrue i hi))
    have h := P14CyclicIntervalBiclique.interval_bound (A.image g) (B.image g)
      (hA.image _) (hB.image _) b t ht hinterval
    rwa [Finset.card_image_of_injOn hia, Finset.card_image_of_injOn hib] at h
  intro A hAS B hBS hA hB _ hedge
  obtain ⟨i₀, hi₀⟩ := hA
  obtain ⟨j₀, hj₀⟩ := hB
  have hA : A.Nonempty := ⟨i₀, hi₀⟩
  have hB : B.Nonempty := ⟨j₀, hj₀⟩
  by_cases hiC : C i₀
  · have hfalse : ∀ j ∈ B, ¬ C j := by
      intro j hj
      rcases hedge i₀ hi₀ j hj with ⟨_, hjC, _⟩ | ⟨hni, _, _⟩
      · exact hjC
      · exact False.elim (hni hiC)
    have htrue : ∀ i ∈ A, C i := by
      intro i hi
      rcases hedge i hi j₀ hj₀ with ⟨hiC, _, _⟩ | ⟨_, hjC, _⟩
      · exact hiC
      · exact False.elim (hfalse j₀ hj₀ hjC)
    exact directed A B hAS hBS hA hB htrue hfalse hedge
  · have htrue : ∀ j ∈ B, C j := by
      intro j hj
      rcases hedge i₀ hi₀ j hj with ⟨hiC', _, _⟩ | ⟨_, hjC, _⟩
      · exact False.elim (hiC hiC')
      · exact hjC
    have hfalse : ∀ i ∈ A, ¬ C i := by
      intro i hi
      rcases hedge i hi j₀ hj₀ with ⟨_, hjC, _⟩ | ⟨hiC', _, _⟩
      · exact False.elim (hjC (htrue j₀ hj₀))
      · exact hiC'
    have h := directed B A hBS hAS hB hA htrue hfalse
      (fun j hj i hi => cross_symmetric C g b t (hedge i hi j hj))
    omega

theorem bound (C : ℕ → Prop) (S : Finset ℕ) (f : ℕ → Option (ZMod r)) (g : ℕ → ZMod q)
    (hf : LayerInjective C S f) (hg : LayerInjective C S g) (hr : Odd r)
    (a : ZMod r) (b : ZMod q) (s t : ℕ) (hs : s + 2 ≤ r) (ht : t < q) (hne : s ≠ t) :
    BicliqueBound (Edge C f g a b s t) S (s + t + 1) := by
  apply P14TwoLayerBiclique.combine _ C S s t hne
  · intro A hAS B hBS hA hB hdis hedge
    apply within_bound C S f hf hr a s hs A hAS B hBS hA hB hdis
    intro i hi j hj
    have h := hedge i hi j hj
    rcases h.1 with hw | hc
    · exact hw
    · exact False.elim (within_not_across h.2 (cross_across hc))
  · intro A hAS B hBS hA hB hdis hedge
    apply cross_bound C S g hg b t ht A hAS B hBS hA hB hdis
    intro i hi j hj
    have h := hedge i hi j hj
    rcases h.1 with hw | hc
    · exact False.elim (within_not_across hw.1 h.2)
    · exact hc

end P14LayerBlockBiclique

end
end

section

/-! Actual odd-order annuli within two layers and consecutive cross-layer
matchings. Zero-width blocks are allowed. Unequal internal and cross degrees
give the required combined biclique bound without a supplied bound premise. -/

noncomputable section
namespace P14OddLayerBlockBiclique
open P14BicliqueComplementConnection P14TwoLayerBiclique P14LayerBlockBiclique
open P14OddCyclicAnnulus
variable {q : ℕ} [NeZero q]

def WithinEdge (C : ℕ → Prop) (g : ℕ → ZMod q) (a l i j : ℕ) : Prop :=
  Within C i j ∧ g j - g i ∈ annulus a l

def Edge (C : ℕ → Prop) (g : ℕ → ZMod q) (a l : ℕ) (b : ZMod q)
    (t i j : ℕ) : Prop :=
  WithinEdge C g a l i j ∨ CrossEdge C g b t i j

theorem within_symmetric (C : ℕ → Prop) (g : ℕ → ZMod q) (a l : ℕ)
    {i j : ℕ} (h : WithinEdge C g a l i j) : WithinEdge C g a l j i := by
  refine ⟨?_, ?_⟩
  · rcases h.1 with ⟨hi, hj⟩ | ⟨hi, hj⟩
    · exact Or.inl ⟨hj, hi⟩
    · exact Or.inr ⟨hj, hi⟩
  · simpa only [neg_sub] using neg_mem a l h.2

theorem within_irreflexive (C : ℕ → Prop) (g : ℕ → ZMod q) (a l : ℕ)
    (ha : 1 ≤ a) (hlimit : 2 * (a + l) ≤ q + 1) (i : ℕ) :
    ¬ WithinEdge C g a l i i := by
  intro h
  by_cases hl : l = 0
  · obtain ⟨r, har, hrl, _⟩ := (mem_iff a l _).mp h.2
    omega
  · exact zero_not_mem a l ha (by omega) hlimit (by simpa using h.2)

theorem within_bound (C : ℕ → Prop) (S : Finset ℕ) (g : ℕ → ZMod q)
    (hg : LayerInjective C S g) (hq : Odd q) (a l : ℕ)
    (ha : 1 ≤ a) (hlimit : 2 * (a + l) ≤ q + 1) :
    BicliqueBound (WithinEdge C g a l) S (2 * l + 1) := by
  classical
  intro A hAS B hBS hA hB _ hedge
  obtain ⟨i₀, hi₀⟩ := hA
  obtain ⟨j₀, hj₀⟩ := hB
  have hA : A.Nonempty := ⟨i₀, hi₀⟩
  have hB : B.Nonempty := ⟨j₀, hj₀⟩
  have hl : 1 ≤ l := by
    obtain ⟨r, har, hrl, _⟩ := (mem_iff a l _).mp (hedge i₀ hi₀ j₀ hj₀).2
    omega
  have hia : Set.InjOn g A := by
    intro i hi j hj he
    exact hg i (hAS hi) j (hAS hj)
      ((same_layer (hedge i hi j₀ hj₀).1).trans
        (same_layer (hedge j hj j₀ hj₀).1).symm) he
  have hib : Set.InjOn g B := by
    intro i hi j hj he
    exact hg i (hBS hi) j (hBS hj)
      ((same_layer (hedge i₀ hi₀ i hi).1).symm.trans
        (same_layer (hedge i₀ hi₀ j hj).1)) he
  have he : ∀ x ∈ A.image g, ∀ y ∈ B.image g, y - x ∈ annulus a l := by
    intro x hx y hy
    obtain ⟨i, hi, rfl⟩ := Finset.mem_image.mp hx
    obtain ⟨j, hj, rfl⟩ := Finset.mem_image.mp hy
    exact (hedge i hi j hj).2
  have h := biclique_bound hq a l ha hl hlimit (A.image g) (B.image g)
    (hA.image _) (hB.image _) he
  rwa [Finset.card_image_of_injOn hia, Finset.card_image_of_injOn hib] at h

theorem edge_symmetric (C : ℕ → Prop) (g : ℕ → ZMod q) (a l : ℕ)
    (b : ZMod q) (t : ℕ) {i j : ℕ} (h : Edge C g a l b t i j) :
    Edge C g a l b t j i := by
  rcases h with hw | hc
  · exact Or.inl (within_symmetric C g a l hw)
  · exact Or.inr (cross_symmetric C g b t hc)

theorem edge_irreflexive (C : ℕ → Prop) (g : ℕ → ZMod q) (a l : ℕ)
    (b : ZMod q) (t : ℕ) (ha : 1 ≤ a) (hlimit : 2 * (a + l) ≤ q + 1)
    (i : ℕ) : ¬ Edge C g a l b t i i := by
  rintro (hw | hc)
  · exact within_irreflexive C g a l ha hlimit i hw
  · rcases hc with ⟨hi, hni, _⟩ | ⟨hni, hi, _⟩ <;> exact hni hi

theorem bound (C : ℕ → Prop) (S : Finset ℕ) (g : ℕ → ZMod q)
    (hg : LayerInjective C S g) (hq : Odd q) (a l : ℕ) (b : ZMod q) (t : ℕ)
    (ha : 1 ≤ a) (hlimit : 2 * (a + l) ≤ q + 1) (ht : t < q)
    (hne : 2 * l ≠ t) : BicliqueBound (Edge C g a l b t) S (2 * l + t + 1) := by
  apply P14TwoLayerBiclique.combine _ C S (2 * l) t hne
  · intro A hAS B hBS hA hB hdis hedge
    apply within_bound C S g hg hq a l ha hlimit A hAS B hBS hA hB hdis
    intro i hi j hj
    have h := hedge i hi j hj
    rcases h.1 with hw | hc
    · exact hw
    · exact False.elim (within_not_across h.2 (cross_across hc))
  · intro A hAS B hBS hA hB hdis hedge
    apply cross_bound C S g hg b t ht A hAS B hBS hA hB hdis
    intro i hi j hj
    have h := hedge i hi j hj
    rcases h.1 with hw | hc
    · exact False.elim (within_not_across hw.1 h.2)
    · exact hc

end P14OddLayerBlockBiclique

end
end

section

/-! Explicit common labels for two odd cyclic layers and Nat-labelled
ordinary graphs. The equivalence, casts and layerwise injectivity are proved,
so all local constructions can use the same physical rows. -/

namespace P14OddLayerLabels
open P14TwoLayerBiclique P14LayerBlockBiclique
variable {q : ℕ} [NeZero q]

def rowEquiv (q : ℕ) : (Fin q ⊕ Fin q) ≃ Fin (2 * q) :=
  finSumFinEquiv.trans (finCongr (by omega))

def encode (v : Fin q ⊕ Fin q) : ℕ := (rowEquiv q v).val

@[simp] theorem encode_inl (x : Fin q) : encode (Sum.inl x) = x.val := rfl
@[simp] theorem encode_inr (x : Fin q) : encode (Sum.inr x) = q + x.val := rfl

def Side (q i : ℕ) : Prop := i < q
def index (q i : ℕ) : ℕ := if i < q then i else i - q
def label (q i : ℕ) : ZMod q := (index q i : ZMod q)
def cast (i : Fin q) : ZMod q := (i.val : ZMod q)

@[simp] theorem side_inl (x : Fin q) : Side q (encode (Sum.inl x)) := x.isLt
@[simp] theorem side_inr (x : Fin q) : ¬ Side q (encode (Sum.inr x)) := by
  change ¬ q + x.val < q
  omega

@[simp] theorem label_inl (x : Fin q) : label q (encode (Sum.inl x)) = cast x := by
  simp [label, index, x.isLt, cast]

@[simp] theorem label_inr (x : Fin q) : label q (encode (Sum.inr x)) = cast x := by
  have h : ¬ q + x.val < q := by omega
  simp [label, index, h, cast]

theorem cast_add (i j : Fin q) : cast (i + j) = cast i + cast j := by
  unfold cast
  rw [Fin.val_add, ZMod.natCast_mod, Nat.cast_add]

theorem cast_sub (i j : Fin q) : cast (i - j) = cast i - cast j := by
  have h := cast_add (i - j) j
  rw [sub_add_cancel] at h
  exact (eq_sub_iff_add_eq).mpr h.symm

theorem cast_injective : Function.Injective (cast (q := q)) := by
  intro i j he
  have hv := congrArg ZMod.val he
  change ((i.val : ZMod q)).val = ((j.val : ZMod q)).val at hv
  rw [ZMod.val_natCast_of_lt i.isLt, ZMod.val_natCast_of_lt j.isLt] at hv
  exact Fin.ext hv

theorem index_lt (i : ℕ) (hi : i < 2 * q) : index q i < q := by
  by_cases h : i < q <;> simp only [index, h, ite_true, ite_false] <;> omega

theorem labels_injective : LayerInjective (Side q) (Finset.range (2 * q)) (label q) := by
  intro i hi j hj hc he
  have hi' := index_lt i (Finset.mem_range.mp hi)
  have hj' := index_lt j (Finset.mem_range.mp hj)
  have hv := congrArg ZMod.val he
  change ((index q i : ZMod q)).val = ((index q j : ZMod q)).val at hv
  rw [ZMod.val_natCast_of_lt hi', ZMod.val_natCast_of_lt hj'] at hv
  change (i < q ↔ j < q) at hc
  by_cases h : i < q
  · have h' := hc.mp h
    simpa only [index, if_pos h, if_pos h'] using hv
  · have h' : ¬ j < q := fun hjq => h (hc.mpr hjq)
    simp only [index, if_neg h, if_neg h'] at hv
    omega

theorem within_inl (a l : ℕ) (i j : Fin q) :
    P14OddLayerBlockBiclique.WithinEdge (Side q) (label q) a l
      (encode (Sum.inl i)) (encode (Sum.inl j)) ↔
      cast j - cast i ∈ P14OddCyclicAnnulus.annulus a l := by
  simp only [P14OddLayerBlockBiclique.WithinEdge, Within, side_inl,
    not_true_eq_false, and_self, or_false, true_and, label_inl]

theorem within_inr (a l : ℕ) (i j : Fin q) :
    P14OddLayerBlockBiclique.WithinEdge (Side q) (label q) a l
      (encode (Sum.inr i)) (encode (Sum.inr j)) ↔
      cast j - cast i ∈ P14OddCyclicAnnulus.annulus a l := by
  simp only [P14OddLayerBlockBiclique.WithinEdge, Within, side_inr,
    false_and, not_false_eq_true, and_self, false_or, true_and, label_inr]

theorem cross_inl_inr (b : ZMod q) (t : ℕ) (i j : Fin q) :
    CrossEdge (Side q) (label q) b t (encode (Sum.inl i)) (encode (Sum.inr j)) ↔
      cast j - cast i ∈ P14CyclicArc.arc b t := by
  simp only [CrossEdge, side_inl, side_inr, label_inl, label_inr,
    not_false_eq_true, not_true_eq_false, true_and, false_and, or_false, false_or]

theorem cross_inr_inl (b : ZMod q) (t : ℕ) (i j : Fin q) :
    CrossEdge (Side q) (label q) b t (encode (Sum.inr i)) (encode (Sum.inl j)) ↔
      cast i - cast j ∈ P14CyclicArc.arc b t := by
  simp only [CrossEdge, side_inl, side_inr, label_inl, label_inr,
    not_false_eq_true, not_true_eq_false, true_and, false_and, or_false, false_or]

end P14OddLayerLabels

end

section

/-! Split the actual higher-dimensional graph complement into an ordinary
prefix and explicit remaining steps and offsets. The cross arc wraps at zero. -/

noncomputable section
namespace P14HighDimensionComplementSplit
open P14OddLayerLabels P14HighDimensionLocalFactor P14PrismRemainderCover
open P14OddCyclicAnnulus
variable {q : ℕ} [NeZero q]

theorem step_split {X N : ℕ} (a : Fin N → Fin q)
    (ha : ∀ i, (a i).val = X + 2 + i.val) (z : Fin q)
    (hz : 2 ≤ z.val) (hzN : z.val < X + N + 2) (i j : Fin q)
    (he : j = i + z ∨ i = j + z) :
    cast j - cast i ∈ annulus 2 X ∨ ∃ k, j = i + a k ∨ i = j + a k := by
  by_cases hzX : z.val < X + 2
  · left
    apply (mem_iff 2 X _).mpr
    refine ⟨z.val, hz, by omega, ?_⟩
    rcases he with h | h
    · left
      rw [h, cast_add, add_sub_cancel_left]
      rfl
    · right
      rw [h, cast_add]
      change cast j - (cast j + (z.val : ZMod q)) = -(z.val : ZMod q)
      abel
  · let k : Fin N := ⟨z.val - X - 2, by omega⟩
    have hk : a k = z := by
      apply Fin.ext
      rw [ha]
      dsimp [k]
      omega
    exact Or.inr ⟨k, by rwa [hk]⟩

theorem cross_index {d : ℕ} (hd : 2 ≤ d) (hdq : d ≤ q) (k : Fin q)
    (hnot : ¬ (1 ≤ k.val ∧ k.val ≤ d - 2)) :
    ∃ s : Fin (q - d + 2), ((d - 1 + s.val : ℕ) : ZMod q) = cast k := by
  by_cases hk : k.val = 0
  · refine ⟨⟨q - d + 1, by omega⟩, ?_⟩
    have he : d - 1 + (q - d + 1) = q := by omega
    change ((d - 1 + (q - d + 1) : ℕ) : ZMod q) = (k.val : ZMod q)
    rw [he, ZMod.natCast_self, hk, Nat.cast_zero]
  · refine ⟨⟨k.val + 1 - d, by have h := k.isLt; omega⟩, ?_⟩
    have he : d - 1 + (k.val + 1 - d) = k.val := by omega
    change ((d - 1 + (k.val + 1 - d) : ℕ) : ZMod q) = (k.val : ZMod q)
    rw [he]

theorem cross_split {d T B : ℕ} (hd : 2 ≤ d) (hdq : d ≤ q)
    (b : Fin B → Fin q) (hB : T + B = q - d + 2)
    (hb : ∀ j, cast (b j) = ((d - 1 + T + j.val : ℕ) : ZMod q)) (i j : Fin q) :
    (1 ≤ (j - i).val ∧ (j - i).val ≤ d - 2) ∨
      cast j - cast i ∈ P14CyclicArc.arc ((d - 1 : ℕ) : ZMod q) T ∨
      ∃ k, j = i + b k := by
  by_cases hp : 1 ≤ (j - i).val ∧ (j - i).val ≤ d - 2
  · exact Or.inl hp
  right
  obtain ⟨s, hs⟩ := cross_index hd hdq (j - i) hp
  by_cases hst : s.val < T
  · left
    apply Finset.mem_image.mpr
    refine ⟨s.val, Finset.mem_range.mpr hst, ?_⟩
    rw [← cast_sub]
    simpa only [Nat.cast_add] using hs
  · right
    let k : Fin B := ⟨s.val - T, by have h := s.isLt; omega⟩
    have hk : b k = j - i := by
      apply cast_injective
      rw [hb]
      have he : d - 1 + T + k.val = d - 1 + s.val := by dsimp [k]; omega
      rw [he]
      exact hs
    exact ⟨k, by rw [hk, add_sub_cancel]⟩

theorem cover {d X T N B : ℕ} (hq : 7 ≤ q) (ho : Odd q)
    (hd : 6 ≤ d) (hdq : d ≤ q) (a : Fin N → Fin q) (b : Fin B → Fin q)
    (hN : X + N = P14HighDimensionQubitCover.layerCount q) (hB : T + B = q - d + 2)
    (ha : ∀ i, (a i).val = X + 2 + i.val)
    (hb : ∀ j, cast (b j) = ((d - 1 + T + j.val : ℕ) : ZMod q))
    (u v : Fin q ⊕ Fin q) (hne : u ≠ v) :
    Prescribed d u v ∨
      P14OddLayerBlockBiclique.Edge (Side q) (label q) 2 X ((d - 1 : ℕ) : ZMod q) T
        (encode u) (encode v) ∨
      (∃ i, Inside (a i) u v) ∨ (∃ j, Cross (b j) u v) := by
  have internal (i j : Fin q) (hne : i ≠ j) :
      (j = i + 1 ∨ i = j + 1) ∨ cast j - cast i ∈ annulus 2 X ∨
        ∃ k, j = i + a k ∨ i = j + a k := by
    rcases P14HighDimensionQubitCover.internal_cover hq ho i j hne with h | ⟨k, hk⟩
    · exact Or.inl h
    · right
      apply step_split a ha (P14HighDimensionQubitCover.step hq k)
        (by dsimp [P14HighDimensionQubitCover.step]; omega) ?_ i j hk
      have hki := k.isLt
      change k.val + 2 < X + N + 2
      omega
  cases u with
  | inl i =>
    cases v with
    | inl j =>
      rcases internal i j (fun h => hne (congrArg Sum.inl h)) with h | h | ⟨k, hk⟩
      · exact Or.inl h
      · exact Or.inr (Or.inl (Or.inl ((within_inl 2 X i j).mpr h)))
      · exact Or.inr (Or.inr (Or.inl ⟨k, hk⟩))
    | inr j =>
      rcases cross_split (by omega : 2 ≤ d) hdq b hB hb i j with h | h | ⟨k, hk⟩
      · exact Or.inl h
      · exact Or.inr (Or.inl (Or.inr ((cross_inl_inr _ T i j).mpr h)))
      · exact Or.inr (Or.inr (Or.inr ⟨k, hk⟩))
  | inr i =>
    cases v with
    | inl j =>
      rcases cross_split (by omega : 2 ≤ d) hdq b hB hb j i with h | h | ⟨k, hk⟩
      · exact Or.inl h
      · exact Or.inr (Or.inl (Or.inr ((cross_inr_inl _ T i j).mpr h)))
      · exact Or.inr (Or.inr (Or.inr ⟨k, hk⟩))
    | inr j =>
      rcases internal i j (fun h => hne (congrArg Sum.inr h)) with h | h | ⟨k, hk⟩
      · exact Or.inl h
      · exact Or.inr (Or.inl (Or.inl ((within_inr 2 X i j).mpr h)))
      · exact Or.inr (Or.inr (Or.inl ⟨k, hk⟩))

end P14HighDimensionComplementSplit
end
end

section

/-! The complete higher-dimensional complement when d<q. Three consecutive
cross shifts complete q reflection rounds; every other cross shift is one
additional matching. This removes the former prism-capacity restriction. -/

noncomputable section
namespace P14HighDimensionThreeShiftCover
open P14HighDimensionLocalFactor P14OddLayerLabels P14PrismRemainderCover
variable {q : ℕ} [NeZero q]

def offset (d s : ℕ) : Fin q :=
  ⟨(d - 1 + s) % q, Nat.mod_lt _ (NeZero.pos q)⟩

theorem cast_offset (d s : ℕ) :
    cast (offset (q := q) d s) = ((d - 1 + s : ℕ) : ZMod q) := by
  simp [offset, P14OddLayerLabels.cast, ZMod.natCast_mod]

theorem first_three {d : ℕ} (hd : 2 ≤ d) (hdq : d < q)
    (s : ℕ) (hs : s < 3) :
    offset (q := q) d s = ⟨d, hdq⟩ ∨
    offset (q := q) d s = (⟨d, hdq⟩ : Fin q) + 1 ∨
    offset (q := q) d s + 1 = (⟨d, hdq⟩ : Fin q) := by
  have h1 : cast (1 : Fin q) = 1 := by
    simp [P14OddLayerLabels.cast, Fin.val_one', ZMod.natCast_mod]
  have hb : cast (⟨d, hdq⟩ : Fin q) = (d : ZMod q) := rfl
  have he : s = 0 ∨ s = 1 ∨ s = 2 := by omega
  rcases he with rfl | rfl | rfl
  · right; right
    apply cast_injective
    rw [cast_add, cast_offset, h1, hb]
    have hn : d - 1 + 0 + 1 = d := by omega
    simpa only [Nat.cast_add, Nat.cast_one] using
      congrArg (fun n : ℕ => (n : ZMod q)) hn
  · left
    apply cast_injective
    rw [cast_offset, hb]
    congr 1
    omega
  · right; left
    apply cast_injective
    rw [cast_offset, cast_add, hb, h1]
    have hn : d - 1 + 2 = d + 1 := by omega
    rw [hn, Nat.cast_add, Nat.cast_one]

theorem exists_cover {d : ℕ} (hd : 6 ≤ d) (hdq : d < q) :
    ∃ F : Fin (2 * q - d - 1) → (Fin q ⊕ Fin q) → (Fin q ⊕ Fin q),
      (∀ c, Function.Involutive (F c)) ∧ (∀ c x, F c x ≠ x) ∧
      ∀ x y, x ≠ y → Prescribed d x y ∨ ∃ c, F c x = y := by
  classical
  let b : Fin q := ⟨d, hdq⟩
  let Colors := Fin q ⊕ Fin (q - d - 1)
  let all : Colors → (Fin q ⊕ Fin q) → (Fin q ⊕ Fin q) :=
    Sum.elim (P14ReflectionThreeShift.shifted b)
      (fun j => crossMatching (offset d (3 + j.val)))
  have hall (c : Colors) : Function.Involutive (all c) := by
    cases c with
    | inl c => exact P14ReflectionThreeShift.shifted_involutive b c
    | inr j => exact cross_involutive _
  have hne (c : Colors) (x : Fin q ⊕ Fin q) : all c x ≠ x := by
    cases c with
    | inl c => exact P14ReflectionThreeShift.shifted_fixedPointFree b c x
    | inr j => exact cross_ne _ x
  have cross (a z : Fin q) : Prescribed d (.inl a) (.inr z) ∨
      ∃ c : Colors, all c (.inl a) = .inr z := by
    by_cases hp : 1 ≤ (z - a).val ∧ (z - a).val ≤ d - 2
    · exact Or.inl hp
    right
    obtain ⟨s, hs⟩ := P14HighDimensionComplementSplit.cross_index
      (by omega : 2 ≤ d) (by omega : d ≤ q) (z - a) hp
    have he : offset d s.val = z - a := cast_injective ((cast_offset d s.val).trans hs)
    by_cases h3 : s.val < 3
    · have hh := first_three (by omega : 2 ≤ d) hdq s.val h3
      rw [he] at hh
      have ht : z - b = a ∨ z - b = a + 1 ∨ a = (z - b) + 1 := by
        change z - a = b ∨ z - a = b + 1 ∨ (z - a) + 1 = b at hh
        rcases hh with h | h | h
        · left
          rw [← h]
          abel
        · right; left
          calc
            z - b = ((z - a) + a) - b := by abel
            _ = ((b + 1) + a) - b := by rw [h]
            _ = a + 1 := by abel
        · right; right
          rw [← h]
          abel
      obtain ⟨c, hc⟩ := P14ReflectionThreeShift.shifted_cross b a z ht
      exact ⟨.inl c, hc⟩
    · let j : Fin (q - d - 1) := ⟨s.val - 3, by have h := s.isLt; omega⟩
      have hj : 3 + j.val = s.val := by dsimp [j]; omega
      refine ⟨.inr j, ?_⟩
      change Sum.inr (a + offset d (3 + j.val)) = .inr z
      rw [hj, he, add_sub_cancel]
  have cover (x y : Fin q ⊕ Fin q) (hxy : x ≠ y) :
      Prescribed d x y ∨ ∃ c : Colors, all c x = y := by
    cases x with
    | inl a =>
      cases y with
      | inl z =>
        by_cases hc : z = a + 1 ∨ a = z + 1
        · exact Or.inl hc
        · have ha : a ≠ z := fun h => hxy (congrArg Sum.inl h)
          obtain ⟨c, he⟩ := (P14ReflectionThreeShift.shifted_within b a z ha
            (fun h => hc (Or.inl h)) (fun h => hc (Or.inr h))).1
          exact Or.inr ⟨.inl c, he⟩
      | inr z => exact cross a z
    | inr a =>
      cases y with
      | inl z =>
        rcases cross z a with hp | ⟨c, hc⟩
        · exact Or.inl hp
        · right
          refine ⟨c, ?_⟩
          rw [← hc]
          exact hall c _
      | inr z =>
        by_cases hc : z = a + 1 ∨ a = z + 1
        · exact Or.inl hc
        · have ha : a ≠ z := fun h => hxy (congrArg Sum.inr h)
          obtain ⟨c, he⟩ := (P14ReflectionThreeShift.shifted_within b a z ha
            (fun h => hc (Or.inl h)) (fun h => hc (Or.inr h))).2
          exact Or.inr ⟨.inl c, he⟩
  have hcard : Fintype.card Colors = 2 * q - d - 1 := by
    simp only [Colors, Fintype.card_sum, Fintype.card_fin]
    omega
  let e : Fin (2 * q - d - 1) ≃ Colors := (Fintype.equivFinOfCardEq hcard).symm
  refine ⟨fun c => all (e c), fun c => hall (e c), fun c => hne (e c), ?_⟩
  intro x y hxy
  rcases cover x y hxy with h | ⟨c, hc⟩
  · exact Or.inl h
  · exact Or.inr ⟨e.symm c, by simpa only [Equiv.apply_symm_apply] using hc⟩

end P14HighDimensionThreeShiftCover
end
end

section

/-! Canonical coordinate UPBs for the checked higher-dimensional factor
and its explicit three-cross-shift complement for every dimension below q. -/

noncomputable section
namespace P14HighDimensionThreeShiftUPB
open P14ComplexLocalCover P14HighDimensionLocalFactor
open P14CanonicalUPBTransport
open scoped BigOperators

def dimensions (d q : ℕ) : Fin ((2 * q - d - 1) + 1) → ℕ :=
  Fin.cons d (fun _ => 2)

def caps (d q : ℕ) : Fin ((2 * q - d - 1) + 1) → ℕ :=
  Fin.cons d (fun _ => 1)

theorem sum_caps (d q : ℕ) : (∑ j, caps d q j) = d + (2 * q - d - 1) := by
  simp [caps, Fin.sum_univ_succ]

theorem sum_deficits {d q : ℕ} (hd : 6 ≤ d) (hdq : d ≤ q) :
    2 + (∑ j, (dimensions d q j - 1)) = 2 * q := by
  simp only [dimensions, Fin.sum_univ_succ, Fin.cons_zero, Fin.cons_succ]
  simp only [Nat.reduceSub, Finset.sum_const, Finset.card_univ, Fintype.card_fin,
    smul_eq_mul, mul_one]
  omega

theorem canonical {n q : ℕ} (hq : 7 ≤ q) (ho : Odd q)
    (hdq : n + 6 < q) :
    Conclusion ((2 * q - (n + 6) - 1) + 1) (dimensions (n + 6) q) := by
  classical
  letI : NeZero q := ⟨by omega⟩
  obtain ⟨F, hF, hn, hc⟩ := P14HighDimensionThreeShiftCover.exists_cover (by omega) hdq
  let R : Fin ((2 * q - (n + 6) - 1) + 1) →
      (Fin q ⊕ Fin q) → (Fin q ⊕ Fin q) → Prop :=
    Fin.cons (Prescribed (n + 6)) (fun c x y => F c x = y)
  have hlocal : ∀ j, HasLocalFactor (Fin q ⊕ Fin q)
      (dimensions (n + 6) q j) (caps (n + 6) q j) (R j) := by
    intro j
    refine Fin.cases ?_ (fun c => ?_) j
    · exact exists_factor hq ho (by omega)
    · exact P14MatchingLocalFactor.on_finite (F c) (hF c) (hn c)
  have hcover : ∀ x y : Fin q ⊕ Fin q, x ≠ y → ∃ j, R j x y := by
    intro x y hxy
    rcases hc x y hxy with h | ⟨c, hc⟩
    · exact ⟨0, h⟩
    · exact ⟨c.succ, hc⟩
  have hcard : Fintype.card (Fin q ⊕ Fin q) = 2 * q := by simp [two_mul]
  have hbudget : (∑ j, caps (n + 6) q j) < Fintype.card (Fin q ⊕ Fin q) := by
    rw [sum_caps, hcard]
    omega
  have hbound : Fintype.card (Fin q ⊕ Fin q) ≤
      2 + ∑ j, (dimensions (n + 6) q j - 1) := by
    rw [hcard, sum_deficits (by omega) (by omega : n + 6 ≤ q)]
  exact P14ComplexLocalCover.canonical (dimensions (n + 6) q) (caps (n + 6) q) R
    hlocal hcover hbudget hbound

end P14HighDimensionThreeShiftUPB
end
end

section

/-! Allocate prescribed total layer degree without splitting any local
degree into equal halves. One odd local degree fills the possible midpoint
gaps of all the others. No graph-existence assertion is included. -/

noncomputable section
namespace P14UnequalBlockAllocation
open scoped BigOperators

def Allowed (r a : ℕ) : Prop := a ≤ r ∧ a ≠ r - a

theorem allowed_of_odd {r a : ℕ} (hr : Odd r) (ha : a ≤ r) : Allowed r a := by
  obtain ⟨k, hk⟩ := hr
  constructor
  · exact ha
  · omega

theorem extend_interval (M r n : ℕ) (hM : 1 ≤ M) (hr : 0 < r)
    (hn : n ≤ M + r) :
    ∃ a b : ℕ, a ≤ M ∧ Allowed r b ∧ a + b = n := by
  by_cases hnr : n ≤ r
  · by_cases hmid : n = r - n
    · refine ⟨1, n - 1, hM, ?_, ?_⟩
      · constructor <;> omega
      · omega
    · exact ⟨0, n, by omega, ⟨hnr, hmid⟩, by omega⟩
  · exact ⟨n - r, r, by omega, ⟨le_rfl, by omega⟩, by omega⟩

theorem allocate_with_interval {ι : Type*} (S : Finset ι) (r : ι → ℕ)
    (M : ℕ) (hM : 1 ≤ M) (hr : ∀ i ∈ S, 0 < r i)
    (n : ℕ) (hn : n ≤ M + ∑ i ∈ S, r i) :
    ∃ a : ℕ, a ≤ M ∧ ∃ x : ι → ℕ,
      (∀ i ∈ S, Allowed (r i) (x i)) ∧ a + (∑ i ∈ S, x i) = n := by
  classical
  induction S using Finset.induction_on generalizing n with
  | empty =>
      refine ⟨n, by simpa using hn, fun _ => 0, ?_, ?_⟩
      · simp
      · simp
  | @insert i S hi ih =>
      have hni : n ≤ (M + ∑ j ∈ S, r j) + r i := by
        rw [Finset.sum_insert hi] at hn
        omega
      obtain ⟨u, b, hu, hb, hub⟩ := extend_interval (M + ∑ j ∈ S, r j) (r i) n
        (by omega) (hr i (Finset.mem_insert_self _ _)) hni
      obtain ⟨a, ha, x, hx, hax⟩ := ih (fun j hj => hr j (Finset.mem_insert_of_mem hj)) u hu
      have hupdate : (∑ j ∈ S, Function.update x i b j) = ∑ j ∈ S, x j := by
        apply Finset.sum_congr rfl
        intro j hj
        exact Function.update_of_ne (fun h : j = i => hi (h ▸ hj)) b x
      refine ⟨a, ha, Function.update x i b, ?_, ?_⟩
      · intro j hj
        rcases Finset.mem_insert.mp hj with rfl | hj
        · simpa using hb
        · rw [Function.update_of_ne (fun h : j = i => hi (h ▸ hj))]
          exact hx j hj
      · rw [Finset.sum_insert hi, Function.update_self, hupdate]
        omega

theorem allocate {ι : Type*} (S : Finset ι) (r : ι → ℕ)
    (hr : ∀ i ∈ S, 0 < r i) (hodd : ∃ i ∈ S, Odd (r i))
    (n : ℕ) (hn : n ≤ ∑ i ∈ S, r i) :
    ∃ x : ι → ℕ, (∀ i ∈ S, Allowed (r i) (x i)) ∧ (∑ i ∈ S, x i) = n := by
  classical
  obtain ⟨i, hi, hri⟩ := hodd
  have hsum := Finset.sum_erase_add S r hi
  have hn' : n ≤ r i + ∑ j ∈ S.erase i, r j := by omega
  obtain ⟨a, ha, x, hx, hax⟩ := allocate_with_interval (S.erase i) r (r i)
    (hr i hi) (fun j hj => hr j (Finset.mem_of_mem_erase hj)) n hn'
  have hupdate : (∑ j ∈ S.erase i, Function.update x i a j) = ∑ j ∈ S.erase i, x j := by
    apply Finset.sum_congr rfl
    intro j hj
    exact Function.update_of_ne (Finset.mem_erase.mp hj).1 a x
  refine ⟨Function.update x i a, ?_, ?_⟩
  · intro j hj
    by_cases hji : j = i
    · subst j
      simpa using allowed_of_odd hri ha
    · rw [Function.update_of_ne hji]
      exact hx j (Finset.mem_erase.mpr ⟨hji, hj⟩)
  · have hy := Finset.sum_erase_add S (Function.update x i a) hi
    rw [hupdate, Function.update_self] at hy
    omega

end P14UnequalBlockAllocation

end
end

section

/-! Allocate even within-layer degrees while avoiding equality with the
cross degree. A single odd deficit fills midpoint gaps. An explicit capacity
condition leaves enough cross matchings to pair each unused layer step into
a three-matching prism. No graph existence is assumed or asserted here. -/

noncomputable section
namespace P14OddLayerAllocation
open scoped BigOperators

def Allowed (r x : ℕ) : Prop := x ≤ r / 2 ∧ 4 * x ≠ r

theorem allowed_of_odd {r x : ℕ} (hr : Odd r) (hx : x ≤ r / 2) : Allowed r x := by
  obtain ⟨k, hk⟩ := hr
  constructor <;> omega

theorem extend_interval (M r n : ℕ) (hM : 1 ≤ M) (hr : 2 ≤ r)
    (hn : n ≤ M + r / 2) :
    ∃ a b : ℕ, a ≤ M ∧ Allowed r b ∧ a + b = n := by
  by_cases hnr : n ≤ r / 2
  · by_cases hmid : 4 * n = r
    · refine ⟨1, n - 1, hM, ?_, ?_⟩
      · constructor <;> omega
      · omega
    · exact ⟨0, n, by omega, ⟨hnr, hmid⟩, by omega⟩
  · refine ⟨n - r / 2, r / 2, by omega, ?_, by omega⟩
    constructor <;> omega

theorem allocate_with_interval {ι : Type*} (S : Finset ι) (r : ι → ℕ)
    (M : ℕ) (hM : 1 ≤ M) (hr : ∀ i ∈ S, 2 ≤ r i)
    (n : ℕ) (hn : n ≤ M + ∑ i ∈ S, r i / 2) :
    ∃ a : ℕ, a ≤ M ∧ ∃ x : ι → ℕ,
      (∀ i ∈ S, Allowed (r i) (x i)) ∧ a + (∑ i ∈ S, x i) = n := by
  classical
  induction S using Finset.induction_on generalizing n with
  | empty =>
      refine ⟨n, by simpa using hn, fun _ => 0, ?_, ?_⟩
      · simp
      · simp
  | @insert i S hi ih =>
      have hni : n ≤ (M + ∑ j ∈ S, r j / 2) + r i / 2 := by
        rw [Finset.sum_insert hi] at hn
        omega
      obtain ⟨u, b, hu, hb, hub⟩ := extend_interval (M + ∑ j ∈ S, r j / 2) (r i) n
        (by omega) (hr i (Finset.mem_insert_self _ _)) hni
      obtain ⟨a, ha, x, hx, hax⟩ := ih (fun j hj => hr j (Finset.mem_insert_of_mem hj)) u hu
      have hupdate : (∑ j ∈ S, Function.update x i b j) = ∑ j ∈ S, x j := by
        apply Finset.sum_congr rfl
        intro j hj
        exact Function.update_of_ne (fun h : j = i => hi (h ▸ hj)) b x
      refine ⟨a, ha, Function.update x i b, ?_, ?_⟩
      · intro j hj
        rcases Finset.mem_insert.mp hj with rfl | hj
        · simpa using hb
        · rw [Function.update_of_ne (fun h : j = i => hi (h ▸ hj))]
          exact hx j hj
      · rw [Finset.sum_insert hi, Function.update_self, hupdate]
        omega

theorem allocate {ι : Type*} (S : Finset ι) (r : ι → ℕ)
    (hr : ∀ i ∈ S, 2 ≤ r i) (hodd : ∃ i ∈ S, Odd (r i))
    (n : ℕ) (hn : n ≤ ∑ i ∈ S, r i / 2) :
    ∃ x : ι → ℕ, (∀ i ∈ S, Allowed (r i) (x i)) ∧ (∑ i ∈ S, x i) = n := by
  classical
  obtain ⟨i, hi, hri⟩ := hodd
  have hsum := Finset.sum_erase_add S (fun j => r j / 2) hi
  have hn' : n ≤ r i / 2 + ∑ j ∈ S.erase i, r j / 2 := by omega
  obtain ⟨a, ha, x, hx, hax⟩ := allocate_with_interval (S.erase i) r (r i / 2)
    (by have h := hr i hi; omega) (fun j hj => hr j (Finset.mem_of_mem_erase hj)) n hn'
  have hupdate : (∑ j ∈ S.erase i, Function.update x i a j) = ∑ j ∈ S.erase i, x j := by
    apply Finset.sum_congr rfl
    intro j hj
    exact Function.update_of_ne (Finset.mem_erase.mp hj).1 a x
  refine ⟨Function.update x i a, ?_, ?_⟩
  · intro j hj
    by_cases hji : j = i
    · subst j
      simpa using allowed_of_odd hri ha
    · rw [Function.update_of_ne hji]
      exact hx j (Finset.mem_erase.mpr ⟨hji, hj⟩)
  · have hy := Finset.sum_erase_add S (Function.update x i a) hi
    rw [hupdate, Function.update_self] at hy
    omega

theorem parity_capacity {ι : Type*} (S : Finset ι) (r : ι → ℕ) :
    (∑ i ∈ S, r i) = 2 * (∑ i ∈ S, r i / 2) + ∑ i ∈ S, r i % 2 := by
  rw [Finset.mul_sum, ← Finset.sum_add_distrib]
  apply Finset.sum_congr rfl
  intro i _
  omega

theorem allocate_with_prisms {ι : Type*} (S : Finset ι) (r : ι → ℕ)
    (L C m : ℕ) (hr : ∀ i ∈ S, 2 ≤ r i) (ho : ∃ i ∈ S, Odd (r i))
    (hdegree : 2 * L + C = (∑ i ∈ S, r i) + m)
    (hcapacity : L + (∑ i ∈ S, r i % 2) ≤ C) :
    ∃ x t : ι → ℕ, ∃ N B : ℕ,
      (∀ i ∈ S, 2 * x i + t i = r i ∧ 2 * x i ≠ t i) ∧
      (∑ i ∈ S, x i) + N = L ∧ (∑ i ∈ S, t i) + B = C ∧
      N ≤ B ∧ 3 * N + (B - N) = m := by
  classical
  let K := ∑ i ∈ S, r i / 2
  let X := min L K
  obtain ⟨x, hx, hsum⟩ := allocate S r hr ho X (min_le_right _ _)
  let t : ι → ℕ := fun i => r i - 2 * x i
  have hparts : ∀ i ∈ S, 2 * x i + t i = r i ∧ 2 * x i ≠ t i := by
    intro i hi
    have h := hx i hi
    dsimp only [Allowed] at h
    dsimp only [t]
    constructor <;> omega
  have htotal : 2 * X + (∑ i ∈ S, t i) = ∑ i ∈ S, r i := by
    rw [← hsum, Finset.mul_sum, ← Finset.sum_add_distrib]
    exact Finset.sum_congr rfl (fun i hi => (hparts i hi).1)
  have hX : X ≤ L := min_le_left _ _
  have hparity := parity_capacity S r
  have hcross : (∑ i ∈ S, t i) ≤ C := by
    by_cases hLK : L ≤ K
    · have he : X = L := min_eq_left hLK
      omega
    · have he : X = K := min_eq_right (by omega)
      dsimp only [K] at he
      omega
  have hNB : L - X ≤ C - (∑ i ∈ S, t i) := by
    by_cases hLK : L ≤ K
    · have he : X = L := min_eq_left hLK
      omega
    · have he : X = K := min_eq_right (by omega)
      dsimp only [K] at he
      omega
  refine ⟨x, t, L - X, C - (∑ i ∈ S, t i), hparts, ?_, ?_, hNB, ?_⟩ <;> omega

theorem five_capacity {ι : Type*} (S : Finset ι) (r : ι → ℕ)
    (q m : ℕ) (hq : 7 ≤ q) (ho : Odd q) (hr : ∀ i ∈ S, 4 ≤ r i)
    (htotal : (∑ i ∈ S, r i) + m = 2 * q - 6) :
    (q - 5) / 2 + (∑ i ∈ S, r i % 2) ≤ q - 1 := by
  have he : 5 * (∑ i ∈ S, r i % 2) ≤ ∑ i ∈ S, r i := by
    rw [Finset.mul_sum]
    apply Finset.sum_le_sum
    intro i hi
    have h := hr i hi
    omega
  obtain ⟨k, hk⟩ := ho
  omega

end P14OddLayerAllocation

end
end

section

/-! Non-dominant widths without an odd-deficit seed. Work backward from
full capacity, leaving one interval of width one. Its sole possible balanced
case has deficit four and is handled by the balanced dimension-five graph. -/

noncomputable section
namespace P14BalancedLayerAllocation
open scoped BigOperators

def Allowed (r x : ℕ) : Prop := x ≤ r / 2 ∧ (4 * x ≠ r ∨ r = 4)

theorem complement {r x : ℕ} (h : Allowed r x) : Allowed r (r / 2 - x) := by
  rcases h with ⟨hx, hn | hr⟩
  · constructor
    · omega
    · left
      omega
  · constructor
    · omega
    · exact Or.inr hr

theorem allocate {ι : Type*} (S : Finset ι) (r : ι → ℕ) (L : ℕ)
    (hr : ∀ i ∈ S, 4 ≤ r i) (hm : ∀ i ∈ S, r i / 2 ≤ L + 1) :
    ∃ x : ι → ℕ, (∀ i ∈ S, Allowed (r i) (x i)) ∧
      (∑ i ∈ S, x i) = min L (∑ i ∈ S, r i / 2) := by
  classical
  rcases S.eq_empty_or_nonempty with rfl | hS
  · refine ⟨fun _ => 0, ?_, ?_⟩ <;> simp
  obtain ⟨i, hi⟩ := hS
  let K := ∑ j ∈ S, r j / 2
  let X := min L K
  have hsum := Finset.sum_erase_add S (fun j => r j / 2) hi
  have hri := hr i hi
  have hmi := hm i hi
  have hiK : r i / 2 ≤ K := by dsimp only [K]; omega
  have hXi : r i / 2 ≤ X + 1 := by dsimp only [X]; omega
  have hY : K - X ≤ 1 + ∑ j ∈ S.erase i, r j / 2 := by
    dsimp only [K] at *
    omega
  obtain ⟨a, ha, x, hx, hax⟩ := P14OddLayerAllocation.allocate_with_interval
    (S.erase i) r 1 (by omega) (fun j hj => by
      have h := hr j (Finset.mem_of_mem_erase hj); omega) (K - X) hY
  let y : ι → ℕ := Function.update x i a
  have hy : ∀ j ∈ S, Allowed (r j) (y j) := by
    intro j hj
    by_cases hji : j = i
    · subst j
      simp only [y, Function.update_self]
      constructor
      · omega
      · by_cases he : r i = 4
        · exact Or.inr he
        · left
          omega
    · rw [show y j = x j from Function.update_of_ne hji a x]
      have h := hx j (Finset.mem_erase.mpr ⟨hji, hj⟩)
      exact ⟨h.1, Or.inl h.2⟩
  have hupdate : (∑ j ∈ S.erase i, y j) = ∑ j ∈ S.erase i, x j := by
    apply Finset.sum_congr rfl
    intro j hj
    exact Function.update_of_ne (Finset.mem_erase.mp hj).1 a x
  have hysum : (∑ j ∈ S, y j) = K - X := by
    have h := Finset.sum_erase_add S y hi
    rw [hupdate, show y i = a from Function.update_self ..] at h
    omega
  refine ⟨fun j => r j / 2 - y j, fun j hj => complement (hy j hj), ?_⟩
  have he : (∑ j ∈ S, (r j / 2 - y j)) + (∑ j ∈ S, y j) = K := by
    rw [← Finset.sum_add_distrib]
    exact Finset.sum_congr rfl (fun j hj => Nat.sub_add_cancel (hy j hj).1)
  have hX : X ≤ K := min_le_right _ _
  change (∑ j ∈ S, (r j / 2 - y j)) = X
  omega

theorem allocate_with_prisms {ι : Type*} (S : Finset ι) (r : ι → ℕ)
    (L C m : ℕ) (hr : ∀ i ∈ S, 4 ≤ r i) (hm : ∀ i ∈ S, r i / 2 ≤ L + 1)
    (hdegree : 2 * L + C = (∑ i ∈ S, r i) + m)
    (hcapacity : L + (∑ i ∈ S, r i % 2) ≤ C) :
    ∃ x t : ι → ℕ, ∃ N B : ℕ,
      (∀ i ∈ S, 2 * x i + t i = r i ∧ (2 * x i ≠ t i ∨ r i = 4)) ∧
      (∑ i ∈ S, x i) + N = L ∧ (∑ i ∈ S, t i) + B = C ∧
      N ≤ B ∧ 3 * N + (B - N) = m := by
  classical
  let K := ∑ i ∈ S, r i / 2
  let X := min L K
  obtain ⟨x, hx, hsum⟩ := allocate S r L hr hm
  change (∑ i ∈ S, x i) = X at hsum
  let t : ι → ℕ := fun i => r i - 2 * x i
  have hparts : ∀ i ∈ S, 2 * x i + t i = r i ∧ (2 * x i ≠ t i ∨ r i = 4) := by
    intro i hi
    have h := hx i hi
    dsimp only [Allowed] at h
    dsimp only [t]
    refine ⟨by omega, ?_⟩
    rcases h.2 with hn | he
    · left
      omega
    · exact Or.inr he
  have htotal : 2 * X + (∑ i ∈ S, t i) = ∑ i ∈ S, r i := by
    rw [← hsum, Finset.mul_sum, ← Finset.sum_add_distrib]
    exact Finset.sum_congr rfl (fun i hi => (hparts i hi).1)
  have hX : X ≤ L := min_le_left _ _
  have hparity := P14OddLayerAllocation.parity_capacity S r
  have hcross : (∑ i ∈ S, t i) ≤ C := by
    by_cases hLK : L ≤ K
    · have he : X = L := min_eq_left hLK
      omega
    · have he : X = K := min_eq_right (by omega)
      dsimp only [K] at he
      omega
  have hNB : L - X ≤ C - (∑ i ∈ S, t i) := by
    by_cases hLK : L ≤ K
    · have he : X = L := min_eq_left hLK
      omega
    · have he : X = K := min_eq_right (by omega)
      dsimp only [K] at he
      omega
  refine ⟨x, t, L - X, C - (∑ i ∈ S, t i), hparts, ?_, ?_, hNB, ?_⟩ <;> omega

end P14BalancedLayerAllocation

end
end

section

/-! A sharper prism capacity inequality for mixed higher dimensions.
The presence of one ordinary factor of at least the exceptional dimension
supplies the capacity missing from the qubit-only construction. -/

noncomputable section
namespace P14HighDimensionAllocation
open scoped BigOperators

theorem allocate {ι : Type*} (S : Finset ι) (r : ι → ℕ)
    (L C m : ℕ) (hr : ∀ i ∈ S, 5 ≤ r i) (hm : ∀ i ∈ S, r i / 2 ≤ L + 1)
    (hdegree : 2 * L + C = (∑ i ∈ S, r i) + m)
    (hcapacity : L + (∑ i ∈ S, r i % 2) ≤ C + (∑ i ∈ S, r i / 2)) :
    ∃ x t : ι → ℕ, ∃ N B : ℕ,
      (∀ i ∈ S, 2 * x i + t i = r i ∧ 2 * x i ≠ t i) ∧
      (∑ i ∈ S, x i) + N = L ∧ (∑ i ∈ S, t i) + B = C ∧
      N ≤ B ∧ 3 * N + (B - N) = m := by
  classical
  let K := ∑ i ∈ S, r i / 2
  let X := min L K
  obtain ⟨x, hx, hsum⟩ := P14BalancedLayerAllocation.allocate S r L
    (fun i hi => by have h := hr i hi; omega) hm
  change (∑ i ∈ S, x i) = X at hsum
  let t : ι → ℕ := fun i => r i - 2 * x i
  have hparts : ∀ i ∈ S, 2 * x i + t i = r i ∧ 2 * x i ≠ t i := by
    intro i hi
    have h := hx i hi
    have hr' := hr i hi
    dsimp only [P14BalancedLayerAllocation.Allowed] at h
    dsimp only [t]
    constructor <;> omega
  have htotal : 2 * X + (∑ i ∈ S, t i) = ∑ i ∈ S, r i := by
    rw [← hsum, Finset.mul_sum, ← Finset.sum_add_distrib]
    exact Finset.sum_congr rfl (fun i hi => (hparts i hi).1)
  have hX : X ≤ L := min_le_left _ _
  have hparity := P14OddLayerAllocation.parity_capacity S r
  have hcross : (∑ i ∈ S, t i) ≤ C := by
    by_cases hLK : L ≤ K
    · have he : X = L := min_eq_left hLK
      omega
    · have he : X = K := min_eq_right (by omega)
      dsimp only [K] at *
      omega
  have hNB : L - X ≤ C - (∑ i ∈ S, t i) := by
    by_cases hLK : L ≤ K
    · have he : X = L := min_eq_left hLK
      omega
    · have he : X = K := min_eq_right (by omega)
      dsimp only [K] at *
      omega
  refine ⟨x, t, L - X, C - (∑ i ∈ S, t i), hparts, ?_, ?_, hNB, ?_⟩ <;> omega

theorem capacity {ι : Type*} (S : Finset ι) (hS : S.Nonempty) (r : ι → ℕ)
    {q d : ℕ} (hq : 7 ≤ q) (ho : Odd q) (hd : 6 ≤ d) (hdq : d ≤ q)
    (hr : ∀ i ∈ S, d - 1 ≤ r i) :
    P14HighDimensionQubitCover.layerCount q + (∑ i ∈ S, r i % 2) ≤
      (q - d + 2) + (∑ i ∈ S, r i / 2) := by
  classical
  let T := ∑ i ∈ S, (r i / 2 - r i % 2)
  have hsplit : (∑ i ∈ S, r i / 2) = T + (∑ i ∈ S, r i % 2) := by
    rw [← Finset.sum_add_distrib]
    apply Finset.sum_congr rfl
    intro i hi
    have h := hr i hi
    omega
  obtain ⟨i, hi⟩ := hS
  have hri := hr i hi
  have hT : r i / 2 - r i % 2 ≤ T :=
    Finset.single_le_sum (f := fun j => r j / 2 - r j % 2) (fun j _ => Nat.zero_le _) hi
  have hL := P14HighDimensionQubitCover.layer_count hq ho
  omega

theorem construct {q d p m : ℕ} (hq : 7 ≤ q) (ho : Odd q) (hd : 6 ≤ d)
    (hdq : d ≤ q) (hp : 0 < p) (r : Fin p → ℕ)
    (hr : ∀ i, d - 1 ≤ r i) (hu : ∀ i, r i ≤ q - 1)
    (htotal : (∑ i, r i) + m = 2 * q - d - 1) :
    ∃ x t : Fin p → ℕ, ∃ N B : ℕ,
      (∀ i, 2 * x i + t i = r i ∧ 2 * x i ≠ t i) ∧
      (∑ i, x i) + N = P14HighDimensionQubitCover.layerCount q ∧
      (∑ i, t i) + B = q - d + 2 ∧ N ≤ B ∧ 3 * N + (B - N) = m := by
  classical
  have hL := P14HighDimensionQubitCover.layer_count hq ho
  have hc := capacity Finset.univ ⟨⟨0, hp⟩, Finset.mem_univ _⟩ r
    hq ho hd hdq (fun i _ => hr i)
  obtain ⟨x, t, N, B, hpart, hN, hB, hNB, hm⟩ :=
    allocate Finset.univ r (P14HighDimensionQubitCover.layerCount q) (q - d + 2) m
      (fun i _ => by have h := hr i; omega)
      (fun i _ => by have h := hu i; omega) (by omega) hc
  exact ⟨x, t, N, B, fun i => hpart i (Finset.mem_univ i), hN, hB, hNB, hm⟩

end P14HighDimensionAllocation
end
end

section

/-! Remove the ordinary-dimension upper bound. A dominant ordinary factor
absorbs all available layer steps; every other factor uses only cross edges. -/

noncomputable section
namespace P14HighDimensionFlexibleAllocation
open scoped BigOperators

theorem construct {q d p m : ℕ} (hq : 7 ≤ q) (ho : Odd q) (hd : 6 ≤ d)
    (hdq : d ≤ q) (hp : 0 < p) (r : Fin p → ℕ)
    (hr : ∀ i, d - 1 ≤ r i) (htotal : (∑ i, r i) + m = 2 * q - d - 1) :
    ∃ x t : Fin p → ℕ, ∃ N B : ℕ,
      (∀ i, 2 * x i + t i = r i ∧ 2 * x i ≠ t i) ∧
      (∑ i, x i) + N = P14HighDimensionQubitCover.layerCount q ∧
      (∑ i, t i) + B = q - d + 2 ∧ N ≤ B ∧ 3 * N + (B - N) = m := by
  classical
  by_cases hu : ∀ i, r i ≤ q - 1
  · exact P14HighDimensionAllocation.construct hq ho hd hdq hp r hr hu htotal
  push_neg at hu
  obtain ⟨a, ha⟩ := hu
  let L := P14HighDimensionQubitCover.layerCount q
  have hL : 2 * L + 3 = q := P14HighDimensionQubitCover.layer_count hq ho
  let x : Fin p → ℕ := fun i => if i = a then L else 0
  let t : Fin p → ℕ := fun i => r i - 2 * x i
  have hra : r a ≤ ∑ i, r i :=
    Finset.single_le_sum (f := r) (fun i _ => Nat.zero_le _) (Finset.mem_univ a)
  have hparts (i : Fin p) : 2 * x i + t i = r i ∧ 2 * x i ≠ t i := by
    by_cases hi : i = a
    · subst i
      have hx : x a = L := by simp [x]
      change 2 * x a + (r a - 2 * x a) = r a ∧ 2 * x a ≠ r a - 2 * x a
      rw [hx]
      constructor <;> omega
    · have hri := hr i
      have hx : x i = 0 := by simp [x, hi]
      change 2 * x i + (r i - 2 * x i) = r i ∧ 2 * x i ≠ r i - 2 * x i
      rw [hx]
      constructor <;> omega
  have hx : (∑ i, x i) = L := by simp [x]
  have ht : 2 * L + (∑ i, t i) = ∑ i, r i := by
    rw [← hx, Finset.mul_sum, ← Finset.sum_add_distrib]
    exact Finset.sum_congr rfl (fun i _ => (hparts i).1)
  refine ⟨x, t, 0, m, hparts, ?_, ?_, by omega, by omega⟩
  · simpa only [Nat.add_zero] using hx
  · omega

end P14HighDimensionFlexibleAllocation
end
end

section

/-! Actual leftover step prisms and qubit matchings for the unrestricted higher-dimensional
mixed allocation. Cross offsets are cyclic and may wrap through zero. -/

noncomputable section
namespace P14HighDimensionFlexibleRemainder
open P14PrismRemainderCover P14OddLayerLabels
open scoped BigOperators

theorem construct {q d p m : ℕ} [NeZero q] (hq : 7 ≤ q) (ho : Odd q)
    (hd : 6 ≤ d) (hdq : d ≤ q) (hp : 0 < p) (r : Fin p → ℕ)
    (hr : ∀ i, d - 1 ≤ r i)
    (htotal : (∑ i, r i) + m = 2 * q - d - 1) :
    ∃ x t : Fin p → ℕ, ∃ N B : ℕ,
      ∃ a : Fin N → Fin q, ∃ b : Fin B → Fin q,
      ∃ F : Fin m → (Fin q ⊕ Fin q) → (Fin q ⊕ Fin q),
      (∀ i, 2 * x i + t i = r i ∧ 2 * x i ≠ t i) ∧
      (∑ i, x i) + N = P14HighDimensionQubitCover.layerCount q ∧
      (∑ i, t i) + B = q - d + 2 ∧ N ≤ B ∧
      (∀ i, (a i).val = (∑ j, x j) + 2 + i.val) ∧
      (∀ j, cast (b j) = ((d - 1 + (∑ i, t i) + j.val : ℕ) : ZMod q)) ∧
      (∀ c, Function.Involutive (F c)) ∧ (∀ c v, F c v ≠ v) ∧
      (∀ u v, ((∃ i, Inside (a i) u v) ∨ (∃ j, Cross (b j) u v)) ↔
        ∃ c, F c u = v) := by
  classical
  have hL := P14HighDimensionQubitCover.layer_count hq ho
  obtain ⟨x, t, N, B, hpart, hN, hB, hNB, hm⟩ :=
    P14HighDimensionFlexibleAllocation.construct hq ho hd hdq hp r hr htotal
  let a : Fin N → Fin q := fun i =>
    ⟨(∑ j, x j) + 2 + i.val, by have hi := i.isLt; omega⟩
  let b : Fin B → Fin q := fun j =>
    ⟨(d - 1 + (∑ i, t i) + j.val) % q, Nat.mod_lt _ (NeZero.pos q)⟩
  have ha : ∀ i, a i ≠ 0 := by
    intro i he
    have hv := congrArg Fin.val he
    change (∑ j, x j) + 2 + i.val = 0 at hv
    omega
  have hb (j : Fin B) : cast (b j) = ((d - 1 + (∑ i, t i) + j.val : ℕ) : ZMod q) := by
    simp only [P14OddLayerLabels.cast, b, ZMod.natCast_mod]
  obtain ⟨G, hG, hGne, hGC⟩ := P14PrismRemainderCover.exists_cover (by omega) ho a b ha hNB
  let e : Fin (3 * N + (B - N)) ≃ Fin m := finCongr hm
  let F : Fin m → (Fin q ⊕ Fin q) → (Fin q ⊕ Fin q) := fun c => G (e.symm c)
  refine ⟨x, t, N, B, a, b, F, hpart, hN, hB, hNB, fun _ => rfl, hb,
    fun c => hG (e.symm c), fun c => hGne (e.symm c), ?_⟩
  intro u v
  rw [hGC]
  constructor
  · rintro ⟨c, hc⟩
    exact ⟨e c, by simpa only [F, Equiv.symm_apply_apply] using hc⟩
  · rintro ⟨c, hc⟩
    exact ⟨e.symm c, hc⟩

end P14HighDimensionFlexibleRemainder
end
end

section

/-! Cumulative finite offset intervals cover their literal prefixSum interval.
Reduction modulo n permits wrapping; zero-length blocks are allowed. -/

namespace P14CyclicOffsetIntervalCover

open scoped BigOperators

def prefixSum (length : ℕ → ℕ) (m : ℕ) : ℕ :=
  ∑ i ∈ Finset.range m, length i

theorem prefix_succ (length : ℕ → ℕ) (m : ℕ) :
    prefixSum length (m + 1) = prefixSum length m + length m :=
  Finset.sum_range_succ length m

private theorem exists_nat_block (length : ℕ → ℕ) (m : ℕ) :
    ∀ q : ℕ, q < prefixSum length m →
      ∃ i : ℕ, i < m ∧ ∃ t : ℕ, t < length i ∧ q = prefixSum length i + t := by
  induction m with
  | zero =>
      intro q hq
      simp [prefixSum] at hq
  | succ m ih =>
      intro q hq
      by_cases hlt : q < prefixSum length m
      · obtain ⟨i, hi, t, ht, hqt⟩ := ih q hlt
        exact ⟨i, Nat.lt_succ_of_lt hi, t, ht, hqt⟩
      · refine ⟨m, Nat.lt_succ_self m, q - prefixSum length m, ?_, ?_⟩
        · rw [prefix_succ] at hq
          omega
        · omega

theorem exists_prefix_block (length : ℕ → ℕ) (m q : ℕ)
    (hq : q < prefixSum length m) :
    ∃ i : Fin m, ∃ t : Fin (length i.val),
      q = prefixSum length i.val + t.val := by
  obtain ⟨i, hi, t, ht, hqt⟩ := exists_nat_block length m q hq
  exact ⟨⟨i, hi⟩, ⟨t, ht⟩, hqt⟩

theorem cyclic_interval_cover {n : ℕ} [NeZero n]
    (length : ℕ → ℕ) (m : ℕ) (δ : Fin n)
    (hlength : ∀ i < m, length i ≤ n) (q : ℕ)
    (hq : q < prefixSum length m) :
    ∃ i : Fin m, ∃ t : Fin (length i.val),
      δ + Fin.ofNat n q =
        (δ + Fin.ofNat n (prefixSum length i.val)) +
          t.castLE (hlength i.val i.isLt) := by
  obtain ⟨i, t, hqt⟩ := exists_prefix_block length m q hq
  refine ⟨i, t, ?_⟩
  rw [hqt, add_assoc, Fin.ofNat_add]
  rfl

theorem full_cycle_cover {n : ℕ} [NeZero n]
    (length : ℕ → ℕ) (m : ℕ) (δ : Fin n)
    (hlength : ∀ i < m, length i ≤ n)
    (htotal : n ≤ prefixSum length m) (w : Fin n) :
    ∃ i : Fin m, ∃ t : Fin (length i.val),
      w = (δ + Fin.ofNat n (prefixSum length i.val)) +
        t.castLE (hlength i.val i.isLt) := by
  have hq : (w - δ).val < prefixSum length m :=
    lt_of_lt_of_le (w - δ).isLt htotal
  obtain ⟨i, t, h⟩ := cyclic_interval_cover length m δ hlength (w - δ).val hq
  have hw : δ + Fin.ofNat n (w - δ).val = w := by
    rw [Fin.ofNat_val_eq_self]
    calc
      δ + (w - δ) = (w - δ) + δ := add_comm _ _
      _ = w := sub_add_cancel w δ
  exact ⟨i, t, hw.symm.trans h⟩

end P14CyclicOffsetIntervalCover

end

section

/-! Consecutive arcs from exact prefix sums form an actual disjoint
partition of a cyclic interval of length at most the modulus. Empty
blocks are permitted. -/

noncomputable section
namespace P14CyclicArcPartition
open P14CyclicArc P14CyclicOffsetIntervalCover
open scoped BigOperators
variable {q : ℕ} [NeZero q]

theorem prefix_mono (length : ℕ → ℕ) {i m : ℕ} (hi : i ≤ m) :
    prefixSum length i ≤ prefixSum length m := by
  apply Finset.sum_le_sum_of_subset
  exact Finset.range_mono hi

theorem prefix_end (length : ℕ → ℕ) {i m : ℕ} (hi : i < m) :
    prefixSum length i + length i ≤ prefixSum length m := by
  rw [← prefix_succ]
  exact prefix_mono length (by omega)

theorem block_subset (length : ℕ → ℕ) (m : ℕ) (a : ZMod q) (i : ℕ) (hi : i < m) :
    arc (a + (prefixSum length i : ZMod q)) (length i) ⊆ arc a (prefixSum length m) := by
  intro x hx
  obtain ⟨t, ht, rfl⟩ := Finset.mem_image.mp hx
  have ht' := Finset.mem_range.mp ht
  have hp := prefix_end length hi
  refine Finset.mem_image.mpr ⟨prefixSum length i + t, Finset.mem_range.mpr (by omega), ?_⟩
  rw [Nat.cast_add]
  abel

theorem cover (length : ℕ → ℕ) (m : ℕ) (a x : ZMod q) :
    x ∈ arc a (prefixSum length m) ↔
      ∃ i : ℕ, i < m ∧ x ∈ arc (a + (prefixSum length i : ZMod q)) (length i) := by
  constructor
  · intro hx
    obtain ⟨n, hn, rfl⟩ := Finset.mem_image.mp hx
    obtain ⟨i, t, he⟩ := exists_prefix_block length m n (Finset.mem_range.mp hn)
    refine ⟨i.val, i.isLt, Finset.mem_image.mpr ⟨t.val, Finset.mem_range.mpr t.isLt, ?_⟩⟩
    rw [he, Nat.cast_add]
    abel
  · rintro ⟨i, hi, hx⟩
    exact block_subset length m a i hi hx

theorem disjoint_blocks (length : ℕ → ℕ) (m : ℕ) (a : ZMod q)
    (htotal : prefixSum length m ≤ q) (i j : ℕ) (hi : i < m) (hj : j < m) (hne : i ≠ j) :
    Disjoint (arc (a + (prefixSum length i : ZMod q)) (length i))
      (arc (a + (prefixSum length j : ZMod q)) (length j)) := by
  apply Finset.disjoint_left.mpr
  intro x hxi hxj
  obtain ⟨u, hu, heu⟩ := Finset.mem_image.mp hxi
  obtain ⟨v, hv, hev⟩ := Finset.mem_image.mp hxj
  have hu' := Finset.mem_range.mp hu
  have hv' := Finset.mem_range.mp hv
  have hpi := prefix_end length hi
  have hpj := prefix_end length hj
  have he : ((prefixSum length i + u : ℕ) : ZMod q) =
      ((prefixSum length j + v : ℕ) : ZMod q) := by
    apply add_left_cancel (a := a)
    rw [Nat.cast_add, Nat.cast_add]
    calc
      a + ((prefixSum length i : ZMod q) + (u : ZMod q)) =
          (a + (prefixSum length i : ZMod q)) + (u : ZMod q) := by abel
      _ = x := heu
      _ = (a + (prefixSum length j : ZMod q)) + (v : ZMod q) := hev.symm
      _ = a + ((prefixSum length j : ZMod q) + (v : ZMod q)) := by abel
  have hn := congrArg ZMod.val he
  rw [ZMod.val_natCast_of_lt (by omega), ZMod.val_natCast_of_lt (by omega)] at hn
  rcases lt_or_gt_of_ne hne with hij | hji
  · have horder := prefix_mono length (show i + 1 ≤ j by omega)
    rw [prefix_succ] at horder
    omega
  · have horder := prefix_mono length (show j + 1 ≤ i by omega)
    rw [prefix_succ] at horder
    omega

end P14CyclicArcPartition

end
end

section

/-! Prefix blocks partition the actual within/cross edge relation. The
edge partition includes literal coverage and uniqueness, not only degree
totals. -/

noncomputable section
namespace P14LayerBlockPartition
open P14CyclicArc P14CyclicOffsetIntervalCover P14LayerBlockBiclique
open P14BicliqueComplementConnection
variable {r q : ℕ} [NeZero r] [NeZero q]

theorem round_cover (length : ℕ → ℕ) (m : ℕ) (a : ZMod r) (x y : Option (ZMod r)) :
    P14CyclicRoundBlock.Edge a (prefixSum length m) x y ↔
      ∃ i : ℕ, i < m ∧ P14CyclicRoundBlock.Edge
        (a + (prefixSum length i : ZMod r)) (length i) x y := by
  cases x with
  | none =>
    cases y with
    | none => simp [P14CyclicRoundBlock.Edge]
    | some y => exact P14CyclicArcPartition.cover length m a y
  | some x =>
    cases y with
    | none => exact P14CyclicArcPartition.cover length m a x
    | some y =>
      constructor
      · rintro ⟨hne, c, hc, he⟩
        obtain ⟨i, hi, hci⟩ := (P14CyclicArcPartition.cover length m a c).mp hc
        exact ⟨i, hi, hne, c, hci, he⟩
      · rintro ⟨i, hi, hne, c, hc, he⟩
        exact ⟨hne, c, P14CyclicArcPartition.block_subset length m a i hi hc, he⟩

theorem round_disjoint (hr : Odd r) (a b : ZMod r) (s t : ℕ)
    (hd : Disjoint (arc a s) (arc b t)) (x y : Option (ZMod r))
    (ha : P14CyclicRoundBlock.Edge a s x y) (hb : P14CyclicRoundBlock.Edge b t x y) : False := by
  cases x with
  | none =>
    cases y with
    | none => exact ha
    | some y => exact Finset.disjoint_left.mp hd ha hb
  | some x =>
    cases y with
    | none => exact Finset.disjoint_left.mp hd ha hb
    | some y =>
      obtain ⟨_, c, hc, hec⟩ := ha
      obtain ⟨_, d, hd', hed⟩ := hb
      have he : c = d := P14CyclicRoundBlock.doubling_injective hr (hec.symm.trans hed)
      exact Finset.disjoint_left.mp hd (he ▸ hc) hd'

theorem cross_cover (C : ℕ → Prop) (g : ℕ → ZMod q) (length : ℕ → ℕ)
    (m : ℕ) (b : ZMod q) (x y : ℕ) :
    CrossEdge C g b (prefixSum length m) x y ↔
      ∃ i : ℕ, i < m ∧ CrossEdge C g (b + (prefixSum length i : ZMod q)) (length i) x y := by
  constructor
  · rintro (⟨hx, hy, hm⟩ | ⟨hx, hy, hm⟩)
    · obtain ⟨i, hi, hmi⟩ := (P14CyclicArcPartition.cover length m b _).mp hm
      exact ⟨i, hi, Or.inl ⟨hx, hy, hmi⟩⟩
    · obtain ⟨i, hi, hmi⟩ := (P14CyclicArcPartition.cover length m b _).mp hm
      exact ⟨i, hi, Or.inr ⟨hx, hy, hmi⟩⟩
  · rintro ⟨i, hi, ⟨hx, hy, hm⟩ | ⟨hx, hy, hm⟩⟩
    · exact Or.inl ⟨hx, hy, P14CyclicArcPartition.block_subset length m b i hi hm⟩
    · exact Or.inr ⟨hx, hy, P14CyclicArcPartition.block_subset length m b i hi hm⟩

theorem edge_cover (C : ℕ → Prop) (f : ℕ → Option (ZMod r)) (g : ℕ → ZMod q)
    (s t : ℕ → ℕ) (m : ℕ) (a : ZMod r) (b : ZMod q) (x y : ℕ) :
    Edge C f g a b (prefixSum s m) (prefixSum t m) x y ↔
      ∃ i : ℕ, i < m ∧ Edge C f g
        (a + (prefixSum s i : ZMod r)) (b + (prefixSum t i : ZMod q)) (s i) (t i) x y := by
  constructor
  · rintro (⟨hw, he⟩ | hc)
    · obtain ⟨i, hi, hei⟩ := (round_cover s m a (f x) (f y)).mp he
      exact ⟨i, hi, Or.inl ⟨hw, hei⟩⟩
    · obtain ⟨i, hi, hci⟩ := (cross_cover C g t m b x y).mp hc
      exact ⟨i, hi, Or.inr hci⟩
  · rintro ⟨i, hi, ⟨hw, he⟩ | hc⟩
    · exact Or.inl ⟨hw, (round_cover s m a (f x) (f y)).mpr ⟨i, hi, he⟩⟩
    · exact Or.inr ((cross_cover C g t m b x y).mpr ⟨i, hi, hc⟩)

theorem edge_disjoint (C : ℕ → Prop) (f : ℕ → Option (ZMod r)) (g : ℕ → ZMod q)
    (hr : Odd r) (s t : ℕ → ℕ) (m : ℕ) (a : ZMod r) (b : ZMod q)
    (hs : prefixSum s m ≤ r) (ht : prefixSum t m ≤ q)
    (i j : ℕ) (hi : i < m) (hj : j < m) (hne : i ≠ j) (x y : ℕ)
    (he : Edge C f g (a + (prefixSum s i : ZMod r)) (b + (prefixSum t i : ZMod q)) (s i) (t i) x y)
    (he' : Edge C f g (a + (prefixSum s j : ZMod r)) (b + (prefixSum t j : ZMod q)) (s j) (t j) x y) : False := by
  rcases he with ⟨hw, hri⟩ | hci
  · rcases he' with ⟨_, hrj⟩ | hcj
    · exact round_disjoint hr _ _ _ _ (P14CyclicArcPartition.disjoint_blocks s m a hs i j hi hj hne)
        (f x) (f y) hri hrj
    · exact within_not_across hw (cross_across hcj)
  · rcases he' with ⟨hw, _⟩ | hcj
    · exact within_not_across hw (cross_across hci)
    · have hd := P14CyclicArcPartition.disjoint_blocks t m b ht i j hi hj hne
      rcases hci with ⟨hx, hy, hmi⟩ | ⟨hx, hy, hmi⟩
      · rcases hcj with ⟨_, _, hmj⟩ | ⟨hnx, _, _⟩
        · exact Finset.disjoint_left.mp hd hmi hmj
        · exact hnx hx
      · rcases hcj with ⟨hpx, _, _⟩ | ⟨_, _, hmj⟩
        · exact hx hpx
        · exact Finset.disjoint_left.mp hd hmi hmj

theorem partition (C : ℕ → Prop) (S : Finset ℕ)
    (f : ℕ → Option (ZMod r)) (g : ℕ → ZMod q)
    (hf : LayerInjective C S f) (hg : LayerInjective C S g) (hr : Odd r)
    (s t : ℕ → ℕ) (m : ℕ) (a : ZMod r) (b : ZMod q)
    (hs : ∀ i < m, s i + 2 ≤ r) (ht : ∀ i < m, t i < q)
    (hne : ∀ i < m, s i ≠ t i)
    (hsum : prefixSum s m ≤ r) (htsum : prefixSum t m ≤ q) :
    ∃ H : ℕ → ℕ → ℕ → Prop,
      (∀ i < m, (∀ {x y}, H i x y → H i y x) ∧ (∀ x, ¬ H i x x) ∧
        BicliqueBound (H i) S (s i + t i + 1)) ∧
      (∀ x y, Edge C f g a b (prefixSum s m) (prefixSum t m) x y ↔ ∃ i, i < m ∧ H i x y) ∧
      (∀ i < m, ∀ j < m, i ≠ j → ∀ x y, H i x y → H j x y → False) := by
  let H := fun i => Edge C f g (a + (prefixSum s i : ZMod r))
    (b + (prefixSum t i : ZMod q)) (s i) (t i)
  refine ⟨H, ?_, ?_, ?_⟩
  · intro i hi
    exact ⟨edge_symmetric C f g _ _ _ _, edge_irreflexive C f g _ _ _ _,
      bound C S f g hf hg hr _ _ _ _ (hs i hi) (ht i hi) (hne i hi)⟩
  · exact edge_cover C f g s t m a b
  · intro i hi j hj hij x y hix hjx
    exact edge_disjoint C f g hr s t m a b hsum htsum i j hi hj hij x y hix hjx

end P14LayerBlockPartition

end
end

section

/-! Prefix blocks cover the actual odd annulus/cross-interval relation.
Every block has its own proved biclique bound, including empty internal or
cross blocks. This supplies concrete ordinary graphs for later UPB assembly. -/

noncomputable section
namespace P14OddAnnulusBlocks
open P14CyclicOffsetIntervalCover P14CyclicArcPartition P14OddCyclicAnnulus
open P14LayerBlockBiclique P14OddLayerBlockBiclique P14BicliqueComplementConnection
variable {q : ℕ} [NeZero q]

theorem annulus_cover (length : ℕ → ℕ) (m a : ℕ) (z : ZMod q) :
    z ∈ annulus a (prefixSum length m) ↔
      ∃ i : ℕ, i < m ∧ z ∈ annulus (a + prefixSum length i) (length i) := by
  constructor
  · intro hz
    obtain ⟨r, har, hr, he⟩ := (mem_iff a (prefixSum length m) z).mp hz
    obtain ⟨i, t, hi⟩ := exists_prefix_block length m (r - a) (by omega)
    refine ⟨i.val, i.isLt, (mem_iff _ _ z).mpr ⟨r, ?_, ?_, he⟩⟩
    · have ht := t.isLt
      omega
    · have ht := t.isLt
      omega
  · rintro ⟨i, hi, hz⟩
    obtain ⟨r, har, hr, he⟩ := (mem_iff _ _ z).mp hz
    have hend := prefix_end length hi
    exact (mem_iff a (prefixSum length m) z).mpr ⟨r, by omega, by omega, he⟩

theorem edge_cover (C : ℕ → Prop) (g : ℕ → ZMod q) (s t : ℕ → ℕ)
    (m a : ℕ) (b : ZMod q) (x y : ℕ) :
    P14OddLayerBlockBiclique.Edge C g a (prefixSum s m) b (prefixSum t m) x y ↔
      ∃ i : ℕ, i < m ∧ P14OddLayerBlockBiclique.Edge C g
        (a + prefixSum s i) (s i) (b + (prefixSum t i : ZMod q)) (t i) x y := by
  constructor
  · rintro (⟨hw, he⟩ | hc)
    · obtain ⟨i, hi, hei⟩ := (annulus_cover s m a _).mp he
      exact ⟨i, hi, Or.inl ⟨hw, hei⟩⟩
    · obtain ⟨i, hi, hci⟩ := (P14LayerBlockPartition.cross_cover C g t m b x y).mp hc
      exact ⟨i, hi, Or.inr hci⟩
  · rintro ⟨i, hi, ⟨hw, he⟩ | hc⟩
    · exact Or.inl ⟨hw, (annulus_cover s m a _).mpr ⟨i, hi, he⟩⟩
    · exact Or.inr ((P14LayerBlockPartition.cross_cover C g t m b x y).mpr ⟨i, hi, hc⟩)

theorem exists_cover (C : ℕ → Prop) (S : Finset ℕ) (g : ℕ → ZMod q)
    (hg : LayerInjective C S g) (hq : Odd q) (s t : ℕ → ℕ)
    (m a : ℕ) (b : ZMod q) (ha : 1 ≤ a)
    (hsum : 2 * (a + prefixSum s m) ≤ q + 1)
    (ht : ∀ i < m, t i < q) (hne : ∀ i < m, 2 * s i ≠ t i) :
    ∃ H : ℕ → ℕ → ℕ → Prop,
      (∀ i < m, (∀ {x y}, H i x y → H i y x) ∧ (∀ x, ¬ H i x x) ∧
        BicliqueBound (H i) S (2 * s i + t i + 1)) ∧
      (∀ x y, P14OddLayerBlockBiclique.Edge C g a (prefixSum s m) b
        (prefixSum t m) x y ↔ ∃ i, i < m ∧ H i x y) := by
  let H := fun i => P14OddLayerBlockBiclique.Edge C g (a + prefixSum s i)
    (s i) (b + (prefixSum t i : ZMod q)) (t i)
  refine ⟨H, ?_, edge_cover C g s t m a b⟩
  intro i hi
  have hend := prefix_end s hi
  have ha' : 1 ≤ a + prefixSum s i := by omega
  have hlimit : 2 * (a + prefixSum s i + s i) ≤ q + 1 := by omega
  exact ⟨P14OddLayerBlockBiclique.edge_symmetric C g _ _ _ _,
    P14OddLayerBlockBiclique.edge_irreflexive C g _ _ _ _ ha' hlimit,
    P14OddLayerBlockBiclique.bound C S g hg hq _ _ _ _ ha' hlimit (ht i hi) (hne i hi)⟩

end P14OddAnnulusBlocks

end
end

section

/-! Complete graph cover for a minimal higher-dimensional exceptional factor,
ordinary factors of unrestricted dimensions, and arbitrary remaining qubits. -/

noncomputable section
namespace P14HighDimensionFlexibleGraphCover
open P14OddLayerLabels P14HighDimensionLocalFactor P14BicliqueComplementConnection
open P14CyclicOffsetIntervalCover
open scoped BigOperators

def lengths {p : ℕ} (x : Fin p → ℕ) (i : ℕ) : ℕ :=
  if hi : i < p then x ⟨i, hi⟩ else 0

@[simp] theorem lengths_fin {p : ℕ} (x : Fin p → ℕ) (i : Fin p) :
    lengths x i.val = x i := by simp [lengths, i.isLt]

theorem prefix_lengths {p : ℕ} (x : Fin p → ℕ) : prefixSum (lengths x) p = ∑ i, x i := by
  unfold prefixSum
  rw [← Fin.sum_univ_eq_sum_range]
  apply Finset.sum_congr rfl
  intro i _
  exact lengths_fin x i

theorem construct {q d p m : ℕ} [NeZero q] (hq : 7 ≤ q) (ho : Odd q)
    (hd : 6 ≤ d) (hdq : d ≤ q) (hp : 0 < p) (r : Fin p → ℕ)
    (hr : ∀ i, d - 1 ≤ r i)
    (htotal : (∑ i, r i) + m = 2 * q - d - 1) :
    ∃ H : Fin p → ℕ → ℕ → Prop,
      ∃ F : Fin m → (Fin q ⊕ Fin q) → (Fin q ⊕ Fin q),
      (∀ i, (∀ {u v}, H i u v → H i v u) ∧ (∀ u, ¬ H i u u) ∧
        BicliqueBound (H i) (Finset.range (2 * q)) (r i + 1)) ∧
      (∀ c, Function.Involutive (F c)) ∧ (∀ c u, F c u ≠ u) ∧
      (∀ u v, u ≠ v → Prescribed d u v ∨
        (∃ i, H i (encode u) (encode v)) ∨ (∃ c, F c u = v)) := by
  classical
  obtain ⟨x, t, N, B, a, b, F, hpart, hN, hB, _, ha, hb, hF, hFne, hFC⟩ :=
    P14HighDimensionFlexibleRemainder.construct hq ho hd hdq hp r hr htotal
  have hL := P14HighDimensionQubitCover.layer_count hq ho
  have hlimit : 2 * (2 + prefixSum (lengths x) p) ≤ q + 1 := by
    rw [prefix_lengths]
    omega
  have ht : ∀ i < p, lengths t i < q := by
    intro i hi
    have h := (hpart ⟨i, hi⟩).1
    have hle : t ⟨i, hi⟩ ≤ ∑ j, t j :=
      Finset.single_le_sum (f := t) (fun j _ => Nat.zero_le _) (Finset.mem_univ _)
    simp only [lengths, dif_pos hi]
    omega
  have hne : ∀ i < p, 2 * lengths x i ≠ lengths t i := by
    intro i hi
    simpa only [lengths, dif_pos hi] using (hpart ⟨i, hi⟩).2
  obtain ⟨K, hK, hKC⟩ := P14OddAnnulusBlocks.exists_cover (Side q)
    (Finset.range (2 * q)) (label q) labels_injective ho (lengths x) (lengths t)
    p 2 ((d - 1 : ℕ) : ZMod q) (by decide) hlimit ht hne
  have hKC' (u v : Fin q ⊕ Fin q) :
      P14OddLayerBlockBiclique.Edge (Side q) (label q) 2 (∑ i, x i)
        ((d - 1 : ℕ) : ZMod q) (∑ i, t i) (encode u) (encode v) ↔
          ∃ i, i < p ∧ K i (encode u) (encode v) := by
    simpa only [prefix_lengths] using hKC (encode u) (encode v)
  refine ⟨fun i => K i.val, F, ?_, hF, hFne, ?_⟩
  · intro i
    have hk := hK i.val i.isLt
    refine ⟨hk.1, hk.2.1, ?_⟩
    have hbound := hk.2.2
    rw [lengths_fin, lengths_fin, (hpart i).1] at hbound
    exact hbound
  · intro u v huv
    rcases P14HighDimensionComplementSplit.cover hq ho hd hdq a b hN hB ha hb u v huv with
      he | hord | hinside | hcross
    · exact Or.inl he
    · obtain ⟨i, hi, hedge⟩ := (hKC' u v).mp hord
      exact Or.inr (Or.inl ⟨⟨i, hi⟩, hedge⟩)
    · exact Or.inr (Or.inr ((hFC u v).mp (Or.inl hinside)))
    · exact Or.inr (Or.inr ((hFC u v).mp (Or.inr hcross)))

end P14HighDimensionFlexibleGraphCover
end
end

section

/-! Actual Gram determinants detect independence of finite real coordinate
families. Polynomial Gram determinants specialize to the same matrices.
No generic independence or rank witness is assumed. -/

namespace P14RealGramIndependence
open Matrix
open scoped BigOperators Matrix

def gramMatrix {R ι : Type*} [CommRing R] {d : ℕ}
    (v : ι → Fin d → R) : Matrix ι ι R := fun i j => ∑ k, v i k * v j k

theorem det_ne_zero_iff {ι : Type*} [Fintype ι] [DecidableEq ι] {d : ℕ}
    (v : ι → Fin d → ℝ) :
    (gramMatrix v).det ≠ 0 ↔ LinearIndependent ℝ v := by
  let A : Matrix (Fin d) ι ℝ := fun k i => v i k
  have hg : A.transpose * A = gramMatrix v := by
    ext i j
    rfl
  have hc : A.col = v := by
    funext i k
    rfl
  rw [← hg, ← isUnit_iff_ne_zero, ← Matrix.isUnit_iff_isUnit_det,
    ← Matrix.mulVec_injective_iff_isUnit]
  change Function.Injective (A.transpose * A).mulVecLin ↔ LinearIndependent ℝ v
  rw [← LinearMap.ker_eq_bot, Matrix.ker_mulVecLin_transpose_mul_self,
    LinearMap.ker_eq_bot]
  change Function.Injective A.mulVec ↔ LinearIndependent ℝ v
  rw [Matrix.mulVec_injective_iff, hc]

theorem eval_det_gram {σ ι : Type*} [Fintype ι] [DecidableEq ι] {d : ℕ}
    (P : ι → Fin d → MvPolynomial σ ℝ) (z : σ → ℝ) :
    MvPolynomial.eval z (gramMatrix P).det =
      (gramMatrix (fun i k => MvPolynomial.eval z (P i k))).det := by
  rw [(MvPolynomial.eval z).map_det]
  congr 1
  ext i j
  simp [gramMatrix]

end P14RealGramIndependence

end

section

/-! Choose a maximal nonzero Gram polynomial without assuming generic
independence. On its nonempty regular locus the chosen rows span every
candidate row. The zero locus is retained, not declared impossible. -/

noncomputable section
namespace P14PolynomialGramChoice
open MvPolynomial Submodule P14RealGramIndependence
open scoped BigOperators

variable {σ ι : Type*} [DecidableEq ι] {d : ℕ}

def rowsAt (P : ι → Fin d → MvPolynomial σ ℝ) (z : σ → ℝ) : ι → Fin d → ℝ :=
  fun i k => eval z (P i k)

def gramPolynomial (P : ι → Fin d → MvPolynomial σ ℝ) (S : Finset ι) :
    MvPolynomial σ ℝ := (gramMatrix (fun i : S => P i)).det

theorem gramPolynomial_empty (P : ι → Fin d → MvPolynomial σ ℝ) :
    gramPolynomial P ∅ = 1 := by
  exact Matrix.det_isEmpty

theorem eval_gram_iff (P : ι → Fin d → MvPolynomial σ ℝ)
    (S : Finset ι) (z : σ → ℝ) :
    eval z (gramPolynomial P S) ≠ 0 ↔ LinearIndependent ℝ (fun i : S => rowsAt P z i) := by
  rw [gramPolynomial, eval_det_gram]
  exact det_ne_zero_iff _

theorem gram_ne_zero_iff (P : ι → Fin d → MvPolynomial σ ℝ) (S : Finset ι) :
    gramPolynomial P S ≠ 0 ↔ ∃ z, LinearIndependent ℝ (fun i : S => rowsAt P z i) := by
  constructor
  · intro hp
    have hz : ∃ z, eval z (gramPolynomial P S) ≠ 0 := by
      by_contra h
      push_neg at h
      apply hp
      apply MvPolynomial.funext
      intro z
      simpa only [map_zero] using h z
    obtain ⟨z, hz⟩ := hz
    exact ⟨z, (eval_gram_iff P S z).mp hz⟩
  · rintro ⟨z, hz⟩ hzero
    have hn := (eval_gram_iff P S z).mpr hz
    exact hn (by rw [hzero, map_zero])

structure IsMaximal (P : ι → Fin d → MvPolynomial σ ℝ) (N B : Finset ι) : Prop where
  subset : B ⊆ N
  nonzero : gramPolynomial P B ≠ 0
  maximal : ∀ S ⊆ N, gramPolynomial P S ≠ 0 → S.card ≤ B.card

theorem exists_maximal (P : ι → Fin d → MvPolynomial σ ℝ) (N : Finset ι) :
    ∃ B, IsMaximal P N B := by
  classical
  let candidates := N.powerset.filter (fun S => gramPolynomial P S ≠ 0)
  have hempty : ∅ ∈ candidates := by simp [candidates, gramPolynomial_empty]
  obtain ⟨B, hB, hmax⟩ := candidates.exists_max_image Finset.card ⟨∅, hempty⟩
  have hb : B ⊆ N ∧ gramPolynomial P B ≠ 0 := by
    simpa only [candidates, Finset.mem_filter, Finset.mem_powerset] using hB
  refine ⟨B, hb.1, hb.2, ?_⟩
  intro S hS hnonzero
  exact hmax S (by simp only [candidates, Finset.mem_filter, Finset.mem_powerset]; exact ⟨hS, hnonzero⟩)

theorem IsMaximal.spans_on_regular (P : ι → Fin d → MvPolynomial σ ℝ)
    (N B : Finset ι) (hB : IsMaximal P N B) (z : σ → ℝ)
    (hz : eval z (gramPolynomial P B) ≠ 0) :
    ∀ i ∈ N, rowsAt P z i ∈ span ℝ (rowsAt P z '' (B : Set ι)) := by
  have hli : LinearIndepOn ℝ (rowsAt P z) (B : Set ι) := (eval_gram_iff P B z).mp hz
  intro i hi
  by_contra hnot
  have hiB : i ∉ B := by
    intro hib
    exact hnot (subset_span ⟨i, hib, rfl⟩)
  have hnew : LinearIndependent ℝ (fun j : (insert i B : Finset ι) => rowsAt P z j) := by
    change LinearIndepOn ℝ (rowsAt P z) ((insert i B : Finset ι) : Set ι)
    rw [Finset.coe_insert]
    exact hli.insert hnot
  have hpoly : gramPolynomial P (insert i B) ≠ 0 := (gram_ne_zero_iff P _).mpr ⟨z, hnew⟩
  have hc := hB.maximal (insert i B) (Finset.insert_subset hi hB.subset) hpoly
  rw [Finset.card_insert_of_notMem hiB] at hc
  exact Nat.not_succ_le_self _ hc

theorem IsMaximal.span_eq_on_regular (P : ι → Fin d → MvPolynomial σ ℝ)
    (N B : Finset ι) (hB : IsMaximal P N B) (z : σ → ℝ)
    (hz : eval z (gramPolynomial P B) ≠ 0) :
    span ℝ (rowsAt P z '' (B : Set ι)) = span ℝ (rowsAt P z '' (N : Set ι)) := by
  apply le_antisymm
  · exact span_mono (Set.image_mono hB.subset)
  · apply span_le.mpr
    rintro _ ⟨i, hi, rfl⟩
    exact hB.spans_on_regular P N B z hz i hi

/-- The chosen regular locus really contains a real point. -/
theorem exists_spanning_gram (P : ι → Fin d → MvPolynomial σ ℝ) (N : Finset ι) :
    ∃ B, IsMaximal P N B ∧ (∃ z, eval z (gramPolynomial P B) ≠ 0) ∧
      ∀ z, eval z (gramPolynomial P B) ≠ 0 →
        span ℝ (rowsAt P z '' (B : Set ι)) = span ℝ (rowsAt P z '' (N : Set ι)) := by
  obtain ⟨B, hB⟩ := exists_maximal P N
  obtain ⟨z, hz⟩ := (gram_ne_zero_iff P B).mp hB.nonzero
  exact ⟨B, hB, ⟨z, (eval_gram_iff P B z).mpr hz⟩, hB.span_eq_on_regular P N B⟩

end P14PolynomialGramChoice

end
end

section

/-! Polynomial vanishing identities survive a common polynomial extension
with fresh arbitrary real parameters. This is the suffix-transport invariant
for a prospective generic graph construction; it does not establish the
initial equivalence between different vertex orders. -/

noncomputable section
namespace P14PolynomialImageExtension
open MvPolynomial
open scoped BigOperators

def SameVanishing {U V ι : Type*} (F : U → ι → ℝ) (G : V → ι → ℝ) : Prop :=
  ∀ P : MvPolynomial ι ℝ,
    (∀ x, eval (F x) P = 0) ↔ (∀ y, eval (G y) P = 0)

def substitute {ι κ : Type*} (E : κ → MvPolynomial ι ℝ) :
    MvPolynomial κ ℝ →+* MvPolynomial ι ℝ := eval₂Hom C E

theorem eval_substitute {ι κ : Type*} (E : κ → MvPolynomial ι ℝ)
    (P : MvPolynomial κ ℝ) (x : ι → ℝ) :
    eval x (substitute E P) = eval (fun i => eval x (E i)) P := by
  have hh : (eval x).comp (substitute E) = eval (fun i => eval x (E i)) := by
    apply MvPolynomial.ringHom_ext
    · intro r
      simp [substitute]
    · intro i
      simp [substitute]
  exact DFunLike.congr_fun hh P

def specialize {ι δ : Type*} (z : δ → ℝ) :
    MvPolynomial (ι ⊕ δ) ℝ →+* MvPolynomial ι ℝ :=
  substitute (Sum.elim X (fun i => C (z i)))

theorem eval_specialize {ι δ : Type*} (z : δ → ℝ)
    (P : MvPolynomial (ι ⊕ δ) ℝ) (x : ι → ℝ) :
    eval x (specialize z P) = eval (Sum.elim x z) P := by
  rw [specialize, eval_substitute]
  apply congrArg (fun z : ι ⊕ δ → ℝ => eval z P)
  funext i
  rcases i with i | i <;> simp

def extend {U ι δ κ : Type*} (E : κ → MvPolynomial (ι ⊕ δ) ℝ)
    (F : U → ι → ℝ) : U × (δ → ℝ) → κ → ℝ :=
  fun p i => eval (Sum.elim (F p.1) p.2) (E i)

theorem eval_extension {U ι δ κ : Type*} (E : κ → MvPolynomial (ι ⊕ δ) ℝ)
    (F : U → ι → ℝ) (x : U) (z : δ → ℝ) (P : MvPolynomial κ ℝ) :
    eval (F x) (substitute (fun i => specialize z (E i)) P) =
      eval (extend E F (x, z)) P := by
  rw [eval_substitute]
  apply congrArg (fun z : κ → ℝ => eval z P)
  funext i
  exact eval_specialize z (E i) (F x)

/-- Fresh parameters may occur polynomially in any output coordinate.
No rank or genericity premise is added to the existing vanishing invariant. -/
theorem same_vanishing_extend {U V ι δ κ : Type*}
    (F : U → ι → ℝ) (G : V → ι → ℝ) (h : SameVanishing F G)
    (E : κ → MvPolynomial (ι ⊕ δ) ℝ) : SameVanishing (extend E F) (extend E G) := by
  intro P
  constructor
  · intro hp ⟨y, z⟩
    rw [← eval_extension]
    apply (h (substitute (fun i => specialize z (E i)) P)).mp
    intro x
    rw [eval_extension]
    exact hp (x, z)
  · intro hp ⟨x, z⟩
    rw [← eval_extension]
    apply (h (substitute (fun i => specialize z (E i)) P)).mpr
    intro y
    rw [eval_extension]
    exact hp (y, z)

theorem exists_nonzero_iff {U V ι : Type*}
    (F : U → ι → ℝ) (G : V → ι → ℝ) (h : SameVanishing F G)
    (P : MvPolynomial ι ℝ) :
    (∃ x, eval (F x) P ≠ 0) ↔ (∃ y, eval (G y) P ≠ 0) := by
  simpa only [not_forall] using not_congr (h P)

/-- Transfer a simultaneously regular finite collection, such as all
chosen nonzero Gram determinants, without choosing incompatible witnesses. -/
theorem finite_nonzero_transfer {U V ι T : Type*} [Fintype T]
    (F : U → ι → ℝ) (G : V → ι → ℝ) (h : SameVanishing F G)
    (P : T → MvPolynomial ι ℝ)
    (hw : ∃ x, ∀ t, eval (F x) (P t) ≠ 0) :
    ∃ y, ∀ t, eval (G y) (P t) ≠ 0 := by
  classical
  obtain ⟨x, hx⟩ := hw
  have hn : eval (F x) (∏ t, P t) ≠ 0 := by
    rw [map_prod]
    exact Finset.prod_ne_zero_iff.mpr (fun t _ => hx t)
  obtain ⟨y, hy⟩ := (exists_nonzero_iff F G h (∏ t, P t)).mp ⟨x, hn⟩
  rw [map_prod] at hy
  exact ⟨y, fun t => Finset.prod_ne_zero_iff.mp hy t (Finset.mem_univ t)⟩

end P14PolynomialImageExtension

end
end

section

/-! A maximal Gram choice can be shared by polynomial families having
the same vanishing identities. This does not assume that unrelated
classical choices of a maximizing subset are definitionally identical. -/

noncomputable section
namespace P14GramChoiceVanishing
open MvPolynomial P14PolynomialGramChoice P14PolynomialImageExtension

variable {σ τ ι : Type*} [DecidableEq ι] {d : ℕ}

def flat (P : ι → Fin d → MvPolynomial σ ℝ) : (σ → ℝ) → ι × Fin d → ℝ :=
  fun z a => eval z (P a.1 a.2)

def universalGram (B : Finset ι) : MvPolynomial (ι × Fin d) ℝ :=
  gramPolynomial (fun i k => X (i, k)) B

theorem eval_universalGram (P : ι → Fin d → MvPolynomial σ ℝ)
    (B : Finset ι) (z : σ → ℝ) :
    eval (flat P z) (universalGram B) = eval z (gramPolynomial P B) := by
  simp only [universalGram, gramPolynomial, P14RealGramIndependence.eval_det_gram,
    eval_X, flat]

theorem gram_zero_iff (P : ι → Fin d → MvPolynomial σ ℝ) (B : Finset ι) :
    gramPolynomial P B = 0 ↔ ∀ z, eval (flat P z) (universalGram B) = 0 := by
  constructor
  · intro h z
    rw [eval_universalGram, h, map_zero]
  · intro h
    apply MvPolynomial.funext
    intro z
    rw [← eval_universalGram, map_zero]
    exact h z

theorem gram_nonzero_iff (P : ι → Fin d → MvPolynomial σ ℝ)
    (Q : ι → Fin d → MvPolynomial τ ℝ) (h : SameVanishing (flat P) (flat Q))
    (B : Finset ι) : gramPolynomial P B ≠ 0 ↔ gramPolynomial Q B ≠ 0 := by
  exact not_congr ((gram_zero_iff P B).trans ((h _).trans (gram_zero_iff Q B).symm))

theorem transfer_maximal (P : ι → Fin d → MvPolynomial σ ℝ)
    (Q : ι → Fin d → MvPolynomial τ ℝ) (h : SameVanishing (flat P) (flat Q))
    (N B : Finset ι) (hB : IsMaximal P N B) : IsMaximal Q N B := by
  refine ⟨hB.subset, (gram_nonzero_iff P Q h B).mp hB.nonzero, ?_⟩
  intro S hS hs
  exact hB.maximal S hS ((gram_nonzero_iff P Q h S).mpr hs)

theorem exists_common_maximal (P : ι → Fin d → MvPolynomial σ ℝ)
    (Q : ι → Fin d → MvPolynomial τ ℝ) (h : SameVanishing (flat P) (flat Q))
    (N : Finset ι) : ∃ B, IsMaximal P N B ∧ IsMaximal Q N B := by
  obtain ⟨B, hB⟩ := exists_maximal P N
  exact ⟨B, hB, transfer_maximal P Q h N B hB⟩

end P14GramChoiceVanishing

end
end

section

/-! A single selector on finite candidate sets removes proof-dependent
choices from the sequential Gram construction. -/

noncomputable section
namespace P14CanonicalGramSelector
open MvPolynomial P14PolynomialGramChoice P14GramChoiceVanishing
open P14PolynomialImageExtension

variable {σ τ ι : Type*} [DecidableEq ι] {d : ℕ}

def select (C : Finset (Finset ι)) : Finset ι :=
  if h : C.Nonempty then Classical.choose (C.exists_max_image Finset.card h) else ∅

theorem select_spec (C : Finset (Finset ι)) (h : C.Nonempty) :
    select C ∈ C ∧ ∀ S ∈ C, S.card ≤ (select C).card := by
  rw [select, dif_pos h]
  exact Classical.choose_spec (C.exists_max_image Finset.card h)

def candidates (P : ι → Fin d → MvPolynomial σ ℝ) (N : Finset ι) :
    Finset (Finset ι) := by
  classical
  exact N.powerset.filter (fun S => gramPolynomial P S ≠ 0)

def chosen (P : ι → Fin d → MvPolynomial σ ℝ) (N : Finset ι) : Finset ι :=
  select (candidates P N)

theorem chosen_maximal (P : ι → Fin d → MvPolynomial σ ℝ) (N : Finset ι) :
    IsMaximal P N (chosen P N) := by
  classical
  have he : ∅ ∈ candidates P N := by simp [candidates, gramPolynomial_empty]
  have hs := select_spec (candidates P N) ⟨∅, he⟩
  have hb : chosen P N ⊆ N ∧ gramPolynomial P (chosen P N) ≠ 0 := by
    simpa only [chosen, candidates, Finset.mem_filter, Finset.mem_powerset] using hs.1
  refine ⟨hb.1, hb.2, ?_⟩
  intro S hS hp
  exact hs.2 S (by simp only [candidates, Finset.mem_filter, Finset.mem_powerset]; exact ⟨hS, hp⟩)

theorem chosen_eq (P : ι → Fin d → MvPolynomial σ ℝ)
    (Q : ι → Fin d → MvPolynomial τ ℝ) (h : SameVanishing (flat P) (flat Q))
    (N : Finset ι) : chosen P N = chosen Q N := by
  classical
  apply congrArg select
  ext S
  simp only [candidates, Finset.mem_filter, Finset.mem_powerset]
  rw [gram_nonzero_iff P Q h S]

end P14CanonicalGramSelector

end
end

section

/-! The checked determinant-cleared Gram formula with arbitrary finite
column indices, suitable for selected Finsets, and its specialization law.
No nonsingular specialization or neighbor-span condition is assumed here. -/

namespace P14IndexedGramProjector
open Matrix
open scoped Matrix

variable {R ι : Type*} [CommRing R] [Fintype ι] [DecidableEq ι] {d : ℕ}

def gram (A : Matrix (Fin d) ι R) : Matrix ι ι R := A.transpose * A

def residual (A : Matrix (Fin d) ι R) (t : Fin d → R) : Fin d → R :=
  (gram A).det • t - A *ᵥ ((gram A).adjugate *ᵥ (A.transpose *ᵥ t))

theorem orthogonal (A : Matrix (Fin d) ι R) (t : Fin d → R) :
    A.transpose *ᵥ residual A t = 0 := by
  have hh : A.transpose *ᵥ (A *ᵥ ((gram A).adjugate *ᵥ (A.transpose *ᵥ t))) =
      (gram A).det • (A.transpose *ᵥ t) := by
    calc
      _ = gram A *ᵥ ((gram A).adjugate *ᵥ (A.transpose *ᵥ t)) := by
        rw [mulVec_mulVec]
        rfl
      _ = (gram A * (gram A).adjugate) *ᵥ (A.transpose *ᵥ t) := mulVec_mulVec _ _ _
      _ = _ := by rw [mul_adjugate, smul_mulVec, one_mulVec]
  rw [residual, mulVec_sub, mulVec_smul, hh, sub_self]

theorem residual_inverse {K : Type*} [Field K]
    (A : Matrix (Fin d) ι K) (hq : (gram A).det ≠ 0)
    (y : Fin d → K) (hy : A.transpose *ᵥ y = 0) :
    residual A ((gram A).det⁻¹ • y) = y := by
  simp [residual, mulVec_smul, hy, smul_smul, hq]

theorem map_gram {S : Type*} [CommRing S] (f : R →+* S) (A : Matrix (Fin d) ι R) :
    (gram A).map f = gram (A.map f) := by
  ext i j
  simp [gram, Matrix.mul_apply]

/-- Evaluation preserves the actual residual, including singular points. -/
theorem map_residual {S : Type*} [CommRing S] (f : R →+* S)
    (A : Matrix (Fin d) ι R) (t : Fin d → R) :
    f ∘ residual A t = residual (A.map f) (f ∘ t) := by
  have hd : f (gram A).det = (gram (A.map f)).det := by
    rw [f.map_det]
    change ((gram A).map f).det = _
    rw [map_gram]
  have ha : (gram A).adjugate.map f = (gram (A.map f)).adjugate := by
    change f.mapMatrix (gram A).adjugate = _
    rw [f.map_adjugate]
    change ((gram A).map f).adjugate = _
    rw [map_gram]
  have hi : f ∘ (A.transpose *ᵥ t) = (A.map f).transpose *ᵥ (f ∘ t) := by
    funext i
    rw [Function.comp_apply, f.map_mulVec]
    rfl
  have hm : f ∘ ((gram A).adjugate *ᵥ (A.transpose *ᵥ t)) =
      (gram (A.map f)).adjugate *ᵥ ((A.map f).transpose *ᵥ (f ∘ t)) := by
    funext i
    rw [Function.comp_apply, f.map_mulVec, ha, hi]
  funext i
  simp only [Function.comp_apply, residual, Pi.sub_apply, Pi.smul_apply, smul_eq_mul,
    map_sub, map_mul]
  rw [hd, f.map_mulVec, hm]

end P14IndexedGramProjector

end

section

/-! A maximal nonzero Gram minor gives a polynomial extension orthogonal
to every prescribed neighbor, even on the singular locus. The extension
across that locus is a polynomial identity, not a constant-rank assumption. -/

noncomputable section
namespace P14PolynomialGramOrthogonality
open MvPolynomial Submodule Matrix P14PolynomialGramChoice
open scoped BigOperators Matrix

variable {σ ι : Type*} [DecidableEq ι] {d : ℕ}

def columnMatrix (P : ι → Fin d → MvPolynomial σ ℝ) (B : Finset ι) :
    Matrix (Fin d) B (MvPolynomial σ ℝ) := fun k i => P i k

def extension (P : ι → Fin d → MvPolynomial σ ℝ) (B : Finset ι)
    (t : Fin d → MvPolynomial σ ℝ) : Fin d → MvPolynomial σ ℝ :=
  P14IndexedGramProjector.residual (columnMatrix P B) t

theorem gram_columns (P : ι → Fin d → MvPolynomial σ ℝ) (B : Finset ι) :
    P14IndexedGramProjector.gram (columnMatrix P B) =
      P14RealGramIndependence.gramMatrix (fun i : B => P i) := by
  ext i j
  rfl

theorem eval_extension (P : ι → Fin d → MvPolynomial σ ℝ) (B : Finset ι)
    (t : Fin d → MvPolynomial σ ℝ) (z : σ → ℝ) :
    (fun k => eval z (extension P B t k)) =
      P14IndexedGramProjector.residual (fun k (i : B) => rowsAt P z i k)
        (fun k => eval z (t k)) := by
  exact P14IndexedGramProjector.map_residual (eval z) (columnMatrix P B) t

/-- Over the real polynomial ring a nonzero polynomial may be cancelled
after vanishing is checked everywhere that polynomial does not vanish. -/
theorem eq_zero_of_off_zero (q p : MvPolynomial σ ℝ) (hq : q ≠ 0)
    (h : ∀ z, eval z q ≠ 0 → eval z p = 0) : p = 0 := by
  have hprod : q * p = 0 := by
    apply MvPolynomial.funext
    intro z
    by_cases hz : eval z q = 0
    · simp only [map_mul, map_zero, hz, zero_mul]
    · simp only [map_mul, map_zero, h z hz, mul_zero]
  exact (mul_eq_zero.mp hprod).resolve_left hq

theorem dot_eq_zero_of_mem_span {v : ι → Fin d → ℝ} {B : Finset ι}
    {y x : Fin d → ℝ} (hB : ∀ i ∈ B, v i ⬝ᵥ y = 0)
    (hx : x ∈ span ℝ (v '' (B : Set ι))) : x ⬝ᵥ y = 0 := by
  induction hx using Submodule.span_induction with
  | mem x hx =>
      obtain ⟨i, hi, rfl⟩ := hx
      exact hB i hi
  | zero => exact zero_dotProduct _
  | add x w _ _ hx hw => simp only [add_dotProduct, hx, hw, add_zero]
  | smul a x _ hx => simp only [smul_dotProduct, hx, smul_zero]

theorem orthogonal_polynomial (P : ι → Fin d → MvPolynomial σ ℝ)
    (N B : Finset ι) (hB : IsMaximal P N B) (t : Fin d → MvPolynomial σ ℝ)
    (i : ι) (hi : i ∈ N) : P i ⬝ᵥ extension P B t = 0 := by
  apply eq_zero_of_off_zero (gramPolynomial P B) _ hB.nonzero
  intro z hz
  have hselected : ∀ j ∈ B,
      rowsAt P z j ⬝ᵥ (fun k => eval z (extension P B t k)) = 0 := by
    intro j hj
    have h := congrFun (P14IndexedGramProjector.orthogonal (columnMatrix P B) t) ⟨j, hj⟩
    have he := congrArg (eval z) h
    simpa only [Matrix.mulVec, dotProduct, columnMatrix, Matrix.transpose_apply,
      Pi.zero_apply, map_zero, map_sum, map_mul, rowsAt, extension] using he
  have hspan := hB.spans_on_regular P N B z hz i hi
  have h := dot_eq_zero_of_mem_span hselected hspan
  simpa only [dotProduct, map_sum, map_mul, rowsAt] using h

theorem orthogonal_everywhere (P : ι → Fin d → MvPolynomial σ ℝ)
    (N B : Finset ι) (hB : IsMaximal P N B) (t : Fin d → MvPolynomial σ ℝ)
    (z : σ → ℝ) (i : ι) (hi : i ∈ N) :
    rowsAt P z i ⬝ᵥ (fun k => eval z (extension P B t k)) = 0 := by
  have h := congrArg (eval z) (orthogonal_polynomial P N B hB t i hi)
  simpa only [dotProduct, map_sum, map_mul, map_zero, rowsAt] using h

end P14PolynomialGramOrthogonality

end
end

section

/-! Fresh independent polynomial parameters realize exactly the permitted
orthogonal complement at every regular old parameter value. Orthogonality
itself holds without a regularity hypothesis. -/

noncomputable section
namespace P14PolynomialFreshGramExtension
open MvPolynomial Matrix P14PolynomialGramChoice P14PolynomialGramOrthogonality
open scoped Matrix

variable {σ ι : Type*} [DecidableEq ι] {d : ℕ}

def fresh (P : ι → Fin d → MvPolynomial σ ℝ) (B : Finset ι) :
    Fin d → MvPolynomial (σ ⊕ Fin d) ℝ :=
  extension (fun i k => rename Sum.inl (P i k)) B (fun k => X (Sum.inr k))

theorem eval_fresh (P : ι → Fin d → MvPolynomial σ ℝ) (B : Finset ι)
    (z : σ → ℝ) (t : Fin d → ℝ) :
    (fun k => eval (Sum.elim z t) (fresh P B k)) =
      P14IndexedGramProjector.residual (fun k (i : B) => rowsAt P z i k) t := by
  rw [fresh, eval_extension]
  simp only [rowsAt, eval_rename, eval_X, Sum.elim_inr]
  rfl

theorem residual_orthogonal (P : ι → Fin d → MvPolynomial σ ℝ)
    (N B : Finset ι) (hB : IsMaximal P N B) (z : σ → ℝ) (t : Fin d → ℝ)
    (i : ι) (hi : i ∈ N) :
    rowsAt P z i ⬝ᵥ
      P14IndexedGramProjector.residual (fun k (j : B) => rowsAt P z j k) t = 0 := by
  have h := orthogonal_everywhere P N B hB (fun k => C (t k)) z i hi
  rw [eval_extension] at h
  simpa only [eval_C] using h

theorem fresh_orthogonal (P : ι → Fin d → MvPolynomial σ ℝ)
    (N B : Finset ι) (hB : IsMaximal P N B) (z : σ → ℝ) (t : Fin d → ℝ)
    (i : ι) (hi : i ∈ N) :
    rowsAt P z i ⬝ᵥ (fun k => eval (Sum.elim z t) (fresh P B k)) = 0 := by
  rw [eval_fresh]
  exact residual_orthogonal P N B hB z t i hi

theorem range_fresh_regular (P : ι → Fin d → MvPolynomial σ ℝ)
    (N B : Finset ι) (hB : IsMaximal P N B) (z : σ → ℝ)
    (hz : eval z (gramPolynomial P B) ≠ 0) :
    Set.range (fun t => fun k => eval (Sum.elim z t) (fresh P B k)) =
      {y : Fin d → ℝ | ∀ i ∈ N, rowsAt P z i ⬝ᵥ y = 0} := by
  ext y
  constructor
  · rintro ⟨t, rfl⟩ i hi
    exact fresh_orthogonal P N B hB z t i hi
  · intro hy
    let A : Matrix (Fin d) B ℝ := fun k i => rowsAt P z i k
    have hq : (P14IndexedGramProjector.gram A).det ≠ 0 := by
      have he : eval z (gramPolynomial P B) =
          (P14IndexedGramProjector.gram A).det := by
        rw [gramPolynomial, P14RealGramIndependence.eval_det_gram]
        rfl
      exact he ▸ hz
    have hker : A.transpose *ᵥ y = 0 := by
      funext i
      exact hy i (hB.subset i.property)
    refine ⟨(P14IndexedGramProjector.gram A).det⁻¹ • y, ?_⟩
    exact (eval_fresh P B z _).trans
      (P14IndexedGramProjector.residual_inverse A hq y hker)

/-- This range statement is attained, not vacuous on an empty regular set. -/
theorem exists_regular_full_range (P : ι → Fin d → MvPolynomial σ ℝ) (N : Finset ι) :
    ∃ B z, IsMaximal P N B ∧ eval z (gramPolynomial P B) ≠ 0 ∧
      Set.range (fun t => fun k => eval (Sum.elim z t) (fresh P B k)) =
        {y : Fin d → ℝ | ∀ i ∈ N, rowsAt P z i ⬝ᵥ y = 0} := by
  obtain ⟨B, hB, ⟨z, hz⟩, _⟩ := exists_spanning_gram P N
  exact ⟨B, z, hB, hz, range_fresh_regular P N B hB z hz⟩

end P14PolynomialFreshGramExtension

end
end

section

/-! An actual recursively defined polynomial family for any ordered
orthogonality relation. All earlier rows are retained. Every prescribed
edge is orthogonal at every parameter, including singular parameters. -/

noncomputable section
namespace P14SequentialGramFamily
open MvPolynomial P14PolynomialGramChoice P14CanonicalGramSelector
open P14PolynomialFreshGramExtension
open scoped Matrix

def Params (d : ℕ) : ℕ → Type
  | 0 => Empty
  | n + 1 => Params d n ⊕ Fin d

def neighbors (H : ℕ → ℕ → Prop) [DecidableRel H] (n : ℕ) : Finset ℕ :=
  (Finset.range n).filter (fun i => H i n)

def poly (H : ℕ → ℕ → Prop) [DecidableRel H] (d : ℕ) :
    (n : ℕ) → ℕ → Fin d → MvPolynomial (Params d n) ℝ
  | 0 => fun _ _ => 0
  | n + 1 =>
      let P := poly H d n
      let B := chosen P (neighbors H n)
      fun i k => if i = n then fresh P B k else rename Sum.inl (P i k)

theorem eval_old (H : ℕ → ℕ → Prop) [DecidableRel H] (d n : ℕ)
    (z : Params d n → ℝ) (t : Fin d → ℝ) (i : ℕ) (hi : i ≠ n) :
    rowsAt (poly H d (n + 1)) (Sum.elim z t) i = rowsAt (poly H d n) z i := by
  funext k
  change eval (Sum.elim z t)
    (if i = n then fresh (poly H d n) (chosen (poly H d n) (neighbors H n)) k
      else rename Sum.inl (poly H d n i k)) = eval z (poly H d n i k)
  rw [if_neg hi, eval_rename]
  rfl

theorem eval_new (H : ℕ → ℕ → Prop) [DecidableRel H] (d n : ℕ)
    (z : Params d n → ℝ) (t : Fin d → ℝ) :
    rowsAt (poly H d (n + 1)) (Sum.elim z t) n =
      fun k => eval (Sum.elim z t)
        (fresh (poly H d n) (chosen (poly H d n) (neighbors H n)) k) := by
  funext k
  change eval (Sum.elim z t)
    (if n = n then fresh (poly H d n) (chosen (poly H d n) (neighbors H n)) k
      else rename Sum.inl (poly H d n n k)) = _
  rw [if_pos rfl]

theorem ordered_orthogonal (H : ℕ → ℕ → Prop) [DecidableRel H] (d : ℕ) :
    ∀ n (z : Params d n → ℝ) i j, i < j → j < n → H i j →
      rowsAt (poly H d n) z i ⬝ᵥ rowsAt (poly H d n) z j = 0 := by
  intro n
  induction n with
  | zero =>
      intro z i j hij hj h
      omega
  | succ n ih =>
      intro w i j hij hj h
      let z : Params d n → ℝ := fun x => w (Sum.inl x)
      let t : Fin d → ℝ := fun x => w (Sum.inr x)
      have hw : Sum.elim z t = w := by
        funext x
        cases x <;> rfl
      rw [← hw]
      by_cases hjn : j = n
      · subst j
        rw [eval_old H d n z t i (Nat.ne_of_lt hij), eval_new]
        exact fresh_orthogonal (poly H d n) (neighbors H n)
          (chosen (poly H d n) (neighbors H n)) (chosen_maximal _ _) z t i
          (by simp only [neighbors, Finset.mem_filter, Finset.mem_range]; exact ⟨hij, h⟩)
      · have hlt : j < n := by omega
        have hin : i ≠ n := by omega
        rw [eval_old H d n z t i hin, eval_old H d n z t j hjn]
        exact ih z i j hij hlt h

theorem edge_orthogonal (H : ℕ → ℕ → Prop) [DecidableRel H]
    (hs : Symmetric H) (hr : Irreflexive H) (d n : ℕ)
    (z : Params d n → ℝ) (i j : ℕ) (hi : i < n) (hj : j < n) (h : H i j) :
    rowsAt (poly H d n) z i ⬝ᵥ rowsAt (poly H d n) z j = 0 := by
  rcases lt_trichotomy i j with hij | hij | hij
  · exact ordered_orthogonal H d n z i j hij hj h
  · subst j
    exact False.elim (hr i h)
  · rw [dotProduct_comm]
    exact ordered_orthogonal H d n z j i hij hi (hs h)

end P14SequentialGramFamily

end
end

section

/-! The actual Gram step is a common polynomial coordinate template.
Thus a proved vanishing invariant propagates through an unchanged suffix
step, including the canonical Gram choice and the new parameter block. -/

noncomputable section
namespace P14SequentialGramTransport
open MvPolynomial P14PolynomialGramChoice P14CanonicalGramSelector
open P14PolynomialFreshGramExtension P14SequentialGramFamily
open P14GramChoiceVanishing P14PolynomialImageExtension

variable {σ τ : Type*} {d : ℕ}

def step (P : ℕ → Fin d → MvPolynomial σ ℝ) (n : ℕ) (B : Finset ℕ) :
    ℕ → Fin d → MvPolynomial (σ ⊕ Fin d) ℝ :=
  fun i k => if i = n then fresh P B k else rename Sum.inl (P i k)

def universal (d : ℕ) : ℕ → Fin d → MvPolynomial (ℕ × Fin d) ℝ :=
  fun i k => X (i, k)

def template (d n : ℕ) (B : Finset ℕ) :
    ℕ × Fin d → MvPolynomial ((ℕ × Fin d) ⊕ Fin d) ℝ :=
  fun a => step (universal d) n B a.1 a.2

theorem fresh_template_eval (P : ℕ → Fin d → MvPolynomial σ ℝ)
    (B : Finset ℕ) (z : σ → ℝ) (t : Fin d → ℝ) :
    (fun k => eval (Sum.elim (flat P z) t) (fresh (universal d) B k)) =
      (fun k => eval (Sum.elim z t) (fresh P B k)) := by
  rw [eval_fresh, eval_fresh]
  simp only [rowsAt, universal, eval_X, flat]

theorem template_eval (P : ℕ → Fin d → MvPolynomial σ ℝ)
    (n : ℕ) (B : Finset ℕ) (z : σ → ℝ) (t : Fin d → ℝ) :
    extend (template d n B) (flat P) (z, t) = flat (step P n B) (Sum.elim z t) := by
  funext a
  rcases a with ⟨i, k⟩
  change eval (Sum.elim (flat P z) t)
    (if i = n then fresh (universal d) B k else rename Sum.inl (universal d i k)) =
      eval (Sum.elim z t) (if i = n then fresh P B k else rename Sum.inl (P i k))
  by_cases hi : i = n
  · rw [if_pos hi, if_pos hi]
    exact congrFun (fresh_template_eval P B z t) k
  · simp only [if_neg hi, eval_rename, universal, eval_X, Function.comp_apply,
      Sum.elim_inl, flat]
    rfl

theorem vanishing_step_iff (P : ℕ → Fin d → MvPolynomial σ ℝ)
    (n : ℕ) (B : Finset ℕ) (A : MvPolynomial (ℕ × Fin d) ℝ) :
    (∀ w, eval (flat (step P n B) w) A = 0) ↔
      ∀ p, eval (extend (template d n B) (flat P) p) A = 0 := by
  constructor
  · intro h ⟨z, t⟩
    rw [template_eval]
    exact h _
  · intro h w
    let z : σ → ℝ := fun x => w (Sum.inl x)
    let t : Fin d → ℝ := fun x => w (Sum.inr x)
    have hw : Sum.elim z t = w := by
      funext x
      cases x <;> rfl
    have hp := h (z, t)
    rw [template_eval, hw] at hp
    exact hp

theorem same_vanishing_step (P : ℕ → Fin d → MvPolynomial σ ℝ)
    (Q : ℕ → Fin d → MvPolynomial τ ℝ) (h : SameVanishing (flat P) (flat Q))
    (n : ℕ) (B : Finset ℕ) : SameVanishing (flat (step P n B)) (flat (step Q n B)) := by
  intro A
  rw [vanishing_step_iff, vanishing_step_iff]
  exact same_vanishing_extend (flat P) (flat Q) h (template d n B) A

theorem same_vanishing_chosen_step (P : ℕ → Fin d → MvPolynomial σ ℝ)
    (Q : ℕ → Fin d → MvPolynomial τ ℝ) (h : SameVanishing (flat P) (flat Q))
    (n : ℕ) (N : Finset ℕ) :
    SameVanishing (flat (step P n (chosen P N))) (flat (step Q n (chosen Q N))) := by
  rw [chosen_eq P Q h N]
  exact same_vanishing_step P Q h n (chosen Q N)

theorem same_vanishing_successor (H G : ℕ → ℕ → Prop) [DecidableRel H] [DecidableRel G]
    (d n : ℕ) (h : SameVanishing (flat (poly H d n)) (flat (poly G d n)))
    (hN : neighbors H n = neighbors G n) :
    SameVanishing (flat (poly H d (n + 1))) (flat (poly G d (n + 1))) := by
  change SameVanishing
    (flat (step (poly H d n) n (chosen (poly H d n) (neighbors H n))))
    (flat (step (poly G d n) n (chosen (poly G d n) (neighbors G n))))
  rw [hN]
  exact same_vanishing_chosen_step (poly H d n) (poly G d n) h n (neighbors G n)

end P14SequentialGramTransport

end
end

section

/-! An added row does not alter the Gram candidates of a set that excludes
that row. Fresh variables are genuinely free, so no rank is lost on the
unchanged rows. The exact canonical choice is consequently unchanged. -/

noncomputable section
namespace P14GramStepRestrictions
open MvPolynomial P14PolynomialGramChoice P14CanonicalGramSelector
open P14PolynomialFreshGramExtension P14SequentialGramTransport

variable {σ : Type*} {d : ℕ}

theorem eval_step_old (P : ℕ → Fin d → MvPolynomial σ ℝ) (a : ℕ) (B : Finset ℕ)
    (w : σ ⊕ Fin d → ℝ) (i : ℕ) (hi : i ≠ a) :
    rowsAt (step P a B) w i = rowsAt P (w ∘ Sum.inl) i := by
  funext k
  change eval w (if i = a then fresh P B k else rename Sum.inl (P i k)) = _
  rw [if_neg hi, eval_rename]
  rfl

theorem eval_step_old_split (P : ℕ → Fin d → MvPolynomial σ ℝ)
    (a : ℕ) (B : Finset ℕ) (z : σ → ℝ) (t : Fin d → ℝ) (i : ℕ) (hi : i ≠ a) :
    rowsAt (step P a B) (Sum.elim z t) i = rowsAt P z i := by
  rw [eval_step_old P a B (Sum.elim z t) i hi]
  rfl

theorem eval_step_new (P : ℕ → Fin d → MvPolynomial σ ℝ)
    (a : ℕ) (B : Finset ℕ) (z : σ → ℝ) (t : Fin d → ℝ) :
    rowsAt (step P a B) (Sum.elim z t) a =
      P14IndexedGramProjector.residual (fun k (i : B) => rowsAt P z i k) t := by
  funext k
  change eval (Sum.elim z t) (if a = a then fresh P B k else rename Sum.inl (P a k)) = _
  rw [if_pos rfl]
  exact congrFun (eval_fresh P B z t) k

theorem restricted_eval (P : ℕ → Fin d → MvPolynomial σ ℝ)
    (a : ℕ) (B S : Finset ℕ) (ha : a ∉ S) (w : σ ⊕ Fin d → ℝ) :
    (fun i : S => rowsAt (step P a B) w i) =
      (fun i : S => rowsAt P (w ∘ Sum.inl) i) := by
  funext i
  apply eval_step_old
  intro h
  exact ha (h ▸ i.property)

theorem gram_nonzero_step_iff (P : ℕ → Fin d → MvPolynomial σ ℝ)
    (a : ℕ) (B S : Finset ℕ) (ha : a ∉ S) :
    gramPolynomial (step P a B) S ≠ 0 ↔ gramPolynomial P S ≠ 0 := by
  rw [gram_ne_zero_iff, gram_ne_zero_iff]
  constructor
  · rintro ⟨w, hw⟩
    refine ⟨w ∘ Sum.inl, ?_⟩
    rw [restricted_eval P a B S ha w] at hw
    exact hw
  · rintro ⟨z, hz⟩
    refine ⟨Sum.elim z (fun _ => 0), ?_⟩
    rw [restricted_eval P a B S ha (Sum.elim z (fun _ => 0))]
    exact hz

theorem chosen_step_away (P : ℕ → Fin d → MvPolynomial σ ℝ)
    (a : ℕ) (B N : Finset ℕ) (ha : a ∉ N) :
    chosen (step P a B) N = chosen P N := by
  classical
  apply congrArg select
  ext S
  simp only [candidates, Finset.mem_filter, Finset.mem_powerset]
  constructor
  · rintro ⟨hS, h⟩
    exact ⟨hS, (gram_nonzero_step_iff P a B S (fun hs => ha (hS hs))).mp h⟩
  · rintro ⟨hS, h⟩
    exact ⟨hS, (gram_nonzero_step_iff P a B S (fun hs => ha (hS hs))).mpr h⟩

end P14GramStepRestrictions

end
end

section

/-! Independent labelled Gram steps commute after exchanging their fresh
parameter blocks. This includes the actual canonical neighbor choices. -/

noncomputable section
namespace P14IndependentGramSwap
open MvPolynomial P14PolynomialGramChoice P14CanonicalGramSelector
open P14SequentialGramTransport P14GramStepRestrictions
open P14GramChoiceVanishing P14PolynomialImageExtension

variable {σ : Type*} {d : ℕ}

theorem new_after_away (P : ℕ → Fin d → MvPolynomial σ ℝ)
    (a : ℕ) (A : Finset ℕ) (b : ℕ) (B : Finset ℕ) (ha : a ∉ B)
    (z : σ → ℝ) (ta tb : Fin d → ℝ) :
    rowsAt (step (step P a A) b B) (Sum.elim (Sum.elim z ta) tb) b =
      P14IndexedGramProjector.residual (fun k (i : B) => rowsAt P z i k) tb := by
  rw [eval_step_new]
  have he : (fun k (i : B) => rowsAt (step P a A) (Sum.elim z ta) i k) =
      (fun k (i : B) => rowsAt P z i k) := by
    funext k i
    exact congrFun (eval_step_old_split P a A z ta i (fun h => ha (h ▸ i.property))) k
  rw [he]

theorem commute_rows (P : ℕ → Fin d → MvPolynomial σ ℝ)
    (a : ℕ) (A : Finset ℕ) (b : ℕ) (B : Finset ℕ)
    (hab : a ≠ b) (ha : a ∉ B) (hb : b ∉ A)
    (z : σ → ℝ) (ta tb : Fin d → ℝ) :
    rowsAt (step (step P a A) b B) (Sum.elim (Sum.elim z ta) tb) =
      rowsAt (step (step P b B) a A) (Sum.elim (Sum.elim z tb) ta) := by
  funext i
  by_cases hia : i = a
  · subst i
    rw [eval_step_old_split (step P a A) b B (Sum.elim z ta) tb a hab,
      eval_step_new, new_after_away P b B a A hb z tb ta]
  · by_cases hib : i = b
    · subst i
      rw [new_after_away P a A b B ha z ta tb,
        eval_step_old_split (step P b B) a A (Sum.elim z tb) ta b hab.symm,
        eval_step_new]
    · rw [eval_step_old_split (step P a A) b B (Sum.elim z ta) tb i hib,
        eval_step_old_split P a A z ta i hia,
        eval_step_old_split (step P b B) a A (Sum.elim z tb) ta i hia,
        eval_step_old_split P b B z tb i hib]

theorem commute_flat (P : ℕ → Fin d → MvPolynomial σ ℝ)
    (a : ℕ) (A : Finset ℕ) (b : ℕ) (B : Finset ℕ)
    (hab : a ≠ b) (ha : a ∉ B) (hb : b ∉ A)
    (z : σ → ℝ) (ta tb : Fin d → ℝ) :
    flat (step (step P a A) b B) (Sum.elim (Sum.elim z ta) tb) =
      flat (step (step P b B) a A) (Sum.elim (Sum.elim z tb) ta) := by
  funext x
  exact congrFun (congrFun (commute_rows P a A b B hab ha hb z ta tb) x.1) x.2

theorem vanishing_commute_imp (P : ℕ → Fin d → MvPolynomial σ ℝ)
    (a : ℕ) (A : Finset ℕ) (b : ℕ) (B : Finset ℕ)
    (hab : a ≠ b) (ha : a ∉ B) (hb : b ∉ A)
    (F : MvPolynomial (ℕ × Fin d) ℝ)
    (h : ∀ w, eval (flat (step (step P a A) b B) w) F = 0) :
    ∀ w, eval (flat (step (step P b B) a A) w) F = 0 := by
  intro w
  let z : σ → ℝ := fun x => w (Sum.inl (Sum.inl x))
  let ta : Fin d → ℝ := fun x => w (Sum.inr x)
  let tb : Fin d → ℝ := fun x => w (Sum.inl (Sum.inr x))
  have hw : Sum.elim (Sum.elim z tb) ta = w := by
    funext x
    rcases x with (x | x) | x <;> rfl
  have hh := h (Sum.elim (Sum.elim z ta) tb)
  rw [commute_flat P a A b B hab ha hb z ta tb, hw] at hh
  exact hh

theorem same_vanishing_commute (P : ℕ → Fin d → MvPolynomial σ ℝ)
    (a : ℕ) (A : Finset ℕ) (b : ℕ) (B : Finset ℕ)
    (hab : a ≠ b) (ha : a ∉ B) (hb : b ∉ A) :
    SameVanishing (flat (step (step P a A) b B)) (flat (step (step P b B) a A)) := by
  intro F
  exact ⟨vanishing_commute_imp P a A b B hab ha hb F,
    vanishing_commute_imp P b B a A hab.symm hb ha F⟩

theorem chosen_steps_commute (P : ℕ → Fin d → MvPolynomial σ ℝ)
    (a b : ℕ) (NA NB : Finset ℕ) (hab : a ≠ b) (ha : a ∉ NB) (hb : b ∉ NA) :
    SameVanishing
      (flat (step (step P a (chosen P NA)) b (chosen (step P a (chosen P NA)) NB)))
      (flat (step (step P b (chosen P NB)) a (chosen (step P b (chosen P NB)) NA))) := by
  rw [chosen_step_away P a (chosen P NA) NB ha, chosen_step_away P b (chosen P NB) NA hb]
  exact same_vanishing_commute P a (chosen P NA) b (chosen P NB) hab
    (fun h => ha ((chosen_maximal P NB).subset h))
    (fun h => hb ((chosen_maximal P NA).subset h))

end P14IndependentGramSwap

end
end

section

/-! Lists record original vertex labels, with the latest vertex at the
head. Independent adjacent vertices may be swapped anywhere in the list
without changing the vanishing identities of the actual construction. -/

noncomputable section
namespace P14LabelledGramFamily
open MvPolynomial P14PolynomialGramChoice P14CanonicalGramSelector
open P14SequentialGramTransport P14GramStepRestrictions P14IndependentGramSwap
open P14GramChoiceVanishing P14PolynomialImageExtension P14SequentialGramFamily

def neighbors (H : ℕ → ℕ → Prop) [DecidableRel H] (L : List ℕ) (a : ℕ) : Finset ℕ :=
  L.toFinset.filter (fun i => H i a)

def family (H : ℕ → ℕ → Prop) [DecidableRel H] (d : ℕ) :
    (L : List ℕ) → ℕ → Fin d → MvPolynomial (Params d L.length) ℝ
  | [] => fun _ _ => 0
  | a :: L => step (family H d L) a (chosen (family H d L) (neighbors H L a))

theorem neighbors_cons_of_nonedge (H : ℕ → ℕ → Prop) [DecidableRel H]
    (L : List ℕ) (a b : ℕ) (h : ¬ H a b) :
    neighbors H (a :: L) b = neighbors H L b := by
  ext i
  simp only [neighbors, Finset.mem_filter, List.mem_toFinset, List.mem_cons]
  constructor
  · rintro ⟨(rfl | hi), hib⟩
    · exact False.elim (h hib)
    · exact ⟨hi, hib⟩
  · rintro ⟨hi, hib⟩
    exact ⟨Or.inr hi, hib⟩

theorem same_vanishing_cons (H : ℕ → ℕ → Prop) [DecidableRel H] (d : ℕ)
    (L M : List ℕ) (a : ℕ)
    (h : SameVanishing (flat (family H d L)) (flat (family H d M)))
    (hset : L.toFinset = M.toFinset) :
    SameVanishing (flat (family H d (a :: L))) (flat (family H d (a :: M))) := by
  have hn : neighbors H L a = neighbors H M a := by rw [neighbors, neighbors, hset]
  change SameVanishing
    (flat (step (family H d L) a (chosen (family H d L) (neighbors H L a))))
    (flat (step (family H d M) a (chosen (family H d M) (neighbors H M a))))
  rw [hn]
  exact same_vanishing_chosen_step (family H d L) (family H d M) h a (neighbors H M a)

theorem independent_swap_front (H : ℕ → ℕ → Prop) [DecidableRel H] (d : ℕ)
    (L : List ℕ) (a b : ℕ) (hab : a ≠ b) (hna : ¬ H a b) (hnb : ¬ H b a) :
    SameVanishing (flat (family H d (b :: a :: L))) (flat (family H d (a :: b :: L))) := by
  change SameVanishing
    (flat (step (step (family H d L) a (chosen (family H d L) (neighbors H L a))) b
      (chosen (step (family H d L) a (chosen (family H d L) (neighbors H L a)))
        (neighbors H (a :: L) b))))
    (flat (step (step (family H d L) b (chosen (family H d L) (neighbors H L b))) a
      (chosen (step (family H d L) b (chosen (family H d L) (neighbors H L b)))
        (neighbors H (b :: L) a))))
  rw [neighbors_cons_of_nonedge H L a b hna, neighbors_cons_of_nonedge H L b a hnb]
  exact chosen_steps_commute (family H d L) a b (neighbors H L a) (neighbors H L b) hab
    (fun hi => hna (Finset.mem_filter.mp hi).2)
    (fun hi => hnb (Finset.mem_filter.mp hi).2)

/-- A common list of later vertices transports an existing invariant. -/
theorem same_vanishing_later (H : ℕ → ℕ → Prop) [DecidableRel H] (d : ℕ)
    (L M : List ℕ) (h : SameVanishing (flat (family H d L)) (flat (family H d M)))
    (hset : L.toFinset = M.toFinset) :
    ∀ K : List ℕ, SameVanishing (flat (family H d (K ++ L))) (flat (family H d (K ++ M))) := by
  intro K
  induction K with
  | nil => exact h
  | cons a K ih =>
      apply same_vanishing_cons H d (K ++ L) (K ++ M) a ih
      simp only [List.toFinset_append, hset]

theorem independent_swap_anywhere (H : ℕ → ℕ → Prop) [DecidableRel H] (d : ℕ)
    (K L : List ℕ) (a b : ℕ) (hab : a ≠ b) (hna : ¬ H a b) (hnb : ¬ H b a) :
    SameVanishing (flat (family H d (K ++ b :: a :: L)))
      (flat (family H d (K ++ a :: b :: L))) := by
  apply same_vanishing_later H d (b :: a :: L) (a :: b :: L)
    (independent_swap_front H d L a b hab hna hnb)
  simp only [List.toFinset_cons, Finset.insert_comm]

end P14LabelledGramFamily

end
end

section

/-! Assemble the large-set order comparison from a smaller-set invariant.
Canonical orders make equivalence-closure transport independent of choices
of intermediate lists. No small-set or global invariant is assumed here
except the explicit induction hypothesis on strictly smaller subsets. -/

noncomputable section
namespace P14LastVertexTransport
open P14LabelledGramFamily P14GramChoiceVanishing P14PolynomialImageExtension
open P14BicliqueComplementConnection

def OrderInvariant (H : ℕ → ℕ → Prop) [DecidableRel H] (d : ℕ) (S : Finset ℕ) : Prop :=
  ∀ (L M : List ℕ), L.Nodup → M.Nodup → L.toFinset = S → M.toFinset = S →
    SameVanishing (flat (family H d L)) (flat (family H d M))

def lastOrder (S : Finset ℕ) (a : ℕ) : List ℕ := a :: (S.erase a).toList

theorem lastOrder_nodup (S : Finset ℕ) (a : ℕ) : (lastOrder S a).Nodup := by
  simp only [lastOrder, List.nodup_cons, Finset.mem_toList, Finset.notMem_erase,
    not_false_eq_true, Finset.nodup_toList, and_self]

theorem lastOrder_support (S : Finset ℕ) (a : ℕ) (ha : a ∈ S) :
    (lastOrder S a).toFinset = S := by
  simp only [lastOrder, List.toFinset_cons, Finset.toList_toFinset, Finset.insert_erase ha]

theorem tail_support (S : Finset ℕ) (a : ℕ) (L : List ℕ)
    (hL : (a :: L).Nodup) (hset : (a :: L).toFinset = S) :
    L.toFinset = S.erase a := by
  rw [← hset, List.toFinset_cons, Finset.erase_insert]
  exact fun h => (List.nodup_cons.mp hL).1 (List.mem_toFinset.mp h)

theorem same_last_of_smaller (H : ℕ → ℕ → Prop) [DecidableRel H] (d : ℕ) (S : Finset ℕ)
    (ih : ∀ T ⊆ S, T.card < S.card → OrderInvariant H d T)
    (a : ℕ) (L : List ℕ) (hL : (a :: L).Nodup) (hset : (a :: L).toFinset = S) :
    SameVanishing (flat (family H d (a :: L))) (flat (family H d (lastOrder S a))) := by
  have ha : a ∈ S := by rw [← hset]; simp
  have ht := tail_support S a L hL hset
  have hi := ih (S.erase a) (Finset.erase_subset a S) (Finset.card_erase_lt_of_mem ha)
  apply same_vanishing_cons H d L (S.erase a).toList a
  · exact hi L (S.erase a).toList (List.nodup_cons.mp hL).2
      (Finset.nodup_toList _) ht (Finset.toList_toFinset _)
  · exact ht.trans (Finset.toList_toFinset _).symm

theorem link_last_orders (H : ℕ → ℕ → Prop) [DecidableRel H] (d : ℕ) (S : Finset ℕ)
    (ih : ∀ T ⊆ S, T.card < S.card → OrderInvariant H d T)
    (a b : ℕ) (h : Link H S a b) :
    SameVanishing (flat (family H d (lastOrder S a)))
      (flat (family H d (lastOrder S b))) := by
  rcases h with ⟨ha, hb, hab, hnab, hnba⟩
  let R := ((S.erase a).erase b).toList
  have hRa : a ∉ R := by simp [R]
  have hRb : b ∉ R := by simp [R]
  have hR : R.Nodup := Finset.nodup_toList _
  have hAB : (a :: b :: R).Nodup := by simp [List.nodup_cons, hab, hRa, hRb, hR]
  have hBA : (b :: a :: R).Nodup := by simp [List.nodup_cons, hab.symm, hRa, hRb, hR]
  have hsAB : (a :: b :: R).toFinset = S := by
    simp only [List.toFinset_cons]
    change insert a (insert b (((S.erase a).erase b).toList.toFinset)) = S
    rw [Finset.toList_toFinset, Finset.insert_erase (Finset.mem_erase.mpr ⟨hab.symm, hb⟩),
      Finset.insert_erase ha]
  have hsBA : (b :: a :: R).toFinset = S := by
    simpa only [List.toFinset_cons, Finset.insert_comm] using hsAB
  have hleft := same_last_of_smaller H d S ih a (b :: R) hAB hsAB
  have hright := same_last_of_smaller H d S ih b (a :: R) hBA hsBA
  have hswap := independent_swap_front H d R b a hab.symm hnba hnab
  intro P
  exact (hleft P).symm.trans ((hswap P).trans (hright P))

theorem connected_last_orders (H : ℕ → ℕ → Prop) [DecidableRel H] (d : ℕ) (S : Finset ℕ)
    (ih : ∀ T ⊆ S, T.card < S.card → OrderInvariant H d T)
    (a b : ℕ) (h : Relation.EqvGen (Link H S) a b) :
    SameVanishing (flat (family H d (lastOrder S a)))
      (flat (family H d (lastOrder S b))) := by
  induction h with
  | rel a b hab => exact link_last_orders H d S ih a b hab
  | refl a => intro P; exact Iff.rfl
  | symm a b _ hab => intro P; exact (hab P).symm
  | trans a b c _ _ hab hbc => intro P; exact (hab P).trans (hbc P)

end P14LastVertexTransport

end
end

section

/-! Actual labelled rows satisfy every edge constraint. Conversely, every
independent edge-orthogonal target on a duplicate-free list is attained.
The latter is a realization theorem, not an assumed generic-rank premise. -/

noncomputable section
namespace P14LabelledGramGeometry
open MvPolynomial P14PolynomialGramChoice P14CanonicalGramSelector
open P14PolynomialFreshGramExtension P14GramStepRestrictions P14LabelledGramFamily
open P14SequentialGramFamily (Params)
open scoped Matrix

theorem eval_cons_old (H : ℕ → ℕ → Prop) [DecidableRel H] (d : ℕ)
    (L : List ℕ) (a : ℕ) (w : Params d (a :: L).length → ℝ)
    (i : ℕ) (hi : i ≠ a) :
    rowsAt (family H d (a :: L)) w i = rowsAt (family H d L) (w ∘ Sum.inl) i :=
  eval_step_old _ a _ w i hi

theorem eval_cons_new (H : ℕ → ℕ → Prop) [DecidableRel H] (d : ℕ)
    (L : List ℕ) (a : ℕ) (z : Params d L.length → ℝ) (t : Fin d → ℝ) :
    rowsAt (family H d (a :: L)) (Sum.elim z t) a =
      fun k => eval (Sum.elim z t)
        (fresh (family H d L) (chosen (family H d L) (neighbors H L a)) k) := by
  funext k
  change eval (Sum.elim z t)
    (if a = a then fresh (family H d L) (chosen (family H d L) (neighbors H L a)) k
      else rename Sum.inl (family H d L a k)) = _
  rw [if_pos rfl]

theorem edge_orthogonal (H : ℕ → ℕ → Prop) [DecidableRel H]
    (hs : ∀ {i j}, H i j → H j i) (hr : ∀ i, ¬ H i i) (d : ℕ) :
    ∀ (L : List ℕ), L.Nodup → ∀ (w : Params d L.length → ℝ) i j,
      i ∈ L → j ∈ L → H i j →
      rowsAt (family H d L) w i ⬝ᵥ rowsAt (family H d L) w j = 0 := by
  intro L
  induction L with
  | nil => simp
  | cons a L ih =>
      intro hL w i j hi hj hij
      have hnd := List.nodup_cons.mp hL
      let z : Params d L.length → ℝ := fun x => w (Sum.inl x)
      let t : Fin d → ℝ := fun x => w (Sum.inr x)
      have hw : Sum.elim z t = w := by funext x; cases x <;> rfl
      rw [← hw]
      have hnew : ∀ b ∈ L, H b a →
          rowsAt (family H d (a :: L)) (Sum.elim z t) b ⬝ᵥ
            rowsAt (family H d (a :: L)) (Sum.elim z t) a = 0 := by
        intro b hb hba
        have hne : b ≠ a := fun h => hnd.1 (h ▸ hb)
        rw [eval_cons_old H d L a (Sum.elim z t) b hne, eval_cons_new]
        exact fresh_orthogonal (family H d L) (neighbors H L a)
          (chosen (family H d L) (neighbors H L a)) (chosen_maximal _ _) z t b
          (by simp only [neighbors, Finset.mem_filter, List.mem_toFinset]; exact ⟨hb, hba⟩)
      by_cases hia : i = a
      · subst i
        by_cases hja : j = a
        · subst j
          exact False.elim (hr a hij)
        · rw [dotProduct_comm]
          exact hnew j ((List.mem_cons.mp hj).resolve_left hja) (hs hij)
      · have hiL : i ∈ L := (List.mem_cons.mp hi).resolve_left hia
        by_cases hja : j = a
        · subst j
          exact hnew i hiL hij
        · have hjL : j ∈ L := (List.mem_cons.mp hj).resolve_left hja
          rw [eval_cons_old H d L a (Sum.elim z t) i hia,
            eval_cons_old H d L a (Sum.elim z t) j hja]
          exact ih hnd.2 z i j hiL hjL hij

theorem independent_subset (v : ℕ → Fin d → ℝ) (S T : Finset ℕ)
    (hv : LinearIndependent ℝ (fun i : S => v i)) (hT : T ⊆ S) :
    LinearIndependent ℝ (fun i : T => v i) := by
  let f : T → S := fun i => ⟨i, hT i.property⟩
  have hf : Function.Injective f := by
    intro i j h
    apply Subtype.ext
    exact congrArg (fun x : S => (x : ℕ)) h
  exact hv.comp f hf

theorem gram_regular_of_target {σ : Type*} (P : ℕ → Fin d → MvPolynomial σ ℝ)
    (S B : Finset ℕ) (z : σ → ℝ) (v : ℕ → Fin d → ℝ)
    (hv : LinearIndependent ℝ (fun i : S => v i))
    (hz : ∀ i ∈ S, rowsAt P z i = v i) (hB : B ⊆ S) :
    eval z (gramPolynomial P B) ≠ 0 := by
  apply (eval_gram_iff P B z).mpr
  have he : (fun i : B => rowsAt P z i) = (fun i : B => v i) := by
    funext i
    exact hz i (hB i.property)
  rw [he]
  exact independent_subset v S B hv hB

theorem realizes_independent_target (H : ℕ → ℕ → Prop) [DecidableRel H] (d : ℕ) :
    ∀ (L : List ℕ), L.Nodup → ∀ (v : ℕ → Fin d → ℝ),
      LinearIndependent ℝ (fun i : L.toFinset => v i) →
      (∀ i ∈ L, ∀ j ∈ L, H i j → v i ⬝ᵥ v j = 0) →
      ∃ z : Params d L.length → ℝ, ∀ i ∈ L, rowsAt (family H d L) z i = v i := by
  intro L
  induction L with
  | nil =>
      intro hL v hv horth
      exact ⟨Empty.elim, by simp⟩
  | cons a L ih =>
      intro hL v hv horth
      have hnd := List.nodup_cons.mp hL
      have hsub : L.toFinset ⊆ (a :: L).toFinset := by
        intro i hi
        simpa only [List.toFinset_cons, Finset.mem_insert] using Or.inr hi
      have hvi := independent_subset v (a :: L).toFinset L.toFinset hv hsub
      obtain ⟨z, hz⟩ := ih hnd.2 v hvi
        (fun i hi j hj hij => horth i (List.mem_cons_of_mem a hi) j (List.mem_cons_of_mem a hj) hij)
      let P := family H d L
      let N := neighbors H L a
      let B := chosen P N
      have hB : IsMaximal P N B := chosen_maximal P N
      have hBsub : B ⊆ L.toFinset := fun i hi => (Finset.mem_filter.mp (hB.subset hi)).1
      have hreg : eval z (gramPolynomial P B) ≠ 0 :=
        gram_regular_of_target P L.toFinset B z v hvi
          (fun i hi => hz i (List.mem_toFinset.mp hi)) hBsub
      have hy : ∀ i ∈ N, rowsAt P z i ⬝ᵥ v a = 0 := by
        intro i hi
        have hm := Finset.mem_filter.mp hi
        have hiL : i ∈ L := List.mem_toFinset.mp hm.1
        rw [hz i hiL]
        exact horth i (List.mem_cons_of_mem a hiL) a (List.mem_cons_self) hm.2
      have hrange : v a ∈ Set.range (fun t => fun k => eval (Sum.elim z t) (fresh P B k)) := by
        rw [range_fresh_regular P N B hB z hreg]
        exact hy
      obtain ⟨t, ht⟩ := hrange
      refine ⟨Sum.elim z t, ?_⟩
      intro i hi
      rcases List.mem_cons.mp hi with rfl | hi
      · rw [eval_cons_new]
        exact ht
      · rw [eval_cons_old H d L a (Sum.elim z t) i (fun h => hnd.1 (h ▸ hi))]
        exact hz i hi

end P14LabelledGramGeometry

end
end

section

/-! The actual sequential Gram family realizes the standard basis on its
first d rows. No independence witness is assumed for the construction. -/

noncomputable section
namespace P14SequentialStandardBasis
open MvPolynomial P14PolynomialGramChoice P14CanonicalGramSelector
open P14PolynomialFreshGramExtension P14SequentialGramFamily
open scoped Matrix

def basisRow (d i : ℕ) : Fin d → ℝ :=
  if h : i < d then Pi.single ⟨i, h⟩ 1 else 0

theorem basisRow_eq (d i : ℕ) (h : i < d) :
    basisRow d i = Pi.single ⟨i, h⟩ 1 := by
  rw [basisRow, dif_pos h]

theorem basisRow_orthogonal (d i j : ℕ) (hij : i < j) (hj : j < d) :
    basisRow d i ⬝ᵥ basisRow d j = 0 := by
  have hi : i < d := lt_trans hij hj
  have hne : (⟨i, hi⟩ : Fin d) ≠ ⟨j, hj⟩ := by
    intro h
    have he : i = j := congrArg Fin.val h
    exact (Nat.ne_of_lt hij) he
  rw [basisRow_eq d i hi, basisRow_eq d j hj, single_one_dotProduct]
  exact Pi.single_eq_of_ne hne 1

theorem gram_regular_of_standard {σ : Type*}
    (P : ℕ → Fin d → MvPolynomial σ ℝ) (n : ℕ) (z : σ → ℝ) (hnd : n ≤ d)
    (hz : ∀ i, i < n → rowsAt P z i = basisRow d i)
    (B : Finset ℕ) (hB : B ⊆ Finset.range n) :
    eval z (gramPolynomial P B) ≠ 0 := by
  apply (eval_gram_iff P B z).mpr
  let f : B → Fin d := fun i => ⟨i, lt_of_lt_of_le (Finset.mem_range.mp (hB i.property)) hnd⟩
  have hf : Function.Injective f := by
    intro i j h
    apply Subtype.ext
    exact congrArg Fin.val h
  have he : (fun i : B => rowsAt P z i) = (fun i : B => Pi.single (f i) (1 : ℝ)) := by
    funext i
    rw [hz i (Finset.mem_range.mp (hB i.property)), basisRow_eq d i (f i).isLt]
  rw [he]
  exact (Pi.linearIndependent_single_one (Fin d) ℝ).comp f hf

theorem realizes_initial_basis (H : ℕ → ℕ → Prop) [DecidableRel H] (d : ℕ) :
    ∀ n, n ≤ d → ∃ z : Params d n → ℝ,
      ∀ i, i < n → rowsAt (poly H d n) z i = basisRow d i := by
  intro n
  induction n with
  | zero =>
      intro hn
      refine ⟨Empty.elim, ?_⟩
      intro i hi
      omega
  | succ n ih =>
      intro hn
      obtain ⟨z, hz⟩ := ih (by omega)
      let P := poly H d n
      let N := neighbors H n
      let B := chosen P N
      have hB : IsMaximal P N B := chosen_maximal P N
      have hsub : B ⊆ Finset.range n := by
        intro i hi
        exact (Finset.mem_filter.mp (hB.subset hi)).1
      have hreg : eval z (gramPolynomial P B) ≠ 0 :=
        gram_regular_of_standard P n z (by omega) hz B hsub
      have hy : ∀ i ∈ N, rowsAt P z i ⬝ᵥ basisRow d n = 0 := by
        intro i hi
        have hin : i < n := Finset.mem_range.mp (Finset.mem_filter.mp hi).1
        rw [hz i hin]
        exact basisRow_orthogonal d i n hin (by omega)
      have hrange : basisRow d n ∈
          Set.range (fun t => fun k => eval (Sum.elim z t) (fresh P B k)) := by
        rw [range_fresh_regular P N B hB z hreg]
        exact hy
      obtain ⟨t, ht⟩ := hrange
      refine ⟨Sum.elim z t, ?_⟩
      intro i hi
      by_cases hin : i = n
      · subst i
        rw [eval_new]
        exact ht
      · rw [eval_old H d n z t i hin]
        exact hz i (by omega)

/-- Later steps preserve any previously attained prefix exactly. -/
theorem retain_prefix (H : ℕ → ℕ → Prop) [DecidableRel H] (d n : ℕ)
    (z : Params d n → ℝ) :
    ∀ k, ∃ w : Params d (n + k) → ℝ,
      ∀ i, i < n → rowsAt (poly H d (n + k)) w i = rowsAt (poly H d n) z i := by
  intro k
  induction k with
  | zero => exact ⟨z, fun _ _ => rfl⟩
  | succ k ih =>
      obtain ⟨w, hw⟩ := ih
      refine ⟨Sum.elim w (fun _ => 0), ?_⟩
      intro i hi
      exact (eval_old H d (n + k) w (fun _ => 0) i (by omega)).trans (hw i hi)

theorem realizes_first_d (H : ℕ → ℕ → Prop) [DecidableRel H] (d k : ℕ) :
    ∃ z : Params d (d + k) → ℝ,
      ∀ i, i < d → rowsAt (poly H d (d + k)) z i = basisRow d i := by
  obtain ⟨z, hz⟩ := realizes_initial_basis H d d le_rfl
  obtain ⟨w, hw⟩ := retain_prefix H d d z k
  exact ⟨w, fun i hi => (hw i hi).trans (hz i hi)⟩

theorem first_d_independent (H : ℕ → ℕ → Prop) [DecidableRel H] (d k : ℕ) :
    ∃ z : Params d (d + k) → ℝ,
      LinearIndependent ℝ (fun i : Fin d => rowsAt (poly H d (d + k)) z i) := by
  obtain ⟨z, hz⟩ := realizes_first_d H d k
  refine ⟨z, ?_⟩
  have he : (fun i : Fin d => rowsAt (poly H d (d + k)) z i) =
      (fun i : Fin d => Pi.single i (1 : ℝ)) := by
    funext i
    rw [hz i i.isLt, basisRow_eq d i i.isLt]
  rw [he]
  exact Pi.linearIndependent_single_one (Fin d) ℝ

end P14SequentialStandardBasis

end
end

section

/-! Every duplicate-free labelled list of length at most d has an actual
independent realization. Later vertices outside its support preserve this
witness, so its Gram polynomial in the longer construction is nonzero. -/

noncomputable section
namespace P14LabelledGramBasis
open MvPolynomial P14PolynomialGramChoice P14LabelledGramFamily P14LabelledGramGeometry
open P14SequentialStandardBasis
open P14SequentialGramFamily (Params)
open scoped Matrix

def listBasis (L : List ℕ) (d i : ℕ) : Fin d → ℝ := basisRow d (L.idxOf (i : ℕ))

theorem listBasis_independent (L : List ℕ) (d : ℕ) (hd : L.length ≤ d) :
    LinearIndependent ℝ (fun i : L.toFinset => listBasis L d i) := by
  let f : L.toFinset → Fin d := fun i =>
    ⟨L.idxOf (i : ℕ), lt_of_lt_of_le (List.idxOf_lt_length_iff.mpr (List.mem_toFinset.mp i.property)) hd⟩
  have hf : Function.Injective f := by
    intro i j h
    apply Subtype.ext
    apply (List.idxOf_inj (List.mem_toFinset.mp i.property)).mp
    exact congrArg Fin.val h
  have he : (fun i : L.toFinset => listBasis L d i) =
      (fun i : L.toFinset => Pi.single (f i) (1 : ℝ)) := by
    funext i
    exact basisRow_eq d (L.idxOf (i : ℕ)) (f i).isLt
  rw [he]
  exact (Pi.linearIndependent_single_one (Fin d) ℝ).comp f hf

theorem listBasis_orthogonal (L : List ℕ) (d : ℕ) (hd : L.length ≤ d)
    (i j : ℕ) (hi : i ∈ L) (hj : j ∈ L) (hij : i ≠ j) :
    listBasis L d i ⬝ᵥ listBasis L d j = 0 := by
  have hidxi : L.idxOf (i : ℕ) < d := lt_of_lt_of_le (List.idxOf_lt_length_iff.mpr hi) hd
  have hidxj : L.idxOf j < d := lt_of_lt_of_le (List.idxOf_lt_length_iff.mpr hj) hd
  have hne : (⟨L.idxOf (i : ℕ), hidxi⟩ : Fin d) ≠ ⟨L.idxOf j, hidxj⟩ := by
    intro h
    exact hij ((List.idxOf_inj hi).mp (congrArg Fin.val h))
  rw [listBasis, listBasis, basisRow_eq d _ hidxi, basisRow_eq d _ hidxj,
    single_one_dotProduct]
  exact Pi.single_eq_of_ne hne 1

theorem realizes_list_basis (H : ℕ → ℕ → Prop) [DecidableRel H]
    (hr : ∀ i, ¬ H i i) (d : ℕ) (L : List ℕ) (hL : L.Nodup) (hd : L.length ≤ d) :
    ∃ z : Params d L.length → ℝ, ∀ i ∈ L, rowsAt (family H d L) z i = listBasis L d i := by
  apply realizes_independent_target H d L hL (listBasis L d) (listBasis_independent L d hd)
  intro i hi j hj hij
  apply listBasis_orthogonal L d hd i j hi hj
  intro heq
  subst j
  exact hr i hij

theorem small_list_independent (H : ℕ → ℕ → Prop) [DecidableRel H]
    (hr : ∀ i, ¬ H i i) (d : ℕ) (L : List ℕ) (hL : L.Nodup) (hd : L.length ≤ d) :
    ∃ z : Params d L.length → ℝ,
      LinearIndependent ℝ (fun i : L.toFinset => rowsAt (family H d L) z i) := by
  obtain ⟨z, hz⟩ := realizes_list_basis H hr d L hL hd
  refine ⟨z, ?_⟩
  have he : (fun i : L.toFinset => rowsAt (family H d L) z i) =
      (fun i : L.toFinset => listBasis L d i) := by
    funext i
    exact hz i (List.mem_toFinset.mp i.property)
  rw [he]
  exact listBasis_independent L d hd

theorem retain_prefix (H : ℕ → ℕ → Prop) [DecidableRel H] (d : ℕ)
    (L : List ℕ) (z : Params d L.length → ℝ) :
    ∀ K : List ℕ, (∀ i ∈ K, i ∉ L) →
      ∃ w : Params d (K ++ L).length → ℝ,
        ∀ i ∈ L, rowsAt (family H d (K ++ L)) w i = rowsAt (family H d L) z i := by
  intro K
  induction K with
  | nil => exact fun _ => ⟨z, fun _ _ => rfl⟩
  | cons a K ih =>
      intro hdis
      obtain ⟨w, hw⟩ := ih (fun i hi => hdis i (List.mem_cons_of_mem a hi))
      refine ⟨Sum.elim w (fun _ => 0), ?_⟩
      intro i hi
      have hne : i ≠ a := fun h => hdis a List.mem_cons_self (h ▸ hi)
      exact (eval_cons_old H d (K ++ L) a (Sum.elim w (fun _ => 0)) i hne).trans (hw i hi)

theorem prefix_independent (H : ℕ → ℕ → Prop) [DecidableRel H]
    (hr : ∀ i, ¬ H i i) (d : ℕ) (K L : List ℕ) (hL : L.Nodup)
    (hd : L.length ≤ d) (hdis : ∀ i ∈ K, i ∉ L) :
    ∃ w : Params d (K ++ L).length → ℝ,
      LinearIndependent ℝ (fun i : L.toFinset => rowsAt (family H d (K ++ L)) w i) := by
  obtain ⟨z, hz⟩ := small_list_independent H hr d L hL hd
  obtain ⟨w, hw⟩ := retain_prefix H d L z K hdis
  refine ⟨w, ?_⟩
  have he : (fun i : L.toFinset => rowsAt (family H d (K ++ L)) w i) =
      (fun i : L.toFinset => rowsAt (family H d L) z i) := by
    funext i
    exact hw i (List.mem_toFinset.mp i.property)
  rw [he]
  exact hz

theorem prefix_gram_nonzero (H : ℕ → ℕ → Prop) [DecidableRel H]
    (hr : ∀ i, ¬ H i i) (d : ℕ) (K L : List ℕ) (hL : L.Nodup)
    (hd : L.length ≤ d) (hdis : ∀ i ∈ K, i ∉ L) :
    gramPolynomial (family H d (K ++ L)) L.toFinset ≠ 0 :=
  (gram_ne_zero_iff _ _).mpr (prefix_independent H hr d K L hL hd hdis)

end P14LabelledGramBasis

end
end

section

/-! All orders on at most d distinct vertices have the same polynomial
vanishing identities. A nonzero full Gram polynomial supplies a regular
locus; exact independent-target realization compares the orders there,
and polynomial cancellation extends the identity to every parameter. -/

noncomputable section
namespace P14SmallOrderVanishing
open MvPolynomial P14PolynomialGramChoice P14GramChoiceVanishing
open P14PolynomialImageExtension P14PolynomialGramOrthogonality
open P14LabelledGramFamily P14LabelledGramGeometry P14LabelledGramBasis
open P14SequentialGramFamily (Params)
open scoped Matrix

theorem rows_zero_outside (H : ℕ → ℕ → Prop) [DecidableRel H] (d : ℕ) :
    ∀ (L : List ℕ) (z : Params d L.length → ℝ) i, i ∉ L →
      rowsAt (family H d L) z i = 0 := by
  intro L
  induction L with
  | nil =>
      intro z i hi
      funext k
      change eval z (0 : MvPolynomial (Params d 0) ℝ) = 0
      exact map_zero _
  | cons a L ih =>
      intro z i hi
      have hne : i ≠ a := fun h => hi (List.mem_cons.mpr (Or.inl h))
      rw [eval_cons_old H d L a z i hne]
      exact ih (z ∘ Sum.inl) i (fun h => hi (List.mem_cons_of_mem a h))

theorem mem_iff_of_toFinset_eq (L M : List ℕ) (h : L.toFinset = M.toFinset) (i : ℕ) :
    i ∈ L ↔ i ∈ M := by
  have h' : i ∈ L.toFinset ↔ i ∈ M.toFinset := by rw [h]
  simpa only [List.mem_toFinset] using h'

theorem vanishing_transfer_of_regular (H : ℕ → ℕ → Prop) [DecidableRel H]
    (hs : ∀ {i j}, H i j → H j i) (hr : ∀ i, ¬ H i i) (d : ℕ)
    (L M : List ℕ) (hL : L.Nodup) (hM : M.Nodup) (hset : L.toFinset = M.toFinset)
    (hreg : gramPolynomial (family H d M) M.toFinset ≠ 0)
    (P : MvPolynomial (ℕ × Fin d) ℝ)
    (hp : ∀ z, eval (flat (family H d L) z) P = 0) :
    ∀ w, eval (flat (family H d M) w) P = 0 := by
  let E : ℕ × Fin d → MvPolynomial (Params d M.length) ℝ :=
    fun a => family H d M a.1 a.2
  have hzero : substitute E P = 0 := by
    apply eq_zero_of_off_zero (gramPolynomial (family H d M) M.toFinset) _ hreg
    intro w hw
    let v := rowsAt (family H d M) w
    have hv : LinearIndependent ℝ (fun i : L.toFinset => v i) := by
      rw [hset]
      exact (eval_gram_iff (family H d M) M.toFinset w).mp hw
    have horth : ∀ i ∈ L, ∀ j ∈ L, H i j → v i ⬝ᵥ v j = 0 := by
      intro i hi j hj hij
      exact P14LabelledGramGeometry.edge_orthogonal H hs hr d M hM w i j
        ((mem_iff_of_toFinset_eq L M hset i).mp hi)
        ((mem_iff_of_toFinset_eq L M hset j).mp hj) hij
    obtain ⟨z, hz⟩ := realizes_independent_target H d L hL v hv horth
    have hflat : flat (family H d L) z = flat (family H d M) w := by
      funext a
      rcases a with ⟨i, k⟩
      change rowsAt (family H d L) z i k = rowsAt (family H d M) w i k
      by_cases hi : i ∈ L
      · exact congrFun (hz i hi) k
      · have hiM : i ∉ M := fun h => hi ((mem_iff_of_toFinset_eq L M hset i).mpr h)
        rw [rows_zero_outside H d L z i hi, rows_zero_outside H d M w i hiM]
    rw [eval_substitute]
    change eval (flat (family H d M) w) P = 0
    rw [← hflat]
    exact hp z
  intro w
  have he := congrArg (eval w) hzero
  rw [eval_substitute, map_zero] at he
  exact he

theorem same_vanishing_of_regular (H : ℕ → ℕ → Prop) [DecidableRel H]
    (hs : ∀ {i j}, H i j → H j i) (hr : ∀ i, ¬ H i i) (d : ℕ)
    (L M : List ℕ) (hL : L.Nodup) (hM : M.Nodup) (hset : L.toFinset = M.toFinset)
    (hregL : gramPolynomial (family H d L) L.toFinset ≠ 0)
    (hregM : gramPolynomial (family H d M) M.toFinset ≠ 0) :
    SameVanishing (flat (family H d L)) (flat (family H d M)) := by
  intro P
  exact ⟨vanishing_transfer_of_regular H hs hr d L M hL hM hset hregM P,
    vanishing_transfer_of_regular H hs hr d M L hM hL hset.symm hregL P⟩

theorem small_orders_same_vanishing (H : ℕ → ℕ → Prop) [DecidableRel H]
    (hs : ∀ {i j}, H i j → H j i) (hr : ∀ i, ¬ H i i) (d : ℕ)
    (L M : List ℕ) (hL : L.Nodup) (hM : M.Nodup) (hset : L.toFinset = M.toFinset)
    (hdL : L.length ≤ d) (hdM : M.length ≤ d) :
    SameVanishing (flat (family H d L)) (flat (family H d M)) := by
  exact same_vanishing_of_regular H hs hr d L M hL hM hset
    ((gram_ne_zero_iff _ _).mpr (small_list_independent H hr d L hL hdL))
    ((gram_ne_zero_iff _ _).mpr (small_list_independent H hr d M hM hdM))

end P14SmallOrderVanishing

end
end

section

/-! Global order invariance for the actual labelled Gram construction.
The proof is by the size of the processed set. At most d rows use the
attained independent locus; larger sets use biclique-forced complement
connectivity and the induction hypothesis only on smaller prefixes. -/

noncomputable section
namespace P14GlobalGramOrder
open P14LabelledGramFamily P14GramChoiceVanishing P14PolynomialImageExtension
open P14BicliqueComplementConnection P14LastVertexTransport P14SmallOrderVanishing

theorem order_invariant (H : ℕ → ℕ → Prop) [DecidableRel H]
    (hs : ∀ {i j}, H i j → H j i) (hr : ∀ i, ¬ H i i) (d : ℕ)
    (S : Finset ℕ) (hbound : BicliqueBound H S d) : OrderInvariant H d S := by
  have main : ∀ n (T : Finset ℕ), T.card = n → BicliqueBound H T d → OrderInvariant H d T := by
    intro n
    induction n using Nat.strong_induction_on with
    | h n ih =>
        intro T hcard hB
        have smaller : ∀ U ⊆ T, U.card < T.card → OrderInvariant H d U := by
          intro U hU hlt
          exact ih U.card (by omega) U rfl (bound_subset H T U d hB hU)
        intro L M hL hM hLT hMT
        by_cases hsmall : T.card ≤ d
        · have hl : L.length = T.card :=
            (List.toFinset_card_of_nodup hL).symm.trans (congrArg Finset.card hLT)
          have hm : M.length = T.card :=
            (List.toFinset_card_of_nodup hM).symm.trans (congrArg Finset.card hMT)
          exact small_orders_same_vanishing H hs hr d L M hL hM (hLT.trans hMT.symm)
            (hl.trans_le hsmall) (hm.trans_le hsmall)
        · have hlarge : d < T.card := Nat.lt_of_not_ge hsmall
          cases L with
          | nil =>
              have hz : T.card = 0 := by rw [← hLT]; rfl
              omega
          | cons a L =>
              cases M with
              | nil =>
                  have hz : T.card = 0 := by rw [← hMT]; rfl
                  omega
              | cons b M =>
                  have ha : a ∈ T := by rw [← hLT]; simp
                  have hb : b ∈ T := by rw [← hMT]; simp
                  have hc := connected_of_large H hs T d hB hlarge a b ha hb
                  have hleft := same_last_of_smaller H d T smaller a L hL hLT
                  have hright := same_last_of_smaller H d T smaller b M hM hMT
                  have hmid := connected_last_orders H d T smaller a b hc
                  intro P
                  exact (hleft P).trans ((hmid P).trans ((hright P).symm))
  exact main S.card S rfl hbound

theorem same_vanishing_orders (H : ℕ → ℕ → Prop) [DecidableRel H]
    (hs : ∀ {i j}, H i j → H j i) (hr : ∀ i, ¬ H i i) (d : ℕ)
    (L M : List ℕ) (hL : L.Nodup) (hM : M.Nodup) (hset : L.toFinset = M.toFinset)
    (hbound : BicliqueBound H L.toFinset d) :
    SameVanishing (flat (family H d L)) (flat (family H d M)) :=
  order_invariant H hs hr d L.toFinset hbound L M hL hM rfl hset.symm

end P14GlobalGramOrder

end
end

section

/-! Actual real general-position orthogonal representations under the
biclique bound. Each small subset is put first to obtain a nonzero Gram
polynomial; global order invariance transfers it to one fixed family.
A finite product gives one parameter satisfying every rank condition. -/

noncomputable section
namespace P14GenericOrthogonalRepresentation
open MvPolynomial P14PolynomialGramChoice P14GramChoiceVanishing
open P14LabelledGramFamily P14LabelledGramGeometry P14LabelledGramBasis
open P14BicliqueComplementConnection P14GlobalGramOrder
open scoped Matrix

theorem gram_nonzero_subset (H : ℕ → ℕ → Prop) [DecidableRel H]
    (hs : ∀ {i j}, H i j → H j i) (hr : ∀ i, ¬ H i i) (d : ℕ)
    (S : Finset ℕ) (hbound : BicliqueBound H S d)
    (L : List ℕ) (hL : L.Nodup) (hLS : L.toFinset = S)
    (B : Finset ℕ) (hB : B ⊆ S) (hBd : B.card ≤ d) :
    gramPolynomial (family H d L) B ≠ 0 := by
  let K := (S \ B).toList
  let M := B.toList
  have hdis : ∀ i ∈ K, i ∉ M := by
    intro i hi hj
    exact (Finset.mem_sdiff.mp (Finset.mem_toList.mp hi)).2 (Finset.mem_toList.mp hj)
  have hKM : (K ++ M).Nodup := by
    apply List.nodup_append.mpr
    refine ⟨Finset.nodup_toList _, Finset.nodup_toList _, ?_⟩
    intro i hi j hj heq
    exact hdis i hi (heq.symm ▸ hj)
  have hsupport : (K ++ M).toFinset = S := by
    rw [List.toFinset_append]
    change (S \ B).toList.toFinset ∪ B.toList.toFinset = S
    rw [Finset.toList_toFinset, Finset.toList_toFinset, Finset.sdiff_union_of_subset hB]
  have hMd : M.length ≤ d := by simpa only [M, Finset.length_toList] using hBd
  have hnonzero : gramPolynomial (family H d (K ++ M)) B ≠ 0 := by
    have h := prefix_gram_nonzero H hr d K M (Finset.nodup_toList _) hMd hdis
    simpa only [M, Finset.toList_toFinset] using h
  have hv := order_invariant H hs hr d S hbound (K ++ M) L hKM hL hsupport hLS
  exact (gram_nonzero_iff (family H d (K ++ M)) (family H d L) hv B).mp hnonzero

theorem exists_general_position (H : ℕ → ℕ → Prop) [DecidableRel H]
    (hs : ∀ {i j}, H i j → H j i) (hr : ∀ i, ¬ H i i) (d : ℕ)
    (S : Finset ℕ) (hbound : BicliqueBound H S d) :
    ∃ v : ℕ → Fin d → ℝ,
      (∀ i ∈ S, ∀ j ∈ S, H i j → v i ⬝ᵥ v j = 0) ∧
      (∀ B ⊆ S, B.card ≤ d → LinearIndependent ℝ (fun i : B => v i)) := by
  classical
  let L := S.toList
  let C := S.powerset.filter (fun B => B.card ≤ d)
  let P := family H d L
  have hQ : ∀ B : C, gramPolynomial P B.val ≠ 0 := by
    intro B
    have hb := Finset.mem_filter.mp B.property
    exact gram_nonzero_subset H hs hr d S hbound L (Finset.nodup_toList _)
      (Finset.toList_toFinset _) B.val (Finset.mem_powerset.mp hb.1) hb.2
  obtain ⟨z, hz⟩ := P14PolynomialThreeRows.exists_common_nonzero
    (fun B : C => gramPolynomial P B.val) hQ
  refine ⟨rowsAt P z, ?_, ?_⟩
  · intro i hi j hj hij
    exact P14LabelledGramGeometry.edge_orthogonal H hs hr d L (Finset.nodup_toList _) z i j
      (Finset.mem_toList.mpr hi) (Finset.mem_toList.mpr hj) hij
  · intro B hB hBd
    have hc : B ∈ C := Finset.mem_filter.mpr ⟨Finset.mem_powerset.mpr hB, hBd⟩
    exact (eval_gram_iff P B z).mp (hz ⟨B, hc⟩)

theorem exists_nonzero_general_position (H : ℕ → ℕ → Prop) [DecidableRel H]
    (hs : ∀ {i j}, H i j → H j i) (hr : ∀ i, ¬ H i i) (d : ℕ) (hd : 1 ≤ d)
    (S : Finset ℕ) (hbound : BicliqueBound H S d) :
    ∃ v : ℕ → Fin d → ℝ,
      (∀ i ∈ S, v i ≠ 0) ∧
      (∀ i ∈ S, ∀ j ∈ S, H i j → v i ⬝ᵥ v j = 0) ∧
      (∀ B ⊆ S, B.card ≤ d → LinearIndependent ℝ (fun i : B => v i)) := by
  obtain ⟨v, horth, hrank⟩ := exists_general_position H hs hr d S hbound
  refine ⟨v, ?_, horth, hrank⟩
  intro i hi
  have hli := hrank {i} (Finset.singleton_subset_iff.mpr hi) (by simpa using hd)
  exact hli.ne_zero ⟨i, Finset.mem_singleton_self i⟩

end P14GenericOrthogonalRepresentation

end
end

section

/-! Restrict the actual Nat-labelled graph representation to Fin m and
turn dimension-sized independence into the spanning condition needed by
the exact complex UPB assembly. -/

noncomputable section
namespace P14GenericFiniteRows
open Submodule P14GenericOrthogonalRepresentation P14BicliqueComplementConnection
open scoped Matrix

theorem independent_fin (d m : ℕ) (v : ℕ → Fin d → ℝ)
    (hrank : ∀ B ⊆ Finset.range m, B.card ≤ d → LinearIndependent ℝ (fun i : B => v i))
    (A : Finset (Fin m)) (hA : A.card ≤ d) :
    LinearIndependent ℝ (fun i : A => v i.val.val) := by
  let B := A.image Fin.val
  have hB : B ⊆ Finset.range m := by
    intro n hn
    obtain ⟨i, hi, rfl⟩ := Finset.mem_image.mp hn
    exact Finset.mem_range.mpr i.isLt
  have hc : B.card ≤ d := by
    simpa only [B, Finset.card_image_of_injective _ Fin.val_injective] using hA
  let f : A → B := fun i => ⟨i.val.val, Finset.mem_image.mpr ⟨i.val, i.property, rfl⟩⟩
  have hf : Function.Injective f := by
    intro i j h
    apply Subtype.ext
    apply Fin.ext
    exact congrArg (fun x : B => (x : ℕ)) h
  exact (hrank B hB hc).comp f hf

theorem spans_fin (d m : ℕ) (v : ℕ → Fin d → ℝ)
    (hrank : ∀ B ⊆ Finset.range m, B.card ≤ d → LinearIndependent ℝ (fun i : B => v i))
    (A : Finset (Fin m)) (hA : A.card = d) :
    span ℝ (Set.range (fun i : A => v i.val.val)) = ⊤ := by
  apply (independent_fin d m v hrank A hA.le).span_eq_top_of_card_eq_finrank'
  simpa using hA

theorem exists_fin_rows (H : ℕ → ℕ → Prop)
    (hs : ∀ {i j}, H i j → H j i) (hr : ∀ i, ¬ H i i) (d m : ℕ) (hd : 1 ≤ d)
    (hbound : BicliqueBound H (Finset.range m) d) :
    ∃ v : Fin m → Fin d → ℝ,
      (∀ i, v i ≠ 0) ∧
      (∀ (i j : Fin m), H i.val j.val → v i ⬝ᵥ v j = 0) ∧
      (∀ A : Finset (Fin m), A.card = d → span ℝ (Set.range (fun i : A => v i)) = ⊤) := by
  classical
  obtain ⟨v, hnz, horth, hrank⟩ := exists_nonzero_general_position H hs hr d hd (Finset.range m) hbound
  refine ⟨fun i => v i.val, ?_, ?_, ?_⟩
  · intro i
    exact hnz i.val (Finset.mem_range.mpr i.isLt)
  · intro i j hij
    exact horth i.val (Finset.mem_range.mpr i.isLt) j.val (Finset.mem_range.mpr j.isLt) hij
  · exact fun A hA => spans_fin d m v hrank A hA

end P14GenericFiniteRows

end
end

section

/-! The one-exceptional-factor assembly, with ordinary local vectors
constructed from biclique bounds rather than supplied as a premise. The
exceptional coordinates and the finite graph cover remain explicit inputs. -/

noncomputable section
namespace P14GenericExceptionalUPB
open Submodule P14BicliqueComplementConnection
open scoped BigOperators Matrix

theorem complex_rows (H : ℕ → ℕ → Prop)
    (hs : ∀ {i j}, H i j → H j i) (hr : ∀ i, ¬ H i i)
    (d m : ℕ) (hd : 1 ≤ d) (hbound : BicliqueBound H (Finset.range m) d) :
    ∃ x : Fin m → Fin d → ℂ,
      (∀ i, x i ≠ 0) ∧
      (∀ (i i' : Fin m), H i.val i'.val → (∑ r, star (x i r) * x i' r) = 0) ∧
      (∀ A : Finset (Fin m), A.card = d →
        span ℂ (Set.range (fun i : A => x i)) = ⊤) := by
  obtain ⟨v, hnz, horth, hspan⟩ := P14GenericFiniteRows.exists_fin_rows H hs hr d m hd hbound
  refine ⟨fun i => P14RealComplex.embed (v i), ?_, ?_, ?_⟩
  · intro i hz
    apply hnz i
    apply P14RealComplex.embed_injective
    simpa only [map_zero] using hz
  · intro i i' hij
    rw [P14RealComplex.pair]
    change ((v i ⬝ᵥ v i' : ℝ) : ℂ) = 0
    rw [horth i i' hij, Complex.ofReal_zero]
  · intro A hA
    exact P14RealComplex.spanning (fun i : A => v i) (hspan A hA)

theorem coordinates {p m : ℕ} (d : Fin p → ℕ) (t : Fin p)
    (H : Fin p → ℕ → ℕ → Prop)
    (e : Fin m → Fin (d t) → ℂ)
    (hd : ∀ j, 1 ≤ d j)
    (hs : ∀ j, j ≠ t → ∀ {a b}, H j a b → H j b a)
    (hr : ∀ j, j ≠ t → ∀ a, ¬ H j a a)
    (hbound : ∀ j, j ≠ t → BicliqueBound (H j) (Finset.range m) (d j))
    (henz : ∀ i, e i ≠ 0)
    (hespan : ∀ A : Finset (Fin m), A.card = d t + 1 →
      span ℂ (Set.range (fun i : A => e i)) = ⊤)
    (heorth : ∀ (i i' : Fin m), H t i.val i'.val →
      (∑ r, star (e i r) * e i' r) = 0)
    (hcover : ∀ (i i' : Fin m), i ≠ i' → ∃ j, H j i.val i'.val)
    (hbudget : (∑ j, if j = t then d j else d j - 1) < m) :
    ∃ v : Fin m → (j : Fin p) → Fin (d j) → ℂ,
      (∀ i j, v i j ≠ 0) ∧
      (∀ i i', i ≠ i' →
        ∃ j, (∑ r, star (v i j r) * v i' j r) = 0) ∧
      (∀ a : (j : Fin p) → Fin (d j) → ℂ, (∀ j, a j ≠ 0) →
        ∃ i, ∀ j, (∑ r, star (v i j r) * a j r) ≠ 0) := by
  classical
  let c : Fin p → ℕ := fun j => if j = t then d j else d j - 1
  have hex : ∀ j, ∃ x : Fin m → Fin (d j) → ℂ,
      (∀ i, x i ≠ 0) ∧
      (∀ (i i' : Fin m), H j i.val i'.val → (∑ r, star (x i r) * x i' r) = 0) ∧
      (∀ A : Finset (Fin m), A.card = c j + 1 →
        span ℂ (Set.range (fun i : A => x i)) = ⊤) := by
    intro j
    by_cases hj : j = t
    · subst j
      exact ⟨e, henz, heorth, fun A hA => hespan A (by simpa [c] using hA)⟩
    · obtain ⟨x, hnz, horth, hspan⟩ :=
        complex_rows (H j) (hs j hj) (hr j hj) (d j) m (hd j) (hbound j hj)
      refine ⟨x, hnz, horth, ?_⟩
      intro A hA
      apply hspan A
      simpa [c, hj, Nat.sub_add_cancel (hd j)] using hA
  choose x hnz horth hspan using hex
  apply P14ComplexRowsUPB.coordinates d c (fun i j => x j i)
  · exact fun i j => hnz j i
  · exact hspan
  · intro i i' hne
    obtain ⟨j, hj⟩ := hcover i i' hne
    exact ⟨j, horth j i i' hj⟩
  · simpa [c] using hbudget

end P14GenericExceptionalUPB

end
end

section

/-! Literal mixed-dimensional canonical UPBs without an ordinary dimension upper bound from actual local factors and
the complete higher-dimensional graph cover. No local existence premise remains. -/

noncomputable section
namespace P14HighDimensionFlexibleUPB
open P14ComplexLocalCover P14HighDimensionLocalFactor P14OddLayerLabels
open scoped BigOperators

def dimensions {p : ℕ} (d : ℕ) (r : Fin p → ℕ) (m : ℕ) : Fin (p + m + 1) → ℕ :=
  Fin.cons d (Fin.append (fun i => r i + 1) (fun _ : Fin m => 2))

def caps {p : ℕ} (d : ℕ) (r : Fin p → ℕ) (m : ℕ) : Fin (p + m + 1) → ℕ :=
  Fin.cons d (Fin.append r (fun _ : Fin m => 1))

theorem sum_caps {p : ℕ} (d : ℕ) (r : Fin p → ℕ) (m : ℕ) :
    (∑ j, caps d r m j) = d + (∑ i, r i) + m := by
  simp [caps, Fin.sum_univ_succ, Fin.sum_univ_add, Nat.add_assoc]

theorem sum_deficits {p : ℕ} (d : ℕ) (r : Fin p → ℕ) (m : ℕ) :
    (∑ j, (dimensions d r m j - 1)) = (d - 1) + (∑ i, r i) + m := by
  simp [dimensions, Fin.sum_univ_succ, Fin.sum_univ_add, Nat.add_assoc]

theorem local_factor {q d : ℕ} [NeZero q] (hq : 7 ≤ q) (ho : Odd q)
    (hd : 6 ≤ d) (hdq : d ≤ q) :
    HasLocalFactor (Fin q ⊕ Fin q) d d (Prescribed d) := by
  have he : d = (d - 6) + 6 := by omega
  rw [he]
  exact exists_factor hq ho (by omega)

theorem canonical {q d p m : ℕ} [NeZero q] (hq : 7 ≤ q) (ho : Odd q)
    (hd : 6 ≤ d) (hdq : d ≤ q) (hp : 0 < p) (r : Fin p → ℕ)
    (hr : ∀ i, d - 1 ≤ r i)
    (htotal : (∑ i, r i) + m = 2 * q - d - 1) :
    P14CanonicalUPBTransport.Conclusion (p + m + 1) (dimensions d r m) := by
  classical
  obtain ⟨H, F, hH, hF, hFne, hcover⟩ :=
    P14HighDimensionFlexibleGraphCover.construct hq ho hd hdq hp r hr htotal
  let R : Fin (p + m + 1) → (Fin q ⊕ Fin q) → (Fin q ⊕ Fin q) → Prop :=
    Fin.cons (Prescribed d) (Fin.append
      (fun i u v => H i (encode u) (encode v)) (fun c u v => F c u = v))
  have hord : ∀ i, HasLocalFactor (Fin q ⊕ Fin q) (r i + 1) (r i)
      (fun u v => H i (encode u) (encode v)) := by
    intro i
    obtain ⟨x, hnz, hpair, hspan⟩ :=
      P14GenericExceptionalUPB.complex_rows (H i) (hH i).1 (hH i).2.1
        (r i + 1) (2 * q) (by omega) (hH i).2.2
    have hx : HasLocalFactor (Fin (2 * q)) (r i + 1) (r i)
        (fun u v => H i u.val v.val) := ⟨x, hnz, hspan, hpair⟩
    exact reindex (rowEquiv q) hx
  have hlocal : ∀ j, HasLocalFactor (Fin q ⊕ Fin q)
      (dimensions d r m j) (caps d r m j) (R j) := by
    intro j
    refine Fin.cases ?_ (fun c => ?_) j
    · exact local_factor hq ho hd hdq
    · refine Fin.addCases (fun i => ?_) (fun c => ?_) c
      · simpa only [dimensions, caps, R, Fin.cons_succ, Fin.append_left] using hord i
      · simpa only [dimensions, caps, R, Fin.cons_succ, Fin.append_right] using
          P14MatchingLocalFactor.on_finite (F c) (hF c) (hFne c)
  have hcomplete : ∀ u v : Fin q ⊕ Fin q, u ≠ v → ∃ j, R j u v := by
    intro u v huv
    rcases hcover u v huv with he | ⟨i, hi⟩ | ⟨c, hc⟩
    · exact ⟨0, he⟩
    · refine ⟨(Fin.castAdd m i).succ, ?_⟩
      simpa only [R, Fin.cons_succ, Fin.append_left] using hi
    · refine ⟨(Fin.natAdd p c).succ, ?_⟩
      simpa only [R, Fin.cons_succ, Fin.append_right] using hc
  have hcard : Fintype.card (Fin q ⊕ Fin q) = 2 * q := by simp [two_mul]
  have hbudget : (∑ j, caps d r m j) < Fintype.card (Fin q ⊕ Fin q) := by
    rw [sum_caps, hcard]
    omega
  have hbound : Fintype.card (Fin q ⊕ Fin q) ≤
      2 + ∑ j, (dimensions d r m j - 1) := by
    rw [sum_deficits, hcard]
    omega
  exact P14ComplexLocalCover.canonical (dimensions d r m) (caps d r m) R
    hlocal hcomplete hbudget hbound

theorem of_dimensions {q d p m k : ℕ} [NeZero q] (hq : 7 ≤ q) (ho : Odd q)
    (hd : 6 ≤ d) (hdq : d ≤ q) (hp : 0 < p) (r : Fin p → ℕ)
    (hr : ∀ i, d - 1 ≤ r i)
    (htotal : (∑ i, r i) + m = 2 * q - d - 1)
    (D : Fin k → ℕ) (e : Fin k ≃ Fin (p + m + 1))
    (he : ∀ j, D j = dimensions d r m (e j)) :
    P14CanonicalUPBTransport.Conclusion k D :=
  P14CanonicalUPBTransport.of_dimensions (dimensions d r m) D e he
    (canonical hq ho hd hdq hp r hr htotal)

end P14HighDimensionFlexibleUPB
end
end

section

/-! An actual finite reordering separates arbitrary non-qubit dimensions
from qubits. No externally supplied partition or permutation is assumed. -/

noncomputable section
namespace P14NonQubitPartition
open scoped BigOperators

def lift {m n : ℕ} (e : Fin m ≃ Fin n) : Fin (m + 1) ≃ Fin (n + 1) :=
  (finSuccEquiv m).trans ((Equiv.optionCongr e).trans (finSuccEquiv n).symm)

@[simp] theorem lift_zero {m n : ℕ} (e : Fin m ≃ Fin n) : lift e 0 = 0 := by
  simp [lift, Equiv.optionCongr]

@[simp] theorem lift_succ {m n : ℕ} (e : Fin m ≃ Fin n) (i : Fin m) :
    lift e i.succ = (e i).succ := by
  simp [lift, Equiv.optionCongr]

theorem split {n : ℕ} (d : Fin n → ℕ) (hd : ∀ j, 2 ≤ d j) :
    ∃ p m : ℕ, ∃ r : Fin p → ℕ, ∃ E : Fin (p + m) ≃ Fin n,
      (∀ i, 2 ≤ r i) ∧
      (∀ j, d (E j) = Fin.append (fun i => r i + 1) (fun _ : Fin m => 2) j) := by
  classical
  let A := {j : Fin n // d j ≠ 2}
  let B := {j : Fin n // ¬ d j ≠ 2}
  let p := Fintype.card A
  let m := Fintype.card B
  let ea : Fin p ≃ A := (Fintype.equivFin A).symm
  let eb : Fin m ≃ B := (Fintype.equivFin B).symm
  let r : Fin p → ℕ := fun i => d (ea i).val - 1
  let E : Fin (p + m) ≃ Fin n :=
    finSumFinEquiv.symm.trans ((Equiv.sumCongr ea eb).trans (Equiv.sumCompl (fun j => d j ≠ 2)))
  have hr : ∀ i, 2 ≤ r i := by
    intro i
    have hn := (ea i).property
    have h := hd (ea i).val
    dsimp only [r]
    omega
  refine ⟨p, m, r, E, hr, ?_⟩
  intro j
  refine Fin.addCases (fun i => ?_) (fun i => ?_) j
  · simp only [E, Equiv.trans_apply, finSumFinEquiv_symm_apply_castAdd,
      Equiv.sumCongr_apply, Sum.map_inl, Equiv.sumCompl_apply_inl, Fin.append_left]
    change d (ea i).val = r i + 1
    have h := hd (ea i).val
    dsimp only [r]
    omega
  · simp only [E, Equiv.trans_apply, finSumFinEquiv_symm_apply_natAdd,
      Equiv.sumCongr_apply, Sum.map_inr, Equiv.sumCompl_apply_inr, Fin.append_right]
    change d (eb i).val = 2
    exact not_not.mp (eb i).property

theorem large_witness {n p m b : ℕ} (d : Fin n → ℕ) (r : Fin p → ℕ)
    (E : Fin (p + m) ≃ Fin n)
    (he : ∀ j, d (E j) = Fin.append (fun i => r i + 1) (fun _ : Fin m => 2) j)
    (hb : 3 ≤ b) (hw : ∃ j, b ≤ d j) : ∃ i, b ≤ r i + 1 := by
  obtain ⟨j, hj⟩ := hw
  have h : b ≤ Fin.append (fun i => r i + 1) (fun _ : Fin m => 2) (E.symm j) := by
    rw [← he, Equiv.apply_symm_apply]
    exact hj
  have step : ∀ u : Fin (p + m),
      b ≤ Fin.append (fun i => r i + 1) (fun _ : Fin m => 2) u →
      ∃ i, b ≤ r i + 1 := by
    intro u
    refine Fin.addCases (fun i hi => ?_) (fun i hi => ?_) u
    · exact ⟨i, by simpa only [Fin.append_left] using hi⟩
    · have htwo : b ≤ 2 := by simpa only [Fin.append_right] using hi
      omega
  exact step _ h

end P14NonQubitPartition

end
end

section

/-! Refined four-cell bound when cross edges are sparser than within edges.
Within-layer degrees suffice for mixed bicliques; pure-layer bicliques
retain their own potentially larger cardinality bound. -/
noncomputable section
namespace P14SparseCrossBiclique
open P14BicliqueComplementConnection P14TwoLayerBiclique

theorem four_cells (a b c d s t D : ℕ)
    (hA : 0 < a + b) (hB : 0 < c + d) (ht : t < s) (hD : s + t + 1 ≤ D)
    (hac : 0 < a → 0 < c → a ≤ s ∧ c ≤ s ∧ a + c ≤ D)
    (hbd : 0 < b → 0 < d → b ≤ s ∧ d ≤ s ∧ b + d ≤ D)
    (had : 0 < a → 0 < d → a + d ≤ t + 1)
    (hbc : 0 < b → 0 < c → b + c ≤ t + 1) :
    a + b + (c + d) ≤ D := by
  by_cases ha : a = 0 <;> by_cases hb : b = 0 <;>
    by_cases hc : c = 0 <;> by_cases hd : d = 0 <;> omega

theorem combine (H : ℕ → ℕ → Prop) (C : ℕ → Prop)
    (S : Finset ℕ) (s t D : ℕ) (ht : t < s) (hD : s + t + 1 ≤ D)
    (hsym : ∀ {i j}, H i j → H j i)
    (hdeg : ∀ i ∈ S, ∀ B ⊆ S,
      (∀ j ∈ B, H i j ∧ Within C i j) → B.card ≤ s)
    (hw : BicliqueBound (fun i j => H i j ∧ Within C i j) S D)
    (hx : BicliqueBound (fun i j => H i j ∧ Across C i j) S (t + 1)) :
    BicliqueBound H S D := by
  classical
  intro A hAS B hBS hA hB hdis hedge
  have part_bound (P Q : ℕ → Prop) [DecidablePred P] [DecidablePred Q]
      (K : ℕ → ℕ → Prop) (k : ℕ)
      (hk : BicliqueBound K S k)
      (hK : ∀ i ∈ A.filter P, ∀ j ∈ B.filter Q, K i j)
      (hp : 0 < (A.filter P).card) (hq : 0 < (B.filter Q).card) :
      (A.filter P).card + (B.filter Q).card ≤ k := by
    apply hk (A.filter P) ((Finset.filter_subset _ _).trans hAS)
      (B.filter Q) ((Finset.filter_subset _ _).trans hBS)
      (Finset.card_pos.mp hp) (Finset.card_pos.mp hq)
    · exact hdis.mono (Finset.filter_subset _ _) (Finset.filter_subset _ _)
    · exact hK
  have h00b : 0 < (A.filter C).card → 0 < (B.filter C).card →
      (A.filter C).card + (B.filter C).card ≤ D := by
    apply part_bound C C _ _ hw
    intro i hi j hj
    have hi' := Finset.mem_filter.mp hi
    have hj' := Finset.mem_filter.mp hj
    exact ⟨hedge i hi'.1 j hj'.1, Or.inl ⟨hi'.2, hj'.2⟩⟩
  have h11b : 0 < (A.filter (fun i => ¬ C i)).card →
      0 < (B.filter (fun i => ¬ C i)).card →
      (A.filter (fun i => ¬ C i)).card + (B.filter (fun i => ¬ C i)).card ≤ D := by
    apply part_bound (fun i => ¬ C i) (fun i => ¬ C i) _ _ hw
    intro i hi j hj
    have hi' := Finset.mem_filter.mp hi
    have hj' := Finset.mem_filter.mp hj
    exact ⟨hedge i hi'.1 j hj'.1, Or.inr ⟨hi'.2, hj'.2⟩⟩
  have h01 : 0 < (A.filter C).card → 0 < (B.filter (fun i => ¬ C i)).card →
      (A.filter C).card + (B.filter (fun i => ¬ C i)).card ≤ t + 1 := by
    apply part_bound C (fun i => ¬ C i) _ _ hx
    intro i hi j hj
    have hi' := Finset.mem_filter.mp hi
    have hj' := Finset.mem_filter.mp hj
    exact ⟨hedge i hi'.1 j hj'.1, Or.inl ⟨hi'.2, hj'.2⟩⟩
  have h10 : 0 < (A.filter (fun i => ¬ C i)).card → 0 < (B.filter C).card →
      (A.filter (fun i => ¬ C i)).card + (B.filter C).card ≤ t + 1 := by
    apply part_bound (fun i => ¬ C i) C _ _ hx
    intro i hi j hj
    have hi' := Finset.mem_filter.mp hi
    have hj' := Finset.mem_filter.mp hj
    exact ⟨hedge i hi'.1 j hj'.1, Or.inr ⟨hi'.2, hj'.2⟩⟩

  have part_degree (P Q : ℕ → Prop) [DecidablePred P] [DecidablePred Q]
      (hK : ∀ i ∈ A.filter P, ∀ j ∈ B.filter Q, H i j ∧ Within C i j)
      (hp : 0 < (A.filter P).card) (hq : 0 < (B.filter Q).card) :
      (A.filter P).card ≤ s ∧ (B.filter Q).card ≤ s := by
    obtain ⟨i, hi⟩ := Finset.card_pos.mp hp
    obtain ⟨j, hj⟩ := Finset.card_pos.mp hq
    constructor
    · apply hdeg j (hBS (Finset.mem_filter.mp hj).1)
        (A.filter P) ((Finset.filter_subset _ _).trans hAS)
      intro x hx
      obtain ⟨he, hw⟩ := hK x hx j hj
      refine ⟨hsym he, ?_⟩
      rcases hw with ⟨hx, hj⟩ | ⟨hx, hj⟩
      · exact Or.inl ⟨hj, hx⟩
      · exact Or.inr ⟨hj, hx⟩
    · exact hdeg i (hAS (Finset.mem_filter.mp hi).1)
        (B.filter Q) ((Finset.filter_subset _ _).trans hBS) (fun y hy => hK i hi y hy)
  have h00 : 0 < (A.filter C).card → 0 < (B.filter C).card →
      (A.filter C).card ≤ s ∧ (B.filter C).card ≤ s ∧
        (A.filter C).card + (B.filter C).card ≤ D := by
    intro ha hb
    have hd := part_degree C C (by
      intro i hi j hj
      obtain ⟨hiA, hic⟩ := Finset.mem_filter.mp hi
      obtain ⟨hjB, hjc⟩ := Finset.mem_filter.mp hj
      exact ⟨hedge i hiA j hjB, Or.inl ⟨hic, hjc⟩⟩) ha hb
    exact ⟨hd.1, hd.2, h00b ha hb⟩
  have h11 : 0 < (A.filter (fun i => ¬ C i)).card →
      0 < (B.filter (fun i => ¬ C i)).card →
      (A.filter (fun i => ¬ C i)).card ≤ s ∧ (B.filter (fun i => ¬ C i)).card ≤ s ∧
        (A.filter (fun i => ¬ C i)).card + (B.filter (fun i => ¬ C i)).card ≤ D := by
    intro ha hb
    have hd := part_degree (fun i => ¬ C i) (fun i => ¬ C i) (by
      intro i hi j hj
      obtain ⟨hiA, hic⟩ := Finset.mem_filter.mp hi
      obtain ⟨hjB, hjc⟩ := Finset.mem_filter.mp hj
      exact ⟨hedge i hiA j hjB, Or.inr ⟨hic, hjc⟩⟩) ha hb
    exact ⟨hd.1, hd.2, h11b ha hb⟩

  have hAc := Finset.card_filter_add_card_filter_not (s := A) C
  have hBc := Finset.card_filter_add_card_filter_not (s := B) C
  have hAp := Finset.card_pos.mpr hA
  have hBp := Finset.card_pos.mpr hB
  have h := four_cells (A.filter C).card (A.filter (fun i => ¬ C i)).card
    (B.filter C).card (B.filter (fun i => ¬ C i)).card s t D
    (by omega) (by omega) ht hD h00 h11 h01 h10
  omega

end P14SparseCrossBiclique
end
end

section

/-! Dense internal complements of one nonzero cyclic step per layer.
No coprimality or connectedness assumption on those steps is needed.
Sparse consecutive cross edges give the full target biclique bound. -/
noncomputable section
namespace P14DenseLayerComplement
open P14BicliqueComplementConnection P14TwoLayerBiclique P14LayerBlockBiclique
variable {q : ℕ} [NeZero q]

def W (C : ℕ → Prop) (g : ℕ → ZMod q) (a b : ZMod q) (i j : ℕ) : Prop :=
  (C i ∧ C j ∧ g j - g i ∉ ({0, a, -a} : Finset (ZMod q))) ∨
  (¬ C i ∧ ¬ C j ∧ g j - g i ∉ ({0, b, -b} : Finset (ZMod q)))

def H (C : ℕ → Prop) (g : ℕ → ZMod q) (a b c : ZMod q) (t i j : ℕ) : Prop :=
  W C g a b i j ∨ CrossEdge C g c t i j

theorem neg_avoid (a z : ZMod q) (h : z ∉ ({0, a, -a} : Finset (ZMod q))) :
    -z ∉ ({0, a, -a} : Finset (ZMod q)) := by
  simp only [Finset.mem_insert, Finset.mem_singleton] at h ⊢
  intro hz
  apply h
  rcases hz with he | he | he
  · exact Or.inl (neg_eq_zero.mp he)
  · exact Or.inr (Or.inr (by simpa using congrArg Neg.neg he))
  · exact Or.inr (Or.inl (by simpa using congrArg Neg.neg he))

theorem within {C : ℕ → Prop} {g : ℕ → ZMod q} {a b : ZMod q} {i j : ℕ}
    (h : W C g a b i j) : Within C i j := by
  rcases h with ⟨hi, hj, _⟩ | ⟨hi, hj, _⟩
  · exact Or.inl ⟨hi, hj⟩
  · exact Or.inr ⟨hi, hj⟩

theorem w_symmetric {C : ℕ → Prop} {g : ℕ → ZMod q} {a b : ZMod q} {i j : ℕ}
    (h : W C g a b i j) : W C g a b j i := by
  rcases h with ⟨hi, hj, he⟩ | ⟨hi, hj, he⟩
  · exact Or.inl ⟨hj, hi, by simpa only [neg_sub] using neg_avoid a _ he⟩
  · exact Or.inr ⟨hj, hi, by simpa only [neg_sub] using neg_avoid b _ he⟩

theorem symmetric (C : ℕ → Prop) (g : ℕ → ZMod q) (a b c : ZMod q) (t : ℕ)
    {i j : ℕ} (h : H C g a b c t i j) : H C g a b c t j i := by
  rcases h with hw | hc
  · exact Or.inl (w_symmetric hw)
  · exact Or.inr (cross_symmetric C g c t hc)

theorem irreflexive (C : ℕ → Prop) (g : ℕ → ZMod q) (a b c : ZMod q) (t i : ℕ) :
    ¬ H C g a b c t i i := by
  rintro (hw | hc)
  · rcases hw with ⟨_, _, hn⟩ | ⟨_, _, hn⟩ <;> simp at hn
  · rcases hc with ⟨hi, hni, _⟩ | ⟨hni, hi, _⟩ <;> exact hni hi

theorem difference_degree (B : Finset ℕ) (g : ℕ → ZMod q) (x a : ZMod q)
    (ho : Odd q) (ha : a ≠ 0) (hg : Set.InjOn g B)
    (he : ∀ j ∈ B, g j - x ∉ ({0, a, -a} : Finset (ZMod q))) :
    B.card ≤ q - 3 := by
  classical
  let T : Finset (ZMod q) := {x, x + a, x - a}
  have haneg : a ≠ -a := ZMod.ne_neg_self ho ha
  have hxa : x ≠ x + a := by intro h; exact ha (by have h' := add_left_cancel (h.symm.trans (add_zero x).symm); exact h')
  have hxb : x ≠ x - a := by
    intro h
    have h' := congrArg (fun z : ZMod q => z - x) h
    have hz : -a = 0 := by simpa using h'.symm
    exact ha (neg_eq_zero.mp hz)
  have hab : x + a ≠ x - a := by
    intro h
    exact haneg (add_left_cancel (by simpa only [sub_eq_add_neg] using h))
  have hT : T.card = 3 := by simp [T, hxa, hxb, hab]
  have hdis : Disjoint (B.image g) T := by
    apply Finset.disjoint_left.mpr
    intro z hz ht
    obtain ⟨j, hj, rfl⟩ := Finset.mem_image.mp hz
    have hn := he j hj
    simp only [T, Finset.mem_insert, Finset.mem_singleton] at ht
    rcases ht with hh | hh | hh
    · apply hn
      simp [hh]
    · apply hn
      simp [hh]
    · apply hn
      simp [hh]
  have hu : ((B.image g) ∪ T).card ≤ q := by
    simpa using Finset.card_le_univ ((B.image g) ∪ T)
  rw [Finset.card_union_of_disjoint hdis, Finset.card_image_of_injOn hg, hT] at hu
  omega

theorem w_degree (C : ℕ → Prop) (S : Finset ℕ) (g : ℕ → ZMod q)
    (hg : LayerInjective C S g) (a b : ZMod q) (ho : Odd q) (ha : a ≠ 0) (hb : b ≠ 0)
    (i : ℕ) (hi : i ∈ S) (B : Finset ℕ) (hBS : B ⊆ S)
    (he : ∀ j ∈ B, W C g a b i j) : B.card ≤ q - 3 := by
  have hgj : Set.InjOn g B := by
    intro x hx y hy hxy
    exact hg x (hBS hx) y (hBS hy)
      ((same_layer (within (he x hx))).symm.trans (same_layer (within (he y hy)))) hxy
  by_cases hci : C i
  · apply difference_degree B g (g i) a ho ha hgj
    intro j hj
    rcases he j hj with ⟨_, _, hn⟩ | ⟨hn, _, _⟩
    · exact hn
    · exact False.elim (hn hci)
  · apply difference_degree B g (g i) b ho hb hgj
    intro j hj
    rcases he j hj with ⟨hn, _, _⟩ | ⟨_, _, hn⟩
    · exact False.elim (hci hn)
    · exact hn

theorem w_bound (C : ℕ → Prop) (S : Finset ℕ) (g : ℕ → ZMod q)
    (hg : LayerInjective C S g) (a b : ZMod q) : BicliqueBound (W C g a b) S q := by
  classical
  intro A hAS B hBS hA hB hdis hedge
  obtain ⟨i, hi⟩ := hA
  obtain ⟨j, hj⟩ := hB
  have hall : ∀ z ∈ A ∪ B, C z ↔ C i := by
    intro z hz
    rcases Finset.mem_union.mp hz with hza | hzb
    · exact (same_layer (within (hedge z hza j hj))).trans
        (same_layer (within (hedge i hi j hj))).symm
    · exact (same_layer (within (hedge i hi z hzb))).symm
  have hinj : Set.InjOn g ((A ∪ B : Finset ℕ) : Set ℕ) := by
    intro x hx y hy hxy
    apply hg x (Finset.union_subset hAS hBS hx) y (Finset.union_subset hAS hBS hy)
      ((hall x hx).trans (hall y hy).symm) hxy
  have hu : ((A ∪ B).image g).card ≤ q := by
    simpa using Finset.card_le_univ ((A ∪ B).image g)
  rwa [Finset.card_image_of_injOn hinj, Finset.card_union_of_disjoint hdis] at hu

theorem bound (C : ℕ → Prop) (S : Finset ℕ) (g : ℕ → ZMod q)
    (hg : LayerInjective C S g) (a b c : ZMod q) (ho : Odd q) (ha : a ≠ 0) (hb : b ≠ 0)
    (t D : ℕ) (ht : t < q - 3) (hD : q - 3 + t + 1 ≤ D) (hqD : q ≤ D) :
    BicliqueBound (H C g a b c t) S D := by
  apply P14SparseCrossBiclique.combine _ C S (q - 3) t D ht hD
    (symmetric C g a b c t)
  · intro i hi B hBS hedge
    apply w_degree C S g hg a b ho ha hb i hi B hBS
    intro j hj
    obtain ⟨he, hw⟩ := hedge j hj
    rcases he with he | hc
    · exact he
    · exact False.elim (within_not_across hw (cross_across hc))
  · intro A hAS B hBS hA hB hdis hedge
    apply (w_bound C S g hg a b A hAS B hBS hA hB hdis ?_).trans hqD
    intro i hi j hj
    obtain ⟨he, hw⟩ := hedge i hi j hj
    rcases he with he | hc
    · exact he
    · exact False.elim (within_not_across hw (cross_across hc))
  · intro A hAS B hBS hA hB hdis hedge
    apply cross_bound C S g hg c t (by omega) A hAS B hBS hA hB hdis
    intro i hi j hj
    obtain ⟨he, hc⟩ := hedge i hi j hj
    rcases he with hw | he
    · exact False.elim (within_not_across (within hw) hc)
    · exact he

end P14DenseLayerComplement
end
end

section

/-! The balanced four-cell obstruction is isolated exactly: a violation
forces all four cells nonempty and both cross bounds saturated. A supplied
proof of that structural equality case closes the original biclique bound. -/
noncomputable section
namespace P14BalancedCrossBiclique
open P14BicliqueComplementConnection P14TwoLayerBiclique

theorem four_cells (a b c d s D : ℕ)
    (hA : 0 < a + b) (hB : 0 < c + d) (hD : 2 * s + 1 ≤ D)
    (hac : 0 < a → 0 < c → a ≤ s ∧ c ≤ s ∧ a + c ≤ D)
    (hbd : 0 < b → 0 < d → b ≤ s ∧ d ≤ s ∧ b + d ≤ D)
    (had : 0 < a → 0 < d → a + d ≤ s + 1)
    (hbc : 0 < b → 0 < c → b + c ≤ s + 1) :
    a + b + (c + d) ≤ D ∨
      0 < a ∧ 0 < b ∧ 0 < c ∧ 0 < d ∧ a + d = s + 1 ∧ b + c = s + 1 := by
  by_cases ha : a = 0 <;> by_cases hb : b = 0 <;>
    by_cases hc : c = 0 <;> by_cases hd : d = 0 <;> omega

theorem combine (H : ℕ → ℕ → Prop) (C : ℕ → Prop) [DecidablePred C]
    (S : Finset ℕ) (s D : ℕ) (hD : 2 * s + 1 ≤ D)
    (hsym : ∀ {i j}, H i j → H j i)
    (hdeg : ∀ i ∈ S, ∀ B ⊆ S,
      (∀ j ∈ B, H i j ∧ Within C i j) → B.card ≤ s)
    (hw : BicliqueBound (fun i j => H i j ∧ Within C i j) S D)
    (hx : BicliqueBound (fun i j => H i j ∧ Across C i j) S (s + 1))
    (hcritical : ∀ A ⊆ S, ∀ B ⊆ S, A.Nonempty → B.Nonempty → Disjoint A B →
      (∀ i ∈ A, ∀ j ∈ B, H i j) →
      0 < (A.filter C).card → 0 < (A.filter (fun i => ¬ C i)).card →
      0 < (B.filter C).card → 0 < (B.filter (fun i => ¬ C i)).card →
      (A.filter C).card + (B.filter (fun i => ¬ C i)).card = s + 1 →
      (A.filter (fun i => ¬ C i)).card + (B.filter C).card = s + 1 →
      A.card + B.card ≤ D) :
    BicliqueBound H S D := by
  classical
  intro A hAS B hBS hA hB hdis hedge
  have part_bound (P Q : ℕ → Prop) [DecidablePred P] [DecidablePred Q]
      (K : ℕ → ℕ → Prop) (k : ℕ)
      (hk : BicliqueBound K S k)
      (hK : ∀ i ∈ A.filter P, ∀ j ∈ B.filter Q, K i j)
      (hp : 0 < (A.filter P).card) (hq : 0 < (B.filter Q).card) :
      (A.filter P).card + (B.filter Q).card ≤ k := by
    apply hk (A.filter P) ((Finset.filter_subset _ _).trans hAS)
      (B.filter Q) ((Finset.filter_subset _ _).trans hBS)
      (Finset.card_pos.mp hp) (Finset.card_pos.mp hq)
    · exact hdis.mono (Finset.filter_subset _ _) (Finset.filter_subset _ _)
    · exact hK
  have h00b : 0 < (A.filter C).card → 0 < (B.filter C).card →
      (A.filter C).card + (B.filter C).card ≤ D := by
    apply part_bound C C _ _ hw
    intro i hi j hj
    have hi' := Finset.mem_filter.mp hi
    have hj' := Finset.mem_filter.mp hj
    exact ⟨hedge i hi'.1 j hj'.1, Or.inl ⟨hi'.2, hj'.2⟩⟩
  have h11b : 0 < (A.filter (fun i => ¬ C i)).card →
      0 < (B.filter (fun i => ¬ C i)).card →
      (A.filter (fun i => ¬ C i)).card + (B.filter (fun i => ¬ C i)).card ≤ D := by
    apply part_bound (fun i => ¬ C i) (fun i => ¬ C i) _ _ hw
    intro i hi j hj
    have hi' := Finset.mem_filter.mp hi
    have hj' := Finset.mem_filter.mp hj
    exact ⟨hedge i hi'.1 j hj'.1, Or.inr ⟨hi'.2, hj'.2⟩⟩
  have h01 : 0 < (A.filter C).card → 0 < (B.filter (fun i => ¬ C i)).card →
      (A.filter C).card + (B.filter (fun i => ¬ C i)).card ≤ s + 1 := by
    apply part_bound C (fun i => ¬ C i) _ _ hx
    intro i hi j hj
    have hi' := Finset.mem_filter.mp hi
    have hj' := Finset.mem_filter.mp hj
    exact ⟨hedge i hi'.1 j hj'.1, Or.inl ⟨hi'.2, hj'.2⟩⟩
  have h10 : 0 < (A.filter (fun i => ¬ C i)).card → 0 < (B.filter C).card →
      (A.filter (fun i => ¬ C i)).card + (B.filter C).card ≤ s + 1 := by
    apply part_bound (fun i => ¬ C i) C _ _ hx
    intro i hi j hj
    have hi' := Finset.mem_filter.mp hi
    have hj' := Finset.mem_filter.mp hj
    exact ⟨hedge i hi'.1 j hj'.1, Or.inr ⟨hi'.2, hj'.2⟩⟩

  have part_degree (P Q : ℕ → Prop) [DecidablePred P] [DecidablePred Q]
      (hK : ∀ i ∈ A.filter P, ∀ j ∈ B.filter Q, H i j ∧ Within C i j)
      (hp : 0 < (A.filter P).card) (hq : 0 < (B.filter Q).card) :
      (A.filter P).card ≤ s ∧ (B.filter Q).card ≤ s := by
    obtain ⟨i, hi⟩ := Finset.card_pos.mp hp
    obtain ⟨j, hj⟩ := Finset.card_pos.mp hq
    constructor
    · apply hdeg j (hBS (Finset.mem_filter.mp hj).1)
        (A.filter P) ((Finset.filter_subset _ _).trans hAS)
      intro x hx
      obtain ⟨he, hw⟩ := hK x hx j hj
      refine ⟨hsym he, ?_⟩
      rcases hw with ⟨hx, hj⟩ | ⟨hx, hj⟩
      · exact Or.inl ⟨hj, hx⟩
      · exact Or.inr ⟨hj, hx⟩
    · exact hdeg i (hAS (Finset.mem_filter.mp hi).1)
        (B.filter Q) ((Finset.filter_subset _ _).trans hBS) (fun y hy => hK i hi y hy)
  have h00 : 0 < (A.filter C).card → 0 < (B.filter C).card →
      (A.filter C).card ≤ s ∧ (B.filter C).card ≤ s ∧
        (A.filter C).card + (B.filter C).card ≤ D := by
    intro ha hb
    have hd := part_degree C C (by
      intro i hi j hj
      obtain ⟨hiA, hic⟩ := Finset.mem_filter.mp hi
      obtain ⟨hjB, hjc⟩ := Finset.mem_filter.mp hj
      exact ⟨hedge i hiA j hjB, Or.inl ⟨hic, hjc⟩⟩) ha hb
    exact ⟨hd.1, hd.2, h00b ha hb⟩
  have h11 : 0 < (A.filter (fun i => ¬ C i)).card →
      0 < (B.filter (fun i => ¬ C i)).card →
      (A.filter (fun i => ¬ C i)).card ≤ s ∧ (B.filter (fun i => ¬ C i)).card ≤ s ∧
        (A.filter (fun i => ¬ C i)).card + (B.filter (fun i => ¬ C i)).card ≤ D := by
    intro ha hb
    have hd := part_degree (fun i => ¬ C i) (fun i => ¬ C i) (by
      intro i hi j hj
      obtain ⟨hiA, hic⟩ := Finset.mem_filter.mp hi
      obtain ⟨hjB, hjc⟩ := Finset.mem_filter.mp hj
      exact ⟨hedge i hiA j hjB, Or.inr ⟨hic, hjc⟩⟩) ha hb
    exact ⟨hd.1, hd.2, h11b ha hb⟩

  have hAc := Finset.card_filter_add_card_filter_not (s := A) C
  have hBc := Finset.card_filter_add_card_filter_not (s := B) C
  have hAp := Finset.card_pos.mpr hA
  have hBp := Finset.card_pos.mpr hB
  have h := four_cells (A.filter C).card (A.filter (fun i => ¬ C i)).card
    (B.filter C).card (B.filter (fun i => ¬ C i)).card s D
    (by omega) (by omega) hD h00 h11 h01 h10
  rcases h with hb | ⟨ha, hb, hc, hd, had, hbc⟩
  · omega
  · exact hcritical A hAS B hBS hA hB hdis hedge ha hb hc hd had hbc

end P14BalancedCrossBiclique
end
end

section

/-! A cyclic arc avoiding zero and a prescribed residue fits in one of
the two intervening gaps. Applied to all differences of two literal arcs,
this bounds the sum of their lengths without a genericity assumption. -/
noncomputable section
namespace P14CyclicArcGap
open P14CyclicArc
variable {q : ℕ} [NeZero q]

theorem gap (z a : ZMod q) (l : ℕ) (hl : 0 < l)
    (hzero : ∀ n : ℕ, n < l → z + (n : ZMod q) ≠ 0)
    (ha : ∀ n : ℕ, n < l → z + (n : ZMod q) ≠ a) :
    l + 1 ≤ max a.val (q - a.val) := by
  have hz : 0 < z.val := by
    by_contra hn
    have hv : z.val = 0 := by omega
    have he : z = 0 := by rw [← ZMod.natCast_zmod_val z, hv]; simp
    exact hzero 0 hl (by simpa using he)
  have hzq := z.val_lt
  have haq := a.val_lt
  have hend : z.val + l ≤ q := by
    by_contra hn
    have hn' : q - z.val < l := by omega
    apply hzero (q - z.val) hn'
    rw [Nat.cast_sub (by omega : z.val ≤ q), ZMod.natCast_self, ZMod.natCast_zmod_val]
    abel
  have hsplit : z.val > a.val ∨ z.val + l ≤ a.val := by
    by_cases h : a.val < z.val
    · exact Or.inl h
    · right
      by_contra hn
      have hlt : a.val - z.val < l := by omega
      apply ha (a.val - z.val) hlt
      rw [Nat.cast_sub (by omega : z.val ≤ a.val), ZMod.natCast_zmod_val,
        ZMod.natCast_zmod_val]
      abel
  rcases hsplit with h | h
  · have hm := le_max_right a.val (q - a.val)
    omega
  · have hm := le_max_left a.val (q - a.val)
    omega

theorem pair_lengths (x y a : ZMod q) (r s : ℕ) (hr : 0 < r) (hs : 0 < s)
    (hzero : ∀ u ∈ arc x r, ∀ v ∈ arc y s, v - u ≠ 0)
    (ha : ∀ u ∈ arc x r, ∀ v ∈ arc y s, v - u ≠ a) :
    r + s ≤ max a.val (q - a.val) := by
  let z := y - x - ((r - 1 : ℕ) : ZMod q)
  have cover (n : ℕ) (hn : n < r + s - 1) :
      ∃ u ∈ arc x r, ∃ v ∈ arc y s, v - u = z + (n : ZMod q) := by
    by_cases hnr : n < r
    · refine ⟨x + ((r - 1 - n : ℕ) : ZMod q), ?_, y, ?_, ?_⟩
      · exact Finset.mem_image.mpr ⟨r - 1 - n, Finset.mem_range.mpr (by omega), rfl⟩
      · exact P14CyclicArcArithmetic.start_mem y s hs
      · dsimp [z]
        rw [Nat.cast_sub (by omega : n ≤ r - 1)]
        abel
    · refine ⟨x, P14CyclicArcArithmetic.start_mem x r hr,
        y + ((n - (r - 1) : ℕ) : ZMod q), ?_, ?_⟩
      · exact Finset.mem_image.mpr ⟨n - (r - 1), Finset.mem_range.mpr (by omega), rfl⟩
      · dsimp [z]
        rw [Nat.cast_sub (by omega : r - 1 ≤ n)]
        abel
  have h := gap z a (r + s - 1) (by omega) (by
    intro n hn
    obtain ⟨u, hu, v, hv, he⟩ := cover n hn
    rw [← he]
    exact hzero u hu v hv) (by
    intro n hn
    obtain ⟨u, hu, v, hv, he⟩ := cover n hn
    rw [← he]
    exact ha u hu v hv)
  omega

theorem pair_sets (X Y : Finset (ZMod q)) (hX : X.Nonempty) (hY : Y.Nonempty)
    (hx : ∃ x, X = arc x X.card) (hy : ∃ y, Y = arc y Y.card) (a : ZMod q)
    (havoid : ∀ u ∈ X, ∀ v ∈ Y, v - u ∉ ({0, a, -a} : Finset (ZMod q))) :
    X.card + Y.card ≤ max a.val (q - a.val) := by
  obtain ⟨x, hx⟩ := hx
  obtain ⟨y, hy⟩ := hy
  apply pair_lengths x y a X.card Y.card (Finset.card_pos.mpr hX) (Finset.card_pos.mpr hY)
  · intro u hu v hv he
    rw [← hx] at hu
    rw [← hy] at hv
    exact havoid u hu v hv (by simp [he])
  · intro u hu v hv he
    rw [← hx] at hu
    rw [← hy] at hv
    exact havoid u hu v hv (by simp [he])

end P14CyclicArcGap
end
end

section

/-! The balanced dense-complement bound. Saturation makes all four label
sets cyclic arcs, and the two internal forbidden steps rule it out by an
explicit gap bound. The critical case is proved, not assumed. -/
noncomputable section
namespace P14DenseBalancedComplement
open P14DenseLayerComplement P14BicliqueComplementConnection
open P14TwoLayerBiclique P14LayerBlockBiclique P14CyclicArc
variable {q : ℕ} [NeZero q]

theorem upper {C : ℕ → Prop} {g : ℕ → ZMod q} {a b c : ZMod q} {t i j : ℕ}
    (hi : C i) (hj : C j) (he : H C g a b c t i j) :
    g j - g i ∉ ({0, a, -a} : Finset (ZMod q)) := by
  rcases he with (⟨_, _, h⟩ | ⟨hn, _, _⟩) | (⟨_, hn, _⟩ | ⟨hn, _, _⟩)
  · exact h
  · exact False.elim (hn hi)
  · exact False.elim (hn hj)
  · exact False.elim (hn hi)

theorem lower {C : ℕ → Prop} {g : ℕ → ZMod q} {a b c : ZMod q} {t i j : ℕ}
    (hi : ¬ C i) (hj : ¬ C j) (he : H C g a b c t i j) :
    g j - g i ∉ ({0, b, -b} : Finset (ZMod q)) := by
  rcases he with (⟨hp, _, _⟩ | ⟨_, _, h⟩) | (⟨hp, _, _⟩ | ⟨_, hp, _⟩)
  · exact False.elim (hi hp)
  · exact h
  · exact False.elim (hi hp)
  · exact False.elim (hj hp)

theorem across {C : ℕ → Prop} {g : ℕ → ZMod q} {a b c : ZMod q} {t i j : ℕ}
    (hi : C i) (hj : ¬ C j) (he : H C g a b c t i j) :
    g j - g i ∈ arc c t := by
  rcases he with (⟨_, hp, _⟩ | ⟨hn, _, _⟩) | (⟨_, _, h⟩ | ⟨hn, _, _⟩)
  · exact False.elim (hj hp)
  · exact False.elim (hn hi)
  · exact h
  · exact False.elim (hn hi)

theorem bound (hq : 7 ≤ q) (ho : Odd q)
    (C : ℕ → Prop) (S : Finset ℕ) (g : ℕ → ZMod q)
    (hg : LayerInjective C S g) (a b c : ZMod q) (ha : a ≠ 0) (hb : b ≠ 0)
    (hgap : max a.val (q - a.val) + max b.val (q - b.val) ≤ 2 * q - 5) :
    BicliqueBound (H C g a b c (q - 3)) S (2 * q - 5) := by
  classical
  apply P14BalancedCrossBiclique.combine _ C S (q - 3) (2 * q - 5) (by omega)
    (symmetric C g a b c (q - 3))
  · intro i hi B hBS hedge
    apply w_degree C S g hg a b ho ha hb i hi B hBS
    intro j hj
    obtain ⟨he, hw⟩ := hedge j hj
    rcases he with he | hc
    · exact he
    · exact False.elim (within_not_across hw (cross_across hc))
  · intro A hAS B hBS hA hB hdis hedge
    have h := w_bound C S g hg a b A hAS B hBS hA hB hdis (by
      intro i hi j hj
      obtain ⟨he, hw⟩ := hedge i hi j hj
      rcases he with he | hc
      · exact he
      · exact False.elim (within_not_across hw (cross_across hc)))
    omega
  · intro A hAS B hBS hA hB hdis hedge
    apply cross_bound C S g hg c (q - 3) (by omega) A hAS B hBS hA hB hdis
    intro i hi j hj
    obtain ⟨he, hc⟩ := hedge i hi j hj
    rcases he with hw | he
    · exact False.elim (within_not_across (within hw) hc)
    · exact he
  · intro A hAS B hBS _ _ _ hedge ha0 ha1 hb0 hb1 h01 h10
    let A0 := (A.filter C).image g
    let A1 := (A.filter (fun i => ¬ C i)).image g
    let B0 := (B.filter C).image g
    let B1 := (B.filter (fun i => ¬ C i)).image g
    have card_true (T : Finset ℕ) (hTS : T ⊆ S) :
        ((T.filter C).image g).card = (T.filter C).card := by
      apply Finset.card_image_of_injOn
      intro i hi j hj he
      obtain ⟨hiT, hiC⟩ := Finset.mem_filter.mp hi
      obtain ⟨hjT, hjC⟩ := Finset.mem_filter.mp hj
      exact hg i (hTS hiT) j (hTS hjT) ⟨fun _ => hjC, fun _ => hiC⟩ he
    have card_false (T : Finset ℕ) (hTS : T ⊆ S) :
        ((T.filter (fun i => ¬ C i)).image g).card = (T.filter (fun i => ¬ C i)).card := by
      apply Finset.card_image_of_injOn
      intro i hi j hj he
      obtain ⟨hiT, hiC⟩ := Finset.mem_filter.mp hi
      obtain ⟨hjT, hjC⟩ := Finset.mem_filter.mp hj
      exact hg i (hTS hiT) j (hTS hjT)
        ⟨fun h => False.elim (hiC h), fun h => False.elim (hjC h)⟩ he
    have hcA0 : A0.card = (A.filter C).card := card_true A hAS
    have hcA1 : A1.card = (A.filter (fun i => ¬ C i)).card := card_false A hAS
    have hcB0 : B0.card = (B.filter C).card := card_true B hBS
    have hcB1 : B1.card = (B.filter (fun i => ¬ C i)).card := card_false B hBS
    have hnA0 : A0.Nonempty := Finset.card_pos.mp (by omega)
    have hnA1 : A1.Nonempty := Finset.card_pos.mp (by omega)
    have hnB0 : B0.Nonempty := Finset.card_pos.mp (by omega)
    have hnB1 : B1.Nonempty := Finset.card_pos.mp (by omega)
    have cross01 : ∀ x ∈ A0, ∀ y ∈ B1, ((y - x) - c).val < q - 3 := by
      intro x hx y hy
      obtain ⟨i, hi, rfl⟩ := Finset.mem_image.mp hx
      obtain ⟨j, hj, rfl⟩ := Finset.mem_image.mp hy
      obtain ⟨hiA, hiC⟩ := Finset.mem_filter.mp hi
      obtain ⟨hjB, hjC⟩ := Finset.mem_filter.mp hj
      exact (mem_arc_iff c _ (q - 3) (by omega)).mp
        (across hiC hjC (hedge i hiA j hjB))
    have cross10 : ∀ x ∈ B0, ∀ y ∈ A1, ((y - x) - c).val < q - 3 := by
      intro x hx y hy
      obtain ⟨j, hj, rfl⟩ := Finset.mem_image.mp hx
      obtain ⟨i, hi, rfl⟩ := Finset.mem_image.mp hy
      obtain ⟨hiA, hiC⟩ := Finset.mem_filter.mp hi
      obtain ⟨hjB, hjC⟩ := Finset.mem_filter.mp hj
      exact (mem_arc_iff c _ (q - 3) (by omega)).mp
        (across hjC hiC (symmetric C g a b c (q - 3) (hedge i hiA j hjB)))
    have shapes01 := P14CyclicCriticalPair.interval_equality_shapes A0 B1 hnA0 hnB1
      c (q - 3) (by omega) cross01 (by omega)
    have shapes10 := P14CyclicCriticalPair.interval_equality_shapes B0 A1 hnB0 hnA1
      c (q - 3) (by omega) cross10 (by omega)
    have upper_bound := P14CyclicArcGap.pair_sets A0 B0 hnA0 hnB0 shapes01.1 shapes10.1 a (by
      intro x hx y hy
      obtain ⟨i, hi, rfl⟩ := Finset.mem_image.mp hx
      obtain ⟨j, hj, rfl⟩ := Finset.mem_image.mp hy
      obtain ⟨hiA, hiC⟩ := Finset.mem_filter.mp hi
      obtain ⟨hjB, hjC⟩ := Finset.mem_filter.mp hj
      exact upper hiC hjC (hedge i hiA j hjB))
    have lower_bound := P14CyclicArcGap.pair_sets A1 B1 hnA1 hnB1 shapes10.2 shapes01.2 b (by
      intro x hx y hy
      obtain ⟨i, hi, rfl⟩ := Finset.mem_image.mp hx
      obtain ⟨j, hj, rfl⟩ := Finset.mem_image.mp hy
      obtain ⟨hiA, hiC⟩ := Finset.mem_filter.mp hi
      obtain ⟨hjB, hjC⟩ := Finset.mem_filter.mp hj
      exact lower hiC hjC (hedge i hiA j hjB))
    have hAc := Finset.card_filter_add_card_filter_not (s := A) C
    have hBc := Finset.card_filter_add_card_filter_not (s := B) C
    omega

end P14DenseBalancedComplement
end
end

section

/-! If one side is a literal cyclic arc, avoiding zero and a nonzero
step in both directions gives the q-2 bound even when the step is not a unit. -/
noncomputable section
namespace P14OneArcStepComplement
open P14CyclicArc
variable {q : ℕ} [NeZero q]

theorem left_arc_bound (ho : Odd q) (X Y : Finset (ZMod q))
    (hX : X.Nonempty) (hY : Y.Nonempty)
    (hshape : ∃ c r, r ≤ q ∧ X = arc c r) (a : ZMod q) (ha : a ≠ 0)
    (havoid : ∀ x ∈ X, ∀ y ∈ Y, y - x ∉ ({0,a,-a} : Finset (ZMod q))) :
    X.card + Y.card ≤ q - 2 := by
  classical
  obtain ⟨c,r,hr,rfl⟩ := hshape
  have hc : (arc c r).card = r := card_arc c r hr
  have hrp : 0 < r := by have h := Finset.card_pos.mpr hX; omega
  let T := ({0,a,-a} : Finset (ZMod q)).image (fun z => c + z)
  have hT : T.card = 3 := by
    dsimp [T]
    rw [Finset.card_image_of_injective _ (fun _ _ h => add_left_cancel h)]
    simp [ha, ha.symm, (neg_ne_zero.mpr ha).symm, ZMod.ne_neg_self ho ha]
  have hTn : T.Nonempty := Finset.card_pos.mp (by omega)
  have hrun : ∀ u ∈ T, ∀ y ∈ Y, ∀ t : ℕ, t ≤ r - 1 → u + (t : ZMod q) ≠ y := by
    intro u hu y hy t ht he
    obtain ⟨z,hz,rfl⟩ := Finset.mem_image.mp hu
    have hx : c + (t : ZMod q) ∈ arc c r :=
      Finset.mem_image.mpr ⟨t, Finset.mem_range.mpr (by omega), rfl⟩
    apply havoid _ hx y hy
    have hd : y - (c + (t : ZMod q)) = z := by rw [← he]; abel
    rwa [hd]
  have hb := P14CyclicIntervalBiclique.forbidden_run_bound T Y hTn hY (r - 1) hrun
  omega

theorem either_arc_bound (ho : Odd q) (X Y : Finset (ZMod q))
    (hX : X.Nonempty) (hY : Y.Nonempty)
    (hshape : (∃ c r, r ≤ q ∧ X = arc c r) ∨ (∃ c r, r ≤ q ∧ Y = arc c r))
    (a : ZMod q) (ha : a ≠ 0)
    (havoid : ∀ x ∈ X, ∀ y ∈ Y, y - x ∉ ({0,a,-a} : Finset (ZMod q))) :
    X.card + Y.card ≤ q - 2 := by
  rcases hshape with h | h
  · exact left_arc_bound ho X Y hX hY h a ha havoid
  · have hb := left_arc_bound ho Y X hY hX h a ha (by
      intro y hy x hx
      simpa only [neg_sub] using P14DenseLayerComplement.neg_avoid a (y - x) (havoid x hx y hy))
    omega

end P14OneArcStepComplement
end
end

section

/-! The cross degree is one above the internal degree. A violation
forces all four cells nonempty and at least one cross bound saturated. A supplied
proof of that structural equality case closes the original biclique bound. -/
noncomputable section
namespace P14DenseCrossBoundary
open P14BicliqueComplementConnection P14TwoLayerBiclique

theorem four_cells (a b c d s D : ℕ)
    (hA : 0 < a + b) (hB : 0 < c + d) (hD : 2 * s + 2 ≤ D)
    (hac : 0 < a → 0 < c → a ≤ s ∧ c ≤ s ∧ a + c ≤ D)
    (hbd : 0 < b → 0 < d → b ≤ s ∧ d ≤ s ∧ b + d ≤ D)
    (had : 0 < a → 0 < d → a + d ≤ s + 2)
    (hbc : 0 < b → 0 < c → b + c ≤ s + 2) :
    a + b + (c + d) ≤ D ∨
      0 < a ∧ 0 < b ∧ 0 < c ∧ 0 < d ∧ (a + d = s + 2 ∨ b + c = s + 2) := by
  by_cases ha : a = 0 <;> by_cases hb : b = 0 <;>
    by_cases hc : c = 0 <;> by_cases hd : d = 0 <;> omega

theorem combine (H : ℕ → ℕ → Prop) (C : ℕ → Prop) [DecidablePred C]
    (S : Finset ℕ) (s D : ℕ) (hD : 2 * s + 2 ≤ D)
    (hsym : ∀ {i j}, H i j → H j i)
    (hdeg : ∀ i ∈ S, ∀ B ⊆ S,
      (∀ j ∈ B, H i j ∧ Within C i j) → B.card ≤ s)
    (hw : BicliqueBound (fun i j => H i j ∧ Within C i j) S D)
    (hx : BicliqueBound (fun i j => H i j ∧ Across C i j) S (s + 2))
    (hcritical : ∀ A ⊆ S, ∀ B ⊆ S, A.Nonempty → B.Nonempty → Disjoint A B →
      (∀ i ∈ A, ∀ j ∈ B, H i j) →
      0 < (A.filter C).card → 0 < (A.filter (fun i => ¬ C i)).card →
      0 < (B.filter C).card → 0 < (B.filter (fun i => ¬ C i)).card →
      ((A.filter C).card + (B.filter (fun i => ¬ C i)).card = s + 2 ∨
        (A.filter (fun i => ¬ C i)).card + (B.filter C).card = s + 2) →
      A.card + B.card ≤ D) :
    BicliqueBound H S D := by
  classical
  intro A hAS B hBS hA hB hdis hedge
  have part_bound (P Q : ℕ → Prop) [DecidablePred P] [DecidablePred Q]
      (K : ℕ → ℕ → Prop) (k : ℕ)
      (hk : BicliqueBound K S k)
      (hK : ∀ i ∈ A.filter P, ∀ j ∈ B.filter Q, K i j)
      (hp : 0 < (A.filter P).card) (hq : 0 < (B.filter Q).card) :
      (A.filter P).card + (B.filter Q).card ≤ k := by
    apply hk (A.filter P) ((Finset.filter_subset _ _).trans hAS)
      (B.filter Q) ((Finset.filter_subset _ _).trans hBS)
      (Finset.card_pos.mp hp) (Finset.card_pos.mp hq)
    · exact hdis.mono (Finset.filter_subset _ _) (Finset.filter_subset _ _)
    · exact hK
  have h00b : 0 < (A.filter C).card → 0 < (B.filter C).card →
      (A.filter C).card + (B.filter C).card ≤ D := by
    apply part_bound C C _ _ hw
    intro i hi j hj
    have hi' := Finset.mem_filter.mp hi
    have hj' := Finset.mem_filter.mp hj
    exact ⟨hedge i hi'.1 j hj'.1, Or.inl ⟨hi'.2, hj'.2⟩⟩
  have h11b : 0 < (A.filter (fun i => ¬ C i)).card →
      0 < (B.filter (fun i => ¬ C i)).card →
      (A.filter (fun i => ¬ C i)).card + (B.filter (fun i => ¬ C i)).card ≤ D := by
    apply part_bound (fun i => ¬ C i) (fun i => ¬ C i) _ _ hw
    intro i hi j hj
    have hi' := Finset.mem_filter.mp hi
    have hj' := Finset.mem_filter.mp hj
    exact ⟨hedge i hi'.1 j hj'.1, Or.inr ⟨hi'.2, hj'.2⟩⟩
  have h01 : 0 < (A.filter C).card → 0 < (B.filter (fun i => ¬ C i)).card →
      (A.filter C).card + (B.filter (fun i => ¬ C i)).card ≤ s + 2 := by
    apply part_bound C (fun i => ¬ C i) _ _ hx
    intro i hi j hj
    have hi' := Finset.mem_filter.mp hi
    have hj' := Finset.mem_filter.mp hj
    exact ⟨hedge i hi'.1 j hj'.1, Or.inl ⟨hi'.2, hj'.2⟩⟩
  have h10 : 0 < (A.filter (fun i => ¬ C i)).card → 0 < (B.filter C).card →
      (A.filter (fun i => ¬ C i)).card + (B.filter C).card ≤ s + 2 := by
    apply part_bound (fun i => ¬ C i) C _ _ hx
    intro i hi j hj
    have hi' := Finset.mem_filter.mp hi
    have hj' := Finset.mem_filter.mp hj
    exact ⟨hedge i hi'.1 j hj'.1, Or.inr ⟨hi'.2, hj'.2⟩⟩

  have part_degree (P Q : ℕ → Prop) [DecidablePred P] [DecidablePred Q]
      (hK : ∀ i ∈ A.filter P, ∀ j ∈ B.filter Q, H i j ∧ Within C i j)
      (hp : 0 < (A.filter P).card) (hq : 0 < (B.filter Q).card) :
      (A.filter P).card ≤ s ∧ (B.filter Q).card ≤ s := by
    obtain ⟨i, hi⟩ := Finset.card_pos.mp hp
    obtain ⟨j, hj⟩ := Finset.card_pos.mp hq
    constructor
    · apply hdeg j (hBS (Finset.mem_filter.mp hj).1)
        (A.filter P) ((Finset.filter_subset _ _).trans hAS)
      intro x hx
      obtain ⟨he, hw⟩ := hK x hx j hj
      refine ⟨hsym he, ?_⟩
      rcases hw with ⟨hx, hj⟩ | ⟨hx, hj⟩
      · exact Or.inl ⟨hj, hx⟩
      · exact Or.inr ⟨hj, hx⟩
    · exact hdeg i (hAS (Finset.mem_filter.mp hi).1)
        (B.filter Q) ((Finset.filter_subset _ _).trans hBS) (fun y hy => hK i hi y hy)
  have h00 : 0 < (A.filter C).card → 0 < (B.filter C).card →
      (A.filter C).card ≤ s ∧ (B.filter C).card ≤ s ∧
        (A.filter C).card + (B.filter C).card ≤ D := by
    intro ha hb
    have hd := part_degree C C (by
      intro i hi j hj
      obtain ⟨hiA, hic⟩ := Finset.mem_filter.mp hi
      obtain ⟨hjB, hjc⟩ := Finset.mem_filter.mp hj
      exact ⟨hedge i hiA j hjB, Or.inl ⟨hic, hjc⟩⟩) ha hb
    exact ⟨hd.1, hd.2, h00b ha hb⟩
  have h11 : 0 < (A.filter (fun i => ¬ C i)).card →
      0 < (B.filter (fun i => ¬ C i)).card →
      (A.filter (fun i => ¬ C i)).card ≤ s ∧ (B.filter (fun i => ¬ C i)).card ≤ s ∧
        (A.filter (fun i => ¬ C i)).card + (B.filter (fun i => ¬ C i)).card ≤ D := by
    intro ha hb
    have hd := part_degree (fun i => ¬ C i) (fun i => ¬ C i) (by
      intro i hi j hj
      obtain ⟨hiA, hic⟩ := Finset.mem_filter.mp hi
      obtain ⟨hjB, hjc⟩ := Finset.mem_filter.mp hj
      exact ⟨hedge i hiA j hjB, Or.inr ⟨hic, hjc⟩⟩) ha hb
    exact ⟨hd.1, hd.2, h11b ha hb⟩

  have hAc := Finset.card_filter_add_card_filter_not (s := A) C
  have hBc := Finset.card_filter_add_card_filter_not (s := B) C
  have hAp := Finset.card_pos.mpr hA
  have hBp := Finset.card_pos.mpr hB
  have h := four_cells (A.filter C).card (A.filter (fun i => ¬ C i)).card
    (B.filter C).card (B.filter (fun i => ¬ C i)).card s D
    (by omega) (by omega) hD h00 h11 h01 h10
  rcases h with hb | ⟨ha, hb, hc, hd, hcross⟩
  · omega
  · exact hcritical A hAS B hBS hA hB hdis hedge ha hb hc hd hcross

end P14DenseCrossBoundary
end
end

section

/-! The one-qubit dense boundary. Saturation of either cross pair
makes one side of each internal pair an arc and proves the q-2 bounds. -/
noncomputable section
namespace P14DenseOneQubitComplement
open P14DenseLayerComplement P14DenseBalancedComplement
open P14BicliqueComplementConnection P14TwoLayerBiclique P14LayerBlockBiclique P14CyclicArc
variable {q : ℕ} [NeZero q]

theorem bound (hq : 7 ≤ q) (ho : Odd q)
    (C : ℕ → Prop) (S : Finset ℕ) (g : ℕ → ZMod q)
    (hg : LayerInjective C S g) (a b c : ZMod q) (ha : a ≠ 0) (hb : b ≠ 0) :
    BicliqueBound (H C g a b c (q - 2)) S (2 * q - 4) := by
  classical
  apply P14DenseCrossBoundary.combine _ C S (q - 3) (2 * q - 4) (by omega)
    (symmetric C g a b c (q - 2))
  · intro i hi B hBS hedge
    apply w_degree C S g hg a b ho ha hb i hi B hBS
    intro j hj
    obtain ⟨he, hw⟩ := hedge j hj
    rcases he with he | hc
    · exact he
    · exact False.elim (within_not_across hw (cross_across hc))
  · intro A hAS B hBS hA hB hdis hedge
    have h := w_bound C S g hg a b A hAS B hBS hA hB hdis (by
      intro i hi j hj
      obtain ⟨he, hw⟩ := hedge i hi j hj
      rcases he with he | hc
      · exact he
      · exact False.elim (within_not_across hw (cross_across hc)))
    omega
  · intro A hAS B hBS hA hB hdis hedge
    have hn : (q - 3) + 2 = (q - 2) + 1 := by omega
    rw [hn]
    apply cross_bound C S g hg c (q - 2) (by omega) A hAS B hBS hA hB hdis
    intro i hi j hj
    obtain ⟨he, hc⟩ := hedge i hi j hj
    rcases he with hw | he
    · exact False.elim (within_not_across (within hw) hc)
    · exact he
  · intro A hAS B hBS _ _ _ hedge ha0 ha1 hb0 hb1 hcritical
    let A0 := (A.filter C).image g
    let A1 := (A.filter (fun i => ¬ C i)).image g
    let B0 := (B.filter C).image g
    let B1 := (B.filter (fun i => ¬ C i)).image g
    have card_true (T : Finset ℕ) (hTS : T ⊆ S) :
        ((T.filter C).image g).card = (T.filter C).card := by
      apply Finset.card_image_of_injOn
      intro i hi j hj he
      obtain ⟨hiT, hiC⟩ := Finset.mem_filter.mp hi
      obtain ⟨hjT, hjC⟩ := Finset.mem_filter.mp hj
      exact hg i (hTS hiT) j (hTS hjT) ⟨fun _ => hjC, fun _ => hiC⟩ he
    have card_false (T : Finset ℕ) (hTS : T ⊆ S) :
        ((T.filter (fun i => ¬ C i)).image g).card = (T.filter (fun i => ¬ C i)).card := by
      apply Finset.card_image_of_injOn
      intro i hi j hj he
      obtain ⟨hiT, hiC⟩ := Finset.mem_filter.mp hi
      obtain ⟨hjT, hjC⟩ := Finset.mem_filter.mp hj
      exact hg i (hTS hiT) j (hTS hjT)
        ⟨fun h => False.elim (hiC h), fun h => False.elim (hjC h)⟩ he
    have hcA0 : A0.card = (A.filter C).card := card_true A hAS
    have hcA1 : A1.card = (A.filter (fun i => ¬ C i)).card := card_false A hAS
    have hcB0 : B0.card = (B.filter C).card := card_true B hBS
    have hcB1 : B1.card = (B.filter (fun i => ¬ C i)).card := card_false B hBS
    have hnA0 : A0.Nonempty := Finset.card_pos.mp (by omega)
    have hnA1 : A1.Nonempty := Finset.card_pos.mp (by omega)
    have hnB0 : B0.Nonempty := Finset.card_pos.mp (by omega)
    have hnB1 : B1.Nonempty := Finset.card_pos.mp (by omega)
    have cross01 : ∀ x ∈ A0, ∀ y ∈ B1, ((y - x) - c).val < q - 2 := by
      intro x hx y hy
      obtain ⟨i, hi, rfl⟩ := Finset.mem_image.mp hx
      obtain ⟨j, hj, rfl⟩ := Finset.mem_image.mp hy
      obtain ⟨hiA, hiC⟩ := Finset.mem_filter.mp hi
      obtain ⟨hjB, hjC⟩ := Finset.mem_filter.mp hj
      exact (mem_arc_iff c _ (q - 2) (by omega)).mp
        (across hiC hjC (hedge i hiA j hjB))
    have cross10 : ∀ x ∈ B0, ∀ y ∈ A1, ((y - x) - c).val < q - 2 := by
      intro x hx y hy
      obtain ⟨j, hj, rfl⟩ := Finset.mem_image.mp hx
      obtain ⟨i, hi, rfl⟩ := Finset.mem_image.mp hy
      obtain ⟨hiA, hiC⟩ := Finset.mem_filter.mp hi
      obtain ⟨hjB, hjC⟩ := Finset.mem_filter.mp hj
      exact (mem_arc_iff c _ (q - 2) (by omega)).mp
        (across hjC hiC (symmetric C g a b c (q - 2) (hedge i hiA j hjB)))
    have wide_shape (X : Finset (ZMod q)) (h : ∃ c, X = arc c X.card) :
        ∃ c r, r ≤ q ∧ X = arc c r := by
      obtain ⟨c,hc⟩ := h
      exact ⟨c,X.card,by simpa using Finset.card_le_univ X,hc⟩
    have shapes :
        ((∃ c r, r ≤ q ∧ A0 = arc c r) ∨ (∃ c r, r ≤ q ∧ B0 = arc c r)) ∧
        ((∃ c r, r ≤ q ∧ A1 = arc c r) ∨ (∃ c r, r ≤ q ∧ B1 = arc c r)) := by
      rcases hcritical with h01 | h10
      · have hh := P14CyclicCriticalPair.interval_equality_shapes A0 B1 hnA0 hnB1
          c (q - 2) (by omega) cross01 (by omega)
        exact ⟨Or.inl (wide_shape A0 hh.1), Or.inr (wide_shape B1 hh.2)⟩
      · have hh := P14CyclicCriticalPair.interval_equality_shapes B0 A1 hnB0 hnA1
          c (q - 2) (by omega) cross10 (by omega)
        exact ⟨Or.inr (wide_shape B0 hh.1), Or.inl (wide_shape A1 hh.2)⟩
    have upper_bound := P14OneArcStepComplement.either_arc_bound ho A0 B0 hnA0 hnB0 shapes.1 a ha (by
      intro x hx y hy
      obtain ⟨i, hi, rfl⟩ := Finset.mem_image.mp hx
      obtain ⟨j, hj, rfl⟩ := Finset.mem_image.mp hy
      obtain ⟨hiA, hiC⟩ := Finset.mem_filter.mp hi
      obtain ⟨hjB, hjC⟩ := Finset.mem_filter.mp hj
      exact upper hiC hjC (hedge i hiA j hjB))
    have lower_bound := P14OneArcStepComplement.either_arc_bound ho A1 B1 hnA1 hnB1 shapes.2 b hb (by
      intro x hx y hy
      obtain ⟨i, hi, rfl⟩ := Finset.mem_image.mp hx
      obtain ⟨j, hj, rfl⟩ := Finset.mem_image.mp hy
      obtain ⟨hiA, hiC⟩ := Finset.mem_filter.mp hi
      obtain ⟨hjB, hjC⟩ := Finset.mem_filter.mp hj
      exact lower hiC hjC (hedge i hiA j hjB))
    have hAc := Finset.card_filter_add_card_filter_not (s := A) C
    have hBc := Finset.card_filter_add_card_filter_not (s := B) C
    omega

end P14DenseOneQubitComplement
end
end

