/-! Literal canonical vectors for the remaining non-dominant single
partner ququart family. Every local nonzero, span, orthogonality and
size condition follows from checked constructions. -/
noncomputable section
namespace P14QuquartFreeUPB
open P14ComplexLocalCover P14OddLayerLabels P14CanonicalUPBTransport
open P14QuquartDenseUPB
open scoped BigOperators

theorem canonical {q D m : ℕ} [NeZero q] (hq : 15 ≤ q) (ho : Odd q)
    (hD : 3 ≤ D) (hDq : D < q) (htotal : D + m = 2 * q - 4) :
    Conclusion (m + 2) (dimensions D m) := by
  classical
  obtain ⟨G, F, hsym, hirr, hbound, hF, hFne, hcover⟩ :=
    P14QuquartFreeCover.construct hq ho hD hDq htotal
  have hq7 : 7 ≤ q := by omega
  let R : Fin (m + 2) → (Fin q ⊕ Fin q) → (Fin q ⊕ Fin q) → Prop :=
    Fin.cons (P14QuquartGraphCover.E hq7)
      (Fin.cons (fun u v => G (encode u) (encode v))
        (fun c u v => F c u = v))
  have hpartner : HasLocalFactor (Fin q ⊕ Fin q) D (D - 1) (R 1) := by
    obtain ⟨x, hnz, hpair, hspan⟩ := P14GenericExceptionalUPB.complex_rows
      (G) hsym
      hirr D (2 * q) (by omega)
      hbound
    have hspan' : ∀ S : Finset (Fin (2 * q)), S.card = (D - 1) + 1 →
        Submodule.span ℂ (Set.range (fun i : S => x i)) = ⊤ := by
      intro S hs
      exact hspan S (by omega)
    have hx : HasLocalFactor (Fin (2 * q)) D (D - 1)
        (fun u v => G u.val v.val) := ⟨x, hnz, hspan', hpair⟩
    exact P14ComplexLocalCover.reindex (rowEquiv q) hx
  have hlocal : ∀ j, HasLocalFactor (Fin q ⊕ Fin q)
      (dimensions D m j) (caps D m j) (R j) := by
    intro j
    refine Fin.cases (P14QuquartPartnerUPB.exceptional hq7 ho) (fun j => ?_) j
    refine Fin.cases hpartner (fun c => ?_) j
    simpa only [dimensions, caps, R, Fin.cons_succ] using
      P14MatchingLocalFactor.on_finite (F c) (hF c) (hFne c)
  have hcomplete : ∀ u v, u ≠ v → ∃ j, R j u v := by
    intro u v huv
    rcases hcover u v huv with he | hp | ⟨c, hc⟩
    · exact ⟨0, he⟩
    · exact ⟨1, hp⟩
    · exact ⟨c.succ.succ, hc⟩
  have hcard : Fintype.card (Fin q ⊕ Fin q) = 2 * q := by simp [two_mul]
  apply P14ComplexLocalCover.canonical (dimensions D m) (caps D m) R hlocal hcomplete
  · rw [sum_caps, hcard]
    omega
  · rw [sum_deficits, hcard]
    omega


end P14QuquartFreeUPB
end
end

section

/-! Rescale an invertible cyclic step to a forbidden run of three
consecutive residues. The internal complement then has biclique bound
q-2, improving the dense construction while retaining its exact graph. -/
noncomputable section
namespace P14UnitCycleComplement
open P14DenseLayerComplement P14BicliqueComplementConnection
open P14TwoLayerBiclique P14LayerBlockBiclique
variable {q : ℕ} [NeZero q]

theorem inverse_bound (a u : ZMod q) (hu : u * a = 1)
    (X Y : Finset (ZMod q)) (hX : X.Nonempty) (hY : Y.Nonempty)
    (havoid : ∀ x ∈ X, ∀ y ∈ Y, y - x ∉ ({0, a, -a} : Finset (ZMod q))) :
    X.card + Y.card ≤ q - 2 := by
  have hau : a * u = 1 := by rwa [mul_comm]
  have hinj : Function.Injective (fun x : ZMod q => u * x) := by
    intro x y he
    have h := congrArg (fun z : ZMod q => a * z) he
    simpa only [← mul_assoc, hau, one_mul] using h
  let X' := X.image (fun x => u * x - 1)
  let Y' := Y.image (fun y => u * y)
  have hcX : X'.card = X.card :=
    Finset.card_image_of_injective _ (fun _ _ h => hinj (sub_left_inj.mp h))
  have hcY : Y'.card = Y.card := Finset.card_image_of_injective _ hinj
  have hrun : ∀ x ∈ X', ∀ y ∈ Y', ∀ t : ℕ, t ≤ 2 → x + (t : ZMod q) ≠ y := by
    intro x hx y hy t ht he
    obtain ⟨x, hx0, rfl⟩ := Finset.mem_image.mp hx
    obtain ⟨y, hy0, rfl⟩ := Finset.mem_image.mp hy
    have hh := congrArg (fun z : ZMod q => a * z) he
    simp only [mul_add, mul_sub, ← mul_assoc, hau, one_mul, mul_one] at hh
    have cases_t : t = 0 ∨ t = 1 ∨ t = 2 := by omega
    apply havoid x hx0 y hy0
    rcases cases_t with rfl | rfl | rfl
    · have hh0 : x - a = y := by simpa only [Nat.cast_zero, mul_zero, add_zero] using hh
      have hz : y - x = -a := by rw [← hh0]; abel
      simp [hz]
    · have hh1 : x = y := by simpa only [Nat.cast_one, mul_one, sub_add_cancel] using hh
      simp [hh1]
    · have hh2 : x - a + (a + a) = y := by simpa only [Nat.cast_ofNat, mul_two] using hh
      have hz : y - x = a := by rw [← hh2]; abel
      simp [hz]
  have h := P14CyclicIntervalBiclique.forbidden_run_bound X' Y'
    (hX.image _) (hY.image _) 2 hrun
  rw [hcX, hcY] at h
  omega

theorem w_bound (C : ℕ → Prop) (S : Finset ℕ) (g : ℕ → ZMod q)
    (hg : LayerInjective C S g) (a b ua ub : ZMod q)
    (ha : ua * a = 1) (hb : ub * b = 1) :
    BicliqueBound (W C g a b) S (q - 2) := by
  classical
  intro A hAS B hBS hA hB _ hedge
  obtain ⟨i, hi⟩ := hA
  obtain ⟨j, hj⟩ := hB
  have hall : ∀ z ∈ A ∪ B, C z ↔ C i := by
    intro z hz
    rcases Finset.mem_union.mp hz with hza | hzb
    · exact (same_layer (within (hedge z hza j hj))).trans
        (same_layer (within (hedge i hi j hj))).symm
    · exact (same_layer (within (hedge i hi z hzb))).symm
  have hinj : Set.InjOn g ((A ∪ B : Finset ℕ) : Set ℕ) := by
    intro x hx y hy hxy
    exact hg x (Finset.union_subset hAS hBS hx) y (Finset.union_subset hAS hBS hy)
      ((hall x hx).trans (hall y hy).symm) hxy
  have hiA : Set.InjOn g A := by
    intro x hx y hy hxy
    exact hinj (Finset.mem_union_left B hx) (Finset.mem_union_left B hy) hxy
  have hiB : Set.InjOn g B := by
    intro x hx y hy hxy
    exact hinj (Finset.mem_union_right A hx) (Finset.mem_union_right A hy) hxy
  have hcA : (A.image g).card = A.card := Finset.card_image_of_injOn hiA
  have hcB : (B.image g).card = B.card := Finset.card_image_of_injOn hiB
  by_cases hCi : C i
  · have h := inverse_bound a ua ha (A.image g) (B.image g)
      ((show A.Nonempty from ⟨i, hi⟩).image _) ((show B.Nonempty from ⟨j, hj⟩).image _) (by
        intro x hx y hy
        obtain ⟨x, hx0, rfl⟩ := Finset.mem_image.mp hx
        obtain ⟨y, hy0, rfl⟩ := Finset.mem_image.mp hy
        rcases hedge x hx0 y hy0 with ⟨_, _, h⟩ | ⟨hn, _, _⟩
        · exact h
        · exact False.elim (hn ((hall x (Finset.mem_union_left B hx0)).mpr hCi)))
    rwa [hcA, hcB] at h
  · have h := inverse_bound b ub hb (A.image g) (B.image g)
      ((show A.Nonempty from ⟨i, hi⟩).image _) ((show B.Nonempty from ⟨j, hj⟩).image _) (by
        intro x hx y hy
        obtain ⟨x, hx0, rfl⟩ := Finset.mem_image.mp hx
        obtain ⟨y, hy0, rfl⟩ := Finset.mem_image.mp hy
        rcases hedge x hx0 y hy0 with ⟨hp, _, _⟩ | ⟨_, _, h⟩
        · exact False.elim (hCi ((hall x (Finset.mem_union_left B hx0)).mp hp))
        · exact h)
    rwa [hcA, hcB] at h

theorem bound (C : ℕ → Prop) (S : Finset ℕ) (g : ℕ → ZMod q)
    (hg : LayerInjective C S g) (a b c ua ub : ZMod q)
    (hua : ua * a = 1) (hub : ub * b = 1)
    (ho : Odd q) (ha : a ≠ 0) (hb : b ≠ 0)
    (t D : ℕ) (ht : t < q - 3) (hD : q - 3 + t + 1 ≤ D) (hqD : q - 2 ≤ D) :
    BicliqueBound (H C g a b c t) S D := by
  apply P14SparseCrossBiclique.combine _ C S (q - 3) t D ht hD
    (symmetric C g a b c t)
  · intro i hi B hBS hedge
    apply w_degree C S g hg a b ho ha hb i hi B hBS
    intro j hj
    obtain ⟨he, hw⟩ := hedge j hj
    rcases he with he | hc
    · exact he
    · exact False.elim (within_not_across hw (cross_across hc))
  · intro A hAS B hBS hA hB hdis hedge
    apply (w_bound C S g hg a b ua ub hua hub A hAS B hBS hA hB hdis ?_).trans hqD
    intro i hi j hj
    obtain ⟨he, hw⟩ := hedge i hi j hj
    rcases he with he | hc
    · exact he
    · exact False.elim (within_not_across hw (cross_across hc))
  · intro A hAS B hBS hA hB hdis hedge
    apply cross_bound C S g hg c t (by omega) A hAS B hBS hA hB hdis
    intro i hi j hj
    obtain ⟨he, hc⟩ := hedge i hi j hj
    rcases he with hw | he
    · exact False.elim (within_not_across (within hw) hc)
    · exact he

end P14UnitCycleComplement
end
end

section

/-! Actual invertibility of the ququart half-step and predecessor step.
The latter explicitly requires that three not divide the odd layer size;
the dense internal bound is then q-2 on the same physical row labels. -/
noncomputable section
namespace P14QuquartUnitSteps
open P14OddLayerLabels P14FiveComplementCover P14FivePrescribedPairings
open P14BicliqueComplementConnection
variable {q : ℕ} [NeZero q]

theorem half_coprime (hq : 7 ≤ q) (ho : Odd q) :
    Nat.Coprime (halfIndex hq).val q := by
  rw [P14DoubleConeSplit.half_val hq ho]
  have he : q = 1 + 2 * (q / 2) := by obtain ⟨k, hk⟩ := ho; omega
  have hc : Nat.Coprime (q / 2) (1 + 2 * (q / 2)) :=
    (Nat.coprime_add_mul_right_right (q / 2) 1 2).mpr (by simp)
  simpa only [← he] using hc

theorem pred_coprime (hq : 7 ≤ q) (ho : Odd q) (hthree : ¬ 3 ∣ q) :
    Nat.Coprime (predHalfIndex hq).val q := by
  rw [P14DoubleConeSplit.pred_val hq ho]
  have hc3 : Nat.Coprime 3 q :=
    (Nat.Prime.coprime_iff_not_dvd Nat.prime_three).mpr hthree
  have hc : Nat.Coprime (q - 3) q :=
    (Nat.coprime_self_sub_left (by omega : 3 ≤ q)).mpr hc3
  have he : q - 3 = 2 * (q / 2 - 1) := by obtain ⟨k, hk⟩ := ho; omega
  rw [he] at hc
  exact Nat.Coprime.of_dvd_left ⟨2, by omega⟩ hc

theorem bound (hq : 7 ≤ q) (ho : Odd q) (hthree : ¬ 3 ∣ q) (t D : ℕ)
    (ht : t < q - 3) (hD : q - 3 + t + 1 ≤ D) (hqD : q - 2 ≤ D) :
    BicliqueBound (P14QuquartDenseCover.H hq t) (Finset.range (2 * q)) D := by
  have hA : (P14OddLayerLabels.cast (halfIndex hq))⁻¹ *
      P14OddLayerLabels.cast (halfIndex hq) = 1 := by
    unfold P14OddLayerLabels.cast
    rw [mul_comm]
    exact ZMod.coe_mul_inv_eq_one _ (half_coprime hq ho)
  have hB : (P14OddLayerLabels.cast (predHalfIndex hq))⁻¹ *
      P14OddLayerLabels.cast (predHalfIndex hq) = 1 := by
    unfold P14OddLayerLabels.cast
    rw [mul_comm]
    exact ZMod.coe_mul_inv_eq_one _ (pred_coprime hq ho hthree)
  apply P14UnitCycleComplement.bound _ _ _ labels_injective _ _ _ _ _ hA hB ho ?_ ?_
    t D ht hD hqD
  · intro hz
    have he : halfIndex hq = (0 : Fin q) :=
      cast_injective (by simpa [P14OddLayerLabels.cast] using hz)
    have hv := congrArg Fin.val he
    rw [P14DoubleConeSplit.half_val hq ho] at hv
    change q / 2 = 0 at hv
    omega
  · intro hz
    have he : predHalfIndex hq = (0 : Fin q) :=
      cast_injective (by simpa [P14OddLayerLabels.cast] using hz)
    have hv := congrArg Fin.val he
    rw [P14DoubleConeSplit.pred_val hq ho] at hv
    change q / 2 - 1 = 0 at hv
    omega

end P14QuquartUnitSteps
end
end

section

/-! Complete the one-qubit boundary of the dominant ququart construction.
The balanced biclique equality case and its local vectors are discharged;
no finite exploration or unproved connectivity assertion is used. -/
noncomputable section
namespace P14QuquartOneQubitUPB
open P14ComplexLocalCover P14OddLayerLabels P14CanonicalUPBTransport
open P14QuquartDenseUPB P14FiveComplementCover P14FivePrescribedPairings
open P14BicliqueComplementConnection
open scoped BigOperators
variable {q : ℕ} [NeZero q]

theorem balanced_bound (hq : 7 ≤ q) (ho : Odd q) :
    BicliqueBound (P14QuquartDenseCover.H hq (q - 3))
      (Finset.range (2 * q)) (2 * q - 5) := by
  have cast_val (i : Fin q) : (P14OddLayerLabels.cast i).val = i.val :=
    ZMod.val_natCast_of_lt i.isLt
  have hA : (P14OddLayerLabels.cast (halfIndex hq)).val = q / 2 := by
    rw [cast_val, P14DoubleConeSplit.half_val hq ho]
  have hB : (P14OddLayerLabels.cast (predHalfIndex hq)).val = q / 2 - 1 := by
    rw [cast_val, P14DoubleConeSplit.pred_val hq ho]
  apply P14DenseBalancedComplement.bound hq ho (Side q) (Finset.range (2 * q))
    (label q) labels_injective _ _ _
  · intro hz
    have hv := congrArg ZMod.val hz
    rw [hA, ZMod.val_zero] at hv
    omega
  · intro hz
    have hv := congrArg ZMod.val hz
    rw [hB, ZMod.val_zero] at hv
    omega
  · rw [hA, hB]
    omega

theorem one_qubit (hq : 7 ≤ q) (ho : Odd q) :
    Conclusion 3 (dimensions (2 * q - 5) 1) := by
  classical
  let D := 2 * q - 5
  let t := q - 3
  have hcount : t + 1 + 2 = q := by dsimp [t]; omega
  obtain ⟨F, hF, hFne, hcover⟩ := P14QuquartDenseCover.cover hq hcount
  let R : Fin 3 → (Fin q ⊕ Fin q) → (Fin q ⊕ Fin q) → Prop :=
    Fin.cons (P14QuquartGraphCover.E hq)
      (Fin.cons (fun u v => P14QuquartDenseCover.H hq t (encode u) (encode v))
        (fun c u v => F c u = v))
  have hpartner : HasLocalFactor (Fin q ⊕ Fin q) D (D - 1) (R 1) := by
    obtain ⟨x, hnz, hpair, hspan⟩ := P14GenericExceptionalUPB.complex_rows
      (P14QuquartDenseCover.H hq t) (P14QuquartDenseCover.symmetric hq t)
      (P14QuquartDenseCover.irreflexive hq t) D (2 * q) (by dsimp [D]; omega)
      (balanced_bound hq ho)
    have hspan' : ∀ S : Finset (Fin (2 * q)), S.card = (D - 1) + 1 →
        Submodule.span ℂ (Set.range (fun i : S => x i)) = ⊤ := by
      intro S hs
      exact hspan S (by dsimp [D] at *; omega)
    have hx : HasLocalFactor (Fin (2 * q)) D (D - 1)
        (fun u v => P14QuquartDenseCover.H hq t u.val v.val) := ⟨x, hnz, hspan', hpair⟩
    exact P14ComplexLocalCover.reindex (rowEquiv q) hx
  have hlocal : ∀ j, HasLocalFactor (Fin q ⊕ Fin q)
      (dimensions D 1 j) (caps D 1 j) (R j) := by
    intro j
    refine Fin.cases (P14QuquartPartnerUPB.exceptional hq ho) (fun j => ?_) j
    refine Fin.cases hpartner (fun c => ?_) j
    simpa only [dimensions, caps, R, Fin.cons_succ] using
      P14MatchingLocalFactor.on_finite (F c) (hF c) (hFne c)
  have hcomplete : ∀ u v, u ≠ v → ∃ j, R j u v := by
    intro u v huv
    rcases hcover u v huv with he | hp | ⟨c, hc⟩
    · exact ⟨0, he⟩
    · exact ⟨1, hp⟩
    · exact ⟨c.succ.succ, hc⟩
  have hcard : Fintype.card (Fin q ⊕ Fin q) = 2 * q := by simp [two_mul]
  apply P14ComplexLocalCover.canonical (dimensions D 1) (caps D 1) R hlocal hcomplete
  · rw [sum_caps, hcard]
    dsimp [D]
    omega
  · rw [sum_deficits, hcard]
    dsimp [D]
    omega

theorem canonical {D m : ℕ} (hq : 7 ≤ q) (ho : Odd q)
    (hqD : q ≤ D) (hm : 1 ≤ m) (htotal : D + m = 2 * q - 4) :
    Conclusion (m + 2) (dimensions D m) := by
  by_cases hm1 : m = 1
  · subst m
    have he : D = 2 * q - 5 := by omega
    subst D
    exact one_qubit hq ho
  · exact P14QuquartDenseUPB.canonical hq ho hqD (by omega) htotal

theorem of_dimensions {D m p : ℕ} (hq : 7 ≤ q) (ho : Odd q)
    (hqD : q ≤ D) (hm : 1 ≤ m) (htotal : D + m = 2 * q - 4)
    (d : Fin p → ℕ) (e : Fin p ≃ Fin (m + 2))
    (he : ∀ j, d j = dimensions D m (e j)) : Conclusion p d :=
  P14CanonicalUPBTransport.of_dimensions (dimensions D m) d e he
    (canonical hq ho hqD hm htotal)

theorem four_nine_two : Conclusion 3 (dimensions 9 1) :=
  one_qubit (q := 7) (by omega) (by decide)

end P14QuquartOneQubitUPB
end
end

section

/-! Actual canonical UPBs in the intermediate dominant range. A proved
unit-step bound replaces the previous loose within-layer estimate; the
exceptional factor, matching cover and full vector assembly stay literal. -/
noncomputable section
namespace P14QuquartUnitUPB
open P14ComplexLocalCover P14OddLayerLabels P14CanonicalUPBTransport
open P14QuquartDenseUPB
open scoped BigOperators

theorem canonical_coprime_many {q D m : ℕ} [NeZero q] (hq : 7 ≤ q) (ho : Odd q) (hthree : ¬ 3 ∣ q)
    (hqD : q - 2 ≤ D) (hm : 2 ≤ m) (htotal : D + m = 2 * q - 4) :
    Conclusion (m + 2) (dimensions D m) := by
  classical
  let t := D + 2 - q
  have hcount : t + m + 2 = q := by dsimp [t]; omega
  have ht : t < q - 3 := by omega
  have hD : q - 3 + t + 1 ≤ D := by dsimp [t]; omega
  obtain ⟨F, hF, hFne, hcover⟩ := P14QuquartDenseCover.cover hq hcount
  let R : Fin (m + 2) → (Fin q ⊕ Fin q) → (Fin q ⊕ Fin q) → Prop :=
    Fin.cons (P14QuquartGraphCover.E hq)
      (Fin.cons (fun u v => P14QuquartDenseCover.H hq t (encode u) (encode v))
        (fun c u v => F c u = v))
  have hpartner : HasLocalFactor (Fin q ⊕ Fin q) D (D - 1) (R 1) := by
    obtain ⟨x, hnz, hpair, hspan⟩ := P14GenericExceptionalUPB.complex_rows
      (P14QuquartDenseCover.H hq t) (P14QuquartDenseCover.symmetric hq t)
      (P14QuquartDenseCover.irreflexive hq t) D (2 * q) (by omega)
      (P14QuquartUnitSteps.bound hq ho hthree t D ht hD hqD)
    have hspan' : ∀ S : Finset (Fin (2 * q)), S.card = (D - 1) + 1 →
        Submodule.span ℂ (Set.range (fun i : S => x i)) = ⊤ := by
      intro S hs
      exact hspan S (by omega)
    have hx : HasLocalFactor (Fin (2 * q)) D (D - 1)
        (fun u v => P14QuquartDenseCover.H hq t u.val v.val) := ⟨x, hnz, hspan', hpair⟩
    exact P14ComplexLocalCover.reindex (rowEquiv q) hx
  have hlocal : ∀ j, HasLocalFactor (Fin q ⊕ Fin q)
      (dimensions D m j) (caps D m j) (R j) := by
    intro j
    refine Fin.cases (P14QuquartPartnerUPB.exceptional hq ho) (fun j => ?_) j
    refine Fin.cases hpartner (fun c => ?_) j
    simpa only [dimensions, caps, R, Fin.cons_succ] using
      P14MatchingLocalFactor.on_finite (F c) (hF c) (hFne c)
  have hcomplete : ∀ u v, u ≠ v → ∃ j, R j u v := by
    intro u v huv
    rcases hcover u v huv with he | hp | ⟨c, hc⟩
    · exact ⟨0, he⟩
    · exact ⟨1, hp⟩
    · exact ⟨c.succ.succ, hc⟩
  have hcard : Fintype.card (Fin q ⊕ Fin q) = 2 * q := by simp [two_mul]
  apply P14ComplexLocalCover.canonical (dimensions D m) (caps D m) R hlocal hcomplete
  · rw [sum_caps, hcard]
    omega
  · rw [sum_deficits, hcard]
    omega

theorem canonical {q D m : ℕ} [NeZero q] (hq : 7 ≤ q) (ho : Odd q)
    (hm : 1 ≤ m) (htotal : D + m = 2 * q - 4)
    (hroom : q ≤ D ∨ (q - 2 ≤ D ∧ ¬ 3 ∣ q)) :
    Conclusion (m + 2) (dimensions D m) := by
  rcases hroom with hD | ⟨hD, hthree⟩
  · exact P14QuquartOneQubitUPB.canonical hq ho hD hm htotal
  · by_cases hm1 : m = 1
    · exact P14QuquartOneQubitUPB.canonical hq ho (by omega) hm htotal
    · exact canonical_coprime_many hq ho hthree hD (by omega) htotal

theorem of_dimensions {q D m p : ℕ} [NeZero q] (hq : 7 ≤ q) (ho : Odd q)
    (hm : 1 ≤ m) (htotal : D + m = 2 * q - 4)
    (hroom : q ≤ D ∨ (q - 2 ≤ D ∧ ¬ 3 ∣ q))
    (d : Fin p → ℕ) (e : Fin p ≃ Fin (m + 2))
    (he : ∀ j, d j = dimensions D m (e j)) : Conclusion p d :=
  P14CanonicalUPBTransport.of_dimensions (dimensions D m) d e he
    (canonical hq ho hm htotal hroom)

theorem four_ten_eight_qubits : Conclusion 10 (dimensions 10 8) :=
  canonical (q := 11) (by omega) (by decide) (by omega) (by omega)
    (Or.inr ⟨by omega, by decide⟩)

theorem four_nine_nine_qubits : Conclusion 11 (dimensions 9 9) :=
  canonical (q := 11) (by omega) (by decide) (by omega) (by omega)
    (Or.inr ⟨by omega, by decide⟩)

end P14QuquartUnitUPB
end
end

section

/-! Recognize arbitrary dimension lists containing a ququart and a partner
with room supplied by the numerical bound or a third sufficiently large
factor. The partition and factor permutations are constructed internally. -/

noncomputable section
namespace P14QuquartPartnerCanonical
open P14QuquartPartnerUPB P14CanonicalUPBTransport P14NonQubitPartition
open scoped BigOperators

theorem with_heads {q n k : ℕ} [NeZero q] (hq : 7 ≤ q) (ho : Odd q)
    (d : Fin (n + 2) → ℕ) (hd : ∀ j, 2 ≤ d j)
    (hzero : d 0 = 4) (hone : d 1 = k + 3)
    (hsum : (∑ j, (d j - 1)) = 2 * q - 2)
    (hroom : 2 * k ≤ q + 1 ∨ ∃ j : Fin n, k + 3 ≤ d j.succ.succ) :
    Conclusion (n + 2) d := by
  classical
  let t : Fin n → ℕ := fun j => d j.succ.succ
  obtain ⟨p, m, r, E, hr, he⟩ := P14NonQubitPartition.split t (fun j => hd j.succ.succ)
  let F : Fin (p + m + 2) ≃ Fin (n + 2) := lift (lift E)
  have hdim : ∀ j, dimensions r m k j = d (F j) := by
    intro j
    refine Fin.cases ?_ (fun j => ?_) j
    · simpa only [dimensions, Fin.cons_zero, F, lift_zero] using hzero.symm
    · refine Fin.cases ?_ (fun j => ?_) j
      · have hone' : k + 3 = d (0 : Fin (n + 1)).succ := by
          rw [Fin.succ_zero_eq_one]
          exact hone.symm
        simpa only [dimensions, Fin.cons_succ, Fin.cons_zero, F, lift_succ, lift_zero]
          using hone'
      · simpa only [dimensions, Fin.cons_succ, F, lift_succ, t] using (he j).symm
  have hs : (∑ j, (dimensions r m k j - 1)) = 2 * q - 2 := by
    calc
      _ = ∑ j, (d (F j) - 1) :=
        Finset.sum_congr rfl (fun j _ => congrArg (fun a : ℕ => a - 1) (hdim j))
      _ = _ := (F.sum_comp (fun j => d j - 1)).trans hsum
  rw [sum_deficits] at hs
  have htotal : (∑ i, r i) + m + k = 2 * q - 7 := by
    clear hroom
    omega
  have hcap : 2 * k ≤ q + 1 ∨ ∃ i, k + 2 ≤ r i := by
    rcases hroom with h | h
    · exact Or.inl h
    · obtain ⟨i, hi⟩ := P14NonQubitPartition.large_witness t r E he (by omega) h
      exact Or.inr ⟨i, by omega⟩
  have hc := P14QuquartPartnerUPB.canonical hq ho r hr htotal hcap
  apply P14CanonicalUPBTransport.of_dimensions (dimensions r m k) d F.symm
  · intro j
    simpa only [Equiv.apply_symm_apply] using (hdim (F.symm j)).symm
  · exact hc

theorem off_heads {n : ℕ} (v : Fin (n + 2)) (hzero : v ≠ 0) (hone : v ≠ 1) :
    ∃ u : Fin n, v = u.succ.succ := by
  revert hzero hone
  refine Fin.cases ?_ (fun w => ?_) v
  · intro h _
    exact False.elim (h rfl)
  · refine Fin.cases ?_ (fun u _ _ => ⟨u, rfl⟩) w
    intro _ h
    exact False.elim (h rfl)

theorem with_factors {q p : ℕ} [NeZero q] (hq : 7 ≤ q) (ho : Odd q)
    (d : Fin p → ℕ) (hd : ∀ j, 2 ≤ d j)
    (a b : Fin p) (hab : a ≠ b) (ha : d a = 4) (hb : 3 ≤ d b)
    (hsum : (∑ j, (d j - 1)) = 2 * q - 2)
    (hroom : 2 * (d b - 3) ≤ q + 1 ∨
      ∃ c : Fin p, c ≠ a ∧ c ≠ b ∧ d b ≤ d c) : Conclusion p d := by
  classical
  cases p with
  | zero => exact Fin.elim0 a
  | succ n =>
    cases n with
    | zero => exact False.elim (hab (Fin.ext (by have ha := a.isLt; have hb := b.isLt; omega)))
    | succ n =>
      let E : Fin (n + 2) ≃ Fin (n + 2) := Equiv.swap 0 a
      have hE0 : E 0 = a := Equiv.swap_apply_left _ _
      have hB : E.symm b ≠ 0 := by
        intro he
        have h := congrArg E he
        rw [Equiv.apply_symm_apply, hE0] at h
        exact hab h.symm
      obtain ⟨t, ht⟩ : ∃ t : Fin (n + 1), E.symm b = t.succ := by
        rcases Fin.eq_zero_or_eq_succ (E.symm b) with h | h
        · exact False.elim (hB h)
        · exact h
      let G : Fin (n + 1) ≃ Fin (n + 1) := Equiv.swap 0 t
      let F : Fin (n + 2) ≃ Fin (n + 2) := (lift G).trans E
      have hF0 : F 0 = a := by simp only [F, Equiv.trans_apply, lift_zero, hE0]
      have hF1 : F 1 = b := by
        change E (lift G (0 : Fin (n + 1)).succ) = b
        rw [lift_succ]
        have hG0 : G 0 = t := Equiv.swap_apply_left _ _
        rw [hG0, ← ht, Equiv.apply_symm_apply]
      let D : Fin (n + 2) → ℕ := fun j => d (F j)
      have hD0 : D 0 = 4 := by simpa only [D, hF0] using ha
      have hD1 : D 1 = (d b - 3) + 3 := by
        dsimp only [D]
        rw [hF1]
        omega
      have hcap : 2 * (d b - 3) ≤ q + 1 ∨
          ∃ j : Fin n, (d b - 3) + 3 ≤ D j.succ.succ := by
        rcases hroom with h | ⟨c, hca, hcb, hc⟩
        · exact Or.inl h
        · have hc0 : F.symm c ≠ 0 := by
            intro he
            have h := congrArg F he
            rw [Equiv.apply_symm_apply, hF0] at h
            exact hca h
          have hc1 : F.symm c ≠ 1 := by
            intro he
            have h := congrArg F he
            rw [Equiv.apply_symm_apply, hF1] at h
            exact hcb h
          obtain ⟨j, hj⟩ := off_heads (F.symm c) hc0 hc1
          refine Or.inr ⟨j, ?_⟩
          dsimp only [D]
          rw [← hj, Equiv.apply_symm_apply]
          omega
      have hs : (∑ j, (D j - 1)) = 2 * q - 2 :=
        (F.sum_comp (fun j => d j - 1)).trans hsum
      have H := with_heads hq ho D (fun j => hd (F j)) hD0 hD1 hs hcap
      have H' := reindex D F.symm H
      simpa only [D, Equiv.apply_symm_apply] using H'

theorem three_nonqubit {q p : ℕ} [NeZero q] (hq : 7 ≤ q) (ho : Odd q)
    (d : Fin p → ℕ) (hd : ∀ j, 2 ≤ d j)
    (hsum : (∑ j, (d j - 1)) = 2 * q - 2)
    (hthree : ∃ a b c : Fin p, a ≠ b ∧ a ≠ c ∧ b ≠ c ∧
      d a = 4 ∧ 3 ≤ d b ∧ 3 ≤ d c) : Conclusion p d := by
  obtain ⟨a, b, c, hab, hac, hbc, ha, hb, hc⟩ := hthree
  by_cases hle : d b ≤ d c
  · exact with_factors hq ho d hd a b hab ha hb hsum
      (Or.inr ⟨c, hac.symm, hbc.symm, hle⟩)
  · exact with_factors hq ho d hd a c hac ha hc hsum
      (Or.inr ⟨b, hab.symm, hbc, by omega⟩)

end P14QuquartPartnerCanonical

end
end

section

/-! Complete multipartite family with exactly one ququart and otherwise
qubits, with arbitrary factor order. The small/parity regions and exact
q=7/9 boundary arguments discharge every number of factors. -/
noncomputable section
namespace P14QuquartOnlyCanonical
open P14CanonicalUPBTransport
open scoped BigOperators

def dimensions (m : ℕ) : Fin (m + 1) → ℕ := Fin.cons 4 (fun _ : Fin m => 2)

theorem sum_deficits (m : ℕ) : (∑ j, (dimensions m j - 1)) = 3 + m := by
  simp [dimensions, Fin.sum_univ_succ]

theorem with_qubits (m : ℕ) (hm : 2 ≤ m) : Conclusion (m + 1) (dimensions m) := by
  classical
  by_contra hnot
  have hd : ∀ j, 2 ≤ dimensions m j := by
    intro j
    refine Fin.cases ?_ (fun j => ?_) j <;> simp [dimensions]
  have hbi : ¬ (m + 1 = 2 ∧ ∃ j, dimensions m j = 2) := by rintro ⟨he,_⟩; omega
  obtain ⟨_,_,hr⟩ :=
    P14CanonicalResidualAfterEight.necessary_conditions (by omega) (dimensions m) hd hbi hnot
  have hmod : (5 + m) % 4 = 2 := by
    rcases hr with htwo | hr
    · omega
    · rw [sum_deficits] at hr
      omega
  by_cases h5 : m = 5
  · subst m
    apply hnot
    apply P14TenRowFullCanonical.multipartite (dimensions 5) (by omega) hd
    · intro h
      have h0 := h 0
      norm_num [dimensions] at h0
    · rw [sum_deficits]
  let q := (m + 5) / 2
  have hq : 7 ≤ q := by dsimp [q]; omega
  have ho : Odd q := by
    refine ⟨m / 4 + 1, ?_⟩
    dsimp [q]
    omega
  have he : m = 2 * q - 5 := by dsimp [q]; omega
  apply hnot
  have hc : Conclusion ((2 * q - 5) + 1) (dimensions (2 * q - 5)) :=
    P14QuquartSevenUPB.canonical_ge_seven q hq ho
  rw [← he] at hc
  exact hc

theorem multipartite {p : ℕ} (d : Fin p → ℕ) (hp : 3 ≤ p)
    (hone : ∃ a : Fin p, d a = 4 ∧ ∀ j, j ≠ a → d j = 2) :
    Conclusion p d := by
  classical
  obtain ⟨a,ha,hrest⟩ := hone
  cases p with
  | zero => omega
  | succ n =>
    let E : Fin (n + 1) ≃ Fin (n + 1) := Equiv.swap 0 a
    have h0 : E 0 = a := Equiv.swap_apply_left 0 a
    have he : ∀ j, dimensions n j = d (E j) := by
      intro j
      refine Fin.cases ?_ (fun j => ?_) j
      · simpa only [dimensions, Fin.cons_zero, h0] using ha.symm
      · have hne : E j.succ ≠ a := by
          intro hh
          have hz := E.injective (hh.trans h0.symm)
          exact Fin.succ_ne_zero j hz
        simpa only [dimensions, Fin.cons_succ] using (hrest (E j.succ) hne).symm
    apply P14CanonicalUPBTransport.of_dimensions (dimensions n) d E.symm
    · intro j
      simpa only [Equiv.apply_symm_apply] using (he (E.symm j)).symm
    · exact with_qubits n (by omega)

end P14QuquartOnlyCanonical

end
end

section

/-! The full canonical conclusion for every multipartite dimension list
containing a ququart and at least two other non-qubit factors. All parities
and total deficits are handled using the previously checked regions. -/

noncomputable section
namespace P14QuquartThreeCanonical
open P14CanonicalUPBTransport
open scoped BigOperators

theorem multipartite {p : ℕ} (d : Fin p → ℕ) (hp : 3 ≤ p)
    (hd : ∀ j, 2 ≤ d j)
    (hthree : ∃ a b c : Fin p, a ≠ b ∧ a ≠ c ∧ b ≠ c ∧
      d a = 4 ∧ 3 ≤ d b ∧ 3 ≤ d c) : Conclusion p d := by
  classical
  by_contra hnot
  have hbi : ¬ (p = 2 ∧ ∃ j, d j = 2) := by rintro ⟨he, _⟩; omega
  obtain ⟨_, _, hr⟩ :=
    P14CanonicalResidualAfterEight.necessary_conditions (by omega) d hd hbi hnot
  have hmod : (2 + ∑ j, (d j - 1)) % 4 = 2 := by
    rcases hr with hp2 | hmod
    · omega
    · exact hmod
  obtain ⟨a, b, c, hab, hac, hbc, ha, hb, hc⟩ := hthree
  let T : Finset (Fin p) := {a, b, c}
  have hsub : (∑ j ∈ T, (d j - 1)) ≤ ∑ j, (d j - 1) :=
    Finset.sum_le_sum_of_subset_of_nonneg (Finset.subset_univ T)
      (fun _ _ _ => Nat.zero_le _)
  have hT : (∑ j ∈ T, (d j - 1)) = (d a - 1) + (d b - 1) + (d c - 1) := by
    simp [T, hab, hac, hbc, Nat.add_assoc]
  rw [hT] at hsub
  have hl : 6 ≤ ∑ j, (d j - 1) := by omega
  have hnq : ¬ (∀ j, d j = 2) := by intro h; have h' := h a; omega
  by_cases h8 : (∑ j, (d j - 1)) = 8
  · exact hnot (P14TenRowFullCanonical.multipartite d hp hd hnq h8)
  let S := ∑ j, (d j - 1)
  have hS : S % 4 = 0 ∧ 12 ≤ S := by dsimp only [S]; omega
  let q := (S + 2) / 2
  have hq : 7 ≤ q := by dsimp only [q]; omega
  have ho : Odd q := by
    refine ⟨S / 4, ?_⟩
    dsimp only [q]
    omega
  letI : NeZero q := ⟨by omega⟩
  have hsum : (∑ j, (d j - 1)) = 2 * q - 2 := by
    change S = 2 * q - 2
    dsimp only [q]
    omega
  exact hnot (P14QuquartPartnerCanonical.three_nonqubit hq ho d hd hsum
    ⟨a, b, c, hab, hac, hbc, ha, hb, hc⟩)

theorem residual_shape {p : ℕ} (d : Fin p → ℕ) (hp : 3 ≤ p)
    (hd : ∀ j, 2 ≤ d j) (a : Fin p) (ha : d a = 4)
    (hnot : ¬ Conclusion p d) :
    ∃ b : Fin p, b ≠ a ∧ 3 ≤ d b ∧
      ∀ j, j ≠ a → j ≠ b → d j = 2 := by
  classical
  by_cases hs : ∀ j, j ≠ a → d j = 2
  · exact False.elim (hnot (P14QuquartOnlyCanonical.multipartite d hp ⟨a, ha, hs⟩))
  push_neg at hs
  obtain ⟨b, hba, hb⟩ := hs
  have hb3 : 3 ≤ d b := by have h := hd b; omega
  refine ⟨b, hba, hb3, ?_⟩
  intro j hja hjb
  by_contra hj
  have hj3 : 3 ≤ d j := by have h := hd j; omega
  exact hnot (multipartite d hp hd ⟨a, b, j, hba.symm, hja.symm, hjb.symm, ha, hb3, hj3⟩)

theorem residual_bound {p : ℕ} (d : Fin p → ℕ) (hp : 3 ≤ p)
    (hd : ∀ j, 2 ≤ d j) (a : Fin p) (ha : d a = 4)
    (hnot : ¬ Conclusion p d) :
    ∃ b : Fin p, b ≠ a ∧ 3 ≤ d b ∧
      (∀ j, j ≠ a → j ≠ b → d j = 2) ∧
      12 ≤ (∑ j, (d j - 1)) ∧
      (∑ j, (d j - 1)) % 4 = 0 ∧
      (∑ j, (d j - 1)) + 4 < 4 * (d b - 3) := by
  classical
  obtain ⟨b, hba, hb, hothers⟩ := residual_shape d hp hd a ha hnot
  have hbi : ¬ (p = 2 ∧ ∃ j, d j = 2) := by rintro ⟨he, _⟩; omega
  obtain ⟨_, _, hr⟩ :=
    P14CanonicalResidualAfterEight.necessary_conditions (by omega) d hd hbi hnot
  have hmod : (2 + ∑ j, (d j - 1)) % 4 = 2 := by
    rcases hr with hp2 | hmod
    · omega
    · exact hmod
  let T : Finset (Fin p) := {a, b}
  have hsub : (∑ j ∈ T, (d j - 1)) ≤ ∑ j, (d j - 1) :=
    Finset.sum_le_sum_of_subset_of_nonneg (Finset.subset_univ T)
      (fun _ _ _ => Nat.zero_le _)
  have hT : (∑ j ∈ T, (d j - 1)) = (d a - 1) + (d b - 1) := by
    simp [T, hba.symm]
  rw [hT] at hsub
  have hl : 5 ≤ ∑ j, (d j - 1) := by omega
  have hnq : ¬ (∀ j, d j = 2) := by intro h; have h' := h a; omega
  have h8 : (∑ j, (d j - 1)) ≠ 8 := by
    intro he
    exact hnot (P14TenRowFullCanonical.multipartite d hp hd hnq he)
  let S := ∑ j, (d j - 1)
  have hS : S % 4 = 0 ∧ 12 ≤ S := by dsimp only [S]; omega
  let q := (S + 2) / 2
  have hq : 7 ≤ q := by dsimp only [q]; omega
  have ho : Odd q := by
    refine ⟨S / 4, ?_⟩
    dsimp only [q]
    omega
  letI : NeZero q := ⟨by omega⟩
  have hsum : (∑ j, (d j - 1)) = 2 * q - 2 := by
    change S = 2 * q - 2
    dsimp only [q]
    omega
  have hroom : ¬ 2 * (d b - 3) ≤ q + 1 := by
    intro hcap
    exact hnot (P14QuquartPartnerCanonical.with_factors hq ho d hd
      a b hba.symm ha hb hsum (Or.inl hcap))
  refine ⟨b, hba, hb, hothers, hS.2, hS.1, ?_⟩
  omega

end P14QuquartThreeCanonical
end
end

section

/-! Every three-factor tuple containing a dimension-four factor satisfies
the literal canonical bound, with arbitrary factor order and no parity or
partner-size restriction. Existing regions handle every other branch. -/
noncomputable section
namespace P14QuquartTripleCanonical
open P14CanonicalUPBTransport P14QuquartDenseUPB P14NonQubitPartition
open scoped BigOperators

theorem with_one_qubit (D : ℕ) (hD : 2 ≤ D) : Conclusion 3 (dimensions D 1) := by
  classical
  let d := dimensions D 1
  have hd : ∀ j, 2 ≤ d j := by
    intro j
    refine Fin.cases (by change 2 ≤ 4; omega) (fun j => ?_) j
    refine Fin.cases hD (fun _ => le_rfl) j
  have hs : (∑ j, (d j - 1)) = D + 3 := by
    dsimp only [d]
    rw [sum_deficits]
    omega
  by_contra hnot
  have hbi : ¬ (3 = 2 ∧ ∃ j, d j = 2) := by omega
  obtain ⟨_, _, hr⟩ := P14CanonicalResidualAfterEight.necessary_conditions
    (by omega) d hd hbi hnot
  have hmod : (D + 5) % 4 = 2 := by
    rcases hr with h | h
    · omega
    · rw [hs] at h
      omega
  by_cases hsmall : D = 5
  · have hnq : ¬ (∀ j, d j = 2) := by
      intro h
      have h0 := h 0
      change 4 = 2 at h0
      omega
    exact hnot (P14TenRowFullCanonical.multipartite d (by omega) hd hnq (by omega))
  let q := (D + 5) / 2
  have hq : 7 ≤ q := by dsimp [q]; omega
  have ho : Odd q := by
    refine ⟨(D + 3) / 4, ?_⟩
    dsimp [q]
    omega
  letI : NeZero q := ⟨by omega⟩
  have he : D = 2 * q - 5 := by dsimp [q]; omega
  apply hnot
  change Conclusion 3 (dimensions D 1)
  rw [he]
  exact P14QuquartOneQubitUPB.one_qubit hq ho

theorem triple (d : Fin 3 → ℕ) (hd : ∀ j, 2 ≤ d j)
    (hfour : ∃ a, d a = 4) : Conclusion 3 d := by
  classical
  by_contra hnot
  obtain ⟨a, ha⟩ := hfour
  obtain ⟨b, hba, hb, hrest⟩ :=
    P14QuquartThreeCanonical.residual_shape d (by omega) hd a ha hnot
  let E : Fin 3 ≃ Fin 3 := Equiv.swap 0 a
  have hE0 : E 0 = a := Equiv.swap_apply_left _ _
  have hB : E.symm b ≠ 0 := by
    intro he
    have h := congrArg E he
    rw [Equiv.apply_symm_apply, hE0] at h
    exact hba h
  obtain ⟨t, ht⟩ : ∃ t : Fin 2, E.symm b = t.succ := by
    rcases Fin.eq_zero_or_eq_succ (E.symm b) with h | h
    · exact False.elim (hB h)
    · exact h
  let G : Fin 2 ≃ Fin 2 := Equiv.swap 0 t
  let F : Fin 3 ≃ Fin 3 := (lift G).trans E
  have hF0 : F 0 = a := by simp only [F, Equiv.trans_apply, lift_zero, hE0]
  have hF1 : F 1 = b := by
    change E (lift G (0 : Fin 2).succ) = b
    rw [lift_succ]
    have hG0 : G 0 = t := Equiv.swap_apply_left _ _
    rw [hG0, ← ht, Equiv.apply_symm_apply]
  have hdim : ∀ j, dimensions (d b) 1 j = d (F j) := by
    intro j
    refine Fin.cases ?_ (fun j => ?_) j
    · simpa only [dimensions, Fin.cons_zero, hF0] using ha.symm
    · refine Fin.cases ?_ (fun j => ?_) j
      · change d b = d (F 1)
        rw [hF1]
      · change 2 = d (F j.succ.succ)
        apply (hrest _ ?_ ?_).symm
        · intro he
          have hz := F.injective (he.trans hF0.symm)
          exact Fin.succ_ne_zero j.succ hz
        · intro he
          have hz := F.injective (he.trans hF1.symm)
          have h' : j.succ = (0 : Fin 2) := Fin.succ_injective 2 hz
          exact Fin.succ_ne_zero j h'
  apply hnot
  apply P14CanonicalUPBTransport.of_dimensions (dimensions (d b) 1) d F.symm
  · intro j
    simpa only [Equiv.apply_symm_apply] using (hdim (F.symm j)).symm
  · exact with_one_qubit (d b) (by omega)

end P14QuquartTripleCanonical
end
end

section

/-! Recognize the exact single-partner shape in arbitrary factor order.
Combining all checked ququart regions leaves only at least fourteen-factor
residuals; all three-through-thirteen-factor ququart tuples are settled. -/
noncomputable section
namespace P14QuquartResidualAfterUnits
open P14CanonicalUPBTransport P14QuquartDenseUPB P14NonQubitPartition
open scoped BigOperators

theorem sum_two_heads {p : ℕ} (d : Fin p → ℕ) (a b : Fin p)
    (hab : a ≠ b) (ha : d a = 4) (hb : 3 ≤ d b)
    (hrest : ∀ j, j ≠ a → j ≠ b → d j = 2) :
    (∑ j, (d j - 1)) = d b + p := by
  classical
  have hf (j : Fin p) : d j - 1 =
      1 + (if j = a then 2 else 0) + (if j = b then d b - 2 else 0) := by
    by_cases hja : j = a
    · subst j
      simp [ha, hab]
    · by_cases hjb : j = b
      · subst j
        simp only [hja, if_false, if_true, add_zero]
        omega
      · rw [hrest j hja hjb]
        simp [hja, hjb]
  have hs : (∑ j, (d j - 1)) = p + 2 + (d b - 2) := by
    calc
      _ = ∑ j, (1 + (if j = a then 2 else 0) + (if j = b then d b - 2 else 0)) :=
        Finset.sum_congr rfl (fun j _ => hf j)
      _ = _ := by simp [Finset.sum_add_distrib]
  omega

theorem with_factors {q p : ℕ} [NeZero q] (hq : 7 ≤ q) (ho : Odd q)
    (d : Fin p → ℕ) (hp : 3 ≤ p) (a b : Fin p)
    (hab : a ≠ b) (ha : d a = 4) (hb : 3 ≤ d b)
    (hrest : ∀ j, j ≠ a → j ≠ b → d j = 2)
    (hsum : (∑ j, (d j - 1)) = 2 * q - 2)
    (hroom : q ≤ d b ∨ (q - 2 ≤ d b ∧ ¬ 3 ∣ q)) : Conclusion p d := by
  classical
  cases p with
  | zero => omega
  | succ n =>
    cases n with
    | zero => omega
    | succ n =>
      let E : Fin (n + 2) ≃ Fin (n + 2) := Equiv.swap 0 a
      have hE0 : E 0 = a := Equiv.swap_apply_left _ _
      have hB : E.symm b ≠ 0 := by
        intro he
        have h := congrArg E he
        rw [Equiv.apply_symm_apply, hE0] at h
        exact hab h.symm
      obtain ⟨t, ht⟩ : ∃ t : Fin (n + 1), E.symm b = t.succ := by
        rcases Fin.eq_zero_or_eq_succ (E.symm b) with h | h
        · exact False.elim (hB h)
        · exact h
      let G : Fin (n + 1) ≃ Fin (n + 1) := Equiv.swap 0 t
      let F : Fin (n + 2) ≃ Fin (n + 2) := (lift G).trans E
      have hF0 : F 0 = a := by simp only [F, Equiv.trans_apply, lift_zero, hE0]
      have hF1 : F 1 = b := by
        change E (lift G (0 : Fin (n + 1)).succ) = b
        rw [lift_succ]
        have hG0 : G 0 = t := Equiv.swap_apply_left _ _
        rw [hG0, ← ht, Equiv.apply_symm_apply]
      have hdim : ∀ j, dimensions (d b) n j = d (F j) := by
        intro j
        refine Fin.cases ?_ (fun j => ?_) j
        · simpa only [dimensions, Fin.cons_zero, hF0] using ha.symm
        · refine Fin.cases ?_ (fun j => ?_) j
          · change d b = d (F 1)
            rw [hF1]
          · change 2 = d (F j.succ.succ)
            apply (hrest _ ?_ ?_).symm
            · intro he
              have hz := F.injective (he.trans hF0.symm)
              exact Fin.succ_ne_zero j.succ hz
            · intro he
              have hz := F.injective (he.trans hF1.symm)
              have h' : j.succ = (0 : Fin (n + 1)) := Fin.succ_injective (n + 1) hz
              exact Fin.succ_ne_zero j h'
      have htotal : d b + n = 2 * q - 4 := by
        have hs := sum_two_heads d a b hab ha hb hrest
        omega
      apply P14CanonicalUPBTransport.of_dimensions (dimensions (d b) n) d F.symm
      · intro j
        simpa only [Equiv.apply_symm_apply] using (hdim (F.symm j)).symm
      · exact P14QuquartUnitUPB.canonical hq ho (by omega) htotal hroom

theorem small_total {p : ℕ} (d : Fin p → ℕ) (hp : 3 ≤ p)
    (hd : ∀ j, 2 ≤ d j) (hfour : ∃ a, d a = 4)
    (hsmall : (∑ j, (d j - 1)) < 28) : Conclusion p d := by
  classical
  by_contra hnot
  obtain ⟨a, ha⟩ := hfour
  obtain ⟨b, hba, hb, hrest, hlo, hmod, hgap⟩ :=
    P14QuquartThreeCanonical.residual_bound d hp hd a ha hnot
  let S := ∑ j, (d j - 1)
  change 12 ≤ S at hlo
  change S % 4 = 0 at hmod
  change S + 4 < 4 * (d b - 3) at hgap
  change S < 28 at hsmall
  let q := (S + 2) / 2
  have hq : 7 ≤ q := by dsimp [q]; omega
  have ho : Odd q := by
    refine ⟨S / 4, ?_⟩
    dsimp [q]
    omega
  letI : NeZero q := ⟨by omega⟩
  have hsum : (∑ j, (d j - 1)) = 2 * q - 2 := by
    change S = 2 * q - 2
    dsimp [q]
    omega
  have hqcases : q = 7 ∨ q = 9 ∨ q = 11 ∨ q = 13 := by dsimp [q]; omega
  have hroom : q ≤ d b ∨ (q - 2 ≤ d b ∧ ¬ 3 ∣ q) := by
    by_cases h : q ≤ d b
    · exact Or.inl h
    · right
      constructor
      · omega
      · rintro ⟨k, hk⟩
        omega
  exact hnot (with_factors hq ho d hp a b hba.symm ha hb hrest hsum hroom)

theorem residual {p : ℕ} (d : Fin p → ℕ) (hp : 3 ≤ p)
    (hd : ∀ j, 2 ≤ d j) (a : Fin p) (ha : d a = 4)
    (hnot : ¬ Conclusion p d) :
    14 ≤ p ∧ ∃ b : Fin p, b ≠ a ∧ 3 ≤ d b ∧
      (∀ j, j ≠ a → j ≠ b → d j = 2) ∧
      28 ≤ (∑ j, (d j - 1)) ∧ (∑ j, (d j - 1)) % 4 = 0 ∧
      (∑ j, (d j - 1)) + 4 < 4 * (d b - 3) ∧
      d b < ((∑ j, (d j - 1)) + 2) / 2 ∧
      (3 ∣ (((∑ j, (d j - 1)) + 2) / 2) ∨
        d b < (((∑ j, (d j - 1)) + 2) / 2) - 2) := by
  classical
  obtain ⟨b, hba, hb, hrest, hlo, hmod, hgap⟩ :=
    P14QuquartThreeCanonical.residual_bound d hp hd a ha hnot
  have hlarge : 28 ≤ (∑ j, (d j - 1)) := by
    by_contra hn
    exact hnot (small_total d hp hd ⟨a, ha⟩ (by omega))
  let S := ∑ j, (d j - 1)
  let q := (S + 2) / 2
  change 12 ≤ S at hlo
  change 28 ≤ S at hlarge
  change S % 4 = 0 at hmod
  have hq : 7 ≤ q := by dsimp [q]; omega
  have ho : Odd q := by
    refine ⟨S / 4, ?_⟩
    dsimp [q]
    omega
  letI : NeZero q := ⟨by omega⟩
  have hsum : (∑ j, (d j - 1)) = 2 * q - 2 := by
    change S = 2 * q - 2
    dsimp [q]
    omega
  have hnroom : ¬ (q ≤ d b ∨ (q - 2 ≤ d b ∧ ¬ 3 ∣ q)) := by
    intro hroom
    exact hnot (with_factors hq ho d hp a b hba.symm ha hb hrest hsum hroom)
  have hD : d b < q := by
    by_contra h
    exact hnroom (Or.inl (by omega))
  have hcase : 3 ∣ q ∨ d b < q - 2 := by
    by_cases hthree : 3 ∣ q
    · exact Or.inl hthree
    · right
      by_contra hn
      exact hnroom (Or.inr ⟨by omega, hthree⟩)
  have hs : S = d b + p := sum_two_heads d a b hba.symm ha hb hrest
  have hp14 : 14 ≤ p := by dsimp [q] at hD; omega
  exact ⟨hp14, b, hba, hb, hrest, hlarge, hmod, hgap, hD, hcase⟩

theorem few_factors {p : ℕ} (d : Fin p → ℕ) (hp : 3 ≤ p) (hp13 : p ≤ 13)
    (hd : ∀ j, 2 ≤ d j) (hfour : ∃ a, d a = 4) : Conclusion p d := by
  by_contra hnot
  obtain ⟨a, ha⟩ := hfour
  have h := (residual d hp hd a ha hnot).1
  omega

end P14QuquartResidualAfterUnits
end
end

section

/-! The complete multipartite dimension-four canonical family, in any
factor order and without parity or other dimension restrictions.
Other mixed-dimensional families and the full root remain outside this result. -/
noncomputable section
namespace P14QuquartFullCanonical
open P14CanonicalUPBTransport P14QuquartDenseUPB P14NonQubitPartition
open scoped BigOperators

theorem with_factors {q p : ℕ} [NeZero q] (hq : 15 ≤ q) (ho : Odd q)
    (d : Fin p → ℕ) (hp : 3 ≤ p) (a b : Fin p)
    (hab : a ≠ b) (ha : d a = 4) (hb : 3 ≤ d b)
    (hrest : ∀ j, j ≠ a → j ≠ b → d j = 2)
    (hsum : (∑ j, (d j - 1)) = 2 * q - 2)
    (hDq : d b < q) : Conclusion p d := by
  classical
  cases p with
  | zero => omega
  | succ n =>
    cases n with
    | zero => omega
    | succ n =>
      let E : Fin (n + 2) ≃ Fin (n + 2) := Equiv.swap 0 a
      have hE0 : E 0 = a := Equiv.swap_apply_left _ _
      have hB : E.symm b ≠ 0 := by
        intro he
        have h := congrArg E he
        rw [Equiv.apply_symm_apply, hE0] at h
        exact hab h.symm
      obtain ⟨t, ht⟩ : ∃ t : Fin (n + 1), E.symm b = t.succ := by
        rcases Fin.eq_zero_or_eq_succ (E.symm b) with h | h
        · exact False.elim (hB h)
        · exact h
      let G : Fin (n + 1) ≃ Fin (n + 1) := Equiv.swap 0 t
      let F : Fin (n + 2) ≃ Fin (n + 2) := (lift G).trans E
      have hF0 : F 0 = a := by simp only [F, Equiv.trans_apply, lift_zero, hE0]
      have hF1 : F 1 = b := by
        change E (lift G (0 : Fin (n + 1)).succ) = b
        rw [lift_succ]
        have hG0 : G 0 = t := Equiv.swap_apply_left _ _
        rw [hG0, ← ht, Equiv.apply_symm_apply]
      have hdim : ∀ j, dimensions (d b) n j = d (F j) := by
        intro j
        refine Fin.cases ?_ (fun j => ?_) j
        · simpa only [dimensions, Fin.cons_zero, hF0] using ha.symm
        · refine Fin.cases ?_ (fun j => ?_) j
          · change d b = d (F 1)
            rw [hF1]
          · change 2 = d (F j.succ.succ)
            apply (hrest _ ?_ ?_).symm
            · intro he
              have hz := F.injective (he.trans hF0.symm)
              exact Fin.succ_ne_zero j.succ hz
            · intro he
              have hz := F.injective (he.trans hF1.symm)
              have h' : j.succ = (0 : Fin (n + 1)) := Fin.succ_injective (n + 1) hz
              exact Fin.succ_ne_zero j h'
      have htotal : d b + n = 2 * q - 4 := by
        have hs := P14QuquartResidualAfterUnits.sum_two_heads d a b hab ha hb hrest
        omega
      apply P14CanonicalUPBTransport.of_dimensions (dimensions (d b) n) d F.symm
      · intro j
        simpa only [Equiv.apply_symm_apply] using (hdim (F.symm j)).symm
      · exact P14QuquartFreeUPB.canonical hq ho hb hDq htotal


theorem multipartite {p : ℕ} (d : Fin p → ℕ) (hp : 3 ≤ p)
    (hd : ∀ j, 2 ≤ d j) (hfour : ∃ a, d a = 4) : Conclusion p d := by
  classical
  by_contra hnot
  obtain ⟨a,ha⟩ := hfour
  obtain ⟨_,b,hba,hb,hrest,hlarge,hmod,_,hDq,_⟩ :=
    P14QuquartResidualAfterUnits.residual d hp hd a ha hnot
  let S := ∑ j, (d j - 1)
  let q := (S + 2) / 2
  change 28 ≤ S at hlarge
  change S % 4 = 0 at hmod
  change d b < q at hDq
  have hq : 15 ≤ q := by dsimp [q]; omega
  have ho : Odd q := by
    refine ⟨S / 4, ?_⟩
    dsimp [q]
    omega
  letI : NeZero q := ⟨by omega⟩
  have hsum : (∑ j, (d j - 1)) = 2 * q - 2 := by
    change S = 2 * q - 2
    dsimp [q]
    omega
  exact hnot (with_factors hq ho d hp a b hba.symm ha hb hrest hsum hDq)

end P14QuquartFullCanonical
end
end

section

/-! Recognize any dimension-five factor, without a caller-supplied ordering.
The full multipartite family is obtained by combining the raw odd-half-order
construction with the already checked parity and small-row regions. -/

noncomputable section
namespace P14FiveRawCanonical
open P14FiveFlexibleUPB P14CanonicalUPBTransport P14NonQubitPartition
open scoped BigOperators

theorem odd_large {q p : ℕ} [NeZero q] (hq : 7 ≤ q) (ho : Odd q)
    (d : Fin p → ℕ) (hd : ∀ j, 2 ≤ d j) (hf : ∃ j, d j = 5)
    (hsum : (∑ j, (d j - 1)) = 2 * q - 2) : Conclusion p d := by
  classical
  obtain ⟨a, ha⟩ := hf
  cases p with
  | zero => exact Fin.elim0 a
  | succ n =>
    let E : Fin (n + 1) ≃ Fin (n + 1) := Equiv.swap 0 a
    let t : Fin n → ℕ := fun j => d (E j.succ)
    obtain ⟨u, m, r, F, hr, he⟩ := P14NonQubitPartition.split t (fun j => hd (E j.succ))
    let G : Fin (u + m + 1) ≃ Fin (n + 1) := (lift F).trans E
    have hdim : ∀ j, dimensions r m j = d (G j) := by
      intro j
      refine Fin.cases ?_ (fun j => ?_) j
      · simp only [dimensions, Fin.cons_zero, G, Equiv.trans_apply, lift_zero,
          E, Equiv.swap_apply_left, ha]
      · simpa only [dimensions, Fin.cons_succ, G, Equiv.trans_apply, lift_succ, t]
          using (he j).symm
    have hs : (∑ j, (dimensions r m j - 1)) = 2 * q - 2 := by
      calc
        _ = ∑ j, (d (G j) - 1) :=
          Finset.sum_congr rfl (fun j _ => congrArg (fun z : ℕ => z - 1) (hdim j))
        _ = _ := (G.sum_comp (fun j => d j - 1)).trans hsum
    rw [sum_deficits] at hs
    have ht : (∑ i, r i) + m = 2 * q - 6 := by omega
    apply P14CanonicalUPBTransport.of_dimensions (dimensions r m) d G.symm
    · intro j
      simpa only [Equiv.apply_symm_apply] using (hdim (G.symm j)).symm
    · exact P14FiveFlexibleUPB.canonical hq ho r hr ht

theorem multipartite {p : ℕ} (d : Fin p → ℕ) (hp : 3 ≤ p)
    (hd : ∀ j, 2 ≤ d j) (hf : ∃ j, d j = 5) : Conclusion p d := by
  classical
  by_contra hnot
  have hbi : ¬ (p = 2 ∧ ∃ j, d j = 2) := by rintro ⟨he, _⟩; omega
  obtain ⟨_, _, hr⟩ :=
    P14CanonicalResidualAfterEight.necessary_conditions (by omega) d hd hbi hnot
  have hmod : (2 + ∑ j, (d j - 1)) % 4 = 2 := by
    rcases hr with hp2 | hmod
    · omega
    · exact hmod
  obtain ⟨a, ha⟩ := hf
  have hrest : p - 1 ≤ ∑ j ∈ (Finset.univ : Finset (Fin p)).erase a, (d j - 1) := by
    calc
      p - 1 = ∑ _j ∈ (Finset.univ : Finset (Fin p)).erase a, (1 : ℕ) := by simp
      _ ≤ _ := Finset.sum_le_sum (fun j _ => by have hj := hd j; omega)
  have hsplit := Finset.sum_erase_add (Finset.univ : Finset (Fin p))
    (fun j => d j - 1) (Finset.mem_univ a)
  have hl : 6 ≤ ∑ j, (d j - 1) := by omega
  have hnq : ¬ (∀ j, d j = 2) := by intro h; have h' := h a; omega
  by_cases h8 : (∑ j, (d j - 1)) = 8
  · exact hnot (P14TenRowFullCanonical.multipartite d hp hd hnq h8)
  let S := ∑ j, (d j - 1)
  have hS : S % 4 = 0 ∧ 12 ≤ S := by dsimp only [S]; omega
  let q := (S + 2) / 2
  have hq : 7 ≤ q := by dsimp only [q]; omega
  have ho : Odd q := by
    refine ⟨S / 4, ?_⟩
    dsimp only [q]
    omega
  letI : NeZero q := ⟨by omega⟩
  have hsum : (∑ j, (d j - 1)) = 2 * q - 2 := by
    change S = 2 * q - 2
    dsimp only [q]
    omega
  exact hnot (odd_large hq ho d hd ⟨a, ha⟩ hsum)

end P14FiveRawCanonical

end
end

section

/-! Complete all multipartite tuples with a factor of dimension three,
four or five. Record necessary conditions for the remaining full root;
none of the residual conditions asserts that a counterexample exists. -/
namespace P14LowDimensionCanonical
open P14CanonicalUPBTransport
open scoped BigOperators

theorem multipartite {p : ℕ} (d : Fin p → ℕ) (hp : 3 ≤ p)
    (hd : ∀ j, 2 ≤ d j) (hlow : ∃ j, 3 ≤ d j ∧ d j ≤ 5) : Conclusion p d := by
  obtain ⟨j,hj,hj5⟩ := hlow
  have he : d j = 3 ∨ d j = 4 ∨ d j = 5 := by omega
  rcases he with h | h | h
  · exact P14QutritFullCanonical.multipartite d hp hd ⟨j,h⟩
  · exact P14QuquartFullCanonical.multipartite d hp hd ⟨j,h⟩
  · exact P14FiveRawCanonical.multipartite d hp hd ⟨j,h⟩

theorem residual {p : ℕ} (d : Fin p → ℕ) (hp : 3 ≤ p)
    (hd : ∀ j, 2 ≤ d j) (hnq : ¬ (∀ j, d j = 2)) (hnot : ¬ Conclusion p d) :
    (∀ j, d j = 2 ∨ 6 ≤ d j) ∧ (∃ j, 6 ≤ d j) ∧
      (∑ j, (d j - 1)) % 4 = 0 ∧ 12 ≤ (∑ j, (d j - 1)) ∧
      (∃ j, Even (d j)) := by
  classical
  have hdim : ∀ j, d j = 2 ∨ 6 ≤ d j := by
    intro j
    by_contra hj
    have hj2 := hd j
    exact hnot (multipartite d hp hd ⟨j,by omega,by omega⟩)
  have hlarge : ∃ j, 6 ≤ d j := by
    by_contra hn
    apply hnq
    intro j
    rcases hdim j with h | h
    · exact h
    · exact False.elim (hn ⟨j,h⟩)
  have hbi : ¬ (p = 2 ∧ ∃ j, d j = 2) := by rintro ⟨he,_⟩; omega
  obtain ⟨_,he,hr⟩ :=
    P14CanonicalResidualAfterEight.necessary_conditions (by omega) d hd hbi hnot
  have hmod : (∑ j, (d j - 1)) % 4 = 0 := by
    rcases hr with hp2 | hmod <;> omega
  have h8 : (∑ j, (d j - 1)) ≠ 8 := by
    intro hs
    exact hnot (P14TenRowFullCanonical.multipartite d hp hd hnq hs)
  have hlo : 5 ≤ (∑ j, (d j - 1)) := by
    obtain ⟨j,hj⟩ := hlarge
    have hle : d j - 1 ≤ ∑ k, (d k - 1) :=
      Finset.single_le_sum (f := fun k : Fin p => d k - 1) (fun k _ => Nat.zero_le _) (Finset.mem_univ j)
    omega
  exact ⟨hdim,hlarge,hmod,by omega,he⟩

theorem admissible_residual {p : ℕ} (d : Fin p → ℕ)
    (had : Admissible p d) (hnot : ¬ Conclusion p d) :
    p = 2 ∨ (3 ≤ p ∧ (∀ j, d j = 2 ∨ 6 ≤ d j) ∧ (∃ j, 6 ≤ d j) ∧
      (∑ j, (d j - 1)) % 4 = 0 ∧ 12 ≤ (∑ j, (d j - 1)) ∧
      (∃ j, Even (d j))) := by
  obtain ⟨hp,hd,_,hnq⟩ := had
  by_cases hp2 : p = 2
  · exact Or.inl hp2
  · exact Or.inr ⟨by omega,residual d (by omega) hd hnq hnot⟩

end P14LowDimensionCanonical
end

section

/-! Recognize the mixed higher-dimensional construction in arbitrary factor
order. Together with the checked lower-dimensional cases, every multipartite
tuple with at least two non-qubits is covered, without dimension upper bounds. -/

noncomputable section
namespace P14HighDimensionRawCanonical
open P14HighDimensionFlexibleUPB P14CanonicalUPBTransport P14NonQubitPartition
open scoped BigOperators

theorem chosen_minimum {q p : ℕ} [NeZero q] (hq : 7 ≤ q) (ho : Odd q)
    (d : Fin p → ℕ) (hd : ∀ j, 2 ≤ d j) (a : Fin p) (ha : 6 ≤ d a)
    (hmin : ∀ j, d j ≠ 2 → d a ≤ d j)
    (hw : ∃ b, b ≠ a ∧ d b ≠ 2)
    (hsum : (∑ j, (d j - 1)) = 2 * q - 2) : Conclusion p d := by
  classical
  have hdq : d a ≤ q := by
    obtain ⟨b, hba, hb⟩ := hw
    have hbmin := hmin b hb
    have hle : (d a - 1) + (d b - 1) ≤ ∑ j, (d j - 1) := by
      calc
        _ = ∑ j ∈ ({a, b} : Finset (Fin p)), (d j - 1) := by simp [hba.symm]
        _ ≤ _ := Finset.sum_le_sum_of_subset_of_nonneg (Finset.subset_univ _)
          (fun _ _ _ => Nat.zero_le _)
    omega
  cases p with
  | zero => exact Fin.elim0 a
  | succ n =>
    let E : Fin (n + 1) ≃ Fin (n + 1) := Equiv.swap 0 a
    have hE0 : E 0 = a := Equiv.swap_apply_left _ _
    let t : Fin n → ℕ := fun j => d (E j.succ)
    obtain ⟨u, m, r, F, hr, he⟩ := P14NonQubitPartition.split t (fun j => hd (E j.succ))
    let G : Fin (u + m + 1) ≃ Fin (n + 1) := (lift F).trans E
    have hdim : ∀ j, dimensions (d a) r m j = d (G j) := by
      intro j
      refine Fin.cases ?_ (fun j => ?_) j
      · simp only [dimensions, Fin.cons_zero, G, Equiv.trans_apply, lift_zero, hE0]
      · simpa only [dimensions, Fin.cons_succ, G, Equiv.trans_apply, lift_succ, t]
          using (he j).symm
    have hlarge : ∃ j, 3 ≤ t j := by
      obtain ⟨b, hba, hb⟩ := hw
      have hb0 : E.symm b ≠ 0 := by
        intro hh
        have hh' := congrArg E hh
        rw [Equiv.apply_symm_apply, hE0] at hh'
        exact hba hh'
      obtain ⟨j, hj⟩ : ∃ j : Fin n, E.symm b = j.succ := by
        rcases Fin.eq_zero_or_eq_succ (E.symm b) with h | h
        · exact False.elim (hb0 h)
        · exact h
      refine ⟨j, ?_⟩
      dsimp only [t]
      rw [← hj, Equiv.apply_symm_apply]
      have hdb := hd b
      omega
    obtain ⟨i, _⟩ := P14NonQubitPartition.large_witness t r F he (by decide : 3 ≤ 3) hlarge
    have hp : 0 < u := by have hi := i.isLt; omega
    have hrange (i : Fin u) : d a - 1 ≤ r i := by
      have heq := hdim (Fin.castAdd m i).succ
      simp only [dimensions, Fin.cons_succ, Fin.append_left] at heq
      have hri := hr i
      have hn : d (G (Fin.castAdd m i).succ) ≠ 2 := by omega
      have hlo := hmin _ hn
      omega
    have hs : (∑ j, (dimensions (d a) r m j - 1)) = 2 * q - 2 := by
      calc
        _ = ∑ j, (d (G j) - 1) :=
          Finset.sum_congr rfl (fun j _ => congrArg (fun z : ℕ => z - 1) (hdim j))
        _ = _ := (G.sum_comp (fun j => d j - 1)).trans hsum
    rw [sum_deficits] at hs
    have ht : (∑ i, r i) + m = 2 * q - d a - 1 := by omega
    apply P14CanonicalUPBTransport.of_dimensions (dimensions (d a) r m) d G.symm
    · intro j
      simpa only [Equiv.apply_symm_apply] using (hdim (G.symm j)).symm
    · exact P14HighDimensionFlexibleUPB.canonical hq ho ha hdq hp r hrange ht

theorem odd_mixed {q p : ℕ} [NeZero q] (hq : 7 ≤ q) (ho : Odd q)
    (d : Fin p → ℕ) (hd : ∀ j, d j = 2 ∨ 6 ≤ d j)
    (htwo : ∃ a b, a ≠ b ∧ d a ≠ 2 ∧ d b ≠ 2)
    (hsum : (∑ j, (d j - 1)) = 2 * q - 2) : Conclusion p d := by
  classical
  obtain ⟨u, v, huv, hdu, hdv⟩ := htwo
  let S := (Finset.univ : Finset (Fin p)).filter (fun j => d j ≠ 2)
  have hS : S.Nonempty := ⟨u, Finset.mem_filter.mpr ⟨Finset.mem_univ _, hdu⟩⟩
  obtain ⟨a, haS, hamin⟩ := Finset.exists_min_image S d hS
  have ha : d a ≠ 2 := (Finset.mem_filter.mp haS).2
  have ha6 : 6 ≤ d a := (hd a).resolve_left ha
  have hmin : ∀ j, d j ≠ 2 → d a ≤ d j := by
    intro j hj
    exact hamin j (Finset.mem_filter.mpr ⟨Finset.mem_univ _, hj⟩)
  have hw : ∃ b, b ≠ a ∧ d b ≠ 2 := by
    by_cases hau : a = u
    · exact ⟨v, fun h => huv (hau.symm.trans h.symm), hdv⟩
    · exact ⟨u, Ne.symm hau, hdu⟩
  exact chosen_minimum hq ho d (fun j => by rcases hd j with h | h <;> omega)
    a ha6 hmin hw hsum

theorem multipartite {p : ℕ} (d : Fin p → ℕ) (hp : 3 ≤ p)
    (hd : ∀ j, 2 ≤ d j) (htwo : ∃ a b, a ≠ b ∧ d a ≠ 2 ∧ d b ≠ 2)
    : Conclusion p d := by
  classical
  by_contra hnot
  have hnq : ¬ (∀ j, d j = 2) := by
    intro h
    obtain ⟨a, _, _, ha, _⟩ := htwo
    exact ha (h a)
  obtain ⟨hshape, _, hmod, hlo, _⟩ := P14LowDimensionCanonical.residual d hp hd hnq hnot
  let S := ∑ j, (d j - 1)
  let q := (S + 2) / 2
  have hq : 7 ≤ q := by dsimp [q, S]; omega
  have ho : Odd q := by
    refine ⟨S / 4, ?_⟩
    dsimp [q, S]
    omega
  letI : NeZero q := ⟨by omega⟩
  have hsum : (∑ j, (d j - 1)) = 2 * q - 2 := by dsimp [q, S]; omega
  exact hnot (odd_mixed hq ho d hshape htwo hsum)

theorem residual_shape {p : ℕ} (d : Fin p → ℕ) (hp : 3 ≤ p)
    (hd : ∀ j, 2 ≤ d j) (hnq : ¬ (∀ j, d j = 2)) (hnot : ¬ Conclusion p d) :
    ∃ a, 6 ≤ d a ∧ ∀ j, j ≠ a → d j = 2 := by
  classical
  obtain ⟨_, ⟨a, ha⟩, _, _, _⟩ := P14LowDimensionCanonical.residual d hp hd hnq hnot
  refine ⟨a, ha, ?_⟩
  intro j hja
  by_contra hj
  exact hnot (multipartite d hp hd ⟨a, j, hja.symm, by omega, hj⟩)

end P14HighDimensionRawCanonical
end
end

section

/-! Entries of the concrete balanced spectral matrix, with the Fourier
orientation and the inverse phase in the Cauchy denominator explicit. -/

noncomputable section
namespace P14BalancedSpectralEntries

open Matrix P14FourierSpectralWeights P14BalancedSpectralMatrix
open scoped BigOperators

theorem star_normalization (p : ℕ) :
    star (fourierNormalization p) = fourierNormalization p := by
  simp [fourierNormalization, Complex.star_def]

theorem normalization_sq (p : ℕ) :
    fourierNormalization p * fourierNormalization p = (p : ℂ)⁻¹ := by
  have hs : (Real.sqrt (p : ℝ) : ℂ) * (Real.sqrt (p : ℝ) : ℂ) = (p : ℂ) := by
    norm_cast
    exact Real.mul_self_sqrt (Nat.cast_nonneg p)
  simp only [fourierNormalization]
  rw [← mul_inv, hs]

private theorem basisChange_mul_swapPhase {p : ℕ} [NeZero p] (η : ℂ)
    (i j : Option (Fin p)) :
    (basisChange p * swapPhase (p := p) η :
      Matrix (Option (Fin p)) (Option (Fin p)) ℂ) i j =
      basisChange p i (Equiv.swap none (some (0 : Fin p)) j) * phaseWeight η j := by
  classical
  simp [Matrix.mul_apply, swapPhase, weightedPermutation, mul_ite]

theorem spectralMatrix_apply {p : ℕ} [NeZero p] (η : ℂ)
    (i j : Option (Fin p)) :
    spectralMatrix (p := p) η i j =
      ∑ q : Option (Fin p),
        (basisChange p i (Equiv.swap none (some (0 : Fin p)) q) * phaseWeight η q) *
          star (basisChange p j q) := by
  rw [spectralMatrix, Matrix.mul_apply]
  simp only [basisChange_mul_swapPhase, Matrix.conjTranspose_apply]

theorem spectralMatrix_none_none {p : ℕ} [NeZero p] (η : ℂ) :
    spectralMatrix (p := p) η none none = 0 := by
  simp [spectralMatrix_apply, Fintype.sum_option, basisChange, phaseWeight]

theorem spectralMatrix_some_none {p : ℕ} [NeZero p] (η : ℂ) (a : Fin p) :
    spectralMatrix (p := p) η (some a) none = fourierNormalization p := by
  simp [spectralMatrix_apply, Fintype.sum_option, basisChange, phaseWeight, fourierMatrix]

theorem spectralMatrix_none_some {p : ℕ} [NeZero p] (η : ℂ) (b : Fin p) :
    spectralMatrix (p := p) η none (some b) = fourierNormalization p := by
  classical
  have hterm (j : Fin p) :
      (basisChange p none (Equiv.swap none (some (0 : Fin p)) (some j)) *
        phaseWeight η (some j)) * star (basisChange p (some b) (some j)) =
      if j = 0 then fourierNormalization p else 0 := by
    by_cases hj : j = 0
    · subst j
      simp [basisChange, phaseWeight, fourierMatrix, fourierNormalization, Complex.star_def]
    · rw [Equiv.swap_apply_of_ne_of_ne (by simp) (by simpa using hj)]
      simp [basisChange, hj]
  have hsum := Finset.sum_congr (s₁ := Finset.univ) (s₂ := Finset.univ) rfl
    (fun j _ => hterm j)
  simpa [spectralMatrix_apply, Fintype.sum_option, basisChange, phaseWeight] using hsum

theorem spectralMatrix_some_some_sum {p : ℕ} [NeZero p] (η : ℂ) (a b : Fin p) :
    spectralMatrix (p := p) η (some a) (some b) =
      (∑ j : Fin p, fourierMatrix p a j * η ^ j.val * star (fourierMatrix p b j)) -
        fourierNormalization p * fourierNormalization p := by
  classical
  have hterm (j : Fin p) :
      (basisChange p (some a) (Equiv.swap none (some (0 : Fin p)) (some j)) *
        phaseWeight η (some j)) * star (basisChange p (some b) (some j)) +
        (if j = 0 then fourierNormalization p * fourierNormalization p else 0) =
      fourierMatrix p a j * η ^ j.val * star (fourierMatrix p b j) := by
    by_cases hj : j = 0
    · subst j
      simp [basisChange, phaseWeight, fourierMatrix, fourierNormalization, Complex.star_def]
    · rw [Equiv.swap_apply_of_ne_of_ne (by simp) (by simpa using hj)]
      simp [basisChange, phaseWeight, hj]
  apply eq_sub_iff_add_eq.mpr
  have hsum := Finset.sum_congr (s₁ := Finset.univ) (s₂ := Finset.univ) rfl
    (fun j _ => hterm j)
  simpa [spectralMatrix_apply, Fintype.sum_option, basisChange, phaseWeight,
    Finset.sum_add_distrib] using hsum

private theorem geometric_quotient {p : ℕ} (η x y : ℂ)
    (hη : η ≠ 0) (hy : y ≠ 0)
    (hpow : (η * x / y) ^ p = η) (hne : η * x / y ≠ 1) :
    (∑ j : Fin p, (η * x / y) ^ j.val) - 1 =
      (y - x) / (x - η⁻¹ * y) := by
  let s := η * x / y
  have hs : s - 1 ≠ 0 := sub_ne_zero.mpr hne
  have hd : x - η⁻¹ * y ≠ 0 := by
    intro h
    apply hne
    rw [sub_eq_zero.mp h]
    field_simp [hη, hy]
  have hg : (∑ j : Fin p, s ^ j.val) * (s - 1) = η - 1 := by
    rw [Fin.sum_univ_eq_sum_range, geom_sum_mul]
    exact congrArg (fun z : ℂ => z - 1) hpow
  have hsum : (∑ j : Fin p, s ^ j.val) - 1 = (η - s) / (s - 1) := by
    apply (eq_div_iff hs).mpr
    calc
      _ = (∑ j : Fin p, s ^ j.val) * (s - 1) - (s - 1) := by ring
      _ = η - s := by rw [hg]; ring
  change (∑ j : Fin p, s ^ j.val) - 1 = _
  rw [hsum]
  dsimp [s]
  field_simp [hη, hy, hs, hd]
  <;> ring

theorem spectralMatrix_some_some {p : ℕ} [NeZero p] (hp : 3 ≤ p)
    {η : ℂ} (hη : IsPrimitiveRoot η (p - 1)) (a b : Fin p) :
    spectralMatrix (p := p) η (some a) (some b) =
      (fourierRoot p ^ b.val - fourierRoot p ^ a.val) /
        ((p : ℂ) * (fourierRoot p ^ a.val - η⁻¹ * fourierRoot p ^ b.val)) := by
  let ζ := fourierRoot p
  let x := ζ ^ a.val
  let y := ζ ^ b.val
  have hζ : IsPrimitiveRoot ζ p := fourierRoot_isPrimitiveRoot p (by omega)
  have hη0 : η ≠ 0 := hη.ne_zero (by omega)
  have hy : y ≠ 0 := pow_ne_zero _ (hζ.ne_zero (by omega))
  have hηp : η ^ p = η := by
    have hnat : p - 1 + 1 = p := by omega
    rw [← hnat, pow_succ, hη.pow_eq_one, one_mul]
  have hpower (m : ℕ) : (ζ ^ m) ^ p = 1 := by
    rw [← pow_mul, Nat.mul_comm, pow_mul, hζ.pow_eq_one, one_pow]
  have hs : (η * x / y) ^ p = η := by
    simp only [x, y, mul_pow, div_pow, hpower, hηp, mul_one, div_one]
  have hη1 : η ≠ 1 := by
    simpa using hη.pow_ne_one_of_pos_of_lt (show 1 ≠ 0 by omega) (show 1 < p - 1 by omega)
  have hs1 : η * x / y ≠ 1 := by
    intro h
    apply hη1
    simpa [h] using hs.symm
  have hunit : star ζ * ζ = 1 := by
    change (starRingEnd ℂ) ζ * ζ = 1
    simpa only [hζ.norm'_eq_one (by omega), one_pow, Complex.ofReal_one]
      using Complex.conj_mul' ζ
  have hyunit : star y * y = 1 := by
    simpa only [mul_pow, ← star_pow, one_pow] using
      congrArg (fun z : ℂ => z ^ b.val) hunit
  have hstar : star y = y⁻¹ := by
    apply mul_right_cancel₀ hy
    rw [hyunit, inv_mul_cancel₀ hy]
  have hterm (j : Fin p) :
      fourierMatrix p a j * η ^ j.val * star (fourierMatrix p b j) =
        (fourierNormalization p * fourierNormalization p) * (η * x / y) ^ j.val := by
    change (fourierNormalization p * ζ ^ (a.val * j.val)) * η ^ j.val *
      star (fourierNormalization p * ζ ^ (b.val * j.val)) = _
    simp only [pow_mul, star_mul, star_normalization]
    change (fourierNormalization p * x ^ j.val) * η ^ j.val *
      (star (y ^ j.val) * fourierNormalization p) = _
    rw [star_pow, hstar]
    simp only [div_eq_mul_inv, mul_pow]
    ring
  have hsum :
      (∑ j : Fin p, fourierMatrix p a j * η ^ j.val * star (fourierMatrix p b j)) =
        (fourierNormalization p * fourierNormalization p) *
          (∑ j : Fin p, (η * x / y) ^ j.val) := by
    rw [Finset.mul_sum]
    exact Finset.sum_congr rfl (fun j _ => hterm j)
  rw [spectralMatrix_some_some_sum, hsum]
  calc
    _ = (fourierNormalization p * fourierNormalization p) *
        ((∑ j : Fin p, (η * x / y) ^ j.val) - 1) := by ring
    _ = (p : ℂ)⁻¹ * ((y - x) / (x - η⁻¹ * y)) := by
      rw [normalization_sq, geometric_quotient η x y hη0 hy hs hs1]
    _ = _ := by
      change _ = (y - x) / ((p : ℂ) * (x - η⁻¹ * y))
      simp only [div_eq_mul_inv, mul_inv]
      ring

theorem matrix_none_none (p : ℕ) [NeZero p] : matrix p none none = 0 :=
  spectralMatrix_none_none _

theorem matrix_some_none {p : ℕ} [NeZero p] (a : Fin p) :
    matrix p (some a) none = fourierNormalization p := spectralMatrix_some_none _ a

theorem matrix_none_some {p : ℕ} [NeZero p] (b : Fin p) :
    matrix p none (some b) = fourierNormalization p := spectralMatrix_none_some _ b

theorem matrix_some_some {p : ℕ} [NeZero p] (hp : 3 ≤ p) (a b : Fin p) :
    matrix p (some a) (some b) =
      (fourierRoot p ^ b.val - fourierRoot p ^ a.val) /
        ((p : ℂ) * (fourierRoot p ^ a.val -
          (fourierRoot (p - 1))⁻¹ * fourierRoot p ^ b.val)) :=
  spectralMatrix_some_some hp (fourierRoot_isPrimitiveRoot (p - 1) (by omega)) a b

end P14BalancedSpectralEntries

end
end

section

/-! Natural-power obstructions for the balanced bordered Cauchy construction.
The two finite node families may overlap. Their injectivity is needed later
for polynomial root counting, but not for the power obstructions proved here.
No matrix rank or simultaneous genericity premise is used. -/

namespace P14BalancedRootOrder

open scoped BigOperators

variable {K : Type*} [Field K]

theorem root_ne_zero {p : ℕ} {x : K} (hp : 0 < p) (hx : x ^ p = 1) : x ≠ 0 := by
  intro hzero
  rw [hzero, zero_pow (Nat.ne_of_gt hp)] at hx
  exact zero_ne_one hx

theorem pow_is_root {p : ℕ} {x : K} (hx : x ^ p = 1) (a : ℕ) :
    (x ^ a) ^ p = 1 := by
  rw [pow_right_comm, hx, one_pow]

/-- Consecutive positive root orders have only the identity in common. -/
theorem consecutive_roots_eq_one {p : ℕ} {x : K} (hp : 0 < p)
    (hx : x ^ p = 1) (hprev : x ^ (p - 1) = 1) : x = 1 := by
  have hpow : x ^ p = x := by
    calc
      x ^ p = x ^ (p - 1 + 1) := by
        rw [Nat.sub_one_add_one (Nat.ne_of_gt hp)]
      _ = x := by rw [pow_succ, hprev, one_mul]
  exact hpow.symm.trans hx

theorem primitive_ne_zero {p : ℕ} {c : K} (hp : 3 ≤ p)
    (hc : IsPrimitiveRoot c (p - 1)) : c ≠ 0 :=
  hc.ne_zero (by omega)

theorem primitive_ne_one {p : ℕ} {c : K} (hp : 3 ≤ p)
    (hc : IsPrimitiveRoot c (p - 1)) : c ≠ 1 :=
  hc.ne_one (by omega)

theorem one_sub_ne_zero {p : ℕ} {c : K} (hp : 3 ≤ p)
    (hc : IsPrimitiveRoot c (p - 1)) : 1 - c ≠ 0 := by
  intro hzero
  exact primitive_ne_one hp hc (sub_eq_zero.mp hzero).symm

/-- This includes x=y: only the differently scaled equality is excluded. -/
theorem sub_mul_ne_zero {p : ℕ} {c x y : K} (hp : 3 ≤ p)
    (hc : IsPrimitiveRoot c (p - 1)) (hx : x ^ p = 1) (hy : y ^ p = 1) :
    x - c * y ≠ 0 := by
  intro hzero
  have hxy : x = c * y := sub_eq_zero.mp hzero
  have hpow := congrArg (fun z : K => z ^ p) hxy
  rw [hx, mul_pow, hy, mul_one] at hpow
  exact primitive_ne_one hp hc
    (consecutive_roots_eq_one (by omega) hpow.symm hc.pow_eq_one)

/-- The strict exponent range is essential; the endpoint p-1 is excluded. -/
theorem pow_mul_sub_ne_zero {p a : ℕ} {c X Y : K} (hp : 3 ≤ p)
    (hc : IsPrimitiveRoot c (p - 1)) (ha0 : 0 < a) (ha : a < p - 1)
    (hX : X ^ p = 1) (hY : Y ^ p = 1) : c ^ a * Y - X ≠ 0 := by
  intro hzero
  have hxy : c ^ a * Y = X := sub_eq_zero.mp hzero
  have hpow := congrArg (fun z : K => z ^ p) hxy
  rw [mul_pow, hY, hX, mul_one] at hpow
  have hprev : (c ^ a) ^ (p - 1) = 1 := pow_is_root hc.pow_eq_one a
  have hone : c ^ a = 1 := consecutive_roots_eq_one (by omega) hpow hprev
  exact hc.pow_ne_one_of_pos_of_lt (Nat.ne_of_gt ha0) ha hone

theorem prod_pow_eq_one {ι : Type*} {p : ℕ} (S : Finset ι) (x : ι → K)
    (hx : ∀ i ∈ S, x i ^ p = 1) : (∏ i ∈ S, x i) ^ p = 1 := by
  calc
    (∏ i ∈ S, x i) ^ p = ∏ i ∈ S, x i ^ p := (Finset.prod_pow S p x).symm
    _ = ∏ _i ∈ S, (1 : K) := Finset.prod_congr rfl hx
    _ = 1 := Finset.prod_const_one

theorem prod_ne_zero_of_roots {ι : Type*} {p : ℕ} (hp : 0 < p)
    (S : Finset ι) (x : ι → K) (hx : ∀ i ∈ S, x i ^ p = 1) :
    (∏ i ∈ S, x i) ≠ 0 :=
  root_ne_zero hp (prod_pow_eq_one S x hx)

theorem fintype_prod_pow_eq_one {ι : Type*} [Fintype ι] {p : ℕ}
    (x : ι → K) (hx : ∀ i, x i ^ p = 1) : (∏ i, x i) ^ p = 1 :=
  prod_pow_eq_one Finset.univ x (fun i _ => hx i)

theorem fintype_prod_ne_zero_of_roots {ι : Type*} [Fintype ι] {p : ℕ}
    (hp : 0 < p) (x : ι → K) (hx : ∀ i, x i ^ p = 1) : (∏ i, x i) ≠ 0 :=
  root_ne_zero hp (fintype_prod_pow_eq_one x hx)

/-- The finite row and column sets have independent index types and sizes. -/
theorem finset_pow_mul_prod_sub_prod_ne_zero {ι κ : Type*} {p a : ℕ} {c : K}
    (hp : 3 ≤ p) (hc : IsPrimitiveRoot c (p - 1))
    (S : Finset ι) (T : Finset κ) (x : ι → K) (y : κ → K)
    (hx : ∀ i ∈ S, x i ^ p = 1) (hy : ∀ j ∈ T, y j ^ p = 1)
    (ha0 : 0 < a) (ha : a < p - 1) :
    c ^ a * (∏ j ∈ T, y j) - (∏ i ∈ S, x i) ≠ 0 :=
  pow_mul_sub_ne_zero hp hc ha0 ha (prod_pow_eq_one S x hx) (prod_pow_eq_one T y hy)

theorem pow_mul_prod_sub_prod_ne_zero {ι κ : Type*} [Fintype ι] [Fintype κ]
    {p a : ℕ} {c : K} (hp : 3 ≤ p) (hc : IsPrimitiveRoot c (p - 1))
    (x : ι → K) (y : κ → K) (hx : ∀ i, x i ^ p = 1) (hy : ∀ j, y j ^ p = 1)
    (ha0 : 0 < a) (ha : a < p - 1) :
    c ^ a * (∏ j, y j) - (∏ i, x i) ≠ 0 :=
  pow_mul_sub_ne_zero hp hc ha0 ha
    (fintype_prod_pow_eq_one x hx) (fintype_prod_pow_eq_one y hy)

theorem powers_injective {p : ℕ} {ζ : K} (hζ : IsPrimitiveRoot ζ p) :
    Function.Injective (fun i : Fin p => ζ ^ i.val) := by
  intro i j hij
  apply Fin.ext
  exact hζ.pow_inj i.isLt j.isLt hij

theorem selected_powers_denominator_ne_zero {p : ℕ} {c ζ : K}
    (hp : 3 ≤ p) (hc : IsPrimitiveRoot c (p - 1)) (hζ : IsPrimitiveRoot ζ p)
    (i j : Fin p) : ζ ^ i.val - c * ζ ^ j.val ≠ 0 :=
  sub_mul_ne_zero hp hc (pow_is_root hζ.pow_eq_one i.val)
    (pow_is_root hζ.pow_eq_one j.val)

/-- Actual primitive-root powers discharge both product-root premises. -/
theorem selected_powers_numerator_ne_zero {ι κ : Type*} [Fintype ι] [Fintype κ]
    {p a : ℕ} {c ζ : K} (hp : 3 ≤ p) (hc : IsPrimitiveRoot c (p - 1))
    (hζ : IsPrimitiveRoot ζ p) (f : ι → Fin p) (g : κ → Fin p)
    (ha0 : 0 < a) (ha : a < p - 1) :
    c ^ a * (∏ j, ζ ^ (g j).val) - (∏ i, ζ ^ (f i).val) ≠ 0 :=
  pow_mul_prod_sub_prod_ne_zero hp hc (fun i => ζ ^ (f i).val)
    (fun j => ζ ^ (g j).val) (fun i => pow_is_root hζ.pow_eq_one (f i).val)
    (fun j => pow_is_root hζ.pow_eq_one (g j).val) ha0 ha

end P14BalancedRootOrder

end

section

/-! The actual balanced identity-plus-unitary-column family. One fixed
equivalence reindexes the matrix on both axes. These pairing and whole-half
rank results do not assert the separate selected-spanning theorem. -/

noncomputable section
namespace P14BalancedPhysicalFamily

open Matrix P14FourierSpectralWeights P14BalancedSpectralEntries
open P14BalancedRootOrder
open scoped BigOperators

theorem matrix_entry_eq_zero_iff {p : ℕ} [NeZero p] (hp : 3 ≤ p)
    (i j : Option (Fin p)) : P14BalancedSpectralMatrix.matrix p i j = 0 ↔ i = j := by
  have hρ := fourierNormalization_ne_zero p (by omega)
  cases i with
  | none =>
    cases j <;> simp [matrix_none_none, matrix_none_some, hρ]
  | some a =>
    cases j with
    | none => simp [matrix_some_none, hρ]
    | some b =>
      have hζ := fourierRoot_isPrimitiveRoot p (by omega)
      have hc : IsPrimitiveRoot (fourierRoot (p - 1))⁻¹ (p - 1) :=
        (fourierRoot_isPrimitiveRoot (p - 1) (by omega)).inv
      have hd : (p : ℂ) * (fourierRoot p ^ a.val -
          (fourierRoot (p - 1))⁻¹ * fourierRoot p ^ b.val) ≠ 0 :=
        mul_ne_zero (Nat.cast_ne_zero.mpr (by omega))
          (selected_powers_denominator_ne_zero hp hc hζ a b)
      rw [matrix_some_some hp]
      constructor
      · intro h
        have hnum := (div_eq_zero_iff.mp h).resolve_right hd
        have hba : b = a := powers_injective hζ (sub_eq_zero.mp hnum)
        exact congrArg some hba.symm
      · intro h
        have hab : a = b := Option.some.inj h
        subst b
        simp

def finMatrix (p : ℕ) [NeZero p] : Matrix (Fin (p + 1)) (Fin (p + 1)) ℂ :=
  fun i j => P14BalancedSpectralMatrix.matrix p (finSuccEquiv p i) (finSuccEquiv p j)

theorem finMatrix_entry_eq_zero_iff {p : ℕ} [NeZero p] (hp : 3 ≤ p)
    (i j : Fin (p + 1)) : finMatrix p i j = 0 ↔ i = j := by
  rw [finMatrix, matrix_entry_eq_zero_iff hp]
  exact (finSuccEquiv p).injective.eq_iff

theorem finMatrix_columns_gram {p : ℕ} [NeZero p] (hp : 3 ≤ p)
    (i j : Fin (p + 1)) :
    (∑ q, star (finMatrix p q i) * finMatrix p q j) = if i = j then 1 else 0 := by
  calc
    _ = ∑ q : Option (Fin p),
        star (P14BalancedSpectralMatrix.matrix p q (finSuccEquiv p i)) *
          P14BalancedSpectralMatrix.matrix p q (finSuccEquiv p j) :=
      (finSuccEquiv p).sum_comp _
    _ = _ := by
      rw [P14BalancedSpectralMatrix.columns_gram hp]
      by_cases hij : i = j
      · subst j
        simp
      · rw [if_neg ((finSuccEquiv p).injective.ne hij), if_neg hij]

theorem finMatrix_unitary {p : ℕ} [NeZero p] (hp : 3 ≤ p) :
    finMatrix p ∈ Matrix.unitaryGroup (Fin (p + 1)) ℂ := by
  apply Matrix.mem_unitaryGroup_iff'.mpr
  ext i j
  change (∑ q, star (finMatrix p q i) * finMatrix p q j) = if i = j then 1 else 0
  exact finMatrix_columns_gram hp i j

theorem columns_linearIndependent {p : ℕ} [NeZero p] (hp : 3 ≤ p) :
    LinearIndependent ℂ (fun j : Fin (p + 1) => fun q => finMatrix p q j) := by
  let u : unitary (Matrix (Fin (p + 1)) (Fin (p + 1)) ℂ) :=
    ⟨finMatrix p, finMatrix_unitary hp⟩
  have hu : IsUnit (finMatrix p) := Unitary.isUnit_coe (U := u)
  exact Matrix.linearIndependent_cols_iff_isUnit.mpr hu

theorem columns_span {p : ℕ} [NeZero p] (hp : 3 ≤ p) :
    Submodule.span ℂ (Set.range (fun j : Fin (p + 1) => fun q => finMatrix p q j)) = ⊤ := by
  exact (columns_linearIndependent hp).span_eq_top_of_card_eq_finrank (by simp)

def family (p : ℕ) [NeZero p] :
    (Fin (p + 1) ⊕ Fin (p + 1)) → Fin (p + 1) → ℂ
  | Sum.inl a, q => if q = a then 1 else 0
  | Sum.inr b, q => finMatrix p q b

theorem a_pairing {p : ℕ} [NeZero p] (a b : Fin (p + 1)) :
    (∑ q, star (family p (Sum.inl a) q) * family p (Sum.inl b) q) =
      if a = b then 1 else 0 := by
  by_cases hab : a = b
  · subst b
    simp [family, ite_mul, mul_ite]
  · simp [family, ite_mul, mul_ite, hab, Ne.symm hab]

theorem b_pairing {p : ℕ} [NeZero p] (hp : 3 ≤ p) (a b : Fin (p + 1)) :
    (∑ q, star (family p (Sum.inr a) q) * family p (Sum.inr b) q) =
      if a = b then 1 else 0 :=
  finMatrix_columns_gram hp a b

theorem ab_pairing {p : ℕ} [NeZero p] (a b : Fin (p + 1)) :
    (∑ q, star (family p (Sum.inl a) q) * family p (Sum.inr b) q) =
      finMatrix p a b := by
  simp [family, ite_mul, mul_ite]

theorem ba_pairing {p : ℕ} [NeZero p] (a b : Fin (p + 1)) :
    (∑ q, star (family p (Sum.inr a) q) * family p (Sum.inl b) q) =
      star (finMatrix p b a) := by
  simp [family, ite_mul, mul_ite]

theorem family_ne_zero {p : ℕ} [NeZero p] (hp : 3 ≤ p)
    (i : Fin (p + 1) ⊕ Fin (p + 1)) : family p i ≠ 0 := by
  cases i with
  | inl a =>
    intro h
    have hbad : (1 : ℂ) = 0 := by simpa [family] using congrFun h a
    exact one_ne_zero hbad
  | inr b =>
    intro h
    have hzero : ∀ q, family p (Sum.inr b) q = 0 := fun q => congrFun h q
    have hbad : (0 : ℂ) = 1 := by simpa [hzero] using b_pairing hp b b
    exact zero_ne_one hbad

theorem b_linearIndependent {p : ℕ} [NeZero p] (hp : 3 ≤ p) :
    LinearIndependent ℂ (fun b : Fin (p + 1) => family p (Sum.inr b)) :=
  columns_linearIndependent hp

theorem b_span {p : ℕ} [NeZero p] (hp : 3 ≤ p) :
    Submodule.span ℂ (Set.range (fun b : Fin (p + 1) => family p (Sum.inr b))) = ⊤ :=
  columns_span hp

def balancedRelation {p : ℕ} :
    (Fin (p + 1) ⊕ Fin (p + 1)) → (Fin (p + 1) ⊕ Fin (p + 1)) → Prop
  | Sum.inl a, Sum.inl b => a ≠ b
  | Sum.inr a, Sum.inr b => a ≠ b
  | Sum.inl a, Sum.inr b => a = b
  | Sum.inr a, Sum.inl b => a = b

theorem pairing_eq_zero_iff {p : ℕ} [NeZero p] (hp : 3 ≤ p)
    (i j : Fin (p + 1) ⊕ Fin (p + 1)) :
    (∑ q, star (family p i q) * family p j q) = 0 ↔ balancedRelation i j := by
  cases i with
  | inl a =>
    cases j with
    | inl b =>
      rw [a_pairing]
      simp [balancedRelation]
    | inr b =>
      simpa only [ab_pairing, balancedRelation] using finMatrix_entry_eq_zero_iff hp a b
  | inr a =>
    cases j with
    | inl b =>
      rw [ba_pairing, star_eq_zero, finMatrix_entry_eq_zero_iff hp]
      exact eq_comm
    | inr b =>
      rw [b_pairing hp]
      simp [balancedRelation]

theorem pairing_zero {p : ℕ} [NeZero p] (hp : 3 ≤ p)
    (i j : Fin (p + 1) ⊕ Fin (p + 1)) (hij : balancedRelation i j) :
    (∑ q, star (family p i q) * family p j q) = 0 :=
  (pairing_eq_zero_iff hp i j).mpr hij

end P14BalancedPhysicalFamily

end
end

section

/-! The unbordered square Cauchy kernel is trivial when the actual product
obstruction is nonzero. The primitive-root wrapper proves that obstruction
and every denominator condition from separate row/column root data. -/

noncomputable section
namespace P14CauchyUnborderedKernel

open Polynomial P14CauchyKernelPolynomial P14PolynomialRootInterpolation
open scoped BigOperators

variable {K : Type*} [Field K]

theorem kernel_eq_zero {r : ℕ} (hr : 2 ≤ r) (c : K) (x y v : Fin r → K)
    (hc : c ≠ 0) (hc1 : c ≠ 1) (hy : ∀ j, y j ≠ 0)
    (hxinj : Function.Injective x) (hyinj : Function.Injective y)
    (hd : ∀ i j, x i - c * y j ≠ 0)
    (hsep : c ^ (r - 1) * (∏ j, y j) ≠ ∏ i, x i)
    (hrow : ∀ i, (∑ j, ((y j - x i) / (x i - c * y j)) * v j) = 0) :
    ∀ j, v j = 0 := by
  let P : K[X] := C (1 - c) * N c y v - C (sigma v) * Q c y
  have hdegree : P.natDegree ≤ r := by
    apply (natDegree_sub_le _ _).trans
    apply max_le
    · exact (natDegree_C_mul_le _ _).trans ((N_natDegree_le c y v).trans (by omega))
    · exact (natDegree_C_mul_le _ _).trans (le_of_eq (Q_natDegree c y))
  have hcoeff : P.coeff r = -sigma v := by
    simp only [P, coeff_sub, coeff_C_mul, N_coeff_eq_zero c y v (by omega) le_rfl,
      Q_coeff_top, mul_zero, mul_one, zero_sub]
  have heval : ∀ i, P.eval (x i) = 0 :=
    fun i => row_zero_imp c y v (x i) (hd i) (hrow i)
  have hP : P = C (-sigma v) * rootPolynomial x :=
    eq_C_mul_rootPolynomial x hxinj (by omega) P (-sigma v) hdegree hcoeff heval
  have hA : rootPolynomial x = Q (1 : K) x := by
    simp only [rootPolynomial, Q, one_mul]
  have hzero := congrArg (Polynomial.eval (0 : K)) hP
  rw [hA] at hzero
  simp only [P, eval_sub, eval_C_mul, eval_N_zero, eval_Q_zero] at hzero
  have hpred : r - 1 + 1 = r := by omega
  have hsigned : (-c) ^ (r - 1) = (-1 : K) ^ (r - 1) * c ^ (r - 1) := by
    calc
      _ = ((-1 : K) * c) ^ (r - 1) := by rw [neg_one_mul]
      _ = _ := mul_pow _ _ _
  have hpowR : (-c) ^ r = ((-1 : K) ^ (r - 1) * c ^ (r - 1)) * (-c) := by
    calc
      _ = (-c) ^ (r - 1 + 1) := by rw [hpred]
      _ = _ := by rw [pow_succ, hsigned]
  have hepsR : (-1 : K) ^ r = (-1 : K) ^ (r - 1) * (-1 : K) := by
    calc
      _ = (-1 : K) ^ (r - 1 + 1) := by rw [hpred]
      _ = _ := pow_succ _ _
  rw [hsigned, hpowR, hepsR] at hzero
  have hproduct : (-1 : K) ^ (r - 1) *
      (sigma v * (c ^ (r - 1) * (∏ j, y j) - ∏ i, x i)) = 0 := by
    convert sub_eq_zero.mpr hzero using 1 <;> ring
  have heps : (-1 : K) ^ (r - 1) ≠ 0 :=
    pow_ne_zero _ (neg_ne_zero.mpr one_ne_zero)
  have hsigma : sigma v = 0 :=
    (mul_eq_zero.mp ((mul_eq_zero.mp hproduct).resolve_left heps)).resolve_right
      (sub_ne_zero.mpr hsep)
  have hPzero : P = 0 := by
    rw [hP, hsigma, neg_zero, C_0, zero_mul]
  have hmul : C (1 - c) * N c y v = 0 := by
    simpa only [P, hsigma, C_0, zero_mul, sub_zero] using hPzero
  have hN : N c y v = 0 :=
    (mul_eq_zero.mp hmul).resolve_left
      (C_ne_zero.mpr (sub_ne_zero.mpr (Ne.symm hc1)))
  exact N_eq_zero_imp c y v hc hy hyinj hN

/-- Actual consecutive root orders discharge every scalar noncancellation
premise; row and column lists remain separately injective and may overlap. -/
theorem kernel_eq_zero_of_roots {p r : ℕ} (hp : 3 ≤ p) (hr : 2 ≤ r) (hrp : r < p)
    (c : K) (x y v : Fin r → K) (hc : IsPrimitiveRoot c (p - 1))
    (hx : ∀ i, x i ^ p = 1) (hy : ∀ j, y j ^ p = 1)
    (hxinj : Function.Injective x) (hyinj : Function.Injective y)
    (hrow : ∀ i, (∑ j, ((y j - x i) / (x i - c * y j)) * v j) = 0) :
    ∀ j, v j = 0 := by
  apply kernel_eq_zero hr c x y v
    (P14BalancedRootOrder.primitive_ne_zero hp hc)
    (P14BalancedRootOrder.primitive_ne_one hp hc)
    (fun j => P14BalancedRootOrder.root_ne_zero (by omega) (hy j)) hxinj hyinj
    (fun i j => P14BalancedRootOrder.sub_mul_ne_zero hp hc (hx i) (hy j))
    ?_ hrow
  exact sub_ne_zero.mp (P14BalancedRootOrder.pow_mul_prod_sub_prod_ne_zero
    hp hc x y hx hy (by omega) (by omega))

end P14CauchyUnborderedKernel

end
end

section

/-! Kernel injectivity for the two one-border square Cauchy matrices.
Only the border-row case needs nonzero row nodes, to adjoin the extra root 0.
Row and column node lists may overlap; actual denominators remain explicit. -/

noncomputable section
namespace P14CauchyOneBorderKernel

open Polynomial P14CauchyKernelPolynomial P14PolynomialRootInterpolation
open scoped BigOperators

variable {K : Type*} [Field K]

/-- The first equation is the all-ones border row. -/
theorem border_row_kernel {r : ℕ} (hr : 2 ≤ r) (c : K)
    (x : Fin (r - 1) → K) (y v : Fin r → K)
    (hc : c ≠ 0) (hc1 : 1 - c ≠ 0)
    (hx : Function.Injective x) (hx0 : ∀ i, x i ≠ 0)
    (hy : Function.Injective y) (hy0 : ∀ j, y j ≠ 0)
    (hd : ∀ i j, x i - c * y j ≠ 0)
    (hsigma : sigma v = 0)
    (hrow : ∀ i, (∑ j, ((y j - x i) / (x i - c * y j)) * v j) = 0) :
    ∀ j, v j = 0 := by
  have hNx (i : Fin (r - 1)) : (N c y v).eval (x i) = 0 := by
    have h := row_zero_imp c y v (x i) (hd i) (hrow i)
    have hmul : (1 - c) * (N c y v).eval (x i) = 0 := by
      simpa only [eval_sub, eval_C_mul, hsigma, zero_mul, sub_zero] using h
    exact (mul_eq_zero.mp hmul).resolve_left hc1
  have hN0 : (N c y v).eval 0 = 0 := by
    rw [eval_N_zero, hsigma, mul_zero]
  let z : Fin ((r - 1) + 1) → K := Fin.cons (0 : K) x
  have hnot : (0 : K) ∉ Set.range x := by
    rintro ⟨i, hi⟩
    exact hx0 i hi
  have hz : Function.Injective z := Fin.cons_injective_of_injective hnot hx
  have hdegree : (N c y v).natDegree < (r - 1) + 1 := by
    have hcount : (r - 1) + 1 = r := by omega
    rw [hcount]
    have hN := N_natDegree_le c y v
    omega
  have heval : ∀ i, (N c y v).eval (z i) = 0 := by
    intro i
    refine Fin.cases ?_ (fun j => ?_) i
    · change (N c y v).eval 0 = 0
      exact hN0
    · change (N c y v).eval (x j) = 0
      exact hNx j
  have hN : N c y v = 0 := zero_of_eval z hz (N c y v) hdegree heval
  exact N_eq_zero_imp c y v hc hy0 hy hN

/-- The first unknown coefficient belongs to the all-ones border column. -/
theorem border_column_kernel {r : ℕ} (hr : 2 ≤ r) (c : K)
    (x : Fin r → K) (y v : Fin (r - 1) → K) (alpha : K)
    (hc : c ≠ 0) (hc1 : 1 - c ≠ 0)
    (hx : Function.Injective x) (hy : Function.Injective y) (hy0 : ∀ j, y j ≠ 0)
    (hd : ∀ i j, x i - c * y j ≠ 0)
    (hrow : ∀ i, alpha + (∑ j, ((y j - x i) / (x i - c * y j)) * v j) = 0) :
    alpha = 0 ∧ ∀ j, v j = 0 := by
  let P : K[X] := C (alpha - sigma v) * Q c y + C (1 - c) * N c y v
  have hdegree : P.natDegree ≤ r - 1 := by
    dsimp only [P]
    apply (natDegree_add_le _ _).trans
    apply max_le
    · exact (natDegree_C_mul_le _ _).trans (le_of_eq (Q_natDegree c y))
    · exact (natDegree_C_mul_le _ _).trans
        ((N_natDegree_le c y v).trans (Nat.sub_le _ _))
  have heval (i : Fin r) : P.eval (x i) = 0 := by
    calc
      P.eval (x i) = (Q c y).eval (x i) *
          (alpha + ∑ j, ((y j - x i) / (x i - c * y j)) * v j) := by
        simp only [P, eval_add, eval_C_mul]
        rw [mul_add, row_clear c y v (x i) (hd i)]
        ring
      _ = 0 := by rw [hrow i, mul_zero]
  have hP : P = 0 := zero_of_eval x hx P (by omega) heval
  have hNpole (j : Fin (r - 1)) : (N c y v).eval (c * y j) = 0 := by
    have h := congrArg (Polynomial.eval (c * y j)) hP
    have hmul : (1 - c) * (N c y v).eval (c * y j) = 0 := by
      simpa only [P, eval_add, eval_C_mul, eval_Q_pole, mul_zero, zero_add,
        eval_zero] using h
    exact (mul_eq_zero.mp hmul).resolve_left hc1
  have hcy : Function.Injective (fun j : Fin (r - 1) => c * y j) := by
    intro i j hij
    exact hy (mul_left_cancel₀ hc hij)
  have hNdegree : (N c y v).natDegree < r - 1 := by
    have hN := N_natDegree_le c y v
    omega
  have hN : N c y v = 0 :=
    zero_of_eval (fun j => c * y j) hcy (N c y v) hNdegree hNpole
  have hv : ∀ j, v j = 0 := N_eq_zero_imp c y v hc hy0 hy hN
  refine ⟨?_, hv⟩
  have hfirst := hrow ⟨0, by omega⟩
  simpa only [hv, mul_zero, Finset.sum_const_zero, add_zero] using hfirst

end P14CauchyOneBorderKernel

end
end

section

/-! Kernel injectivity for the square Cauchy selection containing both borders.
The total matrix size is t+1. The leading scalar is allowed to vanish; the
polynomial identity is obtained before its nonvanishing obstruction is used. -/

noncomputable section
namespace P14CauchyBothBordersKernel
open Polynomial
open P14CauchyKernelPolynomial P14PolynomialRootInterpolation
open scoped BigOperators
variable {K : Type*} [Field K]

theorem kernel_eq_zero {t : ℕ} (ht : 1 ≤ t) (c α : K) (x y v : Fin t → K)
    (hc : c ≠ 0) (hc1 : 1 - c ≠ 0) (hy : ∀ j, y j ≠ 0)
    (hxinj : Function.Injective x) (hyinj : Function.Injective y)
    (hd : ∀ i j, x i - c * y j ≠ 0)
    (hsep : c ^ t * (∏ j, y j) - (∏ i, x i) ≠ 0)
    (hs : sigma v = 0)
    (hrow : ∀ i, α + (∑ j, ((y j - x i) / (x i - c * y j)) * v j) = 0) :
    α = 0 ∧ ∀ j, v j = 0 := by
  let P : K[X] := C α * Q c y + C (1 - c) * N c y v
  have hdegree : P.natDegree ≤ t := by
    apply (natDegree_add_le _ _).trans
    apply max_le
    · exact (natDegree_C_mul_le _ _).trans (le_of_eq (Q_natDegree c y))
    · exact (natDegree_C_mul_le _ _).trans
        ((N_natDegree_le c y v).trans (Nat.sub_le _ _))
  have hcoeff : P.coeff t = α := by
    simp only [P, coeff_add, coeff_C_mul, Q_coeff_top,
      N_coeff_eq_zero c y v ht (le_refl t), mul_one, mul_zero, add_zero]
  have hroots : ∀ i, P.eval (x i) = 0 := by
    intro i
    have hclear := row_clear c y v (x i) (hd i)
    rw [hs, zero_mul, sub_zero] at hclear
    have hm := congrArg (fun z : K => (Q c y).eval (x i) * z) (hrow i)
    rw [mul_add, hclear, mul_zero] at hm
    simpa only [P, eval_add, eval_C_mul, mul_comm ((Q c y).eval (x i)) α] using hm
  have hid : P = C α * rootPolynomial x :=
    eq_C_mul_rootPolynomial x hxinj (by omega) P α hdegree hcoeff hroots
  have hroot0 : (rootPolynomial x).eval 0 = (-1 : K) ^ t * ∏ i, x i := by
    have hA : rootPolynomial x = Q (1 : K) x := by
      simp only [rootPolynomial, Q, one_mul]
    rw [hA, eval_Q_zero]
  have heval := congrArg (Polynomial.eval 0) hid
  simp only [P, eval_add, eval_C_mul, eval_Q_zero, eval_N_zero, hs,
    mul_zero, add_zero, hroot0] at heval
  have hsign : (-c) ^ t = (-1 : K) ^ t * c ^ t := by
    rw [← mul_pow, neg_one_mul]
  have hz : (-1 : K) ^ t * (α * (c ^ t * (∏ j, y j) - ∏ i, x i)) = 0 := by
    calc
      _ = α * ((-c) ^ t * ∏ j, y j) - α * ((-1 : K) ^ t * ∏ i, x i) := by
        rw [hsign]
        ring
      _ = 0 := sub_eq_zero.mpr heval
  have ha : α = 0 :=
    (mul_eq_zero.mp ((mul_eq_zero.mp hz).resolve_left
      (pow_ne_zero t (neg_ne_zero.mpr one_ne_zero)))).resolve_right hsep
  have hN : N c y v = 0 := by
    simp only [P, ha, C_0, zero_mul, zero_add] at hid
    exact (mul_eq_zero.mp hid).resolve_left (C_ne_zero.mpr hc1)
  exact ⟨ha, N_eq_zero_imp c y v hc hy hyinj hN⟩

theorem kernel_eq_zero_of_roots {p t : ℕ} (hp : 3 ≤ p) (ht : 1 ≤ t)
    (htp : t < p - 1) (c α : K) (hc : IsPrimitiveRoot c (p - 1))
    (x y v : Fin t → K) (hx : ∀ i, x i ^ p = 1) (hy : ∀ j, y j ^ p = 1)
    (hxinj : Function.Injective x) (hyinj : Function.Injective y)
    (hs : sigma v = 0)
    (hrow : ∀ i, α + (∑ j, ((y j - x i) / (x i - c * y j)) * v j) = 0) :
    α = 0 ∧ ∀ j, v j = 0 := by
  exact kernel_eq_zero ht c α x y v (P14BalancedRootOrder.primitive_ne_zero hp hc)
    (P14BalancedRootOrder.one_sub_ne_zero hp hc)
    (fun j => P14BalancedRootOrder.root_ne_zero (by omega) (hy j)) hxinj hyinj
    (fun i j => P14BalancedRootOrder.sub_mul_ne_zero hp hc (hx i) (hy j))
    (P14BalancedRootOrder.pow_mul_prod_sub_prod_ne_zero hp hc x y hx hy (by omega) htp)
    hs hrow

end P14CauchyBothBordersKernel

end
end

section

/-! Right kernels of actual selected square submatrices of the balanced
spectral matrix. The range is 2 ≤ r < p; endpoint minors are not asserted.
Column permutations transport the unknown coefficients, and the diagonal
scaling uses v / B before invoking the four Cauchy kernel theorems. -/

noncomputable section
namespace P14BalancedSelectedKernel

open P14FourierSpectralWeights P14BalancedSpectralMatrix
open P14BalancedSpectralEntries P14BalancedRootOrder
open scoped BigOperators

def rowScale (p : ℕ) : Option (Fin p) → ℂ
  | none => (fourierNormalization p)⁻¹
  | some _ => (p : ℂ)

def columnScale (p : ℕ) : Option (Fin p) → ℂ
  | none => fourierNormalization p
  | some _ => 1

def cauchyEntry (p : ℕ) : Option (Fin p) → Option (Fin p) → ℂ
  | none, none => 0
  | none, some _ => 1
  | some _, none => 1
  | some a, some b =>
      (fourierRoot p ^ b.val - fourierRoot p ^ a.val) /
        (fourierRoot p ^ a.val - (fourierRoot (p - 1))⁻¹ * fourierRoot p ^ b.val)

theorem columnScale_ne_zero {p : ℕ} (hp : 0 < p) (i : Option (Fin p)) :
    columnScale p i ≠ 0 := by
  cases i with
  | none => exact fourierNormalization_ne_zero p hp
  | some a => exact one_ne_zero

theorem scaled_matrix {p : ℕ} [NeZero p] (hp : 3 ≤ p)
    (i j : Option (Fin p)) :
    rowScale p i * matrix p i j * columnScale p j = cauchyEntry p i j := by
  have hpC : (p : ℂ) ≠ 0 := Nat.cast_ne_zero.mpr (by omega)
  have hnorm := fourierNormalization_ne_zero p (by omega)
  cases i with
  | none =>
    cases j with
    | none => simp only [rowScale, columnScale, cauchyEntry, matrix_none_none,
        mul_zero, zero_mul]
    | some b =>
      simp only [rowScale, columnScale, cauchyEntry, matrix_none_some, mul_one]
      exact inv_mul_cancel₀ hnorm
  | some a =>
    cases j with
    | none =>
      simp only [rowScale, columnScale, cauchyEntry, matrix_some_none]
      rw [mul_assoc, normalization_sq, mul_inv_cancel₀ hpC]
    | some b =>
      simp only [rowScale, columnScale, cauchyEntry, matrix_some_some hp, mul_one]
      rw [← mul_div_assoc, mul_div_mul_left _ _ hpC]

/-- An injective selection either avoids the border or has one border,
which is moved to zero by an actual permutation of its index type. -/
private theorem classify_selection {α : Type*} {t : ℕ}
    (f : Fin (t + 1) → Option α) (hf : Function.Injective f) :
    (∃ a : Fin (t + 1) → α, Function.Injective a ∧ ∀ i, f i = some (a i)) ∨
    ∃ (E : Fin (t + 1) ≃ Fin (t + 1)) (a : Fin t → α),
      Function.Injective a ∧ f (E 0) = none ∧
        ∀ i, f (E i.succ) = some (a i) := by
  classical
  by_cases hb : ∃ i, f i = none
  · obtain ⟨i₀, hi₀⟩ := hb
    let E : Fin (t + 1) ≃ Fin (t + 1) := Equiv.swap 0 i₀
    have hzero : f (E 0) = none := by
      simpa only [E, Equiv.swap_apply_left] using hi₀
    have hnot (i : Fin t) : f (E i.succ) ≠ none := by
      intro h
      exact Fin.succ_ne_zero i (E.injective (hf (h.trans hzero.symm)))
    have hex : ∀ i : Fin t, ∃ a : α, f (E i.succ) = some a := by
      intro i
      cases hi : f (E i.succ) with
      | none => exact (hnot i hi).elim
      | some a => exact ⟨a, rfl⟩
    choose a ha using hex
    refine Or.inr ⟨E, a, ?_, hzero, ha⟩
    intro i j hij
    apply Fin.succ_injective t
    apply E.injective
    apply hf
    rw [ha i, ha j, hij]
  · have hex : ∀ i : Fin (t + 1), ∃ a : α, f i = some a := by
      intro i
      cases hi : f i with
      | none => exact (hb ⟨i, hi⟩).elim
      | some a => exact ⟨a, rfl⟩
    choose a ha using hex
    refine Or.inl ⟨a, ?_, ha⟩
    intro i j hij
    apply hf
    rw [ha i, ha j, hij]

/-- The four border cases for the explicitly scaled entries. -/
theorem cauchy_selected_kernel {p r : ℕ} (hp : 3 ≤ p) (hr : 2 ≤ r)
    (hrp : r < p) (R C : Fin r → Option (Fin p))
    (hR : Function.Injective R) (hC : Function.Injective C) (w : Fin r → ℂ)
    (hw : ∀ i, (∑ j, cauchyEntry p (R i) (C j) * w j) = 0) :
    ∀ j, w j = 0 := by
  classical
  let c : ℂ := (fourierRoot (p - 1))⁻¹
  have hc : IsPrimitiveRoot c (p - 1) :=
    (fourierRoot_isPrimitiveRoot (p - 1) (by omega)).inv
  have hζ := fourierRoot_isPrimitiveRoot p (by omega)
  have hroot (a : Fin p) : (fourierRoot p ^ a.val) ^ p = 1 :=
    pow_is_root hζ.pow_eq_one a.val
  have hzero (a : Fin p) : fourierRoot p ^ a.val ≠ 0 :=
    root_ne_zero (by omega) (hroot a)
  have hnode : Function.Injective (fun a : Fin p => fourierRoot p ^ a.val) :=
    powers_injective hζ
  have hd (a b : Fin p) : fourierRoot p ^ a.val - c * fourierRoot p ^ b.val ≠ 0 :=
    sub_mul_ne_zero hp hc (hroot a) (hroot b)
  cases r with
  | zero => omega
  | succ t =>
    rcases classify_selection R hR with ⟨a, ha, hRa⟩ | ⟨ER, a, ha, hR0, hRa⟩
    · rcases classify_selection C hC with ⟨b, hb, hCb⟩ | ⟨EC, b, hb, hC0, hCb⟩
      · apply P14CauchyUnborderedKernel.kernel_eq_zero_of_roots hp hr hrp c
          (fun i => fourierRoot p ^ (a i).val)
          (fun j => fourierRoot p ^ (b j).val) w hc
          (fun i => hroot (a i)) (fun j => hroot (b j))
          (hnode.comp ha) (hnode.comp hb)
        intro i
        simpa only [hRa, hCb, cauchyEntry, c] using hw i
      · have hreindex (i : Fin (t + 1)) :
            (∑ j, cauchyEntry p (R i) (C (EC j)) * w (EC j)) = 0 := by
          rw [Equiv.sum_comp EC (fun j => cauchyEntry p (R i) (C j) * w j)]
          exact hw i
        have hrows (i : Fin (t + 1)) : w (EC 0) +
            (∑ j : Fin t, ((fourierRoot p ^ (b j).val - fourierRoot p ^ (a i).val) /
              (fourierRoot p ^ (a i).val - c * fourierRoot p ^ (b j).val)) *
                w (EC j.succ)) = 0 := by
          have h := hreindex i
          rw [Fin.sum_univ_succ] at h
          simpa only [hRa, hC0, hCb, cauchyEntry, one_mul, c] using h
        obtain ⟨hw0, hwt⟩ := P14CauchyOneBorderKernel.border_column_kernel hr c
          (fun i => fourierRoot p ^ (a i).val)
          (fun j => fourierRoot p ^ (b j).val) (fun j => w (EC j.succ)) (w (EC 0))
          (primitive_ne_zero hp hc) (one_sub_ne_zero hp hc)
          (hnode.comp ha) (hnode.comp hb) (fun j => hzero (b j))
          (fun i j => hd (a i) (b j)) hrows
        intro j
        obtain ⟨q, rfl⟩ := EC.surjective j
        exact Fin.cases hw0 (fun l => hwt l) q
    · rcases classify_selection C hC with ⟨b, hb, hCb⟩ | ⟨EC, b, hb, hC0, hCb⟩
      · have hsigma : P14CauchyKernelPolynomial.sigma w = 0 := by
          simpa only [hR0, hCb, cauchyEntry, one_mul,
            P14CauchyKernelPolynomial.sigma] using hw (ER 0)
        apply P14CauchyOneBorderKernel.border_row_kernel hr c
          (fun i => fourierRoot p ^ (a i).val)
          (fun j => fourierRoot p ^ (b j).val) w
          (primitive_ne_zero hp hc) (one_sub_ne_zero hp hc)
          (hnode.comp ha) (fun i => hzero (a i))
          (hnode.comp hb) (fun j => hzero (b j))
          (fun i j => hd (a i) (b j)) hsigma
        intro i
        simpa only [hRa, hCb, cauchyEntry, c] using hw (ER i.succ)
      · have hreindex (i : Fin (t + 1)) :
            (∑ j, cauchyEntry p (R i) (C (EC j)) * w (EC j)) = 0 := by
          rw [Equiv.sum_comp EC (fun j => cauchyEntry p (R i) (C j) * w j)]
          exact hw i
        have hsigma : P14CauchyKernelPolynomial.sigma (fun j : Fin t => w (EC j.succ)) = 0 := by
          have h := hreindex (ER 0)
          rw [Fin.sum_univ_succ] at h
          simpa only [hR0, hC0, hCb, cauchyEntry, zero_mul, one_mul, zero_add,
            P14CauchyKernelPolynomial.sigma] using h
        have hrows (i : Fin t) : w (EC 0) +
            (∑ j : Fin t, ((fourierRoot p ^ (b j).val - fourierRoot p ^ (a i).val) /
              (fourierRoot p ^ (a i).val - c * fourierRoot p ^ (b j).val)) *
                w (EC j.succ)) = 0 := by
          have h := hreindex (ER i.succ)
          rw [Fin.sum_univ_succ] at h
          simpa only [hRa, hC0, hCb, cauchyEntry, one_mul, c] using h
        obtain ⟨hw0, hwt⟩ := P14CauchyBothBordersKernel.kernel_eq_zero_of_roots
          hp (show 1 ≤ t by omega) (show t < p - 1 by omega) c (w (EC 0)) hc
          (fun i => fourierRoot p ^ (a i).val)
          (fun j => fourierRoot p ^ (b j).val) (fun j => w (EC j.succ))
          (fun i => hroot (a i)) (fun j => hroot (b j))
          (hnode.comp ha) (hnode.comp hb) hsigma hrows
        intro j
        obtain ⟨q, rfl⟩ := EC.surjective j
        exact Fin.cases hw0 (fun l => hwt l) q

/-- The actual matrix, with all root-order and denominator premises discharged.
Row and column injections are separate and their images may overlap. -/
theorem selected_square_kernel {p r : ℕ} [NeZero p] (hp : 3 ≤ p)
    (hr : 2 ≤ r) (hrp : r < p) (R C : Fin r → Option (Fin p))
    (hR : Function.Injective R) (hC : Function.Injective C) (v : Fin r → ℂ)
    (hv : ∀ i, (∑ j, matrix p (R i) (C j) * v j) = 0) :
    ∀ j, v j = 0 := by
  let w : Fin r → ℂ := fun j => v j / columnScale p (C j)
  have hwrows (i : Fin r) : (∑ j, cauchyEntry p (R i) (C j) * w j) = 0 := by
    calc
      _ = rowScale p (R i) * (∑ j, matrix p (R i) (C j) * v j) := by
        rw [Finset.mul_sum]
        apply Finset.sum_congr rfl
        intro j _
        rw [← scaled_matrix hp]
        dsimp only [w]
        calc
          _ = (rowScale p (R i) * matrix p (R i) (C j)) *
              (columnScale p (C j) * (v j / columnScale p (C j))) := by ring
          _ = _ := by
            rw [mul_div_cancel₀ _ (columnScale_ne_zero (by omega) (C j))]
            ring
      _ = 0 := by rw [hv i, mul_zero]
  have hw := cauchy_selected_kernel hp hr hrp R C hR hC w hwrows
  intro j
  have h := congrArg (fun z : ℂ => z * columnScale p (C j)) (hw j)
  simpa only [w, div_mul_cancel₀ _ (columnScale_ne_zero (by omega) (C j)),
    zero_mul] using h

end P14BalancedSelectedKernel

end
end

section

/-! Identity coordinates together with actual selected matrix columns.
The kernel assumption concerns exactly the missing identity coordinates.
No conjugation or transpose is inserted into that right-kernel condition. -/

noncomputable section
namespace P14BasisPlusColumns
open Submodule
open scoped BigOperators

variable {α 𝕜 : Type*} [Fintype α] [DecidableEq α] [Field 𝕜]

def pairedFamily (U : α → α → 𝕜) : α ⊕ α → α → 𝕜
  | .inl a, q => if q = a then 1 else 0
  | .inr b, q => U q b

def selectedFamily (U : α → α → 𝕜) (a j : Finset α) :
    a ⊕ j → α → 𝕜
  | .inl i => pairedFamily U (.inl i.val)
  | .inr b => pairedFamily U (.inr b.val)

theorem selected_sum_apply (U : α → α → 𝕜) (a j : Finset α)
    (g : a ⊕ j → 𝕜) (q : α) :
    (∑ i, g i • selectedFamily U a j i) q =
      (∑ i : a, if q = i.val then g (.inl i) else 0) +
      ∑ b : j, U q b.val * g (.inr b) := by
  simp only [Fintype.sum_sum_type, Pi.add_apply, Finset.sum_apply, Pi.smul_apply,
    selectedFamily, pairedFamily, smul_eq_mul, mul_ite, mul_one, mul_zero]
  congr 1
  exact Finset.sum_congr rfl (fun b _ => mul_comm _ _)

theorem selected_linearIndependent (U : α → α → 𝕜) (a j : Finset α)
    (hkernel : ∀ v : j → 𝕜,
      (∀ q, q ∉ a → (∑ b : j, U q b.val * v b) = 0) → ∀ b, v b = 0) :
    LinearIndependent 𝕜 (selectedFamily U a j) := by
  apply Fintype.linearIndependent_iff.mpr
  intro g hg
  have hcoord (q : α) :
      (∑ i : a, if q = i.val then g (.inl i) else 0) +
        (∑ b : j, U q b.val * g (.inr b)) = 0 := by
    simpa only [selected_sum_apply, Pi.zero_apply] using congrFun hg q
  have hright : ∀ b : j, g (.inr b) = 0 := by
    apply hkernel (fun b => g (.inr b))
    intro q hq
    have hleft : (∑ i : a, if q = i.val then g (.inl i) else 0) = 0 := by
      apply Finset.sum_eq_zero
      intro i _
      have hqi : q ≠ i.val := by
        intro h
        apply hq
        simpa only [h] using i.property
      exact if_neg hqi
    simpa only [hleft, zero_add] using hcoord q
  intro i
  cases i with
  | inr b => exact hright b
  | inl i =>
    have hsame (l : a) : i.val = l.val ↔ i = l :=
      ⟨Subtype.ext, congrArg Subtype.val⟩
    simpa only [hsame, Finset.sum_ite_eq, Finset.mem_univ, if_true,
      hright, mul_zero, Finset.sum_const_zero, add_zero] using hcoord i.val

theorem selected_span_eq_top (U : α → α → 𝕜) (a j : Finset α)
    (hcard : a.card + j.card = Fintype.card α)
    (hkernel : ∀ v : j → 𝕜,
      (∀ q, q ∉ a → (∑ b : j, U q b.val * v b) = 0) → ∀ b, v b = 0) :
    span 𝕜 (Set.range (selectedFamily U a j)) = ⊤ := by
  apply (selected_linearIndependent U a j hkernel).span_eq_top_of_card_eq_finrank'
  simpa only [Fintype.card_sum, Fintype.card_coe,
    Module.finrank_fintype_fun_eq_card] using hcard

/-- A spanning selected subfamily transfers to the original selected labels. -/
theorem span_eq_top_of_selected_subset (U : α → α → 𝕜)
    (S : Finset (α ⊕ α)) (a j : Finset α)
    (ha : a ⊆ S.toLeft) (hj : j ⊆ S.toRight)
    (hcard : a.card + j.card = Fintype.card α)
    (hkernel : ∀ v : j → 𝕜,
      (∀ q, q ∉ a → (∑ b : j, U q b.val * v b) = 0) → ∀ b, v b = 0) :
    span 𝕜 (Set.range (fun i : S => pairedFamily U i.val)) = ⊤ := by
  apply top_unique
  rw [← selected_span_eq_top U a j hcard hkernel]
  apply span_mono
  rintro _ ⟨i, rfl⟩
  cases i with
  | inl i =>
    exact ⟨⟨.inl i.val, Finset.mem_toLeft.mp (ha i.property)⟩, rfl⟩
  | inr b =>
    exact ⟨⟨.inr b.val, Finset.mem_toRight.mp (hj b.property)⟩, rfl⟩

/-- The existing physical column Gram identity gives ordinary complex linear
independence; this handles the endpoint with every matrix column selected. -/
theorem columns_linearIndependent_of_gram (U : α → α → ℂ)
    (hgram : ∀ i j, (∑ q, star (U q i) * U q j) = if i = j then 1 else 0) :
    LinearIndependent ℂ (fun b => fun q => U q b) := by
  apply Fintype.linearIndependent_iff.mpr
  intro g hg i
  have hz (q : α) : (∑ b, g b * U q b) = 0 := by
    simpa only [Finset.sum_apply, Pi.smul_apply, smul_eq_mul, Pi.zero_apply]
      using congrFun hg q
  have hcalc : (∑ q, star (U q i) * (∑ b, g b * U q b)) = g i := by
    calc
      _ = ∑ b, g b * (∑ q, star (U q i) * U q b) := by
        simp only [Finset.mul_sum]
        rw [Finset.sum_comm]
        apply Finset.sum_congr rfl
        intro b _
        apply Finset.sum_congr rfl
        intro q _
        ac_rfl
      _ = g i := by simp only [hgram, mul_ite, mul_one, mul_zero,
        Finset.sum_ite_eq, Finset.mem_univ, if_true]
  simpa only [hz, mul_zero, Finset.sum_const_zero] using hcalc.symm

theorem columns_span_eq_top_of_gram (U : α → α → ℂ)
    (hgram : ∀ i j, (∑ q, star (U q i) * U q j) = if i = j then 1 else 0) :
    span ℂ (Set.range (fun b => fun q => U q b)) = ⊤ := by
  apply (columns_linearIndependent_of_gram U hgram).span_eq_top_of_card_eq_finrank'
  exact (Module.finrank_fintype_fun_eq_card ℂ).symm

end P14BasisPlusColumns

end
end

section

/-! Every card(alpha)+1 selected identity/matrix columns span, from the
actual Gram identity, the diagonal zero pattern, and only middle-size
square kernels. The maximal missing-row endpoint uses all matrix columns. -/

noncomputable section
namespace P14PairedColumnsSpanning
open Submodule P14BasisPlusColumns
open scoped BigOperators

variable {α : Type*} [Fintype α] [DecidableEq α]

/-- Enumerate the actual missing coordinates and chosen columns independently. -/
theorem kernel_of_selected_square (U : α → α → ℂ) (a j : Finset α) (r : ℕ)
    (ha : (Finset.univ \ a).card = r) (hj : j.card = r)
    (hsquare : ∀ R C : Fin r → α,
      Function.Injective R → Function.Injective C →
      ∀ v : Fin r → ℂ,
        (∀ i, (∑ b, U (R i) (C b) * v b) = 0) → ∀ b, v b = 0) :
    ∀ v : j → ℂ,
      (∀ q, q ∉ a → (∑ b : j, U q b.val * v b) = 0) → ∀ b, v b = 0 := by
  intro v hv
  let eR : Fin r ≃ (Finset.univ \ a : Finset α) :=
    (Finset.equivFinOfCardEq ha).symm
  let eC : Fin r ≃ j := (Finset.equivFinOfCardEq hj).symm
  have hR : Function.Injective (fun i : Fin r => (eR i).val) :=
    Subtype.val_injective.comp eR.injective
  have hC : Function.Injective (fun i : Fin r => (eC i).val) :=
    Subtype.val_injective.comp eC.injective
  have hrows (i : Fin r) :
      (∑ b : Fin r, U (eR i).val (eC b).val * v (eC b)) = 0 := by
    calc
      _ = ∑ b : j, U (eR i).val b.val * v b :=
        eC.sum_comp (fun b : j => U (eR i).val b.val * v b)
      _ = 0 := hv (eR i).val (Finset.mem_sdiff.mp (eR i).property).2
  have hz := hsquare (fun i => (eR i).val) (fun i => (eC i).val)
    hR hC (fun b => v (eC b)) hrows
  intro b
  obtain ⟨i, rfl⟩ := eC.surjective b
  exact hz i

theorem kernel_of_single_missing (U : α → α → ℂ) (a : Finset α) (q b : α)
    (ha : Finset.univ \ a = {q}) (hub : U q b ≠ 0) :
    ∀ v : ({b} : Finset α) → ℂ,
      (∀ x, x ∉ a → (∑ j : ({b} : Finset α), U x j.val * v j) = 0) →
      ∀ j, v j = 0 := by
  intro v hv
  let b0 : ({b} : Finset α) := ⟨b, Finset.mem_singleton_self b⟩
  have hall (j : ({b} : Finset α)) : j = b0 :=
    Subtype.ext (Finset.mem_singleton.mp j.property)
  have hqmem : q ∈ (Finset.univ \ a : Finset α) := by
    rw [ha]
    exact Finset.mem_singleton_self q
  have hq := hv q (Finset.mem_sdiff.mp hqmem).2
  have hsum : (∑ j : ({b} : Finset α), U q j.val * v j) = U q b * v b0 := by
    apply Finset.sum_eq_single b0
    · intro j _ hj
      exact (hj (hall j)).elim
    · intro hnot
      exact (hnot (Finset.mem_univ b0)).elim
  rw [hsum] at hq
  have hz : v b0 = 0 := (mul_eq_zero.mp hq).resolve_left hub
  intro j
  simpa only [hall j] using hz

/-- The endpoints r=0, r=1 and r=card(alpha)-1 are handled separately.
No kernel hypothesis of size card(alpha)-1 is requested. -/
theorem paired_span_eq_top (U : α → α → ℂ)
    (hgram : ∀ i j, (∑ q, star (U q i) * U q j) = if i = j then 1 else 0)
    (hzero : ∀ i j, U i j = 0 ↔ i = j)
    (hmiddle : ∀ r : ℕ, 2 ≤ r → r < Fintype.card α - 1 →
      ∀ R C : Fin r → α, Function.Injective R → Function.Injective C →
      ∀ v : Fin r → ℂ,
        (∀ i, (∑ b, U (R i) (C b) * v b) = 0) → ∀ b, v b = 0)
    (S : Finset (α ⊕ α)) (hS : S.card = Fintype.card α + 1) :
    span ℂ (Set.range (fun i : S => pairedFamily U i.val)) = ⊤ := by
  classical
  let Aset := S.toLeft
  let Bset := S.toRight
  let missing : Finset α := Finset.univ \ Aset
  let r := missing.card
  have hsum : Aset.card + Bset.card = Fintype.card α + 1 := by
    exact Finset.card_toLeft_add_card_toRight.trans hS
  have hA : Aset.card ≤ Fintype.card α := Aset.card_le_univ
  have hB : Bset.card ≤ Fintype.card α := Bset.card_le_univ
  have hmissing : r + Aset.card = Fintype.card α := by
    simpa only [r, missing, Finset.card_univ] using
      Finset.card_sdiff_add_card_eq_card (Finset.subset_univ Aset)
  have hBcard : Bset.card = r + 1 := by omega
  have hpositive : 0 < Fintype.card α := by omega
  have hrle : r ≤ Fintype.card α - 1 := by omega
  by_cases hr0 : r = 0
  · apply span_eq_top_of_selected_subset U S Aset ∅ (Finset.Subset.refl _)
      (Finset.empty_subset _)
    · simp only [Finset.card_empty, add_zero]
      omega
    · intro v _ b
      exact (Finset.notMem_empty b.val b.property).elim
  by_cases hrlast : r = Fintype.card α - 1
  · have hball : Bset = Finset.univ := Bset.eq_univ_of_card (by omega)
    apply top_unique
    rw [← columns_span_eq_top_of_gram U hgram]
    apply span_mono
    rintro _ ⟨b, rfl⟩
    have hb : b ∈ S.toRight := by
      change b ∈ Bset
      rw [hball]
      exact Finset.mem_univ b
    exact ⟨⟨.inr b, Finset.mem_toRight.mp hb⟩, rfl⟩
  by_cases hr1 : r = 1
  · obtain ⟨q, hq⟩ := Finset.card_eq_one.mp (show missing.card = 1 from hr1)
    obtain ⟨b, hb, hbq⟩ := Finset.exists_mem_ne (show 1 < Bset.card by omega) q
    have hub : U q b ≠ 0 := by
      intro hz
      exact hbq ((hzero q b).mp hz).symm
    apply span_eq_top_of_selected_subset U S Aset {b} (Finset.Subset.refl _)
      (Finset.singleton_subset_iff.mpr hb)
    · simp only [Finset.card_singleton]
      omega
    · exact kernel_of_single_missing U Aset q b hq hub
  have hr2 : 2 ≤ r := by omega
  have hrlt : r < Fintype.card α - 1 := by omega
  obtain ⟨J, hJB, hJcard⟩ :=
    Finset.exists_subset_card_eq (show r ≤ Bset.card by omega)
  apply span_eq_top_of_selected_subset U S Aset J (Finset.Subset.refl _) hJB
  · omega
  · exact kernel_of_selected_square U Aset J r rfl hJcard (hmiddle r hr2 hrlt)

end P14PairedColumnsSpanning

end
end

section

/-! The balanced local factor uses the same actual family for nonzeroness,
all selected spans and both orientations of the prescribed pairings. -/

noncomputable section
namespace P14BalancedLocalFactor

open P14BalancedPhysicalFamily P14ComplexLocalCover
open scoped BigOperators

theorem selected_span {p : ℕ} [NeZero p] (hp : 3 ≤ p)
    (S : Finset (Fin (p + 1) ⊕ Fin (p + 1))) (hS : S.card = p + 2) :
    Submodule.span ℂ (Set.range (fun i : S => family p i.val)) = ⊤ := by
  classical
  have hfamily : family p = P14BasisPlusColumns.pairedFamily (finMatrix p) := by
    funext i q
    cases i <;> rfl
  rw [hfamily]
  apply P14PairedColumnsSpanning.paired_span_eq_top (finMatrix p)
    (finMatrix_columns_gram hp) (finMatrix_entry_eq_zero_iff hp) ?_ S
    (by simpa using hS)
  intro r hr hrp R C hR hC v hv
  exact P14BalancedSelectedKernel.selected_square_kernel hp hr
    (by simpa using hrp) ((finSuccEquiv p) ∘ R) ((finSuccEquiv p) ∘ C)
    ((finSuccEquiv p).injective.comp hR) ((finSuccEquiv p).injective.comp hC) v hv

/-- Dimension and killing cap are both p+1, with no rank or genericity premise. -/
theorem exists_local_factor {p : ℕ} (hp : 3 ≤ p) :
    HasLocalFactor (Fin (p + 1) ⊕ Fin (p + 1)) (p + 1) (p + 1)
      balancedRelation := by
  letI : NeZero p := ⟨by omega⟩
  refine ⟨family p, family_ne_zero hp, ?_, pairing_zero hp⟩
  intro S hS
  exact selected_span hp S (by simpa [Nat.add_assoc] using hS)

end P14BalancedLocalFactor

end
end

section

/-! A balanced factor and complementary positive windows on the same two
halves. This gives the literal canonical bound for the balanced allocation;
it does not assert unrestricted admissible dimension coverage. -/

noncomputable section
namespace P14BalancedWindowUPB

open P14ComplexLocalCover P14CyclicOffsetIntervalCover
open P14WindowCircleLocalFactors P14CanonicalUPBTransport
open scoped BigOperators

abbrev Factor (w : ℕ) := Fin 1 ⊕ Fin w

def factorEquiv (w : ℕ) : Factor w ≃ Fin (1 + w) := finSumFinEquiv

def blockCap {w : ℕ} (p : ℕ) (e : Fin w → ℕ) : Factor w → ℕ
  | .inl _ => p + 1
  | .inr j => e j

def blockDimension {w : ℕ} (p : ℕ) (e : Fin w → ℕ) : Factor w → ℕ
  | .inl _ => p + 1
  | .inr j => e j + 1

def caps {w : ℕ} (p : ℕ) (e : Fin w → ℕ) (j : Fin (1 + w)) : ℕ :=
  blockCap p e ((factorEquiv w).symm j)

def dimensions {w : ℕ} (p : ℕ) (e : Fin w → ℕ) (j : Fin (1 + w)) : ℕ :=
  blockDimension p e ((factorEquiv w).symm j)

theorem sum_caps {w : ℕ} (p : ℕ) (e : Fin w → ℕ) :
    (∑ j, caps p e j) = p + 1 + ∑ j, e j := by
  calc
    _ = ∑ j : Factor w, blockCap p e j := (factorEquiv w).symm.sum_comp _
    _ = _ := by simp [blockCap]

theorem sum_dimensions_sub_one {w : ℕ} (p : ℕ) (e : Fin w → ℕ) :
    (∑ j, (dimensions p e j - 1)) = p + ∑ j, e j := by
  calc
    _ = ∑ j : Factor w, (blockDimension p e j - 1) :=
      (factorEquiv w).symm.sum_comp _
    _ = _ := by simp [blockDimension]

def lengths {w : ℕ} (e : Fin w → ℕ) (i : ℕ) : ℕ :=
  if hi : i < w then e ⟨i, hi⟩ else 0

@[simp] theorem lengths_fin {w : ℕ} (e : Fin w → ℕ) (i : Fin w) :
    lengths e i.val = e i := by simp [lengths, i.isLt]

theorem prefix_lengths {w : ℕ} (e : Fin w → ℕ) :
    prefixSum (lengths e) w = ∑ i, e i := by
  rw [prefixSum, ← Fin.sum_univ_eq_sum_range]
  apply Finset.sum_congr rfl
  intro i _
  exact lengths_fin e i

theorem window_lt {p w : ℕ} (e : Fin w → ℕ) (hSum : (∑ i, e i) = p)
    (i : Fin w) : e i < p + 1 := by
  have hle : e i ≤ ∑ j, e j := Finset.single_le_sum (fun j _ => Nat.zero_le (e j))
    (Finset.mem_univ i)
  omega

/-- All witnesses use the same two halves, including both cross orientations. -/
theorem exists_upb {p w : ℕ} (hp : 3 ≤ p) (e : Fin w → ℕ)
    (hSum : (∑ i, e i) = p) :
    (2 + ∑ j : Fin (1 + w), (dimensions p e j - 1)) = 2 * (p + 1) ∧
    ∃ v : Fin (2 * (p + 1)) → (j : Fin (1 + w)) → Fin (dimensions p e j) → ℂ,
      (∀ i j, v i j ≠ 0) ∧
      (∀ i i', i ≠ i' → ∃ j, (∑ a, star (v i j a) * v i' j a) = 0) ∧
      (∀ a : (j : Fin (1 + w)) → Fin (dimensions p e j) → ℂ,
        (∀ j, a j ≠ 0) → ∃ i, ∀ j, (∑ b, star (v i j b) * a j b) ≠ 0) := by
  classical
  let δ : Fin w → Fin (p + 1) := fun i => 1 + Fin.ofNat (p + 1)
    (prefixSum (lengths e) i.val)
  let RJ : Factor w → (Fin (p + 1) ⊕ Fin (p + 1)) →
      (Fin (p + 1) ⊕ Fin (p + 1)) → Prop
    | .inl _ => P14BalancedPhysicalFamily.balancedRelation
    | .inr i => WindowRelation (Nat.le_of_lt (window_lt e hSum i)) (δ i)
  have hlocalJ : ∀ j, HasLocalFactor (Fin (p + 1) ⊕ Fin (p + 1))
      (blockDimension p e j) (blockCap p e j) (RJ j) := by
    rintro (q | i)
    · exact P14BalancedLocalFactor.exists_local_factor hp
    · exact window (P14FourierSpectralWeights.fourierRoot_isPrimitiveRoot (p + 1)
        (by omega)) (window_lt e hSum i) (δ i)
  have hlength : ∀ i < w, lengths e i ≤ p + 1 := by
    intro i hi
    simpa only [lengths, dif_pos hi] using Nat.le_of_lt (window_lt e hSum ⟨i, hi⟩)
  have hcross (a b : Fin (p + 1)) :
      ∃ j : Factor w, RJ j (Sum.inl a) (Sum.inr b) ∧
        RJ j (Sum.inr b) (Sum.inl a) := by
    by_cases hab : a = b
    · exact ⟨.inl 0, hab, hab.symm⟩
    · have hne : b - a ≠ 0 := sub_ne_zero.mpr (Ne.symm hab)
      have hpos : 0 < (b - a).val := by
        by_contra h
        have hz : (b - a).val = 0 := by omega
        exact hne (Fin.ext hz)
      have hq : (b - a).val - 1 < prefixSum (lengths e) w := by
        rw [prefix_lengths, hSum]
        have hb := (b - a).isLt
        omega
      obtain ⟨i, t, ht⟩ := cyclic_interval_cover (lengths e) w (1 : Fin (p + 1))
        hlength ((b - a).val - 1) hq
      let ti : Fin (e i) := ⟨t.val, by rw [← lengths_fin e i]; exact t.isLt⟩
      have htcast : t.castLE (hlength i.val i.isLt) =
          ti.castLE (Nat.le_of_lt (window_lt e hSum i)) := Fin.ext rfl
      have hnat : 1 + ((b - a).val - 1) = (b - a).val := by omega
      have hstart : (1 : Fin (p + 1)) + Fin.ofNat (p + 1) ((b - a).val - 1) =
          b - a := by
        change Fin.ofNat (p + 1) 1 + Fin.ofNat (p + 1) ((b - a).val - 1) = b - a
        have hlt : (b - a).val - 1 < p + 1 :=
          lt_of_le_of_lt (Nat.sub_le _ _) (b - a).isLt
        rw [Fin.ofNat_add, Fin.val_ofNat, Nat.mod_eq_of_lt hlt, hnat,
          Fin.ofNat_val_eq_self]
      have hoffset : b - a = δ i + ti.castLE (Nat.le_of_lt (window_lt e hSum i)) := by
        simpa only [hstart, htcast] using ht
      exact ⟨.inr i, ⟨a, b, ti, hoffset, Or.inl ⟨rfl, rfl⟩⟩,
        ⟨a, b, ti, hoffset, Or.inr ⟨rfl, rfl⟩⟩⟩
  have hcoverJ : ∀ i i' : Fin (p + 1) ⊕ Fin (p + 1), i ≠ i' → ∃ j, RJ j i i' := by
    intro i i' hii'
    cases i with
    | inl a =>
        cases i' with
        | inl b => exact ⟨.inl 0, fun h => hii' (congrArg Sum.inl h)⟩
        | inr b => obtain ⟨j, hj, _⟩ := hcross a b; exact ⟨j, hj⟩
    | inr b =>
        cases i' with
        | inl a => obtain ⟨j, _, hj⟩ := hcross a b; exact ⟨j, hj⟩
        | inr a => exact ⟨.inl 0, fun h => hii' (congrArg Sum.inr h)⟩
  let R : Fin (1 + w) → (Fin (p + 1) ⊕ Fin (p + 1)) →
      (Fin (p + 1) ⊕ Fin (p + 1)) → Prop := fun j => RJ ((factorEquiv w).symm j)
  have hlocal : ∀ j, HasLocalFactor (Fin (p + 1) ⊕ Fin (p + 1))
      (dimensions p e j) (caps p e j) (R j) := fun j => hlocalJ ((factorEquiv w).symm j)
  have hcover : ∀ i i', i ≠ i' → ∃ j, R j i i' := by
    intro i i' hii'
    obtain ⟨j, hj⟩ := hcoverJ i i' hii'
    refine ⟨factorEquiv w j, ?_⟩
    simpa only [R, Equiv.symm_apply_apply] using hj
  have hcard : Fintype.card (Fin (p + 1) ⊕ Fin (p + 1)) = 2 * (p + 1) := by
    simp
    omega
  have hbudget : (∑ j, caps p e j) < 2 * (p + 1) := by rw [sum_caps, hSum]; omega
  refine ⟨?_, assemble (dimensions p e) (caps p e) R hcard hlocal hcover hbudget⟩
  rw [sum_dimensions_sub_one, hSum]
  omega

theorem canonical {p w : ℕ} (hp : 3 ≤ p) (e : Fin w → ℕ)
    (hSum : (∑ i, e i) = p) : Conclusion (1 + w) (dimensions p e) := by
  obtain ⟨hbound, hv⟩ := exists_upb hp e hSum
  refine ⟨2 * (p + 1), ?_, hv⟩
  rw [hbound]

end P14BalancedWindowUPB


end
end

section

/-! The balanced construction preserves the original corrected domain and
literal conclusion through a single supplied factor equivalence. -/

namespace P14BalancedCanonicalRegions

open P14CanonicalUPBTransport P14BalancedWindowUPB
open scoped BigOperators

theorem window_count_pos {p w : ℕ} (hp : 3 ≤ p) (e : Fin w → ℕ)
    (hSum : (∑ i, e i) = p) : 0 < w := by
  by_contra hw
  have hw0 : w = 0 := by omega
  subst w
  rw [Fin.sum_univ_zero] at hSum
  omega

theorem admissible {p w : ℕ} (hp : 3 ≤ p) (e : Fin w → ℕ)
    (hSum : (∑ i, e i) = p) (he : ∀ i, 1 ≤ e i) :
    Admissible (1 + w) (dimensions p e) := by
  have hw := window_count_pos hp e hSum
  refine ⟨by omega, ?_, ?_, ?_⟩
  · intro j
    obtain ⟨j', rfl⟩ := (factorEquiv w).surjective j
    simp only [dimensions, Equiv.symm_apply_apply]
    rcases j' with q | i
    · change 2 ≤ p + 1
      omega
    · change 2 ≤ e i + 1
      have hi := he i
      omega
  · rintro ⟨hcount, j, hj⟩
    have hw1 : w = 1 := by omega
    subst w
    obtain ⟨j', rfl⟩ := (factorEquiv 1).surjective j
    simp only [dimensions, Equiv.symm_apply_apply] at hj
    rcases j' with q | i
    · change p + 1 = 2 at hj
      omega
    · have hi : i = 0 := Fin.eq_zero i
      subst i
      change e 0 + 1 = 2 at hj
      have hsum : e 0 = p := by simpa only [Fin.sum_univ_one] using hSum
      omega
  · intro hAll
    have hSeed := hAll (factorEquiv w (.inl 0))
    have hp2 : p + 1 = 2 := by
      simpa only [dimensions, Equiv.symm_apply_apply, blockDimension] using hSeed
    omega

/-- Original tuple and order, not merely an isomorphic palette. -/
theorem balanced_region {q p w : ℕ} (hp : 3 ≤ p) (e : Fin w → ℕ)
    (hSum : (∑ i, e i) = p) (he : ∀ i, 1 ≤ e i)
    (D : Fin q → ℕ) (E : Fin q ≃ Fin (1 + w))
    (hDimensions : ∀ j, D j = dimensions p e (E j)) :
    Admissible q D ∧ Conclusion q D := by
  exact ⟨admissible_of_dimensions _ D E hDimensions (admissible hp e hSum he),
    of_dimensions _ D E hDimensions (canonical hp e hSum)⟩

end P14BalancedCanonicalRegions

end

section

/-! Recognize the balanced allocation directly in the original ordered
dimension tuple. The factor equivalence and complementary lengths are
constructed internally; no palette-equivalence premise remains. -/

noncomputable section
namespace P14BalancedDimensionRecognition

open P14CanonicalUPBTransport P14BalancedWindowUPB P14BalancedCanonicalRegions
open scoped BigOperators

private def distinguishedEquiv {q w : ℕ} (a : Fin q)
    (f : Fin w ≃ {j : Fin q // j ≠ a}) : Factor w ≃ Fin q where
  toFun := Sum.elim (fun _ => a) (fun i => (f i).val)
  invFun j := if h : j = a then Sum.inl 0 else Sum.inr (f.symm ⟨j, h⟩)
  left_inv j := by
    cases j with
    | inl i =>
      have hi : i = 0 := Fin.eq_zero i
      subst i
      simp
    | inr i => simp [(f i).property]
  right_inv j := by
    by_cases hj : j = a <;> simp [hj]

/-- A distinguished factor of dimension at least four and exactly half of
the total dimension-minus-one weight gives the literal original conclusion. -/
theorem of_total_balance {q : ℕ} (D : Fin q → ℕ) (hD : ∀ j, 2 ≤ D j)
    (a : Fin q) (ha : 4 ≤ D a)
    (hbalance : (∑ j, (D j - 1)) = 2 * (D a - 1)) :
    Admissible q D ∧ Conclusion q D := by
  classical
  let Remaining := {j : Fin q // j ≠ a}
  let w := Fintype.card Remaining
  let f : Fin w ≃ Remaining := (Fintype.equivFin Remaining).symm
  let p := D a - 1
  let e : Fin w → ℕ := fun i => D (f i).val - 1
  have hp : 3 ≤ p := by dsimp [p]; omega
  have hsplit : (D a - 1) + (∑ j : Remaining, (D j.val - 1)) =
      ∑ j : Fin q, (D j - 1) := by
    exact (Fintype.sum_eq_add_sum_subtype_ne (fun j : Fin q => D j - 1) a).symm
  have hsum : (∑ i, e i) = p := by
    have heq : (∑ i, e i) = ∑ j : Remaining, (D j.val - 1) :=
      f.sum_comp (fun j : Remaining => D j.val - 1)
    rw [heq]
    dsimp only [p]
    omega
  have he : ∀ i, 1 ≤ e i := by
    intro i
    have hi := hD (f i).val
    dsimp only [e]
    omega
  let T : Factor w ≃ Fin q := distinguishedEquiv a f
  let E : Fin q ≃ Fin (1 + w) := T.symm.trans (factorEquiv w)
  have hDimensions : ∀ j, D j = dimensions p e (E j) := by
    intro j
    obtain ⟨t, rfl⟩ := T.surjective j
    simp only [E, Equiv.trans_apply, Equiv.symm_apply_apply, dimensions]
    cases t with
    | inl i =>
      change D a = p + 1
      dsimp only [p]
      omega
    | inr i =>
      change D (f i).val = e i + 1
      have hi := hD (f i).val
      dsimp only [e]
      omega
  exact balanced_region hp e hsum he D E hDimensions

theorem conclusion_of_total_balance {q : ℕ} (D : Fin q → ℕ)
    (hD : Admissible q D) (a : Fin q) (ha : 4 ≤ D a)
    (hbalance : (∑ j, (D j - 1)) = 2 * (D a - 1)) : Conclusion q D :=
  (of_total_balance D hD.2.1 a ha hbalance).2

/-- The other-factor formulation uses the original indices and a literal
erasure of the distinguished index. -/
theorem conclusion_of_other_sum {q : ℕ} (D : Fin q → ℕ)
    (hD : Admissible q D) (a : Fin q) (ha : 4 ≤ D a)
    (hbalance : (∑ j ∈ Finset.univ.erase a, (D j - 1)) = D a - 1) :
    Conclusion q D := by
  have hsplit := Finset.sum_erase_add Finset.univ (fun j : Fin q => D j - 1)
    (Finset.mem_univ a)
  have htotal : (∑ j, (D j - 1)) = 2 * (D a - 1) := by
    rw [hbalance] at hsplit
    omega
  exact conclusion_of_total_balance D hD a ha htotal

theorem equal_bipartite (K : ℕ) (hK : 4 ≤ K) :
    Conclusion 2 (fun _ : Fin 2 => K) := by
  apply (of_total_balance (fun _ : Fin 2 => K) (fun _ => by omega)
    (0 : Fin 2) hK ?_).2
  simp

end P14BalancedDimensionRecognition

end
end

section

/-! Complete all non-dominant multipartite cases and all mixed triples.
Any remaining multipartite failure must have at least four factors and
exactly one strictly dominant dimension, with every other factor a qubit. -/

noncomputable section
namespace P14HighDimensionSingleCanonical
open P14CanonicalUPBTransport P14HighDimensionThreeShiftUPB
open scoped BigOperators

theorem single_sum {p : ℕ} (d : Fin p → ℕ) (a : Fin p)
    (hrest : ∀ j, j ≠ a → d j = 2) :
    (∑ j, (d j - 1)) = (d a - 1) + (p - 1) := by
  classical
  have hs : (∑ j ∈ Finset.univ.erase a, (d j - 1)) = p - 1 := by
    calc
      _ = ∑ _j ∈ Finset.univ.erase a, (1 : ℕ) := by
        apply Finset.sum_congr rfl
        intro j hj
        rw [hrest j (Finset.mem_erase.mp hj).1]
      _ = p - 1 := by simp
  have hsplit := Finset.sum_erase_add Finset.univ (fun j : Fin p => d j - 1)
    (Finset.mem_univ a)
  omega

theorem one_high {q p : ℕ} (hq : 7 ≤ q) (ho : Odd q)
    (d : Fin p → ℕ) (a : Fin p) (ha : 6 ≤ d a) (haq : d a < q)
    (hrest : ∀ j, j ≠ a → d j = 2)
    (hsum : (∑ j, (d j - 1)) = 2 * q - 2) : Conclusion p d := by
  classical
  have hp : 0 < p := by have h := a.isLt; omega
  letI : NeZero p := ⟨by omega⟩
  have hs := single_sum d a hrest
  have hk : (2 * q - d a - 1) + 1 = p := by omega
  let E : Fin p ≃ Fin p := Equiv.swap 0 a
  have he0 : E 0 = a := Equiv.swap_apply_left _ _
  let G : Fin ((2 * q - d a - 1) + 1) ≃ Fin p := (finCongr hk).trans E
  have hdim : ∀ j, dimensions (d a) q j = d (G j) := by
    intro j
    refine Fin.cases ?_ (fun j => ?_) j
    · have h0 : (finCongr hk) 0 = (0 : Fin p) := Fin.ext rfl
      simp only [dimensions, Fin.cons_zero, G, Equiv.trans_apply, h0, he0]
    · have hne : G j.succ ≠ a := by
        intro he
        have hh : (finCongr hk) j.succ = (0 : Fin p) := E.injective (he.trans he0.symm)
        have hv := congrArg Fin.val hh
        change j.val + 1 = 0 at hv
        omega
      simpa only [dimensions, Fin.cons_succ, hrest _ hne]
  have hd6 : d a = (d a - 6) + 6 := by omega
  have hc : Conclusion ((2 * q - d a - 1) + 1) (dimensions (d a) q) := by
    rw [hd6]
    exact canonical hq ho (by omega)
  apply P14CanonicalUPBTransport.of_dimensions (dimensions (d a) q) d G.symm
  · intro j
    simpa only [Equiv.apply_symm_apply] using (hdim (G.symm j)).symm
  · exact hc

theorem single_nondominant {p : ℕ} (d : Fin p → ℕ) (hp : 3 ≤ p)
    (hd : ∀ j, 2 ≤ d j) (a : Fin p) (ha : 6 ≤ d a)
    (hrest : ∀ j, j ≠ a → d j = 2)
    (hbal : 2 * (d a - 1) ≤ ∑ j, (d j - 1)) : Conclusion p d := by
  classical
  by_contra hnot
  have hnq : ¬ (∀ j, d j = 2) := by intro h; have hh := h a; omega
  obtain ⟨_, _, hmod, hlo, _⟩ := P14LowDimensionCanonical.residual d hp hd hnq hnot
  let S := ∑ j, (d j - 1)
  let q := (S + 2) / 2
  have hq : 7 ≤ q := by dsimp [q, S]; omega
  have ho : Odd q := by
    refine ⟨S / 4, ?_⟩
    dsimp [q, S]
    omega
  have hsum : (∑ j, (d j - 1)) = 2 * q - 2 := by dsimp [q, S]; omega
  by_cases hlt : d a < q
  · exact hnot (one_high hq ho d a ha hlt hrest hsum)
  · have he : (∑ j, (d j - 1)) = 2 * (d a - 1) := by omega
    exact hnot (P14BalancedDimensionRecognition.of_total_balance d hd a (by omega) he).2

theorem nondominant {p : ℕ} (d : Fin p → ℕ) (hp : 3 ≤ p)
    (hd : ∀ j, 2 ≤ d j) (hnq : ¬ (∀ j, d j = 2))
    (hbal : ∀ a, 2 * (d a - 1) ≤ ∑ j, (d j - 1)) : Conclusion p d := by
  classical
  by_contra hnot
  obtain ⟨a, ha, hrest⟩ := P14HighDimensionRawCanonical.residual_shape d hp hd hnq hnot
  exact hnot (single_nondominant d hp hd a ha hrest (hbal a))

theorem triple (d : Fin 3 → ℕ) (hd : ∀ j, 2 ≤ d j)
    (hnq : ¬ (∀ j, d j = 2)) : Conclusion 3 d := by
  classical
  by_contra hnot
  obtain ⟨a, ha, hrest⟩ := P14HighDimensionRawCanonical.residual_shape d (by decide) hd hnq hnot
  let E : Fin 3 ≃ Fin 3 := Equiv.swap 2 a
  have he2 : E 2 = a := Equiv.swap_apply_left _ _
  have h0 : E 0 ≠ a := by
    intro h
    have he : (0 : Fin 3) = 2 := E.injective (h.trans he2.symm)
    exact (by decide : (0 : Fin 3) ≠ 2) he
  have h1 : E 1 ≠ a := by
    intro h
    have he : (1 : Fin 3) = 2 := E.injective (h.trans he2.symm)
    exact (by decide : (1 : Fin 3) ≠ 2) he
  have hdim : ∀ j, (![2, 2, d a] : Fin 3 → ℕ) j = d (E j) := by
    intro j
    fin_cases j
    · exact (hrest _ h0).symm
    · exact (hrest _ h1).symm
    · change d a = d (E 2)
      rw [he2]
  have hc : Conclusion 3 (![2, 2, d a] : Fin 3 → ℕ) :=
    P14TwoQubitsUPB.canonical (d a) (by omega)
  apply hnot
  apply P14CanonicalUPBTransport.of_dimensions (![2, 2, d a]) d E.symm
  · intro j
    simpa only [Equiv.apply_symm_apply] using (hdim (E.symm j)).symm
  · exact hc

theorem residual_strict {p : ℕ} (d : Fin p → ℕ) (hp : 3 ≤ p)
    (hd : ∀ j, 2 ≤ d j) (hnq : ¬ (∀ j, d j = 2)) (hnot : ¬ Conclusion p d) :
    4 ≤ p ∧ ∃ a, 6 ≤ d a ∧ (∀ j, j ≠ a → d j = 2) ∧ p < d a ∧
      (∑ j, (d j - 1)) % 4 = 0 ∧ 12 ≤ (∑ j, (d j - 1)) := by
  have hp4 : 4 ≤ p := by
    by_contra h
    have he : p = 3 := by omega
    subst p
    exact hnot (triple d hd hnq)
  obtain ⟨a, ha, hrest⟩ := P14HighDimensionRawCanonical.residual_shape d hp hd hnq hnot
  have hnb : ¬ 2 * (d a - 1) ≤ ∑ j, (d j - 1) :=
    fun h => hnot (single_nondominant d hp hd a ha hrest h)
  have hs := single_sum d a hrest
  obtain ⟨_, _, hmod, hlo, _⟩ := P14LowDimensionCanonical.residual d hp hd hnq hnot
  exact ⟨hp4, a, ha, hrest, by omega, hmod, hlo⟩

end P14HighDimensionSingleCanonical
end
end

section

/-! Complete every admissible mixed four-factor tuple in arbitrary order.
Any remaining multipartite failure now needs at least five factors. -/

noncomputable section
open scoped BigOperators
namespace P14QuadraticFourCanonical
open P14CanonicalUPBTransport

theorem four (d : Fin 4 → ℕ) (hd : ∀ j, 2 ≤ d j)
    (hnq : ¬ (∀ j, d j = 2)) : Conclusion 4 d := by
  classical
  by_contra hnot
  obtain ⟨_, a, ha, hrest, _, hmod, hlo⟩ :=
    P14HighDimensionSingleCanonical.residual_strict d (by decide) hd hnq hnot
  have hsum := P14HighDimensionSingleCanonical.single_sum d a hrest
  let S := ∑ j, (d j - 1)
  let q := (S + 2) / 2
  have hq : 7 ≤ q := by dsimp [q, S]; omega
  have hdim0 : d a = 2 * q - 4 := by dsimp [q, S]; omega
  let E : Fin 4 ≃ Fin 4 := Equiv.swap 0 a
  have he0 : E 0 = a := Equiv.swap_apply_left _ _
  have hdim : ∀ j, P14QuadraticThreeQubitUPB.dimensions q j = d (E j) := by
    intro j
    refine Fin.cases ?_ (fun j => ?_) j
    · simpa only [P14QuadraticThreeQubitUPB.dimensions, Fin.cons_zero, he0] using hdim0.symm
    · have hne : E j.succ ≠ a := by
        intro h
        exact Fin.succ_ne_zero j (E.injective (h.trans he0.symm))
      simpa only [P14QuadraticThreeQubitUPB.dimensions, Fin.cons_succ, hrest _ hne]
  apply hnot
  apply P14CanonicalUPBTransport.of_dimensions (P14QuadraticThreeQubitUPB.dimensions q) d E.symm
  · intro j
    simpa only [Equiv.apply_symm_apply] using (hdim (E.symm j)).symm
  · exact P14QuadraticThreeQubitUPB.canonical hq

theorem residual_five {p : ℕ} (d : Fin p → ℕ) (hp : 3 ≤ p)
    (hd : ∀ j, 2 ≤ d j) (hnq : ¬ (∀ j, d j = 2)) (hnot : ¬ Conclusion p d) :
    5 ≤ p ∧ ∃ a, 6 ≤ d a ∧ (∀ j, j ≠ a → d j = 2) ∧ p < d a ∧
      (∑ j, (d j - 1)) % 4 = 0 ∧ 12 ≤ (∑ j, (d j - 1)) := by
  obtain ⟨hp4, hrest⟩ := P14HighDimensionSingleCanonical.residual_strict d hp hd hnq hnot
  refine ⟨?_, hrest⟩
  by_contra hh
  have he : p = 4 := by omega
  subst p
  exact hnot (four d hd hnq)

end P14QuadraticFourCanonical
end
end

section

/-! Complete every admissible mixed five-factor tuple in arbitrary order.
Any remaining multipartite failure needs at least six factors. -/

noncomputable section
open scoped BigOperators
namespace P14CubicFiveCanonical
open P14CanonicalUPBTransport

theorem five (d : Fin 5 → ℕ) (hd : ∀ j, 2 ≤ d j)
    (hnq : ¬ (∀ j, d j=2)) : Conclusion 5 d := by
  classical
  by_contra hnot
  obtain ⟨_,a,ha,hrest,_,hmod,hlo⟩ :=
    P14HighDimensionSingleCanonical.residual_strict d (by decide) hd hnq hnot
  have hsum := P14HighDimensionSingleCanonical.single_sum d a hrest
  let S := ∑ j, (d j-1)
  let q := (S+2)/2
  have hq : 7 ≤ q := by dsimp [q,S]; omega
  have hdim0 : d a=2*q-5 := by dsimp [q,S]; omega
  let E : Fin 5 ≃ Fin 5 := Equiv.swap 0 a
  have he0 : E 0=a := Equiv.swap_apply_left _ _
  have hdim : ∀ j, P14CubicFourQubitUPB.dimensions q j=d (E j) := by
    intro j
    refine Fin.cases ?_ (fun j => ?_) j
    · simpa only [P14CubicFourQubitUPB.dimensions,Fin.cons_zero,he0] using hdim0.symm
    · have hne : E j.succ ≠ a := by
        intro h
        exact Fin.succ_ne_zero j (E.injective (h.trans he0.symm))
