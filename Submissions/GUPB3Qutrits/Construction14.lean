theorem proof :
    ∃ u : Fin 14 → Fin 3 → ℂ, ∃ w : Fin 14 → Fin 3 → ℂ, ∃ z : Fin 14 → Fin 3 → ℂ,
      (∀ i, u i ≠ 0) ∧ (∀ i, w i ≠ 0) ∧ (∀ i, z i ≠ 0) ∧
      (∀ i j, i ≠ j →
        (∑ r, star (u i r) * u j r) * (∑ r, star (w i r) * w j r) *
          (∑ r, star (z i r) * z j r) = 0) ∧
      (∀ x : Fin 3 → ℂ, x ≠ 0 → ∀ N : Fin 3 → Fin 3 → ℂ, N ≠ 0 →
        ∃ i, (∑ r, star (u i r) * x r) * (∑ r, ∑ s, star (w i r * z i s) * N r s) ≠ 0) ∧
      (∀ y : Fin 3 → ℂ, y ≠ 0 → ∀ N : Fin 3 → Fin 3 → ℂ, N ≠ 0 →
        ∃ i, (∑ r, star (w i r) * y r) * (∑ r, ∑ s, star (u i r * z i s) * N r s) ≠ 0) ∧
      (∀ t : Fin 3 → ℂ, t ≠ 0 → ∀ N : Fin 3 → Fin 3 → ℂ, N ≠ 0 →
        ∃ i, (∑ r, star (z i r) * t r) * (∑ r, ∑ s, star (u i r * w i s) * N r s) ≠ 0) := by
  refine ⟨u, w, z, ?_, ?_, ?_, ?_, ?_, ?_, ?_⟩
  · intro i hi
    obtain ⟨r, hr⟩ := nzU i
    apply hr
    have h := congr_fun hi r
    simpa [u] using h
  · intro i hi
    obtain ⟨r, hr⟩ := nzW i
    apply hr
    have h := congr_fun hi r
    simpa [w] using h
  · intro i hi
    obtain ⟨r, hr⟩ := nzZ i
    apply hr
    have h := congr_fun hi r
    simpa [z] using h
  · intro i j hij
    rcases orthZ i j hij with hU | hW | hZ
    · have h : (∑ r, star (u i r) * u j r) = 0 := by
        rw [show (∑ r, star (u i r) * u j r) = (dot3Z (uZ i) (uZ j) : ℂ) by
          simpa [u] using dot3_cast (uZ i) (uZ j)]
        exact_mod_cast hU
      rw [h]; simp
    · have h : (∑ r, star (w i r) * w j r) = 0 := by
        rw [show (∑ r, star (w i r) * w j r) = (dot3Z (wZ i) (wZ j) : ℂ) by
          simpa [w] using dot3_cast (wZ i) (wZ j)]
        exact_mod_cast hW
      rw [h]; simp
    · have h : (∑ r, star (z i r) * z j r) = 0 := by
        rw [show (∑ r, star (z i r) * z j r) = (dot3Z (zZ i) (zZ j) : ℂ) by
          simpa [z] using dot3_cast (zZ i) (zZ j)]
        exact_mod_cast hZ
      rw [h]; simp
  · intro x hx N hN
    by_contra hno
    exact unextA x hx N hN (fun i => not_ne_iff.mp (fun hne => hno ⟨i, hne⟩))
  · intro x hx N hN
    by_contra hno
    exact unextB x hx N hN (fun i => not_ne_iff.mp (fun hne => hno ⟨i, hne⟩))
  · intro x hx N hN
    by_contra hno
    exact unextC x hx N hN (fun i => not_ne_iff.mp (fun hne => hno ⟨i, hne⟩))

